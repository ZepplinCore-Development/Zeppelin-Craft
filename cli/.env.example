# Zeppelin CLI Database Configuration
# Copy to .env and fill in your values

# AzerothCore database connection (for regular operations)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASS=your_password

# MySQL root credentials (for DROP/CREATE DATABASE operations)
DB_ROOT_USER=root
DB_ROOT_PASS=your_root_password

# DBC database connection (spell-editor database)
DBC_HOST=localhost
DBC_PORT=3306
DBC_USER=your_dbc_user
DBC_PASS=your_dbc_password
DBC_NAME=spellwork_335

# Tool binaries
MPQCLI_PATH=/path/to/mpqcli
DBCTOOL_PATH=/path/to/dbctool

# Server paths
NGINX_PATH=/path/to/nginx
SERVER_DBC_PATH=/path/to/data/dbc

# Build paths
DBC_EXPORT_PATH=/path/to/HeadlessExporter/Export
DBC_REORDER_PATH=/path/to/Scripts/Patch Builder
RESOURCE_PARSER_PATH=/path/to/Scripts/Resource Parser
