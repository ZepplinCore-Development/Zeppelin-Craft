# Zeppelin CLI Database Configuration
# Copy to .env and fill in your values

# AzerothCore database connection (for regular operations)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASS=your_password

# MySQL root credentials (for DROP/CREATE DATABASE operations)
DB_ROOT_USER=root
DB_ROOT_PASS=your_root_password

# DBC database connection (spell-editor database)
DBC_HOST=localhost
DBC_PORT=3306
DBC_USER=your_dbc_user
DBC_PASS=your_dbc_password
DBC_NAME=spellwork_335
