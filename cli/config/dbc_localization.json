{
  "$schema": "../schemas/dbc_localization.schema.json",
  "description": "DBC table localization field blacklist (fallback). Primary detection uses meta/ Loc fields. Fields listed here are excluded from diffs to avoid locale-only changes.",
  "version": "2.0.0",
  "locale_index": {
    "comment": "With meta/ Loc type, columns use language code suffixes (_enus, _kokr, etc.)",
    "english_suffixes": ["_enus"],
    "non_english_suffixes": ["_kokr", "_frfr", "_dede", "_zhcn", "_zhtw", "_eses", "_esmx", "_ruru", "_jajp", "_ptpt", "_itit", "_unused_1", "_unused_2", "_unused_3", "_unused_4"]
  },
  "tables": {
    "achievement": {
      "localized_prefixes": ["name", "description"],
      "keep_suffixes": ["_enus", "_flags"],
      "comment": "name_enus=English"
    },
    "achievement_criteria": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "areatable": {
      "localized_prefixes": ["area_name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "barbershopstyle": {
      "localized_prefixes": ["display_name", "description"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "chrclasses": {
      "localized_prefixes": ["name", "name_female", "name_male"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "chrraces": {
      "localized_prefixes": ["name", "name_female", "name_male"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "creaturefamily": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "dungeonencounter": {
      "localized_prefixes": ["encounter_name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "emotestextsound": {
      "localized_prefixes": [],
      "keep_suffixes": [],
      "comment": "No text fields, only sound IDs"
    },
    "faction": {
      "localized_prefixes": ["name", "description"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "factiongroup": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "gametips": {
      "localized_prefixes": ["text"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "itemclass": {
      "localized_prefixes": ["class_name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "itemlimitcategory": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "itemsubclass": {
      "localized_prefixes": ["display_name", "verbose_name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "languages": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "lfgdungeongroup": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "lfgdungeons": {
      "localized_prefixes": ["name", "description"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "loadingscreens": {
      "localized_prefixes": [],
      "keep_suffixes": [],
      "comment": "Contains file paths, not localized text"
    },
    "locktype": {
      "localized_prefixes": ["name", "resource_name", "verb"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "map": {
      "localized_prefixes": ["map_name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "mapdifficulty": {
      "localized_prefixes": ["message"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "namegen": {
      "localized_prefixes": [],
      "keep_suffixes": [],
      "comment": "Name generation data, not localized display text"
    },
    "questsort": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "skillline": {
      "localized_prefixes": ["name", "description", "alternate_verb"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "soundentries": {
      "localized_prefixes": [],
      "keep_suffixes": [],
      "comment": "Sound file paths, not localized text"
    },
    "spell": {
      "localized_prefixes": ["spell_name", "spell_subtext", "spell_desc", "spell_tooltip"],
      "keep_suffixes": ["_enus", "_flags"],
      "comment": "spell_name_enus=English"
    },
    "spelldispeltype": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "spellfocusobject": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "spellicon": {
      "localized_prefixes": [],
      "keep_suffixes": [],
      "comment": "Icon paths, not localized text"
    },
    "spellmechanic": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "spellrange": {
      "localized_prefixes": ["name", "short_name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "spellshapeshiftform": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "talenttab": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "totemcategory": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "vocaluisounds": {
      "localized_prefixes": [],
      "keep_suffixes": [],
      "comment": "Sound IDs, not text"
    },
    "wmoareatable": {
      "localized_prefixes": ["name"],
      "keep_suffixes": ["_enus", "_flags"]
    },
    "worldmaparea": {
      "localized_prefixes": [],
      "keep_suffixes": [],
      "comment": "Contains area references, not localized text"
    },
    "worldstateui": {
      "localized_prefixes": ["icon", "text", "tooltip"],
      "keep_suffixes": ["_enus", "_flags"]
    }
  }
}
