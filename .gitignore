# Environment files - DO NOT COMMIT
.env
*/.env
**/.env
Scripts/**/.env

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/
env/
.venv/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
temp.txt
*.tmp

# Log files
*.log
cli/logs/*.log
cli/lib/resource_parser/*.log
logs/

# Large binary archives
*.7z

# Backup files (use git for versioning)
*.bak
*.BAK

# WoW model skin files (binary assets)
*.skin
*.SKIN

# EXE patcher binaries (large, not source)
EXE Patching/*.exe

# Launcher build output
Launcher/dist/

# External zpaks (separate repos, managed by zep CLI)
external/
!external/.gitkeep

# Compiled CLI helpers — rebuilt from sources alongside them
/cli/lib/navmesh_checker/mmap_query

# Local DBCTool-style config (credentials, not source of truth)
/config.json
