# Environment files - DO NOT COMMIT
.env
*/.env
**/.env
Scripts/**/.env

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/
env/
.venv/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
temp.txt
*.tmp

# Log files
cli/logs/*.log
cli/lib/resource_parser/*.log
logs/

# Large binary archives
*.7z

# Backup files (use git for versioning)
*.bak

# External zpaks (separate repos, managed by zep CLI)
external/
!external/.gitkeep