# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched
* text=auto

# Force LF line endings for these file types
*.sql text eol=lf
*.csv text eol=lf
*.conf text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Forge patches must survive checkout byte-for-byte. With core.autocrlf=true and
# `* text=auto` a fresh checkout rewrote every line CRLF, so `git am` in
# `zep forge apply-patch` failed against the LF sources it was diffed from.
*.patch -text

# Force binary for certain file types
*.exe binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
*.pyc binary
*.pyz binary
*.pkg binary