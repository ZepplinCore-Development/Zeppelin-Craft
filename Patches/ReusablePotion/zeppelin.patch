+    {
+        many_visuals = true;
+    }
+    if (visual1 == REUSE_SPELL_VISUAL_POTION_OTHER_ONE){
+        many_visuals = true;
+    }
+    if(!many_visuals){
+        return;
+    }
+
+    player->SendCooldownEvent(spellInfo);
+    player->SetLastPotionId(0);
+}
