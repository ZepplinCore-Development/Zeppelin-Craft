Subject: [PATCH 2/5] Zeppelin customizations: Secondary skills and vendor
 gating
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Keep First Aid, Cooking, Fishing learnable from trainers (revert IPP book requirements)
- Move vanilla_vendors.sql to optional (no vendor item progression gating)

🤖 Generated with [Claude Code](https://claude.com/claude-code)

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../base/zz_zeppelin_secondary_skills.sql     | 28 +++++++++++++++++++
 .../sql/world/zz_optional_vanilla_vendors.sql |  0
 2 files changed, 28 insertions(+)
 create mode 100644 data/sql/world/base/zz_zeppelin_secondary_skills.sql
 rename data/sql/world/base/vanilla_vendors.sql => optional/sql/world/zz_optional_vanilla_vendors.sql (100%)

diff --git a/data/sql/world/base/zz_zeppelin_secondary_skills.sql b/data/sql/world/base/zz_zeppelin_secondary_skills.sql
new file mode 100644
index 0000000..eb57644
--- /dev/null
+++ b/data/sql/world/base/zz_zeppelin_secondary_skills.sql
@@ -0,0 +1,28 @@
+-- Zeppelin Customization: Keep First Aid, Cooking, and Fishing learnable from trainers
+-- IPP moves these to books/quests only, but we want the standard WotLK trainer experience
+
+-- Restore First Aid skills to trainers (IPP removes SpellIDs 54254, 10847, 54255)
+-- 54254 = Grand Master First Aid, 10847 = Expert First Aid, 54255 = Master First Aid
+DELETE FROM `trainer_spell` WHERE `SpellID` IN (54254, 10847, 54255);
+INSERT INTO `trainer_spell` (`TrainerId`, `SpellId`, `MoneyCost`, `ReqSkillLine`, `ReqSkillRank`, `ReqLevel`) VALUES
+-- First Aid trainers use TrainerId from npc_trainer entries
+(29, 10847, 5000, 129, 125, 0),   -- Expert First Aid (skill 225)
+(29, 54255, 100000, 129, 225, 0), -- Master First Aid (skill 300)
+(29, 54254, 350000, 129, 350, 0); -- Grand Master First Aid (skill 450)
+
+-- Restore Cooking skills to trainers (IPP removes SpellIDs 18261, 19886, 54257, 54256)
+-- 18261 = Expert Cooking, 19886 = Artisan Cooking, 54256 = Master Cooking, 54257 = Grand Master Cooking
+DELETE FROM `trainer_spell` WHERE `SpellID` IN (18261, 19886, 54257, 54256);
+INSERT INTO `trainer_spell` (`TrainerId`, `SpellId`, `MoneyCost`, `ReqSkillLine`, `ReqSkillRank`, `ReqLevel`) VALUES
+(21, 18261, 5000, 185, 125, 0),   -- Expert Cooking (skill 225)
+(21, 19886, 25000, 185, 200, 0),  -- Artisan Cooking (skill 300)
+(21, 54256, 100000, 185, 275, 0), -- Master Cooking (skill 375)
+(21, 54257, 350000, 185, 350, 0); -- Grand Master Cooking (skill 450)
+
+-- Restore Fishing skills to trainers (IPP removes SpellIDs 18249, 54083, 54084)
+-- 18249 = Expert Fishing, 54083 = Master Fishing, 54084 = Grand Master Fishing
+DELETE FROM `trainer_spell` WHERE `SpellID` IN (18249, 54083, 54084);
+INSERT INTO `trainer_spell` (`TrainerId`, `SpellId`, `MoneyCost`, `ReqSkillLine`, `ReqSkillRank`, `ReqLevel`) VALUES
+(20, 18249, 5000, 356, 125, 0),   -- Expert Fishing (skill 225)
+(20, 54083, 100000, 356, 225, 0), -- Master Fishing (skill 375)
+(20, 54084, 350000, 356, 350, 0); -- Grand Master Fishing (skill 450)
diff --git a/data/sql/world/base/vanilla_vendors.sql b/optional/sql/world/zz_optional_vanilla_vendors.sql
similarity index 100%
rename from data/sql/world/base/vanilla_vendors.sql
rename to optional/sql/world/zz_optional_vanilla_vendors.sql
-- 
