From: Claude <claude@buttzeppelin>
Date: Fri, 30 Jan 2026 06:53:56 +0000
Subject: [PATCH] Apply Zeppelin patch

---
 .gitattributes                  | 28 ++++++++++++++++++++++++++++
 src/mod_accountbound.h          | 11 ++++++-----
 src/mod_accountbound_player.cpp | 12 +++++++-----
 3 files changed, 41 insertions(+), 10 deletions(-)
 create mode 100644 .gitattributes

diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 0000000..cc02d42
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,28 @@
+# Handle line endings automatically for files detected as text
+* text=auto
+
+# Force LF line endings for these file types
+*.cpp text eol=lf
+*.hpp text eol=lf
+*.h text eol=lf
+*.c text eol=lf
+*.sql text eol=lf
+*.conf text eol=lf
+*.py text eol=lf
+*.sh text eol=lf
+*.md text eol=lf
+*.txt text eol=lf
+*.cmake text eol=lf
+*.in text eol=lf
+*.dist text eol=lf
+
+# Force binary for certain file types
+*.exe binary
+*.dll binary
+*.so binary
+*.dylib binary
+*.a binary
+*.lib binary
+*.png binary
+*.jpg binary
+*.jpeg binary
diff --git a/src/mod_accountbound.h b/src/mod_accountbound.h
index 9fcb3f8..4f82d0a 100644
--- a/src/mod_accountbound.h
+++ b/src/mod_accountbound.h
@@ -52,11 +52,12 @@ public:
     bool OnGossipHello(Player* /*player*/, Creature* /*creature*/) override;
 
