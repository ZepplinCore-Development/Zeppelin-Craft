{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeppelin-server.local/schemas/zpak.schema.json",
  "title": "Zeppelin Package Manifest",
  "description": "Schema for zpak.json manifest files",
  "type": "object",
  "required": ["name", "version", "description", "author", "type", "contents"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "name": {
      "type": "string",
      "description": "Package identifier (must match folder name)",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "description": "Semantic version (e.g., 1.0.0)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "description": "Human-readable package description"
    },
    "author": {
      "type": "string",
      "description": "Package author or maintainer"
    },
    "type": {
      "type": "string",
      "enum": ["native", "mpq", "acore-extension", "hybrid"],
      "description": "Package type determining available operations"
    },
    "acore": {
      "type": "object",
      "description": "AzerothCore module reference (required for acore-extension type)",
      "properties": {
        "module": {
          "type": "string",
          "description": "AC module name in Zeppelin-Core/modules/"
        },
        "source": {
          "type": "string",
          "format": "uri",
          "description": "Upstream git repository URL"
        },
        "branch": {
          "type": "string",
          "description": "Upstream branch to track",
          "default": "master"
        },
        "patch_mode": {
          "type": "string",
          "enum": ["single", "granular"],
          "description": "Patch strategy: single squashed patch or granular per-commit",
          "default": "single"
        }
      },
      "required": ["module", "source"]
    },
    "contents": {
      "type": "object",
      "description": "Package content declarations",
      "properties": {
        "patches": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Glob patterns for patch files"
        },
        "sql": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Glob patterns for SQL files (acore_world)"
        },
        "dbc": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Glob patterns for DBC SQL files"
        },
        "mpq": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "properties": {
                "assets": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "Directories containing MPQ assets"
                },
                "output": {
                  "type": "string",
                  "description": "Output MPQ filename (e.g., PATCH-H.MPQ)"
                }
              },
              "required": ["assets", "output"]
            }
          ],
          "description": "MPQ asset configuration"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Other zpaks that must load before this one",
      "default": []
    },
    "feature_id": {
      "type": "string",
      "pattern": "^F-\\d{3}$",
      "description": "Joplin feature ID (e.g., F-004)"
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether package is active",
      "default": true
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "description": "Load order (lower = earlier)",
      "default": 100
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"type": {"const": "acore-extension"}}
      },
      "then": {
        "required": ["acore"]
      }
    }
  ]
}
