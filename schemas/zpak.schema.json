{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeppelin-server.local/schemas/zpak.schema.json",
  "title": "Zeppelin Package Manifest",
  "description": "Schema for zpak.json manifest files",
  "type": "object",
  "required": ["name", "version", "description", "author", "type", "contents"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "name": {
      "type": "string",
      "description": "Package identifier (must match folder name)",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "description": "Semantic version (e.g., 1.0.0)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "description": "Human-readable package description"
    },
    "author": {
      "type": "string",
      "description": "Package author or maintainer"
    },
    "type": {
      "type": "string",
      "enum": ["native", "mpq", "acore-extension", "hybrid"],
      "description": "Package type determining available operations"
    },
    "acore": {
      "type": "object",
      "description": "AzerothCore module reference (required for acore-extension type)",
      "properties": {
        "module": {
          "type": "string",
          "description": "AC module name in Zeppelin-Core/modules/"
        },
        "source": {
          "type": "string",
          "format": "uri",
          "description": "Upstream git repository URL"
        },
        "branch": {
          "type": "string",
          "description": "Upstream branch to track",
          "default": "master"
        },
        "patch_mode": {
          "type": "string",
          "enum": ["single", "granular"],
          "description": "Patch strategy: single squashed patch or granular per-commit",
          "default": "single"
        }
      },
      "required": ["module", "source"]
    },
    "contents": {
      "type": "object",
      "description": "Package content declarations",
      "properties": {
        "patches": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Glob patterns for patch files"
        },
        "sql": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Glob patterns for SQL files (acore_world)"
        },
        "dbc": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Glob patterns for DBC SQL files"
        },
        "mpq": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {"type": "string"},
              "description": "Glob patterns for MPQ assets (packed into client_patch)"
            }
          ],
          "description": "MPQ asset patterns - contents go to client_patch MPQ"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Other zpaks that must load before this one",
      "default": []
    },
    "dbc_source": {
      "type": "string",
      "description": "Path to DBC files for import (relative to zpak or absolute). Used by 'zep dbc import-module' as default source location."
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[FI]-\\d{3}$",
      "description": "Primary Joplin feature/issue ID (e.g., F-004)"
    },
    "feature_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[FI]-\\d{3}$"
      },
      "description": "Multiple Joplin feature/issue IDs this zpak implements"
    },
    "client_patch": {
      "type": "string",
      "enum": ["PATCH-A", "PATCH-H", "PATCH-O", "PATCH-X", "PATCH-Z"],
      "description": "Client patch this zpak belongs to (for build orchestration)"
    },
    "build": {
      "type": "object",
      "description": "Build configuration for zpaks with generators or preprocessors",
      "properties": {
        "generator": {
          "type": "string",
          "description": "Generator to run (e.g., atlasloot-generator)"
        },
        "output_dir": {
          "type": "string",
          "description": "Output directory for generator (relative to zpak)"
        },
        "preprocessor": {
          "type": "string",
          "description": "Preprocessor to run before packing (e.g., resource-parser)"
        },
        "preprocessor_optional": {
          "type": "boolean",
          "description": "If true, preprocessor can be skipped with --quick flag",
          "default": false
        },
        "preprocessor_warning": {
          "type": "string",
          "description": "Warning message shown when preprocessor will run"
        }
      }
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether package is active",
      "default": true
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "description": "Load order (lower = earlier)",
      "default": 100
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"type": {"const": "acore-extension"}}
      },
      "then": {
        "required": ["acore"]
      }
    }
  ]
}
