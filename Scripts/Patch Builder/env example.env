# Database Configuration for Patch Builder
# Copy this file to .env and update with your actual credentials
# DO NOT COMMIT .env TO VERSION CONTROL

# Database Connection Settings
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Database Names
BACKUP_DBC_NAME=original_dbc
LIVE_DBC_NAME=dbc
EXPECTED_DBC_NAME=expected_dbc
SCRATCH_DBC_NAME=scratch_dbc
WORLD_DB_NAME=acore_world

# Root credentials for CREATE/DROP database operations (scratch_dbc)
# Required for dbc-mgr rebuild command
DB_ROOT_USER=root
DB_ROOT_PASSWORD=your_root_password

# Path Configuration (Required - update these paths for your environment)
UPDATE_DIR=Updates
BASE_DIRECTORY=Z:\pool\appdata\wow-server
SPELL_EDITOR_DIR=Z:\pool\appdata\wow-server\Zeppelin-Tools\WoW Spell Editor
MPQ_EDITOR_DIR=Z:\pool\appdata\wow-server\Zeppelin-Tools\MPQ Editor
SERVER_DATA_DIR=Z:\pool\appdata\wow-server\data\dbc
PATCH_REGISTER_PATH=Z:\pool\appdata\binhex-nginx\nginx\MPQ\patch_register.json
NGINX_BASE_PATH=Z:\pool\appdata\binhex-nginx\nginx

# Custom Item Entry Threshold
CUSTOM_ITEM_THRESHOLD=56899