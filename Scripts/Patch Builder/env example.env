# Database Configuration for Patch Builder
# Copy this file to .env and update with your actual credentials
# DO NOT COMMIT .env TO VERSION CONTROL

# Database Connection Settings
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Database Names
BACKUP_DBC_NAME=original_dbc
LIVE_DBC_NAME=dbc
WORLD_DB_NAME=acore_world

# Path Configuration (Update these paths for your environment)
UPDATE_DIR=Updates
BASE_DIRECTORY=Y:\wow-server
SPELL_EDITOR_DIR=Y:\wow-server\Zeppelin-Tools\WoW Spell Editor
MPQ_EDITOR_DIR=Y:\wow-server\Zeppelin-Tools\MPQ Editor
SERVER_DATA_DIR=Y:\wow-server\data\dbc

# Patch Register Configuration (replaces old text file system)
PATCH_REGISTER_PATH=patch_register.json
NGINX_PATCH_REGISTER_PATH=Y:\binhex-nginx\nginx\MPQ\patch_register.json
NGINX_BASE_PATH=Y:\binhex-nginx\nginx

# Legacy file list path (deprecated - now using patch_register.json)
# FILE_LIST_PATH=Y:\binhex-nginx\nginx\MPQ\mandatory\mandatory_file_list.txt

# Custom Item Entry Threshold
CUSTOM_ITEM_THRESHOLD=56899