# Resource Parser Configuration
# Lines starting with # are comments
# Paths can use forward slashes (/) or backslashes (\) without escaping

[paths]
# DBC Files
area_table_dbc = Y:\wow-server\Zeppelin-Tools\Open Azeroth\Patch-O\DBFilesClient\AreaTable.dbc
groundeffect_doodad_dbc = Y:\wow-server\Zeppelin-Tools\Open Azeroth\Patch-O\DBFilesClient\GroundEffectDoodad.dbc
groundeffect_texture_dbc = Y:\wow-server\Zeppelin-Tools\Open Azeroth\Patch-O\DBFilesClient\GroundEffectTexture.dbc

# Modern client CSV files (for validation)
modern_groundeffect_csv = Y:\wow-server\Zeppelin-Craft\Scripts\Resource Parser\data\Modern GroundEffectTexture.csv

# Asset data
wotlk_base_assets = Y:\wow-server\Zeppelin-Craft\Scripts\Resource Parser\data\wotlk_335a_merged.txt
assets_source = Y:\wow-server\Zeppelin-Tools\Asset Library\GAME ASSETS

# Export and source directories
export = Y:\wow-server\Zeppelin-Tools\Open Azeroth\Resource Parser Export
adt = Y:\wow-server\Zeppelin-Tools\Open Azeroth\Patch-O\WORLD\maps

[options]
# Skip files that already exist in export directory
skip_existing_exports = true

# Print verbose logging output
verbose = true

# Duplicate WMO detection and fixing
detect_duplicate_wmos = false
duplicate_wmo_threshold = 1.0
fix_duplicate_wmos = false
