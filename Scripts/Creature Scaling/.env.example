# Database configuration for Creature Scaling scripts
# Copy this file to .env and fill in your credentials
#
# Used by:
#   - creature_scaler.py (orchestrator)
#   - Normal Creature Convertor.py
#   - Elite Creature Scaler.py
#   - Heroic Creature Convertor.py

DB_HOST=192.168.0.55
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=acore_world
