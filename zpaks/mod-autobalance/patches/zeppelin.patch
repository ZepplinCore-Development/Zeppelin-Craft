+// Used for reading a plain comma-delimited list of creature entries from the configuration
+// file, e.g. AutoBalance.ForceBossID / AutoBalance.ForceTrashID (F-207)
+//
+std::set<uint32> LoadCreatureIdSet(std::string creatureIdString)
+{
+    std::string       delimitedValue;
+    std::stringstream creatureIdStream;
+    std::set<uint32>  creatureIdSet;
+
+    creatureIdStream.str(creatureIdString);
+
+    while (std::getline(creatureIdStream, delimitedValue, ',')) // Process each creature ID in the string, delimited by the comma - ","
+    {
+        int creatureId = atoi(delimitedValue.c_str());
+
+        if (creatureId > 0)
+            creatureIdSet.insert((uint32)creatureId);
+    }
+
+    return creatureIdSet;
+}
