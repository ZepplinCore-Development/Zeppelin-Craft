diff --git a/conf/AutoBalance.conf.dist b/conf/AutoBalance.conf.dist
index dae1e96..5a0330d 100644
--- a/conf/AutoBalance.conf.dist
+++ b/conf/AutoBalance.conf.dist
@@ -243,6 +243,44 @@ AutoBalance.InflectionPointRaid40M.CurveFloor=
 AutoBalance.InflectionPointRaid40M.CurveCeiling=
 AutoBalance.InflectionPointRaid40M.BossModifier=
 
+#
+#     AutoBalance.InflectionPoint*.PerStat
+#        Optional per-stat inflection point overrides. Lets a single stat ride its own
+#        curve instead of sharing one curve with every other stat.
+#
+#        Each value is in the same units as that instance type's own InflectionPoint
+#        setting - a fraction of the map's max player count. A value of -1, or a value
+#        omitted from the end of the string, leaves that stat on the standard
+#        inflection point.
+#
+#        The instance type's CurveFloor, CurveCeiling and BossModifier still apply on
+#        top, so an overridden stat STILL converges to full strength at max players.
+#        A per-instance AutoBalance.InflectionPoint.PerInstance override takes priority.
+#
+#        Use this when a difficulty inflates one stat more than another. TBC heroics,
+#        for example, give trash 2.2-3.5x the normal-mode DamageModifier but only ~1.35x
+#        the HealthModifier; a single shared curve cannot undo that asymmetry, and the
+#        flat StatModifier*.Damage settings that can will also weaken a full group.
+#
+#        Format: "[Health] [Mana] [Armor] [Damage] [CCDuration]"
+#
+#        Example: AutoBalance.InflectionPointHeroic.PerStat="-1 -1 -1 0.6"
+#                 (heroic 5-man damage rides an inflection point of maxPlayers * 0.6
+#                  while health, mana and armor stay on the standard 0.5)
+#
+#        Default: Empty string, which disables the feature.
+AutoBalance.InflectionPoint.PerStat=""
+AutoBalance.InflectionPointHeroic.PerStat=""
+AutoBalance.InflectionPointRaid.PerStat=""
+AutoBalance.InflectionPointRaidHeroic.PerStat=""
+AutoBalance.InflectionPointRaid10M.PerStat=""
+AutoBalance.InflectionPointRaid10MHeroic.PerStat=""
+AutoBalance.InflectionPointRaid15M.PerStat=""
+AutoBalance.InflectionPointRaid20M.PerStat=""
+AutoBalance.InflectionPointRaid25M.PerStat=""
+AutoBalance.InflectionPointRaid25MHeroic.PerStat=""
+AutoBalance.InflectionPointRaid40M.PerStat=""
+
 #
 #     AutoBalance.InflectionPoint.PerInstance
 #        Sets Inflection Point settings for specific `InstanceID`s.
@@ -704,6 +742,32 @@ AutoBalance.ForcedID2=""
 #
 AutoBalance.DisabledID=""
 
+#
+#     AutoBalance.ForceBossID
+#        Comma-delimited list of creature entries that AutoBalance should always scale as
+#        a boss, and AutoBalance.ForceTrashID the reverse. ForceTrashID wins if an entry
+#        appears in both.
+#
+#        AutoBalance classes a creature as a boss when the core has set its DUNGEON_BOSS
+#        flag. The core derives that flag *only* from `instance_encounters` rows whose
+#        encounter id also exists in DungeonEncounter.dbc, and the flag is stripped if you
+#        try to set it in the database. Bosses Blizzard never gave a DungeonEncounter row
+#        are therefore scaled as trash, e.g. The Mechanar's two Gatewatchers.
+#
+#        Summons inherit boss status from a forced boss, so forcing a summoner also covers
+#        the creatures it spawns.
+#
+#        Use the NORMAL difficulty entry - Creature::InitEntry() keeps the normal entry
+#        even in heroic, so one id covers both difficulties.
+#
+#        Format: "[CreatureID], [CreatureID], ..."
+#
+#        Example: AutoBalance.ForceBossID="19218, 19710, 17307, 21697, 21698"
+#
+#        Default: Empty string, which disables the feature.
+AutoBalance.ForceBossID=""
+AutoBalance.ForceTrashID=""
+
