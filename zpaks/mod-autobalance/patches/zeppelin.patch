+//
+// Which stat a multiplier is being generated for.
+// `AB_STAT_NONE` means "no per-stat override, use the instance type's standard inflection point".
+//
+enum AutoBalanceStatType : uint8
+{
+    AB_STAT_HEALTH = 0,
+    AB_STAT_MANA,
+    AB_STAT_ARMOR,
+    AB_STAT_DAMAGE,
+    AB_STAT_CCDURATION,
+    AB_STAT_COUNT,
+    AB_STAT_NONE = AB_STAT_COUNT
+};
+
+//
+// Optional per-stat inflection point overrides for one instance type.
+//
+// Each value is in the same units as the instance type's own `AutoBalance.InflectionPoint*`
+// setting - a fraction of the map's max player count. A value of -1 means "not overridden",
+// in which case the stat rides the standard inflection point.
+//
+// The instance type's CurveFloor, CurveCeiling and BossModifier still apply on top, so an
+// overridden stat still converges to full strength at max players.
+//
+class AutoBalancePerStatInflection
+{
+public:
+    AutoBalancePerStatInflection() {}
+
+    float values[AB_STAT_COUNT] = { -1.0f, -1.0f, -1.0f, -1.0f, -1.0f };
+
+    bool has(AutoBalanceStatType stat) const
+    {
+        return stat < AB_STAT_COUNT && values[stat] != -1.0f;
+    }
+
+    float get(AutoBalanceStatType stat) const
+    {
+        return values[stat];
+    }
+
+    bool any() const
+    {
+        for (uint8 i = 0; i < AB_STAT_COUNT; ++i)
+            if (values[i] != -1.0f)
+                return true;
+
+        return false;
+    }
+};
+
 #endif
