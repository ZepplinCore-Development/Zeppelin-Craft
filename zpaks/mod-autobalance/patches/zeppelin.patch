+//
+// Returns the default multiplier for a single stat.
+//
+// If that stat has no per-stat inflection point override configured, `fallbackMultiplier`
+// (the standard multiplier, already calculated by the caller) is returned unchanged, so
+// the default behaviour and the cost of the default behaviour are both untouched.
+//
+float getStatDefaultMultiplier(InstanceMap* instanceMap, bool isBoss, AutoBalanceStatType statType, float fallbackMultiplier)
+{
+    AutoBalancePerStatInflection const* perStat = getPerStatInflection(instanceMap);
+
+    if (!perStat || !perStat->has(statType))
+        return fallbackMultiplier;
+
+    AutoBalanceInflectionPointSettings statSettings = getInflectionPointSettings(instanceMap, isBoss, statType);
+
+    return getDefaultMultiplier(instanceMap, statSettings);
+}
