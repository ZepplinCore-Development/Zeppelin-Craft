+AutoBalancePerStatInflection LoadPerStatInflection(std::string perStatString)
+{
+    //
+    // Format: "[Health] [Mana] [Armor] [Damage] [CCDuration]"
+    // A value of -1, or a value omitted from the end of the string, leaves that stat on
+    // the instance type's standard inflection point.
+    //
+
+    AutoBalancePerStatInflection perStat;
+
+    std::stringstream perStatStream(perStatString);
+    std::string       delimitedValue;
+
+    for (uint8 i = 0; i < AB_STAT_COUNT && perStatStream >> delimitedValue; ++i)
+        perStat.values[i] = (float)atof(delimitedValue.c_str());
+
+    return perStat;
+}
