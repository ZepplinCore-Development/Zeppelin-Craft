+// ---------------------------------------------------------------------------
+// Zeppelin fork (F-208): edit journal, task attribution, rotation reconciliation.
+//
+// Upstream saves by issuing a raw UPDATE against the live world database. That
+// makes an edit untracked, unattributed and destroyed by the next content
+// regeneration. The worldserver container has no mount for the content repo
+// (docker-compose.yml: only env/dist/etc, env/dist/logs and read-only client
+// data), so the module cannot write a .sql file itself. It writes a journal row
+// instead; `zep world edits emit` drains the journal into a tagged, idempotent
+// SQL file in the right zpak.
+// ---------------------------------------------------------------------------
+
+static bool IsJournalEnabled()
+{
+    return sConfigMgr->GetOption<bool>("GObjectEditor.Journal.Enable", true);
+}
+
+static bool RequireTaskForEdits()
+{
+    return sConfigMgr->GetOption<bool>("GObjectEditor.Journal.RequireTask", true)
+        && sConfigMgr->GetOption<bool>("GObjectEditor.Journal.Enable", true);
+}
+
+static bool JournalRequiresTask()
+{
+    return sConfigMgr->GetOption<bool>("GObjectEditor.Journal.RequireTask", true);
+}
+
+// Task id (F-xxx / I-xxx) currently attached to each editing session.
+std::unordered_map<uint64, std::string> TaskIdByPlayer;
+
+// Accepts F-123, I-045, F-164D — the project's feature / issue id format,
+// including the single-letter sub-feature suffix.
+static bool IsValidTaskId(std::string const& id)
+{
+    if (id.size() < 5 || id.size() > 7)
+        return false;
+
+    if ((id[0] != 'F' && id[0] != 'I') || id[1] != '-')
+        return false;
+
+    size_t digits = 0;
+    size_t i = 2;
+    for (; i < id.size() && id[i] >= '0' && id[i] <= '9'; ++i)
+        ++digits;
+
+    if (digits != 3)
+        return false;
+
+    if (i == id.size())
+        return true;
+
+    return (i + 1 == id.size()) && id[i] >= 'A' && id[i] <= 'Z';
+}
+
+static std::string GetTaskId(Player* player)
+{
+    if (!player)
+        return "";
+
+    auto itr = TaskIdByPlayer.find(player->GetGUID().GetRawValue());
+    return itr == TaskIdByPlayer.end() ? "" : itr->second;
+}
+
+static std::string SqlEscaped(std::string value)
+{
+    WorldDatabase.EscapeString(value);
+    return value;
+}
+
+// One journal row per changed column. `oldValue` is what we believe the row held
+// before the edit — the relational form of F-203's base hash, so the emitted SQL
+// can assert what it expected to find.
+static void JournalWrite(Player* player, std::string const& op, std::string const& table,
+                         uint32 pkValue, std::string const& column,
+                         std::string const& oldValue, std::string const& newValue)
+{
+    if (!IsJournalEnabled() || !player)
+        return;
+
+    std::string const task = GetTaskId(player);
+
+    WorldDatabase.Execute(
+        "INSERT INTO `zep_edit_journal` "
+        "(`task_id`, `op`, `table_name`, `pk_name`, `pk_value`, `column_name`, "
+        "`old_value`, `new_value`, `account_id`, `character_name`) "
+        "VALUES ('{}', '{}', '{}', 'guid', {}, '{}', '{}', '{}', {}, '{}')",
+        SqlEscaped(task), SqlEscaped(op), SqlEscaped(table), pkValue, SqlEscaped(column),
+        SqlEscaped(oldValue), SqlEscaped(newValue),
+        player->GetSession() ? player->GetSession()->GetAccountId() : 0,
+        SqlEscaped(player->GetName()));
+
+    if (IsDebugEnabled())
+        LOG_INFO("module", "mod-gobject-editor journal [{}] {} {}.{} guid {}: {} -> {}",
+                 task, op, table, column, pkValue, oldValue, newValue);
+}
+
+static bool FloatDiffers(float a, float b)
+{
+    return std::fabs(a - b) > 0.00005f;
+}
+
+// Journals only the columns that actually moved, so the emitted UPDATE is a
+// minimal, reviewable diff from the row we started with.
+static void JournalGameObjectDiff(Player* player, uint32 guid,
+                                  ObjectTransform const& before, ObjectTransform const& after)
+{
+    struct Field { char const* column; float before; float after; };
+    Field const fields[] = {
+        { "position_x", before.x,  after.x  },
+        { "position_y", before.y,  after.y  },
+        { "position_z", before.z,  after.z  },
+        { "orientation", before.o, after.o  },
+        { "rotation0",  before.r0, after.r0 },
+        { "rotation1",  before.r1, after.r1 },
+        { "rotation2",  before.r2, after.r2 },
+        { "rotation3",  before.r3, after.r3 },
+    };
+
+    for (Field const& f : fields)
+        if (FloatDiffers(f.before, f.after))
+            JournalWrite(player, "update", "gameobject", guid, f.column,
+                         FloatToString(f.before), FloatToString(f.after));
+}
+
+static void JournalCreatureDiff(Player* player, uint32 guid,
+                                CreatureTransform const& before, CreatureTransform const& after)
+{
+    struct Field { char const* column; float before; float after; };
+    Field const fields[] = {
+        { "position_x", before.x, after.x },
+        { "position_y", before.y, after.y },
+        { "position_z", before.z, after.z },
+        { "orientation", before.o, after.o },
+    };
+
+    for (Field const& f : fields)
+        if (FloatDiffers(f.before, f.after))
+            JournalWrite(player, "update", "creature", guid, f.column,
+                         FloatToString(f.before), FloatToString(f.after));
+}
+
+// A newly placed spawn is recorded as a single marker row; the emitter snapshots
+// the whole live row and writes a DELETE + INSERT for it.
+static void JournalSpawnInsert(Player* player, std::string const& table, uint32 guid, uint32 entry)
+{
+    JournalWrite(player, "insert", table, guid, "*", "", std::to_string(entry));
+}
+
+static void JournalSpawnDelete(Player* player, std::string const& table, uint32 guid, uint32 entry)
+{
+    JournalWrite(player, "delete", table, guid, "*", std::to_string(entry), "");
+}
+
+// I-359: a `(0,0,0,1)` rotation is the IDENTITY quaternion and a valid unit
+// quaternion, so ObjectMgr::LoadGameObjects uses it verbatim and never consults
+// `orientation` (its fallback only fires for a NON-unit quaternion). The object
+// therefore renders at 0 rad while the row claims some other facing. Upstream's
+// NormalizeQuaternion only rescues a zero-length quaternion, so it would load the
+// identity as-is and the first save would bake the disagreement in permanently.
+//
+// Deliberately non-destructive: the mismatch is reported, never silently
+// corrected, because the quaternion is what the player can actually see. FIX_ROT
+// applies the repair explicitly.
+static bool TransformRotationMismatch(ObjectTransform const& t, float& renderedYaw)
+{
+    float const length = std::sqrt(t.r0 * t.r0 + t.r1 * t.r1 + t.r2 * t.r2 + t.r3 * t.r3);
+    if (length <= 0.000001f)
+        return false;   // degenerate; NormalizeQuaternion derives it from `o` anyway
+
+    if (std::fabs(t.r0) > 0.0001f || std::fabs(t.r1) > 0.0001f)
+        return false;   // genuinely tilted on X/Y — `orientation` cannot describe it
+
+    renderedYaw = NormalizeAngle(2.0f * std::atan2(t.r2 / length, t.r3 / length));
+
+    float delta = std::fabs(NormalizeAngle(renderedYaw) - NormalizeAngle(t.o));
+    if (delta > static_cast<float>(M_PI))
+        delta = static_cast<float>(M_PI * 2.0) - delta;
+
+    return delta > 0.01f;   // ~0.57 degrees
+}
+
+static void ReportRotationMismatch(Player* player, ObjectTransform const& t)
+{
+    float renderedYaw = 0.0f;
+    if (!TransformRotationMismatch(t, renderedYaw))
+        return;
+
+    SendAddonPayload(player, "WARN:ROTATION_MISMATCH:" + FloatToString(renderedYaw) + ":" + FloatToString(t.o));
+}
+
+// Every mutating action is attributable. Without a task id an edit cannot be
+// emitted into a `zz_[F/I-xxx]_*.sql` file, so refuse it at the door rather than
+// discovering it at drain time.
+static bool RequireTask(Player* player, char const* failOpcode)
+{
+    if (!JournalRequiresTask() || !IsJournalEnabled())
+        return true;
+
+    if (!GetTaskId(player).empty())
+        return true;
+
+    SendAddonPayload(player, std::string(failOpcode) + ":NO_TASK_ID_SET");
+    return false;
+}
