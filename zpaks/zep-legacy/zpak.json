{
  "$schema": "../../schemas/zpak.schema.json",
  "name": "zep-legacy",
  "version": "1.0.0",
  "description": "Legacy custom SQL and DBC files pending reorganization into feature zpaks",
  "author": "Zeppelin Team",
  "type": "native",
  "client_patch": "PATCH-Z",
  "patch_display_name": "Zepcraft",
  "launcher": {
    "requires": []
  },
  "feature_id": "F-044",
  "build": {
    "preprocessors": [
      "model-transforms",
      "item-dbc-sync",
      "dbc-export",
      "trs-generate"
    ],
    "force_parse": true
  },
  "contents": {
    "sql": [
      "sql/**/*.sql"
    ],
    "dbc": [
      "dbc/*.sql"
    ],
    "mpq": [
      "mpq/**/*"
    ]
  },
  "enabled": true,
  "priority": 900,
  "disabled_features": [
    "F-049"
  ]
}