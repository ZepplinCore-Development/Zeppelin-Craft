From fecc90db2cccf5b938e42baaf3bead08bc943910 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sun, 20 Sep 2026 06:34:13 +0000
Subject: [PATCH 05/14] fix: F-211 - skip attachments the archives do not have

Crash on boot: #132 at 0x004B51A0 (Wow.exe, null object) after the module built
Item\ObjectComponents\Chest\Helm_Leather_A_01Green - a HEAD display arrived with a
model-slot index that maps to Chest in kSlotCfg on the character-select screen, so
the path named a file no archive holds and the client crashed on the null result.

ClientModelExists() opens the built path through the client's archive IO (accepting
the .mdx spelling the DBC uses as well as .m2) and skips the attach when it is
missing, so a wrong slot mapping or junk model data in a stock row is a skipped
model rather than a crash.

[EquipExtension] Enabled (default 1) stays as the client-side kill switch.
---
 src/EquipExtension.cpp | 93 +++++++++++++++++++++++++++++++-----------
 1 file changed, 70 insertions(+), 23 deletions(-)

diff --git a/src/EquipExtension.cpp b/src/EquipExtension.cpp
index 1bd499b..d48ee99 100644
--- a/src/EquipExtension.cpp
+++ b/src/EquipExtension.cpp
@@ -20,6 +20,7 @@
 #include "core/SehCompat.hpp"
 #include "events/Event.hpp"
 #include "game/Binding.hpp"
+#include "game/io/Io.hpp"
 #include "game/m2/M2.hpp"
 #include "offsets/game/DB2.hpp"
 #include "offsets/game/M2.hpp"
@@ -153,7 +154,7 @@ namespace wxl::scripts::equipextension
     static settings::BoolSetting g_enabledSetting(
         "EquipExtension", "Enabled",
         "Attach item M2 models (collections, belt buckles, extra slots) from ItemDisplayInfo. "
-        "Set to 0 to disable the module without a rebuild.",
+        "Set to 0 to disable the module on this client without a rebuild.",
         true);
 
     // Append a line to WarcraftXL_equip.log in the game directory.
@@ -195,6 +196,38 @@ namespace wxl::scripts::equipextension
         return true;
     }
 
+    // The module honours model fields on slots the stock client ignores, and the dispatch slot
+    // index does not always line up with kSlotCfg above: on the character-select screen a HEAD
+    // display arrived as slot 3 (Chest), building "Item\ObjectComponents\Chest\Helm_Leather_
+    // A_01Green" - a path no archive has, after which the client crashed on the null result
+    // (#132 at 0x004B51A0 reading 0x0C, Zeppelin 2026-09-20). Never hand the engine a path the
+    // archives do not contain; a missing model is a skipped attach, not a crash.
+    static bool ClientFileExists(const char* path) noexcept
+    {
+        if (!path || !*path) return false;
+        void* h = nullptr;
+        game::io::FileOpen(path, 0, &h);
+        if (!h) return false;
+        game::io::FileClose(h);
+        return true;
+    }
+
+    // Accepts the .mdx spelling the DBC uses as well as the .m2 the archives hold.
+    static bool ClientModelExists(const char* path) noexcept
+    {
+        if (ClientFileExists(path)) return true;
+        char alt[264] = {};
+        size_t n = 0;
+        while (path[n] && n < sizeof(alt) - 1) { alt[n] = path[n]; ++n; }
+        if (n > 4 && (alt[n-3] == 'd' || alt[n-3] == 'D'))   // ".mdx" -> ".m2"
+        {
+            alt[n-3] = '2'; alt[n-2] = '\0';
+            alt[n-4] = alt[n-4] == 'M' ? 'M' : 'm';
+            return ClientFileExists(alt);
+        }
+        return false;
+    }
+
     // ─── Guarded reads: MemReadable probe + (MSVC only) a real SEH guard ─────────
 
     static uint32_t GuardedReadU32(const void* ptr) noexcept
@@ -1045,17 +1078,24 @@ namespace wxl::scripts::equipextension
                 BuildTexPath(texPath1, sizeof(texPath1), texName1, raceCode, genderStr,
                              ef1, cfg.folder, isCol1, customFolder, stem1);
 
-            EquipLog("  M1: attach=%u path='%s' tex='%s' geoCount=%u",
-                     attachA, m1Path, texPath1[0] ? texPath1 : "(none)", geo1.count);
-
-            AttachEntry e1 = {};
-            e1.equipSlot = a.modelSlot;
-            e1.attachId  = attachA;
-            e1.subObj    = subObj;
-            std::memcpy(e1.keyBuf, m1Path,   sizeof(e1.keyBuf));
-            std::memcpy(e1.texBuf, texPath1, sizeof(e1.texBuf));
-            e1.geoFilter = geo1;
-            g_attached[cmo].push_back(e1);
+            if (!ClientModelExists(m1Path))
+            {
+                EquipLog("  M1: SKIP, archives have no '%s' (model slot %u)", m1Path, a.modelSlot);
+            }
+            else
+            {
+                EquipLog("  M1: attach=%u path='%s' tex='%s' geoCount=%u",
+                         attachA, m1Path, texPath1[0] ? texPath1 : "(none)", geo1.count);
+
+                AttachEntry e1 = {};
+                e1.equipSlot = a.modelSlot;
+                e1.attachId  = attachA;
+                e1.subObj    = subObj;
+                std::memcpy(e1.keyBuf, m1Path,   sizeof(e1.keyBuf));
+                std::memcpy(e1.texBuf, texPath1, sizeof(e1.texBuf));
+                e1.geoFilter = geo1;
+                g_attached[cmo].push_back(e1);
+            }
         }
         else
         {
@@ -1078,17 +1118,24 @@ namespace wxl::scripts::equipextension
                 BuildTexPath(texPath2, sizeof(texPath2), texName2, raceCode, genderStr,
                              ef2, cfg.folder, isCol2, customFolder, stem2);
 
-            EquipLog("  M2: attach=%u path='%s' tex='%s' geoCount=%u",
