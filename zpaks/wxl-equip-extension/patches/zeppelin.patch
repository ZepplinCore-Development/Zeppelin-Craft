From 37feb58e10ef32a8416df0064b5012db693b8a37 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sun, 20 Sep 2026 11:07:14 +0000
Subject: [PATCH 08/14] perf: F-211 - memoise the memory probe per page per
 frame

The MemReadable probe added to the guarded readers runs several times per attached
NPC inside the per-frame loops, and a VirtualQuery each time cost Thrall's throne
room 120 -> 20 fps. Answers are now cached per page in a 64-entry direct-mapped
table, valid for the current frame only: a page cannot be unmapped and remapped
between two reads within one frame, and the epoch bumps on every per-frame tick so
anything freed since the last frame is re-queried.
---
 src/EquipExtension.cpp | 42 +++++++++++++++++++++++++++++++-----------
 1 file changed, 31 insertions(+), 11 deletions(-)

diff --git a/src/EquipExtension.cpp b/src/EquipExtension.cpp
index 3f178f4..bedf2e9 100644
--- a/src/EquipExtension.cpp
+++ b/src/EquipExtension.cpp
@@ -177,23 +177,42 @@ namespace wxl::scripts::equipextension
     // UNGUARDED in the llvm-mingw build (core/SehCompat.hpp). A stale model pointer that passes
     // the non-null / >64 KB checks is then a hard client crash instead of a swallowed fault
     // (#132 at 0x...5996, the bone-remap CRC walk, 2026-09-20). Probe the whole range first.
+    // A VirtualQuery per read is far too slow here: these helpers run in the per-frame loops,
+    // several times per attached NPC, and Thrall's throne room dropped from 120 to 20 fps
+    // (Zeppelin 2026-09-20). Answers are memoised per page for the current frame - a page cannot
+    // be unmapped and re-mapped between two reads inside one frame, and the cache is dropped at
+    // every per-frame tick, so a page freed since the last frame is re-queried.
+    static uint32_t g_probeEpoch = 0;
+
+    static bool PageReadable(uintptr_t page) noexcept
+    {
+        struct Entry { uintptr_t page; uint32_t epoch; bool ok; };
+        static Entry cache[64] = {};
+        Entry& slot = cache[(page >> 12) & 63];
+        if (slot.page == page && slot.epoch == g_probeEpoch) return slot.ok;
+
+        MEMORY_BASIC_INFORMATION mbi{};
+        bool ok = false;
+        if (VirtualQuery(reinterpret_cast<LPCVOID>(page), &mbi, sizeof(mbi)) == sizeof(mbi))
+        {
+            constexpr DWORD kReadable = PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY |
+                                        PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
+            ok = mbi.State == MEM_COMMIT && (mbi.Protect & kReadable) &&
+                 !(mbi.Protect & (PAGE_GUARD | PAGE_NOACCESS));
+        }
+        slot = { page, g_probeEpoch, ok };
+        return ok;
+    }
+
     static bool MemReadable(const void* p, size_t bytes) noexcept
     {
         if (!p || bytes == 0) return false;
-        auto addr = reinterpret_cast<uintptr_t>(p);
+        const uintptr_t addr = reinterpret_cast<uintptr_t>(p);
         if (addr < 0x10000) return false;
         const uintptr_t end = addr + bytes;
         if (end < addr) return false;
-        constexpr DWORD kReadable = PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY |
-                                    PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
-        while (addr < end)
-        {
-            MEMORY_BASIC_INFORMATION mbi{};
-            if (VirtualQuery(reinterpret_cast<LPCVOID>(addr), &mbi, sizeof(mbi)) != sizeof(mbi)) return false;
-            if (mbi.State != MEM_COMMIT) return false;
-            if (!(mbi.Protect & kReadable) || (mbi.Protect & (PAGE_GUARD | PAGE_NOACCESS))) return false;
-            addr = reinterpret_cast<uintptr_t>(mbi.BaseAddress) + mbi.RegionSize;
-        }
+        for (uintptr_t page = addr & ~uintptr_t(0xFFF); page < end; page += 0x1000)
+            if (!PageReadable(page)) return false;
         return true;
     }
 
@@ -1178,6 +1197,7 @@ namespace wxl::scripts::equipextension
     void EquipExtension::OnM2PerFrameUpdate(const ev::M2PerFrameUpdateArgs& a)
     {
         void* renderCtx = a.renderCtx;
+        ++g_probeEpoch;               // drop the page-probe memo; see PageReadable
         if (g_attached.empty()) return;
 
         // Purge dead CMOs: cmo->sceneNode is zeroed when WoW frees the character model object.
