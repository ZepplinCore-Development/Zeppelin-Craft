From 51ff8156c6a91b936981a59b66da0ebda60bd68c Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sun, 20 Sep 2026 02:07:29 +0000
Subject: [PATCH 2/5] fix: F-211 - probe memory before the pointer walks the
 mingw build cannot guard

The five call-wrapping SEH guards run unguarded on llvm-mingw (clang cannot emit a
32-bit SEH funclet around a call), so a stale model pointer that passes the non-null
and >64KB checks is a hard client crash instead of a swallowed fault: #132
ACCESS_VIOLATION in BuildBoneRemap's bone-name-CRC walk, on login, with a stock
shoulder texture on the stack.

MemReadable() walks VirtualQuery over the whole range and is applied to the render
context -> model -> header chain, both bone arrays, the bone-index LUT, the skin's
index/submesh arrays and the model path stem; the render-context lookup probes its
owner object first. Also adds an [EquipExtension] Enabled ini setting (default on)
so a server can disable the module client-side without a rebuild.
---
 src/EquipExtension.cpp | 58 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/src/EquipExtension.cpp b/src/EquipExtension.cpp
index 0cd7059..270bd90 100644
--- a/src/EquipExtension.cpp
+++ b/src/EquipExtension.cpp
@@ -148,6 +148,13 @@ namespace wxl::scripts::equipextension
         "grows to 100+ MB during normal play. Set to 1 only when diagnosing bone/attach issues.",
         false);
 
+    // Kill switch: lets a server disable the module client-side without a rebuild.
+    static settings::BoolSetting g_enabledSetting(
+        "EquipExtension", "Enabled",
+        "Attach item M2 models (collections, belt buckles, extra slots) from ItemDisplayInfo. "
+        "Set to 0 to disable the module without a rebuild.",
+        true);
+
     // Append a line to WarcraftXL_equip.log in the game directory.
     static void EquipLog(const char* fmt, ...) noexcept
     {
@@ -162,6 +169,31 @@ namespace wxl::scripts::equipextension
         std::fclose(f);
     }
 
+    // ─── Memory probe: what the SEH guard did on MSVC (Zeppelin F-195/F-211) ─────
+    // clang cannot emit a 32-bit SEH funclet around a call, so the guards that wrap calls run
+    // UNGUARDED in the llvm-mingw build (core/SehCompat.hpp). A stale model pointer that passes
+    // the non-null / >64 KB checks is then a hard client crash instead of a swallowed fault
+    // (#132 at 0x...5996, the bone-remap CRC walk, 2026-09-20). Probe the whole range first.
+    static bool MemReadable(const void* p, size_t bytes) noexcept
+    {
+        if (!p || bytes == 0) return false;
+        auto addr = reinterpret_cast<uintptr_t>(p);
+        if (addr < 0x10000) return false;
+        const uintptr_t end = addr + bytes;
+        if (end < addr) return false;
+        constexpr DWORD kReadable = PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY |
+                                    PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
+        while (addr < end)
+        {
+            MEMORY_BASIC_INFORMATION mbi{};
+            if (VirtualQuery(reinterpret_cast<LPCVOID>(addr), &mbi, sizeof(mbi)) != sizeof(mbi)) return false;
+            if (mbi.State != MEM_COMMIT) return false;
+            if (!(mbi.Protect & kReadable) || (mbi.Protect & (PAGE_GUARD | PAGE_NOACCESS))) return false;
+            addr = reinterpret_cast<uintptr_t>(mbi.BaseAddress) + mbi.RegionSize;
+        }
+        return true;
+    }
+
     // ─── SEH helpers (no C++ objects — safe to use __try/__except) ───────────────
 
     static uint32_t GuardedReadU32(const void* ptr) noexcept
@@ -188,6 +220,7 @@ namespace wxl::scripts::equipextension
     static void* SafeGetRenderCtx(void* owner28, const char* keyBuf) noexcept
     {
         void* result = nullptr;
+        if (!MemReadable(owner28, 8)) return nullptr;   // dangling hash-table bucket (see above)
         WXL_SEH_TRY { result = gm2::GetRenderCtx(owner28, const_cast<char*>(keyBuf)); }
         WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) {}
         return result;
@@ -203,15 +236,21 @@ namespace wxl::scripts::equipextension
         {
             auto* collBytes = reinterpret_cast<uint8_t*>(collRc);
             auto* charBytes = reinterpret_cast<uint8_t*>(charRc);
+            if (!MemReadable(collBytes + m2::kOffInstModel, sizeof(void*)) ||
+                !MemReadable(charBytes + m2::kOffInstModel, sizeof(void*))) return r;
 
             void* collM2  = *reinterpret_cast<void**>(collBytes + m2::kOffInstModel);
             void* charM2  = *reinterpret_cast<void**>(charBytes + m2::kOffInstModel);
             if (!collM2 || !charM2) return r;
+            if (!MemReadable(reinterpret_cast<uint8_t*>(collM2) + m2::kOffModelHeader, sizeof(void*)) ||
+                !MemReadable(reinterpret_cast<uint8_t*>(charM2) + m2::kOffModelHeader, sizeof(void*))) return r;
 
             // M2AnimData = raw M2 file buffer = M2FileHeader (at m2_inst+0x150)
             auto* collHdr = *reinterpret_cast<uint8_t**>(reinterpret_cast<uint8_t*>(collM2) + m2::kOffModelHeader);
             auto* charHdr = *reinterpret_cast<uint8_t**>(reinterpret_cast<uint8_t*>(charM2) + m2::kOffModelHeader);
             if (!collHdr || !charHdr) return r;
+            // the header fields read below live inside the first 0x100 bytes of the file buffer
+            if (!MemReadable(collHdr, 0x100) || !MemReadable(charHdr, 0x100)) return r;
 
             uint32_t collN    = *reinterpret_cast<uint32_t*>(collHdr + m2::kOffHdrBoneCount);
             uint8_t* collBase = *reinterpret_cast<uint8_t**>(collHdr + m2::kOffHdrBoneArray);
@@ -235,6 +274,20 @@ namespace wxl::scripts::equipextension
             if (!collBase || collN == 0 || collN > 256) return r;
             if (reinterpret_cast<uintptr_t>(collBase) < kMinValidPtr ||
                 reinterpret_cast<uintptr_t>(charBase) < kMinValidPtr) return r;
+            // A freed/not-yet-fixed-up model keeps a plausible-looking pointer: probe the arrays.
+            if (charN == 0 || charN > 4096) return r;
+            if (!MemReadable(collBase, static_cast<size_t>(collN) * m2::kBoneStride) ||
+                !MemReadable(charBase, static_cast<size_t>(charN) * m2::kBoneStride))
+            {
+                EquipLog("  BuildBoneRemap: bone array not readable (collBase=%p collN=%u charBase=%p charN=%u)",
+                         collBase, collN, charBase, charN);
+                return r;
+            }
+            if (charLut && (charLutN > 0x1000 || !MemReadable(charLut, static_cast<size_t>(charLutN) * sizeof(int16_t))))
+            {
+                charLut = nullptr;
+                charLutN = 0;
+            }
             r.count = static_cast<uint16_t>(collN);
 
             // Pass 1a: bone name CRC match for remaining unmatched bones
@@ -502,7 +555,10 @@ namespace wxl::scripts::equipextension
         if (!skin || filter.count == 0) return;
         WXL_SEH_TRY
         {
+            if (!MemReadable(skin, sizeof(*skin))) return;
             if (!skin->indices || !skin->submeshes || skin->submeshCount == 0) return;
+            if (!MemReadable(skin->submeshes, static_cast<size_t>(skin->submeshCount) * sizeof(*skin->submeshes)) ||
+                !MemReadable(skin->indices, static_cast<size_t>(skin->indexCount) * sizeof(*skin->indices))) return;
             EquipLog("  ApplyRawTriFilter: submeshCount=%u indexCount=%u filter=[%u %u %u %u](n=%u)",
                      skin->submeshCount, skin->indexCount,
                      filter.count > 0 ? filter.ids[0] : 0,
@@ -1364,6 +1420,7 @@ namespace wxl::scripts::equipextension
         {
             const char* modelStem = reinterpret_cast<const char*>(
                 reinterpret_cast<uint8_t*>(model) + m2::kOffModelPathStem);
+            if (!MemReadable(modelStem, 1)) return;
             // Sanity-check: first char must be printable ASCII (path starts with 'I' for
             // Item\... paths). Garbage pointers or uninitialised memory fail this check.
             if (!modelStem || static_cast<unsigned char>(modelStem[0]) < 0x20
@@ -1494,6 +1551,7 @@ namespace wxl::scripts::equipextension
 
     EquipExtension::EquipExtension()
     {
+        if (!g_enabledSetting.Value()) return;   // kill switch: bind nothing, module stays inert
         on<&EquipExtension::OnItemSlotChange>(ev::Event::OnItemSlotChange);
         on<&EquipExtension::OnItemSlotClear>(ev::Event::OnItemSlotClear);
         on<&EquipExtension::OnM2SkinFinalize>(ev::Event::OnM2SkinFinalize);
-- 
