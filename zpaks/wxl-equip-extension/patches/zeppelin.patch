+    static const WXL_PluginInfo info = {
+        sizeof(WXL_PluginInfo),
+        WXL_API_VERSION,
+        "wxl-equip-extension",
+        1,
+        WXL_CLIENT_BUILD,
+    };
+    return &info;
+}
+
+int __cdecl WXL_Load(const WXL_Api* api)
+{
+    if (!api || api->apiVersion != WXL_API_VERSION) return 0;
+
+    wxl::ext::EventScript::Bind(api);
+    if (!wxl::scripts::equipextension::VPathInstall(api))
+        api->Log(WXL_LOG_WARN, "wxl-equip-extension",
+                 "core publishes no wxl.storage service; collection models cannot be served");
+    wxl::scripts::equipextension::EquipExtension::Install();
+
+    api->Log(WXL_LOG_INFO, "wxl-equip-extension", "equip extension ready");
+    return 1;
+}
