From 6c17b0ba3da6964cc21dc7df5873577825e3a3c8 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sun, 20 Sep 2026 02:28:54 +0000
Subject: [PATCH 3/5] fix: F-211 - probe in the guarded readers too (the read
 guard is inert on mingw)

#132 on logout inside GuardedReadPtr: clang compiles __try around a plain memory
read without erroring, but the guard does not protect - the helper is emitted as a
bare dereference (23 call sites). Both readers now MemReadable-probe first and use
the core's SEH shim, so MSVC keeps a real guard and the mingw build relies on the
probe. Corrects the assumption in core/SehCompat.hpp that memory-access guards
'remain fully protective on every toolchain'.
---
 src/EquipExtension.cpp | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/src/EquipExtension.cpp b/src/EquipExtension.cpp
index 270bd90..3e0d3d1 100644
--- a/src/EquipExtension.cpp
+++ b/src/EquipExtension.cpp
@@ -194,21 +194,25 @@ namespace wxl::scripts::equipextension
         return true;
     }
 
-    // ─── SEH helpers (no C++ objects — safe to use __try/__except) ───────────────
+    // ─── Guarded reads: MemReadable probe + (MSVC only) a real SEH guard ─────────
 
     static uint32_t GuardedReadU32(const void* ptr) noexcept
     {
+        // The __try below is inert on llvm-mingw even around a plain read (proved by a #132 in
+        // this helper on logout, 2026-09-20), so probe first. On MSVC both layers apply.
+        if (!MemReadable(ptr, sizeof(uint32_t))) return 0;
         uint32_t v = 0;
-        __try { v = *static_cast<const uint32_t*>(ptr); }
-        __except (EXCEPTION_EXECUTE_HANDLER) {}
+        WXL_SEH_TRY { v = *static_cast<const uint32_t*>(ptr); }
+        WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) {}
         return v;
     }
 
     static void* GuardedReadPtr(const void* addr) noexcept
     {
+        if (!MemReadable(addr, sizeof(void*))) return nullptr;
         void* v = nullptr;
-        __try { v = *static_cast<void* const*>(addr); }
-        __except (EXCEPTION_EXECUTE_HANDLER) {}
+        WXL_SEH_TRY { v = *static_cast<void* const*>(addr); }
+        WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) {}
         return v;
     }
 
-- 
