From e415e814c3b2f4a8434771c27b37dfc151a32ef1 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sun, 20 Sep 2026 00:41:29 +0000
Subject: [PATCH 1/2] fix: F-195 - shim call-guarding SEH for the llvm-mingw
 i686 build

clang cannot codegen a 32-bit SEH funclet around a call, so the five guards that
wrap calls (CrashHandler's memcpy, SafeGetRenderCtx, BuildBoneRemapGuarded,
ApplyRawTriFilter, OnM2SkinFinalize) use the core's WXL_SEH_TRY/WXL_SEH_EXCEPT
shim from core/SehCompat.hpp. The three guards around pure memory reads are
unchanged and stay fully protective.
---
 src/CrashReporter.cpp  |  5 +++--
 src/EquipExtension.cpp | 17 +++++++++--------
 2 files changed, 12 insertions(+), 10 deletions(-)

diff --git a/src/CrashReporter.cpp b/src/CrashReporter.cpp
index 380928d..f547f73 100644
--- a/src/CrashReporter.cpp
+++ b/src/CrashReporter.cpp
@@ -17,6 +17,7 @@
 // Toggle: [CrashReporter] Enabled in WTF\WXL\WarcraftXL.ini (see Settings.hpp).
 // Set to 0 to disable (e.g. when running under a debugger).
 
+#include "core/SehCompat.hpp"
 #include "Settings.hpp"
 
 #include <windows.h>
@@ -37,7 +38,7 @@ namespace wxl::scripts::equipextension
         uint32_t espVal = 0, espPlus4 = 0, espPlus8 = 0;
         uint8_t  eipBytes[8] = {};
 
-        __try
+        WXL_SEH_TRY
         {
             ebpMinus4 = *reinterpret_cast<uint32_t*>(ctx->Ebp - 4);
             ecxPlus20 = *reinterpret_cast<uint32_t*>(ctx->Ecx + 0x20);
@@ -55,7 +56,7 @@ namespace wxl::scripts::equipextension
 
             std::memcpy(eipBytes, reinterpret_cast<void*>(static_cast<uintptr_t>(ctx->Eip)), 8);
         }
-        __except (EXCEPTION_EXECUTE_HANDLER) {}
+        WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) {}
 
         char msg[2048];
         std::snprintf(msg, sizeof(msg),
diff --git a/src/EquipExtension.cpp b/src/EquipExtension.cpp
index ae95e77..0cd7059 100644
--- a/src/EquipExtension.cpp
+++ b/src/EquipExtension.cpp
@@ -17,6 +17,7 @@
 #include "EquipExtension.hpp"
 #include "Settings.hpp"
 #include "VirtualPath.hpp"
+#include "core/SehCompat.hpp"
 #include "events/Event.hpp"
 #include "game/Binding.hpp"
 #include "game/m2/M2.hpp"
@@ -187,8 +188,8 @@ namespace wxl::scripts::equipextension
     static void* SafeGetRenderCtx(void* owner28, const char* keyBuf) noexcept
     {
         void* result = nullptr;
-        __try { result = gm2::GetRenderCtx(owner28, const_cast<char*>(keyBuf)); }
-        __except (EXCEPTION_EXECUTE_HANDLER) {}
+        WXL_SEH_TRY { result = gm2::GetRenderCtx(owner28, const_cast<char*>(keyBuf)); }
+        WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) {}
         return result;
     }
 
@@ -198,7 +199,7 @@ namespace wxl::scripts::equipextension
     {
         BoneRemap r = {};
         std::memset(r.collToChar, 0xFF, sizeof(r.collToChar));
-        __try
+        WXL_SEH_TRY
         {
             auto* collBytes = reinterpret_cast<uint8_t*>(collRc);
             auto* charBytes = reinterpret_cast<uint8_t*>(charRc);
@@ -311,7 +312,7 @@ namespace wxl::scripts::equipextension
                 if (matched == 0) r.count = 0;
             }
         }
-        __except (EXCEPTION_EXECUTE_HANDLER) {}
+        WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) {}
         return r;
     }
 
@@ -499,7 +500,7 @@ namespace wxl::scripts::equipextension
     static void ApplyRawTriFilter(gm2::M2SkinProfile* skin, const GeosetFilter& filter) noexcept
     {
         if (!skin || filter.count == 0) return;
-        __try
+        WXL_SEH_TRY
         {
             if (!skin->indices || !skin->submeshes || skin->submeshCount == 0) return;
             EquipLog("  ApplyRawTriFilter: submeshCount=%u indexCount=%u filter=[%u %u %u %u](n=%u)",
@@ -532,7 +533,7 @@ namespace wxl::scripts::equipextension
                 }
             }
         }
-        __except (EXCEPTION_EXECUTE_HANDLER) {}
+        WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) {}
     }
 
     // ─── Detach / rebuild ─────────────────────────────────────────────────────────
@@ -1359,7 +1360,7 @@ namespace wxl::scripts::equipextension
         auto it2 = g_attached.find(g_currentRebuildCmo);
         if (it2 == g_attached.end()) return;
 
-        __try
+        WXL_SEH_TRY
         {
             const char* modelStem = reinterpret_cast<const char*>(
                 reinterpret_cast<uint8_t*>(model) + m2::kOffModelPathStem);
@@ -1419,7 +1420,7 @@ namespace wxl::scripts::equipextension
                 if (skin) ApplyRawTriFilter(skin, merged);
             }
         }
-        __except (EXCEPTION_EXECUTE_HANDLER) {}
+        WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) {}
     }
 
     // ─── OnBuildBonePalette ───────────────────────────────────────────────────────
-- 
