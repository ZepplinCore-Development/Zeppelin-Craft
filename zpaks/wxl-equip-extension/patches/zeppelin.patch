From 6c17b0ba3da6964cc21dc7df5873577825e3a3c8 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sun, 20 Sep 2026 02:28:54 +0000
Subject: [PATCH 03/14] fix: F-211 - probe in the guarded readers too (the read
 guard is inert on mingw)

#132 on logout inside GuardedReadPtr: clang compiles __try around a plain memory
read without erroring, but the guard does not protect - the helper is emitted as a
bare dereference (23 call sites). Both readers now MemReadable-probe first and use
the core's SEH shim, so MSVC keeps a real guard and the mingw build relies on the
probe. Corrects the assumption in core/SehCompat.hpp that memory-access guards
'remain fully protective on every toolchain'.
---
 src/EquipExtension.cpp | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/src/EquipExtension.cpp b/src/EquipExtension.cpp
index 270bd90..3e0d3d1 100644
--- a/src/EquipExtension.cpp
+++ b/src/EquipExtension.cpp
@@ -194,21 +194,25 @@ namespace wxl::scripts::equipextension
         return true;
     }
 
-    // ─── SEH helpers (no C++ objects — safe to use __try/__except) ───────────────
+    // ─── Guarded reads: MemReadable probe + (MSVC only) a real SEH guard ─────────
 
     static uint32_t GuardedReadU32(const void* ptr) noexcept
     {
+        // The __try below is inert on llvm-mingw even around a plain read (proved by a #132 in
+        // this helper on logout, 2026-09-20), so probe first. On MSVC both layers apply.
+        if (!MemReadable(ptr, sizeof(uint32_t))) return 0;
         uint32_t v = 0;
-        __try { v = *static_cast<const uint32_t*>(ptr); }
-        __except (EXCEPTION_EXECUTE_HANDLER) {}
+        WXL_SEH_TRY { v = *static_cast<const uint32_t*>(ptr); }
+        WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) {}
         return v;
     }
 
     static void* GuardedReadPtr(const void* addr) noexcept
     {
+        if (!MemReadable(addr, sizeof(void*))) return nullptr;
         void* v = nullptr;
-        __try { v = *static_cast<void* const*>(addr); }
-        __except (EXCEPTION_EXECUTE_HANDLER) {}
+        WXL_SEH_TRY { v = *static_cast<void* const*>(addr); }
+        WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) {}
         return v;
     }
 
-- 
2.34.1


From 68bc21c82675ae90bfef84fc35942448da83398e Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sun, 20 Sep 2026 02:48:12 +0000
Subject: [PATCH 04/14] fix: F-211 - drop attachments stamped with a stale
 scene node (equipment bleed)

The dead-CMO purge only fires if a frame runs between WoW freeing a
CharModelObject and reusing that address. When the address is recycled within the
frame, the previous character's entries survive and its models attach to the new
one - an Orgrimmar Grunt appeared wearing the Kor'kron Elite helm (display 22855).
Each entry already stamps the scene node it was built for, so an entry whose stamp
is not the CMO's current scene node cannot belong to the character now at that
address; the per-frame purge drops those.
---
 src/EquipExtension.cpp | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/src/EquipExtension.cpp b/src/EquipExtension.cpp
index 3e0d3d1..1bd499b 100644
--- a/src/EquipExtension.cpp
+++ b/src/EquipExtension.cpp
@@ -26,6 +26,7 @@
 
 #include <windows.h>
 
+#include <algorithm>
 #include <cstddef>
 #include <cstdio>
 #include <cstdint>
@@ -1122,8 +1123,22 @@ namespace wxl::scripts::equipextension
         for (auto it = g_attached.begin(); it != g_attached.end(); )
         {
             void* sub = GuardedReadPtr(reinterpret_cast<uint8_t*>(it->first) + m2::kOffCmoSceneNode);
-            if (!sub) { VPathEvictCmo(it->first); it = g_attached.erase(it); }
-            else      ++it;
+            if (!sub) { VPathEvictCmo(it->first); it = g_attached.erase(it); continue; }
+            // The zeroed-sceneNode check above only fires if a frame runs between the free and the
+            // reuse of this address. When WoW recycles a CMO within the frame, the entries stamped
+            // with the PREVIOUS character's scene node survive and its models bleed onto the new
+            // one (Zeppelin: an Orgrimmar Grunt wearing the Kor'kron Elite helm, 2026-09-20).
+            // An entry whose stamped scene node is not this CMO's current one cannot belong to it.
+            auto& vec = it->second;
+            const size_t before = vec.size();
+            vec.erase(std::remove_if(vec.begin(), vec.end(),
+                                     [sub](const AttachEntry& e) { return e.subObj && e.subObj != sub; }),
+                      vec.end());
+            if (vec.size() != before)
+                EquipLog("  purge: dropped %zu entry(ies) stamped with a stale scene node (cmo=0x%p sub=0x%p)",
+                         before - vec.size(), it->first, sub);
+            if (vec.empty()) { VPathEvictCmo(it->first); it = g_attached.erase(it); }
+            else             ++it;
         }
         if (g_attached.empty()) return;
 
-- 
