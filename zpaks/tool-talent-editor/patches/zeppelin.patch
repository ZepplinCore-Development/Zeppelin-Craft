diff --git a/src/talent_editor.go b/src/talent_editor.go
index 5e0a268..590a4dc 100644
--- a/src/talent_editor.go
+++ b/src/talent_editor.go
@@ -15,6 +15,8 @@ import (
     "image/png"
     "io/fs"
     "math"
+    "os"
+    "path/filepath"
     "sort"
     "strconv"
     "strings"
@@ -39,6 +41,12 @@ var iconsZip []byte
 var iconsFS fs.FS
 var iconLookup map[string]string
 
+// External (on-disk) icon overlay. Custom/reskinned icons are dropped into a
+// `custom_icons/` folder next to the binary (and/or the working dir) by the
+// `zep build patch-mpq -p I` sync step, so new custom talent icons appear WITHOUT
+// rebuilding this editor. These take priority over the embedded stock set.
+var extIconLookup map[string]string
+
 const (
     MAX_NUM_TALENT_TIERS = 15
     NUM_TALENT_COLUMNS   = 4
@@ -104,10 +112,35 @@ func init() {
     fs.WalkDir(iconsFS, ".", func(path string, d fs.DirEntry, err error) error {
         if !d.IsDir() {
             // store lowercase → actual name
-            iconLookup[strings.ToLower(path)] = path
+            iconLookup[strings.ToLower(filepath.Base(path))] = path
         }
         return nil
     })
+
+    // Scan on-disk overlay folders for custom icons (lowercase basename → path).
+    // Checked before the embedded set so custom icons win. Later dirs do NOT
+    // overwrite earlier hits, so the exe-relative folder wins over the CWD one.
+    extIconLookup = make(map[string]string)
+    var extDirs []string
+    if exe, err := os.Executable(); err == nil {
+        extDirs = append(extDirs, filepath.Join(filepath.Dir(exe), "custom_icons"))
+    }
+    extDirs = append(extDirs, "custom_icons")
+    for _, dir := range extDirs {
+        entries, err := os.ReadDir(dir)
+        if err != nil {
+            continue
+        }
+        for _, e := range entries {
+            if e.IsDir() || strings.ToLower(filepath.Ext(e.Name())) != ".png" {
+                continue
+            }
+            key := strings.ToLower(e.Name())
+            if _, exists := extIconLookup[key]; !exists {
+                extIconLookup[key] = filepath.Join(dir, e.Name())
+            }
+        }
+    }
 }
 
 func main() {
@@ -732,7 +765,12 @@ func createTalentButton(
             if spell, ok := spells[rankSpellID]; ok && spell.IconID.Valid {
