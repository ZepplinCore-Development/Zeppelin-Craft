{
  "$schema": "../../schemas/zpak.schema.json",
  "name": "starter-guild",
  "version": "0.1.0",
  "description": "Auto-join guild for new characters",
  "author": "Zeppelin Team",
  "type": "acore-extension",
  "acore": {
    "module": "mod-starter-guild",
    "source": "https://github.com/azerothcore/mod-starter-guild.git",
    "branch": "master",
    "patch_mode": "single"
  },
  "contents": {
    "patches": ["patches/*.patch"]
  },
  "enabled": true,
  "priority": 100
}
