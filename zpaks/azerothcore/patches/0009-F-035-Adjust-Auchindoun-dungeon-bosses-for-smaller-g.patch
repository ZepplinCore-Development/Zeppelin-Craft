From 7d1725e1ba0044e91dc8ce4999d6f3913fe1eb0e Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Fri, 30 Jan 2026 12:17:18 +0000
Subject: [PATCH] F-035: Adjust Auchindoun dungeon bosses for smaller groups

Exarch Maladaar:
- Replace Freezing Trap with Explosive Trap for Stolen Soul

Pandemonius:
- Reduce MAX_VOID_BLAST from 5 to 1

Nexus-Prince Shaffar:
- Reduce beacon spawn frequency from 10s to 20s

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../Auchindoun/AuchenaiCrypts/boss_exarch_maladaar.cpp      | 4 ++--
 .../Auchindoun/ManaTombs/boss_nexusprince_shaffar.cpp       | 6 ++++--
 .../Outland/Auchindoun/ManaTombs/boss_pandemonius.cpp       | 2 +-
 3 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/src/server/scripts/Outland/Auchindoun/AuchenaiCrypts/boss_exarch_maladaar.cpp b/src/server/scripts/Outland/Auchindoun/AuchenaiCrypts/boss_exarch_maladaar.cpp
index 67679c091..aec2a13a9 100644
--- a/src/server/scripts/Outland/Auchindoun/AuchenaiCrypts/boss_exarch_maladaar.cpp
+++ b/src/server/scripts/Outland/Auchindoun/AuchenaiCrypts/boss_exarch_maladaar.cpp
@@ -46,7 +46,7 @@ enum Spells
     SPELL_FROSTSHOCK            = 37332,
     SPELL_CURSE_OF_AGONY        = 37334,
     SPELL_MORTAL_STRIKE         = 37335,
-    SPELL_FREEZING_TRAP         = 37368,
+    SPELL_EXPLOSIVE_TRAP         = 43444,
     SPELL_HAMMER_OF_JUSTICE     = 37369,
     SPELL_PLAGUE_STRIKE         = 58839
 };
@@ -184,7 +184,7 @@ struct npc_stolen_soul : public ScriptedAI
                 case CLASS_HUNTER:
                     _scheduler.Schedule(0ms, [this](TaskContext context)
                     {
-                        DoCastVictim(SPELL_FREEZING_TRAP);
+                        DoCastVictim(SPELL_EXPLOSIVE_TRAP);
                         context.Repeat(20s);
                     });
                     break;
diff --git a/src/server/scripts/Outland/Auchindoun/ManaTombs/boss_nexusprince_shaffar.cpp b/src/server/scripts/Outland/Auchindoun/ManaTombs/boss_nexusprince_shaffar.cpp
index 0986ba9c6..28400fdc2 100644
--- a/src/server/scripts/Outland/Auchindoun/ManaTombs/boss_nexusprince_shaffar.cpp
+++ b/src/server/scripts/Outland/Auchindoun/ManaTombs/boss_nexusprince_shaffar.cpp
@@ -83,14 +83,16 @@ struct boss_nexusprince_shaffar : public BossAI
         _JustEngagedWith();
         Talk(SAY_AGGRO);
         summons.DoZoneInCombat();
-        scheduler.Schedule(10s, [this](TaskContext context)
+        // reduce frequency to from 10s to 20s
+        scheduler.Schedule(20s, [this](TaskContext context)
         {
             if (!urand(0, 3))
             {
                 Talk(SAY_SUMMON);
             }
             DoCastSelf(SPELL_ETHEREAL_BEACON, true);
-            context.Repeat(10s);
+            context.Repeat(20s);
+            // reduce frequency to from 10s to 20s
         }).Schedule(4s, [this](TaskContext context)
         {
             DoCastVictim(RAND(SPELL_FROSTBOLT, SPELL_FIREBALL));
diff --git a/src/server/scripts/Outland/Auchindoun/ManaTombs/boss_pandemonius.cpp b/src/server/scripts/Outland/Auchindoun/ManaTombs/boss_pandemonius.cpp
index 2612c690e..57be83b1f 100644
--- a/src/server/scripts/Outland/Auchindoun/ManaTombs/boss_pandemonius.cpp
+++ b/src/server/scripts/Outland/Auchindoun/ManaTombs/boss_pandemonius.cpp
@@ -50,7 +50,7 @@ float const ROOM_PULL_RANGE    = 70.0f;
 float const ROOM_ENTERANCE     = -50.0f;
 float const ROOM_EXIT          = -145.0f;
 
-constexpr uint8 MAX_VOID_BLAST = 5;
+constexpr uint8 MAX_VOID_BLAST = 1; // normally 5, but should ideally scale to the number of players in the dungeon.
 
 struct boss_pandemonius : public BossAI
 {
-- 
2.34.1

