From f7f06b978c1e0ccacd8a8d3e6559bbd572c492f0 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sat, 16 May 2026 12:54:26 +0000
Subject: [PATCH] F-177 (cont): Drop AddSC_npc_professions() from
 world_script_loader
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Follow-up to a24eb03e4 — the original commit deleted
npc_professions.cpp but the corresponding decl + call in
world_script_loader.cpp were not staged due to a `git add` chain
that failed silently. Without this, the loader still references
AddSC_npc_professions() and the binary fails to link after the
.cpp delete.
---
 src/server/scripts/World/world_script_loader.cpp | 2 --
 1 file changed, 2 deletions(-)

diff --git a/src/server/scripts/World/world_script_loader.cpp b/src/server/scripts/World/world_script_loader.cpp
index 08cd25e91..f47e05241 100644
--- a/src/server/scripts/World/world_script_loader.cpp
+++ b/src/server/scripts/World/world_script_loader.cpp
@@ -22,7 +22,6 @@ void AddSC_generic_creature();
 void AddSC_go_scripts();
 void AddSC_guards();
 void AddSC_item_scripts();
-void AddSC_npc_professions();
 void AddSC_npc_innkeeper();
 void AddSC_npcs_special();
 void AddSC_npc_taxi();
@@ -46,7 +45,6 @@ void AddWorldScripts()
     AddSC_go_scripts();
     AddSC_guards();
     AddSC_item_scripts();
-    AddSC_npc_professions();
     AddSC_npc_innkeeper();
     AddSC_npcs_special();
     AddSC_npc_taxi();
-- 
2.34.1

