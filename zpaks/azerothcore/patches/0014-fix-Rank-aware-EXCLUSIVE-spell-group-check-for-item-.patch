From 712beb87370ab914fc54cf12b206ad0b8061aed1 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Tue, 10 Feb 2026 13:57:11 +0000
Subject: [PATCH] fix: Rank-aware EXCLUSIVE spell group check for item obtain
 spells (F-001)

Update ApplyItemObtainSpells to use IsHighRankOf when checking EXCLUSIVE
spell groups. Higher-rank spells are allowed through to replace lower-rank
ones, while same or lower ranks are blocked. Works with spell_ranks table
entries for profession tools, riding crops, and alchemy mortars.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/server/game/Entities/Player/Player.cpp | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/src/server/game/Entities/Player/Player.cpp b/src/server/game/Entities/Player/Player.cpp
index e96b0f3b5..19b7df2b5 100644
--- a/src/server/game/Entities/Player/Player.cpp
+++ b/src/server/game/Entities/Player/Player.cpp
@@ -7030,8 +7030,9 @@ void Player::ApplyItemObtainSpells(Item* item, bool apply)
         {
             if (!HasAura(spellId))
             {
-                // Check if a spell from the same exclusive group is already active
-                // This prevents weaker spells from replacing stronger ones in spell groups
+                // For EXCLUSIVE groups, skip cast if same-group spell is active
+                // UNLESS the new spell is a higher rank (spell_ranks table).
+                // This lets higher-tier profession tools replace lower-tier ones.
                 SpellInfo const* spellInfo = sSpellMgr->GetSpellInfo(spellId);
                 bool skipCast = false;
                 if (spellInfo)
@@ -7040,10 +7041,11 @@ void Player::ApplyItemObtainSpells(Item* item, bool apply)
                     {
                         SpellInfo const* existingSpell = appliedAura.second->GetBase()->GetSpellInfo();
                         SpellGroupStackRule rule = sSpellMgr->CheckSpellGroupStackRules(spellInfo, existingSpell);
-                        if (rule == SPELL_GROUP_STACK_RULE_EXCLUSIVE_HIGHEST ||
-                            rule == SPELL_GROUP_STACK_RULE_EXCLUSIVE)
+                        if (rule == SPELL_GROUP_STACK_RULE_EXCLUSIVE)
                         {
-                            // A spell from the same exclusive group is active - skip to preserve it
+                            // Allow higher rank to replace lower rank
+                            if (spellInfo->IsHighRankOf(existingSpell))
+                                continue;
                             skipCast = true;
                             break;
                         }
