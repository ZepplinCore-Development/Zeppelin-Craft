+// Save racial swap choice to database
+void SaveRacialSwap(ObjectGuid::LowType guid, uint8 raceId)
+{
+    CharacterDatabase.Execute("REPLACE INTO `character_racial_swap` (`guid`, `selected_race`) VALUES ({}, {})", guid, raceId);
+}
+
+// Delete racial swap record (player reset to original race)
+void DeleteRacialSwap(ObjectGuid::LowType guid)
+{
+    CharacterDatabase.Execute("DELETE FROM `character_racial_swap` WHERE `guid` = {}", guid);
+}
