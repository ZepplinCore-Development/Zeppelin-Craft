From 75ab015a77feb3996accdbe9b77fba22d3bb8405 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Thu, 22 Oct 2026 04:52:26 +0000
Subject: [PATCH] WIP: F-151 - character list accepts the Zeppelin
 customization trailer (ZEPC)

The worldserver appends eye colour and marking per character after the list;
the decoder refused any trailing data.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01URnr7tKsFMZq4VFsSKkj3S
---
 pkg/char/characters.go  | 8 ++++++++
 pkg/char/client_test.go | 8 ++++++++
 2 files changed, 16 insertions(+)

diff --git a/pkg/char/characters.go b/pkg/char/characters.go
index 8be9cbc..50661c5 100644
--- a/pkg/char/characters.go
+++ b/pkg/char/characters.go
@@ -85,6 +85,14 @@ func decodeCharacters(body []byte) ([]Character, error) {
 		seen[ch.GUID] = true
 		characters = append(characters, ch)
 	}
+	// Zeppelin (F-151): the server appends "ZEPC", a count and per character guid, eye colour and marking.
+	if r.Len() >= 5 && bytes.Equal(r.Bytes()[:4], []byte("ZEPC")) {
+		r.Next(4)
+		extra, _ := r.ReadByte()
+		if _, err := io.ReadFull(r, make([]byte, int(extra)*10)); err != nil {
+			return nil, fmt.Errorf("truncated customization trailer: %w", err)
+		}
+	}
 	if r.Len() != 0 {
 		return nil, errors.New("trailing data in character list")
 	}
diff --git a/pkg/char/client_test.go b/pkg/char/client_test.go
index 088c365..72efc2c 100644
--- a/pkg/char/client_test.go
+++ b/pkg/char/client_test.go
@@ -539,6 +539,14 @@ func TestCharacterDecoder(t *testing.T) {
 			t.Fatalf("accepted truncation at %d", i)
 		}
 	}
+	// Zeppelin (F-151) customization trailer: accepted whole, refused truncated
+	trailer := append([]byte("ZEPC\x02"), make([]byte, 20)...)
+	if chars, err := decodeCharacters(append(bytes.Clone(fixture), trailer...)); err != nil || len(chars) != 2 {
+		t.Fatal("trailer refused", err)
+	}
+	if _, err := decodeCharacters(append(bytes.Clone(fixture), trailer[:len(trailer)-1]...)); err == nil {
+		t.Fatal("accepted a truncated trailer")
+	}
 	for _, change := range []func([]byte) []byte{
 		func(p []byte) []byte { return append(p, 0) }, func(p []byte) []byte { p[0] = 255; return p }, func(p []byte) []byte { p[9] = 0x1b; return p },
 		func(p []byte) []byte { clear(p[1:9]); return p }, func(p []byte) []byte { copy(p[276:284], p[1:9]); return p },
-- 
2.34.1

