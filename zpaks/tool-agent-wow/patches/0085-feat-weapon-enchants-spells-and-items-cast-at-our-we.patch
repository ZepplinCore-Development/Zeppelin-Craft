+    def weapon_consumable(self):
+        """A sharpening stone / weightstone / oil in the bags and a bare main hand: put it on before the
+        pull. Any item whose on-use spell is a temporary weapon enchant (spell effect 54) - the same
+        item-targeted use the shaman's Rockbiter needs. A rejected one (a stone on a mace) is not
+        tried again."""
+        inv = call("interact.inventory")
+        main = next((it for it in inv.get("equipped", []) if it.get("slot") == 15), None)
+        if not main or main.get("tempEnchant"):
+            return
+        bag = {it["entry"] for it in inv.get("items", []) if it.get("entry")}
+        bad = self.__dict__.setdefault("_bad_weapon_items", set())
+        known = self.__dict__.setdefault("_weapon_items", {})  # entry -> enchant spell or 0
+        new = [e for e in bag if e not in known]
+        if new:
+            sp = {e: inf[2] for e, inf in self.items(new).items() if inf and inf[0] == 0 and inf[2]}
+            ench = {int(r["id"]) for r in dbc(f"SELECT id FROM spell WHERE effect_1=54 AND id IN ({inlist(sp.values())})")} if sp else set()
+            for e in new:
+                known[e] = sp.get(e, 0) if sp.get(e, 0) in ench else 0
+        for e in sorted(bag):
+            if known.get(e) and e not in bad:
+                r = call("interact.use_item", entry=e, spell_id=known[e], target_kind="weapon", timeout_ms=6000)
+                print(f"  weapon: used {e} on the main hand: {r.get('detail')}", flush=True)
+                if not r.get("ok"):
+                    bad.add(e)
+                return
+
