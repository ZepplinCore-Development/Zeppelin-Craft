+// VendorSell sends CMSG_SELL_ITEM (vendor u64, item u64, u32 count). AzerothCore replies with
+// SMSG_SELL_ITEM only when the sale fails (vendor u64, item u64, u8 error); silence is a sale.
+func (s *service) VendorSell(ctx context.Context, req *interactv1.VendorSellRequest) (*interactv1.CastResult, error) {
+	vendor, err := s.resolve(ctx, req.GetTarget())
+	if err != nil {
+		return nil, err
+	}
+	ch := s.listen(opcode.SMSGSellItem)
+	defer s.unlisten(ch)
+	var w wow.Writer
+	w.U64(vendor)
+	w.U64(req.GetItemGuid())
+	w.U32(req.GetCount())
+	if err := s.send(ctx, opcode.CMSGSellItem, &w); err != nil {
+		return nil, err
+	}
+	if p, ok := await(ctx, ch, 800*time.Millisecond); ok && len(p.payload) > 0 {
+		return &interactv1.CastResult{Detail: fmt.Sprintf("sell error %d", p.payload[len(p.payload)-1])}, nil
+	}
+	return &interactv1.CastResult{Ok: true, Detail: "sold"}, nil
+}
