+// GetVendorList sends CMSG_LIST_INVENTORY (guid) and decodes SMSG_LIST_INVENTORY
+// (WorldSession::SendListInventory: guid, u8 count, per item: u32 slot+1, u32 item,
+// u32 display, i32 stock, u32 price, u32 durability, u32 buy count, u32 extended cost).
+func (s *service) GetVendorList(ctx context.Context, t *interactv1.Target) (*interactv1.VendorList, error) {
+	guid, err := s.resolve(ctx, t)
+	if err != nil {
+		return nil, err
+	}
+	ch := s.listen(opcode.SMSGListInventory)
+	defer s.unlisten(ch)
+	var w wow.Writer
+	w.U64(guid)
+	if err := s.send(ctx, opcode.CMSGListInventory, &w); err != nil {
+		return nil, err
+	}
+	p, ok := await(ctx, ch, replyTimeout)
+	if !ok {
+		return &interactv1.VendorList{Guid: guid, Detail: "none"}, nil
+	}
+	r := wow.NewReader(p.payload)
+	out := &interactv1.VendorList{Guid: r.U64()}
+	n := int(r.U8())
+	if n == 0 {
+		out.Detail = fmt.Sprintf("empty (error %d)", r.U8())
+		return out, nil
+	}
+	for i := 0; i < n && r.Err() == nil; i++ {
+		it := &interactv1.VendorItem{Slot: r.U32(), ItemId: r.U32()}
+		r.U32() // display
+		it.Stock = int32(r.U32())
+		it.Price = r.U32()
+		r.U32() // durability
+		it.BuyCount, it.ExtendedCost = r.U32(), r.U32()
+		out.Items = append(out.Items, it)
+	}
+	return out, nil
+}
+
+// VendorBuy buys an item: CMSG_BUY_ITEM (vendor guid, item, vendor slot, count, u8) and waits
+// for SMSG_BUY_ITEM or SMSG_BUY_FAILED (guid, item, [param], u8 reason).
+func (s *service) VendorBuy(ctx context.Context, req *interactv1.VendorBuyRequest) (*interactv1.VendorBuyResult, error) {
+	list, err := s.GetVendorList(ctx, req.GetTarget())
+	if err != nil {
+		return nil, err
+	}
+	var slot uint32
+	for _, it := range list.GetItems() {
+		if it.GetItemId() == req.GetItemId() {
+			slot = it.GetSlot()
+		}
+	}
+	if slot == 0 {
+		return &interactv1.VendorBuyResult{Detail: "not sold here"}, nil
+	}
+	count := req.GetCount()
+	if count == 0 {
+		count = 1
+	}
+	ch := s.listen(opcode.SMSGBuyItem, opcode.SMSGBuyFailed)
+	defer s.unlisten(ch)
+	var w wow.Writer
+	w.U64(list.GetGuid())
+	w.U32(req.GetItemId())
+	w.U32(slot)
+	w.U32(count)
+	w.U8(0)
+	if err := s.send(ctx, opcode.CMSGBuyItem, &w); err != nil {
+		return nil, err
+	}
+	p, ok := await(ctx, ch, replyTimeout)
+	if !ok {
+		return &interactv1.VendorBuyResult{Detail: "timeout"}, nil
+	}
+	if p.op == opcode.SMSGBuyItem {
+		return &interactv1.VendorBuyResult{Ok: true, Detail: "bought"}, nil
+	}
+	b := p.payload
+	return &interactv1.VendorBuyResult{Detail: fmt.Sprintf("failed reason %d", b[len(b)-1])}, nil
+}
+
+// SpellClick sends CMSG_SPELLCLICK (guid) - npc_spellclick_spells: quest "click the NPC" credit,
+// boarding vehicles - and reports the first SPELL_GO / CAST_FAILED that follows.
+func (s *service) SpellClick(ctx context.Context, t *interactv1.Target) (*interactv1.CastResult, error) {
+	guid, err := s.resolve(ctx, t)
+	if err != nil {
+		return nil, err
+	}
+	ch := s.listen(opcode.SMSGSpellGo, opcode.SMSGCastFailed)
+	defer s.unlisten(ch)
+	var w wow.Writer
+	w.U64(guid)
+	if err := s.send(ctx, opcode.CMSGSpellclick, &w); err != nil {
+		return nil, err
+	}
+	p, ok := await(ctx, ch, 3*time.Second)
+	if !ok {
+		return &interactv1.CastResult{Detail: "no spell (not clickable for us, or out of range)"}, nil
+	}
+	r := wow.NewReader(p.payload)
+	if p.op == opcode.SMSGCastFailed {
+		r.U8()
+		spell := r.U32()
+		return &interactv1.CastResult{Detail: fmt.Sprintf("cast_failed spell %d result %d", spell, r.U8())}, nil
+	}
+	r.PackedGUID()
+	r.PackedGUID()
+	r.U8()
+	return &interactv1.CastResult{Ok: true, Detail: fmt.Sprintf("spell_go %d", r.U32())}, nil
+}
