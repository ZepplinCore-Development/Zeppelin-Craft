+// Command vehicle is a Zeppelin agent-wow gameplay module (F-219 Track A): boarding, driving and
+// leaving vehicles, and casting from the vehicle action bar.
+//
+// AzerothCore flow: the server grants control with SMSG_CLIENT_CONTROL_UPDATE (packed guid,
+// u8 allow) from Player::SetClientControl; the client answers CMSG_SET_ACTIVE_MOVER (u64 guid)
+// and from then on HandleMovementOpcodes only accepts movement carrying the VEHICLE's guid - so
+// this module tells the move module to switch its mover (move.set_mover). The action bar comes
+// in SMSG_PET_SPELLS (Player::VehicleSpellInitialize: guid, u16 family, u32 duration, u8 react,
+// u8 command, u16 disable, 10 x u32 spell|type<<24, ...). Vehicle spells are plain
+// CMSG_CAST_SPELL: HandleCastSpellOpcode casts with the controlled mover when it has the spell.
+// Leaving: CMSG_REQUEST_VEHICLE_EXIT (empty).
+package main
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"os"
+	"os/signal"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/agent-wow/agent-wow/pkg/modules/v1"
+	"github.com/agent-wow/agent-wow/pkg/opcode"
+	interactv1 "github.com/agent-wow/agent-wow/zeppelin/modules/interact/api"
+	movev1 "github.com/agent-wow/agent-wow/zeppelin/modules/move/api"
+	vehiclev1 "github.com/agent-wow/agent-wow/zeppelin/modules/vehicle/api"
+	"github.com/agent-wow/agent-wow/zeppelin/wow"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/health"
+	"google.golang.org/grpc/health/grpc_health_v1"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/anypb"
+	"google.golang.org/protobuf/types/known/emptypb"
+)
+
+const targetFlagUnit = 0x00000002
+
+type service struct {
+	vehiclev1.UnimplementedVehicleServer
+	session modv1.SessionClient
+
+	mu        sync.Mutex
+	self      uint64
+	vehicle   uint64 // the unit we control (0 = ourselves)
+	spells    []uint32
+	changed   chan struct{} // closed and replaced on every control change
+	castCount uint8
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run() error {
+	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer cancel()
+	path := os.Getenv("AGENT_WOW_MODULE_SOCKET")
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		return err
+	}
+	defer listener.Close()
+	if err := os.Chmod(path, 0666); err != nil {
+		return err
+	}
+	conn, err := grpc.NewClient("unix://"+os.Getenv("AGENT_WOW_SESSION_SOCKET"),
+		grpc.WithTransportCredentials(insecure.NewCredentials()), grpc.WithDisableRetry())
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	s := &service{session: modv1.NewSessionClient(conn), changed: make(chan struct{})}
+	server := grpc.NewServer()
+	vehiclev1.RegisterVehicleServer(server, s)
+	healthy := health.NewServer()
+	grpc_health_v1.RegisterHealthServer(server, healthy)
+	healthy.SetServingStatus("", grpc_health_v1.HealthCheckResponse_SERVING)
+	go func() { <-ctx.Done(); server.Stop() }()
+	return server.Serve(listener)
+}
+
+func (s *service) invoke(ctx context.Context, module, method string, req, resp proto.Message) error {
+	a, err := anypb.New(req)
+	if err != nil {
+		return err
+	}
+	r, err := s.session.InvokeModule(ctx, &modv1.InvokeModuleRequest{Module: module, Method: method, Request: a})
+	if err != nil {
+		return err
+	}
+	return r.GetResult().UnmarshalTo(resp)
+}
+
+func (s *service) send(ctx context.Context, op uint32, w *wow.Writer) error {
+	var payload []byte
+	if w != nil {
+		payload = w.Bytes()
+	}
+	_, err := s.session.SendPacket(ctx, &modv1.SendPacketRequest{Opcode: op, Payload: payload})
+	return err
+}
+
+func (s *service) selfGUID(ctx context.Context) uint64 {
+	s.mu.Lock()
+	g := s.self
+	s.mu.Unlock()
+	if g != 0 {
+		return g
+	}
+	var st interactv1.SelfState
+	if err := s.invoke(ctx, "interact", "self", &emptypb.Empty{}, &st); err == nil {
+		s.mu.Lock()
+		s.self = st.GetGuid()
+		s.mu.Unlock()
+		return st.GetGuid()
+	}
+	return 0
+}
+
+func (s *service) unit(ctx context.Context, guid uint64) *interactv1.WorldObject {
+	var r interactv1.FindResult
+	if err := s.invoke(ctx, "interact", "find", &interactv1.FindRequest{Guid: guid}, &r); err != nil || len(r.GetObjects()) == 0 {
+		return nil
+	}
+	return r.GetObjects()[0]
+}
+
+// -- packets --------------------------------------------------------------------------------------
+
+func (s *service) OnPacket(ctx context.Context, p *modv1.WorldPacket) (*emptypb.Empty, error) {
+	r := wow.NewReader(p.GetPayload())
+	switch p.GetOpcode() {
+	case opcode.SMSGClientControlUpdate:
+		target, allow := r.PackedGUID(), r.U8() == 1
+		if r.Err() != nil || !allow {
+			break
+		}
+		me := s.selfGUID(ctx)
+		// acknowledge the new mover, then point the move module at it
+		var w wow.Writer
+		w.U64(target)
+		_ = s.send(ctx, opcode.CMSGSetActiveMover, &w)
+		req := &movev1.SetMoverRequest{Guid: target}
+		if target == me {
+			req.Guid = 0
+		} else if u := s.unit(ctx, target); u != nil {
+			req.X, req.Y, req.Z, req.RunSpeed = u.GetX(), u.GetY(), u.GetZ(), u.GetRunSpeed()
+		}
+		var pos movev1.Position
+		_ = s.invoke(ctx, "move", "set_mover", req, &pos)
+		s.mu.Lock()
+		if target == me {
+			s.vehicle, s.spells = 0, nil
+		} else {
+			s.vehicle = target
+		}
+		close(s.changed)
+		s.changed = make(chan struct{})
+		s.mu.Unlock()
+	case opcode.SMSGPetSpells:
+		g := r.U64()
+		r.U16() // family
+		r.U32() // duration
+		r.U8()  // react
+		r.U8()  // command
+		r.U16() // disable actions
+		var spells []uint32
+		for i := 0; i < 10 && r.Err() == nil; i++ {
+			spells = append(spells, r.U32()&0x00FFFFFF)
+		}
+		if r.Err() == nil {
+			s.mu.Lock()
+			if g == s.vehicle || s.vehicle == 0 {
+				s.spells = spells
+			}
+			s.mu.Unlock()
+		}
+	}
+	return &emptypb.Empty{}, nil
+}
+
+// -- RPCs -----------------------------------------------------------------------------------------
+
+func (s *service) state(ctx context.Context) *vehiclev1.VehicleState {
+	s.mu.Lock()
+	st := &vehiclev1.VehicleState{Controlling: s.vehicle != 0, Vehicle: s.vehicle, Spells: append([]uint32(nil), s.spells...)}
+	s.mu.Unlock()
+	if st.Vehicle != 0 {
+		if u := s.unit(ctx, st.Vehicle); u != nil {
+			st.Entry = u.GetEntry()
+		}
+	}
+	return st
+}
+
+func (s *service) GetState(ctx context.Context, _ *emptypb.Empty) (*vehiclev1.VehicleState, error) {
+	return s.state(ctx), nil
+}
+
+// Enter clicks a vehicle (spellclick -> ride spell) and waits for the server to hand us control.
+// A ride without control (passenger seat) reports ok with controlling=false.
+func (s *service) Enter(ctx context.Context, req *vehiclev1.EnterRequest) (*vehiclev1.Result, error) {
+	s.mu.Lock()
+	changed := s.changed
+	s.mu.Unlock()
+	var click interactv1.CastResult
+	if err := s.invoke(ctx, "interact", "spellclick", &interactv1.Target{Guid: req.GetGuid(), Entry: req.GetEntry()}, &click); err != nil {
+		return nil, err
+	}
+	wait := 4 * time.Second
+	if req.GetTimeoutMs() > 0 {
+		wait = time.Duration(req.GetTimeoutMs()) * time.Millisecond
+	}
+	select {
+	case <-changed:
+		time.Sleep(300 * time.Millisecond) // SMSG_PET_SPELLS follows the control update
+		st := s.state(ctx)
+		return &vehiclev1.Result{Ok: st.GetControlling(), Detail: "controlling " + click.GetDetail(), State: st}, nil
+	case <-time.After(wait):
+		st := s.state(ctx)
+		return &vehiclev1.Result{Ok: click.GetOk(), Detail: "no control granted (passenger?) - " + click.GetDetail(), State: st}, nil
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+}
+
+func (s *service) Exit(ctx context.Context, _ *emptypb.Empty) (*vehiclev1.Result, error) {
+	s.mu.Lock()
+	changed := s.changed
+	s.mu.Unlock()
+	if err := s.send(ctx, opcode.CMSGRequestVehicleExit, nil); err != nil {
+		return nil, err
+	}
+	select {
+	case <-changed:
+	case <-time.After(3 * time.Second):
+	}
+	st := s.state(ctx)
+	return &vehiclev1.Result{Ok: !st.GetControlling(), Detail: "exit requested", State: st}, nil
+}
+
+// Cast fires a vehicle action-bar spell (by slot or id) with CMSG_CAST_SPELL; the server casts
+// it as the controlled vehicle.
+func (s *service) Cast(ctx context.Context, req *vehiclev1.CastRequest) (*vehiclev1.Result, error) {
+	st := s.state(ctx)
+	spell := req.GetSpellId()
+	if spell == 0 {
+		i := int(req.GetSlot()) - 1
+		if i < 0 || i >= len(st.GetSpells()) || st.GetSpells()[i] == 0 {
+			return nil, status.Errorf(codes.InvalidArgument, "no spell in vehicle slot %d (bar %v)", req.GetSlot(), st.GetSpells())
+		}
+		spell = st.GetSpells()[i]
+	}
+	s.mu.Lock()
+	s.castCount++
+	c := s.castCount
+	s.mu.Unlock()
+	var w wow.Writer
+	w.U8(c)
+	w.U32(spell)
+	w.U8(0)
+	if t := req.GetTarget(); t != 0 {
+		w.U32(targetFlagUnit)
+		w.PackedGUID(t)
+	} else {
+		w.U32(0)
+	}
+	if err := s.send(ctx, opcode.CMSGCastSpell, &w); err != nil {
+		return nil, err
+	}
+	return &vehiclev1.Result{Ok: true, Detail: fmt.Sprintf("cast %d sent", spell), State: st}, nil
+}
