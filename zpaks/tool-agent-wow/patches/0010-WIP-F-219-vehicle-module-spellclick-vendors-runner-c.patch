+  bool controlling = 1;  // we move a vehicle (SMSG_CLIENT_CONTROL_UPDATE gave us control)
+  uint64 vehicle = 2;
+  uint32 entry = 3;
+  repeated uint32 spells = 4; // the vehicle action bar (SMSG_PET_SPELLS), slot order
+  bool passenger = 5;    // in a vehicle without control (a ride)
+}
+
+message EnterRequest {
+  uint64 guid = 1;       // vehicle to click (npc_spellclick_spells), or
+  uint32 entry = 2;      // nearest visible creature of this entry
+  uint32 timeout_ms = 3; // wait for control; 0 = 4 s
+}
+
+message CastRequest {
+  uint32 slot = 1;       // action bar slot 1..10 (when spell_id is 0)
+  uint32 spell_id = 2;
+  uint64 target = 3;     // optional unit target
+}
+message Result {
+  bool ok = 1;
+  string detail = 2;
+  VehicleState state = 3;
+}
+
+service Vehicle {
+  rpc GetState(google.protobuf.Empty) returns (VehicleState);
+  rpc Enter(EnterRequest) returns (Result);
+  rpc Exit(google.protobuf.Empty) returns (Result);
+  rpc Cast(CastRequest) returns (Result);
+  rpc OnPacket(agentwow.module.v1.WorldPacket) returns (google.protobuf.Empty);
+}
