+def _trace_sigterm():
+    """Runners have been dying of a SIGTERM nobody here sends (exit 143, no traceback).
+    Block SIGTERM and wait for it on a thread with sigwaitinfo, which - unlike a Python
+    signal handler - reports the SENDER, then log who it was and exit as before."""
+    import os
+    import signal
+    import threading
+
+    signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM})
+
+    def wait():
+        info = signal.sigwaitinfo({signal.SIGTERM})
+        try:
+            cmd = open(f"/proc/{info.si_pid}/cmdline", "rb").read().replace(b"\0", b" ").decode(errors="replace")
+        except OSError:
+            cmd = "(sender already gone)"
+        print(f"[SIGTERM] from pid {info.si_pid} uid {info.si_uid}: {cmd[:300]}", flush=True)
+        os._exit(143)
+
+    threading.Thread(target=wait, daemon=True).start()
+
+
