+// QuestAbandon drops a quest from the log (CMSG_QUESTLOG_REMOVE_QUEST, u8 slot) - how a player
+// restarts an escort that wandered off without them.
+func (s *service) QuestAbandon(ctx context.Context, req *interactv1.QuestRequest) (*interactv1.CastResult, error) {
+	log, err := s.GetQuestLog(ctx, &emptypb.Empty{})
+	if err != nil {
+		return nil, err
+	}
+	for _, e := range log.GetEntries() {
+		if e.GetQuestId() == req.GetQuestId() {
+			var w wow.Writer
+			w.U8(uint8(e.GetSlot()))
+			if err := s.send(ctx, opcode.CMSGQuestlogRemoveQuest, &w); err != nil {
+				return nil, err
+			}
+			return &interactv1.CastResult{Ok: true, Detail: fmt.Sprintf("abandoned (slot %d)", e.GetSlot())}, nil
+		}
+	}
+	return &interactv1.CastResult{Detail: "not in the quest log"}, nil
+}
