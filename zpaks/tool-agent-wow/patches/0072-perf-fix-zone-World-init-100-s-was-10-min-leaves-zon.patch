+    def summoners(self, entry, slots=3):
+        """Spells that summon creature `entry` (effect 28 in effect slot 1..slots) - one indexed DBC
+        query for the whole run instead of one per creature (182 of them cost 67 s on Elwynn)."""
+        if not hasattr(self, "_summon_idx"):
+            self._summon_idx = {}
+            for r in dbc("SELECT id,effect_1 e1,effect_misc_value_a_1 m1,effect_2 e2,effect_misc_value_a_2 m2,"
+                         "effect_3 e3,effect_misc_value_a_3 m3 FROM spell WHERE effect_1=28 OR effect_2=28 OR effect_3=28"):
+                for k in (1, 2, 3):
+                    if int(r[f"e{k}"]) == 28:
+                        self._summon_idx.setdefault((int(r[f"m{k}"]), k), []).append(int(r["id"]))
+        return sorted({sp for k in range(1, slots + 1) for sp in self._summon_idx.get((int(entry), k), [])})
+
