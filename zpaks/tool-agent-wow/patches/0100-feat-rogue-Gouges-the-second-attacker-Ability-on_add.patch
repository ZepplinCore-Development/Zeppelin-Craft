 	MinPowerPct  uint32 `protobuf:"varint,15,opt,name=min_power_pct,json=minPowerPct,proto3" json:"min_power_pct,omitempty"`    // skip below this % of our max mana; 0 = no floor
 	DotMs        uint32 `protobuf:"varint,16,opt,name=dot_ms,json=dotMs,proto3" json:"dot_ms,omitempty"`                        // a DoT's duration: not applied (or refreshed) on a target expected to die
 	// within half of it - a 15 s DoT on a mob with 5 s left is wasted mana
-	MinCombo      uint32 `protobuf:"varint,17,opt,name=min_combo,json=minCombo,proto3" json:"min_combo,omitempty"` // a finisher (Eviscerate): only with this many combo points on the target -
+	MinCombo uint32 `protobuf:"varint,17,opt,name=min_combo,json=minCombo,proto3" json:"min_combo,omitempty"` // a finisher (Eviscerate): only with this many combo points on the target -
+	// or with any once the target is about to die (< 4 s) or we are losing
+	OnAdd         bool `protobuf:"varint,18,opt,name=on_add,json=onAdd,proto3" json:"on_add,omitempty"` // cast on ANOTHER live attacker in melee reach, never the kill target (Gouge:
 	unknownFields protoimpl.UnknownFields
 	sizeCache     protoimpl.SizeCache
 }
@@ -199,6 +201,13 @@ func (x *Ability) GetMinCombo() uint32 {
 	return 0
 }
 
+func (x *Ability) GetOnAdd() bool {
+	if x != nil {
+		return x.OnAdd
+	}
+	return false
+}
