         {"spell_id": 5277, "every_ms": 300000, "on_self": True, "below_health_pct": 50},      # Evasion (losing)
         {"spell_id": 1766, "every_ms": 10000, "min_power": 25, "interrupt": True},            # Kick
+        # Gouge (level 6) the SECOND mob: 4 s out of the fight while we kill the first (it breaks on
+        # damage - nothing of ours hits it; it rejoins and Gouge is up again 10 s later)
+        {"spell_id": 1776, "every_ms": 10000, "min_power": 45, "on_add": True},               # Gouge
         # the finisher first, gated on combo points (SMSG_UPDATE_COMBO_POINTS): 3 on the target, or any
         # once it is about to die / we are losing - on a 10 s timer it failed NO_COMBO_POINTS 45x a run
         {"spell_id": 2098, "every_ms": 1000, "min_power": 35, "min_combo": 3},                # Eviscerate
