@@ -28,6 +28,8 @@ message Ability {
                               // within half of it - a 15 s DoT on a mob with 5 s left is wasted mana
   uint32 min_combo = 17;      // a finisher (Eviscerate): only with this many combo points on the target -
                               // or with any once the target is about to die (< 4 s) or we are losing
+  bool on_add = 18;           // cast on ANOTHER live attacker in melee reach, never the kill target (Gouge:
