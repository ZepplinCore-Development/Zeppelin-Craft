 }
 
 message KillRequest {
diff --git a/zeppelin/modules/combat/main.go b/zeppelin/modules/combat/main.go
index 2ad2c61..10d3cbe 100644
--- a/zeppelin/modules/combat/main.go
+++ b/zeppelin/modules/combat/main.go
@@ -788,6 +788,31 @@ func (s *service) castAbilities(ctx context.Context, req *combatv1.KillRequest,
 		if p := a.GetBelowHealthPct(); p > 0 && st.GetMaxHealth() > 0 && st.GetHealth()*100/st.GetMaxHealth() >= p {
 			continue
 		}
+		if a.GetOnAdd() {
+			// a second attacker in melee reach (not the one we are killing): Gouge it out of the fight
+			if time.Since(lastCast[a.GetSpellId()]) < every {
+				continue
+			}
+			for _, g := range live {
+				if g == guid {
+					continue
+				}
+				u, err := s.unit(ctx, g)
+				if err != nil || u == nil || u.GetHealth() == 0 || distance(me, u.GetX(), u.GetY(), u.GetZ()) > 5 {
+					continue
+				}
+				var face movev1.Position // Gouge needs it in front of us; the next tick faces the target again
+				_ = s.invoke(ctx, "move", "face", &movev1.FaceRequest{X: u.GetX(), Y: u.GetY()}, &face)
+				if err := s.castAt(ctx, a.GetSpellId(), g); err != nil {
+					return err
+				}
+				lastCast[a.GetSpellId()] = time.Now()
+				res.Casts++
+				res.Spells = append(res.Spells, a.GetSpellId())
+				return nil
+			}
+			continue
+		}
 		if a.GetPerTarget() {
 			// the target first, then every other attacker in melee reach - one cast a tick
 			for _, g := range append([]uint64{guid}, live...) {
@@ -939,7 +964,7 @@ func (s *service) comboOK(a *combatv1.Ability, guid uint64, hp uint32, losing bo
 func (s *service) offenseLeft(req *combatv1.KillRequest, st *interactv1.SelfState, guid uint64, hp uint32,
 	losing bool, lastCast map[uint32]time.Time, lastOn map[[2]uint64]time.Time) bool {
 	for _, a := range req.GetAbilities() {
-		if a.GetOnSelf() || a.GetItemId() != 0 || a.GetOnWeapon() || a.GetInterrupt() || a.GetBuff() {
+		if a.GetOnSelf() || a.GetItemId() != 0 || a.GetOnWeapon() || a.GetInterrupt() || a.GetBuff() || a.GetOnAdd() {
 			continue
 		}
 		if st.GetPower() < a.GetMinPower() || !s.thriftOK(a, st, guid, losing) || !s.dotWorth(a, guid, hp) {
