+    def dense_level(self, p, radius=40, count=5):
+        """A cave, mine or packed camp: `count`+ hostile spawns within `radius` yd of p (phase-filtered,
+        their max levels). Returns the level to wait for - TWO above the toughest of them (the priest
+        died there at 8 against level-7 kobolds, one above was not enough) - or 0 when
+        the spot is not dense. Elwynn's priest died 22 times at level 8 in Fargodeep Mine among level
+        5-7 kobolds: in tunnels there is no detour and every pull brings two or three."""
+        near = [t for t in self.threats() if math.dist(t[:2], p[:2]) < radius]
+        return max(t[2] for t in near) + 2 if len(near) >= count else 0
+
