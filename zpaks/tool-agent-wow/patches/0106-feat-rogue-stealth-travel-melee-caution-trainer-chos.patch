 	Ghost         bool                   `protobuf:"varint,5,opt,name=ghost,proto3" json:"ghost,omitempty"`
-	Pet           uint64                 `protobuf:"varint,6,opt,name=pet,proto3" json:"pet,omitempty"` // our pet (SMSG_PET_SPELLS; 0 = none) - the warlock's imp, a hunter's pet
+	Pet           uint64                 `protobuf:"varint,6,opt,name=pet,proto3" json:"pet,omitempty"`            // our pet (SMSG_PET_SPELLS; 0 = none) - the warlock's imp, a hunter's pet
+	Auras         []uint32               `protobuf:"varint,7,rep,packed,name=auras,proto3" json:"auras,omitempty"` // our visible auras (spell ids): Stealth up or not before a rogue's trip
 	unknownFields protoimpl.UnknownFields
 	sizeCache     protoimpl.SizeCache
 }
@@ -952,6 +953,13 @@ func (x *CombatState) GetPet() uint64 {
 	return 0
 }
 
+func (x *CombatState) GetAuras() []uint32 {
+	if x != nil {
+		return x.Auras
+	}
+	return nil
+}
