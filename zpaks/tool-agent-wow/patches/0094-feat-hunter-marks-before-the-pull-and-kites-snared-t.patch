@@ -423,6 +423,7 @@ func (s *service) Kill(ctx context.Context, req *combatv1.KillRequest) (*combatv
 	bodyDone := !req.GetBodyPull()
 	rng := float64(req.GetRange()) // > 0: a caster/hunter fighting from range until it must melee
 	attacking := false
+	var lastKite time.Time
 	var lastHP uint32
 	var stuckSince time.Time
