@@ -606,6 +607,19 @@ func (s *service) Kill(ctx context.Context, req *combatv1.KillRequest) (*combatv
 			time.Sleep(tick)
 			continue
 		}
+		if rng > 0 && d <= rng && d < 8.5 && len(live) <= 1 && hasAnyAura(t.GetAuras(), req.GetKiteAuras()) &&
+			time.Since(lastKite) > 2*time.Second {
+			// kite: it is slowed and on top of us - back off out of melee (and past the ranged dead zone)
+			// so the next Auto Shot and shots land instead of a melee exchange
+			lastKite = time.Now()
+			dx, dy := float64(me.GetX()-t.GetX()), float64(me.GetY()-t.GetY())
+			h := math.Max(math.Hypot(dx, dy), 0.01)
+			var mv movev1.MoveToResult
+			_ = s.invoke(ctx, "move", "to", &movev1.MoveToRequest{X: me.GetX() + float32(dx/h*10),
+				Y: me.GetY() + float32(dy/h*10), Z: me.GetZ(), TimeoutMs: 2500}, &mv)
+			res.Kites++
+			continue
+		}
 		if rng > 0 && d <= rng {
 			// a cast blocked by line of sight will never land from here: close in now, not in 5 s
 			s.mu.Lock()
@@ -911,6 +925,17 @@ func (s *service) offenseLeft(req *combatv1.KillRequest, st *interactv1.SelfStat
 	return false
 }
 
+func hasAnyAura(have, want []uint32) bool {
+	for _, a := range have {
+		for _, w := range want {
+			if a == w {
+				return true
+			}
+		}
+	}
+	return false
+}
