From 0bbf4eeb98dd0b65bbc7ac5dc3bf3be9913dc8dc Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Thu, 22 Oct 2026 08:39:52 +0000
Subject: [PATCH] WIP: F-219 - step clear before resting; grind only isolated
 targets

- rest(): below 90 % HP, move up to 35 yd to the spot farthest outside live hostiles' reach and
  their spawn points (deaths right after a fight or rez, a mob 4-26 yd away)
- grind(): 18 yd hostile-only isolation like quest pulls; a below-level pair only when no
  isolated target exists anywhere

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019SSuH6gpqY4Kn5Rk9sd149
---
 zeppelin/tests/start_area.py | 58 ++++++++++++++++++++++++++++++++++--
 1 file changed, 55 insertions(+), 3 deletions(-)

diff --git a/zeppelin/tests/start_area.py b/zeppelin/tests/start_area.py
index adb2f8e..c224f90 100644
--- a/zeppelin/tests/start_area.py
+++ b/zeppelin/tests/start_area.py
@@ -1451,13 +1451,53 @@ class Runner:
         return bool(self.fight_args().get("pull_spell") or CLASS_RANGE.get(self.w.cls))
 
     def rest(self, until_pct=90):
-        """Sit until healed - eating first when we are low and carry food."""
+        """Sit until healed - eating first when we are low and carry food - out of every hostile's reach."""
+        try:
+            self.step_clear()
+        except (StepFailed, KeyError) as e:
+            print(f"  ~ step clear: {str(e)[:80]}", flush=True)
         self.fight_args()  # refreshes the food pick
         r = call("combat.rest", until_pct=until_pct, **self._food)
         if r.get("ate"):
             self._kit_t = 0  # one bite fewer: re-read the bags
         return r
 
+    def step_clear(self):
+        """Before sitting down hurt, step out of reach of the hostiles around us. A third of the weak bots'
+        deaths came at half health right after a fight or a rez, a mob 4-26 yd away (Tirisfal: the
+        mage sat at 54/137 HP beside a Ravaged Corpse; corpses reclaimed 22 yd from Gnarlpine): pick
+        the spot within 35 yd farthest from live hostiles and hostile spawn points, and walk there."""
+        s = call("interact.self")
+        if not s.get("maxHealth") or s.get("health", 0) * 100 >= s["maxHealth"] * 90:
+            return
+        level = s.get("level", 1)
+        top = {}
+        for t in self.threats():
+            top[t[3]] = max(top.get(t[3], 0), t[2])
+        live = [(o["x"], o.get("y", 0), top.get(o["entry"], level)) for o in
+                call("interact.find", type=3, radius=70, limit=80).get("objects", [])
+                if o.get("health", 0) > 0 and not o.get("npcFlags") and o["entry"] in top]
+        me = self.me()
+        reach = lambda m: self.aggro_r(m[2], level) + 8
+
+        def margin(x, y):  # how far outside the nearest hostile's reach (negative: inside it)
+            return min((math.dist(m[:2], (x, y)) - reach(m) for m in live), default=99)
+        if margin(me["x"], me["y"]) >= 0:
+            return
+        spawns = [t for t in self.threats() if math.dist(t[:2], (me["x"], me["y"])) < 70]
+        live += [(t[0], t[1], t[2]) for t in spawns]  # a respawn on top of us is the next fight too
+        pts = [(me["x"] + r * math.cos(a * math.pi / 6), me["y"] + r * math.sin(a * math.pi / 6))
+               for r in (20, 35) for a in range(12)]
+        best = max(pts, key=lambda p: margin(*p))
+        if margin(*best) <= margin(me["x"], me["y"]) + 5:
+            return  # nowhere quieter within reach: rest here
+        g = call("move.ground", x=best[0], y=best[1], z=me.get("z", 0))
+        if not g.get("ok"):
+            return
+        print(f"  rest: stepping clear to ({best[0]:.0f},{best[1]:.0f}), {margin(*best):.0f} yd outside the nearest "
+              f"reach (was {margin(me['x'], me['y']):.0f})", flush=True)
+        call("move.to", x=best[0], y=best[1], z=g["z"], timeout_ms=12000)
+
     def maybe_repair(self, below=0.3, max_walk=600):
         """Repair everything at the nearest repair NPC when any worn item is below `below` of its
         durability. Durability 0 = broken: the rogue's Sinister Strike failed 232 times
@@ -2073,9 +2113,21 @@ class Runner:
         if not easy:
             return self.walk_to_grind(level, cap)
 
+        # isolated = no other HOSTILE within aggro reach of it (18 yd), the rule quest pulls use: 10 yd let
+        # Tirisfal's Rotting Dead come two at a time to the grinding mage (a third of its deaths <50 % HP)
         def crowd(t):
-            return sum(1 for m in mobs if m is not t and math.dist((m["x"], m.get("y", 0)), (t["x"], t.get("y", 0))) < 10)
-        t = min(easy, key=lambda o: (crowd(o), -lv.get(o["entry"], 0), o.get("distance", 999)))
+            return sum(1 for m in mobs if m is not t and m["entry"] in hostile and
+                       math.dist((m["x"], m.get("y", 0)), (t["x"], t.get("y", 0))) < 18)
+        iso = [o for o in easy if crowd(o) == 0]
+        if not iso:
+            if self.walk_to_grind(level, cap):
+                return True
+            # nowhere better: a pair is fine when both are below us (no grind at all ended runs)
+            iso = [o for o in easy if crowd(o) <= 1 and lv.get(o["entry"], 99) < level]
+            if not iso:
+                return False
+        easy = iso
+        t = min(easy, key=lambda o: (-lv.get(o["entry"], 0), o.get("distance", 999)))
         best = max(lv.get(o["entry"], 0) for o in easy)
         if best < level - 1 and getattr(self, "_grind_walk", 0) < time.time() - 120:
             # only near-grey mobs here: go where the area's tougher quest targets live (once per 2 min)
-- 
