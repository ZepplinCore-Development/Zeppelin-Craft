+// castAbilities casts the first ability that is ready (priority order), at most one per tick.
+func (s *service) castAbilities(ctx context.Context, req *combatv1.KillRequest, st *interactv1.SelfState,
+	me *movev1.Position, t *interactv1.WorldObject, guid uint64, live []uint64,
+	lastCast map[uint32]time.Time, lastOn map[[2]uint64]time.Time, res *combatv1.KillResult) error {
+	for _, a := range req.GetAbilities() {
+		every := time.Duration(a.GetEveryMs()) * time.Millisecond
+		if n := a.GetMinAttackers(); n > 0 && uint32(len(live)) < n {
+			continue
+		}
+		if a.GetBuff() && s.hasAura(a.GetSpellId()) {
+			continue
+		}
+		if a.GetInterrupt() && !s.isCasting(guid) {
+			continue
+		}
+		if st.GetPower() < a.GetMinPower() {
+			continue
+		}
+		if p := a.GetBelowHealthPct(); p > 0 && st.GetMaxHealth() > 0 && st.GetHealth()*100/st.GetMaxHealth() >= p {
+			continue
+		}
+		if a.GetPerTarget() {
+			// the target first, then every other attacker in melee reach - one cast a tick
+			for _, g := range append([]uint64{guid}, live...) {
+				key := [2]uint64{uint64(a.GetSpellId()), g}
+				if time.Since(lastOn[key]) < every {
+					continue
+				}
+				if g != guid {
+					u, err := s.unit(ctx, g)
+					if err != nil || u == nil || u.GetHealth() == 0 || distance(me, u.GetX(), u.GetY(), u.GetZ()) > 5 {
 						continue
 					}
-					if g != guid {
