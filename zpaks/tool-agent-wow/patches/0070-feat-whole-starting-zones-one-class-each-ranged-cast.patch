-				if err := s.invoke(ctx, "interact", "use_item", &interactv1.UseItemRequest{Entry: a.GetItemId(), SpellId: a.GetSpellId(), TargetKind: "self", TimeoutMs: 1000}, &cr); err == nil {
-					res.Casts++
-					res.Spells = append(res.Spells, a.GetSpellId())
+				if err := s.castAt(ctx, a.GetSpellId(), g); err != nil {
+					return err
 				}
-				continue
-			}
-			target := guid
-			if a.GetOnSelf() {
-				target = st.GetGuid()
+				lastOn[key] = time.Now()
+				res.Casts++
+				res.Spells = append(res.Spells, a.GetSpellId())
+				return nil // one cast a tick: a second one only hits the global cooldown
 			}
-			if err := s.castAt(ctx, a.GetSpellId(), target); err != nil {
-				return nil, err
+			continue
+		}
+		if time.Since(lastCast[a.GetSpellId()]) < every {
+			continue
+		}
+		if a.GetItemId() != 0 {
+			lastCast[a.GetSpellId()] = time.Now() // tried or not: never spam a missing potion
