diff --git a/zeppelin/tests/rpc.py b/zeppelin/tests/rpc.py
index d3edafb..6836c75 100644
--- a/zeppelin/tests/rpc.py
+++ b/zeppelin/tests/rpc.py
@@ -12,7 +12,26 @@ class StepFailed(Exception):
     pass
 
 
+# navmesh override for path/ground queries: a runner sets this to a callable returning the map whose
+# terrain we actually walk (a terrain-swap phase plans on 659/661, not the map we are on), 0 = ours
+nav_map = None
+_NAV_METHODS = ("move.path", "move.path_to", "move.ground")
+
+
 def call(method, **params):
+    if nav_map and method in _NAV_METHODS and "nav_map" not in params:
+        m = nav_map()
+        if m:
+            # the swap navmesh is built from the swapped terrain alone (no vmaps): WMO interiors such
+            # as the Kaja'mine are holes in it, but the base mesh has them - fall back per query
+            try:
+                r = call(method, nav_map=m, **params)
+            except StepFailed as e:
+                if "not on navmesh" not in str(e):
+                    raise
+            else:
+                if "not on navmesh" not in r.get("error", ""):
+                    return r
     try:
         return _call(method, **params)
     except StepFailed as e:
