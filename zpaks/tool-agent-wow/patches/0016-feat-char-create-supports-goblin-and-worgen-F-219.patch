+// options select an extra catalogue: a server's own CharSections/CharHairGeosets/
+// CharacterFacialHairStyles DBCs plus a playercreateinfo dump, restricted to the races the
+// stock client does not ship (Zeppelin: goblin 9, worgen 12). The default is the stock catalogue.
+type options struct {
+	source  string
+	races   map[uint32]bool
+	out     string
+	varName string
+}
+
+func parseArgs(args []string) (options, error) {
+	o := options{source: clientdata.Directory, out: destination, varName: "catalogue"}
+	for i := 0; i < len(args); i++ {
+		if i+1 >= len(args) {
+			return o, fmt.Errorf("%s needs a value", args[i])
+		}
+		value := args[i+1]
+		switch args[i] {
+		case "--source":
+			o.source = value
+		case "--out":
+			o.out = value
+		case "--var":
+			o.varName = value
+		case "--races":
+			o.races = make(map[uint32]bool)
+			for _, field := range regexp.MustCompile(`\d+`).FindAllString(value, -1) {
+				n, _ := strconv.ParseUint(field, 10, 8)
+				o.races[uint32(n)] = true
+			}
+		default:
+			return o, fmt.Errorf("unknown argument %q", args[i])
+		}
+		i++
+	}
+	return o, nil
+}
