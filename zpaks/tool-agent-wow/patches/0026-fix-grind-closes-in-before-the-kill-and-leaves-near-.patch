From 1f0dc3608eb4d20acdb0df3e4b6219dd1851fd30 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Thu, 8 Oct 2026 10:45:38 +0000
Subject: [PATCH] fix: grind closes in before the kill and leaves near-grey
 areas (F-219)

Deathknell: 25 grind pulls, many 'too far' - targets up to 80 yd away, the kill RPC does not
chase that far. Walk to the target first; if only mobs 2+ levels below us are in sight, walk to
a spawn of a tougher quest target (at most once per 2 min).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SQmFdwZBdZ1kNkYTTF4JNJ
---
 zeppelin/tests/start_area.py | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/zeppelin/tests/start_area.py b/zeppelin/tests/start_area.py
index 085b98a..d0a33aa 100644
--- a/zeppelin/tests/start_area.py
+++ b/zeppelin/tests/start_area.py
@@ -887,6 +887,21 @@ class Runner:
         def crowd(t):
             return sum(1 for m in mobs if m is not t and math.dist((m["x"], m.get("y", 0)), (t["x"], t.get("y", 0))) < 10)
         t = min(easy, key=lambda o: (crowd(o), -lv.get(o["entry"], 0), o.get("distance", 999)))
+        best = max(lv.get(o["entry"], 0) for o in easy)
+        if best < level - 1 and getattr(self, "_grind_walk", 0) < time.time() - 120:
+            # only near-grey mobs here: go where the area's tougher quest targets live (once per 2 min)
+            self._grind_walk = time.time()
+            better = {int(r["entry"]): int(r["minlevel"]) for r in sql(
+                f"SELECT entry,minlevel FROM creature_template WHERE entry IN ({inlist(self.w.objective_creatures)}) "
+                f"AND minlevel BETWEEN {best + 1} AND {level}")}
+            me = self.me()
+            spots = sorted(((-better[e], math.dist(p[:2], (me["x"], me["y"])), p) for e in better
+                            for p in self.w.cspawn.get(e, []) if p not in self.w.beyond), key=lambda q: q[:2])
+            if spots:
+                self.travel(*spots[0][2], within=15)
+                return True
+        if t.get("distance", 0) > 5:  # the kill RPC will not chase far ("too far") - close in first
+            self.travel(t["x"], t.get("y", 0), t.get("z", 0), within=4)
         r = call("combat.kill", guid=int(t["guid"]), abilities=self.abilities, loot=True)
         self.kills += r.get("killed", False)
         print(f"  grind {t['entry']} (level {lv.get(t['entry'])}) while quests wait for level {level + 1}: "
-- 
2.34.1

