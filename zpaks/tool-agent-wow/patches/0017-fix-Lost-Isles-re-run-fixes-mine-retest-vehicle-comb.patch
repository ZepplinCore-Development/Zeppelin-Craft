+    def bar_timing(self, bar):
+        """Bar spell -> (cooldown s, max range yd) from the DBC: recovery time (at least the GCD) and
+        the hostile max range; a cone's reach is its effect radius."""
+        cache = self.__dict__.setdefault("_bar_timing", {})
+        need = [sp for sp in bar if sp and sp not in cache]
+        if need:
+            for r in dbc("SELECT s.id,s.recovery_time rt,s.category_recovery_time crt,s.start_recovery_time gcd,"
+                         "r.max_range_hostile mr,rad.radius rad FROM spell s LEFT JOIN spellrange r ON r.id=s.range_index "
+                         "LEFT JOIN spellradius rad ON rad.id=s.effect_radius_index_1 "
+                         f"WHERE s.id IN ({inlist(need)})"):
+                num = lambda v: 0.0 if v in (None, "", "NULL") else float(v)
+                cd = max(num(r["rt"]), num(r["crt"]), num(r["gcd"]), 500) / 1000.0
+                mr = num(r["mr"])
+                if mr > 1e6:  # SpellRange floats are stored as their raw IEEE-754 bits (100 yd = 1120403456)
+                    mr = struct.unpack("<f", struct.pack("<I", int(mr)))[0]
+                cache[int(r["id"])] = (cd, mr or 30.0, num(r["rad"]))
+        return {sp: cache.get(sp, (1.5, 30.0, 0.0)) for sp in bar if sp}
+
+    def dogfight(self, target, bar):
+        """We fly a gunship against fighters faster than us (The Pride of Kezan: Gnomeregan Stealth
+        Fighters 39039 vs our 39074). Chasing one target to 12 yd never closes and long-range
+        rockets fail out of range (silently - a vehicle's failed cast is never reported). Instead:
+        re-aim at the nearest fighter every half second in short hops, sweep the Machine Gun cone
+        whenever one is inside its radius, and fire rockets only in range and off cooldown."""
+        kinds = self.bar_kinds(bar)
+        timing = self.bar_timing([sp for sp, k in kinds.items() if k])
+        last, shots, t0 = {}, 0, time.time()
+        log0 = self.log()
+        while time.time() - t0 < 40:
+            if not any(call("vehicle.state").get("spells", [])):
+                break
+            objs = [o for o in call("interact.find", entry=target, limit=10).get("objects", [])
+                    if o.get("health", 0) > 0 and o.get("distance", 999) < 500]
+            if not objs:
+                time.sleep(1)
+                continue
+            o = min(objs, key=lambda x: x["distance"])
+            d = o["distance"]
+            call("move.face", x=o["x"], y=o.get("y", 0))
+            for sp, kind in kinds.items():
+                if not kind:
+                    continue
+                cd, rng, rad = timing.get(sp, (1.5, 30.0, 0.0))
+                reach = rad if kind == "cone" and rad else rng
+                if d > reach - 3 or time.time() - last.get(sp, 0) < cd:
+                    continue
+                if kind == "ground":
+                    call("vehicle.cast", spell_id=sp, ground=True, x=o["x"], y=o.get("y", 0), z=o.get("z", 0))
+                else:
+                    call("vehicle.cast", spell_id=sp, target=int(o["guid"]))
+                last[sp], shots = time.time(), shots + 1
+            if d > 30:
+                # close in: a short hop to a point just short of it, at its altitude, then re-aim
+                me = self.me()
+                k = max(0.0, (d - 20) / max(d, 1))
+                call("move.to", x=me["x"] + (o["x"] - me["x"]) * k, y=me["y"] + (o.get("y", 0) - me["y"]) * k,
+                     z=me.get("z", 0) + (o.get("z", 0) - me.get("z", 0)) * k, timeout_ms=1200)
+            else:
+                time.sleep(0.4)
+        log1 = self.log()
+        gained = sum(sum(e.get("counts", [0, 0, 0, 0])) for e in log1.values()) - \
+            sum(sum(e.get("counts", [0, 0, 0, 0])) for e in log0.values())
+        print(f"  dogfight with {target}: {shots} shots in {time.time() - t0:.0f}s, +{gained} credit", flush=True)
+        return True
