From f60a941da8d98dfb0253314bcfa58472087f37de Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Fri, 9 Oct 2026 00:11:20 +0000
Subject: [PATCH] fix: camp clearing pulls only mobs hostile to us (F-219)

Regression from careful kill-target clearing: Do it Yourself 14070 (Kezan) targets Bruno and co.
(neutral faction 7) standing among 261 friendly Kezan Citizens (faction 2159); the bot tried to
'clear' citizens first - no damage, quest stuck. hostile(entry) reads FactionTemplate.enemy_group
(1 players, 2 Alliance, 4 Horde) for our side; camp groups in kill() and clear_camp() only take
hostile mobs (the target itself always counts). Idle-wait message reworded.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SQmFdwZBdZ1kNkYTTF4JNJ
---
 zeppelin/tests/start_area.py | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/zeppelin/tests/start_area.py b/zeppelin/tests/start_area.py
index 96c7356..3811540 100644
--- a/zeppelin/tests/start_area.py
+++ b/zeppelin/tests/start_area.py
@@ -949,7 +949,8 @@ class Runner:
         info = {int(r["entry"]): (int(r["minlevel"]), int(r["type"])) for r in sql(
             f"SELECT entry,minlevel,type FROM creature_template WHERE entry IN ({inlist({o['entry'] for o in mobs})})")}
         level = call("interact.self").get("level", 1)
-        mobs = [o for o in mobs if info.get(o["entry"], (99, 0))[1] != 8]  # no critters (type 8)
+        mobs = [o for o in mobs if info.get(o["entry"], (99, 0))[1] != 8  # no critters (type 8)
+                and self.hostile(o["entry"])]                         # nor friendly/neutral bystanders
         if not mobs:
             return False
         # level+1 still lost 1v1 (a level-3 draenei vs a lone Mutated Owlkin 16537): only even or lower
@@ -1039,6 +1040,19 @@ class Runner:
               f"{r.get('reason', 'killed')}", flush=True)
         return True
 
+    def hostile(self, entry):
+        """Is this creature kind hostile to us? FactionTemplate enemy_group: 1 = players, 2 = Alliance,
+        4 = Horde. Camp clearing must only pull those - Do it Yourself's targets stand among 261
+        friendly Kezan Citizens (faction 2159) and the bot "cleared" citizens for no damage."""
+        cache = self.__dict__.setdefault("_hostile", {})
+        if entry not in cache:
+            side = 2 if self.w.race in (1, 3, 4, 7, 11, 12) else 4
+            rows = sql(f"SELECT faction FROM creature_template WHERE entry={int(entry)}")
+            fac = int(rows[0]["faction"]) if rows else 0
+            ft = dbc(f"SELECT enemy_group e FROM factiontemplate WHERE id={fac}") if fac else []
+            cache[entry] = bool(ft) and bool(int(ft[0]["e"]) & (1 | side))
+        return cache[entry]
+
     def giver_distance(self, qid, me):
         """Distance to the nearest spawn of any of the quest's givers."""
         best = 1e9
@@ -1081,7 +1095,8 @@ class Runner:
             return sum(1 for m in mobs if m is not t and
                        math.dist((m["x"], m.get("y", 0)), (t["x"], t.get("y", 0))) < 10)
         t = min(cands, key=lambda o: (crowd(o), o.get("distance", 999)))
-        group = [m for m in mobs if math.dist((m["x"], m.get("y", 0)), (t["x"], t.get("y", 0))) < 15]
+        group = [m for m in mobs if math.dist((m["x"], m.get("y", 0)), (t["x"], t.get("y", 0))) < 15
+                 and (m is t or self.hostile(m["entry"]))]
         if len(group) > 1:
             # the target stands in a camp: clear it from the edge - outermost first, approached from
             # its outer side - until the target is the next one out (a player would; the bot used to
@@ -2719,7 +2734,7 @@ class Runner:
                     if int(r["quest"]) in self.w.quests]
                 if open_q and self.idle_rechecks < 20:
                     self.idle_rechecks += 1
-                    print(f"  quest log empty but {open_q} still open in the DB - waiting", flush=True)
+                    print(f"  nothing workable right now but {open_q} still open in the DB - waiting", flush=True)
                     time.sleep(15)
                     idle = 0
                     continue
