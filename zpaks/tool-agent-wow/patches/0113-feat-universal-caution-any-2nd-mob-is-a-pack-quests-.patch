From 67df294bb0ad938d76cf07dd1a93f5e9f3d9c007 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Tue, 13 Oct 2026 12:44:33 +0000
Subject: [PATCH] feat: universal caution - any 2nd mob is a pack, quests <=
 level+1, rest to 90 % (F-219)

From the five worst bots: over half their deaths were 2-3 mob fights entered
at 35-50 % health, mostly against mobs 1-2 levels up. For every class now:
- planned pulls and camp clearing treat ANY second hostile in reach as a pack
  (park the quest unless a body pull draws the target alone); two pulls that
  brought 2+ park it too
- quests at most 1 level above us; routes refused past mobs 2+ levels up
- rest to 90 % before moving on (was 80)
Class fixes:
- Hunter's Mark is pull-only (fight_args(defend=True) drops it; it was the
  first cast of every ambush)
- a warlock's defend fights open with its DoTs
- druid Healing Touch below 55 % (it gets interrupted)
- combat: a Kill call lets a cast in flight finish (<= 3 s) before returning,
  unless dying or fleeing - the next walk cancelled it (26 mage Frostbolts
  INTERRUPTED a run)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019SSuH6gpqY4Kn5Rk9sd149
---
 zeppelin/modules/combat/main.go | 13 +++++++++++
 zeppelin/tests/start_area.py    | 39 ++++++++++++++++++++-------------
 2 files changed, 37 insertions(+), 15 deletions(-)

diff --git a/zeppelin/modules/combat/main.go b/zeppelin/modules/combat/main.go
index a1608ec..86f7565 100644
--- a/zeppelin/modules/combat/main.go
+++ b/zeppelin/modules/combat/main.go
@@ -442,6 +442,19 @@ func (s *service) Kill(ctx context.Context, req *combatv1.KillRequest) (*combatv
 	}
 	res := &combatv1.KillResult{Guid: guid}
 	finish := func(reason string, killed bool) (*combatv1.KillResult, error) {
+		if reason != "we died" && reason != "flee" {
+			// let a cast already on its way finish (up to 3 s): the caller walks off next and the move
+			// cancelled it - 26 of a mage's Frostbolts a run failed INTERRUPTED, their mana gone
+			for i := 0; i < 30; i++ {
+				s.mu.Lock()
+				busy := time.Now().Before(s.selfCastUntil)
+				s.mu.Unlock()
+				if !busy {
+					break
+				}
+				time.Sleep(100 * time.Millisecond)
+			}
+		}
 		_ = s.send(context.Background(), opcode.CMSGAttackstop, nil)
 		s.mu.Lock()
 		res.Swings, res.DamageDone, res.DamageTaken = s.swings-swings0, s.dmgDone-done0, s.dmgTaken-taken0
