+        # the moment the vehicle shows up: it is a spellclick vehicle and the first prompt is ~2.5 s
+        # after the summon, with a short answer clock
+        import threading
+        th = threading.Thread(target=lambda: call("interact.use", target={"entry": go}), daemon=True)
+        th.start()
