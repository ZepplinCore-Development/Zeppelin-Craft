+        while time.time() - t0 < 90:
+            st = call("vehicle.state")
+            if st.get("entry") == veh:
+                boarded = True
+            elif boarded:
+                break  # ejected: success or a wrong / late answer
+            ev = call("interact.events", since=since)
+            since = ev.get("last", since)
