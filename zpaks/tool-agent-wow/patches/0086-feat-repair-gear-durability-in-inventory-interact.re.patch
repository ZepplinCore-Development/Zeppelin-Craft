+// Repair sends CMSG_REPAIR_ITEM (npc u64, item u64 = 0 for everything, u8 guild bank = 0) to a repair
+// NPC (UNIT_NPC_FLAG_REPAIR). Bots died their gear to durability 0 - broken weapons fail every
+// weapon ability (EQUIPPED_ITEM_CLASS_MAINHAND) and broken armour has none.
+func (s *service) Repair(ctx context.Context, req *interactv1.Target) (*interactv1.CastResult, error) {
+	npc, err := s.resolve(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+	var w wow.Writer
+	w.U64(npc)
+	w.U64(0)
+	w.U8(0)
+	if err := s.send(ctx, opcode.CMSGRepairItem, &w); err != nil {
+		return nil, err
+	}
+	time.Sleep(500 * time.Millisecond)
+	return &interactv1.CastResult{Ok: true, Detail: "repair sent"}, nil
+}
