+					return nil, err
+				}
+				openerDone, res.Pull = true, "opener"
+				res.Casts++
+				res.Spells = append(res.Spells, req.GetOpenerSpell())
+				time.Sleep(tick)
+				continue
+			}
+		}
 		if pullState != "done" {
 			// open from range and let the target walk to us: it leaves its camp mates behind
 			// instead of us walking into their aggro radius
