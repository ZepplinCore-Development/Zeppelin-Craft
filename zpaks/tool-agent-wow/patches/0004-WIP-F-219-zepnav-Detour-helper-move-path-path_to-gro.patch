+"""Orc start: Kaltunk 4641 -> walk into the Den (navmesh) -> Gornek turn-in -> accept 788.
+
+Expects a fresh level 1 orc at the Valley of Trials start in a running `char play` session:
+  zep world char test-setup Zeppkt -r orc -c warrior -g male -l 1 -a ZEPPKT --map 1 --pos "-618.5 -4251.67" --replace
+"""
+import sys
+
+from rpc import call, go_to, near, run, step
+
+KALTUNK, GORNEK = 10176, 3143
+YOUR_PLACE, CUTTING_TEETH = 4641, 788
+
+
+def steps():
+    me = call("move.position")
+    step("in world", me.get("known", False), f"map {me.get('map', 0)} ({me.get('x'):.1f}, {me.get('y'):.1f})")
+    go_to(*near(KALTUNK), "Kaltunk")
+    r = call("interact.quest_accept", target={"entry": KALTUNK}, quest_id=YOUR_PLACE)
+    step("accept 4641 Your Place In The World", r.get("ok", False), r.get("detail", ""))
+    log = [e["questId"] for e in call("interact.quest_log").get("entries", [])]
+    step("4641 in quest log", YOUR_PLACE in log, str(log))
+    go_to(*near(GORNEK), "Gornek (inside the Den)")
+    r = call("interact.quest_complete", target={"entry": GORNEK}, quest_id=YOUR_PLACE)
+    step("turn in 4641 at Gornek", r.get("ok", False), r.get("detail", ""))
+    r = call("interact.quest_accept", target={"entry": GORNEK}, quest_id=CUTTING_TEETH)
+    step("accept 788 Cutting Teeth", r.get("ok", False), r.get("detail", ""))
+    ev = call("interact.events").get("events", [])
+    rewards = [e for e in ev if e.get("kind") == "quest_reward" and e.get("questId") == YOUR_PLACE]
+    step("quest_reward event for 4641", bool(rewards), f"{rewards[0].get('count')} XP" if rewards else "")
+
+
+sys.exit(run(steps))
