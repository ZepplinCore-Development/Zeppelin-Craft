diff --git a/zeppelin/install.sh b/zeppelin/install.sh
index 7a405cb..47befcb 100755
--- a/zeppelin/install.sh
+++ b/zeppelin/install.sh
@@ -2,13 +2,16 @@
 # Build Zeppelin's agent-wow modules (F-219) into a modules directory.
 #   zeppelin/install.sh <module_dir> [module...]     (default: every zeppelin/modules/*)
 # Each module dir gets: its binary (named after the module), module.yaml, module.pb.
-# Needs protoc (~/.local/protoc) and the Go toolchain (GOTOOLCHAIN=auto fetches 1.27.1).
+# Needs protoc (~/.local/protoc), the Go toolchain (GOTOOLCHAIN=auto fetches 1.27.1) and g++.
+# The move module also gets zepnav (zeppelin/nav), compiled against Zeppelin-Core's vendored
+# Detour ($DETOUR_DIR) so it loads mmaps exactly as the worldserver does.
 set -euo pipefail
 ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
 DEST="${1:?usage: install.sh <module_dir> [module...]}"; shift
 PROTOC="${PROTOC:-$HOME/.local/protoc/bin/protoc}"
 INCLUDE="${PROTOC_INCLUDE:-$HOME/.local/protoc/include}"
 export GOTOOLCHAIN="${GOTOOLCHAIN:-auto}"
+DETOUR_DIR="${DETOUR_DIR:-/workspace/project/Zeppelin-Core/deps/recastnavigation/Detour}"
 cd "$ROOT"
 mods=("$@"); [ ${#mods[@]} -eq 0 ] && mods=($(ls zeppelin/modules))
 for m in "${mods[@]}"; do
@@ -17,5 +20,8 @@ for m in "${mods[@]}"; do
     go build -o "$out/$m" "./$src"
     "$PROTOC" -I . -I "$INCLUDE" --include_imports --descriptor_set_out="$out/module.pb" "$src/$m.proto"
     cp "$src/module.yaml" "$out/module.yaml"
+    if [ "$m" = move ]; then
+        g++ -O2 -std=c++17 -w -I"$DETOUR_DIR/Include" zeppelin/nav/zepnav.cpp "$DETOUR_DIR"/Source/*.cpp -o "$out/zepnav"
+    fi
     echo "installed $m -> $out"
 done
