 }
diff --git a/zeppelin/nav/zepnav.cpp b/zeppelin/nav/zepnav.cpp
new file mode 100644
index 0000000..d71e2ad
--- /dev/null
+++ b/zeppelin/nav/zepnav.cpp
@@ -0,0 +1,238 @@
+// zepnav - Detour path queries on AzerothCore mmaps for Zeppelin's agent-wow move module (F-219).
+//
+// Built against the Detour copy vendored in Zeppelin-Core (deps/recastnavigation, which defines
+// DT_POLYREF64 itself), so tiles load exactly as the worldserver loads them (MMapMgr::loadMap).
+// Query settings mirror the worldserver's PathGenerator: WoW (x,y,z) <-> recast (y,z,x), nearest
+// poly extents {3,5,3} then {3,50,3}, include NAV_GROUND|NAV_WATER|NAV_MAGMA.
+//
+// Line protocol on stdin/stdout (one reply line per request):
+//   path <map> <x1> <y1> <z1> <x2> <y2> <z2>  ->  ok|partial <n> <x y z>...   or   err <reason>
+//   height <map> <x> <y> <z>                  ->  ok <z>                       or   err <reason>
+//   quit
+// Data root: $ZEPNAV_DATA (default /workspace/project/data), reading <root>/mmaps/.
+#include "DetourNavMesh.h"
+#include "DetourNavMeshQuery.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <iostream>
+#include <map>
+#include <memory>
+#include <set>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace {
+
+constexpr uint32_t MMAP_MAGIC = 0x4d4d4150; // 'MMAP'
+constexpr uint32_t MMAP_VERSION = 19;
+constexpr float GRID_SIZE = 533.3333f;
+constexpr int MAX_POLYS = 4096;
+constexpr int MAX_POINTS = 1024;
+constexpr uint16_t NAV_GROUND = 0x01, NAV_MAGMA = 0x02, NAV_WATER = 0x08;
+
+#pragma pack(push, 1)
+struct MmapTileHeader // MapDefines.h: 16 + 1 + 3 + MmapTileRecastConfig(36) = 56 bytes
+{
+    uint32_t mmapMagic;
+    uint32_t dtVersion;
+    uint32_t mmapVersion;
+    uint32_t size;
+    char usesLiquids;
+    char padding[3];
+    unsigned char recastConfig[36];
+};
+#pragma pack(pop)
+static_assert(sizeof(MmapTileHeader) == 56, "MmapTileHeader layout");
+
+std::string g_root = "/workspace/project/data";
+
+struct MapMesh
+{
+    dtNavMesh* mesh = nullptr;
+    dtNavMeshQuery* query = nullptr;
+    std::set<std::pair<int, int>> tried; // filename indices already attempted
+};
+std::map<uint32_t, MapMesh> g_maps;
+
+MapMesh* openMap(uint32_t mapId, std::string& err)
+{
+    auto it = g_maps.find(mapId);
+    if (it != g_maps.end())
+        return &it->second;
+    char path[512];
+    std::snprintf(path, sizeof(path), "%s/mmaps/%03u.mmap", g_root.c_str(), mapId);
+    FILE* f = std::fopen(path, "rb");
+    if (!f) { err = std::string("no mmap file ") + path; return nullptr; }
+    dtNavMeshParams params;
+    size_t n = std::fread(&params, sizeof(params), 1, f);
+    std::fclose(f);
+    if (n != 1) { err = "short .mmap file"; return nullptr; }
+    MapMesh mm;
+    mm.mesh = dtAllocNavMesh();
+    if (dtStatusFailed(mm.mesh->init(&params))) { err = "dtNavMesh::init failed"; return nullptr; }
+    mm.query = dtAllocNavMeshQuery();
+    if (dtStatusFailed(mm.query->init(mm.mesh, 65535))) { err = "dtNavMeshQuery::init failed"; return nullptr; }
+    return &(g_maps[mapId] = mm);
+}
+
+// loadTile tries <map><a><b>.mmtile; Detour places the tile by its own header, so loading a
+// neighbour by a swapped guess is harmless.
+void loadTile(uint32_t mapId, MapMesh& mm, int a, int b)
+{
+    if (a < 0 || b < 0 || a > 63 || b > 63 || !mm.tried.insert({a, b}).second)
+        return;
+    char path[512];
+    std::snprintf(path, sizeof(path), "%s/mmaps/%03u%02d%02d.mmtile", g_root.c_str(), mapId, a, b);
+    FILE* f = std::fopen(path, "rb");
+    if (!f)
+        return;
+    MmapTileHeader h;
+    if (std::fread(&h, sizeof(h), 1, f) != 1 || h.mmapMagic != MMAP_MAGIC || h.mmapVersion != MMAP_VERSION ||
+        h.dtVersion != DT_NAVMESH_VERSION)
+    {
+        std::fclose(f);
+        std::cerr << "zepnav: bad header " << path << "\n";
+        return;
+    }
+    unsigned char* data = static_cast<unsigned char*>(dtAlloc(h.size, DT_ALLOC_PERM));
+    if (std::fread(data, h.size, 1, f) != 1)
+    {
+        std::fclose(f);
+        dtFree(data);
+        return;
+    }
+    std::fclose(f);
+    dtTileRef ref = 0;
+    if (dtStatusFailed(mm.mesh->addTile(data, h.size, DT_TILE_FREE_DATA, 0, &ref)))
+        dtFree(data);
+}
+
+int gridIndex(float c) { return int(32.0f - c / GRID_SIZE); }
+
+// ensureArea loads every tile touching the segment's bounding box (plus a one-tile margin),
+// under both filename orders.
+void ensureArea(uint32_t mapId, MapMesh& mm, float x1, float y1, float x2, float y2)
+{
+    int ax = gridIndex(x1), bx = gridIndex(x2), ay = gridIndex(y1), by = gridIndex(y2);
+    for (int gx = std::min(ax, bx) - 1; gx <= std::max(ax, bx) + 1; ++gx)
+        for (int gy = std::min(ay, by) - 1; gy <= std::max(ay, by) + 1; ++gy)
+        {
+            loadTile(mapId, mm, gx, gy);
+            loadTile(mapId, mm, gy, gx);
+        }
+}
+
+dtQueryFilter makeFilter()
+{
+    dtQueryFilter f;
+    f.setIncludeFlags(NAV_GROUND | NAV_WATER | NAV_MAGMA);
+    f.setExcludeFlags(0);
+    return f;
+}
+
+dtPolyRef nearestPoly(dtNavMeshQuery* q, dtQueryFilter const& f, float const* p, float* closest)
+{
+    float ext[3] = {3.0f, 5.0f, 3.0f};
+    dtPolyRef ref = 0;
+    if (dtStatusSucceed(q->findNearestPoly(p, ext, &f, &ref, closest)) && ref)
+        return ref;
+    ext[1] = 50.0f;
+    if (dtStatusSucceed(q->findNearestPoly(p, ext, &f, &ref, closest)) && ref)
+        return ref;
+    return 0;
+}
+
+std::string doPath(std::istringstream& in)
+{
+    uint32_t mapId;
+    float x1, y1, z1, x2, y2, z2;
+    if (!(in >> mapId >> x1 >> y1 >> z1 >> x2 >> y2 >> z2))
+        return "err usage: path <map> <x1> <y1> <z1> <x2> <y2> <z2>";
+    std::string err;
+    MapMesh* mm = openMap(mapId, err);
+    if (!mm)
+        return "err " + err;
+    ensureArea(mapId, *mm, x1, y1, x2, y2);
+    dtQueryFilter f = makeFilter();
+    float s[3] = {y1, z1, x1}, e[3] = {y2, z2, x2}, sc[3], ec[3];
+    dtPolyRef sp = nearestPoly(mm->query, f, s, sc), ep = nearestPoly(mm->query, f, e, ec);
+    if (!sp)
+        return "err start not on navmesh";
+    if (!ep)
+        return "err end not on navmesh";
+    std::vector<dtPolyRef> polys(MAX_POLYS);
+    int npolys = 0;
+    dtStatus st = mm->query->findPath(sp, ep, sc, ec, &f, polys.data(), &npolys, MAX_POLYS);
+    if (dtStatusFailed(st) || npolys == 0)
+        return "err findPath failed";
+    bool partial = dtStatusDetail(st, DT_PARTIAL_RESULT) || polys[npolys - 1] != ep;
+    float target[3] = {ec[0], ec[1], ec[2]};
+    if (partial) // aim at the closest point of the last reachable poly
+        mm->query->closestPointOnPoly(polys[npolys - 1], ec, target, nullptr);
+    std::vector<float> pts(MAX_POINTS * 3);
+    int npts = 0;
+    st = mm->query->findStraightPath(sc, target, polys.data(), npolys, pts.data(), nullptr, nullptr, &npts, MAX_POINTS);
+    if (dtStatusFailed(st) || npts == 0)
+        return "err findStraightPath failed";
+    std::ostringstream out;
+    out << (partial ? "partial " : "ok ") << npts;
+    out.setf(std::ios::fixed);
+    out.precision(3);
+    for (int i = 0; i < npts; ++i)
+        out << ' ' << pts[i * 3 + 2] << ' ' << pts[i * 3 + 0] << ' ' << pts[i * 3 + 1]; // back to WoW x y z
+    return out.str();
+}
+
+std::string doHeight(std::istringstream& in)
+{
+    uint32_t mapId;
+    float x, y, z;
+    if (!(in >> mapId >> x >> y >> z))
+        return "err usage: height <map> <x> <y> <z>";
+    std::string err;
+    MapMesh* mm = openMap(mapId, err);
+    if (!mm)
+        return "err " + err;
+    ensureArea(mapId, *mm, x, y, x, y);
+    dtQueryFilter f = makeFilter();
+    float p[3] = {y, z, x}, c[3];
+    if (!nearestPoly(mm->query, f, p, c))
+        return "err not on navmesh";
+    std::ostringstream out;
+    out.setf(std::ios::fixed);
+    out.precision(3);
+    out << "ok " << c[1];
+    return out.str();
+}
+
+} // namespace
+
+int main()
+{
+    if (char const* root = std::getenv("ZEPNAV_DATA"))
+        g_root = root;
+    std::ios::sync_with_stdio(false);
+    std::string line;
+    while (std::getline(std::cin, line))
+    {
+        std::istringstream in(line);
+        std::string cmd;
+        in >> cmd;
+        std::string reply;
+        if (cmd == "path")
+            reply = doPath(in);
+        else if (cmd == "height")
+            reply = doHeight(in);
+        else if (cmd == "quit")
+            break;
+        else
+            reply = "err unknown command";
+        std::cout << reply << '\n' << std::flush;
+    }
+    return 0;
+}
