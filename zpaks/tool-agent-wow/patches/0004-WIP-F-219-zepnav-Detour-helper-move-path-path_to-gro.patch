+"""Tiny JSON-RPC client + step runner for Zeppelin agent-wow test scripts (F-219 Track A)."""
+import json
+import sys
+import time
+import urllib.request
+
+URL = "http://127.0.0.1:8086/rpc"
+_id = 0
+
+
+class StepFailed(Exception):
+    pass
+
+
+def call(method, **params):
+    global _id
+    _id += 1
+    body = json.dumps({"jsonrpc": "2.0", "id": _id, "method": method, "params": params}).encode()
+    req = urllib.request.Request(URL, body, {"Content-Type": "application/json"})
+    with urllib.request.urlopen(req, timeout=40) as r:
+        reply = json.load(r)
+    if "error" in reply:
+        raise StepFailed(f"{method}: {reply['error']}")
+    return reply.get("result", {})
+
+
+def step(name, ok, detail=""):
+    mark = "PASS" if ok else "FAIL"
+    print(f"[{mark}] {name}" + (f" - {detail}" if detail else ""), flush=True)
+    if not ok:
+        raise StepFailed(name)
+
+
+def ground(x, y, z_guess):
+    g = call("move.ground", x=x, y=y, z=z_guess)
+    return g["z"] if g.get("ok") else z_guess
+
+
+def go_to(x, y, z, name, within=3.0, max_calls=8):
+    """path_to until arrived (each call is budget-limited)."""
+    t0, walked, calls = time.time(), 0.0, 0
+    for _ in range(max_calls):
+        r = call("move.path_to", x=x, y=y, z=z)
+        mv = r["move"]
+        walked, calls = walked + mv.get("distance", 0), calls + 1
+        if mv.get("arrived") or r.get("remaining", 99) <= within:
+            step(f"walk to {name}", True, f"{walked:.1f} yd in {calls} call(s), {time.time() - t0:.1f} s")
+            return mv["position"]
+        if mv.get("reason") not in ("budget",):
+            step(f"walk to {name}", False, f"{mv.get('reason')} remaining {r.get('remaining')}")
+    step(f"walk to {name}", False, "too many calls")
+
+
+def near(entry, offset=2.0):
+    """A ground point `offset` yd from the nearest visible object of entry, on our side."""
+    objs = call("interact.find", entry=entry, limit=1).get("objects", [])
+    if not objs:
+        raise StepFailed(f"entry {entry} not visible")
+    o = objs[0]
+    me = call("move.position")
+    dx, dy = me["x"] - o["x"], me["y"] - o["y"]
+    d = max((dx * dx + dy * dy) ** 0.5, 0.01)
+    x, y = o["x"] + dx / d * offset, o["y"] + dy / d * offset
+    return x, y, ground(x, y, o["z"])
+
+
+def run(steps):
+    try:
+        steps()
+        print("RESULT: PASS")
+        return 0
+    except StepFailed as e:
+        print(f"RESULT: FAIL at {e}")
+        return 1
