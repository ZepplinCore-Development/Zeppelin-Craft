+		}
+		if err := cmd.Start(); err != nil {
+			return "", fmt.Errorf("start zepnav %s: %w", bin, err)
+		}
+		n.cmd, n.in, n.out = cmd, in, bufio.NewReader(out)
+	}
+	if _, err := io.WriteString(n.in, line+"\n"); err != nil {
+		n.cmd = nil
+		return "", err
+	}
+	reply, err := n.out.ReadString('\n')
+	if err != nil {
+		n.cmd = nil
+		return "", err
+	}
+	return strings.TrimSpace(reply), nil
+}
+
+func (s *service) path(req *movev1.PathRequest) (*movev1.PathResult, error) {
+	p := s.snapshot()
+	if !p.GetKnown() {
+		return nil, status.Error(codes.FailedPrecondition, "position unknown (not in world yet)")
+	}
+	reply, err := s.nav.query(fmt.Sprintf("path %d %f %f %f %f %f %f", p.GetMap(), p.GetX(), p.GetY(), p.GetZ(), req.GetX(), req.GetY(), req.GetZ()))
+	if err != nil {
+		return nil, status.Error(codes.Unavailable, err.Error())
+	}
+	f := strings.Fields(reply)
+	if len(f) == 0 || f[0] == "err" {
+		return &movev1.PathResult{Error: strings.TrimPrefix(reply, "err ")}, nil
+	}
+	res := &movev1.PathResult{Partial: f[0] == "partial"}
+	for i := 2; i+2 < len(f); i += 3 {
+		x, _ := strconv.ParseFloat(f[i], 32)
+		y, _ := strconv.ParseFloat(f[i+1], 32)
+		z, _ := strconv.ParseFloat(f[i+2], 32)
+		res.Points = append(res.Points, &movev1.Point{X: float32(x), Y: float32(y), Z: float32(z)})
+	}
+	return res, nil
+}
+
+func (s *service) Path(_ context.Context, req *movev1.PathRequest) (*movev1.PathResult, error) {
+	return s.path(req)
+}
+
+// PathTo walks the navmesh path to the target for up to budget_ms, then reports what is left;
+// call it again until arrived (one call is capped at 30 s by agent-wow).
+func (s *service) PathTo(ctx context.Context, req *movev1.PathRequest) (*movev1.PathToResult, error) {
+	pr, err := s.path(req)
+	if err != nil {
+		return nil, err
+	}
+	if pr.GetError() != "" {
+		return nil, status.Errorf(codes.FailedPrecondition, "no path: %s", pr.GetError())
+	}
+	var route []point
+	for i, p := range pr.GetPoints() {
+		if i == 0 {
+			continue // the start (our own position, snapped to the mesh)
+		}
+		route = append(route, point{float64(p.GetX()), float64(p.GetY()), float64(p.GetZ())})
+	}
+	budget := time.Duration(req.GetBudgetMs()) * time.Millisecond
+	if budget <= 0 {
+		budget = maxBudget
+	}
+	mv, err := s.walk(ctx, route, float64(req.GetSpeed()), budget)
+	if err != nil {
+		return nil, err
+	}
+	pos := mv.GetPosition()
+	left := dist(point{float64(pos.GetX()), float64(pos.GetY()), float64(pos.GetZ())},
+		point{float64(req.GetX()), float64(req.GetY()), float64(req.GetZ())})
+	if mv.GetArrived() && pr.GetPartial() {
+		mv.Arrived, mv.Reason = false, "partial path: reached the closest navmesh point"
+	}
+	return &movev1.PathToResult{Move: mv, Partial: pr.GetPartial(), Remaining: float32(left), Waypoints: uint32(len(route))}, nil
+}
+
+func (s *service) Ground(_ context.Context, req *movev1.GroundRequest) (*movev1.GroundResult, error) {
+	p := s.snapshot()
+	reply, err := s.nav.query(fmt.Sprintf("height %d %f %f %f", p.GetMap(), req.GetX(), req.GetY(), req.GetZ()))
+	if err != nil {
+		return nil, status.Error(codes.Unavailable, err.Error())
+	}
+	f := strings.Fields(reply)
+	if len(f) == 2 && f[0] == "ok" {
+		z, _ := strconv.ParseFloat(f[1], 32)
+		return &movev1.GroundResult{Ok: true, Z: float32(z)}, nil
 	}
+	return &movev1.GroundResult{Error: strings.TrimPrefix(reply, "err ")}, nil
 }
 
 func (s *service) BeforeLogout(ctx context.Context, _ *emptypb.Empty) (*emptypb.Empty, error) {
