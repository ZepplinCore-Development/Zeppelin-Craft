--- /dev/null
+++ b/zeppelin/tests/zonemap.py
@@ -0,0 +1,40 @@
+"""Which zone a point is in, from the server's own .map files (F-219 fleet).
+
+WorldMapArea bounds are rectangles: Mulgore's holds the Crossroads, so a "Mulgore" run walked a
+level-6 druid into level-16 Barrens mobs. AzerothCore's extracted maps store an area id per cell
+(GridMap::getArea); AreaTable maps an area to its zone.
+"""
+import os
+import struct
+
+MAPS = "/workspace/project/data/maps"
+GRID = 533.3333333
+_tiles = {}
+
+
+def _tile(mapid, gx, gy):
+    k = (mapid, gx, gy)
+    if k not in _tiles:
+        fn = os.path.join(MAPS, "%03d%02d%02d.map" % (mapid, gx, gy))
+        if not os.path.exists(fn):
+            _tiles[k] = None
+        else:
+            with open(fn, "rb") as f:
+                b = f.read()
+            aoff = struct.unpack_from("<I", b, 12)[0]  # map_fileheader.areaMapOffset
+            _, flags, grid = struct.unpack_from("<4sHH", b, aoff)  # 'AREA', flags, gridArea
+            amap = None if flags & 1 else struct.unpack_from("<256H", b, aoff + 8)  # MAP_AREA_NO_AREA
+            _tiles[k] = (grid, amap)
+    return _tiles[k]
+
+
+def area_at(mapid, x, y):
+    """AreaTable id at a world point (0 = no map data): AzerothCore GridMap::getArea."""
+    t = _tile(mapid, int(32 - x / GRID), int(32 - y / GRID))
+    if t is None:
+        return 0
+    grid, amap = t
+    if amap is None:
+        return grid
+    lx, ly = int(16 * (32 - x / GRID)) & 15, int(16 * (32 - y / GRID)) & 15
+    return amap[lx * 16 + ly]
