-    return reply.get("result", {})
+    return _zeros(reply.get("result", {}))
+
+
+# proto3 JSON leaves out zero-valued fields: a pod floating at z = 0, a corpse at health 0, a unit
+# at distance 0. A missing coordinate/stat IS zero, so put the zeros back where scripts index them.
+_POS = ("x", "y", "z")
+_OBJ = _POS + ("distance", "health")
+
+
+def _zeros(res):
+    if isinstance(res, dict):
+        for o in res.get("objects", ()):
+            for k in _OBJ:
+                o.setdefault(k, 0)
+        for key in ("position", "move"):
+            sub = res.get(key)
+            if isinstance(sub, dict):
+                _zeros(sub)
+        if "known" in res or "map" in res:  # a Position
+            for k in _POS:
+                res.setdefault(k, 0)
+    return res
 
 
