+// -- RPCs: bags ----------------------------------------------------------------------------------
+
+// SendAddon whispers an addon message the way SendAddonMessage(prefix, body, "WHISPER", target)
+// does: CMSG_MESSAGECHAT u32 CHAT_MSG_WHISPER (7), u32 LANG_ADDON, target, "prefix\tbody".
+func (s *service) SendAddon(ctx context.Context, req *interactv1.AddonMessage) (*interactv1.CastResult, error) {
+	var w wow.Writer
+	w.U32(7)
+	w.U32(0xFFFFFFFF)
+	w.CString(req.GetTarget())
+	w.CString(req.GetPrefix() + "\t" + req.GetBody())
+	if err := s.send(ctx, opcode.CMSGMessagechat, &w); err != nil {
+		return nil, err
+	}
+	return &interactv1.CastResult{Ok: true, Detail: "sent"}, nil
+}
+
+// ItemSpell casts at a bag item (TARGET_FLAG_ITEM 0x10 + packed item guid) and loots the window
+// the server opens on that item (Disenchant: SMSG_LOOT_RESPONSE keyed by the item guid).
+func (s *service) ItemSpell(ctx context.Context, req *interactv1.ItemSpellRequest) (*interactv1.LootResult, error) {
+	spell := req.GetSpellId()
+	if spell == 0 {
+		spell = 13262
+	}
+	item := req.GetItemGuid()
+	s.mu.Lock()
+	s.castCount++
+	count := s.castCount
+	s.mu.Unlock()
+	var w wow.Writer
+	w.U8(count)
+	w.U32(spell)
+	w.U8(0) // cast flags
+	w.U32(targetFlagItem)
+	w.PackedGUID(item)
+	return s.lootWith(ctx, item, func() error { return s.send(ctx, opcode.CMSGCastSpell, &w) }, true, 8*time.Second)
+}
+
+// Equip sends CMSG_AUTOEQUIP_ITEM (u8 bag, u8 slot): the server picks the slot, and a container
+// goes into a free bag slot. Errors come back as SMSG_INVENTORY_CHANGE_FAILURE (u8 result first).
+func (s *service) Equip(ctx context.Context, req *interactv1.ItemSlot) (*interactv1.CastResult, error) {
+	var w wow.Writer
+	w.U8(uint8(req.GetBag()))
+	w.U8(uint8(req.GetSlot()))
+	return s.bagOp(ctx, opcode.CMSGAutoequipItem, &w)
+}
+
+// Destroy sends CMSG_DESTROYITEM (u8 bag, u8 slot, u8 count, 3 x u8 unused).
+func (s *service) Destroy(ctx context.Context, req *interactv1.ItemSlot) (*interactv1.CastResult, error) {
+	var w wow.Writer
+	w.U8(uint8(req.GetBag()))
+	w.U8(uint8(req.GetSlot()))
+	w.U8(uint8(req.GetCount()))
+	w.U8(0)
+	w.U8(0)
+	w.U8(0)
+	return s.bagOp(ctx, opcode.CMSGDestroyitem, &w)
+}
+
+func (s *service) bagOp(ctx context.Context, op uint32, w *wow.Writer) (*interactv1.CastResult, error) {
+	ch := s.listen(opcode.SMSGInventoryChangeFailure)
+	defer s.unlisten(ch)
+	if err := s.send(ctx, op, w); err != nil {
+		return nil, err
+	}
+	if p, ok := await(ctx, ch, 800*time.Millisecond); ok && len(p.payload) > 0 && p.payload[0] != 0 {
+		return &interactv1.CastResult{Detail: fmt.Sprintf("inventory error %d", p.payload[0])}, nil
+	}
+	return &interactv1.CastResult{Ok: true, Detail: "done"}, nil
+}
