diff --git a/zeppelin/tests/supervise.sh b/zeppelin/tests/supervise.sh
new file mode 100755
index 0000000..e154fd7
--- /dev/null
+++ b/zeppelin/tests/supervise.sh
@@ -0,0 +1,21 @@
+#!/bin/bash
+# supervise.sh CHAR MAP X1 Y1 X2 Y2 MINUTES LOG - run start_area.py and survive worldserver restarts
+# (other sessions reboot the shared worldserver before their tests): when the agent-wow session
+# drops, wait for the server, log back in and resume. The runner rebuilds its state from the quest log.
+CHAR=$1; MAP=$2; BOX="$3 $4 $5 $6"; MIN=$7; LOG=$8
+RUN=$(cd "$(dirname "$0")" && pwd); TESTS="$RUN/../agent-wow/zeppelin/tests"
+deadline=$(( $(date +%s) + MIN * 60 ))
+for attempt in $(seq 1 12); do
+  if ! "$RUN/rpc.sh" interact.self | grep -q '"guid"'; then
+    pkill -f "agent-wow char play $CHAR" ; sleep 3
+    (cd "$RUN" && setsid ../agent-wow/bin/agent-wow char play "$CHAR" < /dev/null > "$RUN/session-$CHAR.log" 2>&1 &)
+    for i in $(seq 1 30); do sleep 5; "$RUN/rpc.sh" interact.self | grep -q '"guid"' && break; done
+    echo "[SUPERVISOR] session $attempt up: $("$RUN/rpc.sh" interact.self | cut -c1-80)" >> "$LOG"
+  fi
+  left=$(( (deadline - $(date +%s)) / 60 )); [ "$left" -le 0 ] && break
+  (cd "$TESTS" && python3 -u start_area.py --char "$CHAR" --map "$MAP" --box $BOX --minutes "$left" >> "$LOG" 2>&1)
+  tail -5 "$LOG" | grep -q "^RESULT:" && ! tail -30 "$LOG" | grep -q "Connection refused\|disconnected" && break
+  echo "[SUPERVISOR] runner stopped without a result (server restart?) - reconnecting" >> "$LOG"
+  sleep 20
+done
+echo "[SUPERVISOR] done" >> "$LOG"
