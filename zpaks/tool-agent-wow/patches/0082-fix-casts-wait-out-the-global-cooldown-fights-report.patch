+++ b/zeppelin/modules/combat/api/combat.pb.go
@@ -349,6 +349,7 @@ type KillResult struct {
 	Casts         uint32                 `protobuf:"varint,12,opt,name=casts,proto3" json:"casts,omitempty"`
 	PeakAttackers uint32                 `protobuf:"varint,13,opt,name=peak_attackers,json=peakAttackers,proto3" json:"peak_attackers,omitempty"` // most units attacking us at once during the fight (1 = a single pull)
 	Spells        []uint32               `protobuf:"varint,15,rep,packed,name=spells,proto3" json:"spells,omitempty"`                             // every spell we cast this fight, in order (proof the rotation fires)
+	CastFails     []string               `protobuf:"bytes,16,rep,name=cast_fails,json=castFails,proto3" json:"cast_fails,omitempty"`              // "spell:result xN" from SMSG_CAST_FAILED this fight
 	Pull          string                 `protobuf:"bytes,14,opt,name=pull,proto3" json:"pull,omitempty"`                                         // "" no opener, "pulled", "came" (target walked in), "failed N" (cast result)
 	unknownFields protoimpl.UnknownFields
 	sizeCache     protoimpl.SizeCache
@@ -482,6 +483,13 @@ func (x *KillResult) GetSpells() []uint32 {
 	return nil
 }
 
+func (x *KillResult) GetCastFails() []string {
+	if x != nil {
+		return x.CastFails
+	}
+	return nil
+}
+
 func (x *KillResult) GetPull() string {
 	if x != nil {
 		return x.Pull
@@ -847,7 +855,7 @@ const file_zeppelin_modules_combat_combat_proto_rawDesc = "" +
 	"\bflee_pct\x18\r \x01(\rR\afleePct\"9\n" +
 	"\bLootItem\x12\x17\n" +
 	"\aitem_id\x18\x01 \x01(\rR\x06itemId\x12\x14\n" +
-	"\x05count\x18\x02 \x01(\rR\x05count\"\xc7\x03\n" +
+	"\x05count\x18\x02 \x01(\rR\x05count\"\xe6\x03\n" +
 	"\n" +
 	"KillResult\x12\x16\n" +
 	"\x06killed\x18\x01 \x01(\bR\x06killed\x12\x16\n" +
@@ -866,7 +874,9 @@ const file_zeppelin_modules_combat_combat_proto_rawDesc = "" +
 	"\x04loot\x18\v \x03(\v2\x1c.zeppelin.combat.v1.LootItemR\x04loot\x12\x14\n" +
 	"\x05casts\x18\f \x01(\rR\x05casts\x12%\n" +
 	"\x0epeak_attackers\x18\r \x01(\rR\rpeakAttackers\x12\x16\n" +
-	"\x06spells\x18\x0f \x03(\rR\x06spells\x12\x12\n" +
+	"\x06spells\x18\x0f \x03(\rR\x06spells\x12\x1d\n" +
+	"\n" +
+	"cast_fails\x18\x10 \x03(\tR\tcastFails\x12\x12\n" +
 	"\x04pull\x18\x0e \x01(\tR\x04pull\"\xac\x02\n" +
 	"\vRestRequest\x12\x1b\n" +
