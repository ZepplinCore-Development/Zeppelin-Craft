diff --git a/zeppelin/modules/combat/combat.proto b/zeppelin/modules/combat/combat.proto
index 39e76f8..e77dedb 100644
--- a/zeppelin/modules/combat/combat.proto
+++ b/zeppelin/modules/combat/combat.proto
@@ -56,6 +56,7 @@ message KillResult {
   uint32 casts = 12;
   uint32 peak_attackers = 13; // most units attacking us at once during the fight (1 = a single pull)
   repeated uint32 spells = 15; // every spell we cast this fight, in order (proof the rotation fires)
+  repeated string cast_fails = 16; // "spell:result xN" from SMSG_CAST_FAILED this fight
   string pull = 14;      // "" no opener, "pulled", "came" (target walked in), "failed N" (cast result)
 }
 
diff --git a/zeppelin/modules/combat/main.go b/zeppelin/modules/combat/main.go
index ebdaa41..d2e1c28 100644
--- a/zeppelin/modules/combat/main.go
+++ b/zeppelin/modules/combat/main.go
@@ -63,6 +63,8 @@ type service struct {
 	auras                                         map[uint8]uint32     // our visible aura slots -> spell
 	casting                                       map[uint64]time.Time // unit -> when its current cast ends
 	selfCastUntil                                 time.Time            // our own cast bar
+	lastCastSent                                  time.Time            // GCD runs from here
+	castFails                                     map[string]uint32    // "spell:result" -> count, this fight
 }
 
 func main() {
@@ -91,7 +93,7 @@ func run() error {
 	}
 	defer conn.Close()
 	s := &service{session: modv1.NewSessionClient(conn), attackers: map[uint64]time.Time{}, castFailed: map[uint32]uint8{},
-		auras: map[uint8]uint32{}, casting: map[uint64]time.Time{}}
+		auras: map[uint8]uint32{}, casting: map[uint64]time.Time{}, castFails: map[string]uint32{}}
 	server := grpc.NewServer()
 	combatv1.RegisterCombatServer(server, s)
 	healthy := health.NewServer()
@@ -201,7 +203,9 @@ func (s *service) OnPacket(ctx context.Context, p *modv1.WorldPacket) (*emptypb.
 		spell, result := r.U32(), r.U8()
 		fmt.Fprintf(os.Stderr, "cast failed spell %d result %d\n", spell, result)
 		s.castFailed[spell] = result
-		s.selfCastUntil = time.Time{}
+		s.castFails[fmt.Sprintf("%d:%d", spell, result)]++
+		// a retry the same tick fails the same way: give it a beat (not ready, out of range...)
+		s.selfCastUntil = time.Now().Add(300 * time.Millisecond)
 	case opcode.MSGCorpseQuery: // u8 found, i32 map, x y z, i32 corpse map (QueryHandler)
 		if r.U8() == 1 {
 			m := r.U32()
@@ -241,7 +245,9 @@ func (s *service) OnPacket(ctx context.Context, p *modv1.WorldPacket) (*emptypb.
 		u := r.PackedGUID()
 		delete(s.casting, u)
 		if u == me {
-			s.selfCastUntil = time.Time{}
+			// the cast is done but the global cooldown (1.5 s from the cast) is not: casting into
+			// it failed ~70 % of a mage's Frostbolts (SMSG_CAST_FAILED 1930 of 2743)
+			s.selfCastUntil = s.lastCastSent.Add(1500 * time.Millisecond)
 		}
 	case opcode.SMSGSpellFailure, opcode.SMSGSpellFailedOther: // packed caster, ...
 		u := r.PackedGUID()
@@ -293,6 +299,7 @@ func (s *service) castAt(ctx context.Context, spell uint32, guid uint64) error {
 	// hold the next cast until the server answers this one (SPELL_START extends it for a cast
 	// bar, GO/FAILURE clears it): a 300 ms tick re-cast Frostbolt 25 times a fight before
 	s.mu.Lock()
+	s.lastCastSent = time.Now()
 	if t := time.Now().Add(400 * time.Millisecond); t.After(s.selfCastUntil) {
 		s.selfCastUntil = t
 	}
@@ -351,12 +358,16 @@ func (s *service) Kill(ctx context.Context, req *combatv1.KillRequest) (*combatv
 	s.mu.Lock()
 	s.target, s.notInRange, s.badFacing, s.deadTarget, s.cantAttack = guid, false, false, false, false
 	swings0, done0, taken0 := s.swings, s.dmgDone, s.dmgTaken
+	s.castFails = map[string]uint32{}
 	s.mu.Unlock()
 	res := &combatv1.KillResult{Guid: guid}
 	finish := func(reason string, killed bool) (*combatv1.KillResult, error) {
 		_ = s.send(context.Background(), opcode.CMSGAttackstop, nil)
 		s.mu.Lock()
 		res.Swings, res.DamageDone, res.DamageTaken = s.swings-swings0, s.dmgDone-done0, s.dmgTaken-taken0
+		for k, n := range s.castFails {
+			res.CastFails = append(res.CastFails, fmt.Sprintf("%sx%d", k, n))
+		}
 		delete(s.attackers, guid)
 		s.target = 0
 		s.mu.Unlock()
