+// -- RPCs: trainers and spells --------------------------------------------------------------------
+
+func (s *service) GetSpells(context.Context, *emptypb.Empty) (*interactv1.KnownSpells, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := &interactv1.KnownSpells{}
+	for sp := range s.known {
+		out.Spells = append(out.Spells, sp)
+	}
+	sort.Slice(out.Spells, func(i, j int) bool { return out.Spells[i] < out.Spells[j] })
+	return out, nil
+}
+
+// GetTrainerList sends CMSG_TRAINER_LIST (guid) and decodes SMSG_TRAINER_LIST
+// (NPCPackets TrainerList::Write: guid, i32 type, i32 count, per spell: i32 id, u8 state,
+// i32 cost, 2 x i32 point cost, u8 req level, i32 skill line, i32 skill rank, 3 x i32 abilities).
+func (s *service) GetTrainerList(ctx context.Context, t *interactv1.Target) (*interactv1.TrainerList, error) {
+	guid, err := s.resolve(ctx, t)
+	if err != nil {
+		return nil, err
+	}
+	ch := s.listen(opcode.SMSGTrainerList)
+	defer s.unlisten(ch)
+	var w wow.Writer
+	w.U64(guid)
+	if err := s.send(ctx, opcode.CMSGTrainerList, &w); err != nil {
+		return nil, err
+	}
+	p, ok := await(ctx, ch, replyTimeout)
+	if !ok {
+		return &interactv1.TrainerList{Guid: guid, Detail: "none"}, nil
+	}
+	r := wow.NewReader(p.payload)
+	out := &interactv1.TrainerList{Guid: r.U64(), Type: r.U32()}
+	n := int(r.U32())
+	for i := 0; i < n && r.Err() == nil; i++ {
+		sp := &interactv1.TrainerSpell{SpellId: r.U32(), State: uint32(r.U8()), Cost: r.U32()}
+		r.Skip(8)
+		sp.ReqLevel = uint32(r.U8())
+		r.Skip(8 + 12)
+		out.Spells = append(out.Spells, sp)
+	}
+	return out, nil
+}
+
+func (s *service) TrainerBuy(ctx context.Context, req *interactv1.TrainerBuyRequest) (*interactv1.TrainerBuyResult, error) {
+	guid, err := s.resolve(ctx, req.GetTarget())
+	if err != nil {
+		return nil, err
+	}
+	return s.buy(ctx, guid, req.GetSpellId())
+}
+
+// buy sends CMSG_TRAINER_BUY_SPELL (guid, spell) and waits for SUCCEEDED / FAILED.
+func (s *service) buy(ctx context.Context, guid uint64, spell uint32) (*interactv1.TrainerBuyResult, error) {
+	ch := s.listen(opcode.SMSGTrainerBuySucceeded, opcode.SMSGTrainerBuyFailed)
+	defer s.unlisten(ch)
+	var w wow.Writer
+	w.U64(guid)
+	w.U32(spell)
+	if err := s.send(ctx, opcode.CMSGTrainerBuySpell, &w); err != nil {
+		return nil, err
+	}
+	p, ok := await(ctx, ch, replyTimeout)
+	if !ok {
+		return &interactv1.TrainerBuyResult{Detail: "timeout"}, nil
+	}
+	r := wow.NewReader(p.payload)
+	r.U64()
+	r.U32()
+	if p.op == opcode.SMSGTrainerBuySucceeded {
+		return &interactv1.TrainerBuyResult{Ok: true, Detail: "learned"}, nil
+	}
+	return &interactv1.TrainerBuyResult{Detail: fmt.Sprintf("failed reason %d", r.U32())}, nil
+}
+
+// TrainerLearnAll buys every spell the trainer lists as learnable now that we can afford,
+// cheapest first, re-listing after each round (a new rank can unlock the next).
+func (s *service) TrainerLearnAll(ctx context.Context, t *interactv1.Target) (*interactv1.LearnAllResult, error) {
+	guid, err := s.resolve(ctx, t)
+	if err != nil {
+		return nil, err
+	}
+	out := &interactv1.LearnAllResult{}
+	tried := map[uint32]bool{}
+	for round := 0; round < 5; round++ {
+		list, err := s.GetTrainerList(ctx, &interactv1.Target{Guid: guid})
+		if err != nil {
+			return nil, err
+		}
+		if list.GetDetail() == "none" {
+			out.Detail = "no trainer window (not a trainer for us, or out of range)"
+			return out, nil
+		}
+		var todo []*interactv1.TrainerSpell
+		for _, sp := range list.GetSpells() {
+			if sp.GetState() == 0 && !tried[sp.GetSpellId()] {
+				todo = append(todo, sp)
+			}
+		}
+		if len(todo) == 0 {
+			break
+		}
+		sort.Slice(todo, func(i, j int) bool { return todo[i].GetCost() < todo[j].GetCost() })
+		for _, sp := range todo {
+			tried[sp.GetSpellId()] = true
+			if sp.GetCost() > s.store.SelfInfo().Money {
+				out.Failed = append(out.Failed, sp.GetSpellId())
+				continue
+			}
+			res, err := s.buy(ctx, guid, sp.GetSpellId())
+			if err != nil {
+				return nil, err
+			}
+			if res.GetOk() {
+				out.Learned = append(out.Learned, sp.GetSpellId())
+				out.Spent += sp.GetCost()
+			} else {
+				out.Failed = append(out.Failed, sp.GetSpellId())
+			}
+		}
+	}
+	out.Detail = fmt.Sprintf("learned %d, failed %d", len(out.Learned), len(out.Failed))
+	return out, nil
+}
