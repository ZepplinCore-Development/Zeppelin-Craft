From 54736ed17c4a1d3a3a816849ae0d46e0583b1525 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Thu, 8 Oct 2026 10:17:47 +0000
Subject: [PATCH] fix: grind the highest-level easy mob for XP (F-219)

Deathknell: a level-4 forsaken ground level-1 zombies and bats (981/2100 XP after 10 kills)
while level 3-4 spiders and Scarlet converts stood nearby. Grind picks prefer the highest
minlevel at or below ours, in sight and when walking to a spawn.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SQmFdwZBdZ1kNkYTTF4JNJ
---
 zeppelin/tests/start_area.py | 16 +++++++++-------
 1 file changed, 9 insertions(+), 7 deletions(-)

diff --git a/zeppelin/tests/start_area.py b/zeppelin/tests/start_area.py
index 8581587..085b98a 100644
--- a/zeppelin/tests/start_area.py
+++ b/zeppelin/tests/start_area.py
@@ -865,15 +865,17 @@ class Runner:
         ents = {o["entry"] for o in mobs} & self.w.objective_creatures  # never a guard or a critter
         if not ents:
             # nothing easy in sight: walk to the nearest spawn of a quest target at or below our level
-            cands = [int(r["entry"]) for r in sql(
-                f"SELECT entry FROM creature_template WHERE entry IN ({inlist(self.w.objective_creatures)}) "
-                f"AND minlevel <= {level}")] if self.w.objective_creatures else []
+            cands = {int(r["entry"]): int(r["minlevel"]) for r in sql(
+                f"SELECT entry,minlevel FROM creature_template WHERE entry IN ({inlist(self.w.objective_creatures)}) "
+                f"AND minlevel <= {level}")} if self.w.objective_creatures else {}
             me = self.me()
-            spots = sorted(((math.dist(p[:2], (me["x"], me["y"])), e, p) for e in cands
-                            for p in self.w.cspawn.get(e, []) if p not in self.w.beyond), key=lambda t: t[0])
+            # the toughest easy mob pays the most XP (Deathknell: level-1 zombies gave a level-4 almost
+            # nothing while level-3/4 spiders and Scarlet converts stood nearby)
+            spots = sorted(((-cands[e], math.dist(p[:2], (me["x"], me["y"])), e, p) for e in cands
+                            for p in self.w.cspawn.get(e, []) if p not in self.w.beyond), key=lambda t: t[:2])
             if not spots:
                 return False
-            _, e, p = spots[0]
+            _, _, e, p = spots[0]
             self.travel(*p, within=15)
             return True
         lv = {int(r["entry"]): int(r["minlevel"]) for r in sql(
@@ -884,7 +886,7 @@ class Runner:
 
         def crowd(t):
             return sum(1 for m in mobs if m is not t and math.dist((m["x"], m.get("y", 0)), (t["x"], t.get("y", 0))) < 10)
-        t = min(easy, key=lambda o: (crowd(o), o.get("distance", 999)))
+        t = min(easy, key=lambda o: (crowd(o), -lv.get(o["entry"], 0), o.get("distance", 999)))
         r = call("combat.kill", guid=int(t["guid"]), abilities=self.abilities, loot=True)
         self.kills += r.get("killed", False)
         print(f"  grind {t['entry']} (level {lv.get(t['entry'])}) while quests wait for level {level + 1}: "
-- 
