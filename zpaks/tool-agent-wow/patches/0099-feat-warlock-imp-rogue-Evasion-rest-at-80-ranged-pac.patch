+        {"spell_id": 5277, "every_ms": 300000, "on_self": True, "min_attackers": 2},          # Evasion (pack)
+        {"spell_id": 5277, "every_ms": 300000, "on_self": True, "below_health_pct": 50},      # Evasion (losing)
         {"spell_id": 1766, "every_ms": 10000, "min_power": 25, "interrupt": True},            # Kick
         # the finisher first, gated on combo points (SMSG_UPDATE_COMBO_POINTS): 3 on the target, or any
