@@ -1293,6 +1298,21 @@ class Runner:
             a["kite_auras"] = KITE_SNARES[self.w.cls]  # step back from a snared mob between shots/casts
         return a
 
+    def ensure_pet(self):
+        """A warlock fights with its imp out (Summon Imp 688, no reagent): the bot never summoned it and
+        tanked every mob in cloth - Durotar was the one area getting worse. Out of combat only, at most
+        every 30 s (a 10 s cast)."""
+        if self.w.cls != 9 or time.time() - getattr(self, "_pet_try", 0) < 30:
+            return
+        st = call("combat.state")
+        if st.get("pet") or st.get("dead") or st.get("attackers"):
+            return
+        if 688 not in set(call("interact.spells").get("spells", [])):
+            return
+        self._pet_try = time.time()
+        r = call("interact.cast", spell_id=688, target_kind="self", timeout_ms=13000)
+        print(f"  pet: Summon Imp - {r.get('detail')}", flush=True)
+
     def fight_range(self):
         """How far a ranged class opens from: its opener's max range (the first known attack spell
         with one - Serpent Sting 35, Frostbolt/Smite/Wrath 30). The module stands 3 yd inside it."""
@@ -1897,7 +1917,9 @@ class Runner:
             if body:
                 ax, ay = body
                 print(f"  body-pulling {out['entry']} out of a group of {len(group)} from ({ax:.0f},{ay:.0f})", flush=True)
-            elif crowd(t) >= 2 and not pull and level < max(lv(m) for m in group) + 3:
+            elif crowd(t) >= (3 if pull else 2) and level < max(lv(m) for m in group) + 3:
+                # ranged too, from 4 a pack: an opener draws one of a pair, but a mage's Frostbolt into
+                # Night Web's Hollow brought six spiders at once (pull x6 deaths)
                 # even the least crowded target stands in a pack and nobody can be body-pulled alone
                 # (Northshire's vineyard: every pull came 2-3 at once): park the quest a level, never
                 # past 3 over the mobs or "later" would loop for ever
@@ -2121,10 +2143,13 @@ class Runner:
             self.kills += r.get("killed", False)
             if r.get("reason") == "we died":
                 return  # the other attackers' kill calls would each log a "fight 0: we died" of their own
+        self.ensure_pet()
         s = call("interact.self")
         low_mana = (self.w.cls in MANA_CLASSES and s.get("powerType", 0) == 0 and s.get("maxPower")
                     and s.get("power", 0) * 100 < s["maxPower"] * 40)  # a dry caster loses its next fight
-        if low_mana or (s.get("maxHealth") and s.get("health", 0) * 100 < s["maxHealth"] * 70):  # never start a pull half dead
+        # 80, not 70: most deaths are the NEXT mob arriving while we are still low (rogue: 23 of 33 defend
+        # deaths came straight after a won fight, at 4-47 % health)
+        if low_mana or (s.get("maxHealth") and s.get("health", 0) * 100 < s["maxHealth"] * 80):  # never start a pull half dead
             self.rest(90)
 
     def _revive_loop(self, corpse):
