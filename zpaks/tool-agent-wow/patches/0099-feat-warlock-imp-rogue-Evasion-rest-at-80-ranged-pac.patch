 	combo                                         uint8                // ...and how many
 }
@@ -207,6 +208,10 @@ func (s *service) OnPacket(ctx context.Context, p *modv1.WorldPacket) (*emptypb.
 		s.deadTarget = true
 	case opcode.SMSGAttackswingCantAttack:
 		s.cantAttack = true
+	case opcode.SMSGPetSpells: // u64 pet guid (0 = the pet is gone), then its action bar
+		if g := r.U64(); r.Err() == nil {
+			s.pet = g
+		}
 	case opcode.SMSGUpdateComboPoints: // packed target guid, u8 points
 		target := r.PackedGUID()
 		n := r.U8()
@@ -385,6 +390,7 @@ func (s *service) Kill(ctx context.Context, req *combatv1.KillRequest) (*combatv
 	s.mu.Lock()
 	s.target, s.notInRange, s.badFacing, s.deadTarget, s.cantAttack = guid, false, false, false, false
 	swings0, done0, taken0 := s.swings, s.dmgDone, s.dmgTaken
+	pet := s.pet
 	s.castFails = map[string]uint32{}
 	for sp, r := range s.castFailed {
 		if r == 47 { // a LINE_OF_SIGHT from an earlier fight says nothing about this one
@@ -392,6 +398,15 @@ func (s *service) Kill(ctx context.Context, req *combatv1.KillRequest) (*combatv
 		}
 	}
 	s.mu.Unlock()
+	if pet != 0 {
+		// send the pet in: a defensive pet only answers what hits us or it, never what WE attack
+		// (CMSG_PET_ACTION: pet guid, ACT_COMMAND 0x07 << 24 | COMMAND_ATTACK 2, target guid)
+		var pw wow.Writer
+		pw.U64(pet)
+		pw.U32(0x07000002)
+		pw.U64(guid)
+		_ = s.send(ctx, opcode.CMSGPetAction, &pw)
+	}
 	res := &combatv1.KillResult{Guid: guid}
 	finish := func(reason string, killed bool) (*combatv1.KillResult, error) {
 		_ = s.send(context.Background(), opcode.CMSGAttackstop, nil)
@@ -1042,8 +1057,11 @@ func (s *service) GetState(ctx context.Context, _ *emptypb.Empty) (*combatv1.Com
 	s.mu.Lock()
 	target := s.target
 	s.mu.Unlock()
+	s.mu.Lock()
+	pet := s.pet
+	s.mu.Unlock()
 	return &combatv1.CombatState{InCombat: len(att) > 0 || target != 0, Attackers: att, Target: target,
-		Dead: st.GetDead(), Ghost: st.GetGhost()}, nil
+		Dead: st.GetDead(), Ghost: st.GetGhost(), Pet: pet}, nil
 }
 
 func (s *service) stand(ctx context.Context, state uint32) error {
