 	firstHit                                      map[uint64]time.Time // target -> when it first lost health (time-to-kill estimate)
 	meleeStopped                                  bool                 // SMSG_ATTACKSTOP for our own swing
+	pet                                           uint64               // SMSG_PET_SPELLS: our pet, 0 = none
