 // SpellClick sends CMSG_SPELLCLICK (guid) - npc_spellclick_spells: quest "click the NPC" credit,
 // boarding vehicles - and reports the first SPELL_GO / CAST_FAILED that follows.
+// SpiritHeal asks a spirit healer (npcflag 0x4000, visible only to ghosts) to resurrect us:
+// CMSG_SPIRIT_HEALER_ACTIVATE (u64 healer guid). The server revives at half health with Resurrection
+// Sickness and leaves bones where the corpse was - the way out when CMSG_RECLAIM_CORPSE is ignored.
+func (s *service) SpiritHeal(ctx context.Context, t *interactv1.Target) (*interactv1.CastResult, error) {
+	guid, err := s.resolve(ctx, t)
+	if err != nil {
+		return nil, err
+	}
+	var w wow.Writer
+	w.U64(guid)
+	if err := s.send(ctx, opcode.CMSGSpiritHealerActivate, &w); err != nil {
+		return nil, err
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		if st := s.store.SelfInfo(); st.Known && !st.Ghost && st.Health > 0 {
+			return &interactv1.CastResult{Ok: true, Detail: "resurrected"}, nil
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(250 * time.Millisecond):
+		}
+	}
+	return &interactv1.CastResult{Detail: "still a ghost (healer out of range, or not a spirit healer)"}, nil
+}
