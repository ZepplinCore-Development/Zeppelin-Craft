+#!/usr/bin/env python3
+"""fleet.py - one agent-wow bot per starting area, run side by side (F-219).
+
+Every code change to the runner or a module should be followed by `fleet.py restart` (optionally
+--build to reinstall the Go modules): each bot gets a FRESH character and replays its starting
+area from level 1, so a fix for one zone cannot silently break another (the Mechashark regression
+came from a Gallywix fix).
+
+    fleet.py setup                 instance dirs, accounts' auth.json, shared module install
+    fleet.py install               rebuild + install the Go modules into the shared module dir
+    fleet.py new [AREA...]         delete the area's character(s), create a fresh one
+    fleet.py start [AREA...]       run each area's legs in the background
+    fleet.py stop [AREA...]        stop driver, supervisor, runner and session
+    fleet.py restart [--build] [AREA...]   stop + (install) + new + start
+    fleet.py status                one line per area
+    fleet.py drive AREA            (internal) run an area's legs in order
+
+AREA defaults to all. Instances live in $AW_FLEET (default Zeppelin-Tools/agent-wow-fleet):
+<area>/config.yaml (own worldrpc port), <area>/config/{auth.json,realm.json,modules->../../modules},
+<area>/data, <area>/fleet.log (the driver's and every leg's output), <area>/state.json (character).
+Accounts ZEPF1..ZEPF9 (auth ids 16-24) are one per area: one account can only be in world once.
+"""
+import json
+import os
+import shutil
+import signal
+import subprocess
+import sys
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.abspath(os.path.join(HERE, "..", ".."))           # agent-wow repo
+FLEET = os.environ.get("AW_FLEET", os.path.abspath(os.path.join(ROOT, "..", "agent-wow-fleet")))
+BIN = os.path.join(ROOT, "bin", "agent-wow")
+TEMPLATE = os.path.abspath(os.path.join(ROOT, "..", "agent-wow-run"))  # config.yaml + realm.json
+PORT0 = 8100
+MODULES = ["move", "interact", "combat", "vehicle"]
+
+
+def box(x, y, half=450):
+    return (x - half, y - half, x + half, y + half)
+
+
+# name, race, class, account index, legs [(map, box, minutes)]. Starts from playercreateinfo; worgen
+# start in Shadowglen here, so the night elf covers it.
+AREAS = [
+    ("northshire", "human", "warrior", 1, [(0, box(-8950, -132), 240)]),
+    ("valley", "orc", "warrior", 2, [(1, (-800, -4500, -30, -4000), 240)]),
+    ("coldridge", "dwarf", "warrior", 3, [(0, box(-6240, 331), 240)]),
+    ("shadowglen", "night-elf", "warrior", 4, [(1, box(10311, 832), 240)]),
+    ("deathknell", "undead", "warrior", 5, [(0, box(1677, 1678), 240)]),
+    ("narache", "tauren", "warrior", 6, [(1, box(-2918, -258), 240)]),
+    ("sunstrider", "blood-elf", "paladin", 7, [(0, box(8216, -4224), 240)]),  # no blood elf warriors
+    ("ammenvale", "draenei", "warrior", 8, [(1, box(5638, 4202), 240)]),
+    ("goblin", "goblin", "warrior", 9, [(1, (-9120, -11680, -8230, -10750), 240),      # Kezan
+                                        (1, (-500, -11720, 2100, -8850), 360)]),       # Lost Isles
+]
+BY_NAME = {a[0]: a for a in AREAS}
+
+
+def area_dir(name):
+    return os.path.join(FLEET, name)
+
+
+def port_of(name):
+    return PORT0 + [a[0] for a in AREAS].index(name)
+
+
+def env_for(name):
+    e = dict(os.environ)
+    e.update(AW_RUN=area_dir(name), AW_BIN=BIN, AW_TESTS=HERE, AGENT_WOW_RPC_PORT=str(port_of(name)))
+    return e
+
+
+def state(name):
+    try:
+        with open(os.path.join(area_dir(name), "state.json")) as f:
+            return json.load(f)
+    except (OSError, ValueError):
+        return {}
+
+
+def save_state(name, st):
+    with open(os.path.join(area_dir(name), "state.json"), "w") as f:
+        json.dump(st, f)
+
+
+def log(name, line):
+    with open(os.path.join(area_dir(name), "fleet.log"), "a") as f:
+        f.write(f"[FLEET {time.strftime('%H:%M:%S')}] {line}\n")
+
+
+def aw(name, *args, timeout=60):
+    """agent-wow in the area's instance dir (its config.yaml, auth and realm)."""
+    return subprocess.run([BIN, *args], cwd=area_dir(name), capture_output=True, text=True, timeout=timeout)
+
+
+# -- commands -------------------------------------------------------------------------------------
+
+def cmd_setup(names):
+    os.makedirs(os.path.join(FLEET, "modules"), exist_ok=True)
+    tpl = open(os.path.join(TEMPLATE, "config.yaml")).read()
+    for name in names:
+        d = area_dir(name)
+        os.makedirs(os.path.join(d, "config"), exist_ok=True)
+        os.makedirs(os.path.join(d, "data"), exist_ok=True)
+        with open(os.path.join(d, "config.yaml"), "w") as f:
+            f.write(tpl.replace("port: 8086", f"port: {port_of(name)}"))
+        shutil.copyfile(os.path.join(TEMPLATE, "config", "realm.json"), os.path.join(d, "config", "realm.json"))
+        auth = os.path.join(FLEET, f"acct{BY_NAME[name][3]}", "auth.json")
+        shutil.copyfile(auth, os.path.join(d, "config", "auth.json"))
+        os.chmod(os.path.join(d, "config", "auth.json"), 0o600)
+        link = os.path.join(d, "config", "modules")
+        if not os.path.islink(link):
+            os.symlink(os.path.join("..", "..", "modules"), link)
+        print(f"{name}: {d} port {port_of(name)} account ZEPF{BY_NAME[name][3]}")
+    if not os.listdir(os.path.join(FLEET, "modules")):
+        cmd_install()
+
+
+def cmd_install():
+    r = subprocess.run([os.path.join(ROOT, "zeppelin", "install.sh"), os.path.join(FLEET, "modules"), *MODULES],
+                       cwd=ROOT, capture_output=True, text=True)
+    print(r.stdout.strip() or r.stderr.strip())
+    if r.returncode:
+        raise SystemExit(f"install failed: {r.stderr[-400:]}")
+
+
+def pids(char):
+    """Driver, supervisor, runner and session processes of one character."""
+    out = []
+    for line in subprocess.run(["ps", "-eo", "pid,args"], capture_output=True, text=True).stdout.splitlines()[1:]:
+        pid, _, args = line.strip().partition(" ")
+        a = args.split()
+        if (len(a) >= 4 and a[1].endswith("supervise.sh") and a[2] == char) or \
+           ("start_area.py" in args and f"--char {char} " in args + " ") or \
+           (len(a) >= 4 and a[0].endswith("agent-wow") and a[1:3] == ["char", "play"] and a[3] == char):
+            out.append(int(pid))
+    return out
+
+
+def driver_pids(name):
+    out = []
+    for line in subprocess.run(["ps", "-eo", "pid,args"], capture_output=True, text=True).stdout.splitlines()[1:]:
+        pid, _, args = line.strip().partition(" ")
+        if "fleet.py drive" in args and args.split()[-1] == name:
+            out.append(int(pid))
+    return out
+
+
+def cmd_stop(names):
+    for name in names:
+        char = state(name).get("char")
+        targets = driver_pids(name) + (pids(char) if char else [])
+        for p in targets:
+            try:
+                os.kill(p, signal.SIGTERM)
+            except ProcessLookupError:
+                pass
+        if targets:
+            log(name, f"stopped ({len(targets)} processes)")
+        print(f"{name}: stopped {len(targets)} processes")
+
+
+def cmd_new(names):
+    for name in names:
+        _, race, cls, _, _ = BY_NAME[name]
+        r = aw(name, "auth", "login")  # session saved in the instance's data dir; play reuses it
+        if r.returncode:
+            raise SystemExit(f"{name}: auth login failed: {(r.stderr or r.stdout).strip()[:300]}")
+        listing = aw(name, "char", "list")
+        for line in listing.stdout.splitlines()[2:]:
+            f = line.split()
+            if f and f[0].isdigit():
+                r = aw(name, "char", "delete", f[1], "--yes")
+                print(f"{name}: deleted {f[1]} ({(r.stdout or r.stderr).strip()[:60]})")
+        r = aw(name, "char", "create", "--race", race, "--class", cls)
+        if r.returncode:
+            raise SystemExit(f"{name}: create failed: {(r.stderr or r.stdout).strip()[:300]}")
+        listing = aw(name, "char", "list")
+        chars = [l.split()[1] for l in listing.stdout.splitlines()[2:] if l.split() and l.split()[0].isdigit()]
+        if len(chars) != 1:
+            raise SystemExit(f"{name}: expected one character after create, got {chars}")
+        save_state(name, {"char": chars[0], "race": race, "class": cls, "created": time.strftime("%F %T")})
+        log(name, f"new character {chars[0]} ({race} {cls})")
+        print(f"{name}: {chars[0]} ({race} {cls})")
+
+
+def cmd_start(names):
+    for name in names:
+        if driver_pids(name):
+            print(f"{name}: already running")
+            continue
+        if not state(name).get("char"):
+            raise SystemExit(f"{name}: no character - run `fleet.py new {name}` first")
+        subprocess.Popen([sys.executable, os.path.abspath(__file__), "drive", name], cwd=HERE, env=env_for(name),
+                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                         start_new_session=True)
+        print(f"{name}: started ({state(name)['char']}, port {port_of(name)})")
+
+
+def cmd_drive(name):
+    """Run the area's legs in order; a leg must PASS before the next one starts."""
+    char, legs = state(name)["char"], BY_NAME[name][4]
+    flog = os.path.join(area_dir(name), "fleet.log")
+    for i, (mapid, bx, minutes) in enumerate(legs, 1):
+        log(name, f"leg {i}/{len(legs)} map {mapid} box {bx} ({minutes} min)")
+        start = os.path.getsize(flog)
+        subprocess.run([os.path.join(HERE, "supervise.sh"), char, str(mapid), *map(str, bx), str(minutes), flog],
+                       env=env_for(name), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        with open(flog) as f:
+            f.seek(start)
+            verdicts = [l.strip() for l in f if l.startswith("RESULT:")]
+        verdict = verdicts[-1] if verdicts else "RESULT: none"
+        log(name, f"leg {i} {verdict}")
+        if not verdict.startswith("RESULT: PASS"):
+            log(name, "FLEET RESULT: STOPPED")
+            return
+    log(name, "FLEET RESULT: PASS (all legs)")
+
+
+def db(sql, database):
+    r = subprocess.run([sys.executable, "-m", "cli.zep", "world", "sql", "query", sql, "-d", database],
+                       cwd=os.path.abspath(os.path.join(ROOT, "..", "..", "Zeppelin-Craft")),
+                       capture_output=True, text=True)
+    rows = [l.split("\t") for l in r.stdout.splitlines() if l and l[0].isdigit()]
+    return rows
+
+
+def cmd_status(names):
+    for name in names:
+        st = state(name)
+        char = st.get("char", "-")
+        lvl, rewarded = "-", "-"
+        if char != "-":
+            rows = db(f"SELECT c.level,(SELECT COUNT(*) FROM character_queststatus_rewarded r WHERE r.guid=c.guid) "
+                      f"FROM characters c WHERE c.name='{char}'", "characters")
+            if rows:
+                lvl, rewarded = rows[0][0], rows[0][1]
+        last, verdict = "", ""
+        try:
+            with open(os.path.join(area_dir(name), "fleet.log")) as f:
+                lines = [l.rstrip() for l in f if l.strip()]
+            last = lines[-1][:70] if lines else ""
+            verdict = next((l for l in reversed(lines) if "FLEET RESULT" in l or l.startswith("RESULT:")), "")
+        except OSError:
+            pass
+        run = "running" if driver_pids(name) else "idle"
+        print(f"{name:11} {char:13} L{lvl:>2} q{rewarded:>3} {run:7} | {verdict[-40:]:40} | {last}")
+
+
+def main():
+    args = sys.argv[1:]
+    if not args:
+        print(__doc__)
+        return
+    cmd, rest = args[0], args[1:]
+    build = "--build" in rest
+    rest = [a for a in rest if a != "--build"]
+    names = rest or [a[0] for a in AREAS]
+    for n in names:
+        if n not in BY_NAME:
+            raise SystemExit(f"unknown area {n}; areas: {', '.join(BY_NAME)}")
+    if cmd == "setup":
+        cmd_setup(names)
+    elif cmd == "install":
+        cmd_install()
+    elif cmd == "new":
+        cmd_new(names)
+    elif cmd == "start":
+        cmd_start(names)
+    elif cmd == "stop":
+        cmd_stop(names)
+    elif cmd == "restart":
+        cmd_stop(names)
+        time.sleep(5)
+        if build:
+            cmd_install()
+        cmd_new(names)
+        cmd_start(names)
+    elif cmd == "status":
+        cmd_status(names)
+    elif cmd == "drive":
+        cmd_drive(names[0])
+    else:
+        raise SystemExit(__doc__)
+
+
+if __name__ == "__main__":
+    main()
