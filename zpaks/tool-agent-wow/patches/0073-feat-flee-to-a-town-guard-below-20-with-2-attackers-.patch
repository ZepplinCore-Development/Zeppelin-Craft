+    def flee_to_guard(self):
+        """Run - without stopping to fight - to the nearest guard and let him take the pack."""
+        me = self.me()
+        g = min(self.w.guards, key=lambda p: math.dist(p[:2], (me["x"], me["y"])), default=None)
+        if not g:
+            return
+        print(f"  ! fleeing to the guard at ({g[0]:.0f},{g[1]:.0f}) {math.dist(g[:2], (me['x'], me['y'])):.0f} yd", flush=True)
+        was, self.reviving = self.reviving, True  # no detours, no stop-on-attack: just run
+        try:
+            self.travel(g[0], g[1], g[2], within=4)
+        except StepFailed:
+            pass
+        finally:
+            self.reviving = was
