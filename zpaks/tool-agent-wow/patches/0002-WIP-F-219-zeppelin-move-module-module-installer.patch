diff --git a/zeppelin/modules/move/move.proto b/zeppelin/modules/move/move.proto
new file mode 100644
index 0000000..925dacb
--- /dev/null
+++ b/zeppelin/modules/move/move.proto
@@ -0,0 +1,40 @@
+syntax = "proto3";
+package zeppelin.move.v1;
+option go_package = "github.com/agent-wow/agent-wow/zeppelin/modules/move/api;movev1";
+
+import "api/module/v1/session.proto";
+import "google/protobuf/empty.proto";
+
+// Position of the played character as the module last knew it.
+message Position {
+  uint32 map = 1;
+  float x = 2;
+  float y = 3;
+  float z = 4;
+  float o = 5;
+  float run_speed = 6;   // yards per second
+  bool known = 7;        // false until SMSG_LOGIN_VERIFY_WORLD arrives
+}
+
+message MoveToRequest {
+  float x = 1;
+  float y = 2;
+  float z = 3;
+  float speed = 4;       // 0 = current run speed
+  uint32 timeout_ms = 5; // 0 = distance / speed + 5 s
+}
+
+message MoveToResult {
+  Position position = 1;
+  bool arrived = 2;      // false when stopped, teleported or timed out on the way
+  string reason = 3;
+  float distance = 4;    // yards walked
+}
+
+service Move {
+  rpc GetPosition(google.protobuf.Empty) returns (Position);
+  rpc MoveTo(MoveToRequest) returns (MoveToResult);
+  rpc Stop(google.protobuf.Empty) returns (Position);
+  rpc OnPacket(agentwow.module.v1.WorldPacket) returns (google.protobuf.Empty);
+  rpc BeforeLogout(google.protobuf.Empty) returns (google.protobuf.Empty);
+}
