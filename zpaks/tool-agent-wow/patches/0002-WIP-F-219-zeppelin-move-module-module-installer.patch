+// Command move is a Zeppelin agent-wow gameplay module (F-219 Track A): it tracks the played
+// character's position and walks it in straight lines with client movement packets.
+//
+// The server trusts client positions (no anticheat module), so a move is START_FORWARD, a
+// HEARTBEAT every 500 ms along the line at the current run speed, then STOP at the target.
+// Z is interpolated linearly between start and target: callers supply ground Z for both ends,
+// and long moves over uneven ground should be broken into waypoints (Detour pathing is a later
+// step). The module also answers what agent-wow's core does not: same-map teleports
+// (MSG_MOVE_TELEPORT_ACK), map transfers (SMSG_NEW_WORLD -> MSG_MOVE_WORLDPORT_ACK) and every
+// forced speed change, so the server keeps accepting movement after a teleport or a mount.
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"math"
+	"net"
+	"os"
+	"os/signal"
+	"strconv"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/agent-wow/agent-wow/pkg/modules/v1"
+	"github.com/agent-wow/agent-wow/pkg/opcode"
+	movev1 "github.com/agent-wow/agent-wow/zeppelin/modules/move/api"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/health"
+	"google.golang.org/grpc/health/grpc_health_v1"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/types/known/emptypb"
+)
+
+const (
+	moveFlagForward  = 0x00000001
+	defaultRunSpeed  = 7.0
+	heartbeatEvery   = 500 * time.Millisecond
+	maxMoveDistance  = 2000.0 // yards; anything longer is a caller bug, not a walk
+	moveFlagsUnknown = 0
+)
+
+// forcedSpeed maps each SMSG_FORCE_*_CHANGE to its CMSG ack (always opcode+1) and whether the
+// packet carries the extra uint8 the server writes only for run speed.
+var forcedSpeed = map[uint32]bool{
+	opcode.SMSGForceRunSpeedChange:        true,
+	opcode.SMSGForceRunBackSpeedChange:    false,
+	opcode.SMSGForceSwimSpeedChange:       false,
+	opcode.SMSGForceWalkSpeedChange:       false,
+	opcode.SMSGForceSwimBackSpeedChange:   false,
+	opcode.SMSGForceTurnRateChange:        false,
+	opcode.SMSGForceFlightSpeedChange:     false,
+	opcode.SMSGForceFlightBackSpeedChange: false,
+	opcode.SMSGForcePitchRateChange:       false,
+}
+
+type service struct {
+	movev1.UnimplementedMoveServer
+	session modv1.SessionClient
+	guid    uint64
+
+	mu       sync.Mutex
+	pos      movev1.Position
+	moving   bool
+	cancel   context.CancelFunc // cancels the running MoveTo
+	teleport chan struct{}      // closed and replaced on every teleport
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run() error {
+	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer cancel()
+	guid, err := strconv.ParseUint(os.Getenv("AGENT_WOW_CHARACTER_GUID"), 10, 64)
+	if err != nil {
+		return fmt.Errorf("AGENT_WOW_CHARACTER_GUID: %w", err)
+	}
+	path := os.Getenv("AGENT_WOW_MODULE_SOCKET")
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		return err
+	}
+	defer listener.Close()
+	if err := os.Chmod(path, 0666); err != nil {
+		return err
+	}
+	conn, err := grpc.NewClient("unix://"+os.Getenv("AGENT_WOW_SESSION_SOCKET"),
+		grpc.WithTransportCredentials(insecure.NewCredentials()), grpc.WithDisableRetry())
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	s := &service{session: modv1.NewSessionClient(conn), guid: guid, teleport: make(chan struct{})}
+	s.pos.RunSpeed = defaultRunSpeed
+	server := grpc.NewServer()
+	movev1.RegisterMoveServer(server, s)
+	healthy := health.NewServer()
+	grpc_health_v1.RegisterHealthServer(server, healthy)
+	healthy.SetServingStatus("", grpc_health_v1.HealthCheckResponse_SERVING)
+	go func() { <-ctx.Done(); server.Stop() }()
+	return server.Serve(listener)
+}
+
+// -- wire helpers ---------------------------------------------------------------------------------
+
+func packGUID(guid uint64) []byte {
+	out := []byte{0}
+	for i := 0; i < 8; i++ {
+		if b := byte(guid >> (8 * i)); b != 0 {
+			out[0] |= 1 << i
+			out = append(out, b)
+		}
+	}
+	return out
+}
+
+func readPackedGUID(r *bytes.Reader) (uint64, error) {
+	mask, err := r.ReadByte()
+	if err != nil {
+		return 0, err
+	}
+	var guid uint64
+	for i := 0; i < 8; i++ {
+		if mask&(1<<i) != 0 {
+			b, err := r.ReadByte()
+			if err != nil {
+				return 0, err
+			}
+			guid |= uint64(b) << (8 * i)
+		}
+	}
+	return guid, nil
+}
+
+// movementInfo writes the 3.3.5 MovementInfo the server reads in WorldSession::ReadMovementInfo:
+// flags u32, flags2 u16, time u32, x y z o, fallTime u32 (no transport/pitch/jump fields).
+func movementInfo(buf *bytes.Buffer, flags uint32, clientTime uint32, x, y, z, o float32) {
+	le := binary.LittleEndian
+	_ = binary.Write(buf, le, flags)
+	_ = binary.Write(buf, le, uint16(0))
+	_ = binary.Write(buf, le, clientTime)
+	for _, f := range []float32{x, y, z, o} {
+		_ = binary.Write(buf, le, f)
+	}
+	_ = binary.Write(buf, le, uint32(0))
+}
+
+func (s *service) clock(ctx context.Context) (uint32, error) {
+	c, err := s.session.GetClock(ctx, &emptypb.Empty{})
+	if err != nil {
+		return 0, err
+	}
+	return c.GetClientTimeMs(), nil
+}
+
+func (s *service) send(ctx context.Context, op uint32, payload []byte) error {
+	_, err := s.session.SendPacket(ctx, &modv1.SendPacketRequest{Opcode: op, Payload: payload})
+	return err
+}
+
+// sendMove sends a movement opcode for the player at (x,y,z,o).
+func (s *service) sendMove(ctx context.Context, op uint32, flags uint32, x, y, z, o float32) error {
+	t, err := s.clock(ctx)
+	if err != nil {
+		return err
+	}
+	var buf bytes.Buffer
+	buf.Write(packGUID(s.guid))
+	movementInfo(&buf, flags, t, x, y, z, o)
+	return s.send(ctx, op, buf.Bytes())
+}
+
+// -- packets from the server ----------------------------------------------------------------------
+
+func (s *service) OnPacket(ctx context.Context, p *modv1.WorldPacket) (*emptypb.Empty, error) {
+	r := bytes.NewReader(p.GetPayload())
+	le := binary.LittleEndian
+	switch op := p.GetOpcode(); {
+	case op == opcode.SMSGLoginVerifyWorld || op == opcode.SMSGNewWorld:
+		// u32 map, x y z o - same layout for both
+		var m uint32
+		var v [4]float32
+		if binary.Read(r, le, &m) != nil || binary.Read(r, le, &v) != nil {
+			return &emptypb.Empty{}, nil
+		}
+		s.setPosition(m, v, true)
+		if op == opcode.SMSGNewWorld {
+			// the server holds the player "being teleported" until this ack arrives
+			_ = s.send(ctx, opcode.MSGMoveWorldportAck, nil)
+		}
+	case op == opcode.MSGMoveTeleportAck:
+		// packed guid, u32 counter, MovementInfo
+		guid, err := readPackedGUID(r)
+		if err != nil || guid != s.guid {
+			return &emptypb.Empty{}, nil
+		}
+		var counter, flags, t uint32
+		var flags2 uint16
+		var v [4]float32
+		if binary.Read(r, le, &counter) != nil || binary.Read(r, le, &flags) != nil ||
+			binary.Read(r, le, &flags2) != nil || binary.Read(r, le, &t) != nil || binary.Read(r, le, &v) != nil {
+			return &emptypb.Empty{}, nil
+		}
+		s.mu.Lock()
+		m := s.pos.Map
+		s.mu.Unlock()
+		s.setPosition(m, v, true)
+		now, err := s.clock(ctx)
+		if err == nil {
+			var buf bytes.Buffer
+			buf.Write(packGUID(s.guid))
+			_ = binary.Write(&buf, le, counter)
+			_ = binary.Write(&buf, le, now)
+			_ = s.send(ctx, opcode.MSGMoveTeleportAck, buf.Bytes())
+		}
+	default:
+		run, ok := forcedSpeed[op]
+		if !ok {
+			break
+		}
+		// packed guid, u32 counter, [u8 for run], f32 speed -> ack: guid, counter, MovementInfo, speed
+		guid, err := readPackedGUID(r)
+		if err != nil || guid != s.guid {
+			break
+		}
+		var counter uint32
+		var speed float32
+		if binary.Read(r, le, &counter) != nil {
+			break
+		}
+		if run {
+			_, _ = r.ReadByte()
+		}
+		if binary.Read(r, le, &speed) != nil {
+			break
+		}
+		s.mu.Lock()
+		if op == opcode.SMSGForceRunSpeedChange {
+			s.pos.RunSpeed = speed
+		}
+		x, y, z, o := s.pos.X, s.pos.Y, s.pos.Z, s.pos.O
+		flags := uint32(moveFlagsUnknown)
+		if s.moving {
+			flags = moveFlagForward
+		}
+		s.mu.Unlock()
+		now, err := s.clock(ctx)
+		if err != nil {
+			break
+		}
+		var buf bytes.Buffer
+		buf.Write(packGUID(s.guid))
+		_ = binary.Write(&buf, le, counter)
+		movementInfo(&buf, flags, now, x, y, z, o)
+		_ = binary.Write(&buf, le, speed)
+		_ = s.send(ctx, op+1, buf.Bytes())
+	}
+	return &emptypb.Empty{}, nil
+}
+
+// setPosition records a server-dictated position; teleport=true interrupts a running MoveTo.
+func (s *service) setPosition(m uint32, v [4]float32, teleport bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.pos.Map, s.pos.X, s.pos.Y, s.pos.Z, s.pos.O, s.pos.Known = m, v[0], v[1], v[2], v[3], true
+	if teleport {
+		close(s.teleport)
+		s.teleport = make(chan struct{})
+	}
+}
+
+func (s *service) snapshot() *movev1.Position {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	p := movev1.Position{Map: s.pos.Map, X: s.pos.X, Y: s.pos.Y, Z: s.pos.Z, O: s.pos.O,
+		RunSpeed: s.pos.RunSpeed, Known: s.pos.Known}
+	return &p
+}
+
+// -- RPCs -----------------------------------------------------------------------------------------
+
+func (s *service) GetPosition(context.Context, *emptypb.Empty) (*movev1.Position, error) {
+	return s.snapshot(), nil
+}
+
+func (s *service) Stop(ctx context.Context, _ *emptypb.Empty) (*movev1.Position, error) {
+	s.mu.Lock()
+	if s.cancel != nil {
+		s.cancel()
+	}
+	s.mu.Unlock()
+	return s.snapshot(), nil
+}
+
+func (s *service) MoveTo(ctx context.Context, req *movev1.MoveToRequest) (*movev1.MoveToResult, error) {
+	s.mu.Lock()
+	if !s.pos.Known {
+		s.mu.Unlock()
+		return nil, status.Error(codes.FailedPrecondition, "position unknown (not in world yet)")
+	}
+	if s.moving {
+		s.mu.Unlock()
+		return nil, status.Error(codes.FailedPrecondition, "already moving; call move.stop first")
+	}
+	x0, y0, z0 := float64(s.pos.X), float64(s.pos.Y), float64(s.pos.Z)
+	speed := float64(req.GetSpeed())
+	if speed <= 0 {
+		speed = float64(s.pos.RunSpeed)
+	}
+	moveCtx, cancel := context.WithCancel(ctx)
+	s.moving, s.cancel = true, cancel
+	teleported := s.teleport
+	s.mu.Unlock()
+	defer func() {
+		cancel()
+		s.mu.Lock()
+		s.moving, s.cancel = false, nil
+		s.mu.Unlock()
+	}()
+
+	x1, y1, z1 := float64(req.GetX()), float64(req.GetY()), float64(req.GetZ())
+	dist := math.Sqrt((x1-x0)*(x1-x0) + (y1-y0)*(y1-y0) + (z1-z0)*(z1-z0))
+	if dist > maxMoveDistance {
+		return nil, status.Errorf(codes.InvalidArgument, "move of %.0f yd exceeds %.0f yd; use waypoints", dist, maxMoveDistance)
+	}
+	o := float32(math.Mod(math.Atan2(y1-y0, x1-x0)+2*math.Pi, 2*math.Pi))
+	total := time.Duration(dist / speed * float64(time.Second))
+	timeout := total + 5*time.Second
+	if req.GetTimeoutMs() > 0 {
+		timeout = time.Duration(req.GetTimeoutMs()) * time.Millisecond
+	}
+	deadline := time.Now().Add(timeout)
+
+	at := func(frac float64) (float32, float32, float32) {
+		return float32(x0 + (x1-x0)*frac), float32(y0 + (y1-y0)*frac), float32(z0 + (z1-z0)*frac)
+	}
+	result := func(arrived bool, reason string, frac float64) *movev1.MoveToResult {
+		return &movev1.MoveToResult{Position: s.snapshot(), Arrived: arrived, Reason: reason, Distance: float32(dist * frac)}
+	}
+	if dist < 0.05 {
+		return result(true, "already there", 1), nil
+	}
+
+	if err := s.sendMove(moveCtx, opcode.MSGMoveSetFacing, 0, float32(x0), float32(y0), float32(z0), o); err != nil {
+		return nil, err
+	}
+	if err := s.sendMove(moveCtx, opcode.MSGMoveStartForward, moveFlagForward, float32(x0), float32(y0), float32(z0), o); err != nil {
+		return nil, err
+	}
+	start := time.Now()
+	ticker := time.NewTicker(heartbeatEvery)
+	defer ticker.Stop()
+	frac := 0.0
+	stopAt := func(reason string, arrived bool) (*movev1.MoveToResult, error) {
+		x, y, z := at(frac)
+		s.setPosition(s.snapshot().Map, [4]float32{x, y, z, o}, false)
+		// a fresh context: the move's own may already be cancelled
+		stopCtx, done := context.WithTimeout(context.Background(), 3*time.Second)
+		defer done()
+		if err := s.sendMove(stopCtx, opcode.MSGMoveStop, 0, x, y, z, o); err != nil {
+			return nil, err
+		}
+		return result(arrived, reason, frac), nil
+	}
+	for {
+		select {
+		case <-moveCtx.Done():
+			return stopAt("stopped", false)
+		case <-teleported:
+			// the server moved us; its position stands, no STOP from the old line
+			return result(false, "teleported", frac), nil
+		case now := <-ticker.C:
+			frac = math.Min(1, float64(now.Sub(start))/float64(total))
+			if frac >= 1 {
+				return stopAt("arrived", true)
+			}
+			if now.After(deadline) {
+				return stopAt("timeout", false)
+			}
+			x, y, z := at(frac)
+			s.setPosition(s.snapshot().Map, [4]float32{x, y, z, o}, false)
+			if err := s.sendMove(moveCtx, opcode.MSGMoveHeartbeat, moveFlagForward, x, y, z, o); err != nil {
+				if errors.Is(moveCtx.Err(), context.Canceled) {
+					return stopAt("stopped", false)
+				}
+				return nil, err
+			}
+		}
+	}
+}
+
+func (s *service) BeforeLogout(ctx context.Context, _ *emptypb.Empty) (*emptypb.Empty, error) {
+	_, _ = s.Stop(ctx, &emptypb.Empty{})
+	return &emptypb.Empty{}, nil
+}
