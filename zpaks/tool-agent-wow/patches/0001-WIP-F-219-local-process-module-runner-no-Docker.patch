+// validateProcess checks a process launch: Command[0] must be a file inside the module directory
+// or a bare program name resolvable on PATH (an absolute or escaping path is rejected).
+func validateProcess(m Manifest) error {
+	if m.Compose.File != "" || m.Compose.Service != "" {
+		return errors.New("set either compose or process, not both")
+	}
+	bin := m.Process.Command[0]
+	if strings.TrimSpace(bin) == "" {
+		return errors.New("process command is empty")
+	}
+	if !strings.ContainsRune(bin, filepath.Separator) {
+		if _, err := os.Stat(filepath.Join(m.Directory, bin)); err == nil {
+			_, err = asset(m, bin)
+			return err
+		}
+		if _, err := exec.LookPath(bin); err != nil {
+			return fmt.Errorf("process command %q: %w", bin, err)
+		}
+		return nil
+	}
+	if _, err := asset(m, bin); err != nil {
+		return fmt.Errorf("process command: %w", err)
+	}
+	return nil
+}
