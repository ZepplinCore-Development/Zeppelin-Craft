+"""deaths.py AREA [AREA...] - cause-of-death breakdown for each bot's latest run (F-219).
+Per death: the killing fight (pull / defend / engage, attackers), health going in (= damage taken in
+the fatal fight, as it ends at 0), the killer's level against ours, and what the bot was doing."""
+import collections, re, subprocess, sys
+sys.path.insert(0, __file__.rsplit("/", 1)[0])
+from fleet import area_dir
+
+FIGHT = re.compile(r"fight (\d+): we died \[(\w+) x(\d+)[^\]]*\].*?taken (\d+) hp 0/(\d+)")
+
+def levels(entries):
+    if not entries:
+        return {}
+    q = f"SELECT entry,minlevel,maxlevel,name FROM creature_template WHERE entry IN ({','.join(map(str, entries))})"
+    out = subprocess.run([sys.executable, "-m", "cli.zep", "world", "sql", "query", q], capture_output=True, text=True,
+                         cwd="/workspace/project/Zeppelin-Craft").stdout.splitlines()[1:]
+    return {int(r.split("\t")[0]): (int(r.split("\t")[1]), int(r.split("\t")[2]), r.split("\t")[3]) for r in out if r.strip()}
+
+def context(L, i):
+    for j in range(i - 1, max(0, i - 15), -1):
+        t = L[j].strip()
+        if not t or t.startswith(("fight", "!")) or "died" in t:
+            continue
+        for key, label in (("revive:", "just revived"), ("spirit rez", "just revived"), ("engage on our terms", "road engage"),
+                           ("let ", "letting a mob pass"), ("grind", "grinding"), ("clear camp", "clearing a camp"),
+                           ("rest: stepping", "resting"), ("detour around", "travelling (detour)"), ("travel ", "travelling"),
+                           ("repair", "repair trip"), ("body-pulling", "body pull"), ("[PASS]", "questing"), ("hit ", "questing"),
+                           ("open GO", "questing"), ("use ", "questing")):
+            if key in t:
+                return label
+        return "other: " + t[:50]
+    return "?"
+
+for area in sys.argv[1:]:
+    log = open(f"{area_dir(area)}/fleet.log", errors="replace").read().splitlines()
+    start = max(i for i, l in enumerate(log) if "] new character" in l)
+    L = log[start:]
+    level = 1
+    rows = []
+    for i, l in enumerate(L):
+        m = re.search(r"\[TRAIN\] level (\d+)", l)
+        if m:
+            level = int(m[1])
+        d = FIGHT.search(l)
+        if d and " swings 0 dealt 0 taken 0" not in l:
+            rows.append(dict(entry=int(d[1]), kind=d[2], n=int(d[3]), start=int(d[4]) * 100 // int(d[5]), lvl=level,
+                             ctx=context(L, i)))
+    info = levels({r["entry"] for r in rows})
+    print(f"=== {area}: {len(rows)} deaths")
+    c = collections.Counter
+    print("  fight:", dict(c(f"{r['kind']} x{min(r['n'], 3)}{'+' if r['n'] > 3 else ''}" for r in rows).most_common()))
+    print("  health going in:", dict(c(("<50%" if r["start"] < 50 else "50-89%" if r["start"] < 90 else "90%+") for r in rows).most_common()))
+    print("  killer vs us:", dict(c(("+%d" % (info.get(r["entry"], (0, 0))[1] - r["lvl"])) for r in rows).most_common()))
+    print("  doing:", dict(c(r["ctx"] for r in rows).most_common(8)))
+    print("  killers:", ", ".join(f"{info.get(e, (0, 0, '?'))[2]} {info.get(e, (0, 0))[0]}-{info.get(e, (0, 0))[1]} x{k}"
+                                for e, k in c(r["entry"] for r in rows).most_common(5)))
