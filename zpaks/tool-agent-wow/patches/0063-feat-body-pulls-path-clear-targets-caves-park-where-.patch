+    def aggro_r(self, mob_level, level):
+        """Roughly how close a hostile mob notices us: 20 yd at our level, a yard less per level we
+        are above it, a yard more per level below (AzerothCore clamps to 5..45)."""
+        return max(5.0, min(45.0, 20.0 + mob_level - level))
