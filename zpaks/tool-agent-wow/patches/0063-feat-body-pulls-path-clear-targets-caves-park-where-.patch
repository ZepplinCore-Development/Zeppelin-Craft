+        return (t["x"] + ux * (r + 6), t.get("y", 0) + uy * (r + 6))
+
+    def path_passes(self, t, mobs, level, lvl_of):
+        """How many OTHER hostiles the walk to t passes within their aggro reach (3D: a cave's
+        tunnels stack - Deathknell's Night Web Hollow pulled 5-6 spiders walking to one)."""
