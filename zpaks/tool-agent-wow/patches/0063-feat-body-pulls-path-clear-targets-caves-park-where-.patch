+    def body_pull_spot(self, t, others, cx, cy, level, lvl_of):
+        """Where to stand to body-pull t out of its camp: on its outer side (away from the camp
+        centre cx,cy), just past its aggro reach. None when the spot where it would notice us is
+        inside another camp mob's reach too - then the whole camp comes and a body pull is no help."""
