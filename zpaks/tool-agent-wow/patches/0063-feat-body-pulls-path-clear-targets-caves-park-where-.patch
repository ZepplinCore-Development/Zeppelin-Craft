+        except StepFailed:
+            return 0
+        near = set()
+        for a, b in zip(pts, pts[1:]):
+            A = (a.get("x", 0), a.get("y", 0), a.get("z", 0))
+            B = (b.get("x", 0), b.get("y", 0), b.get("z", 0))
+            k = max(1, int(math.dist(A, B) / 3))
+            for i in range(k + 1):
+                P = tuple(A[j] + (B[j] - A[j]) * i / k for j in range(3))
+                if math.dist(P[:2], (t["x"], t.get("y", 0))) < 8:
