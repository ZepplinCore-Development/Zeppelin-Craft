+        if n < 0.5:  # the target IS the centre: approach from our side
+            me = self.me()
+            ux, uy, n = me["x"] - t["x"], me["y"] - t.get("y", 0), max(math.hypot(me["x"] - t["x"], me["y"] - t.get("y", 0)), 0.01)
+        ux, uy = ux / n, uy / n
+        r = self.aggro_r(lvl_of(t), level)
+        notice = (t["x"] + ux * r, t.get("y", 0) + uy * r)
+        if any(math.dist((o["x"], o.get("y", 0)), notice) < self.aggro_r(lvl_of(o), level) + 2 for o in others):
