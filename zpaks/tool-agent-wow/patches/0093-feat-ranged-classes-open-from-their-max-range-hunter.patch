+    def fight_range(self):
+        """How far a ranged class opens from: its opener's max range (the first known attack spell
+        with one - Serpent Sting 35, Frostbolt/Smite/Wrath 30). The module stands 3 yd inside it."""
+        if not CLASS_RANGE.get(self.w.cls):
+            return 0
+        for a in getattr(self, "abilities", []):
+            if not a.get("on_self") and not a.get("interrupt") and a.get("max_range", 0) > 8:
+                return a["max_range"]
+        return CLASS_RANGE[self.w.cls]
