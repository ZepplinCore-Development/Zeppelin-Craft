+        # ...but only when the periodic part is the point: Fireball's 4 s burn is a sliver of its impact
+        # and must never make it "not worth casting" (Immolate's DoT outweighs its hit - that one counts)
+        dur = {}
+        for r in (dbc("SELECT s.*,d.base_duration dur FROM spell s JOIN spellduration d ON d.id=s.duration_index "
+                      f"WHERE s.id IN ({inlist(ids)})") if ids else []):
+            direct = periodic = 0.0
+            for i in (1, 2, 3):
+                bp = int(r[f"effect_base_points_{i}"]) + 1 + max(int(r[f"effect_die_sides_{i}"]), 0) / 2
+                if int(r[f"effect_{i}"]) == 2:  # SCHOOL_DAMAGE
+                    direct += bp
+                elif int(r[f"effect_apply_aura_name_{i}"]) == 3 and int(r[f"effect_amplitude_{i}"]) > 0:
+                    periodic += bp * int(r["dur"]) / int(r[f"effect_amplitude_{i}"])
+            if periodic > 0 and periodic >= direct:
+                dur[int(r["id"])] = int(r["dur"])
