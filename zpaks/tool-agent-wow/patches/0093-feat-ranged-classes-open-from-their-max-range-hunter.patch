From 0724cc1dc49790a39978a930cadf33ade28ced98 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Mon, 12 Oct 2026 04:38:56 +0000
Subject: [PATCH] feat: ranged classes open from their max range; hunter shots;
 cast lock per cast (F-219)

- range = the opener's max range (Serpent Sting 35, Frostbolt/Smite/Wrath 30);
  planned pulls stand 2 yd inside it (was 20 yd) and grinding stops at range
  (it walked to 4 yd)
- hunter: Serpent Sting, Arcane Shot, Concussive Shot, Auto Shot from range;
  Raptor Strike on cooldown in melee; Hunter's Mark only with spare mana
- mage: Frostbolt opener (the slow buys a second cast), Fire Blast as it closes
- cast lock ends only on SPELL_GO/FAILURE carrying OUR cast count: triggered
  spells (Frost Armor's Chill on every hit) released it mid-cast
- NOT_READY retries in 0.4 s (Raptor Strike's cooldown runs from the swing)
- dot_ms only where the periodic part outweighs the direct hit (Fireball's
  burn no longer makes it a DoT)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019SSuH6gpqY4Kn5Rk9sd149
---
 zeppelin/modules/combat/main.go | 18 +++++++++--
 zeppelin/tests/start_area.py    | 56 +++++++++++++++++++++++++--------
 2 files changed, 59 insertions(+), 15 deletions(-)

diff --git a/zeppelin/modules/combat/main.go b/zeppelin/modules/combat/main.go
index 8978d81..a1e936e 100644
--- a/zeppelin/modules/combat/main.go
+++ b/zeppelin/modules/combat/main.go
@@ -257,16 +257,20 @@ func (s *service) OnPacket(ctx context.Context, p *modv1.WorldPacket) (*emptypb.
 	case opcode.SMSGSpellGo: // packed caster (item or unit), packed caster unit, ...
 		r.PackedGUID()
 		u := r.PackedGUID()
+		count := r.U8()
 		delete(s.casting, u)
-		if u == me {
+		// only OUR cast ends the lock: triggered spells carry castCount 0 - Frost Armor's Chill on
+		// every hit taken released it mid-Frostbolt (SPELL_IN_PROGRESS ~120 a mage run)
+		if u == me && count == s.castCount {
 			// the cast is done but the global cooldown (1.5 s from the cast) is not: casting into
 			// it failed ~70 % of a mage's Frostbolts (SMSG_CAST_FAILED 1930 of 2743)
 			s.selfCastUntil = s.lastCastSent.Add(1500 * time.Millisecond)
 		}
 	case opcode.SMSGSpellFailure, opcode.SMSGSpellFailedOther: // packed caster, ...
 		u := r.PackedGUID()
+		count := r.U8()
 		delete(s.casting, u)
-		if u == me {
+		if u == me && count == s.castCount {
 			s.selfCastUntil = time.Time{}
 		}
 	case opcode.SMSGCorpseReclaimDelay: // u32 ms
@@ -302,6 +306,9 @@ func (s *service) attack(ctx context.Context, guid uint64) error {
 func (s *service) castAt(ctx context.Context, spell uint32, guid uint64) error {
 	s.mu.Lock()
 	s.castCount++
+	if s.castCount == 0 { // 0 is what TRIGGERED spells carry: never use it for ours
+		s.castCount = 1
+	}
 	c := s.castCount
 	s.mu.Unlock()
 	var w wow.Writer
@@ -704,6 +711,13 @@ func (s *service) castAbilities(ctx context.Context, req *combatv1.KillRequest,
 		if !s.thriftOK(a, st, guid, losing) {
 			continue
 		}
+		s.mu.Lock()
+		if s.castFailed[a.GetSpellId()] == 67 { // NOT_READY: its cooldown runs from the hit (Raptor
+			// Strike lands on the next swing), not from our send - retry in 0.4 s, not a whole timer
+			delete(s.castFailed, a.GetSpellId())
+			lastCast[a.GetSpellId()] = time.Now().Add(400*time.Millisecond - every)
+		}
+		s.mu.Unlock()
 		if !a.GetOnSelf() && a.GetItemId() == 0 && !a.GetOnWeapon() {
 			// out of the spell's range band: the hunter's Serpent Sting failed TOO_CLOSE in melee and
 			// Raptor Strike fired from range - the cast only cost the tick
