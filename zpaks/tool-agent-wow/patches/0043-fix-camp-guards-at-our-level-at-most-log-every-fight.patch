From 0732083e8f76de557c116d8d1e65babae91f9f0a Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Thu, 8 Oct 2026 20:54:14 +0000
Subject: [PATCH] fix: camp guards at our level at most; log every fight's
 swings and damage (F-219)

- a level-3 draenei lost 1v1 to a Mutated Owlkin 16537 (level 3-4) while clearing a crate camp:
  camp clearing now only takes mobs at or below our level (tougher guards park the quest)
- kill()/clear_camp print the combat module's own numbers (swings, damage dealt and taken) per
  fight, to measure why fresh characters lose even fights

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SQmFdwZBdZ1kNkYTTF4JNJ
---
 zeppelin/tests/start_area.py | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/zeppelin/tests/start_area.py b/zeppelin/tests/start_area.py
index 0bfd3d1..d919bf6 100644
--- a/zeppelin/tests/start_area.py
+++ b/zeppelin/tests/start_area.py
@@ -937,13 +937,14 @@ class Runner:
         mobs = [o for o in mobs if info.get(o["entry"], (99, 0))[1] != 8]  # no critters (type 8)
         if not mobs:
             return False
-        if any(info.get(o["entry"], (99, 0))[0] > level + 1 for o in mobs):
+        # level+1 still lost 1v1 (a level-3 draenei vs a lone Mutated Owlkin 16537): only even or lower
+        if any(info.get(o["entry"], (99, 0))[0] > level for o in mobs):
             # a guard 2+ levels above us (Ammen Vale: a level-2 draenei died to a Mutated Root Lasher
             # clearing the last mob) - not a fight to take yet: park the quest until we outlevel it
             q = getattr(self, "current_qid", None)
             if q:
                 self.deaths_on[q] = max(self.deaths_on.get(q, 0), 2)
-            print(f"  camp at ({spot[0]:.0f},{spot[1]:.0f}) is guarded above level {level + 1} - later", flush=True)
+            print(f"  camp at ({spot[0]:.0f},{spot[1]:.0f}) is guarded above level {level} - later", flush=True)
             return True
         # outermost = farthest from the crate; among those, the nearest to us
         t = max(mobs, key=lambda o: (round(math.dist((o["x"], o.get("y", 0)), spot[:2]) / 5), -o.get("distance", 0)))
@@ -953,6 +954,7 @@ class Runner:
         if math.dist((me["x"], me["y"]), (ax, ay)) > 8:
             self.travel(ax, ay, ground(ax, ay, t.get("z", 0)), within=4)
         r = call("combat.kill", guid=int(t["guid"]), abilities=self.abilities, loot=True)
+        self.fight_log(t["entry"], r)
         self.kills += r.get("killed", False)
         if "no damage" in r.get("reason", "") or "cannot attack" in r.get("reason", ""):
             self.grind_skip.add(t["entry"])  # not hostile after all
@@ -1032,7 +1034,15 @@ class Runner:
             return sum(1 for m in mobs if m is not t and
                        math.dist((m["x"], m.get("y", 0)), (t["x"], t.get("y", 0))) < 10)
         t = min(cands, key=lambda o: (crowd(o), o.get("distance", 999)))
-        return call("combat.kill", guid=int(t["guid"]), abilities=self.abilities, loot=True)
+        r = call("combat.kill", guid=int(t["guid"]), abilities=self.abilities, loot=True)
+        self.fight_log(entry, r)
+        return r
+
+    def fight_log(self, entry, r):
+        """One line per fight with what the combat module measured - how hard we hit vs how hard we
+        are hit is the number that explains the death rate of fresh characters."""
+        print(f"  fight {entry}: {r.get('reason', 'killed')} swings {r.get('swings', 0)} dealt {r.get('damageDone', 0)} "
+              f"taken {r.get('damageTaken', 0)}", flush=True)
 
     def spirit_rez(self):
         """Resurrect at the nearest spirit healer (npcflag 0x4000; only a ghost sees one). Its spawn
