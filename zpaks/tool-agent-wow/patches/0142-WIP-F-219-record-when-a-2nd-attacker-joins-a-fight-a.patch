               f"{' fails ' + ','.join(r['castFails']) if r.get('castFails') else ''}"
-              f"{' kites ' + str(r['kites']) if r.get('kites') else ''}",
+              f"{' kites ' + str(r['kites']) if r.get('kites') else ''}"
+              f"{' add@%.1fs hp%d%%' % (r['addAfterMs'] / 1000, r.get('addOurHpPct', 0)) if r.get('addAfterMs') else ''}",
               flush=True)
         self.check_loot(r)
         why = r.get("reason", "")
