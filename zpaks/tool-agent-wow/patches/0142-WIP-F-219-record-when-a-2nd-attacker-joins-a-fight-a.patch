diff --git a/zeppelin/tests/deaths.py b/zeppelin/tests/deaths.py
index c3c0a2e..44d4cc0 100644
--- a/zeppelin/tests/deaths.py
+++ b/zeppelin/tests/deaths.py
@@ -1,4 +1,4 @@
-"""deaths.py AREA [AREA...] - cause-of-death breakdown for each bot's latest run (F-219).
+"""deaths.py AREA [AREA...] | --adds AREA... - cause-of-death breakdown for each bot's latest run (F-219).
 Per death: the killing fight (pull / defend / engage, attackers), health going in (= damage taken in
 the fatal fight, as it ends at 0), the killer's level against ours, and what the bot was doing."""
 import collections, re, subprocess, sys
@@ -30,7 +30,7 @@ def context(L, i):
         return "other: " + t[:50]
     return "?"
 
-for area in sys.argv[1:]:
+for area in ([] if "--adds" in sys.argv else sys.argv[1:]):
     log = open(f"{area_dir(area)}/fleet.log", errors="replace").read().splitlines()
     start = max(i for i, l in enumerate(log) if "] new character" in l)
     L = log[start:]
@@ -53,3 +53,22 @@ for area in sys.argv[1:]:
     print("  doing:", dict(c(r["ctx"] for r in rows).most_common(8)))
     print("  killers:", ", ".join(f"{info.get(e, (0, 0, '?'))[2]} {info.get(e, (0, 0))[0]}-{info.get(e, (0, 0))[1]} x{k}"
                                 for e, k in c(r["entry"] for r in rows).most_common(5)))
+
+
+def adds(area):
+    """When the 2nd attacker joined, over every 2+ fight of the latest run: at once (the pull brought
+    it - avoidable) or mid-fight (a wanderer - drag the fight away)."""
+    log = open(f"{area_dir(area)}/fleet.log", errors="replace").read().splitlines()
+    L = log[max(i for i, l in enumerate(log) if "] new character" in l):]
+    rows = [(float(m[1]), int(m[2]), "we died" in l) for l in L for m in [re.search(r" add@([\d.]+)s hp(\d+)%", l)] if m]
+    if not rows:
+        print(f"  {area}: no add timings logged yet")
+        return
+    b = collections.Counter(("0-3 s (pull brought it)" if t < 3 else "3-10 s" if t < 10 else "10 s+ (mid-fight)") for t, _, _ in rows)
+    died = collections.Counter(("0-3 s" if t < 3 else "3-10 s" if t < 10 else "10 s+") for t, _, d in rows if d)
+    print(f"  {area}: {len(rows)} fights with an add - {dict(b)}; fatal ones: {dict(died)}")
+
+
+if __name__ == "__main__" and "--adds" in sys.argv:
+    for a in [x for x in sys.argv[1:] if not x.startswith("--")]:
+        adds(a)
