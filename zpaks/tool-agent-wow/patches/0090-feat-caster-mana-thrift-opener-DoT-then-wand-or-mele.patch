+// thriftOK: the mana-thrift gates of an ability (max_per_target, min_power_pct), both lifted while
+// we are losing the fight.
+func (s *service) thriftOK(a *combatv1.Ability, st *interactv1.SelfState, guid uint64, losing bool) bool {
+	if losing {
+		return true
+	}
+	if n := a.GetMaxPerTarget(); n > 0 && s.castsOn[[2]uint64{uint64(a.GetSpellId()), guid}] >= n {
+		return false
+	}
+	if p := a.GetMinPowerPct(); p > 0 && st.GetPowerType() == 0 && st.GetMaxPower() > 0 &&
+		st.GetPower()*100/st.GetMaxPower() < p {
+		return false
+	}
+	return true
+}
+
+// offenseLeft: is any attack spell (not a self cast, item, weapon enchant or interrupt) still allowed
+// on this target by power and thrift? None left = a ranged fighter switches to wand or melee.
+func (s *service) offenseLeft(req *combatv1.KillRequest, st *interactv1.SelfState, guid uint64, losing bool) bool {
+	for _, a := range req.GetAbilities() {
+		if a.GetOnSelf() || a.GetItemId() != 0 || a.GetOnWeapon() || a.GetInterrupt() || a.GetBuff() {
+			continue
+		}
+		if st.GetPower() >= a.GetMinPower() && s.thriftOK(a, st, guid, losing) {
+			return true
+		}
+	}
+	return false
+}
