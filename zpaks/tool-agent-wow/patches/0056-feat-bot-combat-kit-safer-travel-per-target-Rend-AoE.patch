+        threats = [t for t in self.threats() if level - t[2] < 6                    # grey mobs leave us be
+                   and math.dist(t[:2], (x, y)) > radius(t) + 15                     # the camp we are going to
+                   and math.dist(t[:2], start) > radius(t)                           # one we are already in
+                   and not any(math.dist(t[:2], c) < 30 for c in self._skirted)]       # skirted this trip
