+
+// Equipped lists what we wear: bag 255, slot = equipment slot (0 head .. 15 main hand, 16 off hand,
+// 17 ranged, 18 tabard).
+func (s *Store) Equipped() []InventoryItem {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	me, ok := s.objects[s.self]
+	if !ok {
+		return nil
+	}
+	var out []InventoryItem
+	for i := 0; i < 19; i++ {
+		g := guidAt(me.Values, uint16(FieldPlayerInvSlot+2*i))
+		if g == 0 {
+			continue
+		}
+		it := InventoryItem{GUID: g, Bag: BagBackpack, Slot: uint8(i), Count: 1}
+		if o, ok := s.objects[g]; ok {
+			it.Entry, it.Count = o.Values[FieldEntry], o.Values[FieldItemStackCount]
+		}
+		out = append(out, it)
+	}
+	return out
+}
