+    def lead_follower(self, qid, idx, target, before):
+        """Walk our summoned follower to its next marker (nearest one not tried this quest) and wait for
+        the credit: it pays when the FOLLOWER reaches the marker, so stand on it and give it time."""
+        esc, pts = self.w.follow_credit[target]
+        tried = self.__dict__.setdefault("_follow_tried", {}).setdefault(qid, set())
+        me = self.me()
+        left = [p for p in pts if p not in tried]
+        if not left:
+            tried.clear()  # every marker once and still short: go round again
+            left = list(pts)
+        p = min(left, key=lambda q: math.dist(q[:2], (me["x"], me["y"])))
+        tried.add(p)
+
+        def follower():
+            seen = [o for o in call("interact.find", entry=esc, limit=3).get("objects", []) if o.get("health", 0) > 0]
+            return min(seen, key=lambda o: o.get("distance", 99)) if seen else None
+        # lead, do not run: short hops on the straight road (no detours - the follower takes the direct
+        # path) and wait for it after each one. Detours round the Kaja'mite cave's 18-mob camp left the
+        # Frightened Miner behind and the quest lost its follower after 2 of 4 deposits
+        was, self._detouring = getattr(self, "_detouring", False), True
+        try:
+            for _ in range(40):
+                me = self.me()
+                d = math.dist(p[:2], (me["x"], me["y"]))
+                if d <= 4:
+                    break
+                k = min(1.0, 20.0 / d)
+                hx, hy = me["x"] + (p[0] - me["x"]) * k, me["y"] + (p[1] - me["y"]) * k
+                self.travel(hx, hy, ground(hx, hy, p[2]), within=3)
+                self.safe()
+                # wait for it - it stops ~15 s to mine any marker it passes (the bot walked on after 12 s,
+                # lost sight of the Frightened Miner at 58 yd and abandoned a quest that was going fine)
+                unseen = 0
+                for _ in range(25):
+                    f = follower()
+                    if f:
+                        unseen = 0
+                        hp0 = getattr(self, "_follow_hp", f.get("health", 0))
+                        self._follow_hp = f.get("health", 0)
+                        self._follow_seen = (f["x"], f.get("y", 0), f.get("z", 0))
+                        if f.get("health", 0) < hp0:
+                            # it is being hit (passive: it never fights back) - kill what stands on it
+                            foes = [o for o in call("interact.find", type=3, radius=40, limit=30).get("objects", [])
+                                    if o.get("health", 0) > 0 and not o.get("npcFlags") and self.hostile(o["entry"])
+                                    and math.dist((o["x"], o.get("y", 0)), (f["x"], f.get("y", 0))) < 8]
+                            if foes:
+                                g = min(foes, key=lambda o: math.dist((o["x"], o.get("y", 0)), (f["x"], f.get("y", 0))))
+                                r = call("combat.kill", guid=int(g["guid"]), **self.fight_args(), loot=False)
+                                self.fight_log(g["entry"], r, "defend follower")
+                                continue
+                        if f.get("distance", 99) < 12:
+                            break
+                        if f.get("distance", 99) > 30:  # it fell behind: go back for it
+                            self.travel(f["x"], f.get("y", 0), f.get("z", 0), within=8)
+                    else:
+                        unseen += 1
+                        if unseen > 5:
+                            break  # gone: the miss/abandon logic below decides
+                        if getattr(self, "_follow_seen", None):  # out of sight: back to where we last saw it
+                            self.travel(*self._follow_seen, within=8)
+                    if self.log().get(qid, {}).get("counts", [0, 0, 0, 0])[idx] > before:
+                        print(f"  follower credit {target}: on the way, near ({me['x']:.0f},{me['y']:.0f})", flush=True)
+                        return True
+                    time.sleep(2)
+                if not follower():
+                    break
+        finally:
+            self._detouring = was
+        t0 = time.time()
+        while time.time() - t0 < 30:
+            self.safe()
+            now = self.log().get(qid, {}).get("counts", [0, 0, 0, 0])[idx]
+            if now > before:
+                print(f"  follower credit {target}: {now} at marker ({p[0]:.0f},{p[1]:.0f})", flush=True)
+                return True
+            time.sleep(2)
+        seen = [o for o in call("interact.find", entry=esc, limit=3).get("objects", []) if o.get("distance", 99) < 40]
+        print(f"  follower credit {target}: nothing at ({p[0]:.0f},{p[1]:.0f}) - follower {esc} "
+              f"{'beside us' if seen else 'NOT in sight'}", flush=True)
+        if not seen and getattr(self, "_follow_seen", None):
+            self.travel(*self._follow_seen, within=8)  # look where we last saw it before giving up
+            seen = [o for o in call("interact.find", entry=esc, limit=3).get("objects", []) if o.get("distance", 99) < 40]
+        if not seen:
+            miss = self.stuck.get(("follow", target), 0) + 1
+            self.stuck[("follow", target)] = miss
+            if miss >= 2:
+                # the follower is gone (killed, lost in a cave) and its controller aura stays on us, so
+                # nothing summons another: drop and retake the quest, as a player would (14021: the
+                # Frightened Miner lost after 2 deposits; a relog kept aura 68062 and brought no miner)
+                r = call("interact.quest_abandon", quest_id=qid)
+                print(f"  follower {esc} gone - abandon {qid} to restart it: {r.get('detail')}", flush=True)
+                self.stuck.pop(("follow", target), None)
+                self.stuck.pop(qid, None)
+                self._follow_tried.pop(qid, None)
+                self._follow_seen = None
+                time.sleep(2)
+                return True
+            raise StepFailed(f"follower {esc} for credit {target} not with us")
+        self.stuck.pop(("follow", target), None)
+        return True
