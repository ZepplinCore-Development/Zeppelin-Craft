+            for r in (16, 28) for a in range(12)]
+        best = max(pts, key=lambda p: score(*p))
+        if far <= 30 and score(*best) - score(me["x"], me["y"]) < 8:
+            return 1  # in reach and about as quiet as it gets
+        z = ground(best[0], best[1], corpse.get("z", me.get("z", 0)))
+        if abs(z - corpse.get("z", z)) > 12:
+            best, z = (corpse["x"], corpse["y"]), corpse.get("z", z)  # a ledge: the radius is 3D - the body
+        print(f"    revive: reclaiming from ({best[0]:.0f},{best[1]:.0f}), {score(*best):.0f} yd from the "
