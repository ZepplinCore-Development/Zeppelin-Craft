+    def _place_ghost(self, corpse, placed):
+        """Park the ghost where it will come back to life: we revive where the GHOST stands, anywhere
+        within the 39 yd reclaim radius - not on the body, next to whatever killed us (Teldrassil: a
+        hunter revived beside the same Timberling 6 times running and died each time before it could
+        sit down). Picks the spot within 28 yd of the corpse farthest from live hostiles and from
+        hostile spawn points (a respawn on top of a half-health bot is the next death). Returns 1 when
+        it settled on a spot (moved or not), 0 when the ghost is not near the body yet. Called between
+        revive polls (3 s apart): a ghost covers ~30 yd in that time and the module reclaims as soon as
+        it is within 34 yd with the delay over - so take over from 70 yd out."""
+        me = self.me()
