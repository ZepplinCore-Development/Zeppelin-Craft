+        if far > 70:
+            return 0
+        live = [(o["x"], o.get("y", 0)) for o in call("interact.find", type=3, radius=90, limit=80).get("objects", [])
+                if o.get("health", 0) > 0 and not o.get("npcFlags") and self.hostile(o["entry"])]
+        spawns = [t[:2] for t in self.threats() if math.dist(t[:2], (corpse["x"], corpse["y"])) < 90]
