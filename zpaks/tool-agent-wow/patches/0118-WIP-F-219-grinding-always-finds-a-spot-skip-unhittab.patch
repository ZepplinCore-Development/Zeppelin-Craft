+            # immune is read as "skip for 2 min since"; a fight that ran its budget skips 10 min
+            self.immune[int(r["guid"])] = time.time() + (480 if why == "budget" else 0)
         if r.get("reason") == "flee":
             self.flee_to_guard()
 
@@ -2516,7 +2545,12 @@ class Runner:
         # level-9/10 Ether Fiends and the Spire's packs on roads the +3 rule let it take
         gap = 2  # every class (was 3 for ranged: a level-5 druid walked into level-7/8 gnolls)
         red = [t for t in self.threats() if t[2] >= level + gap]
-        if not red:
+        # ...and where we died twice at this level in the last 15 min: whatever got us there will again
+        # (Teldrassil's hunter ran one road to the same grell ambush 10 times: the died-twice check only
+        # looked at the destination)
+        spots = [(dx, dy) for dx, dy, dl in self.death_spots if dl == level]
+        graves = [p for p in spots if sum(1 for q in spots if math.dist(p, q) < 45) >= 2]
+        if not red and not graves:
             return
         try:
             pts = call("move.path", x=x, y=y, z=z).get("points", [])
@@ -2535,6 +2569,13 @@ class Runner:
                 p = (ax + (bx - ax) * i / n, ay + (by - ay) * i / n)
