@@ -1955,9 +1974,12 @@ class Runner:
             spots = sorted(((-better[e], math.dist(p[:2], (me["x"], me["y"])), p) for e in better
                             for p in self.w.cspawn.get(e, []) if p not in self.w.beyond
                             and math.dist(p[:2], (me["x"], me["y"])) < 400), key=lambda q: q[:2])
-            if spots:
-                self.travel(*spots[0][2], within=15)
-                return True
+            for _, _, p in [q for q in spots[:8] if not self.dense_level(q[2]) or level >= self.dense_level(q[2])][:4]:
+                try:
+                    self.travel(*p, within=15)
+                    return True
+                except StepFailed as e:  # a guarded road there: fight what is here instead
+                    print(f"  ~ grind (better): {str(e)[:90]}", flush=True)
         # the kill RPC will not chase far ("too far") - close in first; a ranged class only to its range
         # (it walked to 4 yd and gave its whole range advantage away)
         stand = self.fight_range() - 2 if CLASS_RANGE.get(self.w.cls) else 4
@@ -2219,6 +2241,13 @@ class Runner:
               f"{' kites ' + str(r['kites']) if r.get('kites') else ''}",
               flush=True)
         self.check_loot(r)
+        why = r.get("reason", "")
+        if r.get("guid") and not r.get("killed") and not r.get("damageDone") and (
