+                if grave:
+                    q = getattr(self, "current_qid", None)
+                    if q:
+                        self.defer_until[q] = max(self.defer_until.get(q, 0), level + 1)
+                    raise StepFailed(f"route to ({x:.0f},{y:.0f}) passes ({grave[0]:.0f},{grave[1]:.0f}) where we "
+                                     f"died twice at level {level} - back at level {level + 1}")
                 hit = next((t for t in red if math.dist(t[:2], p) < reach(t)), None)
                 if hit:
                     # back at the first level where it no longer counts: hit - gap + 1 (melee: one below
@@ -2658,6 +2699,10 @@ class Runner:
                         break  # the flank is unwalkable after all: take the plain path
             finally:
                 self._detouring = False
+            if self._skirted and not self.reviving:
+                # the detours changed the road: guard the rest of it from here (Teldrassil: the hunter
+                # skirted a lone Nightsaber, walked on past the Vicious Grell camp and died there 25 times)
+                self.route_guard(x, y, z, call("interact.self").get("level", 1))
         # walk in 6 s slices and turn to fight between them: one 25 s path_to let a mob that aggroed
         # on the way hit our back the whole time (most early deaths were on the road, not in camps)
         for _ in range(60):
