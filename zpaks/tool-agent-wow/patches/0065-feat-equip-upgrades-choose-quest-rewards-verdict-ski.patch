diff --git a/zeppelin/tests/start_area.py b/zeppelin/tests/start_area.py
index 9b56dfe..5f3e8a1 100644
--- a/zeppelin/tests/start_area.py
+++ b/zeppelin/tests/start_area.py
@@ -103,6 +103,18 @@ def inlist(values):
     return ",".join(str(v) for v in values) or "0"
 
 
+# -- gear: equip upgrades, choose quest rewards ---------------------------------------------------
+# InventoryType -> equipment slots it can go to (0 head .. 15 main hand, 16 off hand, 17 ranged)
+INV_SLOTS = {1: [0], 2: [1], 3: [2], 5: [4], 20: [4], 6: [5], 7: [6], 8: [7], 9: [8], 10: [9], 11: [10, 11],
+             12: [12, 13], 16: [14], 13: [15], 21: [15], 17: [15], 22: [16], 14: [16], 23: [16], 15: [17],
+             25: [17], 26: [17]}
+WEAPON_SKILL = {0: 44, 1: 172, 2: 45, 3: 46, 4: 54, 5: 160, 6: 229, 7: 43, 8: 55, 10: 136, 13: 473,
+                15: 173, 16: 176, 18: 226}  # item subclass -> skill line
+ARMOR_OK = {1: {1, 2, 3, 6}, 2: {1, 2, 3, 6}, 3: {1, 2}, 4: {1, 2}, 5: {1}, 6: {1, 2, 3}, 7: {1, 2}, 8: {1},
+            9: {1}, 11: {1, 2}}  # class -> armour subclasses wearable below 40 (6 = shield)
+STAT_W = {1: {4: 2.0, 3: 1.0, 7: 1.5}, 2: {4: 2.0, 5: 1.0, 7: 1.5}, 4: {3: 2.0, 4: 1.0, 7: 1.5}}  # STR 4 AGI 3 INT 5 STA 7
+
+
 class World:
     """Everything the runner needs about the area, loaded once."""
 
@@ -157,7 +169,7 @@ class World:
             if int(r["id"]) in self.gspawn:
                 self.enders.setdefault(int(r["quest"]), []).append(("g", int(r["id"])))
         self.quests = {int(r["ID"]): r for r in sql(
-            "SELECT q.ID,q.LogTitle,q.MinLevel,q.QuestLevel,q.AllowableRaces,q.StartItem,"
+            "SELECT q.ID,q.LogTitle,q.MinLevel,q.QuestLevel,q.AllowableRaces,q.StartItem,q.RewardNextQuest,q.QuestSortID,"
