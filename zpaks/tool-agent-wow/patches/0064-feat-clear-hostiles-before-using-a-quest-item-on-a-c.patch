From 4630d003c68d1303f5bdcbc42154d83142430203 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sat, 10 Oct 2026 06:26:12 +0000
Subject: [PATCH] feat: clear hostiles before using a quest item on a creature;
 threats know wander + patrol routes (F-219)

- use_quest_item_on: clear_camp() around the target spawn first, as for a crate (Ammen Vale's
  Inoculation targets stand among Mutated Owlkin); the friendly target is never pulled
- threats(): random wanderers widen by wander_distance; waypoint patrols (creature_addon.path_id
  -> waypoint_data) count along their whole route, so detours skirt the patrol, not the spawn

Not yet live in the running fleet (queued for the next restart).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SQmFdwZBdZ1kNkYTTF4JNJ
---
 zeppelin/tests/start_area.py | 31 ++++++++++++++++++++++++++-----
 1 file changed, 26 insertions(+), 5 deletions(-)

diff --git a/zeppelin/tests/start_area.py b/zeppelin/tests/start_area.py
index 7869387..9b56dfe 100644
--- a/zeppelin/tests/start_area.py
+++ b/zeppelin/tests/start_area.py
@@ -1658,15 +1658,27 @@ class Runner:
             side = 2 if self.w.race in (1, 3, 4, 7, 11, 12) else 4
             x1, y1, x2, y2 = self.w.box
             m = 500
-            rows = sql("SELECT c.id e,c.position_x x,c.position_y y,t.faction f,t.minlevel l FROM creature c "
+            rows = sql("SELECT c.guid g,c.id e,c.position_x x,c.position_y y,t.faction f,t.minlevel l,"
+                       "c.MovementType mt,c.wander_distance wd,a.path_id p FROM creature c "
+                       "LEFT JOIN creature_addon a ON a.guid=c.guid "
                        "JOIN creature_template t ON t.entry=c.id WHERE t.type<>8 AND t.npcflag=0 AND "
                        f"c.map={self.w.map} AND c.position_x BETWEEN {min(x1, x2) - m} AND {max(x1, x2) + m} "
                        f"AND c.position_y BETWEEN {min(y1, y2) - m} AND {max(y1, y2) + m}")
             facs = inlist({int(r["f"]) for r in rows})
             enemy = {int(r["id"]) for r in dbc(f"SELECT id,enemy_group e FROM factiontemplate WHERE id IN ({facs})")
                      if int(r["e"]) & (1 | side)}
-            self._threats = [(float(r["x"]), float(r["y"]), int(r["l"]), int(r["e"])) for r in rows
-                             if int(r["f"]) in enemy]
+            # (x, y, level, entry, pad): pad widens the reach - a random wanderer by its wander
+            # radius; a waypoint patrol is a threat along its WHOLE route (Ammen Vale: 4 of 37 Mutated
+            # Owlkin patrol 9-71 node paths - nowhere near their spawn point)
+            hot = [r for r in rows if int(r["f"]) in enemy]
+            self._threats = [(float(r["x"]), float(r["y"]), int(r["l"]), int(r["e"]),
+                              float(r["wd"] or 0) if r["mt"] == "1" else 0.0) for r in hot]
+            paths = {int(r["p"]): r for r in hot if r["mt"] == "2" and r["p"] not in ("NULL", "0", "")}
+            if paths:
+                for w in sql(f"SELECT id,point,position_x x,position_y y FROM waypoint_data WHERE id IN ({inlist(paths)})"):
+                    if int(w["point"]) % 2 == 0:  # every other node: dense enough at ~20 yd reach
+                        r = paths[int(w["id"])]
+                        self._threats.append((float(w["x"]), float(w["y"]), int(r["l"]), int(r["e"]), 3.0))
         return self._threats
 
     def detour(self, x, y, z):
@@ -1684,8 +1696,8 @@ class Runner:
             return []
         start = (pts[0].get("x", 0), pts[0].get("y", 0))
 
-        def radius(t):
-            return max(6.0, min(28.0, 20.0 + t[2] - level)) + 4  # +4: the mob is not always on its spawn
+        def radius(t):  # +4: never exactly on its spot; + its wander radius / patrol slack
+            return max(6.0, min(28.0, 20.0 + t[2] - level)) + 4 + t[4]
         threats = [t for t in self.threats() if level - t[2] < 6                    # grey mobs leave us be
                    and math.dist(t[:2], (x, y)) > radius(t) + 15                     # the camp we are going to
                    and math.dist(t[:2], start) > radius(t)                           # one we are already in
@@ -2771,6 +2783,15 @@ class Runner:
             item = int(q[k])
             if item and self.w.item_spell.get(item):
                 spell = self.w.item_spell[item]
+                # clear the hostiles around the target first, as for a crate in a camp (Ammen Vale:
+                # Inoculation's Nestlewood Owlkin stand among Mutated Owlkin - walking in to use the
+                # item pulled 2-3 of them every time). The friendly target itself is never pulled
+                spot = self.w.nearest("c", entry, self.me(), self.phase_mask())
+                cleared = self.clear_camp(spot) if spot else False
+                if cleared == "later":
+                    return False  # parked until we level - let other quests run
+                if cleared:
+                    return True   # pulled one hostile; the target waits until it is clear
                 o = self.go_near("c", entry, offset=2.0, usable_only=True, has_aura=self.w.spell_target_aura.get(spell, 0))
                 if o:
                     self.used[int(o["guid"])] = time.time()
