diff --git a/zeppelin/modules/combat/main.go b/zeppelin/modules/combat/main.go
index dbeb976..8978d81 100644
--- a/zeppelin/modules/combat/main.go
+++ b/zeppelin/modules/combat/main.go
@@ -68,6 +68,8 @@ type service struct {
 	castsOn                                       map[[2]uint64]uint32 // (spell, target) -> casts, for max_per_target
 	maxSeen                                       map[uint64]uint32    // target -> highest health seen (its max: no field for it)
 	firstHit                                      map[uint64]time.Time // target -> when it first lost health (time-to-kill estimate)
+	comboTarget                                   uint64               // SMSG_UPDATE_COMBO_POINTS: whose they are...
+	combo                                         uint8                // ...and how many
 }
 
 func main() {
@@ -201,6 +203,12 @@ func (s *service) OnPacket(ctx context.Context, p *modv1.WorldPacket) (*emptypb.
 		s.deadTarget = true
 	case opcode.SMSGAttackswingCantAttack:
 		s.cantAttack = true
+	case opcode.SMSGUpdateComboPoints: // packed target guid, u8 points
+		target := r.PackedGUID()
+		n := r.U8()
+		if r.Err() == nil {
+			s.comboTarget, s.combo = target, n
+		}
 	case opcode.SMSGCastFailed: // castCount u8, spell u32, result u8
 		r.U8()
 		spell, result := r.U32(), r.U8()
@@ -755,6 +763,9 @@ func (s *service) castAbilities(ctx context.Context, req *combatv1.KillRequest,
 		if !a.GetOnSelf() && !s.dotWorth(a, guid, t.GetHealth()) {
 			continue
 		}
+		if !s.comboOK(a, guid, t.GetHealth(), losing) {
+			continue
+		}
 		if a.GetOnWeapon() {
 			// a temporary weapon enchant (Rockbiter): only when the main hand has none, cast AT the
 			// weapon - cast at ourselves it failed ITEM_NOT_FOUND every time
@@ -842,6 +853,27 @@ func (s *service) dotWorth(a *combatv1.Ability, guid uint64, hp uint32) bool {
 	return left == 0 || left*2 >= time.Duration(a.GetDotMs())*time.Millisecond
 }
 
+// comboOK: a finisher waits for min_combo points on this target; any point will do once the target is
+// about to die (under 4 s at the current rate) or we are losing. Eviscerate used to fire on a 10 s
+// timer and failed NO_COMBO_POINTS 45 times a run.
+func (s *service) comboOK(a *combatv1.Ability, guid uint64, hp uint32, losing bool) bool {
+	n := a.GetMinCombo()
+	if n == 0 {
+		return true
+	}
+	s.mu.Lock()
+	have := uint32(0)
+	if s.comboTarget == guid {
+		have = uint32(s.combo)
+	}
+	s.mu.Unlock()
+	if have >= n {
+		return true
+	}
+	left := s.timeLeft(guid, hp)
+	return have >= 1 && (losing || (left > 0 && left < 4*time.Second))
+}
+
 // offenseLeft: is any attack spell (not a self cast, item, weapon enchant, interrupt or buff) castable
 // on this target now or within 2 s - power, thrift, its own timer and the DoT test all allow it? None
 // = a ranged fighter switches to wand or melee (a DoT ticking for 18 s is no reason to stand idle).
