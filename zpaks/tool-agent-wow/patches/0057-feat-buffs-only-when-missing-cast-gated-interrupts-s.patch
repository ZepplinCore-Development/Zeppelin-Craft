+func (s *service) hasAura(spell uint32) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for _, sp := range s.auras {
+		if sp == spell {
+			return true
+		}
+	}
+	return false
+}
+
+// isCasting: the unit is mid-cast with time left to interrupt it.
+func (s *service) isCasting(guid uint64) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	end, ok := s.casting[guid]
+	return ok && time.Until(end) > 150*time.Millisecond
+}
