-// offenseLeft: is any attack spell (not a self cast, item, weapon enchant or interrupt) still allowed
-// on this target by power and thrift? None left = a ranged fighter switches to wand or melee.
-func (s *service) offenseLeft(req *combatv1.KillRequest, st *interactv1.SelfState, guid uint64, losing bool) bool {
+// timeLeft estimates how long the target has to live from the damage done to it so far
+// (0 = unknown: no damage yet, or under 2 s of data).
+func (s *service) timeLeft(guid uint64, hp uint32) time.Duration {
+	t0, ok := s.firstHit[guid]
+	lost := s.maxSeen[guid] - hp
+	if !ok || lost == 0 || time.Since(t0) < 2*time.Second {
+		return 0
+	}
+	return time.Duration(float64(time.Since(t0)) * float64(hp) / float64(lost))
+}
+
+// dotWorth: a DoT only goes on (or is refreshed) when the target should outlive half its duration.
+func (s *service) dotWorth(a *combatv1.Ability, guid uint64, hp uint32) bool {
+	if a.GetDotMs() == 0 {
+		return true
+	}
+	left := s.timeLeft(guid, hp)
+	return left == 0 || left*2 >= time.Duration(a.GetDotMs())*time.Millisecond
+}
+
+// offenseLeft: is any attack spell (not a self cast, item, weapon enchant, interrupt or buff) castable
+// on this target now or within 2 s - power, thrift, its own timer and the DoT test all allow it? None
+// = a ranged fighter switches to wand or melee (a DoT ticking for 18 s is no reason to stand idle).
+func (s *service) offenseLeft(req *combatv1.KillRequest, st *interactv1.SelfState, guid uint64, hp uint32,
+	losing bool, lastCast map[uint32]time.Time, lastOn map[[2]uint64]time.Time) bool {
 	for _, a := range req.GetAbilities() {
 		if a.GetOnSelf() || a.GetItemId() != 0 || a.GetOnWeapon() || a.GetInterrupt() || a.GetBuff() {
 			continue
 		}
-		if st.GetPower() >= a.GetMinPower() && s.thriftOK(a, st, guid, losing) {
+		if st.GetPower() < a.GetMinPower() || !s.thriftOK(a, st, guid, losing) || !s.dotWorth(a, guid, hp) {
+			continue
+		}
+		last := lastCast[a.GetSpellId()]
+		if a.GetPerTarget() {
+			last = lastOn[[2]uint64{uint64(a.GetSpellId()), guid}]
+		}
+		if time.Since(last)+2*time.Second >= time.Duration(a.GetEveryMs())*time.Millisecond {
 			return true
 		}
 	}
