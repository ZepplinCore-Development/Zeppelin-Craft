+syntax = "proto3";
+package zeppelin.interact.v1;
+option go_package = "github.com/agent-wow/agent-wow/zeppelin/modules/interact/api;interactv1";
+
+import "api/module/v1/session.proto";
+import "google/protobuf/empty.proto";
+
+// Target names an NPC or game object: an exact GUID, or the nearest visible object of an entry.
+message Target {
+  uint64 guid = 1;
+  uint32 entry = 2;
+}
+
+message WorldObject {
+  uint64 guid = 1;
+  uint32 entry = 2;
+  uint32 type = 3;       // 3 unit, 4 player, 5 game object
+  float x = 4;
+  float y = 5;
+  float z = 6;
+  float distance = 7;    // from the player, -1 when unknown
+  uint32 health = 8;
+  uint32 npc_flags = 9;
+  uint32 dyn_flags = 10; // unit: 0x1 lootable; GO: dynamic field
+  uint32 go_state = 11;  // GO: GAMEOBJECT_BYTES_1 byte 0
+  uint32 go_type = 12;   // GO: GAMEOBJECT_BYTES_1 byte 1
+}
+
+message FindRequest {
+  uint32 entry = 1;
+  uint32 type = 2;
+  float radius = 3;
+  uint32 limit = 4;
+}
+message FindResult { repeated WorldObject objects = 1; }
+
+message GossipOption {
+  uint32 id = 1;
+  uint32 icon = 2;
+  bool coded = 3;
+  string text = 4;
+}
+message GossipQuest {
+  uint32 id = 1;
+  uint32 icon = 2;
+  int32 level = 3;
+  string title = 4;
+}
+// Menu is whatever window the server opened in reply: a gossip menu or a quest list.
+message Menu {
+  string kind = 1;       // "gossip", "quest_list", "none" (timeout / window closed)
+  uint64 guid = 2;
+  uint32 menu_id = 3;
+  uint32 text_id = 4;
+  string title = 5;
+  repeated GossipOption options = 6;
+  repeated GossipQuest quests = 7;
+}
+
+message SelectRequest {
+  Target target = 1;
+  uint32 menu_id = 2;
+  uint32 option = 3;
+  string code = 4;
+}
+
+message QuestRequest {
+  Target target = 1;
+  uint32 quest_id = 2;
+  uint32 reward = 3;     // choice-reward index for complete
+}
+message QuestResult {
+  bool ok = 1;
+  string detail = 2;     // e.g. "accepted", "completed", "invalid reason 9", "timeout"
+  repeated uint32 choice_items = 3;
+}
+
+message QuestLogEntry {
+  uint32 quest_id = 1;
+  uint32 state = 2;
+  repeated uint32 counts = 3;
+  uint32 slot = 4;
+}
+message QuestLog { repeated QuestLogEntry entries = 1; }
+
+message LootItem {
+  uint32 slot = 1;
+  uint32 item_id = 2;
+  uint32 count = 3;
+}
+message LootResult {
+  bool opened = 1;
+  string detail = 2;
+  uint32 gold = 3;
+  repeated LootItem items = 4;   // what the window offered
+  repeated LootItem received = 5; // SMSG_ITEM_PUSH_RESULT seen while looting
+}
+message UseRequest {
+  Target target = 1;
+  bool loot_all = 2;     // also take everything if the use opens a loot window
+  uint32 spell_id = 3;   // cast this at the object instead of CMSG_GAMEOBJ_USE (locked chests: Opening 22810)
+}
+
+message CastRequest {
+  uint32 spell_id = 1;
+  Target target = 2;     // empty = no target (self / area)
+  string target_kind = 3; // "unit" (default when a target is given), "go", "self"
+  uint32 timeout_ms = 4; // wait for SPELL_GO / failure; 0 = 12 s (covers cast times)
+}
+message CastResult {
+  bool ok = 1;
+  string detail = 2;     // "spell_go", "cast_failed result N", "interrupted result N", "timeout"
+}
+
+message Event {
+  uint32 seq = 1;
+  uint32 client_time_ms = 2;
+  string kind = 3;       // quest_kill, quest_item, quest_complete, quest_reward, quest_failed, item, chat
+  uint32 quest_id = 4;
+  uint32 entry = 5;      // creature/GO/item entry
+  uint32 count = 6;
+  uint32 required = 7;
+  string text = 8;
+}
+message EventsRequest { uint32 since = 1; }
+message Events { repeated Event events = 1; uint32 last = 2; }
+
+service Interact {
+  rpc Find(FindRequest) returns (FindResult);
+  rpc GossipHello(Target) returns (Menu);
+  rpc GossipSelect(SelectRequest) returns (Menu);
+  rpc QuestHello(Target) returns (Menu);
+  rpc QuestAccept(QuestRequest) returns (QuestResult);
+  rpc QuestComplete(QuestRequest) returns (QuestResult);
+  rpc GetQuestLog(google.protobuf.Empty) returns (QuestLog);
+  rpc Use(UseRequest) returns (LootResult);
+  rpc Loot(UseRequest) returns (LootResult);
+  rpc GetEvents(EventsRequest) returns (Events);
+  rpc Cast(CastRequest) returns (CastResult);
+  rpc OnPacket(agentwow.module.v1.WorldPacket) returns (google.protobuf.Empty);
+}
diff --git a/zeppelin/modules/interact/main.go b/zeppelin/modules/interact/main.go
new file mode 100644
index 0000000..a26265b
--- /dev/null
+++ b/zeppelin/modules/interact/main.go
@@ -0,0 +1,771 @@
+// Command interact is a Zeppelin agent-wow gameplay module (F-219 Track A): it tracks visible
+// objects from update packets and drives NPC/GO interaction - gossip, quest accept / complete /
+// reward, game object use and looting - and records quest/item events for test assertions.
+//
+// Packet layouts follow the AzerothCore handlers/writers: NPCHandler/MiscHandler (gossip),
+// QuestHandler + GossipDef.cpp (quest windows), SpellHandler (GO use), LootHandler + LootMgr
+// (loot), QuestPackets.cpp (quest events), PlayerStorage SendNewItem (item push).
+// Interaction range is the caller's job: walk within ~5 yd first (move module).
+package main
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"os"
+	"os/signal"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/agent-wow/agent-wow/pkg/modules/v1"
+	"github.com/agent-wow/agent-wow/pkg/opcode"
+	"github.com/agent-wow/agent-wow/zeppelin/modules/interact/api"
+	movev1 "github.com/agent-wow/agent-wow/zeppelin/modules/move/api"
+	"github.com/agent-wow/agent-wow/zeppelin/wow"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/health"
+	"google.golang.org/grpc/health/grpc_health_v1"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/types/known/anypb"
+	"google.golang.org/protobuf/types/known/emptypb"
+)
+
+const (
+	replyTimeout = 5 * time.Second
+	maxEvents    = 2000
+)
+
+type packet struct {
+	op      uint32
+	payload []byte
+}
+
+type service struct {
+	interactv1.UnimplementedInteractServer
+	session modv1.SessionClient
+	store   *wow.Store
+
+	mu        sync.Mutex
+	waiters   map[chan packet]map[uint32]bool
+	events    []*interactv1.Event
+	seq       uint32
+	pushes    []*interactv1.LootItem // item pushes since the last loot started
+	castCount uint8
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run() error {
+	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer cancel()
+	path := os.Getenv("AGENT_WOW_MODULE_SOCKET")
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		return err
+	}
+	defer listener.Close()
+	if err := os.Chmod(path, 0666); err != nil {
+		return err
+	}
+	conn, err := grpc.NewClient("unix://"+os.Getenv("AGENT_WOW_SESSION_SOCKET"),
+		grpc.WithTransportCredentials(insecure.NewCredentials()), grpc.WithDisableRetry())
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	s := &service{session: modv1.NewSessionClient(conn), store: wow.NewStore(), waiters: map[chan packet]map[uint32]bool{}}
+	server := grpc.NewServer()
+	interactv1.RegisterInteractServer(server, s)
+	healthy := health.NewServer()
+	grpc_health_v1.RegisterHealthServer(server, healthy)
+	healthy.SetServingStatus("", grpc_health_v1.HealthCheckResponse_SERVING)
+	go func() { <-ctx.Done(); server.Stop() }()
+	return server.Serve(listener)
+}
+
+// -- plumbing -------------------------------------------------------------------------------------
+
+func (s *service) send(ctx context.Context, op uint32, w *wow.Writer) error {
+	var payload []byte
+	if w != nil {
+		payload = w.Bytes()
+	}
+	_, err := s.session.SendPacket(ctx, &modv1.SendPacketRequest{Opcode: op, Payload: payload})
+	return err
+}
+
+// listen registers interest in opcodes BEFORE the request is sent, so a fast reply isn't missed.
+func (s *service) listen(ops ...uint32) chan packet {
+	ch := make(chan packet, 32)
+	set := map[uint32]bool{}
+	for _, op := range ops {
+		set[op] = true
+	}
+	s.mu.Lock()
+	s.waiters[ch] = set
+	s.mu.Unlock()
+	return ch
+}
+
+func (s *service) unlisten(ch chan packet) {
+	s.mu.Lock()
+	delete(s.waiters, ch)
+	s.mu.Unlock()
+}
+
+// await returns the first packet on ch, or ok=false on timeout.
+func await(ctx context.Context, ch chan packet, d time.Duration) (packet, bool) {
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case p := <-ch:
+		return p, true
+	case <-t.C:
+	case <-ctx.Done():
+	}
+	return packet{}, false
+}
+
+func (s *service) clock(ctx context.Context) uint32 {
+	c, err := s.session.GetClock(ctx, &emptypb.Empty{})
+	if err != nil {
+		return 0
+	}
+	return c.GetClientTimeMs()
+}
+
+func (s *service) event(ctx context.Context, e *interactv1.Event) {
+	e.ClientTimeMs = s.clock(ctx)
+	s.mu.Lock()
+	s.seq++
+	e.Seq = s.seq
+	s.events = append(s.events, e)
+	if len(s.events) > maxEvents {
+		s.events = s.events[len(s.events)-maxEvents:]
+	}
+	s.mu.Unlock()
+}
+
+// position asks the move module where we are (declared dependency).
+func (s *service) position(ctx context.Context) (*movev1.Position, error) {
+	req, _ := anypb.New(&emptypb.Empty{})
+	resp, err := s.session.InvokeModule(ctx, &modv1.InvokeModuleRequest{Module: "move", Method: "position", Request: req})
+	if err != nil {
+		return nil, err
+	}
+	var p movev1.Position
+	if err := resp.GetResult().UnmarshalTo(&p); err != nil {
+		return nil, err
+	}
+	return &p, nil
+}
+
+// resolve turns a Target into a GUID: the GUID itself, or the nearest visible object of entry.
+func (s *service) resolve(ctx context.Context, t *interactv1.Target) (uint64, error) {
+	if t.GetGuid() != 0 {
+		return t.GetGuid(), nil
+	}
+	if t.GetEntry() == 0 {
+		return 0, status.Error(codes.InvalidArgument, "target needs guid or entry")
+	}
+	q := wow.Query{Entry: t.GetEntry(), Limit: 1}
+	if p, err := s.position(ctx); err == nil && p.GetKnown() {
+		q.HasCenter, q.X, q.Y, q.Z = true, p.GetX(), p.GetY(), p.GetZ()
+	}
+	hits := s.store.Find(q)
+	if len(hits) == 0 {
+		return 0, status.Errorf(codes.NotFound, "no visible object with entry %d", t.GetEntry())
+	}
+	return hits[0].GUID, nil
+}
+
+// -- packets from the server ----------------------------------------------------------------------
+
+func (s *service) OnPacket(ctx context.Context, p *modv1.WorldPacket) (*emptypb.Empty, error) {
+	op, payload := p.GetOpcode(), p.GetPayload()
+	switch op {
+	case opcode.SMSGCompressedUpdateObject:
+		plain, err := wow.DecompressUpdate(payload)
+		if err != nil {
+			fmt.Fprintln(os.Stderr, "compressed update:", err)
+			break
+		}
+		s.applyUpdate(plain)
+	case opcode.SMSGUpdateObject:
+		s.applyUpdate(payload)
+	case opcode.SMSGDestroyObject:
+		r := wow.NewReader(payload)
+		if g := r.U64(); r.Err() == nil {
+			s.store.Destroy(g)
+		}
+	case opcode.SMSGMonsterMove:
+		r := wow.NewReader(payload)
+		g := r.PackedGUID()
+		r.U8()
+		x, y, z := r.F32(), r.F32(), r.F32()
+		if r.Err() == nil {
+			s.store.Move(g, x, y, z)
+		}
+	case opcode.SMSGNewWorld:
+		s.store.Reset()
+	case opcode.SMSGQuestupdateAddKill:
+		r := wow.NewReader(payload)
+		e := &interactv1.Event{Kind: "quest_kill", QuestId: r.U32(), Entry: r.U32(), Count: r.U32(), Required: r.U32()}
+		if r.Err() == nil {
+			s.event(ctx, e)
+		}
+	case opcode.SMSGQuestupdateAddItem:
+		s.event(ctx, &interactv1.Event{Kind: "quest_item"})
+	case opcode.SMSGQuestupdateComplete:
+		r := wow.NewReader(payload)
+		s.event(ctx, &interactv1.Event{Kind: "quest_complete", QuestId: r.U32()})
+	case opcode.SMSGQuestgiverQuestComplete:
+		r := wow.NewReader(payload)
+		s.event(ctx, &interactv1.Event{Kind: "quest_reward", QuestId: r.U32(), Count: r.U32()}) // count = XP
+	case opcode.SMSGQuestgiverQuestFailed:
+		r := wow.NewReader(payload)
+		s.event(ctx, &interactv1.Event{Kind: "quest_failed", QuestId: r.U32(), Count: r.U32()})
+	case opcode.SMSGQuestgiverQuestInvalid:
+		r := wow.NewReader(payload)
+		s.event(ctx, &interactv1.Event{Kind: "quest_invalid", Count: r.U32()})
+	case opcode.SMSGItemPushResult:
+		r := wow.NewReader(payload)
+		r.U64()            // player
+		r.U32()            // received (0 looted, 1 from npc)
+		created := r.U32() // 0 received, 1 created
+		r.U32()            // show in chat
+		r.U8()             // bag
+		r.U32()            // slot
+		item := r.U32()
+		r.U32() // suffix factor
+		r.U32() // random property
+		count := r.U32()
+		total := r.U32()
+		if r.Err() == nil {
+			s.event(ctx, &interactv1.Event{Kind: "item", Entry: item, Count: count, Required: total,
+				Text: map[uint32]string{0: "received", 1: "created"}[created]})
+			s.mu.Lock()
+			s.pushes = append(s.pushes, &interactv1.LootItem{ItemId: item, Count: count})
+			s.mu.Unlock()
+		}
+	}
+	// hand the packet to anyone waiting for it
+	s.mu.Lock()
+	for ch, set := range s.waiters {
+		if set[op] {
+			select {
+			case ch <- packet{op, payload}:
+			default:
+			}
+		}
+	}
+	s.mu.Unlock()
+	return &emptypb.Empty{}, nil
+}
+
+func (s *service) applyUpdate(payload []byte) {
+	blocks, err := wow.ParseUpdate(payload)
+	s.store.Apply(blocks)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "update object:", err)
+	}
+}
+
+// -- RPCs: objects --------------------------------------------------------------------------------
+
+func toWorldObject(h wow.Hit) *interactv1.WorldObject {
+	o := &interactv1.WorldObject{Guid: h.GUID, Entry: h.Entry(), Type: uint32(h.Type), X: h.X, Y: h.Y, Z: h.Z, Distance: h.Distance}
+	switch h.Type {
+	case wow.TypeUnit, wow.TypePlayer:
+		o.Health, o.NpcFlags, o.DynFlags = h.Values[wow.FieldUnitHealth], h.Values[wow.FieldUnitNPCFlags], h.Values[wow.FieldUnitDynFlags]
+	case wow.TypeGameObject:
+		b := h.Values[wow.FieldGOBytes1]
+		o.GoState, o.GoType, o.DynFlags = b&0xFF, (b>>8)&0xFF, h.Values[wow.FieldGODynamic]
+	}
+	return o
+}
+
+func (s *service) Find(ctx context.Context, req *interactv1.FindRequest) (*interactv1.FindResult, error) {
+	q := wow.Query{Entry: req.GetEntry(), Type: uint8(req.GetType()), Radius: req.GetRadius(), Limit: int(req.GetLimit())}
+	if q.Limit == 0 {
+		q.Limit = 50
+	}
+	if p, err := s.position(ctx); err == nil && p.GetKnown() {
+		q.HasCenter, q.X, q.Y, q.Z = true, p.GetX(), p.GetY(), p.GetZ()
+	}
+	out := &interactv1.FindResult{}
+	for _, h := range s.store.Find(q) {
+		out.Objects = append(out.Objects, toWorldObject(h))
+	}
+	return out, nil
+}
+
+func (s *service) GetQuestLog(context.Context, *emptypb.Empty) (*interactv1.QuestLog, error) {
+	out := &interactv1.QuestLog{}
+	for _, e := range s.store.QuestLog() {
+		out.Entries = append(out.Entries, &interactv1.QuestLogEntry{QuestId: e.QuestID, State: e.State, Slot: uint32(e.Slot),
+			Counts: []uint32{uint32(e.Counts[0]), uint32(e.Counts[1]), uint32(e.Counts[2]), uint32(e.Counts[3])}})
+	}
+	return out, nil
+}
+
+func (s *service) GetEvents(_ context.Context, req *interactv1.EventsRequest) (*interactv1.Events, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := &interactv1.Events{Last: s.seq}
+	for _, e := range s.events {
+		if e.GetSeq() > req.GetSince() {
+			out.Events = append(out.Events, e)
+		}
+	}
+	return out, nil
+}
+
+// -- RPCs: gossip and quests ----------------------------------------------------------------------
+
+var menuOps = []uint32{opcode.SMSGGossipMessage, opcode.SMSGQuestgiverQuestList, opcode.SMSGGossipComplete,
+	opcode.SMSGQuestgiverQuestDetails, opcode.SMSGQuestgiverOfferReward, opcode.SMSGQuestgiverRequestItems}
+
+// parseMenu decodes the window the server opened. Unknown kinds are reported by name.
+func parseMenu(p packet) *interactv1.Menu {
+	r := wow.NewReader(p.payload)
+	switch p.op {
+	case opcode.SMSGGossipMessage: // PlayerMenu::SendGossipMenu
+		m := &interactv1.Menu{Kind: "gossip", Guid: r.U64(), MenuId: r.U32(), TextId: r.U32()}
+		n := r.U32()
+		for i := uint32(0); i < n && r.Err() == nil; i++ {
+			o := &interactv1.GossipOption{Id: r.U32(), Icon: uint32(r.U8()), Coded: r.U8() != 0}
+			r.U32() // box money
+			o.Text = r.CString()
+			r.CString() // box text
+			m.Options = append(m.Options, o)
+		}
+		n = r.U32()
+		for i := uint32(0); i < n && r.Err() == nil; i++ {
+			q := &interactv1.GossipQuest{Id: r.U32(), Icon: r.U32(), Level: int32(r.U32())}
+			r.U32() // flags
+			r.U8()  // repeatable
+			q.Title = r.CString()
+			m.Quests = append(m.Quests, q)
+		}
+		return m
+	case opcode.SMSGQuestgiverQuestList: // PlayerMenu::SendQuestGiverQuestList
+		m := &interactv1.Menu{Kind: "quest_list", Guid: r.U64(), Title: r.CString()}
+		r.U32() // emote delay
+		r.U32() // emote
+		n := r.U8()
+		for i := uint8(0); i < n && r.Err() == nil; i++ {
+			q := &interactv1.GossipQuest{Id: r.U32(), Icon: r.U32(), Level: int32(r.U32())}
+			r.U32()
+			r.U8()
+			q.Title = r.CString()
+			m.Quests = append(m.Quests, q)
+		}
+		return m
+	case opcode.SMSGQuestgiverQuestDetails:
+		return &interactv1.Menu{Kind: "quest_details", Guid: r.U64()}
+	case opcode.SMSGQuestgiverOfferReward:
+		return &interactv1.Menu{Kind: "offer_reward", Guid: r.U64()}
+	case opcode.SMSGQuestgiverRequestItems:
+		return &interactv1.Menu{Kind: "request_items", Guid: r.U64()}
+	case opcode.SMSGGossipComplete:
+		return &interactv1.Menu{Kind: "closed"}
+	}
+	return &interactv1.Menu{Kind: "none"}
+}
+
+func (s *service) openMenu(ctx context.Context, op uint32, guid uint64) (*interactv1.Menu, error) {
+	ch := s.listen(menuOps...)
+	defer s.unlisten(ch)
+	var w wow.Writer
+	w.U64(guid)
+	if err := s.send(ctx, op, &w); err != nil {
+		return nil, err
+	}
+	p, ok := await(ctx, ch, replyTimeout)
+	if !ok {
+		return &interactv1.Menu{Kind: "none", Guid: guid}, nil
+	}
+	return parseMenu(p), nil
+}
+
+func (s *service) GossipHello(ctx context.Context, t *interactv1.Target) (*interactv1.Menu, error) {
+	guid, err := s.resolve(ctx, t)
+	if err != nil {
+		return nil, err
+	}
+	return s.openMenu(ctx, opcode.CMSGGossipHello, guid)
+}
+
+func (s *service) QuestHello(ctx context.Context, t *interactv1.Target) (*interactv1.Menu, error) {
+	guid, err := s.resolve(ctx, t)
+	if err != nil {
+		return nil, err
+	}
+	return s.openMenu(ctx, opcode.CMSGQuestgiverHello, guid)
+}
+
+func (s *service) GossipSelect(ctx context.Context, req *interactv1.SelectRequest) (*interactv1.Menu, error) {
+	guid, err := s.resolve(ctx, req.GetTarget())
+	if err != nil {
+		return nil, err
+	}
+	ch := s.listen(menuOps...)
+	defer s.unlisten(ch)
+	var w wow.Writer
+	w.U64(guid)
+	w.U32(req.GetMenuId())
+	w.U32(req.GetOption())
+	if req.GetCode() != "" {
+		w.CString(req.GetCode())
+	}
+	if err := s.send(ctx, opcode.CMSGGossipSelectOption, &w); err != nil {
+		return nil, err
+	}
+	p, ok := await(ctx, ch, replyTimeout)
+	if !ok {
+		return &interactv1.Menu{Kind: "none", Guid: guid}, nil
+	}
+	return parseMenu(p), nil
+}
+
+func (s *service) inLog(questID uint32) bool {
+	for _, e := range s.store.QuestLog() {
+		if e.QuestID == questID {
+			return true
+		}
+	}
+	return false
+}
+
+// QuestAccept sends CMSG_QUESTGIVER_ACCEPT_QUEST (the server checks giver relation and range
+// itself) and waits for the quest to appear in our quest log, or for an invalid/failed reply.
+func (s *service) QuestAccept(ctx context.Context, req *interactv1.QuestRequest) (*interactv1.QuestResult, error) {
+	guid, err := s.resolve(ctx, req.GetTarget())
+	if err != nil {
+		return nil, err
+	}
+	if s.inLog(req.GetQuestId()) {
+		return &interactv1.QuestResult{Ok: true, Detail: "already in quest log"}, nil
+	}
+	ch := s.listen(opcode.SMSGQuestgiverQuestInvalid, opcode.SMSGQuestgiverQuestFailed, opcode.SMSGUpdateObject,
+		opcode.SMSGCompressedUpdateObject)
+	defer s.unlisten(ch)
+	var w wow.Writer
+	w.U64(guid)
+	w.U32(req.GetQuestId())
+	w.U32(0) // unk1
+	if err := s.send(ctx, opcode.CMSGQuestgiverAcceptQuest, &w); err != nil {
+		return nil, err
+	}
+	deadline := time.Now().Add(replyTimeout)
+	for time.Now().Before(deadline) {
+		p, ok := await(ctx, ch, time.Until(deadline))
+		if !ok {
+			break
+		}
+		switch p.op {
+		case opcode.SMSGQuestgiverQuestInvalid:
+			r := wow.NewReader(p.payload)
+			return &interactv1.QuestResult{Detail: fmt.Sprintf("invalid (QuestFailedReason %d)", r.U32())}, nil
+		case opcode.SMSGQuestgiverQuestFailed:
+			r := wow.NewReader(p.payload)
+			r.U32()
+			return &interactv1.QuestResult{Detail: fmt.Sprintf("failed (reason %d)", r.U32())}, nil
+		}
+		if s.inLog(req.GetQuestId()) { // the store applied this update before we were woken
+			return &interactv1.QuestResult{Ok: true, Detail: "accepted"}, nil
+		}
+	}
+	if s.inLog(req.GetQuestId()) {
+		return &interactv1.QuestResult{Ok: true, Detail: "accepted"}, nil
+	}
+	return &interactv1.QuestResult{Detail: "timeout (not in quest log; giver out of range or quest not offered?)"}, nil
+}
+
+// QuestComplete walks the turn-in dialogue: COMPLETE_QUEST -> (REQUEST_ITEMS -> REQUEST_REWARD)
+// -> OFFER_REWARD -> CHOOSE_REWARD -> SMSG_QUESTGIVER_QUEST_COMPLETE.
+func (s *service) QuestComplete(ctx context.Context, req *interactv1.QuestRequest) (*interactv1.QuestResult, error) {
+	guid, err := s.resolve(ctx, req.GetTarget())
+	if err != nil {
+		return nil, err
+	}
+	qid := req.GetQuestId()
+	ch := s.listen(opcode.SMSGQuestgiverRequestItems, opcode.SMSGQuestgiverOfferReward, opcode.SMSGQuestgiverQuestComplete,
+		opcode.SMSGQuestgiverQuestInvalid, opcode.SMSGQuestgiverQuestFailed, opcode.SMSGGossipComplete)
+	defer s.unlisten(ch)
+	var w wow.Writer
+	w.U64(guid)
+	w.U32(qid)
+	if err := s.send(ctx, opcode.CMSGQuestgiverCompleteQuest, &w); err != nil {
+		return nil, err
+	}
+	res := &interactv1.QuestResult{}
+	deadline := time.Now().Add(2 * replyTimeout)
+	for {
+		p, ok := await(ctx, ch, time.Until(deadline))
+		if !ok {
+			res.Detail = "timeout"
+			return res, nil
+		}
+		r := wow.NewReader(p.payload)
+		switch p.op {
+		case opcode.SMSGQuestgiverRequestItems:
+			// the "Continue" button: ask for the reward window
+			var w wow.Writer
+			w.U64(guid)
+			w.U32(qid)
+			if err := s.send(ctx, opcode.CMSGQuestgiverRequestReward, &w); err != nil {
+				return nil, err
+			}
+		case opcode.SMSGQuestgiverOfferReward: // PlayerMenu::SendQuestGiverOfferReward
+			r.U64()
+			r.U32() // quest
+			r.CString()
+			r.CString()
+			r.U8()  // auto finish
+			r.U32() // flags
+			r.U32() // suggested players
+			emotes := r.U32()
+			r.Skip(int(emotes) * 8)
+			choices := r.U32()
+			for i := uint32(0); i < choices && r.Err() == nil; i++ {
+				res.ChoiceItems = append(res.ChoiceItems, r.U32())
+				r.Skip(8)
+			}
+			var w wow.Writer
+			w.U64(guid)
+			w.U32(qid)
+			w.U32(req.GetReward())
+			if err := s.send(ctx, opcode.CMSGQuestgiverChooseReward, &w); err != nil {
+				return nil, err
+			}
+		case opcode.SMSGQuestgiverQuestComplete:
+			if id := r.U32(); id == qid {
+				res.Ok, res.Detail = true, "completed"
+				return res, nil
+			}
+		case opcode.SMSGQuestgiverQuestInvalid:
+			res.Detail = fmt.Sprintf("invalid (QuestFailedReason %d)", r.U32())
+			return res, nil
+		case opcode.SMSGQuestgiverQuestFailed:
+			r.U32()
+			res.Detail = fmt.Sprintf("failed (reason %d)", r.U32())
+			return res, nil
+		case opcode.SMSGGossipComplete:
+			res.Detail = "window closed by server (objectives incomplete?)"
+			return res, nil
+		}
+	}
+}
+
+// -- RPCs: game objects and loot ------------------------------------------------------------------
+
+// parseLoot reads SMSG_LOOT_RESPONSE: guid, loot type, then LootView (gold, count, items) - or,
+// for loot type 0 (LOOT_NONE), an error byte.
+func parseLoot(payload []byte, res *interactv1.LootResult) {
+	r := wow.NewReader(payload)
+	r.U64()
+	if lootType := r.U8(); lootType == 0 {
+		res.Detail = fmt.Sprintf("loot error %d", r.U8())
+		return
+	}
+	res.Opened = true
+	res.Gold = r.U32()
+	n := r.U8()
+	for i := uint8(0); i < n && r.Err() == nil; i++ {
+		it := &interactv1.LootItem{Slot: uint32(r.U8()), ItemId: r.U32(), Count: r.U32()}
+		r.Skip(12) // display id, random suffix, random property
+		r.U8()     // slot type
+		res.Items = append(res.Items, it)
+	}
+}
+
+// takeAll empties an open loot window: each item, the money, then release.
+func (s *service) takeAll(ctx context.Context, guid uint64, res *interactv1.LootResult) error {
+	for _, it := range res.Items {
+		var w wow.Writer
+		w.U8(uint8(it.GetSlot()))
+		if err := s.send(ctx, opcode.CMSGAutostoreLootItem, &w); err != nil {
+			return err
+		}
+	}
+	if res.GetGold() > 0 {
+		if err := s.send(ctx, opcode.CMSGLootMoney, nil); err != nil {
+			return err
+		}
+	}
+	time.Sleep(500 * time.Millisecond) // let the item pushes arrive before release
+	var w wow.Writer
+	w.U64(guid)
+	if err := s.send(ctx, opcode.CMSGLootRelease, &w); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	res.Received = append(res.Received, s.pushes...)
+	s.mu.Unlock()
+	if res.Detail == "" {
+		res.Detail = "looted"
+	}
+	return nil
+}
+
+// lootWith runs trigger (a GO use, a cast or CMSG_LOOT) and handles the loot window it opens.
+func (s *service) lootWith(ctx context.Context, guid uint64, trigger func() error, lootAll bool, wait time.Duration) (*interactv1.LootResult, error) {
+	s.mu.Lock()
+	s.pushes = nil
+	s.mu.Unlock()
+	ch := s.listen(opcode.SMSGLootResponse)
+	defer s.unlisten(ch)
+	if err := trigger(); err != nil {
+		return nil, err
+	}
+	res := &interactv1.LootResult{}
+	p, ok := await(ctx, ch, wait)
+	if !ok {
+		res.Detail = "no loot window"
+		s.mu.Lock()
+		res.Received = append(res.Received, s.pushes...) // a GO use can push an item without a window
+		s.mu.Unlock()
+		return res, nil
+	}
+	parseLoot(p.payload, res)
+	if res.GetOpened() && lootAll {
+		if err := s.takeAll(ctx, guid, res); err != nil {
+			return nil, err
+		}
+	}
+	return res, nil
+}
+
+// Use sends CMSG_GAMEOBJ_USE (plus GAMEOBJ_REPORT_USE, as the client does) and reports any loot
+// window it opens.
+func (s *service) Use(ctx context.Context, req *interactv1.UseRequest) (*interactv1.LootResult, error) {
+	guid, err := s.resolve(ctx, req.GetTarget())
+	if err != nil {
+		return nil, err
+	}
+	if spell := req.GetSpellId(); spell != 0 {
+		trigger := func() error {
+			res, err := s.cast(ctx, spell, guid, targetGO, 12*time.Second)
+			if err == nil && !res.GetOk() {
+				err = status.Errorf(codes.Aborted, "cast %d at GO failed: %s", spell, res.GetDetail())
+			}
+			return err
+		}
+		return s.lootWith(ctx, guid, trigger, req.GetLootAll(), replyTimeout)
+	}
+	var w wow.Writer
+	w.U64(guid)
+	defer func() { _ = s.send(context.Background(), opcode.CMSGGameobjReportUse, &w) }()
+	trigger := func() error { return s.send(ctx, opcode.CMSGGameobjUse, &w) }
+	return s.lootWith(ctx, guid, trigger, req.GetLootAll(), replyTimeout)
+}
+
+// Loot opens a corpse or object's loot (CMSG_LOOT).
+func (s *service) Loot(ctx context.Context, req *interactv1.UseRequest) (*interactv1.LootResult, error) {
+	guid, err := s.resolve(ctx, req.GetTarget())
+	if err != nil {
+		return nil, err
+	}
+	var w wow.Writer
+	w.U64(guid)
+	return s.lootWith(ctx, guid, func() error { return s.send(ctx, opcode.CMSGLoot, &w) }, true, replyTimeout)
+}
+
+// -- RPCs: spells ---------------------------------------------------------------------------------
+
+const (
+	targetNone = iota
+	targetUnit
+	targetGO
+	targetFlagUnit       = 0x00000002 // TARGET_FLAG_UNIT
+	targetFlagGameObject = 0x00000800 // TARGET_FLAG_GAMEOBJECT
+)
+
+func (s *service) Cast(ctx context.Context, req *interactv1.CastRequest) (*interactv1.CastResult, error) {
+	kind, guid := targetNone, uint64(0)
+	if req.GetTarget() != nil && (req.GetTarget().GetGuid() != 0 || req.GetTarget().GetEntry() != 0) {
+		g, err := s.resolve(ctx, req.GetTarget())
+		if err != nil {
+			return nil, err
+		}
+		guid, kind = g, targetUnit
+		if req.GetTargetKind() == "go" {
+			kind = targetGO
+		}
+	}
+	if req.GetTargetKind() == "self" {
+		kind, guid = targetUnit, s.store.Self()
+	}
+	wait := 12 * time.Second
+	if req.GetTimeoutMs() > 0 {
+		wait = time.Duration(req.GetTimeoutMs()) * time.Millisecond
+	}
+	return s.cast(ctx, req.GetSpellId(), guid, kind, wait)
+}
+
+// cast sends CMSG_CAST_SPELL (castCount u8, spell u32, castFlags u8, SpellCastTargets) and waits
+// for our SMSG_SPELL_GO, or SMSG_CAST_FAILED / SMSG_SPELL_FAILURE for the same spell.
+func (s *service) cast(ctx context.Context, spell uint32, guid uint64, kind int, wait time.Duration) (*interactv1.CastResult, error) {
+	s.mu.Lock()
+	s.castCount++
+	count := s.castCount
+	s.mu.Unlock()
+	ch := s.listen(opcode.SMSGSpellGo, opcode.SMSGCastFailed, opcode.SMSGSpellFailure)
+	defer s.unlisten(ch)
+	var w wow.Writer
+	w.U8(count)
+	w.U32(spell)
+	w.U8(0) // cast flags
+	switch kind {
+	case targetUnit:
+		w.U32(targetFlagUnit)
+		w.PackedGUID(guid)
+	case targetGO:
+		w.U32(targetFlagGameObject)
+		w.PackedGUID(guid)
+	default:
+		w.U32(0)
+	}
+	if err := s.send(ctx, opcode.CMSGCastSpell, &w); err != nil {
+		return nil, err
+	}
+	self := s.store.Self()
+	deadline := time.Now().Add(wait)
+	for {
+		p, ok := await(ctx, ch, time.Until(deadline))
+		if !ok {
+			return &interactv1.CastResult{Detail: "timeout"}, nil
+		}
+		r := wow.NewReader(p.payload)
+		switch p.op {
+		case opcode.SMSGSpellGo:
+			r.PackedGUID() // item or caster
+			caster := r.PackedGUID()
+			r.U8()
+			if id := r.U32(); id == spell && (self == 0 || caster == self) {
+				return &interactv1.CastResult{Ok: true, Detail: "spell_go"}, nil
+			}
+		case opcode.SMSGCastFailed:
+			r.U8()
+			if id := r.U32(); id == spell {
+				return &interactv1.CastResult{Detail: fmt.Sprintf("cast_failed result %d", r.U8())}, nil
+			}
+		case opcode.SMSGSpellFailure:
+			caster := r.PackedGUID()
+			r.U8()
+			if id := r.U32(); id == spell && (self == 0 || caster == self) {
+				return &interactv1.CastResult{Detail: fmt.Sprintf("interrupted result %d", r.U8())}, nil
+			}
+		}
+	}
+}
