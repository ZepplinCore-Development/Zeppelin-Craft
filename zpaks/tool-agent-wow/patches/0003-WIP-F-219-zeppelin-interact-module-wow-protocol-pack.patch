diff --git a/zeppelin/wow/objects.go b/zeppelin/wow/objects.go
new file mode 100644
index 0000000..99ebf61
--- /dev/null
+++ b/zeppelin/wow/objects.go
@@ -0,0 +1,227 @@
+package wow
+
+import (
+	"math"
+	"sort"
+	"sync"
+)
+
+// Update field indices (UpdateFields.h, 3.3.5a).
+const (
+	FieldEntry          = 0x0003
+	objectEnd           = 0x0006
+	FieldUnitHealth     = objectEnd + 0x0012
+	FieldUnitMaxHealth  = objectEnd + 0x001A
+	FieldUnitLevel      = objectEnd + 0x0030
+	FieldUnitFaction    = objectEnd + 0x0031
+	FieldUnitFlags      = objectEnd + 0x0035
+	FieldUnitDynFlags   = objectEnd + 0x0049
+	FieldUnitNPCFlags   = objectEnd + 0x004C
+	unitEnd             = objectEnd + 0x008E
+	FieldPlayerQuestLog = unitEnd + 0x000A // 25 entries x 5 fields: id, state, counts(2), timer
+	questLogEntries     = 25
+	questLogStride      = 5
+	FieldGODisplayID    = objectEnd + 0x0002
+	FieldGOFlags        = objectEnd + 0x0003
+	FieldGODynamic      = objectEnd + 0x0008
+	FieldGOBytes1       = objectEnd + 0x000B // state, type, artkit, animprogress
+	UnitDynFlagLootable = 0x0001
+	UnitDynFlagTapped   = 0x0004
+)
+
+// Object is what the store knows about one world object.
+type Object struct {
+	GUID    uint64
+	Type    uint8
+	X, Y, Z float32
+	O       float32
+	HasPos  bool
+	Values  map[uint16]uint32
+}
+
+func (o *Object) Entry() uint32 { return o.Values[FieldEntry] }
+
+// QuestLogEntry is one used slot of the player's quest log (PLAYER_QUEST_LOG_n_*).
+type QuestLogEntry struct {
+	QuestID uint32
+	State   uint32
+	Counts  [4]uint16 // creature/GO objective counters
+	Slot    int
+}
+
+// Store tracks objects from update packets. Safe for concurrent use.
+type Store struct {
+	mu      sync.RWMutex
+	objects map[uint64]*Object
+	self    uint64
+}
+
+func NewStore() *Store { return &Store{objects: map[uint64]*Object{}} }
+
+// Apply merges decoded update blocks into the store.
+func (s *Store) Apply(blocks []Block) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for _, b := range blocks {
+		switch b.Type {
+		case UpdateCreateObject, UpdateCreateObject2:
+			o := &Object{GUID: b.GUID, Type: b.ObjType, Values: map[uint16]uint32{}}
+			if old, ok := s.objects[b.GUID]; ok && old.Type == b.ObjType {
+				o = old // re-create after phase/visibility change: keep, then overwrite
+			}
+			if b.HasPos {
+				o.X, o.Y, o.Z, o.O, o.HasPos = b.X, b.Y, b.Z, b.O, true
+			}
+			for k, v := range b.Values {
+				o.Values[k] = v
+			}
+			s.objects[b.GUID] = o
+			if b.Self {
+				s.self = b.GUID
+			}
+		case UpdateValues:
+			if o, ok := s.objects[b.GUID]; ok {
+				for k, v := range b.Values {
+					o.Values[k] = v
+				}
+			}
+		case UpdateMovement:
+			if o, ok := s.objects[b.GUID]; ok && b.HasPos {
+				o.X, o.Y, o.Z, o.O, o.HasPos = b.X, b.Y, b.Z, b.O, true
+			}
+		case UpdateOutOfRange:
+			for _, g := range b.GUIDs {
+				if g != s.self {
+					delete(s.objects, g)
+				}
+			}
+		}
+	}
+}
+
+// Destroy removes an object (SMSG_DESTROY_OBJECT).
+func (s *Store) Destroy(guid uint64) {
+	s.mu.Lock()
+	delete(s.objects, guid)
+	s.mu.Unlock()
+}
+
+// Move updates a unit's position from a movement broadcast (MSG_MOVE_* / SMSG_MONSTER_MOVE).
+func (s *Store) Move(guid uint64, x, y, z float32) {
+	s.mu.Lock()
+	if o, ok := s.objects[guid]; ok {
+		o.X, o.Y, o.Z, o.HasPos = x, y, z, true
+	}
+	s.mu.Unlock()
+}
+
+// Reset forgets everything (map change: the server re-sends what is visible).
+func (s *Store) Reset() {
+	s.mu.Lock()
+	self := s.objects[s.self]
+	s.objects = map[uint64]*Object{}
+	if self != nil {
+		s.objects[self.GUID] = self
+	}
+	s.mu.Unlock()
+}
+
+func (s *Store) Self() uint64 {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	return s.self
+}
+
+// Get returns a copy of one object.
+func (s *Store) Get(guid uint64) (Object, bool) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	o, ok := s.objects[guid]
+	if !ok {
+		return Object{}, false
+	}
+	return copyObject(o), true
+}
+
+func copyObject(o *Object) Object {
+	c := *o
+	c.Values = make(map[uint16]uint32, len(o.Values))
+	for k, v := range o.Values {
+		c.Values[k] = v
+	}
+	return c
+}
+
+// Query filters objects; zero fields match everything. Results are sorted by distance to
+// (X,Y,Z) when HasCenter, else by GUID.
+type Query struct {
+	Entry     uint32
+	Type      uint8 // 0 = any
+	HasCenter bool
+	X, Y, Z   float32
+	Radius    float32 // 0 = unlimited
+	Limit     int
+}
+
+type Hit struct {
+	Object
+	Distance float32
+}
+
+func (s *Store) Find(q Query) []Hit {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	var out []Hit
+	for _, o := range s.objects {
+		if o.GUID == s.self {
+			continue
+		}
+		if q.Type != 0 && o.Type != q.Type {
+			continue
+		}
+		if q.Entry != 0 && o.Entry() != q.Entry {
+			continue
+		}
+		h := Hit{Object: copyObject(o), Distance: -1}
+		if q.HasCenter && o.HasPos {
+			dx, dy, dz := float64(o.X-q.X), float64(o.Y-q.Y), float64(o.Z-q.Z)
+			h.Distance = float32(math.Sqrt(dx*dx + dy*dy + dz*dz))
+			if q.Radius > 0 && h.Distance > q.Radius {
+				continue
+			}
+		}
+		out = append(out, h)
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if q.HasCenter && out[i].Distance != out[j].Distance {
+			return out[i].Distance < out[j].Distance
+		}
+		return out[i].GUID < out[j].GUID
+	})
+	if q.Limit > 0 && len(out) > q.Limit {
+		out = out[:q.Limit]
+	}
+	return out
+}
+
+// QuestLog reads the played character's quest log from its own update fields.
+func (s *Store) QuestLog() []QuestLogEntry {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	me, ok := s.objects[s.self]
+	if !ok {
+		return nil
+	}
+	var out []QuestLogEntry
+	for i := 0; i < questLogEntries; i++ {
+		base := uint16(FieldPlayerQuestLog + i*questLogStride)
+		id := me.Values[base]
+		if id == 0 {
+			continue
+		}
+		c1, c2 := me.Values[base+2], me.Values[base+3]
+		out = append(out, QuestLogEntry{QuestID: id, State: me.Values[base+1], Slot: i,
+			Counts: [4]uint16{uint16(c1), uint16(c1 >> 16), uint16(c2), uint16(c2 >> 16)}})
+	}
+	return out
+}
diff --git a/zeppelin/wow/reader.go b/zeppelin/wow/reader.go
new file mode 100644
index 0000000..603e2e2
--- /dev/null
+++ b/zeppelin/wow/reader.go
@@ -0,0 +1,126 @@
+// Package wow holds Zeppelin's 3.3.5a (build 12340) protocol helpers for agent-wow modules
+// (F-219 Track A). Every layout here is taken from the AzerothCore writer that produces it;
+// the function comments name that writer.
+package wow
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"math"
+)
+
+// ErrShort is returned when a packet ends before a field it declares.
+var ErrShort = errors.New("packet too short")
+
+// Reader is a little-endian cursor over a packet payload. The first failure sticks: every later
+// read returns zero and Err() reports it, so parsers can read a run of fields and check once.
+type Reader struct {
+	b   []byte
+	off int
+	err error
+}
+
+func NewReader(b []byte) *Reader { return &Reader{b: b} }
+
+func (r *Reader) Err() error   { return r.err }
+func (r *Reader) Len() int     { return len(r.b) - r.off }
+func (r *Reader) Offset() int  { return r.off }
+func (r *Reader) Rest() []byte { return r.b[min(r.off, len(r.b)):] }
+
+func (r *Reader) take(n int) []byte {
+	if r.err != nil {
+		return nil
+	}
+	if n < 0 || r.off+n > len(r.b) {
+		r.err = ErrShort
+		return nil
+	}
+	out := r.b[r.off : r.off+n]
+	r.off += n
+	return out
+}
+
+func (r *Reader) U8() uint8 {
+	if b := r.take(1); b != nil {
+		return b[0]
+	}
+	return 0
+}
+
+func (r *Reader) U16() uint16 {
+	if b := r.take(2); b != nil {
+		return binary.LittleEndian.Uint16(b)
+	}
+	return 0
+}
+
+func (r *Reader) U32() uint32 {
+	if b := r.take(4); b != nil {
+		return binary.LittleEndian.Uint32(b)
+	}
+	return 0
+}
+
+func (r *Reader) U64() uint64 {
+	if b := r.take(8); b != nil {
+		return binary.LittleEndian.Uint64(b)
+	}
+	return 0
+}
+
+func (r *Reader) F32() float32 { return math.Float32frombits(r.U32()) }
+
+func (r *Reader) Skip(n int) { r.take(n) }
+
+// CString reads a NUL-terminated string (ByteBuffer << std::string).
+func (r *Reader) CString() string {
+	if r.err != nil {
+		return ""
+	}
+	i := bytes.IndexByte(r.b[r.off:], 0)
+	if i < 0 {
+		r.err = ErrShort
+		return ""
+	}
+	s := string(r.b[r.off : r.off+i])
+	r.off += i + 1
+	return s
+}
+
+// PackedGUID reads ObjectGuid::WriteAsPacked: a mask byte, then one byte per set bit.
+func (r *Reader) PackedGUID() uint64 {
+	mask := r.U8()
+	var g uint64
+	for i := 0; i < 8; i++ {
+		if mask&(1<<i) != 0 {
+			g |= uint64(r.U8()) << (8 * i)
+		}
+	}
+	return g
+}
+
+// Writer builds a little-endian client packet payload.
+type Writer struct{ bytes.Buffer }
+
+func (w *Writer) U8(v uint8)    { w.WriteByte(v) }
+func (w *Writer) U32(v uint32)  { _ = binary.Write(&w.Buffer, binary.LittleEndian, v) }
+func (w *Writer) U64(v uint64)  { _ = binary.Write(&w.Buffer, binary.LittleEndian, v) }
+func (w *Writer) F32(v float32) { w.U32(math.Float32bits(v)) }
+func (w *Writer) CString(s string) {
+	w.WriteString(s)
+	w.WriteByte(0)
+}
+
+// PackedGUID writes ObjectGuid::WriteAsPacked.
+func (w *Writer) PackedGUID(g uint64) {
+	mask, rest := byte(0), make([]byte, 0, 8)
+	for i := 0; i < 8; i++ {
+		if b := byte(g >> (8 * i)); b != 0 {
+			mask |= 1 << i
+			rest = append(rest, b)
+		}
+	}
+	w.WriteByte(mask)
+	w.Write(rest)
+}
diff --git a/zeppelin/wow/update.go b/zeppelin/wow/update.go
new file mode 100644
index 0000000..46f031d
--- /dev/null
+++ b/zeppelin/wow/update.go
@@ -0,0 +1,253 @@
+package wow
+
+import (
+	"bytes"
+	"compress/zlib"
+	"fmt"
+	"io"
+)
+
+// Update block types (UpdateType in UpdateData.h).
+const (
+	UpdateValues        = 0
+	UpdateMovement      = 1
+	UpdateCreateObject  = 2
+	UpdateCreateObject2 = 3
+	UpdateOutOfRange    = 4
+	UpdateNearObjects   = 5
+)
+
+// Object type ids (TypeID).
+const (
+	TypeObject     = 0
+	TypeItem       = 1
+	TypeContainer  = 2
+	TypeUnit       = 3
+	TypePlayer     = 4
+	TypeGameObject = 5
+	TypeDynObject  = 6
+	TypeCorpse     = 7
+)
+
+// Update flags (ObjectUpdateFlags).
+const (
+	updSelf               = 0x0001
+	updTransport          = 0x0002
+	updHasTarget          = 0x0004
+	updUnknown            = 0x0008
+	updLowGUID            = 0x0010
+	updLiving             = 0x0020
+	updStationaryPosition = 0x0040
+	updVehicle            = 0x0080
+	updPosition           = 0x0100
+	updRotation           = 0x0200
+)
+
+// Movement flags read inside a living movement block.
+const (
+	MoveFlagForward         = 0x00000001
+	moveFlagOnTransport     = 0x00000200
+	moveFlagFalling         = 0x00001000
+	moveFlagSwimming        = 0x00200000
+	moveFlagFlying          = 0x02000000
+	moveFlagSplineElevation = 0x04000000
+	moveFlagSplineEnabled   = 0x08000000
+	moveFlag2AlwaysPitch    = 0x00000020
+	moveFlag2Interpolated   = 0x00000400
+	splineFinalPoint        = 0x00008000
+	splineFinalTarget       = 0x00010000
+	splineFinalAngle        = 0x00020000
+)
+
+// Block is one entry of an SMSG_(COMPRESSED_)UPDATE_OBJECT.
+type Block struct {
+	Type    uint8
+	GUID    uint64
+	ObjType uint8 // create blocks only
+	Self    bool  // UPDATEFLAG_SELF: this is the player we are playing
+	HasPos  bool
+	Map     uint32
+	X, Y, Z float32
+	O       float32
+	Values  map[uint16]uint32 // field index -> raw 32-bit value (VALUES and CREATE blocks)
+	GUIDs   []uint64          // OUT_OF_RANGE / NEAR_OBJECTS
+}
+
+// DecompressUpdate turns an SMSG_COMPRESSED_UPDATE_OBJECT payload (u32 size + zlib) into the
+// plain SMSG_UPDATE_OBJECT payload.
+func DecompressUpdate(payload []byte) ([]byte, error) {
+	r := NewReader(payload)
+	size := r.U32()
+	if r.Err() != nil {
+		return nil, r.Err()
+	}
+	zr, err := zlib.NewReader(bytes.NewReader(r.Rest()))
+	if err != nil {
+		return nil, err
+	}
+	defer zr.Close()
+	out := make([]byte, 0, size)
+	buf := bytes.NewBuffer(out)
+	if _, err := io.Copy(buf, io.LimitReader(zr, int64(size)+1)); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+// ParseUpdate decodes an SMSG_UPDATE_OBJECT payload: u32 block count, then blocks. A block that
+// fails to parse stops the packet (there is no length to resync on); the blocks decoded before
+// it are returned together with the error.
+func ParseUpdate(payload []byte) ([]Block, error) {
+	r := NewReader(payload)
+	count := r.U32()
+	if r.Err() != nil {
+		return nil, r.Err()
+	}
+	out := make([]Block, 0, count)
+	for i := uint32(0); i < count; i++ {
+		b, err := parseBlock(r)
+		if err != nil {
+			return out, fmt.Errorf("block %d/%d (type %d): %w", i+1, count, b.Type, err)
+		}
+		out = append(out, b)
+	}
+	return out, nil
+}
+
+func parseBlock(r *Reader) (Block, error) {
+	b := Block{Type: r.U8()}
+	switch b.Type {
+	case UpdateValues:
+		b.GUID = r.PackedGUID()
+		b.Values = parseValues(r)
+	case UpdateMovement:
+		b.GUID = r.PackedGUID()
+		parseMovement(r, &b)
+	case UpdateCreateObject, UpdateCreateObject2:
+		b.GUID = r.PackedGUID()
+		b.ObjType = r.U8()
+		parseMovement(r, &b)
+		b.Values = parseValues(r)
+	case UpdateOutOfRange, UpdateNearObjects:
+		n := r.U32()
+		if n > 100000 {
+			return b, fmt.Errorf("implausible guid count %d", n)
+		}
+		for j := uint32(0); j < n && r.Err() == nil; j++ {
+			b.GUIDs = append(b.GUIDs, r.PackedGUID())
+		}
+	default:
+		return b, fmt.Errorf("unknown update type %d", b.Type)
+	}
+	return b, r.Err()
+}
+
+// parseValues reads Object::BuildValuesUpdate: u8 mask block count, the mask words, then one
+// u32 per set bit in index order.
+func parseValues(r *Reader) map[uint16]uint32 {
+	blocks := int(r.U8())
+	mask := make([]uint32, blocks)
+	for i := range mask {
+		mask[i] = r.U32()
+	}
+	vals := map[uint16]uint32{}
+	for i, word := range mask {
+		for bit := 0; bit < 32; bit++ {
+			if word&(1<<bit) != 0 {
+				vals[uint16(i*32+bit)] = r.U32()
+			}
+		}
+	}
+	return vals
+}
+
+// parseMovement reads Object::BuildMovementUpdate.
+func parseMovement(r *Reader, b *Block) {
+	flags := r.U16()
+	b.Self = flags&updSelf != 0
+	if flags&updLiving != 0 {
+		// Unit::BuildMovementPacket == WorldSession::WriteMovementInfo minus the guid
+		mf := r.U32()
+		mf2 := r.U16()
+		r.U32() // time
+		b.X, b.Y, b.Z, b.O, b.HasPos = r.F32(), r.F32(), r.F32(), r.F32(), true
+		if mf&moveFlagOnTransport != 0 {
+			r.PackedGUID()
+			r.Skip(4 * 4) // transport x y z o
+			r.U32()       // transport time
+			r.U8()        // seat
+			if mf2&moveFlag2Interpolated != 0 {
+				r.U32()
+			}
+		}
+		if mf&(moveFlagSwimming|moveFlagFlying) != 0 || mf2&moveFlag2AlwaysPitch != 0 {
+			r.F32() // pitch
+		}
+		r.U32() // fall time
+		if mf&moveFlagFalling != 0 {
+			r.Skip(4 * 4) // jump zspeed, sin, cos, xyspeed
+		}
+		if mf&moveFlagSplineElevation != 0 {
+			r.F32()
+		}
+		r.Skip(9 * 4) // walk run runback swim swimback flight flightback turn pitch
+		if mf&moveFlagSplineEnabled != 0 {
+			parseSpline(r)
+		}
+	} else if flags&updPosition != 0 {
+		r.PackedGUID() // transport
+		b.X, b.Y, b.Z = r.F32(), r.F32(), r.F32()
+		r.Skip(3 * 4) // transport offset or position again
+		b.O = r.F32()
+		r.F32() // corpse orientation / 0
+		b.HasPos = true
+	} else if flags&updStationaryPosition != 0 {
+		b.X, b.Y, b.Z, b.O, b.HasPos = r.F32(), r.F32(), r.F32(), r.F32(), true
+	}
+	if flags&updUnknown != 0 {
+		r.U32()
+	}
+	if flags&updLowGUID != 0 {
+		r.U32()
+	}
+	if flags&updHasTarget != 0 {
+		r.PackedGUID()
+	}
+	if flags&updTransport != 0 {
+		r.U32()
+	}
+	if flags&updVehicle != 0 {
+		r.U32()
+		r.F32()
+	}
+	if flags&updRotation != 0 {
+		r.U64()
+	}
+}
+
+// parseSpline reads Movement::PacketBuilder::WriteCreate.
+func parseSpline(r *Reader) {
+	sf := r.U32()
+	switch {
+	case sf&splineFinalAngle != 0:
+		r.F32()
+	case sf&splineFinalTarget != 0:
+		r.U64()
+	case sf&splineFinalPoint != 0:
+		r.Skip(3 * 4)
+	}
+	r.U32()       // time passed
+	r.U32()       // duration
+	r.U32()       // id
+	r.Skip(2 * 4) // duration mod, duration mod next
+	r.F32()       // vertical acceleration
+	r.U32()       // effect start time
+	nodes := r.U32()
+	if nodes > 10000 {
+		r.err = fmt.Errorf("implausible spline node count %d", nodes)
+		return
+	}
+	r.Skip(int(nodes) * 12)
+	r.U8()        // spline mode
+	r.Skip(3 * 4) // final destination
+}
diff --git a/zeppelin/wow/update_test.go b/zeppelin/wow/update_test.go
new file mode 100644
index 0000000..fac8331
--- /dev/null
+++ b/zeppelin/wow/update_test.go
@@ -0,0 +1,201 @@
+package wow
+
+import (
+	"bytes"
+	"compress/zlib"
+	"testing"
+)
+
+// values writes a values block with the given field -> value pairs (BuildValuesUpdate).
+func values(w *Writer, fields map[uint16]uint32) {
+	maxIdx := uint16(0)
+	for k := range fields {
+		if k > maxIdx {
+			maxIdx = k
+		}
+	}
+	blocks := int(maxIdx)/32 + 1
+	mask := make([]uint32, blocks)
+	for k := range fields {
+		mask[k/32] |= 1 << (k % 32)
+	}
+	w.U8(uint8(blocks))
+	for _, m := range mask {
+		w.U32(m)
+	}
+	for i := 0; i < blocks*32; i++ {
+		if v, ok := fields[uint16(i)]; ok {
+			w.U32(v)
+		}
+	}
+}
+
+// creature writes a CREATE_OBJECT2 for a moving unit with an active spline, as
+// Object::BuildMovementUpdate + PacketBuilder::WriteCreate produce it.
+func creature(w *Writer, guid uint64, entry uint32, x, y, z float32) {
+	w.U8(UpdateCreateObject2)
+	w.PackedGUID(guid)
+	w.U8(TypeUnit)
+	w.WriteByte(byte(updLiving | updLowGUID | updHasTarget))
+	w.WriteByte(0)
+	w.U32(MoveFlagForward | moveFlagSplineEnabled) // movement flags
+	w.WriteByte(0)                                 // flags2 (u16)
+	w.WriteByte(0)
+	w.U32(123456) // time
+	w.F32(x)
+	w.F32(y)
+	w.F32(z)
+	w.F32(1.5)
+	w.U32(0) // fall time
+	for i := 0; i < 9; i++ {
+		w.F32(2.5) // speeds
+	}
+	w.U32(splineFinalTarget) // spline flags
+	w.U64(0xF130000000000099)
+	w.U32(100)  // time passed
+	w.U32(2000) // duration
+	w.U32(7)    // id
+	w.F32(1)
+	w.F32(1)
+	w.F32(0)
+	w.U32(0)
+	w.U32(2) // nodes
+	for i := 0; i < 2*3; i++ {
+		w.F32(float32(i))
+	}
+	w.U8(0)
+	w.F32(9)
+	w.F32(9)
+	w.F32(9)
+	w.U32(0x0B) // low guid "unk"
+	w.U8(0)     // has target: empty packed guid
+	values(w, map[uint16]uint32{0: uint32(guid), 1: uint32(guid >> 32), 2: 9, FieldEntry: entry,
+		FieldUnitHealth: 55, FieldUnitNPCFlags: 0x3})
+}
+
+// gameObject writes a CREATE_OBJECT for a stationary GO with rotation.
+func gameObject(w *Writer, guid uint64, entry uint32, x, y, z float32) {
+	w.U8(UpdateCreateObject)
+	w.PackedGUID(guid)
+	w.U8(TypeGameObject)
+	f := uint16(updLowGUID | updStationaryPosition | updRotation)
+	w.WriteByte(byte(f))
+	w.WriteByte(byte(f >> 8))
+	w.F32(x)
+	w.F32(y)
+	w.F32(z)
+	w.F32(0.25)
+	w.U32(uint32(guid))
+	w.U64(0x1234)
+	values(w, map[uint16]uint32{FieldEntry: entry, FieldGOBytes1: 0x00030001})
+}
+
+func TestParseUpdateCreateValuesOutOfRange(t *testing.T) {
+	var w Writer
+	w.U32(4)
+	creature(&w, 0xF130000C2F000042, 3143, -600, -4200, 40)
+	gameObject(&w, 0xF110002A1F000010, 171938, -610, -4210, 41)
+	// partial values update: health only
+	w.U8(UpdateValues)
+	w.PackedGUID(0xF130000C2F000042)
+	values(&w, map[uint16]uint32{FieldUnitHealth: 10})
+	w.U8(UpdateOutOfRange)
+	w.U32(1)
+	w.PackedGUID(0xF110002A1F000010)
+
+	blocks, err := ParseUpdate(w.Bytes())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(blocks) != 4 {
+		t.Fatalf("blocks = %d", len(blocks))
+	}
+	c := blocks[0]
+	if c.GUID != 0xF130000C2F000042 || c.ObjType != TypeUnit || !c.HasPos || c.X != -600 || c.Values[FieldEntry] != 3143 {
+		t.Fatalf("creature block wrong: %+v", c)
+	}
+	g := blocks[1]
+	if g.ObjType != TypeGameObject || g.Y != -4210 || g.Values[FieldEntry] != 171938 {
+		t.Fatalf("GO block wrong: %+v", g)
+	}
+
+	s := NewStore()
+	s.Apply(blocks[:2])
+	if hits := s.Find(Query{Entry: 171938}); len(hits) != 1 {
+		t.Fatalf("GO not found: %v", hits)
+	}
+	s.Apply(blocks[2:])
+	o, ok := s.Get(0xF130000C2F000042)
+	if !ok || o.Values[FieldUnitHealth] != 10 || o.Values[FieldUnitNPCFlags] != 3 {
+		t.Fatalf("values merge wrong: %+v", o)
+	}
+	if hits := s.Find(Query{Entry: 171938}); len(hits) != 0 {
+		t.Fatalf("out-of-range GO still present")
+	}
+	hits := s.Find(Query{HasCenter: true, X: -600, Y: -4203, Z: 40, Radius: 5})
+	if len(hits) != 1 || hits[0].Distance < 2.9 || hits[0].Distance > 3.1 {
+		t.Fatalf("distance query wrong: %+v", hits)
+	}
+}
+
+func TestCompressedAndQuestLog(t *testing.T) {
+	var w Writer
+	w.U32(1)
+	w.U8(UpdateCreateObject2)
+	w.PackedGUID(814)
+	w.U8(TypePlayer)
+	f := uint16(updSelf | updLiving | updLowGUID)
+	w.WriteByte(byte(f))
+	w.WriteByte(byte(f >> 8))
+	w.U32(0)
+	w.WriteByte(0)
+	w.WriteByte(0)
+	w.U32(1)
+	w.F32(-618.5)
+	w.F32(-4251.6)
+	w.F32(38.7)
+	w.F32(0)
+	w.U32(0)
+	for i := 0; i < 9; i++ {
+		w.F32(7)
+	}
+	w.U32(0x2F)
+	values(&w, map[uint16]uint32{FieldEntry: 0, FieldPlayerQuestLog: 4641, FieldPlayerQuestLog + 1: 0,
+		FieldPlayerQuestLog + 2: 3 | 7<<16, FieldPlayerQuestLog + 5: 788})
+
+	var z bytes.Buffer
+	zw := zlib.NewWriter(&z)
+	zw.Write(w.Bytes())
+	zw.Close()
+	var c Writer
+	c.U32(uint32(w.Len()))
+	c.Write(z.Bytes())
+
+	plain, err := DecompressUpdate(c.Bytes())
+	if err != nil {
+		t.Fatal(err)
+	}
+	blocks, err := ParseUpdate(plain)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := NewStore()
+	s.Apply(blocks)
+	if s.Self() != 814 {
+		t.Fatalf("self = %d", s.Self())
+	}
+	log := s.QuestLog()
+	if len(log) != 2 || log[0].QuestID != 4641 || log[0].Counts[0] != 3 || log[0].Counts[1] != 7 || log[1].QuestID != 788 {
+		t.Fatalf("quest log wrong: %+v", log)
+	}
+}
+
+func TestTruncatedBlockReportsError(t *testing.T) {
+	var w Writer
+	w.U32(1)
+	creature(&w, 0xF130000C2F000042, 3143, 1, 2, 3)
+	b := w.Bytes()
+	if _, err := ParseUpdate(b[:len(b)-3]); err == nil {
+		t.Fatal("truncated packet parsed without error")
+	}
+}
