+// Face turns in place (MSG_MOVE_SET_FACING) toward a point or to an orientation.
+func (s *service) Face(ctx context.Context, req *movev1.FaceRequest) (*movev1.Position, error) {
+	p := s.snapshot()
+	if !p.GetKnown() {
+		return nil, status.Error(codes.FailedPrecondition, "position unknown (not in world yet)")
+	}
+	s.mu.Lock()
+	moving := s.moving
+	s.mu.Unlock()
+	if moving {
+		return p, nil // the walk sets its own facing
+	}
+	o := req.GetO()
+	if !req.GetUseO() {
+		o = float32(math.Mod(math.Atan2(float64(req.GetY()-p.GetY()), float64(req.GetX()-p.GetX()))+2*math.Pi, 2*math.Pi))
+	}
+	if err := s.sendMove(ctx, opcode.MSGMoveSetFacing, 0, p.GetX(), p.GetY(), p.GetZ(), o); err != nil {
+		return nil, err
+	}
+	s.setPosition(p.GetMap(), [4]float32{p.GetX(), p.GetY(), p.GetZ(), o}, false)
+	return s.snapshot(), nil
+}
