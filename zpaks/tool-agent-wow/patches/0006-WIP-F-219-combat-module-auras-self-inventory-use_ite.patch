diff --git a/zeppelin/modules/combat/combat.proto b/zeppelin/modules/combat/combat.proto
new file mode 100644
index 0000000..2fb94dc
--- /dev/null
+++ b/zeppelin/modules/combat/combat.proto
@@ -0,0 +1,78 @@
+syntax = "proto3";
+package zeppelin.combat.v1;
+option go_package = "github.com/agent-wow/agent-wow/zeppelin/modules/combat/api;combatv1";
+
+import "api/module/v1/session.proto";
+import "google/protobuf/empty.proto";
+
+// Ability is cast during a fight whenever it is off our own timer and we have the power.
+message Ability {
+  uint32 spell_id = 1;
+  uint32 every_ms = 2;   // minimum gap between casts of this ability
+  uint32 min_power = 3;  // rage/mana/energy needed (skip below)
+  bool on_self = 4;      // self-cast (shouts, buffs) instead of on the target
+  uint32 below_health_pct = 5; // 0 = always; else only while our health is below this %
+}
+
+message KillRequest {
+  uint64 guid = 1;       // target guid, or
+  uint32 entry = 2;      // nearest visible creature of this entry
+  repeated Ability abilities = 3;
+  bool loot = 4;         // loot the corpse when it dies
+  uint32 budget_ms = 5;  // 0 = 25 s (agent-wow caps a call at 30 s); call again while "budget"
+  float chase_limit = 6; // give up if the target gets further than this (yd); 0 = 60
+}
+
+message LootItem {
+  uint32 item_id = 1;
+  uint32 count = 2;
+}
+
+message KillResult {
+  bool killed = 1;
+  string reason = 2;     // killed, budget, target gone, too far, we died, no target
+  uint64 guid = 3;
+  uint32 entry = 4;
+  uint32 target_health = 5;
+  uint32 our_health = 6;
+  uint32 our_max_health = 7;
+  uint32 swings = 8;     // our melee hits/misses seen (SMSG_ATTACKERSTATEUPDATE)
+  uint32 damage_done = 9;
+  uint32 damage_taken = 10;
+  repeated LootItem loot = 11;
+  uint32 casts = 12;
+}
+
+message RestRequest {
+  uint32 until_pct = 1;  // 0 = 90
+  uint32 budget_ms = 2;  // 0 = 25 s
+}
+message RestResult {
+  bool done = 1;
+  string reason = 2;     // rested, budget, attacked
+  uint32 health = 3;
+  uint32 max_health = 4;
+}
+
+message ReviveResult {
+  bool alive = 1;
+  string stage = 2;      // alive, released, walking to corpse, waiting reclaim delay, reclaimed
+  float corpse_distance = 3;
+}
+
+message CombatState {
+  bool in_combat = 1;
+  repeated uint64 attackers = 2; // units that attacked us and are still alive and visible
+  uint64 target = 3;
+  bool dead = 4;
+  bool ghost = 5;
+}
+
+service Combat {
+  rpc Kill(KillRequest) returns (KillResult);
+  rpc Rest(RestRequest) returns (RestResult);
+  rpc Revive(google.protobuf.Empty) returns (ReviveResult);
+  rpc GetState(google.protobuf.Empty) returns (CombatState);
+  rpc OnPacket(agentwow.module.v1.WorldPacket) returns (google.protobuf.Empty);
+  rpc BeforeLogout(google.protobuf.Empty) returns (google.protobuf.Empty);
+}
diff --git a/zeppelin/modules/combat/main.go b/zeppelin/modules/combat/main.go
new file mode 100644
index 0000000..4dfd84a
--- /dev/null
+++ b/zeppelin/modules/combat/main.go
@@ -0,0 +1,586 @@
+// Command combat is a Zeppelin agent-wow gameplay module (F-219 Track A): melee kills with
+// optional abilities, resting, and death recovery (release, run back, reclaim corpse).
+//
+// It drives the move module (to / path_to / face / position) and the interact module (find,
+// self, loot) through InvokeModule, and listens to the combat packets itself. Layouts follow
+// AzerothCore: CombatHandler (CMSG_ATTACKSWING guid, CMSG_ATTACKSTOP), MiscHandler
+// (CMSG_SET_SELECTION guid, CMSG_STANDSTATECHANGE u32, CMSG_REPOP_REQUEST, CMSG_RECLAIM_CORPSE
+// guid), Unit::SendMeleeAttackStart/Stop and SendAttackStateUpdate (server side).
+package main
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"net"
+	"os"
+	"os/signal"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/agent-wow/agent-wow/pkg/modules/v1"
+	"github.com/agent-wow/agent-wow/pkg/opcode"
+	combatv1 "github.com/agent-wow/agent-wow/zeppelin/modules/combat/api"
+	interactv1 "github.com/agent-wow/agent-wow/zeppelin/modules/interact/api"
+	movev1 "github.com/agent-wow/agent-wow/zeppelin/modules/move/api"
+	"github.com/agent-wow/agent-wow/zeppelin/wow"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/health"
+	"google.golang.org/grpc/health/grpc_health_v1"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/anypb"
+	"google.golang.org/protobuf/types/known/emptypb"
+)
+
+const (
+	tick           = 300 * time.Millisecond
+	defaultBudget  = 25 * time.Second // agent-wow caps a module call at 30 s
+	meleeTrigger   = 4.5              // approach when further than this (AC melee range ~5 yd)
+	meleeStand     = 2.5              // stop this far from the target
+	pathThreshold  = 25.0             // use the navmesh beyond this
+	targetFlagUnit = 0x00000002
+)
+
+type service struct {
+	combatv1.UnimplementedCombatServer
+	session modv1.SessionClient
+
+	mu                                            sync.Mutex
+	attackers                                     map[uint64]time.Time // who attacked us, last seen
+	target                                        uint64
+	swings                                        uint32
+	dmgDone                                       uint32
+	dmgTaken                                      uint32
+	notInRange, badFacing, deadTarget, cantAttack bool
+	castCount                                     uint8
+	corpse                                        *movev1.Position // where we died
+	reclaimAt                                     time.Time        // SMSG_CORPSE_RECLAIM_DELAY
+}
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run() error {
+	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer cancel()
+	path := os.Getenv("AGENT_WOW_MODULE_SOCKET")
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		return err
+	}
+	defer listener.Close()
+	if err := os.Chmod(path, 0666); err != nil {
+		return err
+	}
+	conn, err := grpc.NewClient("unix://"+os.Getenv("AGENT_WOW_SESSION_SOCKET"),
+		grpc.WithTransportCredentials(insecure.NewCredentials()), grpc.WithDisableRetry())
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	s := &service{session: modv1.NewSessionClient(conn), attackers: map[uint64]time.Time{}}
+	server := grpc.NewServer()
+	combatv1.RegisterCombatServer(server, s)
+	healthy := health.NewServer()
+	grpc_health_v1.RegisterHealthServer(server, healthy)
+	healthy.SetServingStatus("", grpc_health_v1.HealthCheckResponse_SERVING)
+	go func() { <-ctx.Done(); server.Stop() }()
+	return server.Serve(listener)
+}
+
+// -- plumbing -------------------------------------------------------------------------------------
+
+func (s *service) invoke(ctx context.Context, module, method string, req, resp proto.Message) error {
+	a, err := anypb.New(req)
+	if err != nil {
+		return err
+	}
+	r, err := s.session.InvokeModule(ctx, &modv1.InvokeModuleRequest{Module: module, Method: method, Request: a})
+	if err != nil {
+		return err
+	}
+	return r.GetResult().UnmarshalTo(resp)
+}
+
+func (s *service) send(ctx context.Context, op uint32, w *wow.Writer) error {
+	var payload []byte
+	if w != nil {
+		payload = w.Bytes()
+	}
+	_, err := s.session.SendPacket(ctx, &modv1.SendPacketRequest{Opcode: op, Payload: payload})
+	return err
+}
+
+func (s *service) self(ctx context.Context) (*interactv1.SelfState, error) {
+	var st interactv1.SelfState
+	return &st, s.invoke(ctx, "interact", "self", &emptypb.Empty{}, &st)
+}
+
+func (s *service) position(ctx context.Context) (*movev1.Position, error) {
+	var p movev1.Position
+	return &p, s.invoke(ctx, "move", "position", &emptypb.Empty{}, &p)
+}
+
+// unit returns what interact knows about a guid (nil when it is no longer visible).
+func (s *service) unit(ctx context.Context, guid uint64) (*interactv1.WorldObject, error) {
+	var r interactv1.FindResult
+	if err := s.invoke(ctx, "interact", "find", &interactv1.FindRequest{Guid: guid}, &r); err != nil {
+		return nil, err
+	}
+	if len(r.GetObjects()) == 0 {
+		return nil, nil
+	}
+	return r.GetObjects()[0], nil
+}
+
+func distance(a *movev1.Position, x, y, z float32) float64 {
+	dx, dy, dz := float64(a.GetX()-x), float64(a.GetY()-y), float64(a.GetZ()-z)
+	return math.Sqrt(dx*dx + dy*dy + dz*dz)
+}
+
+// -- packets --------------------------------------------------------------------------------------
+
+func (s *service) OnPacket(ctx context.Context, p *modv1.WorldPacket) (*emptypb.Empty, error) {
+	r := wow.NewReader(p.GetPayload())
+	me := s.myGUID(ctx)
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	switch p.GetOpcode() {
+	case opcode.SMSGAttackstart: // attacker u64, victim u64
+		attacker, victim := r.U64(), r.U64()
+		if victim == me && attacker != me {
+			s.attackers[attacker] = time.Now()
+		}
+	case opcode.SMSGAttackstop: // packed attacker, packed victim, u32
+		attacker := r.PackedGUID()
+		delete(s.attackers, attacker)
+	case opcode.SMSGAttackerstateupdate: // hitInfo, packed attacker, packed victim, damage
+		r.U32()
+		attacker, victim, dmg := r.PackedGUID(), r.PackedGUID(), r.U32()
+		if attacker == me {
+			s.swings++
+			s.dmgDone += dmg
+		} else if victim == me {
+			s.attackers[attacker] = time.Now()
+			s.dmgTaken += dmg
+		}
+	case opcode.SMSGAttackswingNotinrange:
+		s.notInRange = true
+	case opcode.SMSGAttackswingBadfacing:
+		s.badFacing = true
+	case opcode.SMSGAttackswingDeadtarget:
+		s.deadTarget = true
+	case opcode.SMSGAttackswingCantAttack:
+		s.cantAttack = true
+	case opcode.SMSGCastFailed: // castCount u8, spell u32, result u8
+		r.U8()
+		spell, result := r.U32(), r.U8()
+		fmt.Fprintf(os.Stderr, "cast failed spell %d result %d\n", spell, result)
+	case opcode.MSGCorpseQuery: // u8 found, i32 map, x y z, i32 corpse map (QueryHandler)
+		if r.U8() == 1 {
+			m := r.U32()
+			x, y, z := r.F32(), r.F32(), r.F32()
+			if r.Err() == nil {
+				s.corpse = &movev1.Position{Map: m, X: x, Y: y, Z: z, Known: true}
+			}
+		}
+	case opcode.SMSGCorpseReclaimDelay: // u32 ms
+		s.reclaimAt = time.Now().Add(time.Duration(r.U32()) * time.Millisecond)
+	}
+	return &emptypb.Empty{}, nil
+}
+
+var meGUID uint64
+
+func (s *service) myGUID(ctx context.Context) uint64 {
+	if meGUID == 0 {
+		if st, err := s.self(ctx); err == nil {
+			meGUID = st.GetGuid()
+		}
+	}
+	return meGUID
+}
+
+// -- kill -----------------------------------------------------------------------------------------
+
+func (s *service) attack(ctx context.Context, guid uint64) error {
+	var sel wow.Writer
+	sel.U64(guid)
+	if err := s.send(ctx, opcode.CMSGSetSelection, &sel); err != nil {
+		return err
+	}
+	var w wow.Writer
+	w.U64(guid)
+	return s.send(ctx, opcode.CMSGAttackswing, &w)
+}
+
+func (s *service) castAt(ctx context.Context, spell uint32, guid uint64) error {
+	s.mu.Lock()
+	s.castCount++
+	c := s.castCount
+	s.mu.Unlock()
+	var w wow.Writer
+	w.U8(c)
+	w.U32(spell)
+	w.U8(0)
+	w.U32(targetFlagUnit)
+	w.PackedGUID(guid)
+	return s.send(ctx, opcode.CMSGCastSpell, &w)
+}
+
+// approach walks to meleeStand yards from the target (navmesh when far).
+func (s *service) approach(ctx context.Context, me *movev1.Position, t *interactv1.WorldObject) error {
+	d := distance(me, t.GetX(), t.GetY(), t.GetZ())
+	dx, dy := float64(me.GetX()-t.GetX()), float64(me.GetY()-t.GetY())
+	h := math.Max(math.Sqrt(dx*dx+dy*dy), 0.01)
+	x, y := float64(t.GetX())+dx/h*meleeStand, float64(t.GetY())+dy/h*meleeStand
+	if d > pathThreshold {
+		var r movev1.PathToResult
+		return s.invoke(ctx, "move", "path_to", &movev1.PathRequest{X: float32(x), Y: float32(y), Z: t.GetZ(), BudgetMs: 8000}, &r)
+	}
+	var r movev1.MoveToResult
+	return s.invoke(ctx, "move", "to", &movev1.MoveToRequest{X: float32(x), Y: float32(y), Z: t.GetZ(), TimeoutMs: 8000}, &r)
+}
+
+func (s *service) Kill(ctx context.Context, req *combatv1.KillRequest) (*combatv1.KillResult, error) {
+	guid := req.GetGuid()
+	if guid == 0 {
+		if req.GetEntry() == 0 {
+			return nil, status.Error(codes.InvalidArgument, "kill needs guid or entry")
+		}
+		var r interactv1.FindResult
+		if err := s.invoke(ctx, "interact", "find", &interactv1.FindRequest{Entry: req.GetEntry(), Type: wow.TypeUnit, Limit: 10}, &r); err != nil {
+			return nil, err
+		}
+		for _, o := range r.GetObjects() { // nearest living one
+			if o.GetHealth() > 0 {
+				guid = o.GetGuid()
+				break
+			}
+		}
+		if guid == 0 {
+			return &combatv1.KillResult{Reason: "no target"}, nil
+		}
+	}
+	budget := defaultBudget
+	if req.GetBudgetMs() > 0 {
+		budget = time.Duration(req.GetBudgetMs()) * time.Millisecond
+	}
+	chase := float64(req.GetChaseLimit())
+	if chase <= 0 {
+		chase = 60
+	}
+	s.mu.Lock()
+	s.target, s.notInRange, s.badFacing, s.deadTarget, s.cantAttack = guid, false, false, false, false
+	swings0, done0, taken0 := s.swings, s.dmgDone, s.dmgTaken
+	s.mu.Unlock()
+	res := &combatv1.KillResult{Guid: guid}
+	finish := func(reason string, killed bool) (*combatv1.KillResult, error) {
+		_ = s.send(context.Background(), opcode.CMSGAttackstop, nil)
+		s.mu.Lock()
+		res.Swings, res.DamageDone, res.DamageTaken = s.swings-swings0, s.dmgDone-done0, s.dmgTaken-taken0
+		delete(s.attackers, guid)
+		s.target = 0
+		s.mu.Unlock()
+		res.Killed, res.Reason = killed, reason
+		if st, err := s.self(ctx); err == nil {
+			res.OurHealth, res.OurMaxHealth = st.GetHealth(), st.GetMaxHealth()
+		}
+		return res, nil
+	}
+	lastCast := map[uint32]time.Time{}
+	attacking := false
+	var lastHP uint32
+	var stuckSince time.Time
+	deadline := time.Now().Add(budget)
+	for {
+		if time.Now().After(deadline) {
+			return finish("budget", false)
+		}
+		st, err := s.self(ctx)
+		if err != nil {
+			return nil, err
+		}
+		if st.GetDead() {
+			return finish("we died", false)
+		}
+		t, err := s.unit(ctx, guid)
+		if err != nil {
+			return nil, err
+		}
+		if t == nil {
+			return finish("target gone", false)
+		}
+		res.Entry, res.TargetHealth = t.GetEntry(), t.GetHealth()
+		if t.GetHealth() == 0 {
+			_, _ = finish("killed", true)
+			if req.GetLoot() {
+				s.lootCorpse(ctx, guid, res)
+			}
+			return res, nil
+		}
+		me, err := s.position(ctx)
+		if err != nil {
+			return nil, err
+		}
+		d := distance(me, t.GetX(), t.GetY(), t.GetZ())
+		fmt.Fprintf(os.Stderr, "kill %#x hp %d dist %.1f me (%.1f,%.1f) it (%.1f,%.1f) our hp %d/%d\n",
+			guid, t.GetHealth(), d, me.GetX(), me.GetY(), t.GetX(), t.GetY(), st.GetHealth(), st.GetMaxHealth())
+		if d > chase {
+			return finish("too far", false)
+		}
+		s.mu.Lock()
+		notInRange, badFacing, cant := s.notInRange, s.badFacing, s.cantAttack
+		s.notInRange, s.badFacing = false, false
+		s.mu.Unlock()
+		if cant {
+			return finish("cannot attack (friendly or immune?)", false)
+		}
+		if d > meleeTrigger || notInRange {
+			if err := s.approach(ctx, me, t); err != nil {
+				return nil, err
+			}
+			continue
+		}
+		// in range but nothing lands and the target's health never moves: friendly / immune
+		if hp := t.GetHealth(); hp != lastHP {
+			lastHP, stuckSince = hp, time.Now()
+		} else if stuckSince.IsZero() {
+			stuckSince = time.Now()
+		}
+		s.mu.Lock()
+		landed := s.swings != swings0
+		s.mu.Unlock()
+		if !landed && time.Since(stuckSince) > 6*time.Second {
+			return finish("no damage (friendly or immune?)", false)
+		}
+		var face movev1.Position
+		if err := s.invoke(ctx, "move", "face", &movev1.FaceRequest{X: t.GetX(), Y: t.GetY()}, &face); err != nil {
+			return nil, err
+		}
+		if !attacking || badFacing {
+			if err := s.attack(ctx, guid); err != nil {
+				return nil, err
+			}
+			attacking = true
+		}
+		for _, a := range req.GetAbilities() {
+			if time.Since(lastCast[a.GetSpellId()]) < time.Duration(a.GetEveryMs())*time.Millisecond {
+				continue
+			}
+			if st.GetPower() < a.GetMinPower() {
+				continue
+			}
+			if p := a.GetBelowHealthPct(); p > 0 && st.GetMaxHealth() > 0 && st.GetHealth()*100/st.GetMaxHealth() >= p {
+				continue
+			}
+			target := guid
+			if a.GetOnSelf() {
+				target = st.GetGuid()
+			}
+			if err := s.castAt(ctx, a.GetSpellId(), target); err != nil {
+				return nil, err
+			}
+			lastCast[a.GetSpellId()] = time.Now()
+			res.Casts++
+		}
+		time.Sleep(tick)
+	}
+}
+
+// lootCorpse waits briefly for the corpse to become lootable, walks up and takes everything.
+func (s *service) lootCorpse(ctx context.Context, guid uint64, res *combatv1.KillResult) {
+	for i := 0; i < 8; i++ {
+		t, err := s.unit(ctx, guid)
+		if err != nil || t == nil {
+			return
+		}
+		if t.GetDynFlags()&wow.UnitDynFlagLootable != 0 {
+			me, err := s.position(ctx)
+			if err == nil && distance(me, t.GetX(), t.GetY(), t.GetZ()) > 4 {
+				_ = s.approach(ctx, me, t)
+			}
+			var lr interactv1.LootResult
+			if err := s.invoke(ctx, "interact", "loot", &interactv1.UseRequest{Target: &interactv1.Target{Guid: guid}, LootAll: true}, &lr); err == nil {
+				for _, it := range lr.GetReceived() {
+					res.Loot = append(res.Loot, &combatv1.LootItem{ItemId: it.GetItemId(), Count: it.GetCount()})
+				}
+			}
+			return
+		}
+		time.Sleep(250 * time.Millisecond)
+	}
+}
+
+// -- rest, state, revive --------------------------------------------------------------------------
+
+func (s *service) liveAttackers(ctx context.Context) []uint64 {
+	s.mu.Lock()
+	ids := make([]uint64, 0, len(s.attackers))
+	for g, seen := range s.attackers {
+		if time.Since(seen) > 30*time.Second {
+			delete(s.attackers, g)
+			continue
+		}
+		ids = append(ids, g)
+	}
+	s.mu.Unlock()
+	var out []uint64
+	for _, g := range ids {
+		if t, err := s.unit(ctx, g); err == nil && t != nil && t.GetHealth() > 0 {
+			out = append(out, g)
+		} else {
+			s.mu.Lock()
+			delete(s.attackers, g)
+			s.mu.Unlock()
+		}
+	}
+	return out
+}
+
+func (s *service) GetState(ctx context.Context, _ *emptypb.Empty) (*combatv1.CombatState, error) {
+	st, err := s.self(ctx)
+	if err != nil {
+		return nil, err
+	}
+	att := s.liveAttackers(ctx)
+	s.mu.Lock()
+	target := s.target
+	s.mu.Unlock()
+	return &combatv1.CombatState{InCombat: len(att) > 0 || target != 0, Attackers: att, Target: target,
+		Dead: st.GetDead(), Ghost: st.GetGhost()}, nil
+}
+
+func (s *service) stand(ctx context.Context, state uint32) error {
+	var w wow.Writer
+	w.U32(state)
+	return s.send(ctx, opcode.CMSGStandstatechange, &w)
+}
+
+// Rest sits until health reaches until_pct (natural regeneration), stopping if attacked.
+func (s *service) Rest(ctx context.Context, req *combatv1.RestRequest) (*combatv1.RestResult, error) {
+	pct := req.GetUntilPct()
+	if pct == 0 {
+		pct = 90
+	}
+	budget := defaultBudget
+	if req.GetBudgetMs() > 0 {
+		budget = time.Duration(req.GetBudgetMs()) * time.Millisecond
+	}
+	deadline := time.Now().Add(budget)
+	if err := s.stand(ctx, 1); err != nil { // UNIT_STAND_STATE_SIT
+		return nil, err
+	}
+	defer func() { _ = s.stand(context.Background(), 0) }()
+	for {
+		st, err := s.self(ctx)
+		if err != nil {
+			return nil, err
+		}
+		res := &combatv1.RestResult{Health: st.GetHealth(), MaxHealth: st.GetMaxHealth()}
+		if st.GetMaxHealth() > 0 && st.GetHealth()*100/st.GetMaxHealth() >= pct {
+			res.Done, res.Reason = true, "rested"
+			return res, nil
+		}
+		if len(s.liveAttackers(ctx)) > 0 {
+			res.Reason = "attacked"
+			return res, nil
+		}
+		if time.Now().After(deadline) {
+			res.Reason = "budget"
+			return res, nil
+		}
+		time.Sleep(time.Second)
+	}
+}
+
+// Revive runs one stage of death recovery per call: release the spirit (remembering the corpse),
+// walk the ghost back, wait out the reclaim delay, reclaim. Call until alive.
+func (s *service) Revive(ctx context.Context, _ *emptypb.Empty) (*combatv1.ReviveResult, error) {
+	st, err := s.self(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if !st.GetDead() {
+		s.mu.Lock()
+		s.corpse = nil
+		s.mu.Unlock()
+		return &combatv1.ReviveResult{Alive: true, Stage: "alive"}, nil
+	}
+	if !st.GetGhost() {
+		pos, err := s.position(ctx)
+		if err != nil {
+			return nil, err
+		}
+		s.mu.Lock()
+		s.corpse = pos
+		s.mu.Unlock()
+		var rp wow.Writer
+		rp.U8(0) // HandleRepopRequestOpcode read_skip<uint8>(): an empty packet is dropped
+		if err := s.send(ctx, opcode.CMSGRepopRequest, &rp); err != nil {
+			return nil, err
+		}
+		time.Sleep(2 * time.Second) // the graveyard teleport arrives and is acked by move
+		return &combatv1.ReviveResult{Stage: "released"}, nil
+	}
+	s.mu.Lock()
+	corpse, reclaimAt := s.corpse, s.reclaimAt
+	s.mu.Unlock()
+	if corpse == nil { // released before this session (logging out dead auto-releases): ask
+		if err := s.send(ctx, opcode.MSGCorpseQuery, nil); err != nil {
+			return nil, err
+		}
+		for i := 0; i < 20 && corpse == nil; i++ {
+			time.Sleep(100 * time.Millisecond)
+			s.mu.Lock()
+			corpse = s.corpse
+			s.mu.Unlock()
+		}
+		if corpse == nil {
+			return nil, status.Error(codes.FailedPrecondition, "ghost and the server reports no corpse")
+		}
+	}
+	me, err := s.position(ctx)
+	if err != nil {
+		return nil, err
+	}
+	d := distance(me, corpse.GetX(), corpse.GetY(), corpse.GetZ())
+	if d > 20 {
+		var r movev1.PathToResult
+		if err := s.invoke(ctx, "move", "path_to", &movev1.PathRequest{X: corpse.GetX(), Y: corpse.GetY(), Z: corpse.GetZ()}, &r); err != nil {
+			return nil, err
+		}
+		return &combatv1.ReviveResult{Stage: "walking to corpse", CorpseDistance: r.GetRemaining()}, nil
+	}
+	if time.Now().Before(reclaimAt) {
+		wait := time.Until(reclaimAt)
+		if wait > 20*time.Second {
+			wait = 20 * time.Second
+		}
+		time.Sleep(wait)
+		return &combatv1.ReviveResult{Stage: "waiting reclaim delay", CorpseDistance: float32(d)}, nil
+	}
+	var w wow.Writer
+	w.U64(st.GetGuid())
+	if err := s.send(ctx, opcode.CMSGReclaimCorpse, &w); err != nil {
+		return nil, err
+	}
+	time.Sleep(2 * time.Second)
+	if st, err = s.self(ctx); err == nil && !st.GetDead() {
+		return &combatv1.ReviveResult{Alive: true, Stage: "reclaimed"}, nil
+	}
+	return &combatv1.ReviveResult{Stage: "reclaim sent, still dead", CorpseDistance: float32(d)}, nil
+}
+
+func (s *service) BeforeLogout(ctx context.Context, _ *emptypb.Empty) (*emptypb.Empty, error) {
+	_ = s.send(ctx, opcode.CMSGAttackstop, nil)
+	return &emptypb.Empty{}, nil
+}
