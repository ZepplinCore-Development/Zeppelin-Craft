index 0000000..48ca397
--- /dev/null
+++ b/zeppelin/wow/monstermove.go
@@ -0,0 +1,70 @@
+package wow
+
+import "time"
+
+// MonsterMove is a decoded SMSG_MONSTER_MOVE (Movement::PacketBuilder::WriteMonsterMove).
+type MonsterMove struct {
+	GUID     uint64
+	Start    [3]float32
+	Dest     [3]float32
+	Duration time.Duration
+	Stop     bool // MonsterMoveStop: the unit halted at Start
+}
+
+const (
+	monsterMoveNormal       = 0
+	monsterMoveStop         = 1
+	monsterMoveFacingSpot   = 2
+	monsterMoveFacingTarget = 3
+	monsterMoveFacingAngle  = 4
+	splineParabolic         = 0x00000800
+	splineFlying            = 0x00002000
+	splineCatmullrom        = 0x00040000
+	splineAnimation         = 0x00200000
+)
+
+// ParseMonsterMove reads: packed guid, u8, start xyz, u32 spline id, u8 type [+ facing], then
+// (unless Stop) u32 flags, [animation: u8 + u32], u32 duration, [parabolic: f32 + u32], path.
+// Smooth paths (Flying|Catmullrom) list every point, last = destination; linear paths write
+// u32 last index, the destination, then packed offsets.
+func ParseMonsterMove(payload []byte) (MonsterMove, error) {
+	r := NewReader(payload)
+	m := MonsterMove{GUID: r.PackedGUID()}
+	r.U8()
+	m.Start = [3]float32{r.F32(), r.F32(), r.F32()}
+	m.Dest = m.Start
+	r.U32() // spline id
+	switch r.U8() {
+	case monsterMoveStop:
+		m.Stop = true
+		return m, r.Err()
+	case monsterMoveFacingSpot:
+		r.Skip(12)
+	case monsterMoveFacingTarget:
+		r.U64()
+	case monsterMoveFacingAngle:
+		r.F32()
+	}
+	flags := r.U32()
+	if flags&splineAnimation != 0 {
+		r.U8()
+		r.U32()
+	}
+	m.Duration = time.Duration(r.U32()) * time.Millisecond
+	if flags&splineParabolic != 0 {
+		r.F32()
+		r.U32()
+	}
+	count := r.U32()
+	if count > 10000 {
+		return m, ErrShort
+	}
+	if flags&(splineFlying|splineCatmullrom) != 0 {
+		for i := uint32(0); i < count && r.Err() == nil; i++ {
+			m.Dest = [3]float32{r.F32(), r.F32(), r.F32()}
+		}
+	} else {
+		m.Dest = [3]float32{r.F32(), r.F32(), r.F32()}
+	}
+	return m, r.Err()
+}
diff --git a/zeppelin/wow/monstermove_test.go b/zeppelin/wow/monstermove_test.go
