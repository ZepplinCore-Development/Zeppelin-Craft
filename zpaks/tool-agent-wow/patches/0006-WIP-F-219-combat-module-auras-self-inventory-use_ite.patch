+	}
+	f := float32(time.Since(o.MoveBegin)) / float32(o.MoveDur)
+	if f >= 1 {
+		o.X, o.Y, o.Z, o.MoveDur = o.MoveDest[0], o.MoveDest[1], o.MoveDest[2], 0
+		return
+	}
+	o.X = o.MoveFrom[0] + (o.MoveDest[0]-o.MoveFrom[0])*f
+	o.Y = o.MoveFrom[1] + (o.MoveDest[1]-o.MoveFrom[1])*f
+	o.Z = o.MoveFrom[2] + (o.MoveDest[2]-o.MoveFrom[2])*f
