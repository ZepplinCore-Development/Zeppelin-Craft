+// sendAck answers a forced speed change: guid, counter, MovementInfo at our position, speed.
+func (s *service) sendAck(ctx context.Context, a pendingAck) {
+	s.mu.Lock()
+	x, y, z, o := s.pos.X, s.pos.Y, s.pos.Z, s.pos.O
+	flags := uint32(moveFlagsUnknown)
+	if s.moving {
