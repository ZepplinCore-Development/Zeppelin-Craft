+func (s *Store) selfState() SelfState {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	me, ok := s.objects[s.self]
+	if !ok {
+		return SelfState{}
+	}
+	v := me.Values
+	pt := uint8(v[FieldUnitBytes0] >> 24)
+	st := SelfState{GUID: me.GUID, Health: v[FieldUnitHealth], MaxHealth: v[FieldUnitMaxHealth], PowerType: pt,
+		Level: v[FieldUnitLevel], XP: v[FieldPlayerXP], NextXP: v[FieldPlayerNextXP], Money: v[FieldPlayerCoinage],
+		StandState: uint8(v[FieldUnitBytes1]), Ghost: v[FieldPlayerFlags]&0x10 != 0, X: me.X, Y: me.Y, Z: me.Z, Known: true}
