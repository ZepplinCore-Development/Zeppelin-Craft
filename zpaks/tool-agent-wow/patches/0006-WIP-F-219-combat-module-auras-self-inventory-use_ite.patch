+// InventoryItem is one item in the backpack or an equipped bag, addressed as CMSG_USE_ITEM wants.
+type InventoryItem struct {
+	GUID  uint64
+	Entry uint32
+	Count uint32
+	Bag   uint8 // 255 = backpack, else the equipment slot of the bag (19-22)
+	Slot  uint8
+}
+
+func guidAt(v map[uint16]uint32, idx uint16) uint64 { return uint64(v[idx]) | uint64(v[idx+1])<<32 }
+
+// Inventory lists backpack and bag contents from the player's and containers' slot fields.
+func (s *Store) Inventory() []InventoryItem {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	me, ok := s.objects[s.self]
+	if !ok {
+		return nil
+	}
+	var out []InventoryItem
+	add := func(g uint64, bag, slot uint8) {
+		if g == 0 {
+			return
+		}
+		it := InventoryItem{GUID: g, Bag: bag, Slot: slot, Count: 1}
+		if o, ok := s.objects[g]; ok {
+			it.Entry, it.Count = o.Values[FieldEntry], o.Values[FieldItemStackCount]
+		}
+		out = append(out, it)
+	}
+	for i := 0; i < 16; i++ {
+		add(guidAt(me.Values, uint16(FieldPlayerPackSlot+2*i)), BagBackpack, uint8(23+i))
+	}
+	for b := 19; b <= 22; b++ {
+		bg := guidAt(me.Values, uint16(FieldPlayerInvSlot+2*b))
+		bag, ok := s.objects[bg]
+		if bg == 0 || !ok {
+			continue
+		}
+		n := int(bag.Values[FieldContainerSlots])
+		for i := 0; i < n && i < 36; i++ {
+			add(guidAt(bag.Values, uint16(FieldContainerSlot1+2*i)), uint8(b), uint8(i))
+		}
+	}
+	return out
+}
