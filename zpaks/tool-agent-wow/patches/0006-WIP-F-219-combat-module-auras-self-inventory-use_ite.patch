+++ b/zeppelin/wow/monstermove_test.go
@@ -0,0 +1,50 @@
+package wow
+
+import (
+	"testing"
+	"time"
+)
+
+func TestParseMonsterMoveLinearAndStop(t *testing.T) {
+	var w Writer
+	w.PackedGUID(0xF130000C1A000042)
+	w.U8(0)
+	w.F32(10)
+	w.F32(20)
+	w.F32(30) // start
+	w.U32(77) // spline id
+	w.U8(monsterMoveNormal)
+	w.U32(0)    // flags: linear
+	w.U32(1500) // duration
+	w.U32(3)    // last index
+	w.F32(40)
+	w.F32(50)
+	w.F32(60) // destination
+	w.U32(0)
+	w.U32(0) // two packed offsets
+	m, err := ParseMonsterMove(w.Bytes())
+	if err != nil || m.Dest != [3]float32{40, 50, 60} || m.Duration != 1500*time.Millisecond || m.Stop {
+		t.Fatalf("linear move wrong: %+v %v", m, err)
+	}
+
+	var st Writer
+	st.PackedGUID(5)
+	st.U8(0)
+	st.F32(1)
+	st.F32(2)
+	st.F32(3)
+	st.U32(1)
+	st.U8(monsterMoveStop)
+	m, err = ParseMonsterMove(st.Bytes())
+	if err != nil || !m.Stop || m.Start != [3]float32{1, 2, 3} {
+		t.Fatalf("stop wrong: %+v %v", m, err)
+	}
+
+	s := NewStore()
+	s.Apply([]Block{{Type: UpdateCreateObject, GUID: 0xF130000C1A000042, ObjType: TypeUnit, HasPos: true, Values: map[uint16]uint32{FieldEntry: 3098}}})
