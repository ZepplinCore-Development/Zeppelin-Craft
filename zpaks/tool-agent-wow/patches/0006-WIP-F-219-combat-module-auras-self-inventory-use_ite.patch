+++ b/zeppelin/tools/updump/main.go
@@ -0,0 +1,61 @@
+// Command updump decodes captured SMSG_UPDATE_OBJECT payloads (interact's $ZEP_CAPTURE_DIR files)
+// and summarises the blocks: a parser regression check and a field inspector.
+//
+//	go run ./zeppelin/tools/updump [-guid G] [-fields lo-hi] files...
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"sort"
+
+	"github.com/agent-wow/agent-wow/zeppelin/wow"
+)
+
+func main() {
+	guid := flag.Uint64("guid", 0, "only blocks for this guid (0 = all; -self shows the UPDATEFLAG_SELF object)")
+	self := flag.Bool("self", false, "only the UPDATEFLAG_SELF object and later VALUES for it")
+	lo := flag.Int("lo", 0, "first field index to print")
+	hi := flag.Int("hi", -1, "last field index to print (-1 = none)")
+	flag.Parse()
+	var me uint64
+	bad := 0
+	for _, f := range flag.Args() {
+		b, err := os.ReadFile(f)
+		if err != nil {
+			fmt.Println(f, err)
+			continue
+		}
+		blocks, err := wow.ParseUpdate(b)
+		if err != nil {
+			bad++
+			fmt.Printf("%s: PARSE ERROR after %d blocks: %v\n", f, len(blocks), err)
+		}
+		for _, bl := range blocks {
+			if bl.Self {
+				me = bl.GUID
+			}
+			if *self && bl.GUID != me {
+				continue
+			}
+			if *guid != 0 && bl.GUID != *guid {
+				continue
+			}
+			fmt.Printf("%s type=%d guid=%#x obj=%d self=%v pos=%v values=%d\n", f, bl.Type, bl.GUID, bl.ObjType, bl.Self, bl.HasPos, len(bl.Values))
+			if *hi >= *lo {
+				var keys []int
+				for k := range bl.Values {
+					if int(k) >= *lo && int(k) <= *hi {
+						keys = append(keys, int(k))
+					}
+				}
+				sort.Ints(keys)
+				for _, k := range keys {
+					fmt.Printf("    [%d / %#x] = %#x\n", k, k, bl.Values[uint16(k)])
+				}
+			}
+		}
+	}
+	fmt.Printf("%d file(s), %d parse error(s)\n", len(flag.Args()), bad)
+}
diff --git a/zeppelin/wow/aura.go b/zeppelin/wow/aura.go
new file mode 100644
index 0000000..15d6e59
--- /dev/null
+++ b/zeppelin/wow/aura.go
@@ -0,0 +1,34 @@
+package wow
+
+// AuraUpdate is a decoded SMSG_AURA_UPDATE / SMSG_AURA_UPDATE_ALL: the target's packed guid, then
+// AuraApplication::BuildUpdatePacket entries - u8 slot, u32 spell (0 = slot cleared), and for a
+// live aura: u8 flags, u8 caster level, u8 stacks/charges, [packed caster unless AFLAG_CASTER
+// 0x08], [u32 max duration, u32 duration if AFLAG_DURATION 0x20].
+type AuraUpdate struct {
+	GUID  uint64
+	Slots map[uint8]uint32 // slot -> spell id (0 = removed)
+	All   bool             // SMSG_AURA_UPDATE_ALL: the complete visible set
+}
+
+func ParseAuraUpdate(payload []byte, all bool) (AuraUpdate, error) {
+	r := NewReader(payload)
+	u := AuraUpdate{GUID: r.PackedGUID(), Slots: map[uint8]uint32{}, All: all}
+	for r.Err() == nil && r.Len() > 0 {
+		slot, spell := r.U8(), r.U32()
+		u.Slots[slot] = spell
+		if spell == 0 {
+			continue
+		}
+		flags := r.U8()
+		r.U8() // caster level
+		r.U8() // stacks / charges
+		if flags&0x08 == 0 {
+			r.PackedGUID()
+		}
+		if flags&0x20 != 0 {
+			r.U32()
+			r.U32()
+		}
+	}
+	return u, r.Err()
+}
diff --git a/zeppelin/wow/monstermove.go b/zeppelin/wow/monstermove.go
