new file mode 100644
index 0000000..41032c2
--- /dev/null
+++ b/zeppelin/tests/start_area.py
@@ -0,0 +1,395 @@
+"""Data-driven start-area quest runner (F-219 Track A).
+
+Plays every quest whose giver stands inside a box, using only the world DB and the running
+agent-wow session: accept -> objectives (kill, collect from creature/GO loot, use GOs, use quest
+items on friendly targets) -> turn in, repeating until nothing is left. It defends itself, rests
+and revives. Meant for testing start areas - including ones ported from other expansions.
+
+  python3 start_area.py --char Zeppkt --map 1 --box -800 -4550 -250 -4000
+
+Needs a running `agent-wow char play <char>` with the move, interact and combat modules.
+Prints a PASS/FAIL line per step and a summary; exit 0 when every eligible quest was rewarded.
+"""
+import argparse
+import math
+import subprocess
+import sys
+import time
+
+from rpc import StepFailed, call, ground, step
+
+CRAFT = "/workspace/project/Zeppelin-Craft"
+OPENING = 22810  # "Opening - No Text": opens locked chest GOs (GameObject::Use has no CHEST case)
+CLASS_ABILITIES = {  # class id -> combat.kill abilities (rank 1, level 1-10)
+    1: [{"spell_id": 78, "every_ms": 3000, "min_power": 150}],  # warrior: Heroic Strike (15 rage)
+}
+
+
+# -- world DB -------------------------------------------------------------------------------------
+
+def sql(query, db="world"):
+    args = ["python3", "-m", "cli.zep", "world", "sql", "query", query]
+    if db != "world":
+        args += ["-d", db]
+    out = subprocess.run(args, cwd=CRAFT, capture_output=True, text=True, check=True).stdout
+    lines = [l for l in out.splitlines() if l.strip()]
+    if not lines or lines[0].startswith("Query completed"):
+        return []
+    head = lines[0].split("\t")
+    return [dict(zip(head, l.split("\t"))) for l in lines[1:]]
+
+
+def ids(rows, key):
+    return sorted({int(r[key]) for r in rows})
+
+
+def inlist(values):
+    return ",".join(str(v) for v in values) or "0"
+
+
+class World:
+    """Everything the runner needs about the area, loaded once."""
+
+    def __init__(self, mapid, box, char):
+        x1, y1, x2, y2 = box
+        where = f"map={mapid} AND position_x BETWEEN {min(x1, x2)} AND {max(x1, x2)} AND position_y BETWEEN {min(y1, y2)} AND {max(y1, y2)}"
+        self.cspawn, self.gspawn = {}, {}
+        for r in sql(f"SELECT id,position_x x,position_y y,position_z z FROM creature WHERE {where}"):
+            self.cspawn.setdefault(int(r["id"]), []).append((float(r["x"]), float(r["y"]), float(r["z"])))
+        for r in sql(f"SELECT id,position_x x,position_y y,position_z z FROM gameobject WHERE {where}"):
+            self.gspawn.setdefault(int(r["id"]), []).append((float(r["x"]), float(r["y"]), float(r["z"])))
+        ce, ge = inlist(self.cspawn), inlist(self.gspawn)
+        self.starters = {}  # quest -> [("c"|"g", entry)]
+        for r in sql(f"SELECT id,quest FROM creature_queststarter WHERE id IN ({ce})"):
+            self.starters.setdefault(int(r["quest"]), []).append(("c", int(r["id"])))
+        for r in sql(f"SELECT id,quest FROM gameobject_queststarter WHERE id IN ({ge})"):
+            self.starters.setdefault(int(r["quest"]), []).append(("g", int(r["id"])))
+        qs = inlist(self.starters)
+        self.enders = {}
+        for r in sql(f"SELECT id,quest FROM creature_questender WHERE quest IN ({qs})"):
+            if int(r["id"]) in self.cspawn:
+                self.enders.setdefault(int(r["quest"]), []).append(("c", int(r["id"])))
+        for r in sql(f"SELECT id,quest FROM gameobject_questender WHERE quest IN ({qs})"):
+            if int(r["id"]) in self.gspawn:
+                self.enders.setdefault(int(r["quest"]), []).append(("g", int(r["id"])))
+        self.quests = {int(r["ID"]): r for r in sql(
+            "SELECT q.ID,q.LogTitle,q.MinLevel,q.AllowableRaces,q.StartItem,"
+            "q.RequiredNpcOrGo1,q.RequiredNpcOrGo2,q.RequiredNpcOrGo3,q.RequiredNpcOrGo4,"
+            "q.RequiredNpcOrGoCount1,q.RequiredNpcOrGoCount2,q.RequiredNpcOrGoCount3,q.RequiredNpcOrGoCount4,"
+            "q.RequiredItemId1,q.RequiredItemId2,q.RequiredItemId3,q.RequiredItemId4,q.RequiredItemId5,q.RequiredItemId6,"
+            "q.RequiredItemCount1,q.RequiredItemCount2,q.RequiredItemCount3,q.RequiredItemCount4,q.RequiredItemCount5,q.RequiredItemCount6,"
+            "q.ItemDrop1,q.ItemDrop2,q.ItemDrop3,q.ItemDrop4,"
+            "COALESCE(a.AllowableClasses,0) AllowableClasses,COALESCE(a.PrevQuestID,0) PrevQuestID,"
+            "COALESCE(a.ExclusiveGroup,0) ExclusiveGroup,COALESCE(a.BreadcrumbForQuestId,0) BreadcrumbForQuestId "
+            f"FROM quest_template q LEFT JOIN quest_template_addon a ON a.ID=q.ID WHERE q.ID IN ({qs})")}
+        items = set()
+        for q in self.quests.values():
+            for k in ("StartItem", "ItemDrop1", "ItemDrop2", "ItemDrop3", "ItemDrop4") + tuple(f"RequiredItemId{i}" for i in range(1, 7)):
+                if int(q[k]):
+                    items.add(int(q[k]))
+        il = inlist(items)
+        self.item_spell = {int(r["entry"]): int(r["spellid_1"]) for r in sql(f"SELECT entry,spellid_1 FROM item_template WHERE entry IN ({il})")}
+        spells = inlist(v for v in self.item_spell.values() if v)
+        # conditions source 17 (spell implicit target) + type 1 (target has aura): e.g. Awaken
+        # Peon 19938 only works on peons that still carry the sleep aura 17743
+        self.spell_target_aura = {int(r["SourceEntry"]): int(r["ConditionValue1"]) for r in sql(
+            "SELECT SourceEntry,ConditionValue1 FROM conditions WHERE SourceTypeOrReferenceId=17 "
+            f"AND ConditionTypeOrReference=1 AND NegativeCondition=0 AND SourceEntry IN ({spells})")}
+        self.creature_loot = {}  # item -> creature entries (spawned here) that drop it
+        for r in sql(f"SELECT Entry,Item FROM creature_loot_template WHERE Item IN ({il})"):
+            for c in ids(sql(f"SELECT entry FROM creature_template WHERE lootid={int(r['Entry'])}"), "entry"):
+                if c in self.cspawn:
+                    self.creature_loot.setdefault(int(r["Item"]), set()).add(c)
+        self.go_loot = {}  # item -> (go entry, go type)
+        for r in sql(f"SELECT t.entry,t.type,l.Item FROM gameobject_loot_template l JOIN gameobject_template t ON t.Data1=l.Entry "
+                     f"WHERE l.Item IN ({il}) AND t.type IN (3,25)"):
+            if int(r["entry"]) in self.gspawn:
+                self.go_loot.setdefault(int(r["Item"]), set()).add((int(r["entry"]), int(r["type"])))
+        c = sql(f"SELECT guid,race,class,level FROM characters WHERE name='{char}'", "characters")[0]
+        self.guid, self.race, self.cls = int(c["guid"]), int(c["race"]), int(c["class"])
+        self.rewarded = set(ids(sql(f"SELECT quest FROM character_queststatus_rewarded WHERE guid={self.guid}", "characters"), "quest"))
+        self.excl_done = set()
+
+    def nearest(self, kind, entry, me):
+        pts = (self.cspawn if kind == "c" else self.gspawn).get(entry, [])
+        return min(pts, key=lambda p: math.dist(p[:2], (me["x"], me["y"])), default=None)
+
+    def eligible(self, qid, level, in_log):
+        q = self.quests[qid]
+        if qid in self.rewarded or qid in in_log or qid not in self.enders:
+            return False  # no ender in the area = an exit quest; out of scope here
+        races, classes = int(q["AllowableRaces"]), int(q["AllowableClasses"])
+        if races and not races & (1 << (self.race - 1)):
+            return False
+        if classes and not classes & (1 << (self.cls - 1)):
+            return False
+        if int(q["MinLevel"]) > level:
+            return False
+        prev = int(q["PrevQuestID"])
+        if prev > 0 and prev not in self.rewarded:
+            return False
+        if prev < 0 and -prev not in in_log:
+            return False
+        bc = int(q["BreadcrumbForQuestId"])
+        if bc and (bc in self.rewarded or bc in in_log):
+            return False
+        eg = int(q["ExclusiveGroup"])
+        if eg > 0 and eg in self.excl_done:
+            return False
+        return True
+
+
+# -- actions --------------------------------------------------------------------------------------
+
+class Runner:
+    def __init__(self, world, abilities):
+        self.w, self.abilities = world, abilities
+        self.blocked, self.stuck, self.deaths, self.kills = set(), {}, 0, 0
+        self.used = {}  # GO guid -> last use time
+        self.refused = set()  # accept answered QUESTGIVER_QUEST_INVALID
+
+    def me(self):
+        return call("move.position")
+
+    def safe(self):
+        """Revive if dead, fight back if attacked, rest if hurt."""
+        st = call("combat.state")
+        if st.get("dead"):
+            self.deaths += 1
+            print("  ! died - recovering", flush=True)
+            for _ in range(20):
+                if call("combat.revive").get("alive"):
+                    break
+            call("combat.rest", until_pct=90)
+            return
+        for g in st.get("attackers", []):
+            r = call("combat.kill", guid=int(g), abilities=self.abilities, loot=True)
+            self.kills += r.get("killed", False)
+        s = call("interact.self")
+        if s.get("maxHealth") and s.get("health", 0) * 100 < s["maxHealth"] * 50:
+            call("combat.rest", until_pct=90)
+
+    def travel(self, x, y, z, within=4.0):
+        for _ in range(12):
+            r = call("move.path_to", x=x, y=y, z=ground(x, y, z))
+            if r["move"].get("arrived") or r.get("remaining", 99) <= within:
+                return True
+            if r["move"].get("reason") != "budget":
+                self.safe()
+        return False
+
+    def go_near(self, kind, entry, offset=2.5, usable_only=False, has_aura=0):
+        """Walk to the nearest spawn of entry, then stand next to the visible object.
+
+        usable_only (GOs): skip objects used in the last 3 minutes and, when the server marks
+        any as quest-active (dynamic flag 0x1), only consider those.
+        """
+        def pick():
+            objs = call("interact.find", entry=entry, limit=15, has_aura=has_aura).get("objects", [])
+            if usable_only:
+                now = time.time()
+                objs = [o for o in objs if now - self.used.get(int(o["guid"]), 0) > 180]
+                if kind == "g":  # GO dynflag 0x1 = quest-active (on a unit it would mean lootable)
+                    active = [o for o in objs if o.get("dynFlags", 0) & 1]
+                    objs = active or objs
+            return objs[0] if objs else None
+
+        p = self.w.nearest(kind, entry, self.me())
+        if p is None:
+            raise StepFailed(f"no spawn of {kind}{entry} in the area")
+        o = pick()
+        if o is None or o["distance"] > 40:
+            if o is None:  # nothing usable in sight: try spawn points further out
+                pts = sorted((self.w.cspawn if kind == "c" else self.w.gspawn).get(entry, []),
+                             key=lambda q: math.dist(q[:2], (self.me()["x"], self.me()["y"])))
+                for q in pts[: min(len(pts), 6)]:
+                    self.travel(*q, within=15)
+                    o = pick()
+                    if o is not None:
+                        break
+            else:
+                self.travel(o["x"], o["y"], o["z"], within=15)
+                o = pick()
+        if o is None:
+            return None
+        me = self.me()
+        dx, dy = me["x"] - o["x"], me["y"] - o["y"]
+        d = max(math.hypot(dx, dy), 0.01)
+        self.travel(o["x"] + dx / d * offset, o["y"] + dy / d * offset, o["z"], within=1.5)
+        return o
+
+    def log(self):
+        return {e["questId"]: e for e in call("interact.quest_log").get("entries", [])}
+
+    def inventory(self):
+        inv = {}
+        for it in call("interact.inventory").get("items", []):
+            inv[it["entry"]] = inv.get(it["entry"], 0) + it.get("count", 1)
+        return inv
+
+    def accept(self, qid):
+        kind, entry = self.w.starters[qid][0]
+        if not self.go_near(kind, entry):
+            self.blocked.add(qid)
+            return
+        r = call("interact.quest_accept", target={"entry": entry}, quest_id=qid)
+        title = self.w.quests[qid]["LogTitle"]
+        print(f"[{'PASS' if r.get('ok') else 'SKIP'}] accept {qid} {title} - {r.get('detail')}", flush=True)
+        if not r.get("ok"):
+            self.blocked.add(qid)
+            self.refused.add(qid)  # the server is the authority on what is offered
+
+    def turn_in(self, qid):
+        kind, entry = self.w.enders[qid][0]
+        self.go_near(kind, entry)
+        r = call("interact.quest_complete", target={"entry": entry}, quest_id=qid)
+        title = self.w.quests[qid]["LogTitle"]
+        if not r.get("ok"):
+            print(f"[FAIL] turn in {qid} {title} - {r.get('detail')}", flush=True)
+            self.blocked.add(qid)
+            return
+        print(f"[PASS] turn in {qid} {title} - {r.get('detail')}", flush=True)
+        self.w.rewarded.add(qid)
+        eg = int(self.w.quests[qid]["ExclusiveGroup"])
+        if eg > 0:
+            self.w.excl_done.add(eg)
+
+    def quest_item(self, q):
+        """The quest-supplied item with an on-use spell, if any."""
+        for k in ("StartItem", "ItemDrop1", "ItemDrop2", "ItemDrop3", "ItemDrop4"):
+            item = int(q[k])
+            if item and self.w.item_spell.get(item):
+                return item
+        return 0
+
+    def use_quest_item_on(self, q, entry):
+        for k in ("StartItem", "ItemDrop1", "ItemDrop2", "ItemDrop3", "ItemDrop4"):
+            item = int(q[k])
+            if item and self.w.item_spell.get(item):
+                spell = self.w.item_spell[item]
+                o = self.go_near("c", entry, offset=2.0, usable_only=True, has_aura=self.w.spell_target_aura.get(spell, 0))
+                if o:
+                    self.used[int(o["guid"])] = time.time()
+                    r = call("interact.use_item", entry=item, spell_id=spell, target={"guid": int(o["guid"])})
+                    print(f"  use item {item} on {entry}: {r.get('detail')}", flush=True)
+                    time.sleep(2)
+                return True
+        return False
+
+    def objective_step(self, qid, entry_log):
+        """Advance one objective of an active quest by one action. False = nothing doable."""
+        q, counts = self.w.quests[qid], entry_log.get("counts", [0, 0, 0, 0])
+        for i in range(1, 5):
+            target, need = int(q[f"RequiredNpcOrGo{i}"]), int(q[f"RequiredNpcOrGoCount{i}"])
+            if not target or counts[i - 1] >= need:
+                continue
+            if target > 0:
+                # a quest that hands out an item with an on-use spell wants it used on the
+                # objective creature (Lazy Peons: Foreman's Blackjack on friendly peons)
+                if self.quest_item(q) or ("use", target) in self.stuck:
+                    return self.use_quest_item_on(q, target)
+                if not self.go_near("c", target, offset=6.0):
+                    return False
+                r = call("combat.kill", entry=target, abilities=self.abilities, loot=True)
+                if r.get("reason", "").startswith(("cannot attack", "no damage")):
+                    self.stuck[("use", target)] = 1  # friendly: a quest item / spell target
+                    return self.use_quest_item_on(q, target)
+                self.kills += r.get("killed", False)
+                return True
+            go = -target
+            if self.go_near("g", go):
+                call("interact.use", target={"entry": go}, loot_all=True)
+                time.sleep(1)
+            return True
+        inv = self.inventory()
+        for i in range(1, 7):
+            item, need = int(q[f"RequiredItemId{i}"]), int(q[f"RequiredItemCount{i}"])
+            if not item or inv.get(item, 0) >= need:
+                continue
+            for go, gotype in sorted(self.w.go_loot.get(item, ())):
+                o = self.go_near("g", go, usable_only=True)
+                if o:
+                    self.used[int(o["guid"])] = time.time()
+                    spell = OPENING if gotype == 3 else 0
+                    r = call("interact.use", target={"guid": int(o["guid"])}, loot_all=True, spell_id=spell)
+                    print(f"  open GO {go} for item {item}: {r.get('detail')} {r.get('received', '')}", flush=True)
+                    return True
+            for c in sorted(self.w.creature_loot.get(item, ())):
+                if self.go_near("c", c, offset=6.0):
+                    r = call("combat.kill", entry=c, abilities=self.abilities, loot=True)
+                    self.kills += r.get("killed", False)
+                    return True
+            return False
+        return False
+
+    def run(self, minutes):
+        t0, idle = time.time(), 0
+        while time.time() - t0 < minutes * 60:
+            self.safe()
+            log = self.log()
+            level = call("interact.self").get("level", 1)
+            # the quest log update that removes a turned-in quest can lag the reward packet
+            log = {q: e for q, e in log.items() if q not in self.w.rewarded}
+            ready = [q for q, e in log.items() if q in self.w.quests and e.get("state") == 1 and q not in self.blocked]
+            if ready:
+                self.turn_in(ready[0])
+                continue
+            active = [q for q in log if q in self.w.quests and q not in self.blocked]
+            progressed = False
+            for qid in active:
+                n = self.stuck.get(qid, 0)
+                if n > 25:
+                    continue
+                try:
+                    if self.objective_step(qid, log[qid]):
+                        progressed = True
+                        break
+                except StepFailed as e:  # one failed action (range, despawn...) is retryable
+                    print(f"  ~ {qid}: {e}", flush=True)
+                self.stuck[qid] = n + 1
+            if progressed:
+                idle = 0
+                continue
+            avail = [q for q in sorted(self.w.starters) if q not in self.blocked and self.w.eligible(q, level, log)]
+            if avail:
+                self.accept(avail[0])
+                continue
+            idle += 1
+            if idle > 2:
+                break
+        return time.time() - t0
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--char", required=True)
+    ap.add_argument("--map", type=int, required=True)
+    ap.add_argument("--box", type=float, nargs=4, required=True, metavar=("X1", "Y1", "X2", "Y2"))
+    ap.add_argument("--minutes", type=float, default=60)
+    a = ap.parse_args()
+    w = World(a.map, a.box, a.char)
+    print(f"area: {sum(map(len, w.cspawn.values()))} creature + {sum(map(len, w.gspawn.values()))} GO spawns, "
+          f"{len(w.starters)} quests started here; char race {w.race} class {w.cls}", flush=True)
+    r = Runner(w, CLASS_ABILITIES.get(w.cls, []))
+    try:
+        secs = r.run(a.minutes)
+    except StepFailed as e:
+        print(f"RESULT: FAIL at {e}")
+        return 1
+    level = call("interact.self").get("level")
+    log = r.log()
+    todo = [q for q in w.starters if (w.eligible(q, 99, log) or q in log) and q not in r.refused and q not in w.rewarded]
+    print(f"\nSUMMARY: {len(w.rewarded)} quests rewarded, level {level}, {r.kills} kills, {r.deaths} deaths, {secs / 60:.1f} min")
+    if todo:
+        print("left:", ", ".join(f"{q} {w.quests[q]['LogTitle']}" for q in sorted(todo)))
+    if r.refused:
+        print("refused by the server (breadcrumbs / not offered):", ", ".join(f"{q} {w.quests[q]['LogTitle']}" for q in sorted(r.refused)))
+    blocked = sorted((r.blocked - r.refused) | {q for q in r.stuck if isinstance(q, int) and r.stuck[q] > 25})
+    if blocked:
+        print("blocked/stuck:", ", ".join(f"{q} {w.quests[q]['LogTitle']}" for q in blocked if q in w.quests))
+    print("RESULT: PASS" if not todo and not blocked else "RESULT: INCOMPLETE")
+    return 0 if not todo and not blocked else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
