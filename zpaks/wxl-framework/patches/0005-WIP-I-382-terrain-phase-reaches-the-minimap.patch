     woff::TileLoaderFn g_origTileLoad = nullptr;
     char    g_childMap[64] = { 0 };       // active phase directory
@@ -92,16 +94,19 @@ namespace
     }
 
     /** @brief Reports whether the active phase has a variant tile at this tile's coords. */
-    bool PhaseHasTile(const void* tile)
+    bool PhaseHasTileAt(int first, int second)
     {
-        const auto* t = static_cast<const adt::TileArea*>(tile);
-        const int first  = t->tileFirst;
-        const int second = t->tileSecond;
         if (first < 0 || first >= 64 || second < 0 || second >= 64) return false;
         const int slot = second * 64 + first; // matches the client's MAIN-chunk tile indexing (tile[0x4c]*64 + tile[0x48])
         return (g_phaseMain[slot * 8] & 1) != 0;
     }
 
+    bool PhaseHasTile(const void* tile)
+    {
+        const auto* t = static_cast<const adt::TileArea*>(tile);
+        return PhaseHasTileAt(t->tileFirst, t->tileSecond);
+    }
+
     /**
      * @brief Per-tile loader detour: when a phase is active and it has this tile, serve the tile from the
      *        phase directory by swapping the loader path globals for this one load, then restoring them.
@@ -121,9 +126,57 @@ namespace
         std::memcpy(reinterpret_cast<void*>(woff::kMapNameStr), saveName, sizeof saveName);
     }
 
+    // --- minimap (I-382) ---
+    // The minimap resolves terrain tiles from the Map.dbc Directory of its own map id, never from the
+    // loader name globals hkTileLoad swaps, so a phase tile still drew the base map's art. The phase
+    // art is keyed in md5translate as "<childMap>\mapX_YY.blp", the same key shape as a real map.
+    mm::Minimap_TerrainTexturePathFn g_origMinimapPath = nullptr;
+    mm::Minimap_RefreshTilesFn       g_origMinimapRefresh = nullptr;
+    bool                             g_minimapFlush = false;
+
+    int __cdecl hkMinimapPath(const int* tile, char* out, int outSize)
+    {
+        if (!g_childMap[0] || !tile || !PhaseHasTileAt(tile[0], tile[1]))
+            return g_origMinimapPath(tile, out, outSize);
+
+        char key[260];
+        std::snprintf(key, sizeof key, "%s\\map%d_%02d.blp", g_childMap, tile[0], tile[1]);
+        auto lookup = reinterpret_cast<mm::Minimap_TranslateLookupFn>(mm::kTranslateLookup);
+        const auto* entry = static_cast<const char*>(lookup(reinterpret_cast<void*>(mm::kTranslateTable), key));
+        if (!entry)
+        {
+            // Phase tile with no art mapped: keep the base tile rather than a hole in the minimap.
+            WLOG_INFO("phasing: no md5translate row for '%s', minimap keeps the base tile", key);
+            return g_origMinimapPath(tile, out, outSize);
+        }
+        std::snprintf(out, outSize, "Textures\\Minimap\\%s", entry + mm::kTranslateDstOffset);
+        return 1;
+    }
+
+    // A phase change re-enters the SAME map id, which the minimap reads as "nothing changed": tiles
+    // whose coords are still in the window keep their old texture. Force one full reload instead.
+    void __cdecl hkMinimapRefresh(const int* window, int mapChanged, void* slots)
+    {
+        if (g_minimapFlush)
+        {
+            g_minimapFlush = false;
+            mapChanged = 1;
+        }
+        g_origMinimapRefresh(window, mapChanged, slots);
+    }
+
+    /** @brief Makes the next minimap update re-resolve every tile (after the phase table changed). */
+    void FlushMinimap()
+    {
+        g_minimapFlush = true;
+        *reinterpret_cast<volatile uint32_t*>(mm::kDirtyFlags) |= mm::kDirtyTiles;
+    }
+
     bool InstallPhasing()
     {
         wxl::hook::Install("TileLoader", woff::kTileLoader, &hkTileLoad, &g_origTileLoad);
+        wxl::hook::Install("MinimapTerrainPath", mm::kTerrainTexturePath, &hkMinimapPath, &g_origMinimapPath);
+        wxl::hook::Install("MinimapRefreshTiles", mm::kRefreshTiles, &hkMinimapRefresh, &g_origMinimapRefresh);
         return true;
     }
 }
@@ -140,6 +193,7 @@ namespace wxl::game::world
         // Stay on the base map (its present table keeps every base tile); re-stream it - the loader detour
         // swaps in the phase ADT only for the tiles the phase actually has, leaving the rest as base.
         ReEnterMap(g_baseMap, MapId());
+        FlushMinimap();
         WLOG_INFO("phasing: phase '%s' active over base '%s'", g_childMap, g_baseMap);
     }
 
@@ -148,9 +202,15 @@ namespace wxl::game::world
         if (!g_baseMap[0]) return; // no phase active
         g_childMap[0] = '\0';      // redirect off before the re-stream
         ReEnterMap(g_baseMap, MapId());
+        FlushMinimap();
         WLOG_INFO("phasing: restored base map '%s'", g_baseMap);
         g_baseMap[0] = '\0';
     }
+
+    const char* TerrainPhase()
+    {
+        return g_childMap[0] ? g_childMap : nullptr;
+    }
 }
 
 WXL_REGISTER_FEATURE("phasing", true, InstallPhasing)
