+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include <cstdint>
+
+// INTERNAL to the core. Minimap.cpp: how a terrain tile becomes a texture path, and the cache that
+// decides whether a tile is re-resolved at all. Modules never include this.
+namespace wxl::offsets::game::minimap
+{
+    // --- terrain tile -> texture path ---
+    // Builds the texture path for one terrain tile (Minimap.cpp, sole caller 0x007F5868). Formats
+    // "%s\\map%d_%02d.blp" from the Map.dbc Directory of the MINIMAP's map id (kMinimapMapId) and
+    // tile[0]/tile[1] (the ADT filename's first/second index), looks that key up in md5translate and
+    // writes "Textures\\Minimap\\<dst>" to out. Returns 1, or 0 with out = "" when the key is absent.
+    // It never reads the map-loader name globals, so a tile-loader redirect does not reach it.
+    // __cdecl, caller-cleaned.
+    constexpr uintptr_t kTerrainTexturePath = 0x007F5240;
+    using Minimap_TerrainTexturePathFn = int(__cdecl*)(const int* tile, char* out, int outSize);
+
+    // Refreshes the minimap's tile-texture slots for a new tile window (sole caller 0x007F5A2C, in the
+    // minimap update 0x007F5930). With mapChanged == 0 a slot whose tile coords are still in the window
+    // keeps its texture and is never re-resolved; nonzero releases and reloads every slot. The update
+    // passes mapChanged = (map id != kMinimapMapId), so re-entering the SAME map keeps every texture.
+    // __cdecl, caller-cleaned.
+    constexpr uintptr_t kRefreshTiles = 0x007F5760;
+    using Minimap_RefreshTilesFn = void(__cdecl*)(const int* window, int mapChanged, void* slots);
+
+    // Map id the minimap last resolved tiles for (u32).
+    constexpr uintptr_t kMinimapMapId = 0x00AF4E48;
+    // Minimap dirty bits (u32). Bit 0 makes the next update call kRefreshTiles even when the tile window
+    // did not move; the zoom setter (0x007F3AE0) sets it the same way, the update clears it.
+    constexpr uintptr_t kDirtyFlags = 0x00D3922C;
+    constexpr uint32_t  kDirtyTiles = 0x1;
+
+    // md5translate.trs hash (the object passed as this to kTranslateLookup).
+    constexpr uintptr_t kTranslateTable = 0x00D39624;
+    // Looks a "<dir>\\mapX_YY.blp" key up in kTranslateTable; returns the entry or null. The entry's
+    // destination filename is an inline string at +0x18. __thiscall, callee-cleaned.
+    constexpr uintptr_t kTranslateLookup = 0x0055F4D0;
+    constexpr uintptr_t kTranslateDstOffset = 0x18;
+    using Minimap_TranslateLookupFn = void*(__thiscall*)(void* table, const char* key);
+}
