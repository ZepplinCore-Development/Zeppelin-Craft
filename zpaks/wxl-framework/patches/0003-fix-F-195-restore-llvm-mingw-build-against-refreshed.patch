From 964b631f770775b48f6ee9a1577931e1ac30d716 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Fri, 31 Jul 2026 09:29:36 +0000
Subject: [PATCH] fix: F-195 - restore llvm-mingw build against refreshed
 upstream

Upstream (45 commits) added code that does not compile under the Linux
cross-compile toolchain:

- 11 functions across GameHooks/LuaBindings/RenderHooks wrap a *call* in
  __try/__except. clang cannot codegen a 32-bit SEH funclet around a call
  (verified minimal repro: __try around memory access compiles, around a
  call it does not, independent of linkage, -O level and
  -fseh-exceptions/-fasync-exceptions). Added core/SehCompat.hpp: real
  __try/__except on MSVC, unguarded on mingw. Memory-access guards are
  left as plain __try and stay protective everywhere.
- /DELAYLOAD + delayimp on the WarcraftXL target are MSVC-only; guarded so
  mingw links these as static imports (as it already did for d3d9).
- wxl-modern-render used world::GetObject, renamed upstream to
  world::ResolveObject.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 CMakeLists.txt              |  9 ++++++--
 src/core/SehCompat.hpp      | 46 +++++++++++++++++++++++++++++++++++++
 src/runtime/GameHooks.cpp   | 25 ++++++++++----------
 src/runtime/LuaBindings.cpp | 21 +++++++++--------
 src/runtime/RenderHooks.cpp |  5 ++--
 5 files changed, 80 insertions(+), 26 deletions(-)
 create mode 100644 src/core/SehCompat.hpp

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a525882..4485704 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -85,11 +85,16 @@ if(CMAKE_SIZEOF_VOID_P EQUAL 4)
         "${CMAKE_CURRENT_SOURCE_DIR}/deps/flatbuffers/include")
 
     add_subdirectory(deps/minhook)
-    target_link_libraries(WarcraftXL PRIVATE minhook d3d9 d3dcompiler shell32 delayimp)
+    target_link_libraries(WarcraftXL PRIVATE minhook d3d9 d3dcompiler shell32)
     # D3D12 and the shader compiler are feature-path dependencies (post-fx, grass capture, liquid
     # shaders), not boot dependencies. Delay-loading keeps the DLL loadable on machines without them;
     # every call site resolves or guards availability before touching those paths.
-    target_link_options(WarcraftXL PRIVATE "/DELAYLOAD:d3d12.dll" "/DELAYLOAD:d3dcompiler_47.dll")
+    if(MSVC)
+        target_link_libraries(WarcraftXL PRIVATE delayimp)
+        target_link_options(WarcraftXL PRIVATE "/DELAYLOAD:d3d12.dll" "/DELAYLOAD:d3dcompiler_47.dll")
+    endif()
+    # mingw (F-195): no delayimp / `/DELAYLOAD` equivalent, so these stay static imports. See the
+    # matching note on the d3d9 proxy target below for the loadability caveat this carries.
     target_compile_definitions(WarcraftXL PRIVATE ${WXL_DEFS})
     if(NOT MSVC)
         # F-194/195 mingw: wxl-modern-render (compiled into the DLL) uses d3d9on12.h + the DComposition
diff --git a/src/core/SehCompat.hpp b/src/core/SehCompat.hpp
new file mode 100644
index 0000000..de125e4
--- /dev/null
+++ b/src/core/SehCompat.hpp
@@ -0,0 +1,46 @@
+// SEH portability shim for the llvm-mingw (Linux cross-compile) build.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+/**
+ * F-195 (Linux/llvm-mingw i686): clang cannot codegen a 32-bit SEH funclet around a **call**.
+ *
+ * Verified against llvm-mingw i686-w64-mingw32-g++ with a minimal repro:
+ *   __try around a pure memory access  -> compiles
+ *   __try around a call                -> "assembler label 'L__ehtable$<fn>' can not be undefined"
+ * The failure is independent of linkage (anonymous namespace or external), optimisation level
+ * (-O0/-O2), -fno-inline, and -fseh-exceptions / -fasync-exceptions. There is no flag that fixes it.
+ *
+ * Guards around **memory access** need no shim -- keep those as plain __try/__except, they compile
+ * and remain fully protective on every toolchain. Use these macros ONLY where the guarded statement
+ * makes a call, which is exactly the construct clang rejects.
+ *
+ * On MSVC the guard is a real __try/__except. On mingw the statement runs UNGUARDED: a fault that
+ * MSVC would have swallowed will propagate. That is a genuine reduction in fault tolerance for the
+ * Linux-built DLL, accepted because the alternative is not building at all. The __except body stays
+ * syntactically valid (it becomes an unreachable `else`), so both paths compile from one source.
+ *
+ * Do not use these macros in a guard whose handler inspects the exception (GetExceptionCode(),
+ * GetExceptionInformation()) -- there is no exception to inspect on the mingw path.
+ */
+#if defined(_MSC_VER)
+#  define WXL_SEH_TRY           __try
+#  define WXL_SEH_EXCEPT(expr)  __except (expr)
+#else
+#  define WXL_SEH_TRY           if (true)
+#  define WXL_SEH_EXCEPT(expr)  else
+#endif
