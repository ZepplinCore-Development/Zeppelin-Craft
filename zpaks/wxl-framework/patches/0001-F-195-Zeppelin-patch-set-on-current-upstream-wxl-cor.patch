diff --git a/deps/mingw-compat/d3d9on12.h b/deps/mingw-compat/d3d9on12.h
new file mode 100644
index 0000000..cbea985
--- /dev/null
+++ b/deps/mingw-compat/d3d9on12.h
@@ -0,0 +1,49 @@
+/*
+ * Minimal d3d9on12.h for mingw-w64 (F-195 / Zeppelin).
+ *
+ * mingw-w64 (GCC 10) does not ship the Windows-SDK D3D9On12 interop header. This provides the
+ * documented, ABI-correct subset the WarcraftXL d3d9 proxy uses: the D3D9ON12_ARGS override
+ * struct and the IDirect3DDevice9On12 interface. Layout/vtable order match the public MS SDK
+ * (docs.microsoft.com/windows/win32/api/d3d9on12), so binaries built against this are
+ * interchangeable with ones built against the real header. IID via mingw's __CRT_UUID_DECL.
+ */
+
+#ifndef _D3D9ON12_H_
+#define _D3D9ON12_H_
+
+#include <d3d9.h>
+#include <d3d12.h>
+
+#ifndef MAX_D3D9ON12_QUEUES
+#define MAX_D3D9ON12_QUEUES 2
+#endif
+
+/* Override list entry passed to Direct3DCreate9On12 / Ex. */
+typedef struct _D3D9ON12_ARGS
+{
+    BOOL      Enable9On12;
+    IUnknown* pD3D12Device;
+    IUnknown* ppD3D12Queues[MAX_D3D9ON12_QUEUES];
+    UINT      NumQueues;
+    UINT      NodeMask;
+} D3D9ON12_ARGS;
+
+/* {e7fda234-b589-4049-940d-8878977531c8} — IID_IDirect3DDevice9On12 */
+#ifdef __cplusplus
+
+struct IDirect3DDevice9On12 : public IUnknown
+{
+    virtual HRESULT STDMETHODCALLTYPE GetD3D12Device(REFIID riid, void** ppvDevice) = 0;
+    virtual HRESULT STDMETHODCALLTYPE UnwrapUnderlyingResource(IDirect3DResource9* pResource, ID3D12CommandQueue* pCommandQueue, REFIID riid, void** ppvResource12) = 0;
+    virtual HRESULT STDMETHODCALLTYPE ReturnUnderlyingResource(IDirect3DResource9* pResource, UINT NumSync, UINT64* pSignalValues, ID3D12Fence** ppFences) = 0;
+};
+
+__CRT_UUID_DECL(IDirect3DDevice9On12, 0xe7fda234, 0xb589, 0x4049, 0x94, 0x0d, 0x88, 0x78, 0x97, 0x75, 0x31, 0xc8)
+
+#endif /* __cplusplus */
+
+/* Exported by d3d9.dll at runtime; the proxy resolves these via GetProcAddress. */
+typedef IDirect3D9* (WINAPI* PFN_Direct3DCreate9On12)(UINT SDKVersion, D3D9ON12_ARGS* pOverrideList, UINT NumOverrideEntries);
+typedef HRESULT     (WINAPI* PFN_Direct3DCreate9On12Ex)(UINT SDKVersion, D3D9ON12_ARGS* pOverrideList, UINT NumOverrideEntries, IDirect3D9Ex** ppOutputInterface);
+
+#endif /* _D3D9ON12_H_ */
