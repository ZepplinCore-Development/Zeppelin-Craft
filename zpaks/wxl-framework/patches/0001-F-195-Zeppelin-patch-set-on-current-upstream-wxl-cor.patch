diff --git a/src/offsets/engine/Script.hpp b/src/offsets/engine/Script.hpp
new file mode 100644
index 0000000..ae66ac2
--- /dev/null
+++ b/src/offsets/engine/Script.hpp
@@ -0,0 +1,55 @@
+// Client FrameScript / Lua entry points: register native C functions into the client's Lua state so
+// server-driven addon messages (ALE + CSMH) can invoke them. Every address below is verified against
+// nginx/wow/EXE/Wow.exe build 12340 (see the disassembly notes on each constant).
+// Copyright (C) 2026 WarcraftXL. GPLv3.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// INTERNAL to the core. Modules never include this; they use wxl::game / wxl::events.
+namespace wxl::offsets::engine::script
+{
+    // void __cdecl FrameScript_RegisterFunction(const char* name, lua_CFunction fn): binds fn as a
+    // global Lua function `name` in the live FrameScript state. Verified body: it reads the state from
+    // *(lua_State**)kLuaState, then lua_pushcclosure(L, fn, 0) + setglobal(L, name). Must run while a
+    // state exists (kLuaState non-null) -- see hkFrameScriptInit, which registers right after the state
+    // is (re)created.
+    //
+    // NOTE: an earlier revision used 0x00819D40 here. That is a DIFFERENT FrameScript helper -- it takes
+    // (name, int, int) and builds+runs a Lua string; it never takes a function pointer, so the bridge
+    // was never actually installed as a C function (the observed NULL lua_State crash). The real
+    // registrar, the one the client's own Script_* table loop calls, is 0x00817F90.
+    constexpr uintptr_t kRegisterFunction = 0x00817F90;
+    using RegisterFunctionFn = void(__cdecl*)(const char* name, int(__cdecl* fn)(void* L));
+
+    // FrameScript_Initialize @0x00819BB0 (__cdecl, one forwarded arg, plain `ret`): creates a fresh Lua
+    // state (lua_newstate) and stores it at kLuaState. WoW recreates the state on every glue<->world
+    // transition (paired with FrameScript_Destroy @0x0081A9B0, which lua_close()s it and writes null to
+    // kLuaState), so any C function registered into the old state is lost. We post-hook this to
+    // re-register the bridge into each new state.
+    constexpr uintptr_t kFrameScriptInitialize = 0x00819BB0;
+    using FrameScriptInitializeFn = void*(__cdecl*)(void* arg);
+
+    // The live FrameScript lua_State*: *(void**)kLuaState. Null before init / after destroy. Both the
+    // engine's own RegisterFunction and every stock Script_* handler resolve L from here
+    // (mov esi, [0x00D3F78C]).
+    constexpr uintptr_t kLuaState = 0x00D3F78C;
+
+    // const char* __cdecl lua_tolstring(lua_State* L, int idx, size_t* len): reads a Lua stack value as
+    // a string (len may be null; returns null when the value is not a string). Confirmed: the stock
+    // Script_RunScript handler @0x004DD490 calls exactly this as lua_tolstring([ebp+8], 1, 0).
+    constexpr uintptr_t kToLString = 0x0084E0E0;
+    using ToLStringFn = const char*(__cdecl*)(void* L, int idx, size_t* len);
+
+    // Before dispatching a registered Lua C function, the client validates its pointer against Wow.exe's
+    // own .text bounds (validator @0x0086B5A0): valid iff  *kTextLo <= fn < *kTextHi, else ERROR #134
+    // "Invalid function pointer". Our bridge functions live in this DLL, ABOVE .text, so the stock guard
+    // rejects them. We raise *kTextHi so DLL code is accepted. This regresses nothing: every stock C
+    // function is below the original *kTextHi and still passes -- we only additionally accept higher
+    // (DLL) addresses. The guard treats a non-zero *kTextHi as "already computed" and skips its
+    // recompute (0x0086B5B5: test ecx,ecx / jne), so the widened value sticks for the session.
+    constexpr uintptr_t kTextLo = 0x00D415B8; // Wow.exe .text lower bound (== 0x00401000 for 12340)
+    constexpr uintptr_t kTextHi = 0x00D415BC; // Wow.exe .text upper bound (the value we widen)
+}
diff --git a/src/runtime/PhasingHooks.cpp b/src/runtime/PhasingHooks.cpp
index 20cdb74..975f6f5 100644
--- a/src/runtime/PhasingHooks.cpp
+++ b/src/runtime/PhasingHooks.cpp
@@ -18,7 +18,9 @@
 
 #include "core/Hook.hpp"
 #include "core/Logger.hpp"
+#include "game/Binding.hpp"
 #include "game/world/Loading.hpp"
+#include "offsets/engine/Script.hpp"
 #include "offsets/game/World.hpp"
 #include "runtime/storage/ShmClient.hpp"
 
@@ -147,11 +149,86 @@ namespace wxl::game::world
 
 namespace wxl::runtime::phasing
 {
+    namespace se = wxl::offsets::engine::script;
+
+    se::FrameScriptInitializeFn g_origFrameScriptInit = nullptr;
+
+    /** @brief The live FrameScript lua_State, or null before init / after destroy. */
+    void* LuaState() { return *reinterpret_cast<void* const*>(se::kLuaState); }
+
+    // Bound into the client's Lua so the server can drive terrain swaps over an addon message
+    // (ALE server script -> CSMH -> these globals). WarcraftXL_SetTerrainPhase("<mapDir>") overlays the
+    // phase-variant map; WarcraftXL_ClearTerrainPhase() restores the base. lua_CFunction: __cdecl,
+    // returns the number of results pushed (0). The state is resolved from the FrameScript global
+    // (kLuaState) -- the same pointer the engine's own Script_* handlers use -- which is the state the
+    // addon message runs on, so it is guaranteed non-null and holds the call's arguments.
+    static int __cdecl Lua_SetTerrainPhase(void*)
+    {
+        void* L = LuaState();
+        if (!L) return 0;
+        const char* dir = wxl::game::Native<se::ToLStringFn>(se::kToLString)(L, 1, nullptr);
+        if (dir && dir[0])
+            wxl::game::world::SetTerrainPhase(dir);
+        return 0;
+    }
+
+    static int __cdecl Lua_ClearTerrainPhase(void*)
+    {
+        wxl::game::world::ClearTerrainPhase();
+        return 0;
+    }
+
+    /**
+     * @brief Lets the client dispatch Lua C functions that live in this DLL. The stock guard (Script.hpp
+     *        kTextLo/kTextHi) rejects any function pointer outside Wow.exe's .text with ERROR #134; our
+     *        bridge functions are in the DLL, above .text. Raising the upper bound accepts them and
+     *        regresses no stock call (every stock pointer is below the original bound and still passes).
+     *        Idempotent -- safe to call on every (re)registration.
+     */
+    void AllowDllFunctionPointers()
+    {
+        *reinterpret_cast<uint32_t*>(se::kTextLo) = 0x00401000; // Wow.exe .text start (fixed, 12340)
+        *reinterpret_cast<uint32_t*>(se::kTextHi) = 0xFFFF0000; // accept DLL code above .text
+    }
+
+    /** @brief Registers the terrain bridge globals into the current FrameScript state. */
+    void RegisterBridge()
+    {
+        AllowDllFunctionPointers(); // or the client rejects our DLL-resident closures on call (#134)
+        auto reg = wxl::game::Native<se::RegisterFunctionFn>(se::kRegisterFunction);
+        reg("WarcraftXL_SetTerrainPhase", &Lua_SetTerrainPhase);
+        reg("WarcraftXL_ClearTerrainPhase", &Lua_ClearTerrainPhase);
+    }
+
+    /**
+     * @brief Post-detour on FrameScript_Initialize: after the client builds a fresh Lua state, register
+     *        the bridge into it. WoW recreates the state on every glue<->world transition, so this is
+     *        what keeps the globals present in whatever state is live (a one-shot registration is lost
+     *        the first time the state is torn down and rebuilt).
+     */
+    void* __cdecl hkFrameScriptInit(void* arg)
+    {
+        void* r = g_origFrameScriptInit(arg); // let the client finish building the state first
+        RegisterBridge();
+        WLOG_INFO("phasing: terrain Lua bridge registered into FrameScript state %p", LuaState());
+        return r;
+    }
+
     void Install()
     {
         wxl::core::hook::Install("TileLoader", woff::kTileLoader,
                                  reinterpret_cast<void*>(&hkTileLoad),
                                  reinterpret_cast<void**>(&g_origTileLoad));
-        WLOG_INFO("phasing: terrain-phase loader hook installed");
+
+        // Register the terrain bridge into every FrameScript state via a post-hook on
+        // FrameScript_Initialize (see Script.hpp). If a state already exists at install time (injected
+        // mid-session), register into it now -- the hook only fires on subsequent (re)creations.
+        wxl::core::hook::Install("FrameScriptInit", se::kFrameScriptInitialize,
+                                 reinterpret_cast<void*>(&hkFrameScriptInit),
+                                 reinterpret_cast<void**>(&g_origFrameScriptInit));
+        if (LuaState())
+            RegisterBridge();
+
+        WLOG_INFO("phasing: terrain-phase loader hook + Lua bridge installed");
     }
 }
