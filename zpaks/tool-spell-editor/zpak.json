{
  "$schema": "../../schemas/zpak.schema.json",
  "name": "tool-spell-editor",
  "version": "0.1.0",
  "description": "WoW Spell Editor (stoneharry/WoW-Spell-Editor) - forge-tracked source + Zeppelin custom-effect patches (F-188)",
  "author": "Zeppelin Team",
  "type": "acore-extension",
  "contents": {
    "patches": [
      "patches/*.patch"
    ]
  },
  "acore": {
    "module": "spell-editor",
