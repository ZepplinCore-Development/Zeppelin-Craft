{
 "$schema": "../../schemas/zpak.schema.json",
 "name": "zep-hd-curated",
 "version": "0.1.0",
 "description": "F-216 curated HD collection: exactly the model/texture files picked in the model viewer, pulled from the community HD packs (Asset Library). Generated by `zep model curate --apply` straight into mpq/parsed-assets - no source-assets, so the resource parser never runs over already-parsed files. Ship with `zep build patch-mpq -p Q --build`.",
 "author": "Zeppelin Team",
 "type": "mpq",
 "client_patch": "PATCH-Q",
 "enabled": true,
 "priority": 30,
 "patch_display_name": "HD Models (curated)",
 "feature_id": "F-216",
 "build": {
  "split": [
   {
    "piece": "01",
    "match": [
     "CREATURE/[A-D]*"
    ]
   },
   {
    "piece": "02",
    "match": [
     "CREATURE/[E-L]*"
    ]
   },
   {
    "piece": "03",
    "match": [
     "CREATURE/[M-R]*"
    ]
   },
   {
    "piece": "04",
    "match": [
     "CREATURE/*"
    ]
   },
   {
    "piece": "05",
    "match": [
     "CHARACTER/*"
    ]
   },
   {
    "piece": "06",
    "match": [
     "ITEM/OBJECTCOMPONENTS/*"
    ]
   },
   {
    "piece": "07",
    "match": [
     "ITEM/*"
    ]
   },
   {
    "piece": "08",
    "match": [
     "TEXTURES/BAKEDNPCTEXTURES/CREATUREDISPLAYEXTRA-0*"
    ]
   },
   {
    "piece": "09",
    "match": [
     "TEXTURES/BAKEDNPCTEXTURES/CREATUREDISPLAYEXTRA-1[0-4]*"
    ]
   },
   {
    "piece": "10",
    "match": [
     "TEXTURES/BAKEDNPCTEXTURES/*"
    ]
   },
   {
    "piece": "11",
    "match": [
     "WORLD/EXPANSION0[12]/*"
    ]
   },
   {
    "piece": "12",
    "match": [
     "WORLD/EXPANSION*"
    ]
   },
   {
    "piece": "13",
    "match": [
     "WORLD/*"
    ]
   },
   {
    "piece": "14",
    "match": [
     "DUNGEONS/*"
    ]
   },
   {
    "piece": "15",
    "match": [
     "*"
    ]
   }
  ]
 }
}
