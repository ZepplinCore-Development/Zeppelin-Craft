{
 "_doc": "F-216: fixes applied by `zep model curate` (and the model picker's panes) to community-pack files it ships. Keyed by lowercase path. base_sha256 = the pack file the recipe was written for: a different file (pack update) skips the recipe with a warning. 'ship' = extra files the fixed model needs, taken from the same option's sources. Ops: cli/lib/m2_ops.py.",
 "creature/golemstone/golemcannonstone.m2": {
  "source": "patch-hd-everything",
  "note": "Texture 1 (the reflection layer the body batch combines with its skin) lost its filename in conversion: type 0, empty name -> the golem draws black. Give it the reflection map its sibling golemstone.m2 in the same pack uses.",
  "base_sha256": "8097f23e14d9e5181599872fca48d7de729d183e04b32f6dd8910edd7541f114",
  "result_sha256": "1111b211f8cbf6b1d0a450d65e96d66e52783e405e6068c899be0bf18fef21af",
  "ops": [
   {
    "op": "m2.texture.set",
    "index": 1,
    "expect_type": 0,
    "expect_name": "",
    "name": "Creature\\Golemstone\\orbreflect02.blp"
   }
  ],
  "ship": [
   "creature/golemstone/orbreflect02.blp"
  ]
 },
 "creature/gryphon/gryphon_mount.m2": {
  "source": "patch-hd-everything",
  "note": "The pack's gryphon_mount is the elite gryphon mesh. Texture 0 names CREATURE\\ELITEGRYPHON\\ELITEGRYPHON.BLP but is typed 11 (display skin), so the client ignores the name and paints the display's Gryphon_Skin (made for the regular gryphon) -> scrambled. Make it a fixed texture (type 0).",
  "base_sha256": "f167c8f81345ccaad1c51b397bdfb555feea1818369554d7f038df86b10cfbb7",
  "result_sha256": "272b958d0c67c5d141068fb05b68bf1ccc53df204d3dd765e2dad54368c04457",
  "ops": [
   {
    "op": "m2.texture.set",
    "index": 0,
    "expect_type": 11,
    "expect_name": "CREATURE\\ELITEGRYPHON\\ELITEGRYPHON.BLP",
    "type": 0
   }
  ],
  "ship": [
   "creature/elitegryphon/elitegryphon.blp"
  ]
 },
