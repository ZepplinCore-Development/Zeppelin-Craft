+// Not in the original (F-227): what a spell's value scales with, for the tooltip's "Scales with" line. Same effect
+// classification and coefficient rules as ZepAddCasterBonus.
+uint32_t Spell_C_ZepScalingSources(const SpellRec* spell) {
+    uint32_t sources = 0;
+    const ZepSpellBonus* bonus = ZepGetSpellBonus(spell->m_id);
+
+    for (uint32_t i = 0; i < 3; i++) {
+        int32_t effect = spell->m_effect[i];
+        int32_t aura = spell->m_effectAura[i];
+        bool periodic = aura == 3 || aura == 53 || aura == 8;
+
+        if (!(effect == 2 || effect == 9 || effect == 10 || periodic)) {
+            continue;
+        }
+
+        if (effect == 2 && spell->m_effectMiscValueB[i] && spell->m_effectMiscValue[i] >= 1 && spell->m_effectMiscValue[i] <= 10) {
+            sources |= 1u << (2 + spell->m_effectMiscValue[i]);
+        }
+
+        if (bonus) {
+            if ((periodic ? bonus->dot : bonus->direct) > 0.0f) {
+                sources |= 1;
+            }
+
+            if ((periodic ? bonus->apDot : bonus->ap) > 0.0f) {
+                sources |= 2;
+            }
+        } else if (spell->m_defenseType != 0 && spell->m_effectBonusCoefficient[i] > 0.0f) {
+            sources |= 1;
+        }
+    }
+
+    return sources;
+}
