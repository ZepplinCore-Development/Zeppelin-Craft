+
+bool Spell_C_ZepGetAuraAmounts(uint64_t guid, uint8_t slot, int32_t spellId, int32_t amounts[3], uint8_t* mask) {
+    auto it = s_zepAuraAmounts.find({ guid, slot });
+
+    if (it == s_zepAuraAmounts.end() || it->second.spellId != spellId) {
+        return false;
+    }
+
+    memcpy(amounts, it->second.amount, sizeof(it->second.amount));
+    *mask = it->second.mask;
+    return true;
+}
+
+void Spell_C_ZepSetAuraOverride(int32_t spellId, uint8_t mask, const float values[3]) {
+    s_zepAuraOverride.spellId = spellId;
+    s_zepAuraOverride.mask = mask;
+    memcpy(s_zepAuraOverride.value, values, sizeof(s_zepAuraOverride.value));
+}
+
+void Spell_C_ZepClearAuraOverride() {
+    s_zepAuraOverride.spellId = 0;
+    s_zepAuraOverride.mask = 0;
+}
+
+// SMSG_ZEP_AURA_AMOUNTS = packed target guid, uint8 slot, uint32 spell id, uint8 effect mask, 3 x int32 amount.
+int32_t Packet_SMSG_ZEP_AURA_AMOUNTS(void* param, NETMESSAGE msgId, uint32_t time, CDataStore* msg) {
+    SmartGUID guid;
+    *msg >> guid;
+    uint8_t slot;
+    uint32_t spellId;
+    uint8_t mask;
+    msg->Get(slot);
+    msg->Get(spellId);
+    msg->Get(mask);
+
+    ZepAuraAmounts entry;
+    entry.spellId = static_cast<int32_t>(spellId);
+    entry.mask = mask;
+
+    for (int32_t i = 0; i < 3; i++) {
+        uint32_t value;
+        msg->Get(value);
+        entry.amount[i] = static_cast<int32_t>(value);
+    }
+
+    s_zepAuraAmounts[{ guid.m_guid, slot }] = entry;
+    return 1;
+}
