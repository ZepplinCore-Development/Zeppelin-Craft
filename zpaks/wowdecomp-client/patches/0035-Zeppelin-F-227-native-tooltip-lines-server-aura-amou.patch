+// Not in the original (F-227): the lines the ZepTooltips addon used to add under a spell's description, computed by the
+// client from the same values as $s (spell modifiers per family, spell/attack power, stat scaling):
+// movement speeds, weapon-damage hits, what the value scales with, and crit chance with the crit hit.
+static void ZepFormatRange(char* out, size_t size, float lo, float hi, const char* suffix) {
+    int32_t a = CMath::fint_(lo);
+    int32_t b = CMath::fint_(hi);
+
+    if (a == b) {
+        SStrPrintf(out, size, "%d%s", a, suffix);
+    } else {
+        SStrPrintf(out, size, "%d-%d%s", a, b, suffix);
+    }
+}
+
+static void ZepAddNativeSpellLines(CGTooltip* tooltip, const SpellRec* spell) {
+    CGPlayer_C* player = ClntObjMgrGetActivePlayerObj();
+
+    if (!player || !player->m_player || !player->m_unit) {
+        return;
+    }
+
+    const CImVector color(0xFF, 0xD5, 0x71, 0xFF);   // light blue
+    CGPlayerLocalData* data = static_cast<CGPlayerLocalData*>(player->m_player);
+    char line[256];
+    char range[64];
+    bool speed = false;
+
+    // Movement speeds: one line per speed aura (a flying mount grants Flight and Ground).
+    for (uint32_t i = 0; i < 3; i++) {
+        const char* label = nullptr;
+
+        switch (spell->m_effectAura[i]) {
+            case 31: case 32: case 129: case 130: label = "Ground"; break;
+            case 58: label = "Swim"; break;
+            case 206: case 207: case 208: case 209: case 210: case 211: label = "Flight"; break;
+            default: break;
+        }
+
+        if (label) {
+            float lo;
+            float hi;
+            Spell_C_GetMinMaxPoints(spell, i, &lo, &hi, 0, 0, 0, 0);
+            ZepFormatRange(range, sizeof(range), fabsf(lo), fabsf(hi), "%");
+            SStrPrintf(line, sizeof(line), "%s: %s", label, range);
+            tooltip->AddLine(line, nullptr, color, color, 1);
+            speed = true;
+        }
+    }
+
+    if (speed) {
+        return;
+    }
+
+    // Weapon-damage effects (17 NOSCHOOL, 31 PERCENT, 58 WEAPON, 121 NORMALIZED) on the hand the spell uses.
+    bool weapon = false;
+    float pct = 100.0f;
+    float flat = 0.0f;
+
+    for (uint32_t i = 0; i < 3; i++) {
+        int32_t effect = spell->m_effect[i];
+
+        if (effect == 17 || effect == 31 || effect == 58 || effect == 121) {
+            float lo;
+            float hi;
+            Spell_C_GetMinMaxPoints(spell, i, &lo, &hi, 0, 0, 0, 0);
+            weapon = true;
+
+            if (effect == 31) {
+                pct = lo;
+            } else {
+                flat += lo;
+            }
+        }
+    }
+
+    if (weapon) {
+        CGUnitData* unit = player->m_unit;
+        bool ranged = spell->m_defenseType == 3;
+        bool offhand = (spell->m_attributesExC & 0x01000000) != 0;   // SPELL_ATTR3_REQ_OFFHAND
+        float wlo = ranged ? unit->m_unitFieldMinrangeddamage : offhand ? unit->m_unitFieldMinoffhanddamage : unit->m_unitFieldMindamage;
+        float whi = ranged ? unit->m_unitFieldMaxrangeddamage : offhand ? unit->m_unitFieldMaxoffhanddamage : unit->m_unitFieldMaxdamage;
+
+        if (whi > 0.0f) {                                            // no line without a weapon in that hand
+            ZepFormatRange(range, sizeof(range), wlo * pct / 100.0f + flat, whi * pct / 100.0f + flat, "");
+            SStrPrintf(line, sizeof(line), "Weapon: %s", range);
+            tooltip->AddLine(line, nullptr, color, color, 1);
+        }
+    }
+
+    // What the value scales with.
+    static const char* const s_statNames[] = { "Spell Power", "Attack Power", "", "block value", "armor", "Attack Power",
+        "Spell Power", "Strength", "Agility", "Stamina", "Intellect", "Spirit", "maximum health" };
+    uint32_t sources = Spell_C_ZepScalingSources(spell);
+
+    if (sources) {
+        char names[160] = "";
+        const char* seen[13] = {};
+        uint32_t count = 0;
+
+        for (uint32_t bit = 0; bit < 13; bit++) {
+            const char* name = s_statNames[bit];
+            bool dup = false;
+
+            for (uint32_t k = 0; k < count; k++) {
+                dup = dup || !SStrCmp(seen[k], name, STORM_MAX_STR);
+            }
+
+            if ((sources & (1u << bit)) && *name && !dup) {
+                SStrPrintf(names + SStrLen(names), sizeof(names) - SStrLen(names), "%s%s", count ? ", " : "", name);
+                seen[count++] = name;
+            }
+        }
+
+        SStrPrintf(line, sizeof(line), "Scales with %s", names);
+        tooltip->AddLine(line, nullptr, color, color, 1);
+    }
+
+    // Crit chance for the spell's first damage/heal effect, plus the crit hit.
+    for (uint32_t i = 0; i < 3; i++) {
+        int32_t effect = spell->m_effect[i];
+        int32_t aura = spell->m_effectAura[i];
+
+        if (!(effect == 2 || effect == 10 || aura == 3 || aura == 8)) {
+            continue;
+        }
+
+        float crit;
+
+        if (spell->m_defenseType == 2) {
+            crit = data->m_playerCritPercentage;
+        } else if (spell->m_defenseType == 3) {
+            crit = data->m_playerRangedCritPercentage;
+        } else {
+            crit = 0.0f;
+
+            for (int32_t school = 0; school < 7; school++) {
+                if ((spell->m_schoolMask & (1 << school)) && data->m_playerSpellCritPercentage1[school] > crit) {
+                    crit = data->m_playerSpellCritPercentage1[school];
+                }
+            }
+        }
+
+        int32_t modFlat;
+        int32_t modPct;
+
+        if (Spell_C_GetSpellModifiers(spell, 7, modFlat, modPct)) {   // SPELLMOD_CRITICAL_CHANCE
+            crit += static_cast<float>(modFlat);
+        }
+
+        if (crit <= 0.0f) {
+            break;
+        }
+
+        float lo;
+        float hi;
+        Spell_C_GetMinMaxPoints(spell, i, &lo, &hi, 0, 0, 0, 0);
+        float bonus = (spell->m_defenseType == 2 || spell->m_defenseType == 3) ? 1.0f : 0.5f;
+        float extra = 0.0f;
+
+        if (Spell_C_GetSpellModifiers(spell, 15, modFlat, modPct)) {  // SPELLMOD_CRIT_DAMAGE_BONUS
+            extra = static_cast<float>(modFlat + modPct - 100);
+        }
+
+        float mult = 1.0f + bonus * (1.0f + extra / 100.0f);
+        ZepFormatRange(range, sizeof(range), fabsf(lo) * mult, fabsf(hi) * mult, "");
+        SStrPrintf(line, sizeof(line), "Crit: ~%d%% (%s)", CMath::fint_(crit), range);
+        tooltip->AddLine(line, nullptr, color, color, 1);
+        break;
+    }
+}
