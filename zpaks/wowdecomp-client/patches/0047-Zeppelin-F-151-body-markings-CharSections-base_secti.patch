+
+// Not in the original (F-151): blends one section of a full-atlas layer (palettized, 8-bit alpha) over what is
+// already there, every mip. The stock PasteTransparent8Bit takes section-sized layers only: it ignores the source
+// position and expects the alpha plane straight after a section-high index plane. Nearest sampling, so a layer of
+// another size than the composite still lands on the same UVs.
+void CCharacterComponent::PasteOverlay(COMPONENT_SECTIONS section, void* texture, MipBits* dstMips) {
+    if (!TextureCacheHasMips(texture)) {
+        return;
+    }
+
+    TCTEXTUREINFO info;
+    info.m_width = 0;
+    info.m_height = 0;
+    info.m_mipCount = 0;
+    info.m_alphaSize = 0;
+    info.m_opaque = 1;
+    TextureCacheGetInfo(texture, info, 1);
+    const BlpPalPixel* pal = TextureCacheGetPal(texture);
+
+    if (!pal || info.m_alphaSize != 8 || !info.m_width || !info.m_height) {
+        return;
+    }
+
+    // the source mip matching the composite's size (or the full texture when it is smaller)
+    uint32_t srcMip = 0;
+    uint32_t srcWidth = info.m_width;
+    uint32_t srcHeight = info.m_height;
+
+    while (srcWidth > s_textureSize && srcMip + 1 < info.m_mipCount) {
+        srcWidth >>= 1;
+        srcHeight >>= 1;
+        srcMip++;
+    }
+
+    const CompSectionInfo& sec = s_sectionInfo[section];
+    uint32_t dstSize = s_textureSize;
+
+    for (uint32_t mip = 0; srcMip + mip < info.m_mipCount && (dstSize >> mip) && (sec.m_size.x >> mip) && (sec.m_size.y >> mip); mip++) {
+        uint32_t w = srcWidth >> mip ? srcWidth >> mip : 1;
+        uint32_t h = srcHeight >> mip ? srcHeight >> mip : 1;
+        uint32_t size = dstSize >> mip;
+        const uint8_t* index = static_cast<const uint8_t*>(TextureCacheGetMip(texture, srcMip + mip));
+        const uint8_t* alpha = index + w * h;
+        uint8_t* dst = reinterpret_cast<uint8_t*>(dstMips->m_mip[mip]);
+
+        if (!index || !dst) {
+            break;
+        }
+
+        for (int32_t y = sec.m_pos.y >> mip; y < (sec.m_pos.y + sec.m_size.y) >> mip; y++) {
+            uint32_t sy = static_cast<uint32_t>(y) * h / size;
+
+            for (int32_t x = sec.m_pos.x >> mip; x < (sec.m_pos.x + sec.m_size.x) >> mip; x++) {
+                uint32_t i = static_cast<uint32_t>(x) * w / size + w * sy;
+                uint32_t a = alpha[i];
+
+                if (!a) {
+                    continue;
+                }
+
+                const BlpPalPixel& color = pal[index[i]];
+                uint8_t* pixel = dst + 4 * (static_cast<uint32_t>(y) * size + static_cast<uint32_t>(x));
+                pixel[2] = ((255 - a) * pixel[2] + a * color.m_r) >> 8;
+                pixel[1] = ((255 - a) * pixel[1] + a * color.m_g) >> 8;
+                pixel[0] = ((255 - a) * pixel[0] + a * color.m_b) >> 8;
+            }
+        }
+
+        if (srcWidth < s_textureSize) {
+            break;   // a smaller layer only reaches the top mip, as the stock scaled pastes do
+        }
+    }
+}
