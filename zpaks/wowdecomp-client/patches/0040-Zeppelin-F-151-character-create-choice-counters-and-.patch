+// Not in the original (F-151): GetCharCustomizationInfo(index) -> position, count. The choices of one
+// customization button that its cycle can reach for the selected race, sex and class (the same record and
+// flag checks as CCharacterComponent::SetNext*), and the 1-based position of the current choice among them
+// (0 when the current value is not one of them). Lets the glue screens show "3/20" on each button.
+static bool CharCustomizationReachable(CHAR_CUSTOMIZATION_TYPE type, int32_t value) {
+    const CharacterPreferences& prefs = CCharacterCreation::m_character->m_data.m_preferences;
+    COMPONENT_SELECTION selection = GetSelectionFromContext(COMPONENT_CONTEXT_0, prefs.m_classId);
+    st_race* lookup = CCharacterComponent::s_chrVarArray;
+    auto ok = [&](COMPONENT_VARIATIONS variation, int32_t index, int32_t color) {
+        CharSectionsRec* rec = ComponentGetSectionsRecord(lookup, prefs.m_raceID, prefs.m_sexID, variation, index, color, nullptr);
+        return rec && ComponentFlagsMatch(rec->m_flags, selection);
+    };
+    auto skinOk = [&](int32_t skin, int32_t face) {
+        return ok(VARIATION_SKIN, 0, skin) && ok(VARIATION_FACE, face, skin) && ok(VARIATION_UNDERWEAR, 0, skin);
+    };
+
+    switch (type) {
+        case CHAR_CUSTOMIZATION_SKIN:
+            return skinOk(value, prefs.m_faceId);
+        case CHAR_CUSTOMIZATION_FACE: {
+            int32_t numColors = ComponentGetNumColors(lookup, prefs.m_raceID, prefs.m_sexID, VARIATION_FACE, value);
+            for (int32_t skin = 0; skin < numColors; skin++) {
+                if (skinOk(skin, value)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+        case CHAR_CUSTOMIZATION_HAIR_STYLE:
+        case CHAR_CUSTOMIZATION_FACIAL_FEATURE: {
+            COMPONENT_VARIATIONS variation = type == CHAR_CUSTOMIZATION_HAIR_STYLE ? VARIATION_HAIR : VARIATION_FACIAL_HAIR;
+            if (type == CHAR_CUSTOMIZATION_FACIAL_FEATURE
+                && value >= static_cast<int32_t>(CCharacterComponent::s_characterFacialHairStylesList[prefs.m_raceID * 2 + prefs.m_sexID])) {
+                return false;   // SetBeardStyle refuses it (I-419)
+            }
+            int32_t numColors = ComponentGetNumColors(lookup, prefs.m_raceID, prefs.m_sexID, variation, value);
+            for (int32_t color = 0; color < numColors; color++) {
+                if (ok(variation, value, color)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+        case CHAR_CUSTOMIZATION_HAIR_COLOR:
+            return ok(VARIATION_HAIR, prefs.m_hairStyleId, value);
+        default:
+            return false;
+    }
+}
+
+static int32_t Script_GetCharCustomizationInfo(lua_State* L) {
+    if (!lua_isnumber(L, 1)) {
+        luaL_error(L, "Usage: GetCharCustomizationInfo(index)");
+        return 0;
+    }
+
+    if (!CCharacterCreation::m_character) {
+        return 0;
+    }
+
+    CHAR_CUSTOMIZATION_TYPE type = static_cast<CHAR_CUSTOMIZATION_TYPE>(static_cast<int32_t>(lua_tonumber(L, 1)) - 1);
+    const CharacterPreferences& prefs = CCharacterCreation::m_character->m_data.m_preferences;
+    int32_t current, total;
+
+    switch (type) {
+        case CHAR_CUSTOMIZATION_SKIN:
+            current = prefs.m_skinID;
+            total = ComponentGetNumColors(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, VARIATION_SKIN, 0);
+            break;
+        case CHAR_CUSTOMIZATION_FACE:
+            current = prefs.m_faceId;
+            total = ComponentGetNumVariations(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, VARIATION_FACE);
+            break;
+        case CHAR_CUSTOMIZATION_HAIR_STYLE:
+            current = prefs.m_hairStyleId;
+            total = ComponentGetNumVariations(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, VARIATION_HAIR);
+            break;
+        case CHAR_CUSTOMIZATION_HAIR_COLOR:
+            current = prefs.m_hairColorId;
+            total = ComponentGetNumColors(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, VARIATION_HAIR, prefs.m_hairStyleId);
+            break;
+        case CHAR_CUSTOMIZATION_FACIAL_FEATURE:
+            current = prefs.m_facialHairId;
+            total = ComponentGetNumVariations(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, VARIATION_FACIAL_HAIR);
+            break;
+        default:
+            return 0;
+    }
+
+    int32_t position = 0, count = 0;
+    for (int32_t value = 0; value < total; value++) {
+        if (CharCustomizationReachable(type, value)) {
+            count++;
+            if (value == current) {
+                position = count;
+            }
+        }
+    }
+
+    lua_pushnumber(L, position);
+    lua_pushnumber(L, count);
+    return 2;
+}
+
+// Not in the original (F-151): SetCharacterCreateZoom(zoom 0..1) moves the character-create camera toward the
+// character's head (attachment 11), see ZepSetCameraZoomFocus in CSimpleModel.cpp.
+void ZepSetCameraZoomFocus(CSimpleModel* model, float zoom, bool (*focus)(C3Vector& point));
+
+static bool CharacterCreateHead(C3Vector& point) {
+    CM2Model* model = CCharacterCreation::m_character ? CCharacterCreation::m_character->m_data.m_model : nullptr;
+
+    if (!model || !(model->m_fFlags & 1) || !model->HasAttachment(11)) {
+        return false;
+    }
+
+    point = model->GetAttachmentPosition(11);
+    return true;
+}
+
+static int32_t Script_SetCharacterCreateZoom(lua_State* L) {
+    if (!lua_isnumber(L, 1)) {
+        luaL_error(L, "Usage: SetCharacterCreateZoom(zoom)");
+        return 0;
+    }
+
+    if (CCharacterCreation::m_charCustomizeFrame) {
+        ZepSetCameraZoomFocus(CCharacterCreation::m_charCustomizeFrame, static_cast<float>(lua_tonumber(L, 1)), &CharacterCreateHead);
+    }
+
+    return 0;
+}
