+// Not in the original (F-151): per-frame camera zoom toward a point another model supplies (character create:
+// the character's head attachment), kept outside the class layout. ZepSetCameraZoomFocus(model, zoom 0..1,
+// focus): the eye moves toward the point by zoom * ZOOM_FOCUS_MAX of the distance and the look-at point blends
+// from the camera's target to it, so zoom 0 is the stock framing.
+struct ZepCameraZoom {
+    float zoom;
+    bool (*focus)(C3Vector& point);
+};
+
+static std::unordered_map<const CSimpleModel*, ZepCameraZoom> s_zepCameraZoom;
+static const float ZOOM_FOCUS_MAX = 0.75f;
+
+void ZepSetCameraZoomFocus(CSimpleModel* model, float zoom, bool (*focus)(C3Vector& point)) {
+    if (zoom <= 0.0f || !focus) {
+        s_zepCameraZoom.erase(model);
+    } else {
+        s_zepCameraZoom[model] = { zoom, focus };
+    }
+}
+
+static void ZepApplyCameraZoom(const CSimpleModel* model, CCamera* camera) {
+    auto it = s_zepCameraZoom.find(model);
+
+    if (it == s_zepCameraZoom.end()) {
+        return;
+    }
+
+    const C3Vector& pos = camera->m_position.m_data;
+    C3Vector target(camera->m_target.m_data.x - pos.x, camera->m_target.m_data.y - pos.y, camera->m_target.m_data.z - pos.z);
+    C3Vector point;
+
+    if (!it->second.focus(point)) {
+        return;
+    }
+
+    float z = it->second.zoom > 1.0f ? 1.0f : it->second.zoom;
+    C3Vector focus(point.x - pos.x, point.y - pos.y, point.z - pos.z);
+    C3Vector eye(focus.x * z * ZOOM_FOCUS_MAX, focus.y * z * ZOOM_FOCUS_MAX, focus.z * z * ZOOM_FOCUS_MAX);
+    C3Vector center(target.x + (focus.x - target.x) * z, target.y + (focus.y - target.y) * z, target.z + (focus.z - target.z) * z);
+    C3Vector up(camera->m_rotation.m_sin * camera->m_roll.m_sin, -(camera->m_rotation.m_cos * camera->m_roll.m_sin), camera->m_roll.m_cos);
+    C44Matrix view;
+    GxuXformCreateLookAtSgCompat(eye, center, up, view);
+    g_theGxDevicePtr->XformSetView(view);
+    CShaderEffect::UpdateProjMatrix();
+}
+
