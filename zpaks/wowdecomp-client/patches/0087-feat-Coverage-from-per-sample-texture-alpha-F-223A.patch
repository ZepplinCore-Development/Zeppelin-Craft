+
+    VkShaderModule GetSampleAlphaCoverage(const char* name, bool isPath, uint32_t samples)
+    {
+        if (!s.ready || !name || !*name || std::strlen(name) + 5 > kMaxName) return VK_NULL_HANDLE;
