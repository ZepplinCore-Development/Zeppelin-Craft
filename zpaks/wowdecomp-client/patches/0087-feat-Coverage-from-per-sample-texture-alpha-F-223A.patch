+            {
+                const uint32_t op = words[i] & 0xFFFFu, n = words[i] >> 16;
+                const uint32_t* a = &words[i + 1];
+                if (op == opFunction && n >= 5) body = words[i + 2] == entry;
+                if (body)
+                {
+                    // the first block ends at its merge declaration or terminator (OpLabel 248 starts it)
+                    if (op >= 246u && op <= 255u && op != opLabel) break;
+                    switch (op)
+                    {
+                    case 61: case 79: case 80: case 81: case 83: case 12: case 127: case 129: case 131: case 133:
