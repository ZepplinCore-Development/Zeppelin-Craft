+    // Called by CGWorldFrame::OnWorldRender after FFX::Finish: hands the depth buffer back.
+    void FogFinishWorld();
+    // Called by the D3D9 device before it releases its resources (window resize, device lost).
+    void FogReleaseDeviceResources();
