diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/CataBlur.comp b/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/CataBlur.comp
new file mode 100644
index 00000000..b1774811
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/CataBlur.comp
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// HD: Cata's blurred back buffer (s3 of the water without a mirror). Cata KawaseBlur (WorldView.cpp,
+// LiquidProcTextures.cpp): the scene stretched into 512x512, then four-tap diagonal passes ping-ponged,
+// each one a quarter texel further out. taps 1: the stretch (one bilinear sample); taps 4: one pass.
+// Dispatch ceil(512/8) a side; dst is GENERAL.
+#version 450
+layout(local_size_x=8, local_size_y=8) in;
+layout(set=0,binding=0) uniform sampler2D src;
+layout(set=0,binding=1,rgba8) uniform writeonly image2D dst;
+layout(push_constant) uniform Push { vec2 texel; vec2 offset; uint taps; } pc;
+void main() {
+    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 size = imageSize(dst);
+    if (any(greaterThanEqual(pos,size))) return;
+    vec2 uv = (vec2(pos) + 0.5) / vec2(size);
+    vec4 color;
+    if (pc.taps == 1u) {
+        color = textureLod(src,uv,0.0);
+    } else {
+        vec2 d = pc.texel * 0.5 + pc.offset;
+        color = (textureLod(src,uv + vec2(-d.x,-d.y),0.0) + textureLod(src,uv + vec2(d.x,-d.y),0.0) +
+                 textureLod(src,uv + vec2(-d.x,d.y),0.0) + textureLod(src,uv + vec2(d.x,d.y),0.0)) * 0.25;
+    }
+    imageStore(dst,pos,color);
+}
