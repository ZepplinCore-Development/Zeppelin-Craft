index 00000000..2005b0f9
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/draw/Cmd.hpp
@@ -0,0 +1,323 @@
+// One engine draw, read off the device at slot 42 and ready to be issued through Vulkan.
+// Copyright (C) 2026 WarcraftXL
+//
