+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/render/Jitter.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/render/Jitter.cpp
new file mode 100644
index 00000000..ba5746c5
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/render/Jitter.cpp
@@ -0,0 +1,101 @@
+// The world's sub-pixel jitter, for a temporal resolve.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "native/render/Jitter.hpp"
+
+#include "native/Present.hpp"
+
+namespace
+{
+    constexpr uint32_t kSamples = 8;
+
+    /// The radical inverse of `i` in `base`: the Halton sequence.
+    float Halton(uint32_t i, uint32_t base)
+    {
+        float f = 1.0f, r = 0.0f;
+        for (; i > 0; i /= base)
+        {
+            f /= static_cast<float>(base);
+            r += f * static_cast<float>(i % base);
+        }
+        return r;
+    }
+
+    struct State
+    {
+        bool     inWorld  = false;
+        bool     active   = false;
+        uint32_t requests = 0;   ///< consumers asking for the jitter (RequestJitter)
+        uint32_t index    = 0;
+        float    x        = 0.0f;
+        float    y        = 0.0f;
+        uint64_t jittered = 0;
+        uint64_t skipped  = 0;
+    };
+    State g;
+}
+
+namespace wxlvk::native::render::jitter
+{
+    void BeginWorld()
+    {
+        g.inWorld = true;
+        g.active = g.requests > 0;
+        if (!g.active)
+        {
+            g.x = g.y = 0.0f;
+            return;
+        }
+        g.index = g.index % kSamples + 1;   // 1 .. 8: Halton(0) is 0 in both bases
+        g.x = Halton(g.index, 2) - 0.5f;
+        g.y = Halton(g.index, 3) - 0.5f;
+    }
+
+    void EndWorld() { g.inWorld = false; }
+
+    void Apply(VkViewport& viewport)
+    {
+        if (!g.inWorld || !g.active || !wxlvk::native::present::OnBackBuffer()) return;
+        if (viewport.maxDepth >= 0.999f)
+        {
+            ++g.skipped;
+            return;
+        }
+        viewport.x += g.x;
+        viewport.y += g.y;
+        ++g.jittered;
+    }
+
+    void Current(float& x, float& y)
+    {
+        x = g.active ? g.x : 0.0f;
+        y = g.active ? g.y : 0.0f;
+    }
+
+    bool Active() { return g.active; }
+
+    void Request(bool wanted)
+    {
+        if (wanted) ++g.requests;
+        else if (g.requests > 0) --g.requests;
+    }
+
+    void Counts(uint64_t& jittered, uint64_t& skipped)
+    {
+        jittered = g.jittered;
+        skipped  = g.skipped;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/render/Jitter.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/render/Jitter.hpp
new file mode 100644
index 00000000..a4d0b63d
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/render/Jitter.hpp
@@ -0,0 +1,62 @@
+// The world's sub-pixel jitter, for a temporal resolve.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include "vulkan/Vk.hpp"
+
+#include <cstdint>
+
+// The jitter moves a draw's Vulkan viewport origin by a sub-pixel offset (an 8-sample Halton 2/3
+// sequence, one sample per world frame), which shifts everything the draw rasterises by exactly
+// that much and changes nothing else -- no projection is touched, so no shader constant, no
+// culling and no engine state sees it. A draw is jittered when all three hold:
+//
+//   - it is recorded inside the world scene pass (between the entry and the return of the core's
+//     Gx.WorldOnRender, src/native/render/WorldPass.cpp): the world text and the interface come after it;
+//   - its pass is on the back buffer: portraits and other texture targets keep still;
+//   - its viewport's depth range ends below 1: the world draws in 0 .. 0.94, and the engine's own
+//     full-screen passes inside the world pass (glow composite, screen effects), which resample an
+//     image already drawn, use 0 .. 1 and are left alone.
+//
+// It is on only while a consumer asks for it (wxl.vk.render RequestJitter: a temporal resolve); the
+// counters let a log confirm the split.
+namespace wxlvk::native::render::jitter
+{
+    /// A consumer asks for the jitter (`wanted`) or stops asking. Counted; it applies from the next
+    /// world pass.
+    void Request(bool wanted);
+
+    /// The world scene pass begins: the next jitter sample, while any consumer asks for it.
+    void BeginWorld();
+
+    /// The world scene pass ended.
+    void EndWorld();
+
+    /// Moves a draw's viewport by the jitter when the draw qualifies (see above). From every
+    /// place a draw's viewport is made (src/native/Draw.cpp).
+    void Apply(VkViewport& viewport);
+
+    /// The jitter of the latest world pass, in pixels (0, 0 when it was off).
+    void Current(float& x, float& y);
+
+    /// Whether the latest world pass was jittered.
+    bool Active();
+
+    /// Draws jittered, and draws inside the world pass on the back buffer left alone for their
+    /// depth range, since the start.
+    void Counts(uint64_t& jittered, uint64_t& skipped);
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/render/Stages.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/render/Stages.cpp
