+    // HD: blend two Forever fogs, t = 0 keeps a, 1 gives b
+    void LerpFog(HD::ForeverFog& a, const HD::ForeverFog& b, float t) {
+        for (int i = 0; i < 3; i++) HD::LerpFogLayer(a.layers[i], b.layers[i], t);
+        if (b.count > a.count) a.count = b.count;
+    }
