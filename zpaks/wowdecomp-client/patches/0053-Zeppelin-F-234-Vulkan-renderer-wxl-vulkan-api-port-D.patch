+#include "vulkan/context/Internal.hpp"
+
+namespace wxlvk::vk::context::detail
+{
+    State g;
+    ValidationTable g_validation;
+
+    /**
+     * Whether an extension name appears in an enumerated list.
+     *
+     * @param vector list : what vkEnumerate*ExtensionProperties returned
+     * @param string name : the extension name, e.g. VK_KHR_SWAPCHAIN_EXTENSION_NAME
+     * @return bool present
+     */
+    bool HasExtension(const std::vector<VkExtensionProperties>& list, const char* name)
+    {
+        for (const VkExtensionProperties& e : list)
+            if (std::strcmp(e.extensionName, name) == 0) return true;
+        return false;
+    }
+
+    /**
+     * The validation layer's own output, routed into the core's log.
+     *
+     * Each message is one line: `vulkan: validation <ERROR|WARN|info> #n [<id name>] <message>`,
+     * the message being the layer's own text (it names the objects, the VUID and the spec's
+     * sentence). An id's sixth and later occurrences are counted, not logged (kValidationRepeats);
+     * the fifth says so.
+     *
+     * Returns VK_FALSE unconditionally, which is what the spec requires of an application callback:
+     * VK_TRUE is reserved for the layers' own internal tests and aborts the call.
+     *
+     * @param VkDebugUtilsMessageSeverityFlagBitsEXT severity : one bit
+     * @param VkDebugUtilsMessageTypeFlagsEXT types : general / validation / performance
+     * @param VkDebugUtilsMessengerCallbackDataEXT* data : the message
+     * @param void* user : unused
+     * @return VkBool32 VK_FALSE
+     */
+    VKAPI_ATTR VkBool32 VKAPI_CALL DebugCallback(
+        VkDebugUtilsMessageSeverityFlagBitsEXT severity,
+        VkDebugUtilsMessageTypeFlagsEXT        types,
+        const VkDebugUtilsMessengerCallbackDataEXT* data,
+        void*                                  user)
+    {
+        (void)user;
+
+        int         level = WXL_LOG_DEBUG;
+        const char* tag   = "info";
+        if (severity & VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT)        { level = WXL_LOG_ERROR; tag = "ERROR"; }
+        else if (severity & VK_DEBUG_UTILS_MESSAGE_SEVERITY_WARNING_BIT_EXT) { level = WXL_LOG_WARN;  tag = "WARN"; }
+        if (level == WXL_LOG_WARN && (types & VK_DEBUG_UTILS_MESSAGE_TYPE_PERFORMANCE_BIT_EXT)) tag = "perf";
+
+        const int32_t id   = data ? data->messageIdNumber : 0;
+        const char*   name = (data && data->pMessageIdName) ? data->pMessageIdName : "?";
+        uint64_t      nth  = 0;
+        AcquireSRWLockExclusive(&g_validation.lock);
+        if (level == WXL_LOG_ERROR) ++g_validation.errors;
+        if (level == WXL_LOG_WARN) ++g_validation.warnings;
+        uint32_t i = 0;
+        for (; i < g_validation.idCount; ++i)
+            if (g_validation.ids[i].id == id && std::strncmp(g_validation.ids[i].name, name, sizeof g_validation.ids[i].name - 1) == 0)
+                break;
+        if (i == g_validation.idCount && g_validation.idCount < kValidationIds)
+        {
+            ValidationId& e = g_validation.ids[g_validation.idCount++];
+            e.id    = id;
+            e.level = level;
+            std::strncpy(e.name, name, sizeof e.name - 1);
+            e.name[sizeof e.name - 1] = '\0';
+        }
+        if (i < g_validation.idCount) nth = ++g_validation.ids[i].count;
+        else ++g_validation.untracked;
+        ReleaseSRWLockExclusive(&g_validation.lock);
+
+        if (nth > kValidationRepeats) return VK_FALSE;
+        wxl::ScriptMgr::Log(level, "vulkan: validation %s #%llu [%s]%s %s", tag,
+                            static_cast<unsigned long long>(nth ? nth : 1), name,
+                            nth == kValidationRepeats ? " (further occurrences of this id are counted only)" : "",
+                            (data && data->pMessage) ? data->pMessage : "(no message)");
+        return VK_FALSE;
+    }
+    /// The messenger's create info, shared by the instance pNext chain and the real messenger.
+    VkDebugUtilsMessengerCreateInfoEXT MessengerInfo()
+    {
+        VkDebugUtilsMessengerCreateInfoEXT info = {};
+        info.sType = VK_STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT;
+        // VERBOSE is left out on purpose: on a 32-bit client whose log is a file, the verbose
+        // channel is thousands of lines per instance creation and would bury everything else.
+        info.messageSeverity = VK_DEBUG_UTILS_MESSAGE_SEVERITY_INFO_BIT_EXT
+                             | VK_DEBUG_UTILS_MESSAGE_SEVERITY_WARNING_BIT_EXT
+                             | VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT;
+        info.messageType = VK_DEBUG_UTILS_MESSAGE_TYPE_GENERAL_BIT_EXT
+                         | VK_DEBUG_UTILS_MESSAGE_TYPE_VALIDATION_BIT_EXT
+                         | VK_DEBUG_UTILS_MESSAGE_TYPE_PERFORMANCE_BIT_EXT;
+        info.pfnUserCallback = &DebugCallback;
+        return info;
+    }
+
+    /**
+     * Logs one address-space measurement against the baseline.
+     *
+     * @param string phase : what was just created
+     * @param Snapshot& now : the measurement
+     */
+    void LogFootprint(const char* phase, const footprint::Snapshot& now)
+    {
+        wxl::ScriptMgr::Log(WXL_LOG_DEBUG,
+                            "vulkan: address space after %s: committed %u MiB (%+d), reserved %u MiB "
+                            "(%+d), largest free block %u MiB",
+                            phase, footprint::Mib(now.committed),
+                            footprint::MibDelta(now.committed, g.baseline.committed),
+                            footprint::Mib(now.reserved),
+                            footprint::MibDelta(now.reserved, g.baseline.reserved),
+                            footprint::Mib(now.largestFree));
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Instance.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Instance.cpp
new file mode 100644
index 00000000..fae2fe3f
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Instance.cpp
@@ -0,0 +1,201 @@
+// The Vulkan instance: the loader, the layers, the extensions.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "vulkan/context/Internal.hpp"
+
+namespace wxlvk::vk::context::detail
+{
+    // --- instance ---------------------------------------------------------------------------------
+
+    /**
+     * Creates the instance, with the Win32 surface extensions and optionally validation.
+     *
+     * The device's own drawing needs only apiVersion 1.0: nothing it draws uses a function past
+     * Vulkan 1.0 core plus VK_KHR_surface / VK_KHR_win32_surface / VK_KHR_swapchain. It asks for the
+     * loader's own version capped at 1.2 (Caps.cpp InstanceVersion), because the optional capabilities
+     * the modules may use -- FP16, 16-bit storage, subgroups, multiview, the memory budget -- are probed
+     * and enabled through 1.1 core (vkGetPhysicalDeviceFeatures2 and its chains). A loader without
+     * vkEnumerateInstanceVersion is 1.0 and gets a 1.0 instance, as before; WXL_VK_CAPS off asks for 1.0.
+     *
+     * @return bool ok
+     */
+    bool CreateInstance()
+    {
+        const loader::Global& api = loader::Api();
+
+        uint32_t count = 0;
+        if (api.EnumerateInstanceExtensionProperties(nullptr, &count, nullptr) != VK_SUCCESS)
+            return false;
+        std::vector<VkExtensionProperties> available(count);
+        if (count && api.EnumerateInstanceExtensionProperties(nullptr, &count, available.data())
+                         != VK_SUCCESS)
+            return false;
+        available.resize(count);
+
+        // Both are hard requirements: without them there is no surface, and without a surface the
+        // physical-device choice cannot be made on present support, which is the only defensible way
+        // to make it.
+        if (!HasExtension(available, VK_KHR_SURFACE_EXTENSION_NAME)
+            || !HasExtension(available, VK_KHR_WIN32_SURFACE_EXTENSION_NAME))
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                "vulkan: the loader offers %u instance extension(s) but not both of "
+                                "%s and %s; declining",
+                                count, VK_KHR_SURFACE_EXTENSION_NAME,
+                                VK_KHR_WIN32_SURFACE_EXTENSION_NAME);
+            return false;
+        }
+
+        std::vector<const char*> extensions;
+        extensions.push_back(VK_KHR_SURFACE_EXTENSION_NAME);
+        extensions.push_back(VK_KHR_WIN32_SURFACE_EXTENSION_NAME);
+        wxlvk::host::ExtendInstance(available, extensions);   // WXL_HOST only: the interop capabilities
+
+        std::vector<const char*> layers;
+        if (settings::ValidationWanted())
+        {
+            static const char* const kValidationLayer = "VK_LAYER_KHRONOS_validation";
+
+            bool layerPresent = false;
+            if (api.EnumerateInstanceLayerProperties)
+            {
+                uint32_t layerCount = 0;
+                if (api.EnumerateInstanceLayerProperties(&layerCount, nullptr) == VK_SUCCESS)
+                {
+                    std::vector<VkLayerProperties> props(layerCount);
+                    if (layerCount
+                        && api.EnumerateInstanceLayerProperties(&layerCount, props.data()) == VK_SUCCESS)
+                    {
+                        props.resize(layerCount);
+                        for (const VkLayerProperties& p : props)
+                            if (std::strcmp(p.layerName, kValidationLayer) == 0) layerPresent = true;
+                    }
+                }
+            }
+
+            // Requested is not enabled. A layer that is not installed must be a log line, not a
+            // VK_ERROR_LAYER_NOT_PRESENT from vkCreateInstance -- the user asked for validation, not
+            // for the device to fail without it.
+            if (layerPresent && HasExtension(available, VK_EXT_DEBUG_UTILS_EXTENSION_NAME))
+            {
+                layers.push_back(kValidationLayer);
+                extensions.push_back(VK_EXT_DEBUG_UTILS_EXTENSION_NAME);
+                g.validation = true;
+                g.debugUtils = true;
+            }
+            else
+            {
+                wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                    "vulkan: %s asked for validation but %s; continuing without it",
+                                    settings::kValidationKey,
+                                    layerPresent ? "the loader has no " VK_EXT_DEBUG_UTILS_EXTENSION_NAME
+                                                 : "VK_LAYER_KHRONOS_validation is not installed");
+            }
+        }
+
+        VkApplicationInfo app = {};
+        app.sType              = VK_STRUCTURE_TYPE_APPLICATION_INFO;
+        app.pApplicationName   = "World of Warcraft 3.3.5a (12340)";
+        app.applicationVersion = VK_MAKE_API_VERSION(0, 3, 3, 5);
+        app.pEngineName        = "WarcraftXL / wxl-vulkan-api";
+        app.engineVersion      = VK_MAKE_API_VERSION(0, 0, 2, 0);
+        app.apiVersion         = InstanceVersion();
+
+        const VkDebugUtilsMessengerCreateInfoEXT messenger = MessengerInfo();
+
+        VkInstanceCreateInfo info = {};
+        info.sType                   = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
+        // Chaining the messenger here, and not only creating one afterwards, is what makes the
+        // layers' complaints about vkCreateInstance itself visible -- they are emitted before any
+        // messenger object can exist.
+        info.pNext                   = g.debugUtils ? &messenger : nullptr;
+        info.pApplicationInfo        = &app;
+        info.enabledLayerCount       = static_cast<uint32_t>(layers.size());
+        info.ppEnabledLayerNames     = layers.empty() ? nullptr : layers.data();
+        info.enabledExtensionCount   = static_cast<uint32_t>(extensions.size());
+        info.ppEnabledExtensionNames = extensions.data();
+
+        VkResult r = api.CreateInstance(&info, nullptr, &g.instance);
+
+        // One retry without layers, and only when layers were requested.
+        //
+        // Enumerating a layer is not the same as being able to load it, and on 32-bit Windows the
+        // difference is routine rather than exotic: a 64-bit Vulkan SDK registers
+        // VK_LAYER_KHRONOS_validation under HKLM\SOFTWARE\WOW6432Node\Khronos\Vulkan\ExplicitLayers
+        // with a manifest whose library_path is the 64-bit DLL. vkEnumerateInstanceLayerProperties
+        // reports it present, the availability check above passes, and vkCreateInstance then fails
+        // with LAYER_NOT_PRESENT or INITIALIZATION_FAILED.
+        //
+        // Without this retry that is a permanent decline. Losing validation is a log line; losing
+        // the device because validation is unloadable is an hour spent on the wrong question.
+        if (r != VK_SUCCESS && !layers.empty())
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                "vulkan: vkCreateInstance failed with %u layer(s) requested: %s. "
+                                "The layer enumerated but would not load -- on a 32-bit process "
+                                "that usually means a 64-bit validation layer is registered. "
+                                "Retrying without layers; validation will be off.",
+                                static_cast<unsigned>(layers.size()), ResultName(r));
+
+            info.enabledLayerCount   = 0;
+            info.ppEnabledLayerNames = nullptr;
+            g.instance               = nullptr;
+
+            r = api.CreateInstance(&info, nullptr, &g.instance);
+            if (r == VK_SUCCESS) g.validation = false;
+        }
+
+        if (r != VK_SUCCESS)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: vkCreateInstance failed: %s", ResultName(r));
+            g.instance = nullptr;
+            return false;
+        }
+
+        if (!loader::LoadInstance(g.instance, g.debugUtils, g.iapi))
+        {
+            // The instance exists but is unusable. Destroy it here rather than leaving it to
+            // Teardown(), because the table it would be destroyed through is the one that just came
+            // back incomplete -- DestroyInstance is the one entry point checked for first, so if it
+            // is present it is safe to use, and if it is not there is nothing to be done anyway.
+            if (g.iapi.DestroyInstance) g.iapi.DestroyInstance(g.instance, nullptr);
+            g.instance = nullptr;
+            return false;
+        }
+
+        if (g.debugUtils && g.iapi.CreateDebugUtilsMessengerEXT)
+        {
+            const VkResult m = g.iapi.CreateDebugUtilsMessengerEXT(g.instance, &messenger, nullptr,
+                                                                   &g.messenger);
+            if (m != VK_SUCCESS)
+            {
+                g.messenger = VK_NULL_HANDLE;
+                wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                    "vulkan: vkCreateDebugUtilsMessengerEXT failed: %s; the instance "
+                                    "stands, validation messages after creation are lost",
+                                    ResultName(m));
+            }
+        }
+
+        wxl::ScriptMgr::Log(WXL_LOG_DEBUG,
+                            "vulkan: instance created: api %u.%u requested, %u extension(s), "
+                            "validation %s",
+                            VK_API_VERSION_MAJOR(app.apiVersion), VK_API_VERSION_MINOR(app.apiVersion),
+                            static_cast<unsigned>(extensions.size()),
+                            g.validation ? "on" : "off");
+        return true;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Internal.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Internal.hpp
new file mode 100644
index 00000000..1aaa641b
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Internal.hpp
@@ -0,0 +1,212 @@
+// The Vulkan context's shared internals: its state and the helpers every part of src/vulkan/context/
+// uses.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+
+#include "vulkan/Context.hpp"
+
+#include "vulkan/DeviceCaps.hpp"
+
+#include "vulkan/Footprint.hpp"
+#include "vulkan/Loader.hpp"
+#include "vulkan/Window.hpp"
+
+#include "common/Settings.hpp"
+#include "host/Host.hpp"
+
+#include "wxl/Script.hpp"
+
+#include <cstring>
+#include <vector>
+
+// The context lives in src/vulkan/context/, one file per stage of its bring-up, over this one header.
+// Nothing here is visible outside it: the public face is src/vulkan/Context.hpp.
+//
+//   Debug      validation messages, extension lookups, footprint lines
+//   Instance   the instance
+//   Surface    the window's surface
+//   Physical   the physical device and its queue
+//   Logical    the logical device
+//   Swapchain  the swapchain and its rebuild
+namespace wxlvk::vk::context::detail
+{
+    namespace loader    = wxlvk::vk::loader;
+    namespace footprint = wxlvk::vk::footprint;
+    namespace window    = wxlvk::vk::window;
+    namespace settings  = wxlvk::settings;
+
+    using wxlvk::vk::ApiVersionText;
+    using wxlvk::vk::ColorSpaceName;
+    using wxlvk::vk::DeviceTypeName;
+    using wxlvk::vk::DriverVersionText;
+    using wxlvk::vk::FormatName;
+    using wxlvk::vk::PresentModeName;
+    using wxlvk::vk::ResultName;
+
+    /// Everything this module owns, in one place so Teardown() cannot miss a field.
+    ///
+    /// Dispatchable handles (VkInstance, VkPhysicalDevice, VkDevice, VkQueue) are pointers;
+    /// non-dispatchable ones (VkSurfaceKHR, VkSwapchainKHR, VkDebugUtilsMessengerEXT) are uint64_t
+    /// on this build, because third_party/vulkan-headers/vulkan/vulkan_core.h sets
+    /// VK_USE_64_BIT_PTR_DEFINES to 0 for anything that is not a 64-bit target. That is why the two
+    /// groups are initialised differently below -- nullptr for the pointers, VK_NULL_HANDLE (which is
+    /// 0ULL here) for the integers -- rather than uniformly, which would not compile.
+    struct State
+    {
+        VkInstance               instance  = nullptr;
+        VkPhysicalDevice         physical  = nullptr;
+        VkDevice                 device    = nullptr;
+        VkQueue                  graphicsQueue = nullptr;
+        VkQueue                  presentQueue  = nullptr;
+
+        VkSurfaceKHR             surface   = VK_NULL_HANDLE;
+        VkSwapchainKHR           swapchain = VK_NULL_HANDLE;
+        VkDebugUtilsMessengerEXT messenger = VK_NULL_HANDLE;
+
+        uint32_t graphicsFamily = UINT32_MAX;
+        uint32_t presentFamily  = UINT32_MAX;
+
+        HWND               hwnd        = nullptr;
+        VkSurfaceFormatKHR surfaceFormat = { VK_FORMAT_UNDEFINED, VK_COLOR_SPACE_SRGB_NONLINEAR_KHR };
+        VkPresentModeKHR   presentMode = VK_PRESENT_MODE_FIFO_KHR;
+        VkExtent2D         extent      = { 0, 0 };
+        uint32_t           imageCount  = 0;
+        VkImageUsageFlags  usage       = 0;  ///< the imageUsage the swapchain was created with
+        bool               bc          = false; ///< textureCompressionBC was enabled on the device
+        bool               largePoints = false; ///< largePoints was enabled on the device (gl_PointSize above 1)
+        bool               anisotropy  = false; ///< samplerAnisotropy was enabled on the device
+        bool               preciseOcclusion = false; ///< occlusionQueryPrecise was enabled on the device
+        bool               independentBlend = false; ///< independentBlend was enabled: per-attachment blend state (the G-buffer pass class)
+
+        bool vsync      = true;    ///< the engine's format asks for vsync (SetVsync)
+
+        /// The optional capabilities (Caps.cpp, WXL_VK_CAPS): what was probed, asked for and enabled.
+        DeviceCaps caps;
+        /// vkGetPhysicalDeviceMemoryProperties2 (a 1.1 instance) for the memory budget; null without it.
+        PFN_vkGetPhysicalDeviceMemoryProperties2 memoryProperties2 = nullptr;
+
+        bool debugUtils = false;   ///< VK_EXT_debug_utils was enabled on the instance
+        bool validation = false;   ///< VK_LAYER_KHRONOS_validation was enabled on the instance
+
+        loader::Instance iapi;
+        loader::Device   dapi;
+
+        footprint::Snapshot baseline;     ///< before LoadLibraryA
+        footprint::Snapshot afterLoader;
+        footprint::Snapshot afterInstance;
+        footprint::Snapshot afterDevice;
+
+        bool     settled  = false; ///< Bring() reached Done or Declined; stop calling it
+        unsigned attempts = 0;
+
+        /// Bumped on every swapchain create and destroy. See context::SwapchainGeneration().
+        uint32_t swapGen = 0;
+    };
+    extern State g;
+
+    /// How many times Bring() may answer Retry before it gives up and declines.
+    ///
+    /// Slot 13 calls it right after ICreateWindow, and slot 38 calls it again while the window is
+    /// not measurable (minimised, or a zero-size client rect mid-resize). 600 is about ten seconds of
+    /// presents at 60 fps: long enough to cover an alt-tab during loading, short enough that a
+    /// permanently unusable window stops being retried.
+    constexpr unsigned kMaxAttempts = 600;
+
+
+    /// The validation messages, per message id: the first kValidationRepeats of an id are logged
+    /// whole, the rest counted, so an error a draw raises does not write a line per draw (a frame is
+    /// tens of thousands of them) and bury the first occurrence. LogValidationSummary() names the
+    /// counted ones. The layer may call from any thread that calls Vulkan; the table is locked.
+    constexpr uint32_t kValidationRepeats = 5;
+    constexpr uint32_t kValidationIds     = 128;
+    struct ValidationId
+    {
+        int32_t     id       = 0;
+        int         level    = 0;
+        uint64_t    count    = 0;
+        char        name[96] = {};
+    };
+    struct ValidationTable
+    {
+        SRWLOCK      lock = SRWLOCK_INIT;
+        ValidationId ids[kValidationIds];
+        uint32_t     idCount   = 0;
+        uint64_t     untracked = 0;   ///< messages of ids past the table, all logged
+        uint64_t     errors    = 0;
+        uint64_t     warnings  = 0;
+    };
+    extern ValidationTable g_validation;
+
+    /// One enumerated adapter, with everything the choice is made on.
+    struct Candidate
+    {
+        VkPhysicalDevice           handle = nullptr;
+        VkPhysicalDeviceProperties props  = {};
+        uint32_t index          = 0;
+        uint32_t graphicsFamily = UINT32_MAX;
+        uint32_t presentFamily  = UINT32_MAX;
+        uint64_t deviceLocal    = 0;       ///< bytes across its DEVICE_LOCAL heaps
+        bool     unified        = false;   ///< one family does both graphics and present
+        const char* reject      = nullptr; ///< non-null when the adapter cannot be used
+    };
+
+    // Debug.cpp
+    bool HasExtension(const std::vector<VkExtensionProperties>& list, const char* name);
+    VKAPI_ATTR VkBool32 VKAPI_CALL DebugCallback( VkDebugUtilsMessageSeverityFlagBitsEXT severity, VkDebugUtilsMessageTypeFlagsEXT types, const VkDebugUtilsMessengerCallbackDataEXT* data, void* user);
+    VkDebugUtilsMessengerCreateInfoEXT MessengerInfo();
+    void LogFootprint(const char* phase, const footprint::Snapshot& now);
+
+    // Instance.cpp
+    bool CreateInstance();
+
+    // Surface.cpp
+    bool CreateSurface(HWND hwnd);
+
+    // Physical.cpp
+    unsigned TypeRank(VkPhysicalDeviceType t);
+    const char* WhyBetter(const Candidate& a, const Candidate& b);
+    void Examine(Candidate& c);
+    bool SelectPhysicalDevice();
+
+    // Logical.cpp
+    bool CreateDevice();
+
+    // Caps.cpp: the optional capabilities (WXL_VK_CAPS).
+    /// The instance version to ask for: the loader's up to 1.2, or 1.0 with WXL_VK_CAPS off. Notes it in g.caps.
+    uint32_t InstanceVersion();
+    /// What the device is created with beyond the six core features: the extension feature structs (pNext,
+    /// chained in front of `tail`), the extensions (appended to `names`, `count` updated, at most `room`),
+    /// the core features (set in `features`). Probes the chosen adapter first; nothing with WXL_VK_CAPS off.
+    struct CapsChain
+    {
+        VkPhysicalDevice16BitStorageFeatures      storage16 = {};
+        VkPhysicalDeviceShaderFloat16Int8Features float16   = {};
+        VkPhysicalDeviceMultiviewFeatures         multiview = {};
+        void*                                     head      = nullptr;
+    };
+    void PlanCaps(VkPhysicalDeviceFeatures& features, CapsChain& chain, void* tail, const char** names, uint32_t& count,
+                  uint32_t room);
+    /// After vkCreateDevice: what was enabled, the budget's entry point, the log line.
+    void CapsCreated(bool chainUsed);
+
+    // Swapchain.cpp
+    VkSurfaceFormatKHR PickFormat(const std::vector<VkSurfaceFormatKHR>& formats, const char*& why);
+    bool CreateSwapchain(const window::Found& win);
+    void DropSwapchainObject();
+    void DropSurface();
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Logical.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Logical.cpp
new file mode 100644
index 00000000..12dc6606
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Logical.cpp
@@ -0,0 +1,200 @@
+// The logical device, its features and its queue.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "vulkan/context/Internal.hpp"
+
+namespace wxlvk::vk::context::detail
+{
+    // --- logical device ---------------------------------------------------------------------------
+
+    /**
+     * Creates the logical device with one queue per distinct family, and resolves the device level.
+     *
+     * Three features are requested, each only when the adapter reports it: textureCompressionBC,
+     * robustBufferAccess and largePoints. Nothing else, because an unused enabled feature is an
+     * unused cost -- some drivers allocate differently for robustBufferAccess and the like -- and
+     * because asking for a feature the adapter lacks fails the create.
+     *
+     * No device layers either: enabledLayerCount on VkDeviceCreateInfo has been deprecated and
+     * ignored since Vulkan 1.0.x, and instance layers already cover the device.
+     *
+     * @return bool ok
+     */
+    bool CreateDevice()
+    {
+        const float priority = 1.0f;
+
+        VkDeviceQueueCreateInfo queues[2] = {};
+        uint32_t queueCount = 0;
+
+        queues[queueCount].sType            = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
+        queues[queueCount].queueFamilyIndex = g.graphicsFamily;
+        queues[queueCount].queueCount       = 1;
+        queues[queueCount].pQueuePriorities = &priority;
+        ++queueCount;
+
+        // One VkDeviceQueueCreateInfo per family, never two for the same family: the spec forbids a
+        // duplicate queueFamilyIndex in the array, and the unified case is exactly when that would
+        // happen.
+        if (g.presentFamily != g.graphicsFamily)
+        {
+            queues[queueCount].sType            = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
+            queues[queueCount].queueFamilyIndex = g.presentFamily;
+            queues[queueCount].queueCount       = 1;
+            queues[queueCount].pQueuePriorities = &priority;
+            ++queueCount;
+        }
+
+        // The swapchain, then what the optional capabilities add by name (Caps.cpp PlanCaps: the memory budget,
+        // gl_Layer from the vertex stage, FP16 on a 1.1 device); WXL_HOST appends its interop extensions after them.
+        constexpr uint32_t kMaxBase = 6;
+        const char* extensions[kMaxBase] = { VK_KHR_SWAPCHAIN_EXTENSION_NAME };
+        uint32_t    extensionCount = 1;
+        // Features: ask only for what the adapter reports, because asking for anything else fails
+        // the create. textureCompressionBC: nearly every texture the client loads is a
+        // DXT-compressed BLP, and uploading those as BC1/BC2/BC3 is only legal with the feature on.
+        // Every desktop GPU has it; the query exists so that a machine without it gets decoded
+        // RGBA8 images and a log line instead of a device that fails to come up.
+        VkPhysicalDeviceFeatures features = {};
+        {
+            VkPhysicalDeviceFeatures have = {};
+            g.iapi.GetPhysicalDeviceFeatures(g.physical, &have);
+            features.textureCompressionBC = have.textureCompressionBC;
+            g.bc = have.textureCompressionBC == VK_TRUE;
+            // robustBufferAccess: an out-of-bounds buffer read returns zero (or in-buffer bytes)
+            // instead of faulting the device. The translated shaders index the bone palette with
+            // a register the engine fills (`regs.v[31 + a0.x]`), a vertex buffer is bound whole and
+            // addressed by the engine's own offsets: every one of those is a read this feature turns
+            // from a lost device into a wrong pixel. Every desktop driver supports it; the cost is a
+            // bounds check the hardware does anyway.
+            features.robustBufferAccess = have.robustBufferAccess;
+            // largePoints: the weather sprites (`sand`, `snowpoint`) are point lists
+            // whose vertex module writes gl_PointSize from the engine's oPts, and without the
+            // feature every size above 1.0 is clamped to one pixel. Same pattern as the two
+            // above: asked for only when reported, so a device without it still comes up and
+            // the snow is one pixel wide rather than absent. Vulkan clamps to pointSizeRange,
+            // which src/vulkan/Pipelines.cpp logs at Init in place of D3D's POINTSIZE_MIN/MAX.
+            features.largePoints = have.largePoints;
+            g.largePoints        = have.largePoints == VK_TRUE;
+            // samplerAnisotropy: the engine's filter 5 is D3D's ANISOTROPIC min/mag filter with the
+            // texture's own MAXANISOTROPY (CGxTexFlags bits 9-13, cgxdevice 2.7 / 4.7); without the
+            // feature such a sampler is trilinear, as it is on an adapter without the D3D cap.
+            features.samplerAnisotropy = have.samplerAnisotropy;
+            g.anisotropy               = have.samplerAnisotropy == VK_TRUE;
+            // occlusionQueryPrecise: D3D9's occlusion query returns the exact count of samples that
+            // passed, and its one user (the sun / moon glare, DayNight::DNGlare) divides that count
+            // by the quad's projected area to scale the glare. A query begun without
+            // VK_QUERY_CONTROL_PRECISE_BIT may return any non-zero value for "some passed", which
+            // reads as an almost hidden sun.
+            features.occlusionQueryPrecise = have.occlusionQueryPrecise;
+            g.preciseOcclusion             = have.occlusionQueryPrecise == VK_TRUE;
+            // independentBlend: the G-buffer pass class blends the frame with the draw's own mode and masks
+            // or zeroes its three other attachments, which is per-attachment blend state. Without the
+            // feature the device makes no G-buffer (native/present/Images.cpp) and every pipeline keeps
+            // one blend state for all its attachments.
+            features.independentBlend = have.independentBlend;
+            g.independentBlend        = have.independentBlend == VK_TRUE;
+            if (!g.bc)
+                wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                    "vulkan: the adapter has no textureCompressionBC; DXT textures "
+                                    "are decoded to RGBA8, four to eight times larger");
+            if (!g.preciseOcclusion)
+                wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                    "vulkan: the adapter has no occlusionQueryPrecise; occlusion queries "
+                                    "may count any passing draw as one sample (the sun glare dims)");
+            if (!g.largePoints)
+                wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                    "vulkan: the adapter has no largePoints; point sprites (the "
+                                    "weather's sand and snow) will draw one pixel wide");
+        }
+
+        // The optional capabilities (WXL_VK_CAPS, Caps.cpp): every optional feature the adapter reports, the
+        // extension features chained, their extensions named. Nothing with the key off.
+        const VkPhysicalDeviceFeatures plainFeatures = features;
+        CapsChain capsChain;
+        PlanCaps(features, capsChain, nullptr, extensions, extensionCount, kMaxBase);
+        const bool richer = capsChain.head != nullptr || extensionCount > 1
+                            || std::memcmp(&plainFeatures, &features, sizeof features) != 0;
+
+        // WXL_HOST=1 adds the host link's interop extensions and the timeline feature (src/host/), its pNext
+        // chained after the capabilities'; otherwise this is the swapchain extension (and the capabilities') alone.
+        const wxlvk::host::DeviceExtensions enabled =
+            wxlvk::host::ExtendDevice(g.iapi, g.instance, g.physical, extensions, extensionCount);
+        if (enabled.pNext)
+        {
+            // The capabilities' chain ends on the host's struct (theirs were planned with a null tail).
+            VkBaseOutStructure* last = static_cast<VkBaseOutStructure*>(capsChain.head);
+            while (last && last->pNext) last = last->pNext;
+            if (last) last->pNext = static_cast<VkBaseOutStructure*>(const_cast<void*>(enabled.pNext));
+            else capsChain.head = const_cast<void*>(enabled.pNext);
+        }
+        VkDeviceCreateInfo info = {};
+        info.sType                   = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO;
+        info.pNext                   = capsChain.head;
+        info.queueCreateInfoCount    = queueCount;
+        info.pQueueCreateInfos       = queues;
+        info.enabledExtensionCount   = enabled.count;
+        info.ppEnabledExtensionNames = enabled.names;
+        info.pEnabledFeatures        = &features;
+
+        VkResult r = g.iapi.CreateDevice(g.physical, &info, nullptr, &g.device);
+        bool chainUsed = richer;
+        if (r != VK_SUCCESS && richer)
+        {
+            // The richer device refused (a driver that reports a feature it will not enable): the device as it was,
+            // its six features, the swapchain and the host link's extensions only.
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: vkCreateDevice with the optional capabilities failed (%s); "
+                                "creating the plain device (set %s=0 to skip the attempt)", ResultName(r), settings::kCapsKey);
+            g.device = nullptr;
+            const char* plainNames[kMaxBase] = { VK_KHR_SWAPCHAIN_EXTENSION_NAME };
+            const wxlvk::host::DeviceExtensions plain =
+                wxlvk::host::ExtendDevice(g.iapi, g.instance, g.physical, plainNames, 1);
+            features = plainFeatures;
+            info.pNext                   = plain.pNext;
+            info.enabledExtensionCount   = plain.count;
+            info.ppEnabledExtensionNames = plain.names;
+            r = g.iapi.CreateDevice(g.physical, &info, nullptr, &g.device);
+            chainUsed = false;
+        }
+        if (r != VK_SUCCESS)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: vkCreateDevice failed: %s", ResultName(r));
+            g.device = nullptr;
+            return false;
+        }
+        CapsCreated(chainUsed);
+
+        if (!loader::LoadDevice(g.iapi, g.device, g.dapi))
+        {
+            if (g.dapi.DestroyDevice) g.dapi.DestroyDevice(g.device, nullptr);
+            g.device = nullptr;
+            return false;
+        }
+
+        g.dapi.GetDeviceQueue(g.device, g.graphicsFamily, 0, &g.graphicsQueue);
+        g.dapi.GetDeviceQueue(g.device, g.presentFamily, 0, &g.presentQueue);
+
+        wxl::ScriptMgr::Log(WXL_LOG_DEBUG,
+                            "vulkan: logical device created with %u queue(s): graphics family %u"
+                            "%s, present family %u%s. Extensions: %u (%s first)",
+                            queueCount, g.graphicsFamily,
+                            g.graphicsQueue ? "" : " (queue handle null!)",
+                            g.presentFamily,
+                            g.presentFamily == g.graphicsFamily ? " (same family)" : "",
+                            info.enabledExtensionCount, VK_KHR_SWAPCHAIN_EXTENSION_NAME);
+        return true;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Physical.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Physical.cpp
new file mode 100644
index 00000000..7973af8e
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/context/Physical.cpp
@@ -0,0 +1,257 @@
+// Choosing the physical device and its queue, and what it supports.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "vulkan/context/Internal.hpp"
+
+namespace wxlvk::vk::context::detail
+{
+    // --- physical device --------------------------------------------------------------------------
+
+    /// deviceType as a rank: the only criterion that is a real preference rather than a tie-break.
+    unsigned TypeRank(VkPhysicalDeviceType t)
+    {
+        switch (t)
+        {
+            case VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU:   return 4;
+            case VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU: return 3;
+            case VK_PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU:    return 2;
+            case VK_PHYSICAL_DEVICE_TYPE_CPU:            return 1;
+            default:                                     return 0;
+        }
+    }
+
+    /**
+     * Why `a` is preferred over `b`, or null when it is not.
+     *
+     * A lexicographic comparison on named criteria rather than a single numeric score, for one
+     * reason: a score cannot say *which* term decided, and "do not silently take index 0" is only
+     * honoured if the log can name the criterion. The order is:
+     *
+     *  1. device type. A discrete GPU beats an integrated one, and both beat a software device.
+     *     This is the criterion that matters on a laptop with switchable graphics, where index 0 is
+     *     routinely the integrated part.
+     *  2. one queue family covering both graphics and present. Two families mean every future
+     *     present needs an ownership transfer or a CONCURRENT swapchain, both of which cost
+     *     something for nothing on hardware that does not need them.
+     *  3. the higher supported API version.
+     *  4. the larger total DEVICE_LOCAL heap, as a proxy for "the bigger GPU" among two of the same
+     *     type -- a proxy, not a measurement of anything, which is why it ranks below the three
+     *     facts above it.
+     *  5. the lower enumeration index, so the choice is deterministic rather than arbitrary when
+     *     two adapters are genuinely indistinguishable. Reaching this rule is the only case in which
+     *     taking index 0 is correct, and the log says so.
+     *
+     * @param Candidate& a : the incumbent challenger
+     * @param Candidate& b : the current best
+     * @return string reason : null when `a` is not better
+     */
+    const char* WhyBetter(const Candidate& a, const Candidate& b)
+    {
+        if (TypeRank(a.props.deviceType) != TypeRank(b.props.deviceType))
+            return TypeRank(a.props.deviceType) > TypeRank(b.props.deviceType)
+                       ? "it is the better device type" : nullptr;
+        if (a.unified != b.unified)
+            return a.unified ? "one queue family covers graphics and present" : nullptr;
+        if (a.props.apiVersion != b.props.apiVersion)
+            return a.props.apiVersion > b.props.apiVersion ? "it supports a higher API version"
+                                                           : nullptr;
+        if (a.deviceLocal != b.deviceLocal)
+            return a.deviceLocal > b.deviceLocal ? "it has more device-local memory" : nullptr;
+        if (a.index != b.index)
+            return a.index < b.index ? "the two are indistinguishable, so the lower index wins"
+                                     : nullptr;
+        return nullptr;
+    }
+
+    /**
+     * Fills in one candidate and decides whether it is usable at all.
+     *
+     * Three hard requirements, each of which is checked rather than assumed:
+     *  - VK_KHR_swapchain in its device extension list. Without it there is no swapchain, and a
+     *    headless adapter (a compute-only ICD, or a software device) legitimately lacks it.
+     *  - a queue family with VK_QUEUE_GRAPHICS_BIT.
+     *  - a queue family reporting present support on OUR surface, via
+     *    vkGetPhysicalDeviceSurfaceSupportKHR. This is the check that cannot be replaced by
+     *    guesswork: on a hybrid laptop the adapter that can render is not always the one wired to
+     *    the display the window is on.
+     *
+     * @param Candidate& c : handle and index already set; everything else filled here
+     */
+    void Examine(Candidate& c)
+    {
+        g.iapi.GetPhysicalDeviceProperties(c.handle, &c.props);
+
+        uint32_t extCount = 0;
+        g.iapi.EnumerateDeviceExtensionProperties(c.handle, nullptr, &extCount, nullptr);
+        std::vector<VkExtensionProperties> exts(extCount);
+        if (extCount)
+            g.iapi.EnumerateDeviceExtensionProperties(c.handle, nullptr, &extCount, exts.data());
+        exts.resize(extCount);
+        if (!HasExtension(exts, VK_KHR_SWAPCHAIN_EXTENSION_NAME))
+        {
+            c.reject = "no " VK_KHR_SWAPCHAIN_EXTENSION_NAME;
+            return;
+        }
+
+        VkPhysicalDeviceMemoryProperties mem = {};
+        g.iapi.GetPhysicalDeviceMemoryProperties(c.handle, &mem);
+        for (uint32_t h = 0; h < mem.memoryHeapCount; ++h)
+            if (mem.memoryHeaps[h].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)
+                c.deviceLocal += mem.memoryHeaps[h].size;
+
+        uint32_t familyCount = 0;
+        g.iapi.GetPhysicalDeviceQueueFamilyProperties(c.handle, &familyCount, nullptr);
+        std::vector<VkQueueFamilyProperties> families(familyCount);
+        if (familyCount)
+            g.iapi.GetPhysicalDeviceQueueFamilyProperties(c.handle, &familyCount, families.data());
+        families.resize(familyCount);
+
+        for (uint32_t f = 0; f < familyCount; ++f)
+        {
+            if (families[f].queueCount == 0) continue;
+
+            const bool graphics = (families[f].queueFlags & VK_QUEUE_GRAPHICS_BIT) != 0;
+
+            VkBool32 present = VK_FALSE;
+            if (g.iapi.GetPhysicalDeviceSurfaceSupportKHR(c.handle, f, g.surface, &present)
+                != VK_SUCCESS)
+                present = VK_FALSE;
+
+            // A family that does both ends the search: that is the preferred shape, and taking it
+            // the moment it appears is also what makes `unified` meaningful.
+            if (graphics && present)
+            {
+                c.graphicsFamily = f;
+                c.presentFamily  = f;
+                c.unified        = true;
+                break;
+            }
+            if (graphics && c.graphicsFamily == UINT32_MAX) c.graphicsFamily = f;
+            if (present  && c.presentFamily  == UINT32_MAX) c.presentFamily  = f;
+        }
+
+        if (c.graphicsFamily == UINT32_MAX) { c.reject = "no graphics queue family"; return; }
+        if (c.presentFamily  == UINT32_MAX) { c.reject = "no queue family can present to our window"; }
+    }
+
+    /**
+     * Enumerates the adapters, logs every one, and picks the best by the rules in WhyBetter.
+     *
+     * @return bool ok : false when nothing usable was found
+     */
+    bool SelectPhysicalDevice()
+    {
+        uint32_t count = 0;
+        VkResult r = g.iapi.EnumeratePhysicalDevices(g.instance, &count, nullptr);
+        if (r != VK_SUCCESS && r != VK_INCOMPLETE)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: vkEnumeratePhysicalDevices failed: %s",
+                                ResultName(r));
+            return false;
+        }
+        if (count == 0)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                "vulkan: the loader reports no physical device; there is a "
+                                "vulkan-1.dll but no usable ICD. Declining.");
+            return false;
+        }
+
+        std::vector<VkPhysicalDevice> handles(count);
+        r = g.iapi.EnumeratePhysicalDevices(g.instance, &count, handles.data());
+        if (r != VK_SUCCESS && r != VK_INCOMPLETE)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: vkEnumeratePhysicalDevices failed: %s",
+                                ResultName(r));
+            return false;
+        }
+        handles.resize(count);
+
+        std::vector<Candidate> candidates(count);
+        int best = -1;
+        // Replaced by WhyBetter's answer whenever a later adapter displaces the incumbent, so it
+        // always names the criterion that actually decided. The initial wording is what stands when
+        // the first usable adapter is never displaced -- which is the common case, and is not the
+        // same statement as "it was index 0".
+        const char* bestReason = "it was the first usable adapter and nothing beat it";
+
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            Candidate& c = candidates[i];
+            c.handle = handles[i];
+            c.index  = i;
+            Examine(c);
+
+            char apiText[32];
+            char driverText[32];
+            if (c.reject)
+            {
+                wxl::ScriptMgr::Log(WXL_LOG_DEBUG,
+                                    "vulkan:   adapter %u '%s' (%s, VID %04x DID %04x) rejected: %s",
+                                    i, c.props.deviceName, DeviceTypeName(c.props.deviceType),
+                                    c.props.vendorID, c.props.deviceID, c.reject);
+                continue;
+            }
+
+            wxl::ScriptMgr::Log(WXL_LOG_DEBUG,
+                                "vulkan:   adapter %u '%s' (%s, VID %04x DID %04x) api %s driver %s "
+                                "device-local %u MiB queues gfx=%u present=%u%s",
+                                i, c.props.deviceName, DeviceTypeName(c.props.deviceType),
+                                c.props.vendorID, c.props.deviceID,
+                                ApiVersionText(c.props.apiVersion, apiText, sizeof apiText),
+                                DriverVersionText(c.props.vendorID, c.props.driverVersion,
+                                                  driverText, sizeof driverText),
+                                footprint::Mib(c.deviceLocal),
+                                c.graphicsFamily, c.presentFamily,
+                                c.unified ? " (unified)" : "");
+
+            if (best < 0) { best = static_cast<int>(i); continue; }
+
+            if (const char* why = WhyBetter(c, candidates[static_cast<size_t>(best)]))
+            {
+                best       = static_cast<int>(i);
+                bestReason = why;
+            }
+        }
+
+        if (best < 0)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                "vulkan: %u adapter(s) enumerated, none of them usable; declining",
+                                count);
+            return false;
+        }
+
+        const Candidate& chosen = candidates[static_cast<size_t>(best)];
+        g.physical       = chosen.handle;
+        g.graphicsFamily = chosen.graphicsFamily;
+        g.presentFamily  = chosen.presentFamily;
+
+        char apiText[32];
+        char driverText[32];
+        wxl::ScriptMgr::Log(WXL_LOG_DEBUG,
+                            "vulkan: chose adapter %u '%s' out of %u: %s. %s, api %s, driver %s, "
+                            "VID %04x DID %04x",
+                            chosen.index, chosen.props.deviceName, count,
+                            count == 1 ? "it is the only adapter" : bestReason,
+                            DeviceTypeName(chosen.props.deviceType),
+                            ApiVersionText(chosen.props.apiVersion, apiText, sizeof apiText),
+                            DriverVersionText(chosen.props.vendorID, chosen.props.driverVersion,
+                                              driverText, sizeof driverText),
+                            chosen.props.vendorID, chosen.props.deviceID);
+        return true;
+    }
+}
