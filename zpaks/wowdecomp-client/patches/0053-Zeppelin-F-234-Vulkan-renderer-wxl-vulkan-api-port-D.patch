+    if(s->point) s->DestroySampler(s->device.device,s->point,nullptr);
+    if(s->comparison) s->DestroySampler(s->device.device,s->comparison,nullptr);
+    if(s->pipeline) s->DestroyPipeline(s->device.device,s->pipeline,nullptr);
