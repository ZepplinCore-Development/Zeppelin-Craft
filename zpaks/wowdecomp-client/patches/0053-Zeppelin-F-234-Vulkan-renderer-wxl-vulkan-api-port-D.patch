diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Core.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Core.cpp
new file mode 100644
index 00000000..f90d23c8
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Core.cpp
@@ -0,0 +1,143 @@
+// HD: the wxl-core service table, built into the client for the wxl-vulkan-api port (WarcraftXL,
+// GPL-3.0). wxl-vulkan-api ran as a DLL the WarcraftXL core loaded and handed a WXL_Api; here it is
+// compiled into the client, so this file answers the same calls:
+//
+//   Log               Logs\Vulkan.log, one line per call, flushed (the device can crash the client)
+//   HookAttach*       the six engine seams (Seams.cpp, Engine/Source/Gx/GxSeam.h), by point name; anything else
+//                     is declined (0)
+//   GetInterface      nothing is published (no ImGui overlay, no core device factory)
+//   PublishInterface  kept, so the rendering API (wxl.vk.render) can be looked up by the HD code
+//   everything else   no-ops
+
+#include "wxl/PluginApi.h"
+#include "wxl/Script.hpp"
+#include "wxlcompat/Engine.hpp"
+#include "wxlcompat/Seams.hpp"
+
+#include <windows.h>
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+
+namespace
+{
+    FILE* g_log = nullptr;
+    bool  g_logTried = false;
+    CRITICAL_SECTION g_logLock;
+
+    struct Published
+    {
+        const char* name;
+        uint32_t    version;
+        void*       iface;
+    };
+    Published g_published[16];
+    uint32_t  g_publishedCount = 0;
+
+    const char* LevelName(int level)
+    {
+        switch (level)
+        {
+            case WXL_LOG_TRACE: return "TRACE";
+            case WXL_LOG_DEBUG: return "DEBUG";
+            case WXL_LOG_INFO:  return "INFO";
+            case WXL_LOG_WARN:  return "WARN";
+            case WXL_LOG_ERROR: return "ERROR";
+            default:            return "?";
+        }
+    }
+
+    void __cdecl ApiLog(int level, const char* tag, const char* fmt, ...)
+    {
+        char line[1024];
+        va_list args;
+        va_start(args, fmt);
+        std::vsnprintf(line, sizeof line, fmt, args);
+        va_end(args);
+        wxlcompat::Log(level, tag, line);
+    }
+
+    void __cdecl ApiSubscribe(uint32_t, WXL_EventFn, void*) {}
+    void __cdecl ApiEmit(uint32_t, const void*) {}
+
+    // There are no addresses to detour in this client: a hook by address is taken by its name, which only the late
+    // liquid pass's has a seam for.
+    int __cdecl ApiHookAttach(const char* name, uintptr_t, void* detour, void** original, int priority)
+    {
+        return wxlcompat::SeamAttach(name, detour, original, priority) ? 1 : 0;
+    }
+
+    int __cdecl ApiHookAttachByName(const char* pointName, void* detour, void** original, int priority)
+    {
+        return wxlcompat::SeamAttach(pointName, detour, original, priority) ? 1 : 0;
+    }
+
+    void __cdecl ApiPublishInterface(const char* name, uint32_t version, void* iface)
+    {
+        if (!name || g_publishedCount >= sizeof g_published / sizeof *g_published) return;
+        g_published[g_publishedCount++] = { name, version, iface };
+    }
+
+    void* __cdecl ApiGetInterface(const char* name, uint32_t version)
+    {
+        if (!name) return nullptr;
+        for (uint32_t i = 0; i < g_publishedCount; ++i)
+            if (g_published[i].version == version && std::strcmp(g_published[i].name, name) == 0)
+                return g_published[i].iface;
+        return nullptr;
+    }
+
+    void __cdecl ApiUiAddPanel(const char*, WXL_PanelFn, void*) {}
+    int  __cdecl ApiUiIsOpen() { return 0; }
+    void __cdecl ApiUiText(const char*) {}
+    void __cdecl ApiUiSeparator() {}
+    int  __cdecl ApiUiButton(const char*) { return 0; }
+    int  __cdecl ApiUiCheckbox(const char*, int*) { return 0; }
+    int  __cdecl ApiUiSliderFloat(const char*, float*, float, float) { return 0; }
+    int  __cdecl ApiUiSliderInt(const char*, int*, int, int) { return 0; }
+    int  __cdecl ApiUiColorEdit(const char*, float*) { return 0; }
+    void __cdecl ApiUiSameLine() {}
+    int  __cdecl ApiUiCombo(const char*, int*, const char* const*, int) { return 0; }
+    int  __cdecl ApiUiCollapsingHeader(const char*) { return 0; }
+    int  __cdecl ApiUiInputText(const char*, char*, size_t) { return 0; }
+
+    const WXL_Api g_api = {
+        sizeof(WXL_Api), WXL_API_VERSION,
+        &ApiLog, &ApiSubscribe, &ApiEmit, &ApiHookAttach, &ApiHookAttachByName,
+        &ApiPublishInterface, &ApiGetInterface,
+        &ApiUiAddPanel, &ApiUiIsOpen, &ApiUiText, &ApiUiSeparator, &ApiUiButton, &ApiUiCheckbox,
+        &ApiUiSliderFloat, &ApiUiSliderInt, &ApiUiColorEdit, &ApiUiSameLine, &ApiUiCombo,
+        &ApiUiCollapsingHeader, &ApiUiInputText,
+    };
+
+    struct LockInit
+    {
+        LockInit() { InitializeCriticalSection(&g_logLock); }
+    } g_lockInit;
+}
+
+namespace wxlcompat
+{
+    const WXL_Api* CoreApi() { return &g_api; }
+
+    void Log(int level, const char* tag, const char* text)
+    {
+        EnterCriticalSection(&g_logLock);
+        if (!g_log && !g_logTried)
+        {
+            g_logTried = true;
+            CreateDirectoryA("Logs", nullptr);
+            g_log = std::fopen("Logs\\Vulkan.log", "w");
+        }
+        if (g_log)
+        {
+            SYSTEMTIME t;
+            GetLocalTime(&t);
+            std::fprintf(g_log, "%02u:%02u:%02u.%03u %-5s %s: %s\n", t.wHour, t.wMinute, t.wSecond,
+                         t.wMilliseconds, LevelName(level), tag ? tag : "", text ? text : "");
+            std::fflush(g_log);
+        }
+        LeaveCriticalSection(&g_logLock);
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Engine.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Engine.cpp
new file mode 100644
index 00000000..cde6552a
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Engine.cpp
@@ -0,0 +1,99 @@
+// HD: the engine functions and statics wxl-vulkan-api reached by 32-bit address (wxlcompat/Engine.hpp),
+// as calls into the recompiled x64 client. Part of the wxl-vulkan-api port (WarcraftXL, GPL-3.0).
+
+#include "wxlcompat/Engine.hpp"
+
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDevice/EmergencyMem.h"
+#include "Engine/Source/Gx/CGxDeviceVulkan/CGxDeviceVulkan.h"
+#include "Engine/Source/Gx/CGxPool.h"
+#include "Engine/Source/Gx/CGxTex.h"
+#include "Engine/Source/Gx/Gx.h"
+#include "Engine/Source/Services/Texture.h"
+#include "Engine/Source/Services/TextureBlob.h"
+#include "Engine/Source/ShaderEffect/ShaderEffect.h"
+#include "WoW/Source/WorldClient/World.h"
+
+#include <cstring>
+
+namespace
+{
+    CGxDevice* Dev(void* device) { return static_cast<CGxDevice*>(device); }
+
+    template <class Fn>
+    uintptr_t FnAddress(Fn fn) { return reinterpret_cast<uintptr_t>(fn); }
+}
+
+namespace wxlcompat
+{
+    // --- engine statics ---------------------------------------------------------------------------------
+    uintptr_t GxDevicePtrAddress()     { return reinterpret_cast<uintptr_t>(&g_theGxDevicePtr); }
+    uintptr_t PsConstCacheAddress()    { return reinterpret_cast<uintptr_t>(CGxDevice::s_shadowConstants[0].constants); }
+    uintptr_t PsDirtyRegEndAddress()   { return reinterpret_cast<uintptr_t>(&CGxDevice::s_shadowConstants[0].dirtyMax); }
+    uintptr_t PsDirtyRegStartAddress() { return reinterpret_cast<uintptr_t>(&CGxDevice::s_shadowConstants[0].dirtyMin); }
+    uintptr_t VsConstCacheAddress()    { return reinterpret_cast<uintptr_t>(CGxDevice::s_shadowConstants[1].constants); }
+    uintptr_t VsDirtyRegEndAddress()   { return reinterpret_cast<uintptr_t>(&CGxDevice::s_shadowConstants[1].dirtyMax); }
+    uintptr_t VsDirtyRegStartAddress() { return reinterpret_cast<uintptr_t>(&CGxDevice::s_shadowConstants[1].dirtyMin); }
+    uintptr_t UiVertexShaderAddress()  { return reinterpret_cast<uintptr_t>(CGxDevice::s_uiVertexShader); }
+    uintptr_t UiPixelShaderAddress()   { return reinterpret_cast<uintptr_t>(&CGxDevice::s_uiPixelShader); }
+    uintptr_t EffectFogColorAlphaRefAddress() { return reinterpret_cast<uintptr_t>(&CShaderEffect::s_fogColorAlphaRef); }
+    uintptr_t EffectFogParamsAddress()        { return reinterpret_cast<uintptr_t>(&CShaderEffect::s_fogParams); }
+    uintptr_t CameraViewAddress()      { return reinterpret_cast<uintptr_t>(&CWorldScene::viewMatrix); }
+    uintptr_t CameraPosAddress()       { return reinterpret_cast<uintptr_t>(&CWorldScene::s_activeWorldView); }
+    uintptr_t TexFillBlpAddress()      { return FnAddress(&UpdateBlpTextureAsync); }
+    uintptr_t TexFillTgaAddress()      { return FnAddress(&UpdateTgaTexture); }
+    uintptr_t TexFillBlobAddress()     { return FnAddress(&UpdateBlobTexture); }
+    size_t    TextureFileNameOffset()  { return offsetof(CTexture, m_filename); }
+
+    // --- CGxDevice members --------------------------------------------------------------------------------
+    void IRsForceUpdate(void* device)            { Dev(device)->IRsForceUpdate(); }
+    void IRsSync(void* device, int force)        { Dev(device)->IRsSync(force); }
+    void InitLights(void* device)                { Dev(device)->InitLights(); }
+    void ShaderConstantsClear()                  { g_theGxDevicePtr->ShaderConstantsClear(); }
+    void WaitForFpsCap(void* device)             { Dev(device)->WaitForFPSCap(); }
+    void DeviceScreenShot(void* device)          { Dev(device)->DeviceScreenShot(); }
+    void DeviceSetDefWindow(void* device, const float* rect)
+    {
+        Dev(device)->DeviceSetDefWindow(*reinterpret_cast<const CRect*>(rect));
+    }
+    void ClampRectToWindow(void* device, int32_t* rect)
+    {
+        Dev(device)->ClampRectToWindow(*reinterpret_cast<CiRect*>(rect));
+    }
+    void ITexWHDStartEnd(void* device, void* tex, uint32_t* width, uint32_t* height, uint32_t* start,
+                         uint32_t* end)
+    {
+        Dev(device)->ITexWHDStartEnd(static_cast<CGxTex*>(tex), *width, *height, *start, *end);
+    }
+
+    // --- CGxDeviceVulkan ----------------------------------------------------------------------------------
+    uint16_t WindowClassCreate() { return CGxDeviceVulkan::WindowClassCreate(); }
+    bool CreateGameWindow(void* device, void* format)
+    {
+        return static_cast<CGxDeviceVulkan*>(Dev(device))->ICreateWindow(*static_cast<CGxFormat*>(format)) != 0;
+    }
+
+    // --- other engine objects ----------------------------------------------------------------------------
+    void CImVectorArraySetCount(void* array, uint32_t count)
+    {
+        static_cast<TSGrowableArray<CImVector>*>(array)->SetCount(count);
+    }
+    void* EmergencyMemLock(void* emergency, uint32_t size) { return static_cast<EmergencyMem*>(emergency)->Lock(size); }
+    void  PoolDiscard(void* pool)    { static_cast<CGxPool*>(pool)->Discard(); }
+    void  PoolInvalidate(void* pool) { static_cast<CGxPool*>(pool)->Invalidate(); }
+
+    int GxTexCreate(uint32_t width, uint32_t height, uint32_t format, uint32_t flags, void* userArg,
+                    TexFillFn fill, void** out)
+    {
+        static_assert(sizeof(CGxTexFlags) == sizeof(uint32_t), "the flags travel as one dword");
+        CGxTexFlags texFlags;
+        std::memcpy(&texFlags, &flags, sizeof texFlags);
+        return ::GxTexCreate(width, height, static_cast<EGxTexFormat>(format), texFlags, userArg,
+                             reinterpret_cast<GxTexUserFunc>(fill), *reinterpret_cast<CGxTex**>(out));
+    }
+    void GxTexUpdate(void* tex, int32_t minX, int32_t minY, int32_t maxX, int32_t maxY, int immediate)
+    {
+        ::GxTexUpdate(static_cast<CGxTex*>(tex), minX, minY, maxX, maxY, immediate);
+    }
+    TexFillFn PlaceholderTexFill() { return reinterpret_cast<TexFillFn>(&CGxDeviceVulkan::DefaultTexUserFunc); }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Seams.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Seams.cpp
new file mode 100644
index 00000000..0dc0ede4
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Seams.cpp
@@ -0,0 +1,147 @@
+// HD: the wxl hook points as engine seams (wxlcompat/Seams.hpp, Engine/Source/Gx/GxSeam.h). Part of the
+// wxl-vulkan-api port (WarcraftXL, GPL-3.0).
+//
+// The 32-bit core detoured six engine functions by address. Here each one asks GxSeamEnter at its top and
+// calls the seam's outermost bracket; the chain below keeps the core's order (lower priority first, equal
+// values in attach order), and its last link is an adapter that calls the engine function again with the
+// seam's re-entry flag set, so that call runs the function's own body.
+
+#include "wxlcompat/Seams.hpp"
+
+#include "shaders/Translated.hpp"
+#include "wxl/PluginApi.h"
+#include "wxlcompat/Engine.hpp"
+
+#include "Engine/Source/Gx/GxSeam.h"
+#include "Engine/Source/Model2/CM2SceneRender.h"
+#include "WoW/Source/Ui/WorldFrame.h"
+#include "WoW/Source/WorldClient/MapObj.h"
+#include "WoW/Source/WorldClient/World.h"
+
+#include <cstdio>
+#include <cstring>
+
+namespace
+{
+    // The last link of each chain: the engine function, entered again past its seam.
+
+    void __fastcall WorldOnRender(void* worldFrame, void* /*edx*/)
+    {
+        g_gxSeams[GxSeam_WorldOnRender].m_reenter = 1;
+        static_cast<CGWorldFrame*>(worldFrame)->OnWorldRender();
+    }
+
+    void __cdecl DetailDoodads()
+    {
+        g_gxSeams[GxSeam_DetailDoodads].m_reenter = 1;
+        CWorldScene::RenderDetailDoodads();
+    }
+
+    void __cdecl LiquidPass()
+    {
+        g_gxSeams[GxSeam_LiquidPass].m_reenter = 1;
+        CWorldScene::RenderLiquidPass();
+    }
+
+    uint32_t __fastcall DrawBatchDoodad(void* render, void* /*edx*/, void* elements, void* indices)
+    {
+        g_gxSeams[GxSeam_DrawBatchDoodad].m_reenter = 1;
+        static_cast<CM2SceneRender*>(render)->DrawBatchDoodad(static_cast<M2Element*>(elements), static_cast<uint32_t*>(indices));
+        return 0;
+    }
+
+    void __fastcall WmoExterior(void* mapObj, void* /*edx*/, void* group, int index)
+    {
+        g_gxSeams[GxSeam_WmoExterior].m_reenter = 1;
+        static_cast<CMapObj*>(mapObj)->ExteriorRender(static_cast<CMapObjGroup*>(group), static_cast<uint32_t>(index));
+    }
+
+    void __fastcall WmoInterior(void* mapObj, void* /*edx*/, void* group, int index)
+    {
+        g_gxSeams[GxSeam_WmoInterior].m_reenter = 1;
+        static_cast<CMapObj*>(mapObj)->InteriorRender(static_cast<CMapObjGroup*>(group), static_cast<uint32_t>(index));
+    }
+
+    struct Link
+    {
+        int    priority;
+        void*  detour;
+        void** original;
+    };
+
+    struct Chain
+    {
+        const char* name;     ///< the core's hook point name
+        EGxSeam     seam;
+        void*       engine;   ///< the last link
+        Link        links[4];
+        uint32_t    count;
+    };
+
+    Chain g_chains[] = {
+        { "Gx.WorldOnRender",        GxSeam_WorldOnRender,   reinterpret_cast<void*>(&WorldOnRender),   {}, 0 },
+        { "Adt.RenderDetailDoodads", GxSeam_DetailDoodads,   reinterpret_cast<void*>(&DetailDoodads),   {}, 0 },
+        { "Liquid.WorldLiquidPass",  GxSeam_LiquidPass,      reinterpret_cast<void*>(&LiquidPass),      {}, 0 },
+        { "M2.DrawBatchDoodad",      GxSeam_DrawBatchDoodad, reinterpret_cast<void*>(&DrawBatchDoodad), {}, 0 },
+        { "Wmo.ExtRender",           GxSeam_WmoExterior,     reinterpret_cast<void*>(&WmoExterior),     {}, 0 },
+        { "Wmo.IntRender",           GxSeam_WmoInterior,     reinterpret_cast<void*>(&WmoInterior),     {}, 0 },
+    };
+
+    bool g_enabled = false;
+
+    int32_t ShaderKnown(const void* code, uint32_t size)
+    {
+        return wxlvk::shaders::translated::Known(code, size) ? 1 : 0;
+    }
+
+    /// The chain's outermost link (what the engine calls), or nothing when no detour is attached.
+    void* Outermost(const Chain& c) { return c.count ? c.links[0].detour : nullptr; }
+
+    void Arm(const Chain& c) { g_gxSeams[c.seam].m_bracket = g_enabled ? Outermost(c) : nullptr; }
+}
+
+namespace wxlcompat
+{
+    bool SeamAttach(const char* name, void* detour, void** original, int priority)
+    {
+        if (!name || !detour || !original) return false;
+        for (Chain& c : g_chains)
+        {
+            if (std::strcmp(c.name, name) != 0) continue;
+            if (c.count >= sizeof c.links / sizeof *c.links)
+            {
+                Log(WXL_LOG_WARN, "wxl-vulkan-api", "seam: too many detours on one point, refused");
+                return false;
+            }
+            uint32_t at = c.count;
+            while (at > 0 && c.links[at - 1].priority > priority)
+            {
+                c.links[at] = c.links[at - 1];
+                --at;
+            }
+            c.links[at] = { priority, detour, original };
+            ++c.count;
+            // Every link's original is the next one in, the last one's the engine function.
+            for (uint32_t i = 0; i < c.count; ++i)
+                *c.links[i].original = i + 1 < c.count ? c.links[i + 1].detour : c.engine;
+            Arm(c);
+
+            char line[160];
+            std::snprintf(line, sizeof line, "seam: %s attached (%u detour(s) on it, priority %d)", name, c.count, priority);
+            Log(WXL_LOG_DEBUG, "wxl-vulkan-api", line);
+            return true;
+        }
+        return false;
+    }
+
+    void SeamsEnable(bool on)
+    {
+        g_enabled = on;
+        g_gxShaderKnown = on ? &ShaderKnown : nullptr;
+        for (const Chain& c : g_chains)
+        {
+            Arm(c);
+            g_gxSeams[c.seam].m_reenter = 0;
+        }
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Slots.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Slots.cpp
new file mode 100644
index 00000000..8cdade62
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/src/Slots.cpp
@@ -0,0 +1,92 @@
+// HD: the base and own slot thunks wxl-vulkan-api calls (wxlcompat/Slots.hpp). Part of the
+// wxl-vulkan-api port (WarcraftXL, GPL-3.0).
+//
+// Each thunk has the slot's wxl signature, (device, edx, args...), and calls the x64 member: Base
+// thunks call CGxDevice::X() without virtual dispatch (what the 32-bit code reached through the
+// base vtable), Own thunks call this->X() (what it reached through the device's own vtable).
+// wxl's opaque types are reinterpreted as the real ones; the slot arguments carry the same values.
+
+#include "wxlcompat/Slots.hpp"
+
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+
+namespace
+{
+    namespace wd = wxlvk::device;
+
+    CGxDevice* Dev(void* device) { return static_cast<CGxDevice*>(device); }
+
+    template <class T, class U>
+    T* As(U* p) { return reinterpret_cast<T*>(p); }
+
+    template <class T, class U>
+    const T* As(const U* p) { return reinterpret_cast<const T*>(p); }
+
+    // --- base ---------------------------------------------------------------------------------------------
+    void __fastcall B0(void* d, void*, wd::CGxTex* tex) { Dev(d)->CGxDevice::ITexMarkAsUpdated(As<CGxTex>(tex)); }
+    void __fastcall B2(void* d, void*, const wd::CGxFormat* f) { Dev(d)->CGxDevice::ICursorCreate(*As<CGxFormat>(f)); }
+    void __fastcall B4(void* d, void*) { Dev(d)->CGxDevice::ICursorDraw(); }
+    int __fastcall B10(void* d, void*, WNDPROC proc, const wd::CGxFormat* f)
+    {
+        return Dev(d)->CGxDevice::DeviceCreate(reinterpret_cast<GxWindowProc>(proc), *As<CGxFormat>(f));
+    }
+    void __fastcall B11(void* d, void*) { Dev(d)->CGxDevice::DeviceDestroy(); }
+    int __fastcall B13(void* d, void*, const wd::CGxFormat* f) { return Dev(d)->CGxDevice::DeviceSetFormat(*As<CGxFormat>(f)); }
+    void __fastcall B14(void* d, void*, uint32_t level) { Dev(d)->CGxDevice::DeviceSetBaseMipLevel(level); }
+    void __fastcall B15(void* d, void*, const wd::CGxGammaRamp* r) { Dev(d)->CGxDevice::DeviceSetGamma(*As<CGxGammaRamp>(r)); }
+    void __fastcall B16(void* d, void*, float level) { Dev(d)->CGxDevice::DeviceSetGamma(level); }
+    void __fastcall B23(void* d, void*, uint32_t buffer, wd::CGxTex* tex, uint32_t face)
+    {
+        Dev(d)->CGxDevice::DeviceSetRenderTarget(static_cast<EGxBuffer>(buffer), As<CGxTex>(tex), face);
+    }
+    void __fastcall B38(void* d, void*) { Dev(d)->CGxDevice::ScenePresent(); }
+    void __fastcall B53(void* d, void*, wd::CGxPool* pool) { Dev(d)->CGxDevice::PoolDestroy(As<CGxPool>(pool)); }
+    char* __fastcall B54(void* d, void*, wd::CGxBuf* buf) { return Dev(d)->CGxDevice::BufLock(As<CGxBuf>(buf)); }
+    int __fastcall B55(void* d, void*, wd::CGxBuf* buf, uint32_t bytes) { return Dev(d)->CGxDevice::BufUnlock(As<CGxBuf>(buf), bytes); }
+    void __fastcall B56(void* d, void*, wd::CGxBuf* buf, const void* data, uint32_t size, uint32_t offset)
+    {
+        Dev(d)->CGxDevice::BufData(As<CGxBuf>(buf), data, size, offset);
+    }
+    void __fastcall B58(void* d, void*, wd::CGxTex* tex) { Dev(d)->CGxDevice::TexDestroy(As<CGxTex>(tex)); }
+    void __fastcall B62(void* d, void*, wd::CGxQuery** out, uint32_t type)
+    {
+        Dev(d)->CGxDevice::QueryCreate(*reinterpret_cast<CGxQuery**>(out), static_cast<EGxQueryType>(type));
+    }
+    void __fastcall B63(void* d, void*, wd::CGxQuery** query) { Dev(d)->CGxDevice::QueryDestroy(*reinterpret_cast<CGxQuery**>(query)); }
+    void __fastcall B68(void* d, void*, wd::CGxShader** out, uint32_t target, const char* dir, const char* name,
+                        uint32_t permutations)
+    {
+        Dev(d)->CGxDevice::ShaderCreate(reinterpret_cast<CGxShader**>(out), static_cast<EGxShTarget>(target), dir, name,
+                                        permutations);
+    }
+    void __fastcall B69(void* d, void*, wd::CGxShader** shader) { Dev(d)->CGxDevice::ShaderDestroy(*reinterpret_cast<CGxShader**>(shader)); }
+    void __fastcall B73(void* d, void*, int visible) { Dev(d)->CGxDevice::CursorSetVisible(visible); }
+
+    // --- own ----------------------------------------------------------------------------------------------
+    void __fastcall O0(void* d, void*, wd::CGxTex* tex) { Dev(d)->ITexMarkAsUpdated(As<CGxTex>(tex)); }
+    void __fastcall O2(void* d, void*, const wd::CGxFormat* f) { Dev(d)->ICursorCreate(*As<CGxFormat>(f)); }
+    void __fastcall O3(void* d, void*) { Dev(d)->ICursorDestroy(); }
+    void __fastcall O4(void* d, void*) { Dev(d)->ICursorDraw(); }
+    void __fastcall O5(void* d, void*) { Dev(d)->NotifyOnDeviceRestored(); }
+    void __fastcall O6(void* d, void*) { Dev(d)->NotifyOnTextureRecreation(); }
+    void __fastcall O11(void* d, void*) { Dev(d)->DeviceDestroy(); }
+    void __fastcall O15(void* d, void*, const wd::CGxGammaRamp* r) { Dev(d)->DeviceSetGamma(*As<CGxGammaRamp>(r)); }
+    void __fastcall O58(void* d, void*, wd::CGxTex* tex) { Dev(d)->TexDestroy(As<CGxTex>(tex)); }
+    void __fastcall O68(void* d, void*, wd::CGxShader** out, uint32_t target, const char* dir, const char* name,
+                        uint32_t permutations)
+    {
+        Dev(d)->ShaderCreate(reinterpret_cast<CGxShader**>(out), static_cast<EGxShTarget>(target), dir, name, permutations);
+    }
+    void __fastcall O69(void* d, void*, wd::CGxShader** shader) { Dev(d)->ShaderDestroy(*reinterpret_cast<CGxShader**>(shader)); }
+    void __fastcall O72(void* d, void*, wd::CGxShader* shader) { Dev(d)->IShaderCreate(As<CGxShader>(shader)); }
+}
+
+namespace wxlcompat
+{
+    #define WXLCOMPAT_DEFINE_BASE(slot) \
+        template <> typename wxlvk::device::SlotTraits<slot>::Fn BaseSlot<slot>() { return &B##slot; }
+    #define WXLCOMPAT_DEFINE_OWN(slot) \
+        template <> typename wxlvk::device::SlotTraits<slot>::Fn OwnSlot<slot>() { return &O##slot; }
+    WXLCOMPAT_BASE_SLOTS(WXLCOMPAT_DEFINE_BASE)
+    WXLCOMPAT_OWN_SLOTS(WXLCOMPAT_DEFINE_OWN)
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/wxl/CfgParse.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/wxl/CfgParse.hpp
new file mode 100644
index 00000000..53f85fed
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/wxl/CfgParse.hpp
@@ -0,0 +1,85 @@
+// The WarcraftXL.cfg line format, parsed once here for the core (Config.cpp) and for extensions
+// (ExtensionConfig.hpp): KEY=value lines, '#' or ';' comments, spaces trimmed.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+
+namespace wxl::cfg
+{
+    /**
+     * Interprets a raw knob value as a boolean: a leading 0, n, N, f or F is false, anything else true.
+     *
+     * @param string raw : the value, may be null
+     * @param bool fallback : the result when raw is null or empty
+     * @return bool value
+     */
+    inline bool Truthy(const char* raw, bool fallback)
+    {
+        if (!raw || !*raw) return fallback;
+        const char c = *raw;
+        return !(c == '0' || c == 'n' || c == 'N' || c == 'f' || c == 'F');
+    }
+
+    /**
+     * Reads every KEY=value line of an open .cfg stream into the map. Comments start with '#' or ';',
+     * spaces around the key and the value are dropped, a key already present keeps its first value.
+     *
+     * @param FILE file : an open stream, read to its end
+     * @param map entries : receives the pairs
+     */
+    inline void Parse(FILE* file, std::unordered_map<std::string, std::string>& entries)
+    {
+        char line[512];
+        while (std::fgets(line, sizeof line, file))
+        {
+            char* text = line;
+            while (*text == ' ' || *text == '\t') ++text;
+            if (*text == '#' || *text == ';' || *text == '\0') continue;
+            char* eq = std::strchr(text, '=');
+            if (!eq) continue;
+            char* keyEnd = eq;
+            while (keyEnd > text && (keyEnd[-1] == ' ' || keyEnd[-1] == '\t')) --keyEnd;
+            char* value = eq + 1;
+            while (*value == ' ' || *value == '\t') ++value;
+            char* valueEnd = value + std::strlen(value);
+            while (valueEnd > value && (valueEnd[-1] == '\n' || valueEnd[-1] == '\r'
+                                     || valueEnd[-1] == ' '  || valueEnd[-1] == '\t')) --valueEnd;
+            if (keyEnd > text)
+                entries.emplace(std::string(text, keyEnd), std::string(value, valueEnd));
+        }
+    }
+
+    /**
+     * Parses one .cfg file; a missing file yields an empty map.
+     *
+     * @param string path
+     * @return map entries
+     */
+    inline std::unordered_map<std::string, std::string> ParseFile(const char* path)
+    {
+        std::unordered_map<std::string, std::string> entries;
+        FILE* f = nullptr;
+        if (fopen_s(&f, path, "rb") != 0 || !f) return entries;
+        Parse(f, entries);
+        std::fclose(f);
+        return entries;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/wxl/GraphicsDeviceApi.h b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/wxl/GraphicsDeviceApi.h
new file mode 100644
index 00000000..13dc502d
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/compat/wxl/GraphicsDeviceApi.h
@@ -0,0 +1,66 @@
+// Graphics device provider API: lets an extension supply the engine's CGxDevice backend.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#ifndef WXL_GRAPHICS_DEVICE_API_H
+#define WXL_GRAPHICS_DEVICE_API_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define WXL_GRAPHICS_DEVICE_API_NAME "wxl.graphics.device"
+#define WXL_GRAPHICS_DEVICE_API_VERSION 2
+
+/**
+ * @brief Factory called during the engine's GxDevCreate, in place of the stock CGxDevice::New*.
+ *
+ * It constructs the device and nothing more: the Blizzard base (InitBaseDevice) and the backend's own
+ * vtable over it. The core then does what GxDevCreate does with a stock device -- publishes it as the
+ * engine device, then calls its DeviceCreate (vtable slot 10) with wndProc and context. When that
+ * fails the core deletes it through slot 8 (flags 1) and lets the engine build its stock backend.
+ *
+ * @param api      the API the client asked for (0 OpenGL, 1 D3D9, 2 D3D9Ex).
+ * @param wndProc  the window procedure, passed on to DeviceCreate.
+ * @param context  the CGxFormat, passed on to DeviceCreate.
+ * @return the backend's CGxDevice, or NULL to let the engine build the stock one.
+ */
+typedef void* (__cdecl* WXL_DeviceCreateFn)(int api, void* wndProc, void* context);
+
+typedef struct WXL_GraphicsDeviceApi
+{
+    uint32_t structSize;
+    uint32_t apiVersion;
+
+    /// Registers the device factory. One at a time: a second registration replaces the first.
+    int (__cdecl* RegisterFactory)(WXL_DeviceCreateFn factory, const char* name);
+
+    /// Unregisters @p factory when it is the registered one, so the engine goes back to its own.
+    void (__cdecl* UnregisterFactory)(WXL_DeviceCreateFn factory);
+
+    /// Runs the Blizzard CGxDevice constructor on @p dev, then its default pools and stream buffers.
+    void (__cdecl* InitBaseDevice)(void* dev);
+
+    /// The engine's base CGxDevice vtable, which a backend copies and overrides slot by slot.
+    const void* const* (__cdecl* GetBaseVTable)(void);
+} WXL_GraphicsDeviceApi;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // WXL_GRAPHICS_DEVICE_API_H
