+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+#version 450
+
+layout(set = 0, binding = 0) uniform sampler2D tex;
+
+layout(location = 0) in vec4 vColor;
+layout(location = 1) in vec2 vUV;
+
+layout(location = 0) out vec4 outColor;
+
+void main()
+{
+    outColor = vColor * texture(tex, vUV);
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/overlay.vert b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/overlay.vert
new file mode 100644
index 00000000..27b11c2d
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/overlay.vert
@@ -0,0 +1,35 @@
+// The core's ImGui overlay, drawn natively (src/native/Overlay.cpp): the vertex stage.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+#version 450
+
+// wxl/OverlayApi.h's vertex, 20 bytes: position in display pixels, uv, colour R8G8B8A8_UNORM.
+layout(location = 0) in vec2 inPos;
+layout(location = 1) in vec2 inUV;
+layout(location = 2) in vec4 inColor;
+
+/// Display pixels to clip space: scale (2 / size) and translate (-1 - pos * scale). The display's
+/// +y is down, as Vulkan's clip space, so nothing is flipped.
+layout(push_constant) uniform Consts { vec2 scale; vec2 translate; } pc;
+
+layout(location = 0) out vec4 vColor;
+layout(location = 1) out vec2 vUV;
+
+void main()
+{
+    vColor      = inColor;
+    vUV         = inUV;
+    gl_Position = vec4(inPos * pc.scale + pc.translate, 0.0, 1.0);
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/particle_lit.vert b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/particle_lit.vert
new file mode 100644
index 00000000..cf478783
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/particle_lit.vert
@@ -0,0 +1,109 @@
+// The client's own lit particle vertex shader ("CDiffuse_T1:1"), re-expressed for Vulkan.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+#version 450
+
+// Shaders\Vertex\vs_3_0\CDiffuse_T1.bls permutation 1: lit, no local lights, no skinning, shadow
+// tier 0. Effect(Particle) in shaders\Effects\Particle.wfx pairs it with Combiners_Mod;
+// CParticleEmitter2::RenderParticles picks it for an emitter with the lit bit, with vertex format 4
+// PNCT. Translated line for line from
+// a reconstructed HLSL source (not part of this repository), which fxc compiles back to the shipped token
+// stream byte for byte.
+//
+// The registers it reads, and which engine setter fills each (all vertex target 0, slot 70):
+//
+//   c2..c5    transpose(ProjNative) rows          CShaderEffect::UpdateProjMatrix      0x00872C10
+//   c6, c7    texture matrix unit 0, COLUMNS 0, 1 CShaderEffect::SetTexMtx_Identity   0x00873480
+//   c10       .xyz directional light diffuse, each channel <= 1
+//                                                 CShaderEffect::SetLocalLighting     0x00873CA0
+//   c11       .xyz ambient colour                 same
+//   c12       .xyz normalised light direction, VIEW space, pointing from the light INTO the scene
+//                                                 same; built by CM2Lighting::SetupSunlight
+//   c29       emissive, float4 in 0..1, (0,0,0,0) for a particle batch
+//                                                 CShaderEffect::SetEmissive          0x00873A50
+//   c30       fog (-1/(end-start), end/(end-start), exponent, 0); (0, 1, 1, 0) when fog is off
+//                                                 CShaderEffect::SetFogEnabled        0x00873390
+//   c31..c33  transpose(World*View) rows 0..2     CShaderEffect::UpdateWorldViewMatrix 0x00872B00
+//
+// c0 is def'd (1, 0, 0, 0) in the bytecode. The .w of c10, c11 and c12 overlap the next upload or
+// are stale and are not read. The block below is the whole c0..c39 window, see particle_unlit.vert.
+//
+// Vertex layout PNCT, stride 36: position float3 at 0, normal float3 at 12, D3DCOLOR at 24
+// (B,G,R,A in memory, undone by the B8G8R8A8_UNORM attribute), texcoord float2 at 28. The normal is
+// a per-batch constant (row 2 of the emitter-to-camera matrix): lit particles are lit as if facing up.
+layout(location = 0) in vec3 inPos;
+layout(location = 1) in vec3 inNormal;
+layout(location = 2) in vec4 inColor;
+layout(location = 3) in vec2 inUV;
+
+/// One slice of the uniform ring; the same block as particle_unlit.vert and combiners_mod.frag.
+layout(std140, set = 1, binding = 0) uniform Regs {
+    vec4 p[16];   // pixel  c0..c15, exactly Cmd::pixelConst
+    vec4 misc;      // misc.x = alphaRef / 255.0 (0 = test off); .yzw spare
+    vec4 v[64];   // vertex c0..c63, exactly Cmd::vertexConst (the 64-row slice class)
+} regs;
+
+layout(location = 0) out vec4  vColor;   // COLOR0    -> ps v0
+layout(location = 1) out vec2  vUV;      // TEXCOORD0 -> ps v1.xy
+layout(location = 2) out float vFog;     // FOG       -> ps v2.x, 1 = unfogged
+
+void main()
+{
+    // dp4 r0.x, c31, v0 / dp4 r0.y, c32, v0 / mov r0.w, c0.x / dp4 r0.z, c33, v0.
+    vec4 P = vec4(inPos, 1.0);
+    vec4 p;
+    p.x = dot(regs.v[31], P);
+    p.y = dot(regs.v[32], P);
+    p.w = 1.0;
+    p.z = dot(regs.v[33], P);
+
+    // dp4 o0.xyzw, c2..c5, r0.
+    vec4 clip = vec4(dot(regs.v[2], p), dot(regs.v[3], p), dot(regs.v[4], p), dot(regs.v[5], p));
+
+    // The engine's clip space is D3D's: +y is UP. Vulkan's is +y DOWN. A Vulkan 1.0 target cannot
+    // flip the viewport (a negative height needs VK_KHR_maintenance1), so the flip lives here, on
+    // the one value it concerns. z needs nothing: ProjNative already remaps depth into [0, 1] on
+    // the D3D API id, which is also Vulkan's range.
+    clip.y = -clip.y;
+    gl_Position = clip;
+
+    // mad / max / pow / min: the fog factor, both clamps kept, in the shipped order.
+    float f = p.z * regs.v[30].x + regs.v[30].y;
+    f = max(f, 0.0);
+    f = pow(f, regs.v[30].z);
+    vFog = min(f, 1.0);
+
+    // dp3 r0.xyz, c31..c33, v1; nrm r1.xyz, r0: the normal through the World*View 3x3 as a row
+    // vector, then normalised.
+    vec3 n;
+    n.x = dot(regs.v[31].xyz, inNormal);
+    n.y = dot(regs.v[32].xyz, inNormal);
+    n.z = dot(regs.v[33].xyz, inNormal);
+    n = normalize(n);
+
+    // dp3_sat r0.x, -c12, r1: c12 points INTO the scene, so the lambert term is against -c12,
+    // saturated. mad_sat r0.xyz, r0.x, c10, c11: N.L * diffuse + ambient, saturated. mov r0.w, c0.x.
+    // mad_sat o1, v2, r0, c29: vertex colour * lighting + emissive, saturated -- so alpha is
+    // saturate(colour.a * 1 + emissive.a). No 2x scaling anywhere (that is the Mod2x family).
+    float ndl = clamp(dot(-regs.v[12].xyz, n), 0.0, 1.0);
+    vec4 lit;
+    lit.xyz = clamp(ndl * regs.v[10].xyz + regs.v[11].xyz, 0.0, 1.0);
+    lit.w   = 1.0;
+    vColor  = clamp(inColor * lit + regs.v[29], 0.0, 1.0);
+
+    // (u, v, 1) against the two texture-matrix columns c6.xyw / c7.xyw.
+    vec3 t = vec3(inUV, 1.0);
+    vUV = vec2(dot(regs.v[6].xyw, t), dot(regs.v[7].xyw, t));
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/particle_unlit.vert b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/particle_unlit.vert
new file mode 100644
index 00000000..e64e86c4
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/particle_unlit.vert
@@ -0,0 +1,100 @@
+// The client's own unlit particle vertex shader ("Color_T1:0"), re-expressed for Vulkan.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+#version 450
+
+// Shaders\Vertex\vs_3_0\Color_T1.bls permutation 0 (byte-identical to CDiffuse_T1 permutation 0 and
+// to Color_T1 2/4/6/8). Effect(Particle_Unlit) in shaders\Effects\Particle.wfx pairs it with
+// Combiners_Mod; CParticleEmitter2::RenderParticles picks it for an emitter without the lit bit, with
+// vertex format 8 PCT. Translated line for line from
+// a reconstructed HLSL source (not part of this repository), which fxc compiles back to the shipped token stream
+// byte for byte.
+//
+// The registers it reads, and which engine setter fills each (all vertex target 0, slot 70):
+//
+//   c2..c5    transpose(ProjNative) rows          CShaderEffect::UpdateProjMatrix      0x00872C10
+//   c6, c7    texture matrix unit 0, COLUMNS 0, 1 CShaderEffect::SetTexMtx_Identity   0x00873480
+//             c6 = (m00 m10 m20 m30), c7 = (m01 m11 m21 m31); identity for every particle batch
+//   c30       fog (-1/(end-start), end/(end-start), exponent, 0)
+//             (0, 1, 1, 0) when fog is off          CShaderEffect::SetFogEnabled        0x00873390
+//   c31..c33  transpose(World*View) rows 0..2      CShaderEffect::UpdateWorldViewMatrix 0x00872B00
+//             identity for a particle batch: the vertices were pre-multiplied on the CPU
+//
+// c0 is def'd (1, 0, 0, 0) in the bytecode and is not part of the contract. Nothing in c0..c39 that
+// the shader does not read is touched; the whole window comes in as one uniform slice so that
+// `regs.v[N]` is the engine's `cN`, and src/vulkan/Pipelines.cpp writes it without knowing which
+// shader it is for.
+//
+// Vertex layout PCT, stride 24: position float3 at 0, D3DCOLOR at 12 (B,G,R,A in memory, which the
+// pipeline's B8G8R8A8_UNORM attribute undoes), texcoord float2 at 16.
+layout(location = 0) in vec3 inPos;
+layout(location = 1) in vec4 inColor;
+layout(location = 2) in vec2 inUV;
+
+/// One slice of the uniform ring: the engine's pixel cache c0..c15, one row of backend state,
+/// then its vertex cache c0..c63. Every shader that reads the ring declares exactly this block,
+/// and the translated modules (docs/architecture.md) declare the same one with v[64] or
+/// v[256] -- p and misc come FIRST so a pixel module reads them at the same offset whatever the
+/// vertex module's class.
+layout(std140, set = 1, binding = 0) uniform Regs {
+    vec4 p[16];   // pixel  c0..c15, exactly Cmd::pixelConst
+    vec4 misc;      // misc.x = alphaRef / 255.0 (0 = test off); .yzw spare
+    vec4 v[64];   // vertex c0..c63, exactly Cmd::vertexConst (the 64-row slice class)
+} regs;
+
+layout(location = 0) out vec4  vColor;   // COLOR0    -> ps v0
+layout(location = 1) out vec2  vUV;      // TEXCOORD0 -> ps v1.xy
+layout(location = 2) out float vFog;     // FOG       -> ps v2.x, 1 = unfogged
+
+void main()
+{
+    // dp4 r0.x, c31, v0 / dp4 r0.y, c32, v0 / mov r0.w, c0.x / dp4 r0.z, c33, v0: the position
+    // through the three transposed World*View rows, w forced to 1. The dots are written out one by
+    // one, as in ui.vert, so no mat4 is built and no transpose can creep in.
+    vec4 P = vec4(inPos, 1.0);
+    vec4 p;
+    p.x = dot(regs.v[31], P);
+    p.y = dot(regs.v[32], P);
+    p.w = 1.0;
+    p.z = dot(regs.v[33], P);
+
+    // dp4 o0.xyzw, c2..c5, r0: the projection.
+    vec4 clip = vec4(dot(regs.v[2], p), dot(regs.v[3], p), dot(regs.v[4], p), dot(regs.v[5], p));
+
+    // The engine's clip space is D3D's: +y is UP. Vulkan's is +y DOWN. A Vulkan 1.0 target cannot
+    // flip the viewport (a negative height needs VK_KHR_maintenance1), so the flip lives here, on
+    // the one value it concerns. z needs nothing: ProjNative already remaps depth into [0, 1] on
+    // the D3D API id, which is also Vulkan's range.
+    clip.y = -clip.y;
+    gl_Position = clip;
+
+    // mad / max / pow / min: (end - z) / (end - start), clamped below at 0, raised to the fog
+    // exponent, clamped above at 1. z is view depth, +z forward. Kept in the shipped order and
+    // with both clamps: f is never negative when pow sees it, and fog-off (c30 = (0, 1, 1, 0))
+    // gives exactly 1.
+    float f = p.z * regs.v[30].x + regs.v[30].y;
+    f = max(f, 0.0);
+    f = pow(f, regs.v[30].z);
+    vFog = min(f, 1.0);
+
+    // mad r0.xyz, v2.xyxw, c0.xxyw, c0.yyxw -> (u, v, 1); dp3 against c6.xyww / c7.xyww: the two
+    // texture-matrix columns, with the translation row taken from .w (the matrix is 4x4 and the
+    // shader reads m00, m10, m30 / m01, m11, m31).
+    vec3 t = vec3(inUV, 1.0);
+    vUV = vec2(dot(regs.v[6].xyw, t), dot(regs.v[7].xyw, t));
+
+    // mov o1, v1: the colour untouched -- no 2x, no saturate.
+    vColor = inColor;
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/present.frag b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/present.frag
new file mode 100644
index 00000000..ef3f7f39
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/present.frag
@@ -0,0 +1,41 @@
+// The present pass (src/native/Present.cpp): the back buffer, scaled, through the gamma LUT.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+#version 450
+
+layout(set = 0, binding = 0) uniform sampler2D backBuffer;
+/// 256 x 1 RGBA8: entry i of a channel is what an 8-bit value i of that channel is presented as
+/// (the engine's gamma ramp composed with the inverse of the desktop's).
+layout(set = 0, binding = 1) uniform sampler2D lut;
+
+/// x != 0: apply the LUT.
+layout(push_constant) uniform Consts { vec4 flags; } pc;
+
+layout(location = 0) in vec2 vUV;
+layout(location = 0) out vec4 outColor;
+
+void main()
+{
+    vec3 c = texture(backBuffer, vUV).rgb;
+    if (pc.flags.x != 0.0)
+    {
+        // The centre of entry round(c * 255): a lookup, not a blend between entries.
+        vec3 u = (floor(c * 255.0 + 0.5) + 0.5) / 256.0;
+        c = vec3(texture(lut, vec2(u.r, 0.5)).r,
+                 texture(lut, vec2(u.g, 0.5)).g,
+                 texture(lut, vec2(u.b, 0.5)).b);
+    }
+    outColor = vec4(c, 1.0);
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/present.vert b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/present.vert
new file mode 100644
index 00000000..746f9ffc
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/present.vert
@@ -0,0 +1,27 @@
+// The present pass (src/native/Present.cpp): one full-screen triangle.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+#version 450
+
+// Vertices 0, 1, 2 at uv (0,0), (2,0), (0,2): the triangle covers the viewport, and uv (0,0) is the
+// top-left of both images -- the back buffer's row 0 is its top, as the copy path presents it.
+layout(location = 0) out vec2 vUV;
+
+void main()
+{
+    vec2 p      = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
+    vUV         = p;
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/shadow_cutout.frag b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/shadow_cutout.frag
new file mode 100644
index 00000000..9537bacf
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/shadow_cutout.frag
@@ -0,0 +1,22 @@
+#version 450
+// wxl-vulkan-api: the shadow replay's alpha cutout (src/capture/ShadowPipelines.cpp), in place of an
+// alpha-tested draw's own pixel module when that module reads stage 0 at texcoord0: one texture
+// read and the draw's alpha reference, nothing of the combiners, the lighting or the fog.
+//
+// The bindings are the translated modules' own (docs/architecture.md, "The translated modules"):
+// set 0 binding 0 the stage-0 sampler, set 1 binding 0 the uniform slice whose `misc.x` is the
+// alpha reference (alphaRef / 255, 0 when the draw has none: an alpha-keyed blend keys at one half).
+layout(set = 0, binding = 0) uniform sampler2D s0;
+layout(std140, set = 1, binding = 0) uniform Regs
+{
+    vec4 p[16];
+    vec4 misc;
+} regs;
+
+layout(location = 2) in vec4 texcoord0;
+
+void main()
+{
+    float reference = regs.misc.x > 0.0 ? regs.misc.x : 0.5;
+    if (texture(s0, texcoord0.xy).a < reference) discard;
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/ui.frag b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/ui.frag
new file mode 100644
index 00000000..e2fe2c72
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/ui.frag
@@ -0,0 +1,35 @@
+// The client's own UI pixel shader ("UI"), re-expressed for Vulkan.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+#version 450
+
+// The engine's "UI" pixel shader is tex2D(s0, uv) * color and nothing else; so is this.
+//
+// No alpha test here yet. The UI draws with alphaRef 1 and blend 2 (SRCALPHA / INVSRCALPHA), so a
+// texel the test would drop is one the blend already leaves invisible; the picture is the same
+// either way. When a material that needs it arrives, the test is one `discard` on
+// `color.a * 255.0 < alphaRef` behind a second push constant -- cheap, and a one-line change in
+// both this file and Pipelines.cpp's push range.
+layout(set = 0, binding = 0) uniform sampler2D tex;
+
+layout(location = 0) in vec4 vColor;
+layout(location = 1) in vec2 vUV;
+
+layout(location = 0) out vec4 outColor;
+
+void main()
+{
+    outColor = texture(tex, vUV) * vColor;
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/ui.vert b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/ui.vert
new file mode 100644
index 00000000..c1cc6a3e
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/shaders/glsl/ui.vert
@@ -0,0 +1,49 @@
+// The client's own UI vertex shader ("UI:0"), re-expressed for Vulkan.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+#version 450
+
+// What the engine's bytecode does, read out of it: four dp4 against c0..c3, then a pass-through of
+// the colour and the first texture coordinate. c0..c3 hold transpose(View * ProjNative) -- so c_i
+// is column i of View*ProjNative under the engine's row-vector convention -- which is exactly why
+// the four dots below are written out one by one and not as a mat4 multiply: a mat4 built from
+// the four registers invites a transpose in one direction or the other, and the dots cannot.
+//
+// Vertex layout PCT, stride 24: position float3 at 0, D3DCOLOR at 12 (B,G,R,A in memory, which
+// the pipeline's B8G8R8A8_UNORM attribute undoes), texcoord float2 at 16.
+layout(location = 0) in vec3 inPos;
+layout(location = 1) in vec4 inColor;
+layout(location = 2) in vec2 inUV;
+
+/// The four constant registers the engine's shader reads, pushed per draw (64 bytes).
+layout(push_constant) uniform Consts { vec4 c[4]; } pc;
+
+layout(location = 0) out vec4 vColor;
+layout(location = 1) out vec2 vUV;
+
+void main()
+{
+    vec4 p = vec4(inPos, 1.0);
+    gl_Position = vec4(dot(pc.c[0], p), dot(pc.c[1], p), dot(pc.c[2], p), dot(pc.c[3], p));
+
+    // The engine's clip space is D3D's: +y is UP. Vulkan's is +y DOWN. A Vulkan 1.0 target cannot
+    // flip the viewport (a negative height needs VK_KHR_maintenance1), so the flip lives here, on
+    // the one value it concerns. z needs nothing: ProjNative already remaps depth into [0, 1] on
+    // the D3D API id, which is also Vulkan's range.
+    gl_Position.y = -gl_Position.y;
+
+    vColor = inColor;
+    vUV    = inUV;
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Chain.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Chain.cpp
new file mode 100644
index 00000000..210b0aff
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Chain.cpp
@@ -0,0 +1,491 @@
+// The stages: consumers' compute over the frame (wxl.vk.render RegisterStage), run in order at their
+// point of the engine's frame.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "stages/Chain.hpp"
+
+#include "native/Present.hpp"
+#include "native/Render.hpp"
+#include "native/render/DepthHistory.hpp"
+#include "native/render/Jitter.hpp"
+#include "stages/Gpu.hpp"
+#include "stages/Targets.hpp"
+#include "stages/Timing.hpp"
+#include "vulkan/Pipelines.hpp"
+
+#include "wxl/Script.hpp"
+
+#include <cstring>
+
+namespace
+{
+    namespace present = wxlvk::native::present;
+    namespace gpu     = wxlvk::stages::gpu;
+    namespace targets = wxlvk::stages::targets;
+    namespace timing  = wxlvk::stages::timing;
+
+    using wxlvk::stages::Io;
+    using wxlvk::stages::Point;
+    using wxlvk::stages::chain::kMaxStages;
+
+    constexpr uint32_t kPoints = static_cast<uint32_t>(Point::Count);
+    static_assert(kPoints + kMaxStages <= timing::kLanes, "a timing lane per point and per stage");
+
+    constexpr size_t kNameChars = 48;
+
+    const char* const kPointNames[kPoints] = { "AfterOpaqueWorld", "BeforeUi", "AfterLiquids", "BeforeLiquids",
+                                               "AfterWorldBeforeSpells", "AfterWorldGrade", "AfterWorldBloom" };
+
+    /// The public point of a stage point, and back (an unknown public point is taken as AfterOpaqueWorld,
+    /// as before AfterLiquids existed; Register refuses the others).
+    uint32_t ToPublic(Point p)
+    {
+        return p == Point::BeforeUi ? WXL_VK_POINT_BEFORE_UI
+             : p == Point::AfterLiquids ? WXL_VK_POINT_AFTER_LIQUIDS
+             : p == Point::BeforeLiquids ? WXL_VK_POINT_BEFORE_LIQUIDS
+             : p == Point::AfterWorldBeforeSpells ? WXL_VK_POINT_AFTER_WORLD_BEFORE_SPELLS
+             : p == Point::AfterWorldGrade ? WXL_VK_POINT_AFTER_WORLD_GRADE
+             : p == Point::AfterWorldBloom ? WXL_VK_POINT_AFTER_WORLD_BLOOM
+                                        : WXL_VK_POINT_AFTER_OPAQUE_WORLD;
+    }
+
+    Point FromPublic(uint32_t point)
+    {
+        return point == WXL_VK_POINT_BEFORE_UI ? Point::BeforeUi
+             : point == WXL_VK_POINT_AFTER_LIQUIDS ? Point::AfterLiquids
+             : point == WXL_VK_POINT_BEFORE_LIQUIDS ? Point::BeforeLiquids
+             : point == WXL_VK_POINT_AFTER_WORLD_BEFORE_SPELLS ? Point::AfterWorldBeforeSpells
+             : point == WXL_VK_POINT_AFTER_WORLD_GRADE ? Point::AfterWorldGrade
+             : point == WXL_VK_POINT_AFTER_WORLD_BLOOM ? Point::AfterWorldBloom
+                                                   : Point::AfterOpaqueWorld;
+    }
+
+    /// Why a point's latest run did or did not happen.
+    enum class Outcome : uint8_t
+    {
+        Idle,        ///< no stage wanted
+        Ran,
+        NoFrame,     ///< no frame open, or the draw path is down
+        OffBack,     ///< a point that needs the world's own pass found a texture target current
+        NoBack,      ///< the direct path (no own back buffer) or no image this frame
+        Format,      ///< a back buffer format the stages cannot copy
+        NotReady,    ///< the working image could not be made
+        NoDepth,     ///< the stages need the scene depth and it could not be had
+        Count,
+    };
+
+    const char* const kOutcomeText[] = {
+        "idle (nothing enabled)",
+        "running",
+        "waiting: no frame open",
+        "skipped: a texture target is current",
+        "unavailable: no own back buffer (direct path)",
+        "unavailable: back buffer format",
+        "failed: working image (see the log)",
+        "skipped: no scene depth this frame",
+    };
+    static_assert(sizeof kOutcomeText / sizeof *kOutcomeText == static_cast<size_t>(Outcome::Count), "one text per outcome");
+
+    struct PointState
+    {
+        uint64_t lastSerial = 0;
+        Outcome  outcome    = Outcome::Idle;
+        uint64_t counts[static_cast<size_t>(Outcome::Count)] = {};
+    };
+
+    struct Stage
+    {
+        WXL_VkStageDesc desc = {};
+        Point    point = Point::AfterOpaqueWorld;
+        char     name[kNameChars] = {};
+        uint32_t lane  = 0;       ///< its timing lane, fixed at registration
+        bool     live  = false;
+        uint64_t runs  = 0;
+        bool     wanted = false;  ///< the latest answer of its Wanted, this run
+    };
+
+    /// The world's scene as AfterOpaqueWorld saw it: what BeforeUi and AfterLiquids reconstruct with, since
+    /// the engine's own full-screen passes (and the liquid pass's matrices) may have set their own by then.
+    struct WorldScene
+    {
+        uint64_t             serial = 0;
+        WXL_VkSceneConstants scene  = {};
+        VkViewport           viewport = {};
+        float                jitter[2] = { 0.0f, 0.0f };   ///< what `viewport` carries
+        bool                 valid  = false;
+    };
+
+    struct State
+    {
+        WorldScene world;
+        Stage      stages[kMaxStages];
+        Stage*     order[kMaxStages] = {};   ///< the registered stages by order
+        uint32_t   count = 0;
+        PointState points[kPoints];
+        uint64_t   lastColour   = 0;         ///< the last frame the working image was used
+        bool       formatLogged = false;
+        bool       firstLogged  = false;
+    };
+    State g;
+
+    /// Asks every live stage of the point whether it runs this frame (once per run); true when any does.
+    bool AskWanted(Point p, bool& colour, bool& depth)
+    {
+        bool any = false;
+        colour = depth = false;
+        for (uint32_t i = 0; i < g.count; ++i)
+        {
+            Stage& s = *g.order[i];
+            s.wanted = false;
+            if (!s.live || s.point != p) continue;
+            s.wanted = !s.desc.Wanted || s.desc.Wanted(s.desc.user) != 0;
+            if (!s.wanted) continue;
+            any    = true;
+            colour = colour || (s.desc.flags & WXL_VK_STAGE_WRITES_COLOR) != 0;
+            depth  = depth || (s.desc.flags & WXL_VK_STAGE_NEEDS_DEPTH) != 0;
+        }
+        return any;
+    }
+
+    /// The back buffer's channel order: false for a format the stages cannot copy.
+    bool ChannelOrder(VkFormat format, bool& swapRB)
+    {
+        swapRB = format == VK_FORMAT_B8G8R8A8_UNORM;
+        if (format == VK_FORMAT_B8G8R8A8_UNORM || format == VK_FORMAT_R8G8B8A8_UNORM) return true;
+        if (!g.formatLogged)
+        {
+            g.formatLogged = true;
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "stages: the back buffer is %s; the stages copy only B8G8R8A8 / R8G8B8A8 "
+                                "and stay off", wxlvk::vk::FormatName(format));
+        }
+        return false;
+    }
+
+    /// Whether the frame can be worked on now; `io` receives its extent and channel order.
+    Outcome Preconditions(Point p, Io& io)
+    {
+        if (!present::DrawPathUp() || !present::FrameOpen()) return Outcome::NoFrame;
+        // AfterOpaqueWorld's and AfterLiquids' stages read the depth of the pass the world draws into: only
+        // that pass.
+        if ((p == Point::AfterOpaqueWorld || p == Point::AfterLiquids || p == Point::BeforeLiquids ||
+             p == Point::AfterWorldBeforeSpells || p == Point::AfterWorldGrade || p == Point::AfterWorldBloom) &&
+            !present::OnBackBuffer()) return Outcome::OffBack;
+        VkFormat format = VK_FORMAT_UNDEFINED;
+        if (!present::BackBufferInfo(format, io.extent)) return Outcome::NoBack;
+        if (!ChannelOrder(format, io.swapRB)) return Outcome::Format;
+        return Outcome::Ran;
+    }
+
+    void Copy(VkCommandBuffer cmd, VkImage src, VkImageLayout srcLayout, VkImage dst, VkImageLayout dstLayout,
+              VkExtent2D extent)
+    {
+        VkImageCopy c = {};
+        c.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        c.srcSubresource.layerCount = 1;
+        c.dstSubresource            = c.srcSubresource;
+        c.extent                    = VkExtent3D{ extent.width, extent.height, 1 };
+        gpu::Api()->CmdCopyImage(cmd, src, srcLayout, dst, dstLayout, 1, &c);
+    }
+
+    /// The back buffer into the working image, ready for compute.
+    bool CopyIn(Io& io)
+    {
+        if (!targets::Get(io.extent, io.cmd, io.serial, io.frame)) return false;
+        VkImage back = VK_NULL_HANDLE;
+        VkFormat format = VK_FORMAT_UNDEFINED;
+        VkExtent2D extent = {};
+        if (!present::BackBuffer(io.cmd, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, back, format, extent)) return false;
+        // The working image's earlier readers and writers (the previous run) come first.
+        gpu::Barrier(io.cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                     VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+        Copy(io.cmd, back, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, io.frame.image, VK_IMAGE_LAYOUT_GENERAL, io.extent);
+        gpu::Barrier(io.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                     VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+        g.lastColour = io.serial;
+        return true;
+    }
+
+    /// The working image back onto the back buffer.
+    void CopyOut(const Io& io)
+    {
+        gpu::Barrier(io.cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT,
+                     VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+        VkImage back = VK_NULL_HANDLE;
+        VkFormat format = VK_FORMAT_UNDEFINED;
+        VkExtent2D extent = {};
+        if (!present::BackBuffer(io.cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, back, format, extent)) return;
+        Copy(io.cmd, io.frame.image, VK_IMAGE_LAYOUT_GENERAL, back, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, io.extent);
+    }
+
+    WXL_VkStageContext Context(Point p, const Io& io)
+    {
+        WXL_VkStageContext ctx = {};
+        ctx.structSize      = sizeof ctx;
+        ctx.point           = ToPublic(p);
+        ctx.serial          = io.serial;
+        ctx.completedSerial = present::Completed();
+        ctx.frameSlot       = io.slot;
+        ctx.frameSlots      = wxlvk::vk::pipelines::kFrameSlots;
+        ctx.cmd             = io.cmd;
+        ctx.extent          = io.extent;
+        ctx.colorImage      = io.frame.image;
+        ctx.colorView       = io.frame.view;
+        ctx.colorFormat     = io.frame.format;
+        ctx.colorLayout     = VK_IMAGE_LAYOUT_GENERAL;
+        ctx.swapRB          = io.swapRB ? 1u : 0u;
+        ctx.depthView       = io.depthView;
+        ctx.depthFormat     = io.depthFormat;
+        ctx.depthLayout     = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+        ctx.scene           = &io.scene;
+        ctx.viewport        = io.viewport;
+        ctx.sceneValid      = io.sceneValid ? 1u : 0u;
+        ctx.jitter[0]       = io.jitter[0];
+        ctx.jitter[1]       = io.jitter[1];
+        return ctx;
+    }
+
+    /// Every wanted stage of the point, in order; how many ran. `depthMissing` is set when one was
+    /// skipped for want of the depth.
+    uint32_t RunStages(Point p, const Io& io, bool& depthMissing)
+    {
+        const WXL_VkStageContext ctx = Context(p, io);
+        uint32_t ran = 0;
+        for (uint32_t i = 0; i < g.count; ++i)
+        {
+            Stage& s = *g.order[i];
+            if (!s.wanted || s.point != p) continue;
+            if ((s.desc.flags & WXL_VK_STAGE_NEEDS_DEPTH) && io.depthView == VK_NULL_HANDLE)
+            {
+                depthMissing = true;
+                continue;
+            }
+            timing::Start(io.cmd, s.lane);
+            s.desc.Run(s.desc.user, &ctx);
+            timing::Stop(io.cmd, s.lane);
+            gpu::ComputeToCompute(io.cmd);
+            ++s.runs;
+            ++ran;
+        }
+        return ran;
+    }
+
+    void LogFirst(Point p, const Io& io)
+    {
+        if (g.firstLogged) return;
+        g.firstLogged = true;
+        wxl::ScriptMgr::Log(WXL_LOG_INFO, "stages: first run at %s (frame %llu, %ux%u, %s back buffer, GPU timing %s)",
+                            kPointNames[static_cast<size_t>(p)], static_cast<unsigned long long>(io.serial),
+                            io.extent.width, io.extent.height, io.swapRB ? "BGRA" : "RGBA",
+                            timing::Available() ? "on" : "unavailable");
+    }
+
+    /// The run proper, preconditions met.
+    Outcome Execute(Point p, bool colour, bool depth, Io& io)
+    {
+        io.cmd    = present::Outside();
+        io.slot   = present::Slot();
+        io.serial = present::Serial();
+        if (!io.cmd) return Outcome::NoFrame;
+        const uint32_t lane = static_cast<uint32_t>(p);
+        timing::Open(io.cmd, io.slot, io.serial);
+        timing::Start(io.cmd, lane);
+        if (p != Point::AfterOpaqueWorld && g.world.valid && g.world.serial == io.serial)
+        {
+            io.scene      = g.world.scene;
+            io.viewport   = g.world.viewport;
+            io.jitter[0]  = g.world.jitter[0];
+            io.jitter[1]  = g.world.jitter[1];
+            io.sceneValid = true;
+        }
+        else
+            io.sceneValid = wxlvk::native::render::SceneNow(io.extent, io.scene, io.viewport, io.jitter);
+        if (colour && !CopyIn(io))
+        {
+            timing::Stop(io.cmd, lane);
+            return Outcome::NotReady;
+        }
+        if (depth) present::SceneDepth(io.cmd, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, io.depthView, io.depthFormat);
+        bool depthMissing = false;
+        const uint32_t ran = RunStages(p, io, depthMissing);
+        if (colour) CopyOut(io);
+        // HD/Cata: a snapshot stage can publish sampled images to the water's subsequent draws.
+        // The existing inter-stage compute barrier alone does not cover fragment/vertex readers.
+        // Image layouts and the ownership/lifetime of each published image remain the stage's duty.
+        if (p == Point::BeforeLiquids)
+            gpu::Barrier(io.cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+                         VK_PIPELINE_STAGE_VERTEX_SHADER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT |
+                             VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_ACCESS_SHADER_READ_BIT);
+        timing::Stop(io.cmd, lane);
+        // The compute binds share nothing with the draws' tracking, but the next pass begins clean.
+        wxlvk::vk::pipelines::InvalidateBindings();
+        if (!ran) return depthMissing ? Outcome::NoDepth : Outcome::NotReady;
+        LogFirst(p, io);
+        return Outcome::Ran;
+    }
+
+    /// The working image goes back once no point has used it for longer than the frames in flight.
+    void ReleaseIdle()
+    {
+        if (!present::FrameOpen()) return;
+        if (present::Serial() > g.lastColour + wxlvk::vk::pipelines::kFrameSlots + 1) targets::Release(g.lastColour);
+    }
+
+    Stage* Find(void* handle)
+    {
+        Stage* s = static_cast<Stage*>(handle);
+        return s >= g.stages && s < g.stages + kMaxStages && s->lane ? s : nullptr;
+    }
+
+    double Avg(const timing::Lane& t) { return t.samples ? t.sumMs / static_cast<double>(t.samples) : 0.0; }
+}
+
+namespace wxlvk::stages::chain
+{
+    void* Add(const WXL_VkStageDesc& desc, const char* name)
+    {
+        if (g.count >= kMaxStages) return nullptr;
+        Stage& s = g.stages[g.count];
+        s.desc  = desc;
+        s.point = FromPublic(desc.point);
+        std::strncpy(s.name, name ? name : "stage", kNameChars - 1);
+        s.name[kNameChars - 1] = '\0';
+        s.lane = kPoints + g.count;
+        s.live = true;
+        // Kept sorted by order (stable: an equal order goes after).
+        uint32_t at = g.count;
+        while (at > 0 && g.order[at - 1]->desc.order > desc.order)
+        {
+            g.order[at] = g.order[at - 1];
+            --at;
+        }
+        g.order[at] = &s;
+        ++g.count;
+        return &s;
+    }
+
+    void Remove(void* stage)
+    {
+        if (Stage* s = Find(stage)) s->live = false;
+    }
+
+    bool Stats(void* stage, WXL_VkStageStats& out)
+    {
+        const Stage* s = Find(stage);
+        if (!s) return false;
+        WXL_VkStageStats st = {};
+        st.structSize = out.structSize;
+        st.point      = ToPublic(s->point);
+        st.runs       = s->runs;
+        const PointState& ps = g.points[static_cast<size_t>(s->point)];
+        st.pointStatus = kOutcomeText[static_cast<size_t>(ps.outcome)];
+        if (timing::Available())
+        {
+            const timing::Lane& t = timing::Get(s->lane);
+            st.lastMs  = static_cast<float>(t.lastMs);
+            st.avgMs   = static_cast<float>(Avg(t));
+            st.maxMs   = static_cast<float>(t.maxMs);
+            st.pointMs = static_cast<float>(timing::Get(static_cast<uint32_t>(s->point)).lastMs);
+        }
+        else
+            st.lastMs = st.avgMs = st.maxMs = st.pointMs = -1.0f;
+        // Only what the caller's structure has room for.
+        const size_t n = out.structSize < sizeof st ? out.structSize : sizeof st;
+        std::memcpy(&out, &st, n);
+        out.structSize = static_cast<uint32_t>(n);
+        return true;
+    }
+
+    void NoteWorld()
+    {
+        VkFormat   format = VK_FORMAT_UNDEFINED;
+        VkExtent2D extent = {};
+        g.world.valid = false;
+        if (!present::FrameOpen() || !present::OnBackBuffer() || !present::BackBufferInfo(format, extent)) return;
+        g.world.serial = present::Serial();
+        g.world.valid  = wxlvk::native::render::SceneNow(extent, g.world.scene, g.world.viewport, g.world.jitter);
+    }
+
+    void Run(Point point)
+    {
+        if (point >= Point::Count) return;
+        if (point == Point::AfterOpaqueWorld) NoteWorld();
+        PointState& ps = g.points[static_cast<size_t>(point)];
+        if (present::FrameOpen() && ps.lastSerial == present::Serial()) return;   // once per frame
+        bool colour = false, depth = false;
+        if (!AskWanted(point, colour, depth))
+        {
+            ps.outcome = Outcome::Idle;
+            ReleaseIdle();
+            return;
+        }
+        Io io;
+        Outcome outcome = Preconditions(point, io);
+        if (outcome == Outcome::Ran)
+        {
+            ps.lastSerial = present::Serial();
+            outcome = Execute(point, colour, depth, io);
+        }
+        ps.outcome = outcome;
+        ++ps.counts[static_cast<size_t>(outcome)];
+        ReleaseIdle();
+    }
+
+    void LogStats()
+    {
+        for (uint32_t p = 0; p < kPoints; ++p)
+        {
+            const PointState& ps = g.points[p];
+            const timing::Lane& t = timing::Get(p);
+            uint64_t reached = 0;
+            for (uint64_t c : ps.counts) reached += c;
+            if (!reached) continue;
+            wxl::ScriptMgr::Log(WXL_LOG_INFO,
+                                "stages: %s: %llu run(s), skipped %llu no frame / %llu off the back buffer / %llu no back "
+                                "buffer / %llu format / %llu failed / %llu no depth; GPU avg %.3f ms, max %.3f (copies "
+                                "included); working image %llu MiB",
+                                kPointNames[p], static_cast<unsigned long long>(ps.counts[static_cast<size_t>(Outcome::Ran)]),
+                                static_cast<unsigned long long>(ps.counts[static_cast<size_t>(Outcome::NoFrame)]),
+                                static_cast<unsigned long long>(ps.counts[static_cast<size_t>(Outcome::OffBack)]),
+                                static_cast<unsigned long long>(ps.counts[static_cast<size_t>(Outcome::NoBack)]),
+                                static_cast<unsigned long long>(ps.counts[static_cast<size_t>(Outcome::Format)]),
+                                static_cast<unsigned long long>(ps.counts[static_cast<size_t>(Outcome::NotReady)]),
+                                static_cast<unsigned long long>(ps.counts[static_cast<size_t>(Outcome::NoDepth)]), Avg(t),
+                                t.maxMs, static_cast<unsigned long long>(targets::Bytes() >> 20));
+        }
+        for (uint32_t i = 0; i < g.count; ++i)
+        {
+            const Stage& s = *g.order[i];
+            const timing::Lane& t = timing::Get(s.lane);
+            if (!s.runs) continue;
+            wxl::ScriptMgr::Log(WXL_LOG_INFO, "stages: '%s' at %s (order %d): %llu run(s), GPU avg %.3f ms, max %.3f",
+                                s.name, kPointNames[static_cast<size_t>(s.point)], s.desc.order,
+                                static_cast<unsigned long long>(s.runs), Avg(t), t.maxMs);
+        }
+        if (const uint64_t copies = wxlvk::native::render::depthhistory::Copies())
+            wxl::ScriptMgr::Log(WXL_LOG_INFO, "stages: depth history: %llu copy(ies) of the opaque depth for the "
+                                "rendering API's consumers", static_cast<unsigned long long>(copies));
+        uint64_t jittered = 0, skipped = 0;
+        wxlvk::native::render::jitter::Counts(jittered, skipped);
+        if (jittered || skipped)
+            wxl::ScriptMgr::Log(WXL_LOG_INFO, "stages: jitter: %llu world draw(s) jittered, %llu full-depth-range draw(s) "
+                                "in the world pass left alone", static_cast<unsigned long long>(jittered),
+                                static_cast<unsigned long long>(skipped));
+        timing::Reset();
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Chain.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Chain.hpp
