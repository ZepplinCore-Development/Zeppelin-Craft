+// SPDX-License-Identifier: GPL-3.0-or-later
+// HdBloom.cpp formulas and HDR intermediate formats, isolated from water/fog/grade modules.
+#include "HdVulkanBloom.h"
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <new>
+#ifndef HD_BLOOM_STANDALONE
+#include <cstdio>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/Types.h"
+#include "WoW/Source/WorldClient/DayNight__DNInfo.h"
+#include "WoW/Source/WorldClient/HD/HdBloom.h"
+#include "native/Present.hpp"
