+CGxDevice* CreateCGxDeviceVulkan() {
+    void* mem = SMemAlloc(sizeof(CGxDeviceVulkan), __FILE__, __LINE__, 0);
+
+    if (!mem) {
+        return nullptr;
+    }
+
+    return new (mem) CGxDeviceVulkan();
+}
