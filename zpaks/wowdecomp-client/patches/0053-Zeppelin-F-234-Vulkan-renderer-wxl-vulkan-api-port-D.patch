index 00000000..33cc3c9a
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/capture/ShadowPass.hpp
@@ -0,0 +1,36 @@
+// The shadow replay's depth-only render pass class.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include "vulkan/Vk.hpp"
+
+// One depth attachment, no colour: CLEAR on load (the replay draws every caster again), STORE,
+// UNDEFINED -> SHADER_READ_ONLY_OPTIMAL. Its external dependencies order it after the previous
+// frames' fragment and compute reads of the same image, and its writes before the fragment and
+// compute reads that follow -- so a consumer samples the map with no barrier of its own. Made on
+// first use, kept for the device's life (pipelines are built against it).
+namespace wxlvk::capture::shadowpass
+{
+    /// The pass, or VK_NULL_HANDLE when no format supports a sampled depth attachment.
+    VkRenderPass Get();
+
+    /// The same class with LOAD on load, from SHADER_READ_ONLY_OPTIMAL (WXL_VK_REPLAY_LOAD).
+    VkRenderPass GetLoad();
+
+    /// Its depth format: D32_SFLOAT where it can be sampled, else D16_UNORM.
+    VkFormat Format();
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/capture/ShadowPipelines.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/capture/ShadowPipelines.cpp
new file mode 100644
index 00000000..2221944c
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/capture/ShadowPipelines.cpp
@@ -0,0 +1,193 @@
+// The shadow replay's pipelines: one per captured pipeline entry (and alpha test), depth only.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "capture/ShadowPipelines.hpp"
+
+#include "capture/ShadowPass.hpp"
+#include "vulkan/Context.hpp"
+#include "vulkan/Pipelines.hpp"
+#include "vulkan/Shaders.hpp"
+
+#include "wxl/Script.hpp"
+
+namespace
+{
+    namespace context   = wxlvk::vk::context;
+    namespace pipelines = wxlvk::vk::pipelines;
+    using wxlvk::capture::shadowpipes::Pipe;
+
+    /// An open-addressed table over (entry << 1 | alphaTest): a zone has a few hundred entries.
+    constexpr uint32_t kSlots = 4096;
+
+    struct Slot
+    {
+        uint32_t key    = 0xFFFFFFFFu;
+        Pipe     pipe;
+        bool     failed = false;
+    };
+
+    struct State
+    {
+        VkDevice device = nullptr;
+        Slot     slots[kSlots];
+        uint32_t built  = 0;
+        uint32_t failed = 0;
+        bool     full   = false;
+    };
+    State g;
+
+    VkPipeline Build(const pipelines::ShadowSource& src, VkRenderPass pass, const context::Handles& h)
+    {
+        namespace shaders = wxlvk::vk::shaders;
+        const VkShaderModule vert = shaders::GetPath(src.vertPath);
+        const VkShaderModule frag = src.fragPath[0] ? shaders::GetPath(src.fragPath) : VK_NULL_HANDLE;
+        if (vert == VK_NULL_HANDLE || (src.fragPath[0] && frag == VK_NULL_HANDLE)) return VK_NULL_HANDLE;
+        VkPipelineShaderStageCreateInfo stages[2] = {};
+        stages[0].sType  = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+        stages[0].stage  = VK_SHADER_STAGE_VERTEX_BIT;
+        stages[0].module = vert;
+        stages[0].pName  = "main";
+        stages[1]        = stages[0];
+        stages[1].stage  = VK_SHADER_STAGE_FRAGMENT_BIT;
+        stages[1].module = frag;
+
+        VkPipelineVertexInputStateCreateInfo input = {};
+        input.sType                           = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
+        input.vertexBindingDescriptionCount   = src.bindingCount;
+        input.pVertexBindingDescriptions      = src.bindings;
+        input.vertexAttributeDescriptionCount = src.attrCount;
+        input.pVertexAttributeDescriptions    = src.attrs;
+        VkPipelineInputAssemblyStateCreateInfo assembly = {};
+        assembly.sType    = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+        assembly.topology = src.topology;
+        VkPipelineViewportStateCreateInfo viewport = {};
+        viewport.sType         = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+        viewport.viewportCount = 1;
+        viewport.scissorCount  = 1;
+        VkPipelineRasterizationStateCreateInfo raster = {};
+        raster.sType           = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+        raster.polygonMode     = VK_POLYGON_MODE_FILL;
+        raster.cullMode        = VK_CULL_MODE_NONE;
+        raster.frontFace       = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+        raster.depthBiasEnable = VK_TRUE;
+        raster.lineWidth       = 1.0f;
+        VkPipelineMultisampleStateCreateInfo multisample = {};
+        multisample.sType                = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+        multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+        VkPipelineDepthStencilStateCreateInfo depth = {};
+        depth.sType            = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO;
+        depth.depthTestEnable  = VK_TRUE;
+        depth.depthWriteEnable = VK_TRUE;
+        depth.depthCompareOp   = VK_COMPARE_OP_LESS_OR_EQUAL;
+        depth.maxDepthBounds   = 1.0f;
+        VkPipelineColorBlendStateCreateInfo blend = {};
+        blend.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+        const VkDynamicState dynamics[3] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR, VK_DYNAMIC_STATE_DEPTH_BIAS };
+        VkPipelineDynamicStateCreateInfo dynamic = {};
+        dynamic.sType             = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+        dynamic.dynamicStateCount = 3;
+        dynamic.pDynamicStates    = dynamics;
+
+        VkGraphicsPipelineCreateInfo info = {};
+        info.sType               = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+        info.stageCount          = frag != VK_NULL_HANDLE ? 2u : 1u;
+        info.pStages             = stages;
+        info.pVertexInputState   = &input;
+        info.pInputAssemblyState = &assembly;
+        info.pViewportState      = &viewport;
+        info.pRasterizationState = &raster;
+        info.pMultisampleState   = &multisample;
+        info.pDepthStencilState  = &depth;
+        info.pColorBlendState    = &blend;
+        info.pDynamicState       = &dynamic;
+        info.layout              = src.layout;
+        info.renderPass          = pass;
+        info.basePipelineIndex   = -1;
+        VkPipeline pipe = VK_NULL_HANDLE;
+        if (h.dapi->CreateGraphicsPipelines(h.device, pipelines::PipelineCache(), 1, &info, nullptr, &pipe) != VK_SUCCESS)
+            return VK_NULL_HANDLE;
+        return pipe;
+    }
+
+    Slot* Find(uint32_t key, bool insert)
+    {
+        uint32_t i = (key * 2654435761u) & (kSlots - 1);
+        for (uint32_t probe = 0; probe < kSlots; ++probe, i = (i + 1) & (kSlots - 1))
+        {
+            if (g.slots[i].key == key) return &g.slots[i];
+            if (g.slots[i].key == 0xFFFFFFFFu) return insert ? &g.slots[i] : nullptr;
+        }
+        return nullptr;
+    }
+
+    void Fill(Slot& slot, uint32_t entry, bool alphaTest, const context::Handles& h)
+    {
+        pipelines::ShadowSource src;
+        const VkRenderPass pass = wxlvk::capture::shadowpass::Get();
+        if (pass == VK_NULL_HANDLE || !pipelines::ShadowSourceFor(entry, alphaTest, src)) return;
+        slot.pipe.pipeline = Build(src, pass, h);
+        slot.pipe.layout   = src.layout;
+        slot.pipe.bones    = src.bones;
+        slot.pipe.wind     = src.wind;
+    }
+}
+
+namespace wxlvk::capture::shadowpipes
+{
+    bool Get(uint32_t entry, bool alphaTest, Pipe& out)
+    {
+        const context::Handles* h = context::Get();
+        if (!h || !h->device) return false;
+        if (g.device != h->device)
+        {
+            // A new device: the old one's pipelines are gone with it, never destroyed here.
+            for (Slot& s : g.slots) s = Slot();
+            g.built  = 0;
+            g.failed = 0;
+            g.full   = false;
+            g.device = h->device;
+        }
+        const uint32_t key = (entry << 1) | (alphaTest ? 1u : 0u);
+        Slot* slot = Find(key, true);
+        if (!slot)
+        {
+            if (!g.full)
+            {
+                g.full = true;
+                wxl::ScriptMgr::Log(WXL_LOG_WARN, "capture: the shadow pipeline table is full (%u); later "
+                                    "casters are not replayed (logged once)", kSlots);
+            }
+            return false;
+        }
+        if (slot->key != key)
+        {
+            slot->key = key;
+            Fill(*slot, entry, alphaTest, *h);
+            slot->failed = slot->pipe.pipeline == VK_NULL_HANDLE;
+            if (slot->failed) ++g.failed;
+            else ++g.built;
+        }
+        if (slot->failed) return false;
+        out = slot->pipe;
+        return true;
+    }
+
+    void Counts(uint32_t& built, uint32_t& failed)
+    {
+        built  = g.built;
+        failed = g.failed;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/capture/ShadowPipelines.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/capture/ShadowPipelines.hpp
new file mode 100644
index 00000000..29790270
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/capture/ShadowPipelines.hpp
@@ -0,0 +1,44 @@
+// The shadow replay's pipelines: one per captured pipeline entry (and alpha test), depth only.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include "vulkan/Vk.hpp"
+
+#include <cstdint>
+
+// The entry's vertex input and layout (pipelines::ShadowSourceFor), its vertex module's shadow
+// variant (shadowgen.py: the clip position re-projected by the push range's matrix), its pixel module
+// only when the draw is alpha-tested (the module ends with that test), no colour attachment, no
+// culling (both faces cast: thin geometry has no back), depth test and write, the bias dynamic.
+// Built on first use against the shadow pass class, through the persisted pipeline cache; a build
+// that fails is remembered and its draws skipped.
+namespace wxlvk::capture::shadowpipes
+{
+    struct Pipe
+    {
+        VkPipeline       pipeline = VK_NULL_HANDLE;
+        VkPipelineLayout layout   = VK_NULL_HANDLE;
+        bool             bones    = false;   ///< binds set 2 (the palette)
+        bool             wind     = false;   ///< binds set 3 and pushes the wind's values, the matrix at offset 16
+    };
+
+    /// The pipeline for (entry, alphaTest); false when it cannot be had.
+    bool Get(uint32_t entry, bool alphaTest, Pipe& out);
+
+    /// Pipelines built and builds that failed, for the stats.
+    void Counts(uint32_t& built, uint32_t& failed);
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/CameraCut.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/CameraCut.hpp
new file mode 100644
index 00000000..dc376bb5
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/CameraCut.hpp
@@ -0,0 +1,64 @@
+// Whether the camera jumped between two frames: a cut, a teleport, a loading screen.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+// One rule for everything that keeps last frame's image (TAA's motion, the depth history): the
+// previous frame must be the one right before, and the eye must not have moved more than 10 yards
+// or turned more than 60 degrees in between.
+namespace wxlvk::cut
+{
+    constexpr float kDistance = 10.0f;   ///< yards in one frame
+    constexpr float kCosine   = 0.5f;    ///< a turn past 60 degrees in one frame
+
+    /// A frame's camera, as the test needs it.
+    struct Camera
+    {
+        bool     valid      = false;
+        uint64_t serial     = 0;
+        float    eye[3]     = {};
+        float    forward[3] = {};
+    };
+
+    /// The camera of a frame from its view matrix (row vectors: the forward axis in world space is
+    /// the third column) and eye.
+    inline Camera Of(uint64_t serial, const float view[16], const float eye[4])
+    {
+        Camera c;
+        const float x = view[2], y = view[6], z = view[10];
+        const float len = std::sqrt(x * x + y * y + z * z);
+        c.forward[0] = len > 0.0f ? x / len : 0.0f;
+        c.forward[1] = len > 0.0f ? y / len : 0.0f;
+        c.forward[2] = len > 0.0f ? z / len : 1.0f;
+        for (int i = 0; i < 3; ++i) c.eye[i] = eye[i];
+        c.serial = serial;
+        c.valid  = true;
+        return c;
+    }
+
+    /// Whether `now` cannot use what was kept at `before`.
+    inline bool Between(const Camera& before, const Camera& now)
+    {
+        if (!before.valid || !now.valid || before.serial + 1 != now.serial) return true;
+        const float dx = now.eye[0] - before.eye[0], dy = now.eye[1] - before.eye[1], dz = now.eye[2] - before.eye[2];
+        if (dx * dx + dy * dy + dz * dz > kDistance * kDistance) return true;
+        return now.forward[0] * before.forward[0] + now.forward[1] * before.forward[1]
+                   + now.forward[2] * before.forward[2] < kCosine;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Crc32.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Crc32.hpp
new file mode 100644
index 00000000..3d18052d
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Crc32.hpp
@@ -0,0 +1,18 @@
+// HD: local IEEE CRC-32 helper for wxl-vulkan-api (GPL-3.0); no dependency on an unavailable bake SDK.
+// This file is part of wxl-vulkan-api and is distributed under GPL-3.0-or-later.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+namespace wxlvk {
+    inline uint32_t Crc32(const void* bytes, size_t size) {
+        const auto* data = static_cast<const unsigned char*>(bytes);
+        uint32_t crc = 0xffffffffu;
+        for (size_t i = 0; i < size; ++i) {
+            crc ^= data[i];
+            for (unsigned bit = 0; bit < 8; ++bit)
+                crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+        }
+        return crc ^ 0xffffffffu;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Matrix.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Matrix.hpp
new file mode 100644
index 00000000..95ad9024
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Matrix.hpp
@@ -0,0 +1,73 @@
+// 4x4 matrices as the engine holds them: row-major, row vectors (v' = v * M).
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include <cmath>
+
+// Uploaded as they are, such a matrix reads in GLSL as its transpose, so `m * v` there is the row
+// vector product v * M here: no transpose on either side.
+namespace wxlvk::matrix
+{
+    /// out = a * b.
+    inline void Mul(const float a[16], const float b[16], float out[16])
+    {
+        for (int r = 0; r < 4; ++r)
+            for (int c = 0; c < 4; ++c)
+                out[r * 4 + c] = a[r * 4 + 0] * b[0 * 4 + c] + a[r * 4 + 1] * b[1 * 4 + c] + a[r * 4 + 2] * b[2 * 4 + c]
+                                 + a[r * 4 + 3] * b[3 * 4 + c];
+    }
+
+    /**
+     * The inverse, by Gauss-Jordan elimination with partial pivoting (in double).
+     *
+     * @return bool ok : false for a singular matrix; `out` is then untouched
+     */
+    inline bool Invert(const float m[16], float out[16])
+    {
+        double a[4][8];
+        for (int r = 0; r < 4; ++r)
+            for (int c = 0; c < 4; ++c)
+            {
+                a[r][c]     = m[r * 4 + c];
+                a[r][c + 4] = r == c ? 1.0 : 0.0;
+            }
+        for (int col = 0; col < 4; ++col)
+        {
+            int pivot = col;
+            for (int r = col + 1; r < 4; ++r)
+                if (std::fabs(a[r][col]) > std::fabs(a[pivot][col])) pivot = r;
+            if (std::fabs(a[pivot][col]) < 1e-30) return false;
+            for (int c = 0; c < 8; ++c)
+            {
+                const double t = a[col][c];
+                a[col][c]   = a[pivot][c];
+                a[pivot][c] = t;
+            }
+            const double inv = 1.0 / a[col][col];
+            for (int c = 0; c < 8; ++c) a[col][c] *= inv;
+            for (int r = 0; r < 4; ++r)
+            {
+                if (r == col) continue;
+                const double f = a[r][col];
+                for (int c = 0; c < 8; ++c) a[r][c] -= f * a[col][c];
+            }
+        }
+        for (int r = 0; r < 4; ++r)
+            for (int c = 0; c < 4; ++c) out[r * 4 + c] = static_cast<float>(a[r][c + 4]);
+        return true;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/ModulePath.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/ModulePath.hpp
new file mode 100644
index 00000000..e2b97aa1
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/ModulePath.hpp
@@ -0,0 +1,116 @@
+// Where this extension's own files live, resolved from the DLL rather than from the process.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include <windows.h>
+
+#include <string>
+
+// This extension deploys as a self-contained folder:
+//
+//     Extensions/wxl-vulkan-api/
+//     +-- wxl-vulkan-api.dll
+//     +-- shaders/*.spv
+//
+// so anything it loads at runtime has to be found relative to **the DLL**, never relative to the
+// process. Two independent reasons, and either one on its own would be enough:
+//
+//  - the working directory is not reliably the client's folder. The core's own config reader already
+//    compensates for this by looking for WarcraftXL.cfg one level up as well, which is evidence from
+//    inside this project rather than a general worry.
+//  - even when it is, the client's folder is the wrong place: our files are a directory deeper, and
+//    the point of the layout is that the extension's folder can be dropped in or deleted whole.
+//
+// GetModuleHandleEx with FROM_ADDRESS on a function of ours is what makes this self-locating: it
+// asks the loader which module a given address belongs to, so it works without the DllMain handle
+// being plumbed anywhere and without naming our own file, which would be a second place to keep the
+// DLL's name correct.
+namespace wxlvk::path
+{
+    namespace detail
+    {
+        /// A function whose address is inside this DLL. Only its address is used.
+        inline void Anchor() {}
+    }
+
+    /**
+     * The directory holding this DLL, with a trailing backslash. Empty if the loader refused.
+     *
+     * Resolved once. UNPINNED deliberately: the flag set is FROM_ADDRESS without
+     * UNCHANGED_REFCOUNT, so the handle is reference-counted for the duration -- but since the only
+     * use is an immediate GetModuleFileNameA, the reference is released right after and nothing is
+     * held. The core keeps extensions loaded for the life of the process anyway.
+     *
+     * @return string dir : e.g. "...\\Extensions\\wxl-vulkan-api\\", or "" on failure
+     */
+    inline const std::string& Dir()
+    {
+        static const std::string dir = [] () -> std::string {
+            HMODULE self = nullptr;
+            if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+                                    reinterpret_cast<LPCSTR>(&detail::Anchor), &self)
+                || !self)
+                return std::string();
+
+            // MAX_PATH is not a guarantee on a long path, so grow until the call fits rather than
+            // truncating: a silently truncated path would turn into a confusing "file not found".
+            std::string buf(MAX_PATH, '\0');
+            for (;;)
+            {
+                const DWORD n = GetModuleFileNameA(self, buf.data(),
+                                                   static_cast<DWORD>(buf.size()));
+                if (n == 0)
+                {
+                    FreeLibrary(self);
+                    return std::string();
+                }
+                if (n < buf.size())
+                {
+                    buf.resize(n);
+                    break;
+                }
+                if (buf.size() >= 32768)   // the NT path ceiling; give up rather than loop forever
+                {
+                    FreeLibrary(self);
+                    return std::string();
+                }
+                buf.resize(buf.size() * 2);
+            }
+            FreeLibrary(self);
+
+            const size_t slash = buf.find_last_of("\\/");
+            if (slash == std::string::npos) return std::string();
+            // HD: compiled into WowClient64.exe, so the module is the client itself; the files the
+            // extension kept next to its DLL (shaders\, the pipeline cache) live in Vulkan\ beside it.
+            return buf.substr(0, slash + 1) + "Vulkan\\";
+        }();
+        return dir;
+    }
+
+    /**
+     * A path to one of our deployed files.
+     *
+     * @param string relative : a path under the extension's folder, e.g. "shaders\\blit.vert.spv"
+     * @return string path : the absolute path, or `relative` unchanged if Dir() failed -- which
+     *         leaves the caller's own open failing with a sensible name instead of an empty one
+     */
+    inline std::string Resolve(const char* relative)
+    {
+        const std::string& dir = Dir();
+        return dir.empty() ? std::string(relative) : dir + relative;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Settings.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Settings.hpp
new file mode 100644
index 00000000..3b654467
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Settings.hpp
@@ -0,0 +1,339 @@
+// The extension's configuration keys, read from the environment first and WarcraftXL.cfg second.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include "wxl/CfgParse.hpp"
+
+#include <windows.h>
+
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+
+// Every key lives here so WarcraftXL.cfg is parsed once, with the core's own precedence, behind one
+// function-local static. Each reader resolves its key once and caches the answer.
+namespace wxlvk::settings
+{
+    namespace detail
+    {
+        /**
+         * The WarcraftXL.cfg entries, parsed once per DLL.
+         *
+         * The core's own reader looks for WarcraftXL.cfg in the working directory and falls back one
+         * level up, because the client is sometimes launched from a subdirectory. That two-path
+         * precedence cannot be expressed through wxl::ext::config::Raw (its File() helper caches
+         * whichever path the first caller passed), so both lookups are done here on
+         * wxl::cfg::ParseFile, the primitive both sides share: same line format, same comments.
+         *
+         * @return map entries
+         */
+        inline const std::unordered_map<std::string, std::string>& CfgFile()
+        {
+            static const std::unordered_map<std::string, std::string> entries = [] {
+                // HD: no WarcraftXL.cfg in the x64 client; the same KEY=value lines go in Vulkan\Vulkan.cfg.
+                auto map = wxl::cfg::ParseFile("Vulkan\\Vulkan.cfg");
+                return map;
+            }();
+            return entries;
+        }
+
+        /**
+         * One key's raw value: the environment first, then WarcraftXL.cfg -- the core's precedence.
+         *
+         * @param string name : the key
+         * @param string buf : receives the NUL-terminated value
+         * @param size_t cap : capacity of buf
+         * @return bool found : false when neither source carries a non-empty value
+         */
+        inline bool Raw(const char* name, char* buf, size_t cap)
+        {
+            const DWORD n = GetEnvironmentVariableA(name, buf, static_cast<DWORD>(cap));
+            if (n > 0 && n < cap) return true;
+
+            const auto& cfg = CfgFile();
+            const auto it = cfg.find(name);
+            if (it == cfg.end() || it->second.empty() || it->second.size() + 1 > cap) return false;
+            std::memcpy(buf, it->second.c_str(), it->second.size() + 1);
+            return true;
+        }
+
+        /// The spellings that mean "off" for every key, so a key can be left in a .cfg and flipped
+        /// rather than deleted. Matched before wxl::cfg::Truthy, which only rejects a leading
+        /// 0 / n / f.
+        inline bool OffWord(const char* value)
+        {
+            return _stricmp(value, "off") == 0 || _stricmp(value, "none") == 0
+                   || _stricmp(value, "stock") == 0 || _stricmp(value, "no") == 0
+                   || _stricmp(value, "false") == 0 || _stricmp(value, "0") == 0;
+        }
+
+        /**
+         * One plain on/off key.
+         *
+         * @param string key : the key to read
+         * @return bool wanted : false when unset or set to an off spelling
+         */
+        inline bool Flag(const char* key)
+        {
+            char value[32] = {};
+            if (!Raw(key, value, sizeof value)) return false;
+            if (OffWord(value)) return false;
+            return wxl::cfg::Truthy(value, false);
+        }
+    }
+
+    // --- WXL_VK_DEVICE ---------------------------------------------------------------------------
+
+    /// The key that turns the extension on: `native` puts the native Vulkan device in place of the
+    /// engine's D3D9 backend. Unset (or any other value), the extension registers nothing and hooks
+    /// nothing, and the client runs its stock D3D9 device.
+    constexpr const char* kDeviceKey = "WXL_VK_DEVICE";
+
+    /// What WXL_VK_DEVICE says.
+    enum class DeviceMode
+    {
+        Off,          ///< unset or an off spelling: the extension stays inert
+        Native,       ///< `native`
+        Unrecognised, ///< any other value: inert, and said so once at load
+    };
+
+    /**
+     * What WXL_VK_DEVICE asked for. Resolved once.
+     *
+     * Only the word `native` turns the device on. The device is the one object in the client whose
+     * failure means no picture at all, so owning it takes a deliberate, unambiguous act; a value the
+     * extension does not know is reported rather than guessed at.
+     *
+     * @return DeviceMode mode
+     */
+    inline DeviceMode DeviceModeWanted()
+    {
+        static const DeviceMode mode = [] {
+            char value[32] = {};
+            if (!detail::Raw(kDeviceKey, value, sizeof value)) return DeviceMode::Off;
+            if (_stricmp(value, "native") == 0) return DeviceMode::Native;
+            if (detail::OffWord(value)) return DeviceMode::Off;
+            return DeviceMode::Unrecognised;
+        }();
+        return mode;
+    }
+
+    // --- WXL_VK_TRANSLATED -----------------------------------------------------------------------
+
+    /// Whether the pipelines may build a pair from the offline-translated SPIR-V under
+    /// shaders/translated/, and how it ranks against the hand-written rows in
+    /// src/vulkan/Pipelines.cpp:
+    ///
+    ///   0        never: hand-written rows only (the UI and the fixed function draw, the world does not)
+    ///   1        fill in: a key with no hand-written row is built from the translated modules (default)
+    ///   2        prefer: the translated modules win even where a hand-written row exists
+    constexpr const char* kTranslatedKey = "WXL_VK_TRANSLATED";
+
+    /// WXL_VK_TRANSLATED's three modes.
+    enum : unsigned
+    {
+        kTranslatedOff    = 0,
+        kTranslatedFill   = 1,
+        kTranslatedPrefer = 2,
+    };
+
+    /**
+     * What WXL_VK_TRANSLATED asked for. Resolved once.
+     *
+     * Unset is kTranslatedFill. The off spellings select 0; "2", "prefer", "force" and "all" select
+     * 2; "1", "fill" and every other truthy spelling select 1. An unrecognised word falls back to
+     * the default rather than to off, so a typo cannot silently remove the world.
+     *
+     * @return unsigned mode : one of kTranslated*
+     */
+    inline unsigned TranslatedMode()
+    {
+        static const unsigned mode = [] () -> unsigned {
+            char value[32] = {};
+            if (!detail::Raw(kTranslatedKey, value, sizeof value)) return kTranslatedFill;
+            if (detail::OffWord(value)) return kTranslatedOff;
+            if (_stricmp(value, "2") == 0 || _stricmp(value, "prefer") == 0
+                || _stricmp(value, "force") == 0 || _stricmp(value, "all") == 0)
+                return kTranslatedPrefer;
+            if (_stricmp(value, "1") == 0 || _stricmp(value, "fill") == 0)
+                return kTranslatedFill;
+            return wxl::cfg::Truthy(value, true) ? kTranslatedFill : kTranslatedOff;
+        }();
+        return mode;
+    }
+
+    // --- WXL_VK_VALIDATION -----------------------------------------------------------------------
+
+    /// Requests VK_LAYER_KHRONOS_validation and VK_EXT_debug_utils. Default off: the layer is a
+    /// developer tool, and its allocations are not small in a 32-bit process.
+    constexpr const char* kValidationKey = "WXL_VK_VALIDATION";
+
+    /// Whether validation was asked for. Requested is not enabled: the instance only receives the
+    /// layer when the loader reports it, and the log says which of the two happened.
+    inline bool ValidationWanted()
+    {
+        static const bool wanted = detail::Flag(kValidationKey);
+        return wanted;
+    }
+
+    // --- WXL_VK_STATS ----------------------------------------------------------------------------
+
+    /// Turns on the detailed counters: one block of INFO lines about once a minute (draws, frame,
+    /// pools, textures, targets, queries, CPU time, memory, constants) and a full block at device
+    /// destruction. Default off: the log then holds errors, warnings and one summary line at
+    /// shutdown.
+    constexpr const char* kStatsKey = "WXL_VK_STATS";
+
+    /// Whether the detailed counters are logged.
+    inline bool StatsWanted()
+    {
+        static const bool wanted = detail::Flag(kStatsKey);
+        return wanted;
+    }
+
+    // --- WXL_VK_BONES ----------------------------------------------------------------------------
+
+    /// The bone-palette path (src/vulkan/Pipelines.cpp): a 256-row draw takes its module's `bones`
+    /// variant and the palette ring. Default on; off keeps every 256-row draw on the 256-row
+    /// modules, for an A/B comparison of the two paths.
+    constexpr const char* kBonesKey = "WXL_VK_BONES";
+
+    /// Whether the bone-palette path is allowed. Unset is on.
+    inline bool BonesWanted()
+    {
+        static const bool wanted = [] () -> bool {
+            char value[32] = {};
+            if (!detail::Raw(kBonesKey, value, sizeof value)) return true;
+            return !detail::OffWord(value);
+        }();
+        return wanted;
+    }
+
+    // --- WXL_VK_GBUFFER --------------------------------------------------------------------------
+
+    /// The G-buffer (src/native/present/, docs/architecture.md "The G-buffer"): while a consumer asks
+    /// for it (wxl.vk.render RequestGBuffer), the opaque world's pass carries the albedo, normal and
+    /// light attachments and the modules' `gbuf` variants draw. Default allowed; off refuses every
+    /// request, for an A/B of the attachments' cost.
+    constexpr const char* kGBufferKey = "WXL_VK_GBUFFER";
+
+    /// Whether the G-buffer may be made. Unset is allowed.
+    inline bool GBufferAllowed()
+    {
+        static const bool allowed = [] () -> bool {
+            char value[32] = {};
+            if (!detail::Raw(kGBufferKey, value, sizeof value)) return true;
+            return !detail::OffWord(value);
+        }();
+        return allowed;
+    }
+
+    // --- WXL_VK_ANISOTROPY, WXL_VK_MIP_BIAS --------------------------------------------------------
+
+    /// The anisotropic filtering of the world's mipmapped textures (src/vulkan/pipelines/Samplers.cpp,
+    /// the world variant): the most samples along a pixel's footprint, clamped to the adapter's
+    /// limit, where it is more than the engine's own texture option asks for. 0 or 1 leaves the
+    /// engine's filter. Default 16. Never for the interface, the text or a render target.
+    constexpr const char* kAnisotropyKey = "WXL_VK_ANISOTROPY";
+
+    /// The mip LOD bias of the same samplers, -1 .. 1: below 0 a sharper level is taken (the texture
+    /// shimmers sooner), above 0 a softer one. Default -0.3.
+    constexpr const char* kMipBiasKey = "WXL_VK_MIP_BIAS";
+
+    /**
+     * What WXL_VK_ANISOTROPY asked for. Resolved once.
+     *
+     * Unset is 16; an off spelling, or a number below 2, is no anisotropy of the device's own (0);
+     * a number above 16 is 16; an unrecognised word falls back to the default.
+     *
+     * @return float samples : 0, or 2 .. 16 (the adapter's limit is applied by the caller)
+     */
+    inline float AnisotropyWanted()
+    {
+        static const float wanted = [] () -> float {
+            char value[32] = {};
+            if (!detail::Raw(kAnisotropyKey, value, sizeof value)) return 16.0f;
+            if (detail::OffWord(value)) return 0.0f;
+            char* end = nullptr;
+            const double n = std::strtod(value, &end);
+            if (end == value) return 16.0f;
+            if (n < 2.0) return 0.0f;
+            return static_cast<float>(n > 16.0 ? 16.0 : n);
+        }();
+        return wanted;
+    }
+
+    /**
+     * What WXL_VK_MIP_BIAS asked for. Resolved once.
+     *
+     * Unset is -0.3; an off spelling is 0; a number is clamped to -1 .. 1 (within the 2 every Vulkan
+     * device accepts); an unrecognised word falls back to the default.
+     *
+     * @return float bias
+     */
+    inline float MipBiasWanted()
+    {
+        static const float wanted = [] () -> float {
+            char value[32] = {};
+            if (!detail::Raw(kMipBiasKey, value, sizeof value)) return -0.3f;
+            if (detail::OffWord(value)) return 0.0f;
+            char* end = nullptr;
+            const double n = std::strtod(value, &end);
+            if (end == value) return -0.3f;
+            return static_cast<float>(n < -1.0 ? -1.0 : (n > 1.0 ? 1.0 : n));
+        }();
+        return wanted;
+    }
+
+    // --- WXL_VK_CAPS -----------------------------------------------------------------------------
+
+    /// The device's optional capabilities (src/vulkan/context/Caps.cpp): an instance and a device
+    /// of Vulkan 1.1 or 1.2 when the loader and the adapter offer it, and the optional features the adapter
+    /// reports enabled -- FP16 and INT8 arithmetic, 16-bit storage, the extended storage image formats,
+    /// multiview, multi-draw indirect, VK_EXT_memory_budget, VK_EXT_shader_viewport_index_layer -- for the
+    /// modules to use (wxl.vk.render GetDeviceCaps). Nothing the device itself draws changes with them.
+    /// Default on; off is the Vulkan 1.0 device with the features it had before, for an A/B or a driver
+    /// that misbehaves with the newer version.
+    constexpr const char* kCapsKey = "WXL_VK_CAPS";
+
+    // --- WXL_VK_RECORD_SPLIT ----------------------------------------------------------------------
+
+    /// The draw's recording split into its phases (src/vulkan/pipelines/Record.cpp): the key and the
+    /// pipeline, the textures / slice / descriptor set, the constants' copy, the binds, the shadow capture, the draw
+    /// call -- each phase timed with the CPU's time-stamp counter (a few ns) and logged with the stats block as a cost
+    /// per draw. Default off: the split adds six counter reads to every draw.
+    constexpr const char* kRecordSplitKey = "WXL_VK_RECORD_SPLIT";
+
+    /// Whether the record split is measured. Unset is off.
+    inline bool RecordSplitWanted()
+    {
+        static const bool wanted = detail::Flag(kRecordSplitKey);
+        return wanted;
+    }
+
+    /// Whether the optional capabilities are asked for. Unset is on.
+    inline bool CapsWanted()
+    {
+        static const bool wanted = [] () -> bool {
+            char value[32] = {};
+            if (!detail::Raw(kCapsKey, value, sizeof value)) return true;
+            return !detail::OffWord(value);
+        }();
+        return wanted;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Simd.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Simd.hpp
new file mode 100644
index 00000000..afc25e74
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/common/Simd.hpp
@@ -0,0 +1,131 @@
+// The draw path's 16-byte-row copies, clears and compares: SSE2, never the CRT.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include <emmintrin.h>
+
+#include <cstddef>
+#include <cstdint>
+
+// Everything the draw path copies is rows of sixteen bytes -- constant registers, a ring slice, a
+// bone palette, a pipeline key -- and most of it lands in write-combined memory (the uniform and
+// palette rings live in the BAR window). The CRT's memcpy / memset / memcmp are the wrong tools
+// there: on this hardware a `rep movsb` into write-combined memory is five times slower than a
+// loop of 16-byte stores (286 ns against 57 ns for one 64-row slice), a fast-string memset or
+// memcpy issued shortly before such a copy adds about 100 ns to it, and MSVC inlines memcmp as a
+// 4-byte loop. These helpers are the one implementation every file uses instead. Unaligned loads
+// and stores throughout: the sources are 4-byte-aligned engine memory and the destinations are
+// 16-byte-aligned ring offsets, and movups costs nothing extra on an aligned address.
+namespace wxlvk::simd
+{
+    /**
+     * Copies `rows` rows of sixteen bytes. Four rows per step: one 64-byte cache line, one
+     * write-combining buffer, filled whole and in order.
+     *
+     * @param void* dst : the destination (may overlap nothing of `src`)
+     * @param const void* src : the source
+     * @param size_t rows : rows of 16 bytes
+     */
+    inline void CopyRows(void* dst, const void* src, size_t rows)
+    {
+        __m128i*       d = static_cast<__m128i*>(dst);
+        const __m128i* s = static_cast<const __m128i*>(src);
+        for (; rows >= 4; rows -= 4, d += 4, s += 4)
+        {
+            const __m128i a = _mm_loadu_si128(s);
+            const __m128i b = _mm_loadu_si128(s + 1);
+            const __m128i c = _mm_loadu_si128(s + 2);
+            const __m128i e = _mm_loadu_si128(s + 3);
+            _mm_storeu_si128(d, a);
+            _mm_storeu_si128(d + 1, b);
+            _mm_storeu_si128(d + 2, c);
+            _mm_storeu_si128(d + 3, e);
+        }
+        for (; rows; --rows, ++d, ++s) _mm_storeu_si128(d, _mm_loadu_si128(s));
+    }
+
+    /**
+     * Zeroes `rows` rows of sixteen bytes.
+     *
+     * @param void* dst : the destination
+     * @param size_t rows : rows of 16 bytes
+     */
+    inline void ZeroRows(void* dst, size_t rows)
+    {
+        __m128i*      d = static_cast<__m128i*>(dst);
+        const __m128i z = _mm_setzero_si128();
+        for (; rows >= 4; rows -= 4, d += 4)
+        {
+            _mm_storeu_si128(d, z);
+            _mm_storeu_si128(d + 1, z);
+            _mm_storeu_si128(d + 2, z);
+            _mm_storeu_si128(d + 3, z);
+        }
+        for (; rows; --rows, ++d) _mm_storeu_si128(d, z);
+    }
+
+    /**
+     * Whether `rows` rows of sixteen bytes are byte for byte the same. Stops at the first row
+     * that differs.
+     *
+     * @param const void* a : one
+     * @param const void* b : the other
+     * @param size_t rows : rows of 16 bytes
+     * @return bool same
+     */
+    inline bool EqualRows(const void* a, const void* b, size_t rows)
+    {
+        const __m128i* x = static_cast<const __m128i*>(a);
+        const __m128i* y = static_cast<const __m128i*>(b);
+        for (; rows; --rows, ++x, ++y)
+        {
+            const __m128i eq = _mm_cmpeq_epi8(_mm_loadu_si128(x), _mm_loadu_si128(y));
+            if (_mm_movemask_epi8(eq) != 0xFFFF) return false;
+        }
+        return true;
+    }
+
+    /**
+     * The first row of `rows` that differs between `a` and `b`, or `rows` when none does: what a
+     * caller that then copies from the difference onward wants to know.
+     *
+     * @return size_t row : the first differing row, `rows` when all are equal
+     */
+    inline size_t FirstDifferentRow(const void* a, const void* b, size_t rows)
+    {
+        const __m128i* x = static_cast<const __m128i*>(a);
+        const __m128i* y = static_cast<const __m128i*>(b);
+        for (size_t i = 0; i < rows; ++i)
+        {
+            const __m128i eq = _mm_cmpeq_epi8(_mm_loadu_si128(x + i), _mm_loadu_si128(y + i));
+            if (_mm_movemask_epi8(eq) != 0xFFFF) return i;
+        }
+        return rows;
+    }
+
+    /**
+     * Whether `n` 64-bit words are equal: a word loop, for the keys that are not whole rows.
+     *
+     * @return bool same
+     */
+    inline bool EqualWords64(const uint64_t* a, const uint64_t* b, size_t n)
+    {
+        for (size_t i = 0; i < n; ++i)
+            if (a[i] != b[i]) return false;
+        return true;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/device/Slots.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/device/Slots.hpp
new file mode 100644
index 00000000..8ae403c3
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/device/Slots.hpp
@@ -0,0 +1,306 @@
+// The engine graphics device's 84 vtable slots: one row per slot, carrying its index, its name, the
+// byte count its stock implementation pops, and its signature.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include "wxl/offsets/engine/GxDevice.hpp"
+
+#include <windows.h>
+
+#include <cstdint>
+
+// The engine's 84-slot CGxDevice vtable, slot by slot.
+//
+// Every slot is MSVC __thiscall: `this` in ECX, the arguments pushed right to left, and the CALLEE
+// pops them (`ret N`, N = 4 * argument count). A free function reproduces that on x86 MSVC as
+// `__fastcall(this, edx_dummy, args...)`, which is the shape every native slot is written in.
+//
+// That `ret N` is why the table below is written out slot by slot instead of being approximated. A
+// thunk whose declared argument count disagrees with the callee's pop size moves ESP by the wrong
+// amount on every call, and the crash lands wherever the corrupted frame is eventually used -- never
+// at the slot that caused it. So each row states the pop size independently of the signature, and
+// the static_asserts further down refuse to compile when the two disagree.
+//
+// Provenance of each column:
+//   index, pop  read out of the binary for this project, not taken from the document: the four
+//               device vtables (base 0x00A2DDC0, D3D9 0x00A2E718, D3D9Ex 0x00A2F500, OpenGL
+//               0x00A2E198) were dumped from the Ghidra export's 09_program.bytes and each entry's
+//               body scanned for its `ret` instruction. All four tables are exactly 84 entries long
+//               -- the dword after slot 83 is string data in every one of them. 24 base entries are
+//               __purecall (0x0040BAA5): slots 1, 17, 20, 21, 22, 35, 36, 52, 59, 60, 64-67, 71, 72
+//               and 76-83.
+//   name, args  the CGxDevice/CGxDeviceD3d reference, sections 1.0 and 1.2, cross-checked against
+//               the Ghidra symbol name of each D3D9 entry. Where the reference marks a meaning
+//               inferred rather than read, the row says so.
+//
+// Slot 0 gets its own warning because the obvious guess is wrong and the damage is silent: it is
+// ITexMarkAsUpdated(CGxTex*), not a destructor. It is the engine's lazy texture-upload point,
+// reached on every bind of a texture with a pending update. The destructor is slot 8.
+namespace wxlvk::device
+{
+    namespace gxdev = wxl::offsets::engine::gxdevice;
+
+    // Engine types the slots take by pointer. Incomplete on purpose: their fields are read through
+    // the core's offsets (wxl/offsets/engine/GxDevice.hpp), and a layout guessed here would be a
+    // second, unverified copy of sections 3, 4 and 8 of the reference.
+    struct CGxTex;
+    struct CGxPool;
+    struct CGxBuf;
+    struct CGxShader;
+    struct CGxQuery;
+    struct CGxFormat;
+    struct CGxBatch;
+    struct CGxGammaRamp;  ///< 0x600 bytes, 3 x 256 WORD (the device's copy is at +0x354)
+    struct CImVector;     ///< 32-bit colour, bytes in memory B, G, R, A
+    struct C44Matrix;     ///< 16 floats, row-major, row vectors
+    struct CRect;         ///< 4 floats {minY, minX, maxY, maxX}
+    struct CiRect;        ///< 4 ints, same order
+    struct C2iVector;
+    struct C2Vector;
+    struct C3Vector;
+    /// TSGrowableArray<T>, sized and filled by the read-back slots: CImVector for slot 20, float for 21.
+    struct TSGrowableArray;
+
+    /// What slots 29-34 add to and remove from. Slots 5-7 call them with no arguments at all:
+    /// CGxDevice::NotifyOnDeviceRestored 0x006843B0 is `(**(code**)(this[0x63] + i * 4))()`.
+    using DeviceNotifyFn = void(__cdecl*)();
+
+    /// The `this` and the dead EDX every slot starts with.
+    #define WXL_VK_SELF void* device, void* edx
+
+    // --- the table ----------------------------------------------------------------------------------
+    // X(index, Name, popBytes, ReturnType, (WXL_VK_SELF, args...))
+    #define WXL_VK_DEVICE_SLOTS(X)                                                                      \
+        /* internal: lazy texture upload, and the render-state flush --------------------------------*/ \
+        X( 0, ITexMarkAsUpdated,               0x04, void,      (WXL_VK_SELF, CGxTex* tex))             \
+        X( 1, IRsSendToHw,                     0x04, void,      (WXL_VK_SELF, uint32_t state))          \
+        /* cursor, internal half --------------------------------------------------------------------*/ \
+        X( 2, ICursorCreate,                   0x04, void,      (WXL_VK_SELF, const CGxFormat* format)) \
+        X( 3, ICursorDestroy,                  0x00, void,      (WXL_VK_SELF))                          \
+        X( 4, ICursorDraw,                     0x00, void,      (WXL_VK_SELF))                          \
+        /* the three callback lists being fired (base only) -----------------------------------------*/ \
+        X( 5, NotifyOnDeviceRestored,          0x00, void,      (WXL_VK_SELF))                          \
+        X( 6, NotifyOnTextureRecreation,       0x00, void,      (WXL_VK_SELF))                          \
+        X( 7, NotifyOnStereoChanged,           0x00, void,      (WXL_VK_SELF))                          \
+        /* life cycle -------------------------------------------------------------------------------*/ \
+        X( 8, ScalarDeletingDtor,              0x04, void*,     (WXL_VK_SELF, uint8_t flags))           \
+        X( 9, DeviceCreateOnWindow,            0x08, int,       (WXL_VK_SELF, HWND window,              \
+                                                                 const CGxFormat* format))              \
+        X(10, DeviceCreate,                    0x08, int,       (WXL_VK_SELF, WNDPROC wndProc,          \
+                                                                 const CGxFormat* format))              \
+        X(11, DeviceDestroy,                   0x00, void,      (WXL_VK_SELF))                          \
+        X(12, DeviceEvictResources,            0x00, void,      (WXL_VK_SELF))                          \
+        X(13, DeviceSetFormat,                 0x04, int,       (WXL_VK_SELF, const CGxFormat* format)) \
+        X(14, DeviceSetBaseMipLevel,           0x04, void,      (WXL_VK_SELF, uint32_t level))          \
+        X(15, DeviceSetGammaRamp,              0x04, void,      (WXL_VK_SELF, const CGxGammaRamp* ramp))\
+        X(16, DeviceSetGammaLevel,             0x04, void,      (WXL_VK_SELF, float level))             \
+        X(17, DeviceWindow,                    0x00, HWND,      (WXL_VK_SELF))                          \
+        /* screenshots and read-back ----------------------------------------------------------------*/ \
+        X(18, DeviceTakeScreenShot,            0x00, void,      (WXL_VK_SELF))                          \
+        X(19, DeviceReadScreenShot,            0x0C, void,      (WXL_VK_SELF, uint32_t* width,          \
+                                                                 uint32_t* height, void** data))        \
+        X(20, DeviceReadPixels,                0x08, void,      (WXL_VK_SELF, CiRect* rect,             \
+                                                                 TSGrowableArray* out))                 \
+        X(21, DeviceReadDepths,                0x08, void,      (WXL_VK_SELF, CiRect* rect,             \
+                                                                 TSGrowableArray* out))                 \
+        /* window messages, render targets, depth-stencil -------------------------------------------*/ \
+        X(22, DeviceWM,                        0x0C, void,      (WXL_VK_SELF, uint32_t event,           \
+                                                                 uintptr_t p1, uintptr_t p2))           \
+        X(23, DeviceSetRenderTarget,           0x0C, void,      (WXL_VK_SELF, uint32_t buffer,          \
+                                                                 CGxTex* tex, uint32_t face))           \
+        X(24, CaptureDepthStencilSurface,      0x00, void,      (WXL_VK_SELF))                          \
+        X(25, BindDepthStencilSurface,         0x00, void,      (WXL_VK_SELF))                          \
+        X(26, DeviceResolveDepthBuffer,        0x04, void,      (WXL_VK_SELF, CGxTex* tex))             \
+        X(27, DeviceCopyTex,                   0x10, void,      (WXL_VK_SELF, CGxTex* src,              \
+                                                                 uint32_t srcFace, CGxTex* dst,         \
+                                                                 uint32_t dstFace))                     \
+        X(28, DeviceOverride,                  0x08, void,      (WXL_VK_SELF, int index,                \
+                                                                 uint32_t value))                       \
+        /* the three callback lists being edited (base only) -----------------------------------------*/\
+        X(29, AddDeviceRestoredCallback,       0x04, void,      (WXL_VK_SELF, DeviceNotifyFn callback)) \
+        X(30, RemoveDeviceRestoredCallback,    0x04, void,      (WXL_VK_SELF, DeviceNotifyFn callback)) \
+        X(31, AddTextureRecreationCallback,    0x04, void,      (WXL_VK_SELF, DeviceNotifyFn callback)) \
+        X(32, RemoveTextureRecreationCallback, 0x04, void,      (WXL_VK_SELF, DeviceNotifyFn callback)) \
+        X(33, AddStereoChangedCallback,        0x04, void,      (WXL_VK_SELF, DeviceNotifyFn callback)) \
+        X(34, RemoveStereoChangedCallback,     0x04, void,      (WXL_VK_SELF, DeviceNotifyFn callback)) \
+        /* the window size the engine lays the UI out against ---------------------------------------*/ \
+        X(35, CapsWindowSize,                  0x04, void,      (WXL_VK_SELF, CRect* out))              \
+        X(36, CapsWindowSizeInScreenCoords,    0x04, void,      (WXL_VK_SELF, CRect* out))              \
+        X(37, LogCrashInfo,                    0x08, void,      (WXL_VK_SELF, char* buffer,             \
+                                                                 uint32_t size))                        \
+        /* the frame --------------------------------------------------------------------------------*/ \
+        X(38, ScenePresent,                    0x00, void,      (WXL_VK_SELF))                          \
+        X(39, SceneClear,                      0x08, void,      (WXL_VK_SELF, uint32_t mask,            \
+                                                                 uint32_t color))                       \
+        X(40, XformSetProjection,              0x04, void,      (WXL_VK_SELF, const C44Matrix* matrix)) \
+        X(41, XformSetView,                    0x04, void,      (WXL_VK_SELF, const C44Matrix* matrix)) \
+        X(42, Draw,                            0x08, void,      (WXL_VK_SELF, CGxBatch* batch,          \
+                                                                 int indexed))                          \
+        /* immediate mode: base emulation on every stock backend bar OpenGL's 49 and 50 -------------*/ \
+        X(43, PrimBegin,                       0x04, void,      (WXL_VK_SELF, uint32_t prim))           \
+        X(44, PrimDrawElements,                0x00, void,      (WXL_VK_SELF))                          \
+        X(45, PrimVertex,                      0x04, void,      (WXL_VK_SELF, const C3Vector* position))\
+        X(46, PrimTexCoord,                    0x08, void,      (WXL_VK_SELF, uint32_t tmu,             \
+                                                                 const C2Vector* coord))                \
+        X(47, PrimNormal,                      0x04, void,      (WXL_VK_SELF, const C3Vector* normal))  \
+        X(48, PrimColor,                       0x04, void,      (WXL_VK_SELF, const CImVector* color))  \
+        /* 49 and 50 are inferred names: no-ops on D3D, glPointSize / glLineWidth on OpenGL --------*/  \
+        X(49, PrimPointSize,                   0x04, void,      (WXL_VK_SELF, float size))              \
+        X(50, PrimLineWidth,                   0x04, void,      (WXL_VK_SELF, float width))             \
+        X(51, MasterEnableSet,                 0x08, void,      (WXL_VK_SELF, uint32_t enable, int on)) \
+        /* pools and buffers ------------------------------------------------------------------------*/ \
+        X(52, PoolSizeSet,                     0x08, void,      (WXL_VK_SELF, CGxPool* pool,            \
+                                                                 uint32_t size))                        \
+        X(53, PoolDestroy,                     0x04, void,      (WXL_VK_SELF, CGxPool* pool))           \
+        X(54, BufLock,                         0x04, char*,     (WXL_VK_SELF, CGxBuf* buf))             \
+        X(55, BufUnlock,                       0x08, int,       (WXL_VK_SELF, CGxBuf* buf,              \
+                                                                 uint32_t bytesWritten))                \
+        X(56, BufData,                         0x10, void,      (WXL_VK_SELF, CGxBuf* buf,              \
+                                                                 const void* data, uint32_t size,       \
+                                                                 uint32_t offset))                      \
+        /* textures: 57 is base-only, and creates no API object (creation is lazy, slot 0) ----------*/ \
+        X(57, TexCreate,                       0x2C, int,       (WXL_VK_SELF, uint32_t target,          \
+                                                                 uint32_t width, uint32_t height,       \
+                                                                 uint32_t depth, uint32_t format,       \
+                                                                 uint32_t dataFormat, uint32_t flags,   \
+                                                                 void* userArg, gxdev::TexFillFn fill,  \
+                                                                 const char* name, CGxTex** out))       \
+        X(58, TexDestroy,                      0x04, void,      (WXL_VK_SELF, CGxTex* tex))             \
+        X(59, TexCopy,                         0x18, bool,      (WXL_VK_SELF, CGxTex* tex,              \
+                                                                 C2iVector* dstPos, C2iVector* srcPos,  \
+                                                                 C2iVector* size, uint32_t level,       \
+                                                                 uint32_t face))                        \
+        X(60, TexStretch,                      0x14, bool,      (WXL_VK_SELF, CGxTex* tex,              \
+                                                                 CiRect* dst, CiRect* src,              \
+                                                                 uint32_t level, uint32_t face))        \
+        /* 61 is an inferred name: a byte count, no-op on D3D9, stored at +0x3C44 on D3D9Ex --------*/  \
+        X(61, TexSetCacheSize,                 0x04, void,      (WXL_VK_SELF, uint32_t bytes))          \
+        /* queries ----------------------------------------------------------------------------------*/ \
+        X(62, QueryCreate,                     0x08, void,      (WXL_VK_SELF, CGxQuery** out,           \
+                                                                 uint32_t type))                        \
+        X(63, QueryDestroy,                    0x04, void,      (WXL_VK_SELF, CGxQuery** query))        \
+        X(64, QueryBegin,                      0x04, bool,      (WXL_VK_SELF, CGxQuery* query))         \
+        X(65, QueryEnd,                        0x04, uint32_t,  (WXL_VK_SELF, CGxQuery* query))         \
+        X(66, QueryGetParam,                   0x0C, int,       (WXL_VK_SELF, CGxQuery* query,          \
+                                                                 uint32_t param, uint32_t* out))        \
+        X(67, QueryGetData,                    0x08, bool,      (WXL_VK_SELF, CGxQuery* query,          \
+                                                                 void* out))                            \
+        /* shaders: 68 and 71 take a DIRECTORY and a NAME, not a blob and a length -----------------*/  \
+        X(68, ShaderCreate,                    0x14, void,      (WXL_VK_SELF, CGxShader** out,          \
+                                                                 uint32_t target,                       \
+                                                                 const char* directory,                 \
+                                                                 const char* name,                      \
+                                                                 uint32_t permutations))                \
+        X(69, ShaderDestroy,                   0x04, void,      (WXL_VK_SELF, CGxShader** shader))      \
+        X(70, ShaderConstantsSet,              0x10, void,      (WXL_VK_SELF, uint32_t target,          \
+                                                                 uint32_t reg, const float* values,     \
+                                                                 uint32_t vec4Count))                   \
+        X(71, IShaderReload,                   0x0C, int,       (WXL_VK_SELF, CGxShader* shader,        \
+                                                                 const char* directory,                 \
+                                                                 const char* name))                     \
+        X(72, IShaderCreate,                   0x04, void,      (WXL_VK_SELF, CGxShader* shader))       \
+        /* cursor, public half ----------------------------------------------------------------------*/ \
+        X(73, CursorSetVisible,                0x04, void,      (WXL_VK_SELF, int visible))             \
+        X(74, CursorLock,                      0x00, uint32_t*, (WXL_VK_SELF))                          \
+        X(75, CursorUnlock,                    0x08, void,      (WXL_VK_SELF, uint32_t hotspotX,        \
+                                                                 uint32_t hotspotY))                    \
+        /* stereo: the getters return in ST0 / AL --------------------------------------------------*/  \
+        X(76, StereoSetConvergence,            0x04, void,      (WXL_VK_SELF, float convergence))       \
+        X(77, StereoGetConvergence,            0x00, float,     (WXL_VK_SELF))                          \
+        X(78, StereoSetSeparation,             0x04, void,      (WXL_VK_SELF, float separation))        \
+        X(79, StereoGetSeparation,             0x00, float,     (WXL_VK_SELF))                          \
+        X(80, StereoEnabled,                   0x00, bool,      (WXL_VK_SELF))                          \
+        /* the three with no name and no caller: pure in the base, nullsubs in all three stock      */  \
+        /* backends (0x00653A10 `ret 8`, 0x005EEB70 `ret 0`, 0x00653A10 again). The pop size is the */  \
+        /* only thing known about them, so the arguments are typed as untouched dwords.            */  \
+        X(81, Unknown81,                       0x08, void,      (WXL_VK_SELF, uint32_t p1, uint32_t p2))\
+        X(82, Unknown82,                       0x00, void,      (WXL_VK_SELF))                          \
+        X(83, Unknown83,                       0x08, void,      (WXL_VK_SELF, uint32_t p1, uint32_t p2))
+
+    /// How many entries a stock table has. The core owns the number; this is where the two agree.
+    constexpr unsigned kSlotCount = gxdev::kVTableSlots;
+
+    /// Slot indices by name: `slots::kDraw`, `slots::kITexMarkAsUpdated`, ...
+    namespace slots
+    {
+        #define WXL_VK_SLOT_ENUM(index, name, pop, ret, args) k##name = index,
+        enum : unsigned
+        {
+            WXL_VK_DEVICE_SLOTS(WXL_VK_SLOT_ENUM)
+        };
+        #undef WXL_VK_SLOT_ENUM
+    }
+
+    /// One function-pointer type per slot: `ITexMarkAsUpdatedFn`, `DrawFn`, ...
+    #define WXL_VK_SLOT_TYPEDEF(index, name, pop, ret, args) using name##Fn = ret(__fastcall*) args;
+    WXL_VK_DEVICE_SLOTS(WXL_VK_SLOT_TYPEDEF)
+    #undef WXL_VK_SLOT_TYPEDEF
+
+    /**
+     * How many stack arguments a slot signature declares, i.e. everything after `this` and the dead
+     * EDX, and how many bytes the callee therefore has to pop.
+     *
+     * This exists so the pop size in each row of the table can be checked against the signature next
+     * to it at compile time rather than trusted. Every argument any of the 84 slots takes is one
+     * dword on x86 -- pointer, int, float, or a CImVector by value -- so `arguments * 4` is exactly
+     * the `ret N` the stock implementation uses, and a disagreement is a stack desync waiting for
+     * the first call.
+     */
+    template <typename Fn>
+    struct Arity;
+
+    template <typename Ret, typename... Args>
+    struct Arity<Ret(__fastcall*)(void*, void*, Args...)>
+    {
+        static constexpr unsigned kArgs = sizeof...(Args);
+        static constexpr unsigned kPopBytes = sizeof...(Args) * 4u;
+    };
+
+    /// Slot index -> its function type, pop size and name, for code that is generic over slots.
+    template <unsigned Slot>
+    struct SlotTraits;
+
+    #define WXL_VK_SLOT_TRAITS(index, name, pop, ret, args)                                            \
+        template <>                                                                                    \
+        struct SlotTraits<index>                                                                       \
+        {                                                                                              \
+            using Fn = name##Fn;                                                                       \
+            static constexpr unsigned kIndex = index;                                                  \
+            static constexpr unsigned kPopBytes = pop;                                                 \
+            static constexpr const char* kName = #name;                                                \
+        };                                                                                             \
+        static_assert(Arity<name##Fn>::kPopBytes == (pop),                                             \
+                      "slot " #index " " #name ": its declared arguments do not add up to its ret N");
+    WXL_VK_DEVICE_SLOTS(WXL_VK_SLOT_TRAITS)
+    #undef WXL_VK_SLOT_TRAITS
+
+    /// The slot names, indexed by slot, for a log line that has to name one.
+    #define WXL_VK_SLOT_NAME(index, name, pop, ret, args) #name,
+    constexpr const char* kSlotNames[] = { WXL_VK_DEVICE_SLOTS(WXL_VK_SLOT_NAME) };
+    #undef WXL_VK_SLOT_NAME
+
+    /// The byte count each slot's stock implementation pops, indexed by slot.
+    #define WXL_VK_SLOT_POP(index, name, pop, ret, args) pop,
+    constexpr unsigned kSlotPopBytes[] = { WXL_VK_DEVICE_SLOTS(WXL_VK_SLOT_POP) };
+    #undef WXL_VK_SLOT_POP
+
+    static_assert(sizeof kSlotNames / sizeof *kSlotNames == kSlotCount,
+                  "the slot table has a different number of rows than the engine's vtable has entries");
+    static_assert(sizeof kSlotPopBytes / sizeof *kSlotPopBytes == kSlotCount, "pop table length");
+
+    #undef WXL_VK_SELF
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/draw/Cmd.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/draw/Cmd.hpp
