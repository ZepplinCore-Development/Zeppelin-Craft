+#include "vulkan/DeviceCaps.hpp"
+#include "vulkan/Loader.hpp"
+#include "vulkan/Vk.hpp"
+
+// The native device brings these up synchronously in slot 13, on the client's own window
+// (+0x3968), and keeps the instance and the VkDevice for the life of the process: a format change or
+// a graphics restart only rebuilds the surface and the swapchain on the new window.
+namespace wxlvk::vk::context
+{
+    /// What one bring-up attempt concluded.
+    enum class Attempt
+    {
+        Done,     ///< everything that was asked for exists; stop calling Bring()
+        Retry,    ///< the window is not usable yet (not created, or zero-size); call again next frame
+        Declined, ///< a permanent reason -- no loader, no suitable device, a create failed
+    };
+
+    /**
+     * One bring-up attempt on the client window. Idempotent once it has returned Done or Declined;
+     * on a Declined everything it created has been torn down.
+     *
+     * Must run on the thread that owns the client's window, the render thread the device slots run
+     * on. Win32 surface creation is not documented to require it, but every other window operation
+     * in this client does.
+     *
+     * @return Attempt attempt
+     */
+    Attempt Bring();
+
+    /**
+     * Rebuilds the swapchain on the window the device holds now. Two cases, distinguished by
+     * re-reading the HWND:
+     *
+     *  - same window, new size: the surface is still valid, the swapchain's extent is not. The
+     *    swapchain alone is rebuilt.
+     *  - different window (a format change or a graphics restart made a new one): surface and
+     *    swapchain both go and are rebuilt against the new HWND. The instance and logical device
+     *    survive, which is the point of keeping them separate from the surface.
+     *
+     * Does nothing when the bring-up never completed.
+     */
+    void Rebind();
+
+    /**
+     * Destroys the swapchain and the surface, and leaves the instance and the device standing.
+     *
+     * Slots 11 and 13 call it right before the client window is destroyed: a VkSurfaceKHR must not
+     * outlive its window, and the device is kept so a following slot 13 builds a surface on the new
+     * window without a second vkCreateDevice. Safe when nothing stands.
+     */
+    void ReleaseWindow();
+
+    /**
+     * The vsync of the engine's CGxFormat (slot 13). Read by every swapchain built afterwards: on,
+     * FIFO; off, IMMEDIATE when the surface offers it, else MAILBOX, else FIFO.
+     *
+     * @param bool on : the format's vsync field is non-zero
+     */
+    void SetVsync(bool on);
+
+    /**
+     * Destroys everything, in exact reverse order of creation: swapchain, logical device (after
+     * vkDeviceWaitIdle), surface, debug messenger, instance. The unwinder of a half-finished Bring().
+     *
+     * vulkan-1.dll is deliberately NOT unloaded: see the comment at the call site.
+     */
+    void Teardown();
+
+    /**
+     * With the validation layer on and anything reported: one line with the error and warning
+     * totals, then one per message id whose occurrences past the first five were counted rather
+     * than logged, with its total. Nothing when the layer reported nothing.
+     */
+    void LogValidationSummary();
+
+    /**
+     * Whether the instance and logical device exist.
+     *
+     * @return bool live
+     */
+    bool Live();
+
+    /**
+     * Everything a renderer needs from the bring-up, in one read-only view.
+     *
+     * A struct handed out by pointer rather than eleven accessors, because every caller needs the
+     * whole set at once and a per-field accessor would let a caller read half its state from one
+     * swapchain generation and half from the next.
+     *
+     * Lifetime: the instance- and device-level fields are valid for as long as Live(). The
+     * swapchain-derived fields -- swapchain, format, extent, imageCount -- are valid only while
+     * SwapchainGeneration() is unchanged, and `swapchain` is VK_NULL_HANDLE whenever there is no
+     * swapchain right now, which is a normal state during a resize and not an error.
+     */
+    struct Handles
+    {
+        VkInstance       instance;
+        VkPhysicalDevice physical;
+        VkDevice         device;
+        VkQueue          graphicsQueue;
+        VkQueue          presentQueue;
+        uint32_t         graphicsFamily;
+        uint32_t         presentFamily;
+        VkSwapchainKHR   swapchain;
+        VkFormat         format;
+        VkExtent2D       extent;
+        uint32_t         imageCount;
+        VkImageUsageFlags swapchainUsage;  ///< what the images were created for; gates a blit
+        bool             textureCompressionBC; ///< BC1/2/3 images are legal on this device
+        bool             largePoints;          ///< gl_PointSize above 1.0 is honoured; off, point sprites are one pixel
+        bool             samplerAnisotropy;    ///< anisotropic samplers are legal on this device
+        bool             occlusionQueryPrecise; ///< VK_QUERY_CONTROL_PRECISE_BIT is legal: exact sample counts
+        bool             independentBlend;      ///< per-attachment blend state is legal (the G-buffer pass class needs it)
+        const loader::Instance* iapi;
+        const loader::Device*   dapi;
+    };
+
+    /**
+     * The handle view.
+     *
+     * @return pointer handles : null unless the instance and device exist; check `swapchain`
+     *                           separately, since it comes and goes with every resize
+     */
+    const Handles* Get();
+
+    /**
+     * Bumped on every swapchain create and every swapchain destroy.
+     *
+     * A counter rather than a callback: it cannot be registered twice and cannot fire from inside a
+     * teardown that is halfway done. Anything that cached an image view, a framebuffer or an image
+     * count compares this against the value it built for and rebuilds when they differ.
+     *
+     * @return uint32 generation : starts at 0, before any swapchain has existed
+     */
+    uint32_t SwapchainGeneration();
+
+    /**
+     * The optional capabilities the device was created with (src/vulkan/context/Caps.cpp, WXL_VK_CAPS): its version,
+     * the optional features asked for and enabled, the subgroup and multiview limits, the queue families a module may
+     * want to know about. Zeroed (a 1.0 device, nothing optional) before the device exists and with WXL_VK_CAPS off.
+     */
+    const DeviceCaps& Caps();
+
+    /**
+     * The adapter's memory heaps, and the driver's budget and usage per heap when VK_EXT_memory_budget is enabled.
+     * Not free (a driver query): the caller caches it (src/native/render/Budget.cpp, once every few dozen presents).
+     *
+     * @param props  the heaps and types
+     * @param budget VK_MAX_MEMORY_HEAPS entries: the driver's budget per heap, 0 where unknown
+     * @param usage  VK_MAX_MEMORY_HEAPS entries: this process's usage per heap as the driver counts it, 0 where unknown
+     * @return bool driver : true when budget and usage are the driver's; false when only `props` was filled
+     */
+    bool MemoryHeaps(VkPhysicalDeviceMemoryProperties& props, VkDeviceSize* budget, VkDeviceSize* usage);
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/DeviceCaps.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/DeviceCaps.hpp
new file mode 100644
index 00000000..44ac8078
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/DeviceCaps.hpp
@@ -0,0 +1,76 @@
+// The device's optional capabilities: what the adapter offered, what was enabled, what the modules may use.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include "vulkan/Vk.hpp"
+
+#include <cstdint>
+
+// The device was a Vulkan 1.0 one with six core features (src/vulkan/context/Logical.cpp). With
+// WXL_VK_CAPS (default on) the instance asks for the loader's version up to 1.2, the device is created at
+// min(that, the adapter's), and the optional features below are enabled whenever the adapter reports them --
+// each probed through vkGetPhysicalDeviceFeatures2 / Properties2 (core from 1.1), never assumed. None of them
+// changes what the device itself draws: the translated modules and the hand-written shaders are SPIR-V 1.0
+// that uses none. They are there for the modules (wxl.vk.render GetDeviceCaps, include/wxl/VkRenderApi.h
+// WXL_VkDeviceCaps), which build a variant only where the flag says so.
+namespace wxlvk::vk
+{
+    /// What one flag of DeviceCaps::enabled means; WXL_VK_CAP_* in VkRenderApi.h carries the same bits.
+    enum CapBit : uint32_t
+    {
+        kCapFloat16          = 1u << 0,   ///< shaderFloat16: float16_t arithmetic
+        kCapInt8             = 1u << 1,   ///< shaderInt8
+        kCapStorage16        = 1u << 2,   ///< storageBuffer16BitAccess: 16-bit members in storage buffers
+        kCapUniform16        = 1u << 3,   ///< uniformAndStorageBuffer16BitAccess
+        kCapPush16           = 1u << 4,   ///< storagePushConstant16
+        kCapInputOutput16    = 1u << 5,   ///< storageInputOutput16 (16-bit varyings; NVIDIA has none)
+        kCapInt16            = 1u << 6,   ///< shaderInt16
+        kCapStorageImageExt  = 1u << 7,   ///< shaderStorageImageExtendedFormats: R16F, RG16F, R11G11B10F ... storage images
+        kCapMultiview        = 1u << 8,   ///< multiview: one draw into several layers, gl_ViewIndex
+        kCapLayerFromVertex  = 1u << 9,   ///< VK_EXT_shader_viewport_index_layer: gl_Layer from a vertex shader
+        kCapMemoryBudget     = 1u << 10,  ///< VK_EXT_memory_budget: the driver's per-heap budget and usage
+        kCapMultiDrawIndirect = 1u << 11, ///< multiDrawIndirect: drawCount > 1 in one vkCmdDraw*Indirect
+        kCapIndirectFirstInstance = 1u << 12,  ///< drawIndirectFirstInstance
+        kCapSpirv13          = 1u << 13,  ///< a 1.1 device: SPIR-V 1.3, the subgroup operations (subgroupOps)
+        kCapSpirv15          = 1u << 14,  ///< a 1.2 device: SPIR-V 1.5
+        kCapMultiViewport    = 1u << 15,  ///< multiViewport: gl_ViewportIndex (with kCapLayerFromVertex, from a vertex shader)
+    };
+
+    /// What the probe found and the device was created with. Zeroed (a 1.0 device, nothing optional) until
+    /// the device exists, and for good with WXL_VK_CAPS off.
+    struct DeviceCaps
+    {
+        uint32_t loaderVersion   = VK_API_VERSION_1_0;   ///< vkEnumerateInstanceVersion (1.0 when the loader has none)
+        uint32_t instanceVersion = VK_API_VERSION_1_0;   ///< what the instance was created with
+        uint32_t adapterVersion  = VK_API_VERSION_1_0;   ///< the chosen adapter's VkPhysicalDeviceProperties::apiVersion
+        uint32_t deviceVersion   = VK_API_VERSION_1_0;   ///< min(instanceVersion, adapterVersion): what the device may be used as
+        uint32_t offered = 0;    ///< CapBit: what the adapter reports
+        uint32_t enabled = 0;    ///< CapBit: what the device was created with (a subset of offered)
+        uint32_t subgroupSize   = 0;   ///< VkPhysicalDeviceSubgroupProperties (a 1.1 device), 0 unknown
+        uint32_t subgroupStages = 0;   ///< VkShaderStageFlags
+        uint32_t subgroupOps    = 0;   ///< VkSubgroupFeatureFlags
+        uint32_t maxMultiviewViews = 0;
+        uint32_t computeFamily  = UINT32_MAX;   ///< a queue family with compute and no graphics (async compute)
+        uint32_t computeQueues  = 0;
+        uint32_t transferFamily = UINT32_MAX;   ///< a queue family with transfer alone (a copy engine)
+        uint32_t transferQueues = 0;
+        uint32_t graphicsQueues = 0;            ///< queues of the graphics family (the device takes one)
+        char     driverName[64] = {};           ///< VkPhysicalDeviceDriverProperties (1.2), "" unknown
+        char     driverInfo[64] = {};
+        bool     probed = false;                ///< the probe ran (WXL_VK_CAPS on and the device came up)
+    };
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Footprint.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Footprint.hpp
new file mode 100644
index 00000000..8f7adb6d
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Footprint.hpp
@@ -0,0 +1,120 @@
+// What the bring-up costs in a 32-bit process's address space, measured rather than estimated.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include <windows.h>
+
+#include <cstdint>
+
+// Why this file exists at all, and why it measures what it measures.
+//
+// Wow.exe 12340 is a 32-bit process. The number that kills it is not how much memory it uses but how
+// much contiguous address space is left when the next large allocation arrives, and a Vulkan ICD is
+// a large, eager consumer of exactly that -- an unused Vulkan driver was measured costing about
+// 230 MB.
+//
+// How much there IS to spend was measured rather than assumed, because the figure usually quoted for
+// this client is wrong: `dumpbin /headers Wow.exe` reports PE characteristics 0x123, and 0x0020 of
+// that is IMAGE_FILE_LARGE_ADDRESS_AWARE. So on a 64-bit host this process gets up to 4 GB of user
+// address space, not the 2 GB a 32-bit binary is normally assumed to have. That makes the ICD's cost
+// less alarming than it looks -- and it is exactly why Take() reads its upper bound from
+// GetSystemInfo instead of stopping at 0x7FFFFFFF, since a walk that stopped there would silently
+// under-report every figure below on the machine this actually runs on.
+//
+// The bring-up reports three figures and not one:
+//
+//  - committed bytes: pages the process has actually asked the OS to back. This is the closest thing
+//    to "how much did it cost", and it is the figure to compare against the ~230 MB note.
+//  - reserved bytes: address space taken, committed or not. An ICD that reserves a large arena and
+//    commits a fraction of it costs the full reservation here, and that reservation is what a later
+//    VirtualAlloc collides with. On a 32-bit process this matters MORE than the committed figure.
+//  - largest free block: the single number that predicts the next large-allocation failure. A
+//    process can have 600 MB free and still fail a 64 MB request.
+//
+// All three come from a VirtualQuery walk, which is deliberate: GetProcessMemoryInfo would need
+// psapi on the link line and reports neither the reservation nor the fragmentation. VirtualQuery
+// needs nothing, cannot fail in a way that matters, and is the same source Task Manager's committed
+// figure is derived from.
+//
+// Cost of a walk: one VirtualQuery per region. A client in-world has on the order of a few thousand
+// regions, so a walk is well under a millisecond and happens four times at bring-up and never again.
+namespace wxlvk::vk::footprint
+{
+    /// One walk's result. All sizes in bytes.
+    struct Snapshot
+    {
+        uint64_t reserved    = 0; ///< MEM_RESERVE + MEM_COMMIT region bytes
+        uint64_t committed   = 0; ///< MEM_COMMIT region bytes
+        uint64_t largestFree = 0; ///< biggest single MEM_FREE run
+        uint32_t regions     = 0; ///< regions the walk saw, as a sanity check on the walk itself
+    };
+
+    /**
+     * Walks the process's own user-mode address space.
+     *
+     * The upper bound comes from GetSystemInfo rather than from a hard-coded 0x7FFFFFFF: this client
+     * is /LARGEADDRESSAWARE (see the file comment), so lpMaximumApplicationAddress is the only source
+     * that is right on both a 64-bit host and a 32-bit one. Whatever the bound is, the walk reports
+     * it in `reserved` consistently, so a delta between two snapshots is correct either way.
+     *
+     * @return Snapshot snapshot
+     */
+    inline Snapshot Take()
+    {
+        SYSTEM_INFO info = {};
+        ::GetSystemInfo(&info);
+
+        Snapshot snapshot;
+        auto address = reinterpret_cast<uintptr_t>(info.lpMinimumApplicationAddress);
+        const auto limit = reinterpret_cast<uintptr_t>(info.lpMaximumApplicationAddress);
+
+        while (address < limit)
+        {
+            MEMORY_BASIC_INFORMATION region = {};
+            if (::VirtualQuery(reinterpret_cast<LPCVOID>(address), &region, sizeof region) != sizeof region)
+                break;
+
+            // RegionSize of 0 would make this loop forever; it should not happen, but a diagnostic
+            // helper must not be able to hang the render thread.
+            if (region.RegionSize == 0) break;
+
+            ++snapshot.regions;
+            if (region.State == MEM_FREE)
+            {
+                if (region.RegionSize > snapshot.largestFree) snapshot.largestFree = region.RegionSize;
+            }
+            else
+            {
+                snapshot.reserved += region.RegionSize;
+                if (region.State == MEM_COMMIT) snapshot.committed += region.RegionSize;
+            }
+
+            address += region.RegionSize;
+        }
+        return snapshot;
+    }
+
+    /// Bytes as whole MiB, for a log line that does not need the digits.
+    inline unsigned Mib(uint64_t bytes) { return static_cast<unsigned>(bytes / (1024u * 1024u)); }
+
+    /// A signed MiB delta, so a teardown that gives space back reads as a negative number.
+    inline int MibDelta(uint64_t after, uint64_t before)
+    {
+        const int64_t delta = static_cast<int64_t>(after) - static_cast<int64_t>(before);
+        return static_cast<int>(delta / (1024 * 1024));
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Loader.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Loader.cpp
new file mode 100644
index 00000000..72d70bc7
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Loader.cpp
@@ -0,0 +1,383 @@
+// vulkan-1.dll and the three dispatch levels, all resolved at runtime.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "vulkan/Loader.hpp"
+
+#include "wxl/Script.hpp"
+
+namespace
+{
+    /// The system loader's file name. Bare, so the file-system redirector picks SysWOW64 for us.
+    constexpr const char* kLoaderDll = "vulkan-1.dll";
+
+    HMODULE                     g_module = nullptr;
+    wxlvk::vk::loader::Global   g_global;
+    uint32_t                    g_instanceVersion = 0;
+
+    /**
+     * One global-level entry point, by name.
+     *
+     * vkGetInstanceProcAddr with a null instance is the only legal way to ask for these four, and
+     * the spec is explicit that asking for anything else that way returns null -- which is why this
+     * helper is not reused for the instance level.
+     *
+     * @param string name : the function name
+     * @return pointer fn : null when this loader does not have it
+     */
+    PFN_vkVoidFunction GlobalProc(const char* name)
+    {
+        return g_global.GetInstanceProcAddr ? g_global.GetInstanceProcAddr(nullptr, name) : nullptr;
+    }
+}
+
+namespace wxlvk::vk::loader
+{
+    bool Load()
+    {
+        if (g_module) return g_global.CreateInstance != nullptr;
+
+        g_module = ::LoadLibraryA(kLoaderDll);
+        if (!g_module)
+        {
+            // Declining, not failing. A machine with no Vulkan driver has no vulkan-1.dll at all,
+            // and that is the single most likely reason to be here -- so the line names the file and
+            // the error and says what the consequence is, rather than reading as a defect.
+            wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                "vulkan: %s not present (LoadLibrary error %lu); the Vulkan "
+                                "device cannot be created",
+                                kLoaderDll, ::GetLastError());
+            return false;
+        }
+
+        // The one symbol taken with GetProcAddress. Everything else comes through it, because the
+        // loader exports only a 1.0-era subset by name and resolving e.g. vkCreateInstance with
+        // GetProcAddress would silently bypass the layer chain.
+        g_global.GetInstanceProcAddr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(
+            ::GetProcAddress(g_module, "vkGetInstanceProcAddr"));
+        if (!g_global.GetInstanceProcAddr)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                "vulkan: %s has no vkGetInstanceProcAddr; it is not a Vulkan loader. "
+                                "Declining.", kLoaderDll);
+            ::FreeLibrary(g_module);
+            g_module = nullptr;
+            return false;
+        }
+
+        g_global.CreateInstance = reinterpret_cast<PFN_vkCreateInstance>(
+            GlobalProc("vkCreateInstance"));
+        g_global.EnumerateInstanceLayerProperties =
+            reinterpret_cast<PFN_vkEnumerateInstanceLayerProperties>(
+                GlobalProc("vkEnumerateInstanceLayerProperties"));
+        g_global.EnumerateInstanceExtensionProperties =
+            reinterpret_cast<PFN_vkEnumerateInstanceExtensionProperties>(
+                GlobalProc("vkEnumerateInstanceExtensionProperties"));
+
+        // 1.1 and later. Null here means a 1.0 loader, which the spec says to read as
+        // VK_API_VERSION_1_0 -- not as an error, and not as a reason to decline.
+        g_global.EnumerateInstanceVersion = reinterpret_cast<PFN_vkEnumerateInstanceVersion>(
+            GlobalProc("vkEnumerateInstanceVersion"));
+
+        bool ok = true;
+        if (!g_global.CreateInstance)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: global entry point missing: %s",
+                                "vkCreateInstance");
+            ok = false;
+        }
+        if (!g_global.EnumerateInstanceExtensionProperties)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: global entry point missing: %s",
+                                "vkEnumerateInstanceExtensionProperties");
+            ok = false;
+        }
+        // The layer enumeration is deliberately NOT required: without it, validation simply cannot
+        // be offered, and that is a developer feature.
+        if (!g_global.EnumerateInstanceLayerProperties)
+            wxl::ScriptMgr::Log(WXL_LOG_DEBUG,
+                                "vulkan: this loader has no vkEnumerateInstanceLayerProperties; "
+                                "validation layers cannot be requested");
+
+        if (!ok)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                "vulkan: %s is too old; declining", kLoaderDll);
+            ::FreeLibrary(g_module);
+            g_module = nullptr;
+            g_global = Global();
+            return false;
+        }
+
+        g_instanceVersion = VK_API_VERSION_1_0;
+        if (g_global.EnumerateInstanceVersion)
+        {
+            uint32_t version = 0;
+            // The only documented failure is VK_ERROR_OUT_OF_HOST_MEMORY; on anything other than
+            // success the 1.0 assumption above stands, which is the conservative direction.
+            if (g_global.EnumerateInstanceVersion(&version) == VK_SUCCESS) g_instanceVersion = version;
+        }
+
+        char text[32];
+        wxl::ScriptMgr::Log(WXL_LOG_DEBUG,
+                            "vulkan: loaded %s at 0x%08X, instance API %s%s",
+                            kLoaderDll, static_cast<unsigned>(reinterpret_cast<uintptr_t>(g_module)),
+                            ApiVersionText(g_instanceVersion, text, sizeof text),
+                            g_global.EnumerateInstanceVersion ? "" : " (assumed: no "
+                                                                     "vkEnumerateInstanceVersion)");
+        return true;
+    }
+
+    const Global& Api() { return g_global; }
+
+    uint32_t InstanceVersion() { return g_instanceVersion; }
+
+    bool StillMapped()
+    {
+        if (!g_module || !g_global.GetInstanceProcAddr) return false;
+
+        // GetModuleHandleA does not take a reference, which is what makes it the right call here:
+        // this runs on the exit path and must not change anybody's refcount.
+        const HMODULE live = ::GetModuleHandleA(kLoaderDll);
+        if (live != g_module) return false;
+
+        // And the handle alone is not enough: a module handle is its base address, so a stale handle
+        // could compare equal to a different mapping at the same base. Confirm the entry point we
+        // actually hold still lies inside the image the headers describe.
+        const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(g_module);
+        if (dos->e_magic != IMAGE_DOS_SIGNATURE) return false;
+        const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS32*>(
+            reinterpret_cast<const char*>(g_module) + dos->e_lfanew);
+        if (nt->Signature != IMAGE_NT_SIGNATURE) return false;
+
+        const uintptr_t base = reinterpret_cast<uintptr_t>(g_module);
+        const uintptr_t end  = base + nt->OptionalHeader.SizeOfImage;
+        const uintptr_t proc = reinterpret_cast<uintptr_t>(
+            reinterpret_cast<void*>(g_global.GetInstanceProcAddr));
+        return proc >= base && proc < end;
+    }
+
+    bool LoadInstance(VkInstance instance, bool debugUtils, Instance& out)
+    {
+        if (!instance || !g_global.GetInstanceProcAddr) return false;
+
+        unsigned missing = 0;
+
+        // A macro rather than twenty near-identical lines, and it does the one thing a hand-written
+        // line gets wrong: it derives the string from the field name, so the name in the log and the
+        // name passed to the loader cannot drift apart.
+#define WXL_VK_INSTANCE_PROC(field)                                                               \
+        do {                                                                                      \
+            out.field = reinterpret_cast<PFN_vk##field>(                                          \
+                g_global.GetInstanceProcAddr(instance, "vk" #field));                             \
+            if (!out.field)                                                                       \
+            {                                                                                     \
+                wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: instance entry point missing: vk%s",   \
+                                    #field);                                                      \
+                ++missing;                                                                        \
+            }                                                                                     \
+        } while (false)
+
+        WXL_VK_INSTANCE_PROC(DestroyInstance);
+        WXL_VK_INSTANCE_PROC(EnumeratePhysicalDevices);
+        WXL_VK_INSTANCE_PROC(GetPhysicalDeviceProperties);
+        WXL_VK_INSTANCE_PROC(GetPhysicalDeviceFeatures);
+        WXL_VK_INSTANCE_PROC(GetPhysicalDeviceMemoryProperties);
+        WXL_VK_INSTANCE_PROC(GetPhysicalDeviceQueueFamilyProperties);
+        WXL_VK_INSTANCE_PROC(EnumerateDeviceExtensionProperties);
+        WXL_VK_INSTANCE_PROC(CreateDevice);
+        WXL_VK_INSTANCE_PROC(GetDeviceProcAddr);
+
+        // VK_KHR_surface / VK_KHR_win32_surface. These are only non-null because the instance was
+        // created with those extensions enabled -- which is the whole reason the extension list is
+        // checked against vkEnumerateInstanceExtensionProperties before vkCreateInstance rather than
+        // being discovered by a null pointer here.
+        WXL_VK_INSTANCE_PROC(CreateWin32SurfaceKHR);
+        WXL_VK_INSTANCE_PROC(DestroySurfaceKHR);
+        WXL_VK_INSTANCE_PROC(GetPhysicalDeviceFormatProperties);
+        WXL_VK_INSTANCE_PROC(GetPhysicalDeviceSurfaceSupportKHR);
+        WXL_VK_INSTANCE_PROC(GetPhysicalDeviceSurfaceCapabilitiesKHR);
+        WXL_VK_INSTANCE_PROC(GetPhysicalDeviceSurfaceFormatsKHR);
+        WXL_VK_INSTANCE_PROC(GetPhysicalDeviceSurfacePresentModesKHR);
+
+        if (debugUtils)
+        {
+            WXL_VK_INSTANCE_PROC(CreateDebugUtilsMessengerEXT);
+            WXL_VK_INSTANCE_PROC(DestroyDebugUtilsMessengerEXT);
+        }
+
+#undef WXL_VK_INSTANCE_PROC
+
+        if (missing)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                "vulkan: %u instance entry point(s) missing; declining", missing);
+            return false;
+        }
+        return true;
+    }
+
+    bool LoadDevice(const Instance& api, VkDevice device, Device& out)
+    {
+        if (!device || !api.GetDeviceProcAddr) return false;
+
+        unsigned missing = 0;
+
+        // vkGetDeviceProcAddr, not vkGetInstanceProcAddr. Both would return something callable, but
+        // the instance-level pointer goes through the loader's dispatch trampoline on every call,
+        // and the device-level one is the driver's own entry for this device -- the faster one for
+        // everything the frame calls thousands of times.
+#define WXL_VK_DEVICE_PROC(field)                                                                 \
+        do {                                                                                      \
+            out.field = reinterpret_cast<PFN_vk##field>(                                          \
+                api.GetDeviceProcAddr(device, "vk" #field));                                      \
+            if (!out.field)                                                                       \
+            {                                                                                     \
+                wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: device entry point missing: vk%s",     \
+                                    #field);                                                      \
+                ++missing;                                                                        \
+            }                                                                                     \
+        } while (false)
+
+        WXL_VK_DEVICE_PROC(DestroyDevice);
+        WXL_VK_DEVICE_PROC(GetDeviceQueue);
+        WXL_VK_DEVICE_PROC(DeviceWaitIdle);
+        WXL_VK_DEVICE_PROC(CreateSwapchainKHR);
+        WXL_VK_DEVICE_PROC(DestroySwapchainKHR);
+        WXL_VK_DEVICE_PROC(GetSwapchainImagesKHR);
+
+        // Everything below is what the frame and the modules call. It is resolved here, with the
+        // rest, rather than lazily on the first frame: a missing entry point has to be a decline at
+        // bring-up time with a name in the log, not a null call inside the frame.
+        WXL_VK_DEVICE_PROC(CreateImageView);
+        WXL_VK_DEVICE_PROC(DestroyImageView);
+        WXL_VK_DEVICE_PROC(CreateRenderPass);
+        WXL_VK_DEVICE_PROC(DestroyRenderPass);
+        WXL_VK_DEVICE_PROC(CreateFramebuffer);
+        WXL_VK_DEVICE_PROC(DestroyFramebuffer);
+
+        WXL_VK_DEVICE_PROC(CreateCommandPool);
+        WXL_VK_DEVICE_PROC(DestroyCommandPool);
+        WXL_VK_DEVICE_PROC(AllocateCommandBuffers);
+        WXL_VK_DEVICE_PROC(BeginCommandBuffer);
+        WXL_VK_DEVICE_PROC(EndCommandBuffer);
+        WXL_VK_DEVICE_PROC(CmdBeginRenderPass);
+        WXL_VK_DEVICE_PROC(CmdEndRenderPass);
+
+        // CreateSemaphore is the one field whose name collides with a windows.h macro;
+        // src/vulkan/Loader.hpp undefines it, which is why the line below reads normally and the
+        // string the macro builds is "vkCreateSemaphore" and not "vkCreateSemaphoreW".
+        WXL_VK_DEVICE_PROC(CreateSemaphore);
+        WXL_VK_DEVICE_PROC(DestroySemaphore);
+        WXL_VK_DEVICE_PROC(CreateFence);
+        WXL_VK_DEVICE_PROC(DestroyFence);
+        WXL_VK_DEVICE_PROC(WaitForFences);
+        WXL_VK_DEVICE_PROC(ResetFences);
+        WXL_VK_DEVICE_PROC(GetFenceStatus);
+
+        // The resource path: src/vulkan/Memory.cpp and src/vulkan/Texture.cpp. Resolved
+        // here with everything else for the same reason the frame's entry points are -- a name in
+        // the bring-up log beats a null pointer inside an upload.
+        WXL_VK_DEVICE_PROC(AllocateMemory);
+        WXL_VK_DEVICE_PROC(FreeMemory);
+        WXL_VK_DEVICE_PROC(MapMemory);
+        WXL_VK_DEVICE_PROC(UnmapMemory);
+        WXL_VK_DEVICE_PROC(FlushMappedMemoryRanges);
+
+        WXL_VK_DEVICE_PROC(CreateBuffer);
+        WXL_VK_DEVICE_PROC(DestroyBuffer);
+        WXL_VK_DEVICE_PROC(GetBufferMemoryRequirements);
+        WXL_VK_DEVICE_PROC(BindBufferMemory);
+
+        WXL_VK_DEVICE_PROC(CreateImage);
+        WXL_VK_DEVICE_PROC(DestroyImage);
+        WXL_VK_DEVICE_PROC(GetImageMemoryRequirements);
+        WXL_VK_DEVICE_PROC(BindImageMemory);
+
+        WXL_VK_DEVICE_PROC(CmdPipelineBarrier);
+        WXL_VK_DEVICE_PROC(CmdCopyBuffer);
+        WXL_VK_DEVICE_PROC(CmdCopyBufferToImage);
+        WXL_VK_DEVICE_PROC(CmdClearColorImage);
+        WXL_VK_DEVICE_PROC(CmdBlitImage);
+        WXL_VK_DEVICE_PROC(CmdClearAttachments);
+
+
+        // The draw path: src/vulkan/Shaders.cpp and src/vulkan/Pipelines.cpp. Required like the
+        // rest, because every one of them is 1.0 core and a device cannot legally lack them.
+        WXL_VK_DEVICE_PROC(CreateShaderModule);
+        WXL_VK_DEVICE_PROC(DestroyShaderModule);
+
+        WXL_VK_DEVICE_PROC(CreateDescriptorSetLayout);
+        WXL_VK_DEVICE_PROC(DestroyDescriptorSetLayout);
+        WXL_VK_DEVICE_PROC(CreatePipelineLayout);
+        WXL_VK_DEVICE_PROC(DestroyPipelineLayout);
+        WXL_VK_DEVICE_PROC(CreateGraphicsPipelines);
+        WXL_VK_DEVICE_PROC(DestroyPipeline);
+        WXL_VK_DEVICE_PROC(CreateDescriptorPool);
+        WXL_VK_DEVICE_PROC(DestroyDescriptorPool);
+        WXL_VK_DEVICE_PROC(ResetDescriptorPool);
+        WXL_VK_DEVICE_PROC(AllocateDescriptorSets);
+        WXL_VK_DEVICE_PROC(UpdateDescriptorSets);
+        WXL_VK_DEVICE_PROC(CreateSampler);
+        WXL_VK_DEVICE_PROC(DestroySampler);
+
+        WXL_VK_DEVICE_PROC(CmdBindPipeline);
+        WXL_VK_DEVICE_PROC(CmdBindVertexBuffers);
+        WXL_VK_DEVICE_PROC(CmdBindIndexBuffer);
+        WXL_VK_DEVICE_PROC(CmdBindDescriptorSets);
+        WXL_VK_DEVICE_PROC(CmdPushConstants);
+        WXL_VK_DEVICE_PROC(CmdSetViewport);
+        WXL_VK_DEVICE_PROC(CmdSetScissor);
+        WXL_VK_DEVICE_PROC(CmdDrawIndexed);
+        WXL_VK_DEVICE_PROC(CmdDraw);
+        WXL_VK_DEVICE_PROC(CmdSetDepthBias);
+        WXL_VK_DEVICE_PROC(CmdSetBlendConstants);
+
+        // Render targets, copies, read-back and queries; 1.0 core, so required like the rest.
+        WXL_VK_DEVICE_PROC(CmdCopyImage);
+        WXL_VK_DEVICE_PROC(CmdCopyImageToBuffer);
+        WXL_VK_DEVICE_PROC(CreateQueryPool);
+        WXL_VK_DEVICE_PROC(CmdResetQueryPool);
+        WXL_VK_DEVICE_PROC(CmdBeginQuery);
+        WXL_VK_DEVICE_PROC(CmdEndQuery);
+        WXL_VK_DEVICE_PROC(GetQueryPoolResults);
+
+        // The pipeline cache persisted beside the DLL. 1.0 core.
+        WXL_VK_DEVICE_PROC(CreatePipelineCache);
+        WXL_VK_DEVICE_PROC(GetPipelineCacheData);
+
+        // The stages and the depth history (src/stages/, src/native/render/): compute, its indirect dispatches, buffer fills and
+        // the GPU timestamps of the stats lines. 1.0 core.
+        WXL_VK_DEVICE_PROC(CreateComputePipelines);
+        WXL_VK_DEVICE_PROC(CmdDispatch);
+        WXL_VK_DEVICE_PROC(CmdDispatchIndirect);
+        WXL_VK_DEVICE_PROC(CmdFillBuffer);
+        WXL_VK_DEVICE_PROC(CmdWriteTimestamp);
+
+        WXL_VK_DEVICE_PROC(QueueSubmit);
+        WXL_VK_DEVICE_PROC(AcquireNextImageKHR);
+        WXL_VK_DEVICE_PROC(QueuePresentKHR);
+
+#undef WXL_VK_DEVICE_PROC
+
+        if (missing)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                "vulkan: %u device entry point(s) missing; declining", missing);
+            return false;
+        }
+        return true;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Loader.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Loader.hpp
