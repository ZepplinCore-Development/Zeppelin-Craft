+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "CataWater.h"
+class CGxShader;
+namespace HD::CataWater::Gx {
+// Render thread only, with a live Vulkan device. Engine hash-table ownership, not raw new/delete.
+// The caller keeps the returned reference and releases it before the device is destroyed.
+CGxShader* Acquire(ShaderKind kind, const char* family, uint32_t permutation,
+                   const std::vector<uint8_t>& bytecode, std::string& error);
+void Release(CGxShader*& shader);
+// Candidate bridge, compiled against the actual client headers. Does not bind textures or submit a draw.
+// The caller must finish geometry, lighting, fog, screen/depth constants, descriptors and all per-instance
+// transforms BEFORE this call. Pixel high constants are uploaded LAST to avoid bone/VS overwrites.
+bool BindAndUpload(CGxShader* vertex, CGxShader* pixel, const MaterialConstants& constants,
+                   const PreparedInputs& inputs, const FrameKey& current, std::string& error);
+}
diff --git a/WoW/Source/WorldClient/HD/HdAO.cpp b/WoW/Source/WorldClient/HD/HdAO.cpp
new file mode 100644
index 00000000..421484a0
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdAO.cpp
@@ -0,0 +1,417 @@
+// HD: Waystone HD ambient occlusion (see HdAO.h). Written for this client; the order of the raw D3D9 work and the
+// state reset afterwards are the ones hdWater's depth pass uses in the same place of the frame (HdWater.cpp
+// LineariseDepth), which is known to work in game: no Get* of render states and no state block, because the client
+// makes a PURE device (CGxDeviceD3d::ICreateD3dDevice), where Direct3D does not promise either.
+#include "WoW/Source/WorldClient/HD/HdAO.h"
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <windows.h>
+#include <d3d9.h>
+#include <d3dcompiler.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDeviceD3d/CGxDeviceD3d.h"
+#include "Engine/Source/Gx/Types.h"
+#include "WoW/Source/WorldClient/HD/HdFog.h"
+
+namespace {
+    // HD: checked with d3dcompiler_47 (ps_3_0, optimisation level 3, as below): Generate 438 instruction slots,
+    // Blur 143, Apply 7 (ps_3_0 guarantees 512).
+    const char kShader[] = R"HLSL(// Waystone HD ambient occlusion (ps_3_0, D3D9). Three entry points over the whole world target:
+//   Generate: AO from the world depth (8 samples around each pixel, normals rebuilt from the depth)
+//   Blur:     5-tap blur that stops at depth edges (run twice: across, then down)
+//   Apply:    the AO factor, multiplied into the world's colour by the blend state (dst = dst * src)
+// The world depth is hdFog's INTZ copy of the client's depth buffer (HD::FogGetWorldDepth).
+sampler2D DepthTex : register(s0); // INTZ world depth, point, clamp
+sampler2D AOTex    : register(s1); // AO factor (r), point, clamp
+float4 cScreen : register(c0); // 1/width, 1/height of the target, depth scale A, depth offset B (z01 = raw * A + B)
+float4 cView   : register(c1); // view xy = (local uv * xy + zw) * view z  (from projection a0, b1, c0, c1)
+float4 cRect   : register(c2); // world viewport in target uv: offset xy, 1 / size zw
+float4 cDepth  : register(c3); // projection c2, -d2, sky threshold, unused
+float4 cParams : register(c4); // radius (yards), strength, angular bias, blur sharpness (1/yards)
+float4 cBlur   : register(c5); // blur step in uv (xy), fade start (yards), 1 / fade length
+
+// View-space position of the surface seen at uv (camera at 0, +z forward), w = 1; w = 0 for the sky and for
+// pixels outside the world viewport.
+float4 ViewPos(float2 uv)
+{
+    float2 local = (uv - cRect.xy) * cRect.zw;
+    float raw = tex2Dlod(DepthTex, float4(uv, 0, 0)).r;
+    float z01 = raw * cScreen.z + cScreen.w;           // back to the projection's 0..1 (world uses 0..0.94)
+    float z = cDepth.y / max(cDepth.x - z01, 1e-7);    // zv = d2 / (z01 - c2)
+    bool inside = all(local == saturate(local));
+    float w = (inside && z01 < cDepth.z) ? 1.0 : 0.0;
+    return float4((local * cView.xy + cView.zw) * z, z, w);
+}
+
+// Interleaved gradient noise (Jimenez 2014): per-pixel rotation, removed by the blur.
+float Noise(float2 vpos)
+{
+    return frac(52.9829189 * frac(dot(vpos, float2(0.06711056, 0.00583715))));
+}
+
+float4 Generate(float2 vpos : VPOS) : COLOR0
+{
+    float2 uv = (vpos + 0.5) * cScreen.xy;
+    float4 c = ViewPos(uv);
+    if (c.w < 0.5) return 1.0;
+    float3 p = c.xyz;
+
+    // normal from the neighbours on the side closest in depth (does not bend across silhouettes)
+    float4 l = ViewPos(uv - float2(cScreen.x, 0));
+    float4 r = ViewPos(uv + float2(cScreen.x, 0));
+    float4 u = ViewPos(uv - float2(0, cScreen.y));
+    float4 d = ViewPos(uv + float2(0, cScreen.y));
+    float3 dx = (abs(p.z - l.z) * l.w + (1.0 - l.w) * 1e9 < abs(r.z - p.z) * r.w + (1.0 - r.w) * 1e9) ? p - l.xyz : r.xyz - p;
+    float3 dy = (abs(p.z - u.z) * u.w + (1.0 - u.w) * 1e9 < abs(d.z - p.z) * d.w + (1.0 - d.w) * 1e9) ? p - u.xyz : d.xyz - p;
+    float3 n = cross(dx, dy);
+    n = dot(n, n) > 1e-12 ? normalize(n) : -normalize(p);
+    n = dot(n, p) > 0.0 ? -n : n;                        // facing the camera
+
+    // the radius in yards, in uv at this depth (capped near the camera to 64 pixels)
+    float2 reach = min(cParams.x / (p.z * abs(cView.xy) * cRect.zw), 64.0 * cScreen.xy);
+    float noise = Noise(vpos);
+    float sn, cs;
+    sincos(noise * 0.78539816, sn, cs);                  // rotate the 8 directions by 0..45 degrees per pixel
+    float sum = 0.0;
+    [unroll] for (int i = 0; i < 8; ++i) {
+        const float a = i * 0.78539816;
+        float2 dir = float2(cos(a) * cs - sin(a) * sn, cos(a) * sn + sin(a) * cs);
+        float scale = frac(noise + i * 0.618034) * 0.75 + 0.25;  // 0.25..1 of the radius
+        float4 q = ViewPos(uv + dir * reach * scale);
+        float3 v = q.xyz - p;
+        float dist2 = max(dot(v, v), 1e-8);
+        float invDist = rsqrt(dist2);
+        float angular = saturate(dot(n, v) * invDist - cParams.z);
+        float falloff = saturate(1.0 - dist2 / (cParams.x * cParams.x));
+        sum += angular * falloff * q.w;
+    }
+    float ao = 1.0 - min(0.9, cParams.y * sum * 0.25);
+    // fade out with distance (the depth gets coarse far away, and far scenery is already fogged)
+    ao = lerp(ao, 1.0, saturate((p.z - cBlur.z) * cBlur.w));
+    return float4(ao, ao, ao, 1.0);
+}
+
+float4 Blur(float2 vpos : VPOS) : COLOR0
+{
+    float2 uv = (vpos + 0.5) * cScreen.xy;
+    float4 c = ViewPos(uv);
+    if (c.w < 0.5) return 1.0;
+    float sharp = cParams.w / (1.0 + 0.02 * c.z);       // depth tolerance grows with distance
+    float total = 0.0;
+    float weights = 0.0;
+    [unroll] for (int i = -2; i <= 2; ++i) {
+        float2 t = uv + cBlur.xy * i;
+        float4 q = ViewPos(t);
+        const float spatial = (i == 0) ? 6.0 : ((i == -1 || i == 1) ? 4.0 : 1.0);
+        float weight = spatial * exp2(-abs(q.z - c.z) * sharp) * q.w;
+        total += tex2Dlod(AOTex, float4(t, 0, 0)).r * weight;
+        weights += weight;
+    }
+    float ao = total / max(weights, 1e-6);
+    return float4(ao, ao, ao, 1.0);
+}
+
+float4 Apply(float2 vpos : VPOS) : COLOR0
+{
+    float ao = tex2Dlod(AOTex, float4((vpos + 0.5) * cScreen.xy, 0, 0)).r;
+    return float4(ao, ao, ao, 1.0);
+}
+)HLSL";
+
+    enum { PS_Generate, PS_Blur, PS_Apply, PS_Count };
+    const char* const kEntry[PS_Count] = { "Generate", "Blur", "Apply" };
+    const UINT kConstRegs = 6; // c0..c5 (HD::FogInvalidateClientState re-sends c0..c33)
+    const float kSkyDepth = 0.99999f;
+    const float kFadeStart = 150.0f; // yards: AO fades out from here...
+    const float kFadeLength = 100.0f; // ...over this distance
+
+    typedef HRESULT(WINAPI* D3DCompileFn)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*, LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+
+    struct Target {
+        IDirect3DTexture9* tex = nullptr;
+        IDirect3DSurface9* surf = nullptr;
+    };
+
+    CVar* s_enabled = nullptr;
+    CVar* s_radius = nullptr;
+    CVar* s_strength = nullptr;
+    CVar* s_debug = nullptr;
+    CVar* s_info = nullptr;
+    char s_lastInfo[160] = "";
+
+    std::vector<DWORD> s_code[PS_Count]; // compiled once; the shader objects are remade after a device reset
+    bool s_compileFailed = false;
+    IDirect3DPixelShader9* s_ps[PS_Count] = {};
+    Target s_ao[2];
+    UINT s_width = 0;
+    UINT s_height = 0;
+
+    void RegisterCVars() {
+        static bool registered = false;
+        if (registered) return;
+        registered = true;
+        s_enabled = CVar::Register("hdAO", "HD: 1 = ambient occlusion, 0 = off", 1, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_radius = CVar::Register("hdAORadius", "HD: ambient occlusion reach in yards, 1.5 = normal", 1, "1.5", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_strength = CVar::Register("hdAOStrength", "HD: ambient occlusion strength, 1 = normal", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_debug = CVar::Register("hdAODebug", "HD: 1 = test view, the ambient occlusion alone", 0, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_info = CVar::Register("hdAOInfo", "HD: hdAO status (read only)", 0, "off", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    }
+
+    void SetInfo(const char* text) {
+        if (!s_info || !strcmp(s_lastInfo, text)) return;
+        snprintf(s_lastInfo, sizeof(s_lastInfo), "%s", text);
+        s_info->Set(text, true, false, false, false);
+    }
+
+    float CVarValue(CVar* cvar, float fallback, float lo, float hi) {
+        float v = cvar ? cvar->m_floatValue : fallback;
+        if (!(v == v)) return fallback; // NaN
+        return v < lo ? lo : (v > hi ? hi : v);
+    }
+
+    IDirect3DDevice9* Device() {
+        if (!g_theGxDevicePtr || g_theGxDevicePtr->DeviceApi() != GxApi_D3d9) return nullptr;
+        return static_cast<CGxDeviceD3d*>(g_theGxDevicePtr)->m_d3dDevice;
+    }
+
+    void ReleaseTargets() {
+        for (Target& t : s_ao) {
+            if (t.surf) { t.surf->Release(); t.surf = nullptr; }
+            if (t.tex) { t.tex->Release(); t.tex = nullptr; }
+        }
+        s_width = 0;
+        s_height = 0;
+    }
+
+    void ReleaseShaders() {
+        for (IDirect3DPixelShader9*& ps : s_ps) {
+            if (ps) { ps->Release(); ps = nullptr; }
+        }
+    }
+
+    bool EnsureTargets(IDirect3DDevice9* device, UINT width, UINT height) {
+        if (s_ao[0].surf && s_ao[1].surf && s_width == width && s_height == height) return true;
+        ReleaseTargets();
+        for (Target& t : s_ao) {
+            if (FAILED(device->CreateTexture(width, height, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &t.tex, nullptr)) || !t.tex) {
+                t.tex = nullptr;
+                ReleaseTargets();
+                return false;
+            }
+            if (FAILED(t.tex->GetSurfaceLevel(0, &t.surf)) || !t.surf) {
+                t.surf = nullptr;
+                ReleaseTargets();
+                return false;
+            }
+        }
+        s_width = width;
+        s_height = height;
+        return true;
+    }
+
+    bool EnsureShaders(IDirect3DDevice9* device) {
+        if (s_ps[PS_Generate] && s_ps[PS_Blur] && s_ps[PS_Apply]) return true;
+        if (s_compileFailed) return false;
+        if (s_code[0].empty()) {
+            s_compileFailed = true;
+            HMODULE module = LoadLibraryA("d3dcompiler_47.dll");
+            D3DCompileFn compile = module ? reinterpret_cast<D3DCompileFn>(GetProcAddress(module, "D3DCompile")) : nullptr;
+            if (!compile) {
+                SetInfo("ERROR: d3dcompiler_47.dll not found");
+                return false;
+            }
+            for (int i = 0; i < PS_Count; i++) {
+                ID3DBlob* code = nullptr;
+                ID3DBlob* errors = nullptr;
+                HRESULT hr = compile(kShader, strlen(kShader), "HdAO", nullptr, nullptr, kEntry[i], "ps_3_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+                if (FAILED(hr) || !code) {
+                    char text[160];
+                    snprintf(text, sizeof(text), "ERROR: shader %s: %s", kEntry[i], errors ? static_cast<const char*>(errors->GetBufferPointer()) : "unknown");
+                    SetInfo(text);
+                    if (errors) errors->Release();
+                    if (code) code->Release();
+                    for (std::vector<DWORD>& c : s_code) c.clear();
+                    return false;
+                }
+                if (errors) errors->Release();
+                const DWORD* p = static_cast<const DWORD*>(code->GetBufferPointer());
+                s_code[i].assign(p, p + code->GetBufferSize() / sizeof(DWORD));
+                code->Release();
+            }
+            s_compileFailed = false;
+        }
+        for (int i = 0; i < PS_Count; i++) {
+            if (!s_ps[i] && FAILED(device->CreatePixelShader(s_code[i].data(), &s_ps[i]))) {
+                s_ps[i] = nullptr;
+                ReleaseShaders();
+                s_compileFailed = true;
+                SetInfo("ERROR: CreatePixelShader failed");
+                return false;
+            }
+        }
+        return true;
+    }
+
+    // The world viewport in pixels, as CGxDeviceD3d::IXformSetViewport sets it from the client's viewport.
+    void WorldViewport(float* x, float* y, float* w, float* h) {
+        CGxDevice* gx = g_theGxDevicePtr;
+        const CRect& window = gx->DeviceCurWindow();
+        const CBoundingBox& vp = gx->m_viewport;
+        DWORD vx = static_cast<DWORD>(vp.m_x.m_l * window.maxX + 0.5f);
+        DWORD vy = static_cast<DWORD>((1.0f - vp.m_y.m_h) * window.maxY + 0.5f);
+        DWORD vw = static_cast<DWORD>(vp.m_x.m_h * window.maxX - vx + 0.5f);
+        DWORD vh = static_cast<DWORD>((1.0f - vp.m_y.m_l) * window.maxY - vy + 0.5f);
+        if (gx->m_textureTarget[0].m_apiSpecific || gx->m_textureTarget[1].m_apiSpecific) {
+            vy = static_cast<DWORD>(window.maxY * vp.m_y.m_l);
+        }
+        *x = static_cast<float>(vx);
+        *y = static_cast<float>(vy);
+        *w = static_cast<float>(vw);
+        *h = static_cast<float>(vh);
+    }
+
+    // One full-target pass. SetRenderTarget also sets the viewport to the whole target.
+    void Pass(IDirect3DDevice9* device, IDirect3DSurface9* target, int shader, IDirect3DTexture9* ao, UINT width, UINT height) {
+        device->SetRenderTarget(0, target);
+        device->SetPixelShader(s_ps[shader]);
+        device->SetTexture(1, ao);
+        float w = static_cast<float>(width) - 0.5f;
+        float h = static_cast<float>(height) - 0.5f;
+        float quad[16] = {
+            -0.5f, -0.5f, 0.0f, 1.0f,
+            w, -0.5f, 0.0f, 1.0f,
+            -0.5f, h, 0.0f, 1.0f,
+            w, h, 0.0f, 1.0f,
+        };
+        device->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP, 2, quad, 4 * sizeof(float));
+        device->SetTexture(1, nullptr);
+    }
+}
+
+bool HD::AOWantsDepth() {
+    RegisterCVars();
+    return s_enabled && s_enabled->m_intValue != 0;
+}
+
+void HD::AORenderOpaque() {
+    RegisterCVars();
+    if (!s_enabled || !s_enabled->m_intValue) {
+        // HD: off: no Direct3D call at all (only our own textures are let go, once)
+        if (s_ao[0].tex || s_ao[1].tex) ReleaseTargets();
+        SetInfo("off");
+        return;
+    }
+    IDirect3DDevice9* device = Device();
+    if (!device) { SetInfo("ERROR: needs gxApi d3d9"); return; }
+    HD::FogWorldDepth depth;
+    if (!HD::FogGetWorldDepth(&depth)) {
+        SetInfo("no world depth (multisampling must be 1x, INTZ needed): AO skipped");
+        return;
+    }
+    const C44Matrix& proj = g_theGxDevicePtr->m_projNative;
+    // a perspective projection (zv = d2 / (z - c2), w = view z); anything else (orthographic views) is skipped
+    if (proj.a0 == 0.0f || proj.b1 == 0.0f || proj.c3 != 1.0f || proj.d3 != 0.0f || !(proj.c2 > 0.0f) || !(proj.d2 < 0.0f) ||
+        !(depth.vpMax > depth.vpMin)) {
+        SetInfo("on, projection not supported this frame: AO skipped");
+        return;
+    }
+    if (!EnsureShaders(device)) return;
+
+    IDirect3DSurface9* color = nullptr;
+    if (FAILED(device->GetRenderTarget(0, &color)) || !color) return;
+    D3DSURFACE_DESC desc;
+    color->GetDesc(&desc);
+    if (desc.Width != depth.width || desc.Height != depth.height || desc.MultiSampleType != D3DMULTISAMPLE_NONE) {
+        color->Release();
+        SetInfo("on, world target and depth differ in size: AO skipped");
+        return;
+    }
+    if (!EnsureTargets(device, desc.Width, desc.Height)) {
+        color->Release();
+        SetInfo("ERROR: AO render target not supported");
+        return;
+    }
+    IDirect3DSurface9* worldDepth = nullptr;
+    device->GetDepthStencilSurface(&worldDepth);
+
+    float vx, vy, vw, vh;
+    WorldViewport(&vx, &vy, &vw, &vh);
+    if (vw < 1.0f || vh < 1.0f) { vx = 0.0f; vy = 0.0f; vw = static_cast<float>(desc.Width); vh = static_cast<float>(desc.Height); }
+    const float radius = CVarValue(s_radius, 1.5f, 0.25f, 6.0f);
+    const float strength = CVarValue(s_strength, 1.0f, 0.0f, 3.0f);
+    const float depthScale = 1.0f / (depth.vpMax - depth.vpMin);
+    float c[kConstRegs * 4] = {
+        1.0f / desc.Width, 1.0f / desc.Height, depthScale, -depth.vpMin * depthScale,
+        2.0f / proj.a0, -2.0f / proj.b1, (-1.0f - proj.c0) / proj.a0, (1.0f - proj.c1) / proj.b1,
+        vx / desc.Width, vy / desc.Height, desc.Width / vw, desc.Height / vh,
+        proj.c2, -proj.d2, kSkyDepth, 0.0f,
+        radius, strength, 0.1f, 1.0f / (radius * 0.2f),
+        0.0f, 0.0f, kFadeStart, 1.0f / kFadeLength,
+    };
+
+    // HD: the same states hdWater's depth pass sets here (all re-sent by the client afterwards), plus the blend
+    device->SetDepthStencilSurface(nullptr); // the depth texture cannot be read while it is the depth buffer
+    device->SetRenderState(D3DRS_ZENABLE, FALSE);
+    device->SetRenderState(D3DRS_ZWRITEENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHATESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+    device->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
+    device->SetRenderState(D3DRS_FOGENABLE, FALSE);
+    device->SetRenderState(D3DRS_SCISSORTESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_CLIPPLANEENABLE, 0);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, 0x0F);
+    device->SetVertexShader(nullptr);
+    device->SetFVF(D3DFVF_XYZRHW);
+    device->SetTexture(0, depth.texture);
+    for (DWORD i = 0; i < 2; i++) {
+        device->SetSamplerState(i, D3DSAMP_MINFILTER, D3DTEXF_POINT);
+        device->SetSamplerState(i, D3DSAMP_MAGFILTER, D3DTEXF_POINT);
+        device->SetSamplerState(i, D3DSAMP_MIPFILTER, D3DTEXF_NONE);
+        device->SetSamplerState(i, D3DSAMP_ADDRESSU, D3DTADDRESS_CLAMP);
+        device->SetSamplerState(i, D3DSAMP_ADDRESSV, D3DTADDRESS_CLAMP);
+    }
+    device->SetPixelShaderConstantF(0, c, kConstRegs);
+    Pass(device, s_ao[0].surf, PS_Generate, nullptr, desc.Width, desc.Height);
+    c[20] = 1.0f / desc.Width; c[21] = 0.0f;
+    device->SetPixelShaderConstantF(5, &c[20], 1);
+    Pass(device, s_ao[1].surf, PS_Blur, s_ao[0].tex, desc.Width, desc.Height);
+    c[20] = 0.0f; c[21] = 1.0f / desc.Height;
+    device->SetPixelShaderConstantF(5, &c[20], 1);
+    Pass(device, s_ao[0].surf, PS_Blur, s_ao[1].tex, desc.Width, desc.Height);
+
+    // the world's colour times the AO (dst = dst * src); the alpha (glow mask) is kept
+    const bool debug = s_debug && s_debug->m_intValue != 0;
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, D3DCOLORWRITEENABLE_RED | D3DCOLORWRITEENABLE_GREEN | D3DCOLORWRITEENABLE_BLUE);
+    if (!debug) {
+        device->SetRenderState(D3DRS_ALPHABLENDENABLE, TRUE);
+        device->SetRenderState(D3DRS_BLENDOP, D3DBLENDOP_ADD); // the client never changes it (HdBloom sets it too)
+        device->SetRenderState(D3DRS_SRCBLEND, D3DBLEND_ZERO);
+        device->SetRenderState(D3DRS_DESTBLEND, D3DBLEND_SRCCOLOR);
+    }
+    Pass(device, color, PS_Apply, s_ao[0].tex, desc.Width, desc.Height);
+    device->SetTexture(0, nullptr);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, 0x0F);
+
+    // the world's targets back (SetRenderTarget reset the viewport and the scissor rectangle)
+    device->SetRenderTarget(0, color);
+    device->SetDepthStencilSurface(worldDepth);
+    color->Release();
+    if (worldDepth) worldDepth->Release();
+    // HD: the client turns the depth test on once at start-up and never again (see HdFog.cpp)
+    device->SetRenderState(D3DRS_ZENABLE, D3DZB_TRUE);
+    CGxDeviceD3d* gx = static_cast<CGxDeviceD3d*>(g_theGxDevicePtr);
+    gx->m_viewportDirty = 1;
+    gx->m_scissorRectDirty = 1;
+    HD::FogInvalidateClientState();
+    SetInfo(debug ? "on, test view (hdAODebug 1)" : "on");
+}
+
+void HD::AOReleaseDeviceResources() {
+    ReleaseTargets();
+    ReleaseShaders();
+}
diff --git a/WoW/Source/WorldClient/HD/HdAO.h b/WoW/Source/WorldClient/HD/HdAO.h
new file mode 100644
index 00000000..8048af31
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdAO.h
@@ -0,0 +1,26 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDAO_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDAO_H
+
+// Waystone HD: ambient occlusion (not part of the original client). D3D9 only, off by default.
+// Screen-space AO (8 samples per pixel, normals rebuilt from the depth, 2 blur passes that stop at depth edges),
+// multiplied into the opaque world (terrain, buildings, models of the first pass, grass) before the water, the
+// transparent models, the weather and the spells are drawn. Not a port of WoW Forever's ASSAO (its D3D12 shaders
+// cannot run here): it darkens creases, corners and contact areas in the same spirit.
+// Reads the world depth that HdFog captures (INTZ, multisampling 1x), as hdWater and hdRays do.
+//   hdAO          0 = off (default), 1 = on
+//   hdAORadius    reach in yards, 1.5 = normal (0.25 to 6)
+//   hdAOStrength  1 = normal (0 to 3)
+//   hdAODebug     1 = test view: the AO alone in grey (white = no occlusion)
+//   hdAOInfo      read only, status:  /run print(GetCVar("hdAOInfo"))
+
+namespace HD {
+    // True when hdAO needs the world depth this frame (HdFog::FogBeginWorld).
+    bool AOWantsDepth();
+    // Called by CGWorldFrame::OnWorldRender after CWorldScene::RenderDetailDoodads (the opaque world is drawn).
+    // Does nothing at all when hdAO is 0.
+    void AORenderOpaque();
+    // Called by the D3D9 device before it releases its resources (through HD::FogReleaseDeviceResources).
+    void AOReleaseDeviceResources();
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdBloom.cpp b/WoW/Source/WorldClient/HD/HdBloom.cpp
new file mode 100644
index 00000000..a8447f23
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdBloom.cpp
@@ -0,0 +1,451 @@
+#include "WoW/Source/WorldClient/HD/HdBloom.h"
+#include <cstdio>
+#include <cstring>
+#include <windows.h>
+#include <d3d9.h>
+#include <d3dcompiler.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDeviceD3d/CGxDeviceD3d.h"
+#include "Engine/Source/Gx/Types.h"
+#include "WoW/Source/WorldClient/HD/HdFog.h"
+
+namespace {
+    // Pixel shader registers c0..c3 (see kShader).
+    const UINT kConstRegs = 4;
+
+    // HD: one source, one entry point per pass. Every pass draws a full-screen quad into a smaller target:
+    // bright parts -> blur (quarter and eighth size) for the halo, bright sky near the sun -> blur toward the
+    // sun for the rays, then everything is added over the world with a "screen" blend (never brighter than white).
+    const char* kShader = R"HLSL(
+sampler2D tex0 : register(s0);
+sampler2D tex1 : register(s1);
+sampler2D tex2 : register(s2);
+float4 c_target : register(c0); // 1/width, 1/height of the target being drawn
+float4 c_a      : register(c1); // per pass, see each entry point
+float4 c_b      : register(c2);
+float4 c_c      : register(c3);
+
+float2 UV(float2 vpos) { return (vpos + 0.5) * c_target.xy; }
+
+float3 Box4(float2 uv, float2 texel) {
+    return (tex2D(tex0, uv + texel * float2(-1, -1)).rgb + tex2D(tex0, uv + texel * float2(1, -1)).rgb +
+            tex2D(tex0, uv + texel * float2(-1, 1)).rgb + tex2D(tex0, uv + texel * float2(1, 1)).rgb) * 0.25;
+}
+
+// bright parts only, shrunk. c_a.xy = source texel, c_b.x = threshold, c_b.y = soft knee
+float4 Bright(float2 vpos : VPOS) : COLOR0 {
+    float3 c = Box4(UV(vpos), c_a.xy);
+    float l = max(c.r, max(c.g, c.b));
+    float k = c_b.y;
+    float soft = clamp(l - c_b.x + k, 0.0, 2.0 * k);
+    soft = soft * soft / (4.0 * k + 1e-4);
+    return float4(c * (max(soft, l - c_b.x) / max(l, 1e-4)), 1);
+}
+
+// shrink. c_a.xy = source texel
+float4 Down(float2 vpos : VPOS) : COLOR0 {
+    return float4(Box4(UV(vpos), c_a.xy), 1);
+}
+
+// 9 tap gaussian in one direction (5 filtered taps). c_a.xy = step
+float4 Blur(float2 vpos : VPOS) : COLOR0 {
+    float2 uv = UV(vpos);
+    float3 c = tex2D(tex0, uv).rgb * 0.2270270;
+    c += (tex2D(tex0, uv + c_a.xy * 1.3846154).rgb + tex2D(tex0, uv - c_a.xy * 1.3846154).rgb) * 0.3162162;
+    c += (tex2D(tex0, uv + c_a.xy * 3.2307692).rgb + tex2D(tex0, uv - c_a.xy * 3.2307692).rgb) * 0.0702703;
+    return float4(c, 1);
+}
+
+// where rays start: bright sky around the sun. tex0 = world (half size), tex1 = world depth.
+// c_a.xy = sun position on screen, c_a.z = width / height, c_a.w = radius; c_b.x = threshold, c_b.y = far clip;
+// c_c = world viewport depth min, max, projection c2, d2
+float4 RayMask(float2 vpos : VPOS) : COLOR0 {
+    float2 uv = UV(vpos);
+    // HD: same sky test as the fog: nothing drawn, or at the far clip (the sky dome is drawn there, ~0.94)
+    float raw = tex2D(tex1, uv).r;
+    float z = saturate((raw - c_c.x) / max(c_c.y - c_c.x, 1e-4));
+    float denom = z - c_c.z;
+    float zv = abs(c_c.w / (abs(denom) < 1e-7 ? 1e-7 : denom));
+    float sky = (raw >= 0.99999 || zv >= c_b.y * 0.98) ? 1.0 : 0.0;
+    float3 c = tex2D(tex0, uv).rgb;
+    float fall = saturate(1.0 - length((uv - c_a.xy) * float2(c_a.z, 1.0)) / c_a.w);
+    float l = max(c.r, max(c.g, c.b));
+    float b = saturate((l - c_b.x) / max(1.0 - c_b.x, 1e-3));
+    return float4(c * (sky * fall * fall * (0.25 + 0.75 * b)), 1);
+}
+
+// rays: average along the line toward the sun. c_a.xy = sun position, c_a.z = length, c_a.w = decay;
+// c_b.x = exposure
+float4 Radial(float2 vpos : VPOS) : COLOR0 {
+    float2 uv = UV(vpos);
+    float2 stepUv = (uv - c_a.xy) * (c_a.z / 48.0);
+    float3 sum = 0.0;
+    float w = 1.0;
+    float total = 0.0;
+    [loop] for (int i = 0; i < 48; i++) {
+        sum += tex2D(tex0, uv).rgb * w;
+        total += w;
+        uv -= stepUv;
+        w *= c_a.w;
+    }
+    return float4(sum / total * c_b.x, 1);
+}
+
+// over the world. tex0 = halo, tex1 = wide halo, tex2 = rays. c_a.x = halo strength, c_a.y = rays strength,
+// c_a.z = hdBloomDebug; c_b.xy = sun position, c_b.z = width / height
+float4 Composite(float2 vpos : VPOS) : COLOR0 {
+    float2 uv = UV(vpos);
+    float3 halo = (tex2D(tex0, uv).rgb * 0.6 + tex2D(tex1, uv).rgb * 0.8) * c_a.x;
+    float3 rays = tex2D(tex2, uv).rgb * c_a.y;
+    if (c_a.z > 0.5) {
+        // HD: test views (drawn opaque): 1 = where rays start (x4), 2 = rays only, 3 = halo only; red dot = sun
+        float3 col = c_a.z > 2.5 ? halo : (c_a.z > 1.5 ? rays : tex2D(tex2, uv).rgb * 4.0);
+        if (length((uv - c_b.xy) * float2(c_b.z, 1.0)) < 0.012) col = float3(1, 0, 0);
+        return float4(saturate(col), 1);
+    }
+    return float4(saturate(halo + rays), 1);
+}
+)HLSL";
+
+    enum { PS_Bright, PS_Down, PS_Blur, PS_RayMask, PS_Radial, PS_Composite, PS_Count };
+    const char* const kEntry[PS_Count] = { "Bright", "Down", "Blur", "RayMask", "Radial", "Composite" };
+
+    typedef HRESULT(WINAPI* D3DCompileFn)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*, LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+
+    struct Target {
+        IDirect3DTexture9* tex = nullptr;
+        IDirect3DSurface9* surf = nullptr;
+        UINT w = 0;
+        UINT h = 0;
+    };
+
+    CVar* s_bloom = nullptr;
+    CVar* s_strength = nullptr;
+    CVar* s_threshold = nullptr;
+    CVar* s_rays = nullptr;
+    CVar* s_raysStrength = nullptr;
+    CVar* s_debug = nullptr;
+    CVar* s_info = nullptr;
+
+    IDirect3DPixelShader9* s_ps[PS_Count] = {};
+    bool s_shaderFailed = false;
+    Target s_half;    // the world, half size
+    Target s_quarter[2];
+    Target s_eighth[2];
+    Target s_rays2[2]; // quarter size
+    UINT s_width = 0;
+    UINT s_height = 0;
+    char s_lastInfo[256] = "";
+
+    void RegisterCVars() {
+        static bool registered = false;
+        if (registered) return;
+        registered = true;
+        s_bloom = CVar::Register("hdBloom", "HD: 1 = halo around bright parts of the world", 1, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_strength = CVar::Register("hdBloomStrength", "HD: halo strength, 1 = normal", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_threshold = CVar::Register("hdBloomThreshold", "HD: how bright a pixel must be to glow (0 to 1)", 1, "0.7", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_rays = CVar::Register("hdRays", "HD: 1 = sun rays", 1, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_raysStrength = CVar::Register("hdRaysStrength", "HD: sun rays strength, 1 = normal", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_debug = CVar::Register("hdBloomDebug", "HD: test view, 1 = where rays start, 2 = rays only, 3 = halo only", 0, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_info = CVar::Register("hdBloomInfo", "HD: hdBloom status (read only)", 0, "off", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    }
+
+    void SetInfo(const char* text) {
+        if (!s_info || !strcmp(s_lastInfo, text)) return;
+        snprintf(s_lastInfo, sizeof(s_lastInfo), "%s", text);
+        s_info->Set(text, true, false, false, false);
+    }
+
+    float Clamp(float v, float lo, float hi) {
+        return v < lo ? lo : (v > hi ? hi : v);
+    }
+
+    float CVarValue(CVar* cvar, float fallback, float hi) {
+        return cvar ? Clamp(cvar->m_floatValue, 0.0f, hi) : fallback;
+    }
+
+    IDirect3DDevice9* Device() {
+        if (!g_theGxDevicePtr || g_theGxDevicePtr->DeviceApi() != GxApi_D3d9) return nullptr;
+        return static_cast<CGxDeviceD3d*>(g_theGxDevicePtr)->m_d3dDevice;
+    }
+
+    void ReleaseTarget(Target& t) {
+        if (t.surf) { t.surf->Release(); t.surf = nullptr; }
+        if (t.tex) { t.tex->Release(); t.tex = nullptr; }
+        t.w = 0;
+        t.h = 0;
+    }
+
+    void ReleaseTargets() {
+        ReleaseTarget(s_half);
+        for (int i = 0; i < 2; i++) {
+            ReleaseTarget(s_quarter[i]);
+            ReleaseTarget(s_eighth[i]);
+            ReleaseTarget(s_rays2[i]);
+        }
+        s_width = 0;
+        s_height = 0;
+    }
+
+    bool CreateTarget(IDirect3DDevice9* device, Target& t, UINT w, UINT h, D3DFORMAT format) {
+        if (w < 1) w = 1;
+        if (h < 1) h = 1;
+        if (FAILED(device->CreateTexture(w, h, 1, D3DUSAGE_RENDERTARGET, format, D3DPOOL_DEFAULT, &t.tex, nullptr)) || !t.tex) {
+            t.tex = nullptr;
+            return false;
+        }
+        t.tex->GetSurfaceLevel(0, &t.surf);
+        t.w = w;
+        t.h = h;
+        return t.surf != nullptr;
+    }
+
+    bool CreateTargets(IDirect3DDevice9* device, UINT w, UINT h) {
+        ReleaseTargets();
+        bool ok = CreateTarget(device, s_half, w / 2, h / 2, D3DFMT_A8R8G8B8);
+        for (int i = 0; i < 2 && ok; i++) {
+            ok = CreateTarget(device, s_quarter[i], w / 4, h / 4, D3DFMT_A16B16G16R16F)
+                && CreateTarget(device, s_eighth[i], w / 8, h / 8, D3DFMT_A16B16G16R16F)
+                && CreateTarget(device, s_rays2[i], w / 4, h / 4, D3DFMT_A16B16G16R16F);
+        }
+        if (!ok) {
+            ReleaseTargets();
+            return false;
+        }
+        s_width = w;
+        s_height = h;
+        return true;
+    }
+
+    bool EnsureShaders(IDirect3DDevice9* device) {
+        if (s_ps[PS_Count - 1]) return true;
+        if (s_shaderFailed) return false;
+        s_shaderFailed = true;
+
+        HMODULE module = LoadLibraryA("d3dcompiler_47.dll");
+        D3DCompileFn compile = module ? reinterpret_cast<D3DCompileFn>(GetProcAddress(module, "D3DCompile")) : nullptr;
+        if (!compile) {
+            SetInfo("ERROR: d3dcompiler_47.dll not found");
+            return false;
+        }
+        for (int i = 0; i < PS_Count; i++) {
+            ID3DBlob* code = nullptr;
+            ID3DBlob* errors = nullptr;
+            HRESULT hr = compile(kShader, strlen(kShader), "HdBloom", nullptr, nullptr, kEntry[i], "ps_3_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+            if (FAILED(hr) || !code) {
+                char text[256];
+                snprintf(text, sizeof(text), "ERROR: shader %s: %s", kEntry[i], errors ? static_cast<const char*>(errors->GetBufferPointer()) : "unknown");
+                SetInfo(text);
+                if (errors) errors->Release();
+                if (code) code->Release();
+                return false;
+            }
+            if (errors) errors->Release();
+            hr = device->CreatePixelShader(static_cast<const DWORD*>(code->GetBufferPointer()), &s_ps[i]);
+            code->Release();
+            if (FAILED(hr)) {
+                s_ps[i] = nullptr;
+                SetInfo("ERROR: CreatePixelShader failed");
+                return false;
+            }
+        }
+        s_shaderFailed = false;
+        return true;
+    }
+
+    // One full-screen pass into dst. a and b go to c1 and c2.
+    void Pass(IDirect3DDevice9* device, int ps, IDirect3DSurface9* dst, UINT w, UINT h,
+              IDirect3DBaseTexture9* t0, IDirect3DBaseTexture9* t1, IDirect3DBaseTexture9* t2,
+              float a0, float a1, float a2, float a3, float b0 = 0.0f, float b1 = 0.0f, float b2 = 0.0f,
+              const float* cc = nullptr) {
+        device->SetRenderTarget(0, dst); // also sets the viewport to the whole target
+        float c[kConstRegs * 4] = {
+            1.0f / w, 1.0f / h, 0.0f, 0.0f,
+            a0, a1, a2, a3,
+            b0, b1, b2, 0.0f,
+            cc ? cc[0] : 0.0f, cc ? cc[1] : 0.0f, cc ? cc[2] : 0.0f, cc ? cc[3] : 0.0f,
+        };
+        device->SetPixelShader(s_ps[ps]);
+        device->SetPixelShaderConstantF(0, c, kConstRegs);
+        device->SetTexture(0, t0);
+        device->SetTexture(1, t1);
+        device->SetTexture(2, t2);
+        float fw = static_cast<float>(w) - 0.5f;
+        float fh = static_cast<float>(h) - 0.5f;
+        float quad[16] = {
+            -0.5f, -0.5f, 0.0f, 1.0f,
+            fw, -0.5f, 0.0f, 1.0f,
+            -0.5f, fh, 0.0f, 1.0f,
+            fw, fh, 0.0f, 1.0f,
+        };
+        device->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP, 2, quad, 4 * sizeof(float));
+    }
+
+    void Blur2(IDirect3DDevice9* device, Target* t, float spread) {
+        Pass(device, PS_Blur, t[1].surf, t[1].w, t[1].h, t[0].tex, nullptr, nullptr, spread / t[0].w, 0.0f, 0.0f, 0.0f);
+        Pass(device, PS_Blur, t[0].surf, t[0].w, t[0].h, t[1].tex, nullptr, nullptr, 0.0f, spread / t[1].h, 0.0f, 0.0f);
+    }
+
+    void SetSampler(IDirect3DDevice9* device, DWORD stage, D3DTEXTUREFILTERTYPE filter) {
+        device->SetSamplerState(stage, D3DSAMP_MINFILTER, filter);
+        device->SetSamplerState(stage, D3DSAMP_MAGFILTER, filter);
+        device->SetSamplerState(stage, D3DSAMP_MIPFILTER, D3DTEXF_NONE);
+        device->SetSamplerState(stage, D3DSAMP_ADDRESSU, D3DTADDRESS_CLAMP);
+        device->SetSamplerState(stage, D3DSAMP_ADDRESSV, D3DTADDRESS_CLAMP);
+        device->SetSamplerState(stage, D3DSAMP_SRGBTEXTURE, FALSE);
+    }
+
+    // Our draw changed D3D state behind the client's back: make it send everything again.
+    void InvalidateClientState() {
+        CGxDeviceD3d* gx = static_cast<CGxDeviceD3d*>(g_theGxDevicePtr);
+        memset(gx->m_deviceStates, 0xFF, sizeof(gx->m_deviceStates));
+        gx->m_d3dCurrentVertexDecl = nullptr;
+        gx->m_d3dCurrentIndexBuf = nullptr;
+        for (int i = 0; i < 8; i++) gx->m_d3dVertexStreamBuf[i] = nullptr;
+        ShadowConstants& ps = CGxDevice::s_shadowConstants[0];
+        ps.dirtyMin = 0;
+        if (ps.dirtyMax < kConstRegs - 1) ps.dirtyMax = kConstRegs - 1;
+        gx->IRsForceUpdate();
+    }
+}
+
+bool HD::BloomWantsDepth() {
+    RegisterCVars();
+    return s_rays && s_rays->m_intValue;
+}
+
+void HD::BloomWorld() {
+    RegisterCVars();
+    bool bloom = s_bloom && s_bloom->m_intValue;
+    bool rays = s_rays && s_rays->m_intValue;
+    if (!bloom && !rays) {
+        if (s_half.tex) ReleaseTargets();
+        SetInfo("off");
+        return;
+    }
+
+    IDirect3DDevice9* device = Device();
+    if (!device) {
+        SetInfo("ERROR: needs gxApi d3d9");
+        return;
+    }
+    if (device->TestCooperativeLevel() != D3D_OK) {
+        ReleaseTargets();
+        return;
+    }
+    if (!EnsureShaders(device)) return;
+
+    IDirect3DSurface9* target = nullptr;
+    if (FAILED(device->GetRenderTarget(0, &target)) || !target) return;
+    D3DSURFACE_DESC desc;
+    target->GetDesc(&desc);
+    if ((desc.Width != s_width || desc.Height != s_height || !s_half.tex) && !CreateTargets(device, desc.Width, desc.Height)) {
+        target->Release();
+        SetInfo("ERROR: could not create the bloom textures");
+        return;
+    }
+
+    // HD: the sun rays need the world depth and where the sun is (both from HdFog)
+    HD::FogPostFrame post;
+    memset(&post, 0, sizeof(post));
+    int32_t debug = s_debug ? s_debug->m_intValue : 0;
+    bool havePost = HD::FogGetPostFrame(&post);
+    // HD: in the test views the rays are drawn even when the sun is off screen (to see where it is)
+    bool haveRays = rays && havePost && (post.sunVisible > 0.001f || debug > 0);
+
+    if (!bloom && !haveRays) {
+        target->Release();
+        SetInfo("on, rays: no sun on screen");
+        return;
+    }
+
+    D3DVIEWPORT9 viewport;
+    device->GetViewport(&viewport);
+    IDirect3DSurface9* depth = nullptr;
+    device->GetDepthStencilSurface(&depth);
+    // no depth while we draw: the world depth texture is read by the rays
+    device->SetDepthStencilSurface(nullptr);
+
+    device->StretchRect(target, nullptr, s_half.surf, nullptr, D3DTEXF_LINEAR);
+
+    device->SetRenderState(D3DRS_ZENABLE, FALSE);
+    device->SetRenderState(D3DRS_ZWRITEENABLE, FALSE);
+    device->SetRenderState(D3DRS_STENCILENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHATESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+    device->SetRenderState(D3DRS_SEPARATEALPHABLENDENABLE, FALSE);
+    device->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
+    device->SetRenderState(D3DRS_FOGENABLE, FALSE);
+    device->SetRenderState(D3DRS_SCISSORTESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_CLIPPLANEENABLE, 0);
+    device->SetRenderState(D3DRS_SRGBWRITEENABLE, FALSE);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, 0x0F);
+    device->SetVertexShader(nullptr);
+    device->SetFVF(D3DFVF_XYZRHW);
+    for (DWORD i = 0; i < 3; i++) SetSampler(device, i, D3DTEXF_LINEAR);
+
+    float threshold = CVarValue(s_threshold, 0.7f, 1.0f);
+    if (bloom) {
+        float knee = threshold * 0.5f > 0.05f ? threshold * 0.5f : 0.05f;
+        Pass(device, PS_Bright, s_quarter[0].surf, s_quarter[0].w, s_quarter[0].h, s_half.tex, nullptr, nullptr,
+             1.0f / s_half.w, 1.0f / s_half.h, 0.0f, 0.0f, threshold, knee);
+        Blur2(device, s_quarter, 1.0f);
+        Blur2(device, s_quarter, 2.0f);
+        Pass(device, PS_Down, s_eighth[0].surf, s_eighth[0].w, s_eighth[0].h, s_quarter[0].tex, nullptr, nullptr,
+             1.0f / s_quarter[0].w, 1.0f / s_quarter[0].h, 0.0f, 0.0f);
+        Blur2(device, s_eighth, 1.0f);
+        Blur2(device, s_eighth, 2.0f);
+    }
+    if (haveRays) {
+        SetSampler(device, 1, D3DTEXF_POINT);
+        float aspect = static_cast<float>(desc.Width) / static_cast<float>(desc.Height);
+        float depthRange[4] = { post.vpMin, post.vpMax, post.projC2, post.projD2 };
+        Pass(device, PS_RayMask, s_rays2[0].surf, s_rays2[0].w, s_rays2[0].h, s_half.tex, post.depth, nullptr,
+             post.sunU, post.sunV, aspect, 0.6f, 0.5f, post.farClip, 0.0f, depthRange);
+        SetSampler(device, 1, D3DTEXF_LINEAR);
+        Pass(device, PS_Radial, s_rays2[1].surf, s_rays2[1].w, s_rays2[1].h, s_rays2[0].tex, nullptr, nullptr,
+             post.sunU, post.sunV, 0.9f, 0.97f, 1.5f);
+    }
+
+    // Over the world with a screen blend: src + dst * (1 - src). Keep alpha (used by the glow).
+    IDirect3DBaseTexture9* halo = bloom ? s_quarter[0].tex : s_rays2[1].tex;
+    IDirect3DBaseTexture9* wide = bloom ? s_eighth[0].tex : s_rays2[1].tex;
+    IDirect3DBaseTexture9* rayTex = haveRays ? s_rays2[debug == 1 ? 0 : 1].tex : halo;
+    float haloStrength = bloom ? CVarValue(s_strength, 1.0f, 5.0f) : 0.0f;
+    float rayStrength = haveRays ? CVarValue(s_raysStrength, 1.0f, 5.0f) * (debug > 0 ? 1.0f : post.sunVisible) : 0.0f;
+    float aspectRatio = static_cast<float>(desc.Width) / static_cast<float>(desc.Height);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, debug > 0 ? FALSE : TRUE);
+    device->SetRenderState(D3DRS_SRCBLEND, D3DBLEND_ONE);
+    device->SetRenderState(D3DRS_DESTBLEND, D3DBLEND_INVSRCCOLOR);
+    device->SetRenderState(D3DRS_BLENDOP, D3DBLENDOP_ADD);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, D3DCOLORWRITEENABLE_RED | D3DCOLORWRITEENABLE_GREEN | D3DCOLORWRITEENABLE_BLUE);
+    Pass(device, PS_Composite, target, desc.Width, desc.Height, halo, wide, rayTex, haloStrength, rayStrength,
+         static_cast<float>(debug), 0.0f, post.sunU, post.sunV, aspectRatio);
+
+    for (DWORD i = 0; i < 3; i++) device->SetTexture(i, nullptr);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, 0x0F);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+    // HD: the client turns the depth buffer on once at start-up and never again (see HdFog.cpp)
+    device->SetRenderState(D3DRS_ZENABLE, D3DZB_TRUE);
+    device->SetDepthStencilSurface(depth);
+    device->SetViewport(&viewport);
+    if (depth) depth->Release();
+    target->Release();
+    InvalidateClientState();
+
+    char text[256];
+    if (rays && !havePost) snprintf(text, sizeof(text), "on%s, rays: no world depth this frame", bloom ? ", bloom" : "");
+    else if (rays && !haveRays) snprintf(text, sizeof(text), "on%s, rays: no sun on screen", bloom ? ", bloom" : "");
+    else snprintf(text, sizeof(text), "on%s%s", bloom ? ", bloom" : "", haveRays ? ", rays" : "");
+    if (havePost) {
+        size_t len = strlen(text);
+        snprintf(text + len, sizeof(text) - len, " (sun %.2f %.2f, %.2f) %s", post.sunU, post.sunV, post.sunVisible, post.diag);
+    }
+    SetInfo(text);
+}
+
+void HD::BloomReleaseDeviceResources() {
+    ReleaseTargets();
+}
