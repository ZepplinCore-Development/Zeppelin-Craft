+    bool NameHas(const char* name, const char* what) {
+        char low[128];
+        size_t i = 0;
+        for (; name[i] && i + 1 < sizeof(low); i++) low[i] = static_cast<char>(tolower(static_cast<unsigned char>(name[i])));
+        low[i] = 0;
+        return strstr(low, what) != nullptr;
+    }
