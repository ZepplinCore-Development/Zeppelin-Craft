@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// HD: the Cata water's reflection under Vulkan (step B, method 1): the frame's captured opaque world (wxl's draw capture,
+// src/capture/Capture.hpp) drawn again, in colour, from the camera mirrored in the water plane the engine chose
+// (g_gxCataPlane, WoW/Source/WorldClient/HD/HdCataMirror.cpp), into a half-resolution target of its own. The engine
+// widened its culling to the mirror's view, so what the mirror sees above the top of the screen is in the capture.
+//
+// Each draw keeps its own pixel module, textures, constants and blend; its vertex side is the module's shadow variant
+// (tools/bls_tools/shadowgen.py: the clip position re-projected by one push matrix), here clip -> view -> mirrored
+// view -> an oblique projection whose near plane is the water, so nothing under the water is reflected. The winding
+// is reversed. Under the world, the sky (CataSky.frag, from the engine's GxCataSky): the main camera's ray mirrored.
+//
+// Every frame, plane or not, the sky alone is also drawn into a target of its own: Cata's reflection for the water
+// without a mirror (CWorldScene::RenderReflection's second view, mode 0: the sky only).
+//
+// HD: tranche 3. When the engine drew the game's own sky mirrored this frame (GxCataSky::m_tex, a render target of the
+// engine's), that sky is what lies under the mirror and in the sky alone (CataSkyTex.frag); the rings are the fallback.
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include "wxl/VkRenderApi.h"
+
+namespace HD::CataWater {
+class Mirror {
+public:
+    struct Snapshot {
+        uint64_t serial = 0;
+        VkExtent2D extent{};
+        VkImageView color = VK_NULL_HANDLE;   ///< the mirror, SHADER_READ_ONLY_OPTIMAL after the stage; none without a plane
+        VkImage image = VK_NULL_HANDLE;       ///< its image (the material's proxy)
+        VkImageView sky = VK_NULL_HANDLE;     ///< the sky alone, SHADER_READ_ONLY_OPTIMAL; none without GxCataSky
+        VkImage skyImage = VK_NULL_HANDLE;
+        float height = 0;                     ///< the plane it was drawn for
+        float mainToMirror[16]{};             ///< main clip -> mirror clip (row vectors), for the water's lookup
+    };
+    struct Stats {
+        uint64_t frames = 0, drawn = 0, skipped = 0, noPlane = 0, noCapture = 0, skyFrames = 0, skyTexFrames = 0;   // HD: + tranche 3
+        uint32_t lastDrawn = 0, lastCaptured = 0, pipelines = 0, failedPipelines = 0;
+    };
+
+    bool Initialize(const WXL_VkRenderApi* api);
+    void Enable(bool enabled);
+    const Snapshot* Get(uint64_t serial) const;
+    void StopAndDestroy();   ///< after the GPU is idle (CataWaterService.cpp)
+    const char* Error() const { return error_; }
+    const Stats& GetStats() const { return stats_; }
+
+private:
+    struct Slot {
+        void* colorHandle = nullptr;
+        void* depthHandle = nullptr;
+        WXL_VkImageInfo color{}, depth{};
+        VkFramebuffer framebuffer = VK_NULL_HANDLE;
+        void* skyHandle = nullptr;
+        WXL_VkImageInfo sky{};
+        VkFramebuffer skyFramebuffer = VK_NULL_HANDLE;
+        VkExtent2D extent{};
+        uint64_t lastSerial = 0;
+        bool valid = false;
+        Snapshot snapshot;
+    };
+    struct Pipe {
+        uint32_t entry = 0xFFFFFFFFu;
+        VkPipeline pipeline = VK_NULL_HANDLE;
+        VkPipelineLayout layout = VK_NULL_HANDLE;
+        bool bones = false, wind = false, failed = false;
+    };
+
+    static int __cdecl Wanted(void* self);
+    static void __cdecl Run(void* self, const WXL_VkStageContext* ctx);
+    void Record(const WXL_VkStageContext& ctx);
+    bool Targets(Slot& slot, VkExtent2D extent);
+    void Retire(Slot& slot);
+    const Pipe* PipeFor(uint32_t entry);
+    bool Matrix(const WXL_VkSceneConstants& scene, float height, float out[16]) const;
+    struct SkyPush {
+        float rayX[4], rayY[4], rayO[4];
+        float sinElevation[8];
+        uint32_t color[8];
+    };
+    bool SkyConstants(const WXL_VkSceneConstants& scene, VkExtent2D extent, SkyPush& out) const;
+    bool SkyPipelines();
+    void DrawSky(VkCommandBuffer cmd, VkPipeline pipeline, const SkyPush& push);
+    // HD: tranche 3, the engine's mirrored sky.
+    bool SkyTexPipelines(const VkGraphicsPipelineCreateInfo& base);
+    void DrawSkyTex(VkCommandBuffer cmd, VkPipeline pipeline, VkDescriptorSet set, VkExtent2D extent);
+
+    const WXL_VkRenderApi* api_ = nullptr;
+    WXL_VkDeviceInfo device_{};
+    void* registration_ = nullptr;
+    bool enabled_ = false;
+    const char* error_ = "";
+    std::vector<Slot> slots_;
+    std::vector<Pipe> pipes_;   ///< open addressing by entry
+    VkRenderPass pass_ = VK_NULL_HANDLE;
+    VkRenderPass skyPass_ = VK_NULL_HANDLE;           ///< the sky alone: colour only
+    VkShaderModule skyVert_ = VK_NULL_HANDLE, skyFrag_ = VK_NULL_HANDLE;
+    VkPipelineLayout skyLayout_ = VK_NULL_HANDLE;
+    VkPipeline skyUnder_ = VK_NULL_HANDLE;            ///< in pass_, under the mirrored world
+    VkPipeline skyAlone_ = VK_NULL_HANDLE;            ///< in skyPass_
+    // HD: tranche 3, the same two from the engine's render of the sky (one sampler set per frame slot).
+    VkShaderModule skyTexFrag_ = VK_NULL_HANDLE;
+    VkDescriptorSetLayout skyTexSetLayout_ = VK_NULL_HANDLE;
+    VkPipelineLayout skyTexLayout_ = VK_NULL_HANDLE;
+    VkPipeline skyTexUnder_ = VK_NULL_HANDLE, skyTexAlone_ = VK_NULL_HANDLE;
+    VkDescriptorPool skyTexPool_ = VK_NULL_HANDLE;
+    VkSampler skyTexSampler_ = VK_NULL_HANDLE;
+    std::vector<VkDescriptorSet> skyTexSets_;
+    Stats stats_;
+};
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/CataRipples.cpp b/Engine/Source/Gx/CGxDeviceVulkan/hd/CataRipples.cpp
new file mode 100644
index 00000000..703d4515
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/CataRipples.cpp
@@ -0,0 +1,703 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// HD: the Cata water's dynamic displacement map, tranche 2 (see CataRipples.h). A BeforeLiquids stage with its own
+// render passes, outside the world pass (as CataMirror.cpp). Every map is left in SHADER_READ_ONLY_OPTIMAL between
+// passes; the passes' dependencies order a step's reads after the one before it and the water's reads after both.
+#include "CataRipples.h"
+
+#include <cmath>
+#include <cstring>
+
+#include "Engine/Source/Gx/GxSeam.h"
+#include "draw/Proxy.hpp"
+#include "vulkan/Context.hpp"
+#include "vulkan/Pipelines.hpp"
+#include "wxl/Script.hpp"
+#include "shaders/CataRippleFull.vert.spv.h"
+#include "shaders/CataRippleMesh.frag.spv.h"
+#include "shaders/CataRipplePerturb.frag.spv.h"
+#include "shaders/CataRipplePerturb.vert.spv.h"
+#include "shaders/CataRipplePropagate.frag.spv.h"
+
+namespace HD::CataWater {
+namespace {
+namespace context = wxlvk::vk::context;
+namespace pipelines = wxlvk::vk::pipelines;
+
+constexpr VkFormat kMapFormat = VK_FORMAT_R16G16_SFLOAT;      // Cata GxTex_Gr1616F
+constexpr VkFormat kTextureFormat = VK_FORMAT_R8G8B8A8_UNORM;
+constexpr float kDisplSize = 128.0f;                         // CWorldScene::Render: SetDisplMapInfo(s_playerPos, 128 x 128)
+constexpr float kDisplMapScale[2] = {1.0f, 1.0f};            // s_displMapScale
+constexpr float kPerturbAmplitudeScale[2] = {1.25f, 0.25f};  // s_perturbAmplitudeScale
+constexpr uint32_t kProxySlot = 5;                           // draw/Proxy.hpp: 0..4 the bridge's
+constexpr uint32_t kMaxPerturbations = 256;                  // Liquid::CreatePerturbator / AddPerturbation
+
+struct Op {
+    enum Kind { Perturb, Propagate } kind;
+    uint32_t map, image, source;
+    uint32_t quadFirst, quadCount, meshFirst, meshCount;
+    float offset[2];
+};
+
+// Cata's height of a perturbation: amplitude scaled for its map, clamped, and for a kept one, its period's sine.
+float Height(float amplitude, uint32_t period, uint32_t map, uint32_t elapsed) {
+    float z = kPerturbAmplitudeScale[map] * amplitude;
+    if (z < -1.0f) z = -1.0f;
+    else if (z >= 1.0f) z = 1.0f;
+    if (period) z = static_cast<float>(std::sin(static_cast<double>(elapsed % period) * 6.2831855f / static_cast<double>(period))) * z;
+    return z;
+}
+}
+
+bool Ripples::Initialize(const WXL_VkRenderApi* api) {
+    const context::Handles* h = context::Get();
+    if (api_ || !api || !api->GetDeviceInfo || !api->CreateImage || !api->RetireImage || !api->CreateBuffer ||
+        !api->RetireBuffer || !api->FlushBuffer || !api->RegisterStage || !api->UnregisterStage || !h || !h->dapi) {
+        error_ = "ripples: API missing, or already initialized";
+        return false;
+    }
+    device_.structSize = sizeof device_;
+    if (!api->GetDeviceInfo(&device_) || !device_.device || !device_.frameSlots || device_.frameSlots > 8 ||
+        !device_.getInstanceProcAddr || !device_.physicalDevice) {
+        error_ = "ripples: device unavailable";
+        return false;
+    }
+    auto formats = reinterpret_cast<PFN_vkGetPhysicalDeviceFormatProperties>(
+        device_.getInstanceProcAddr(device_.instance, "vkGetPhysicalDeviceFormatProperties"));
+    VkFormatProperties caps = {};
+    if (formats) formats(device_.physicalDevice, kMapFormat, &caps);
+    const VkFormatFeatureFlags need = VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT | VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BLEND_BIT |
+                                      VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+    if ((caps.optimalTilingFeatures & need) != need) {
+        error_ = "ripples: RG16F maps unsupported";
+        return false;
+    }
+    api_ = api;
+    const wxlvk::vk::loader::Device& d = *h->dapi;
+
+    // Two passes over one RG16F map: LOAD (a perturbation adds to it; a propagation overwrites it) and CLEAR.
+    VkAttachmentDescription att = {};
+    att.format = kMapFormat;
+    att.samples = VK_SAMPLE_COUNT_1_BIT;
+    att.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+    att.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    att.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    att.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    att.initialLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    att.finalLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    VkAttachmentReference ref{0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+    VkSubpassDescription sub = {};
+    sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    sub.colorAttachmentCount = 1;
+    sub.pColorAttachments = &ref;
+    VkSubpassDependency dep[2] = {};
+    // Before: the earlier passes' writes (this map's, or the source's) and the reads of this map (the water last
+    // frame, a propagation) are done.
+    dep[0].srcSubpass = VK_SUBPASS_EXTERNAL;
+    dep[0].dstSubpass = 0;
+    dep[0].srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
+    dep[0].dstStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
+    dep[0].srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    dep[0].dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+    // After: the next pass's fragments and the water's read it.
+    dep[1].srcSubpass = 0;
+    dep[1].dstSubpass = VK_SUBPASS_EXTERNAL;
+    dep[1].srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+    dep[1].dstStageMask = VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+    dep[1].srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    dep[1].dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    VkRenderPassCreateInfo rp = {};
+    rp.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+    rp.attachmentCount = 1;
+    rp.pAttachments = &att;
+    rp.subpassCount = 1;
+    rp.pSubpasses = &sub;
+    rp.dependencyCount = 2;
+    rp.pDependencies = dep;
+    if (d.CreateRenderPass(device_.device, &rp, nullptr, &load_) != VK_SUCCESS) load_ = VK_NULL_HANDLE;
+    att.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+    att.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (d.CreateRenderPass(device_.device, &rp, nullptr, &clear_) != VK_SUCCESS) clear_ = VK_NULL_HANDLE;
+    if (!load_ || !clear_ || !Pipelines()) {
+        StopAndDestroy();
+        error_ = "ripples: passes or pipelines failed";
+        return false;
+    }
+    streams_.assign(device_.frameSlots, Stream());
+
+    WXL_VkStageDesc stage{};
+    stage.structSize = sizeof stage;
+    stage.user = this;
+    stage.point = WXL_VK_POINT_BEFORE_LIQUIDS;
+    stage.order = 9000;    // its own passes: no tie with the scene copy (10000) or the mirror (10010)
+    stage.flags = 0;
+    stage.Wanted = Wanted;
+    stage.Run = Run;
+    registration_ = api_->RegisterStage(&stage, "CataWater.Ripples");
+    if (!registration_) {
+        StopAndDestroy();
+        error_ = "ripples: BeforeLiquids stage refused";
+        return false;
+    }
+    error_ = "";
+    return true;
+}
+
+bool Ripples::Pipelines() {
+    const wxlvk::vk::loader::Device& d = *context::Get()->dapi;
+    const struct { const uint32_t* code; size_t size; } spv[5] = {
+        {kCataRippleFullVertSpv, sizeof kCataRippleFullVertSpv}, {kCataRipplePropagateSpv, sizeof kCataRipplePropagateSpv},
+        {kCataRipplePerturbVertSpv, sizeof kCataRipplePerturbVertSpv}, {kCataRipplePerturbSpv, sizeof kCataRipplePerturbSpv},
+        {kCataRippleMeshSpv, sizeof kCataRippleMeshSpv}};
+    for (uint32_t i = 0; i < 5; ++i) {
+        VkShaderModuleCreateInfo module = {};
+        module.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+        module.codeSize = spv[i].size;
+        module.pCode = spv[i].code;
+        if (d.CreateShaderModule(device_.device, &module, nullptr, &modules_[i]) != VK_SUCCESS) return false;
+    }
+    VkDescriptorSetLayoutBinding binding = {};
+    binding.binding = 0;
+    binding.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    binding.descriptorCount = 1;
+    binding.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+    VkDescriptorSetLayoutCreateInfo setLayout = {};
+    setLayout.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+    setLayout.bindingCount = 1;
+    setLayout.pBindings = &binding;
+    if (d.CreateDescriptorSetLayout(device_.device, &setLayout, nullptr, &setLayout_) != VK_SUCCESS) return false;
+    VkPushConstantRange range = {VK_SHADER_STAGE_FRAGMENT_BIT, 0, 16};
+    VkPipelineLayoutCreateInfo layout = {};
+    layout.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    layout.setLayoutCount = 1;
+    layout.pSetLayouts = &setLayout_;
+    layout.pushConstantRangeCount = 1;
+    layout.pPushConstantRanges = &range;
+    if (d.CreatePipelineLayout(device_.device, &layout, nullptr, &layout_) != VK_SUCCESS) return false;
+
+    // The samplers: the propagation reads texel centres (nearest), perturbTex is Cata's GxTex_LinearMipNearest.
+    VkSamplerCreateInfo sampler = {};
+    sampler.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
+    sampler.magFilter = sampler.minFilter = VK_FILTER_NEAREST;
+    sampler.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    sampler.addressModeU = sampler.addressModeV = sampler.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    sampler.maxLod = 0.0f;
+    if (d.CreateSampler(device_.device, &sampler, nullptr, &point_) != VK_SUCCESS) return false;
+    sampler.magFilter = sampler.minFilter = VK_FILTER_LINEAR;
+    sampler.maxLod = 16.0f;
+    if (d.CreateSampler(device_.device, &sampler, nullptr, &linear_) != VK_SUCCESS) return false;
+    VkDescriptorPoolSize size = {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 2 * kMaps + 1};
+    VkDescriptorPoolCreateInfo pool = {};
+    pool.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+    pool.maxSets = 2 * kMaps + 1;
+    pool.poolSizeCount = 1;
+    pool.pPoolSizes = &size;
+    if (d.CreateDescriptorPool(device_.device, &pool, nullptr, &pool_) != VK_SUCCESS) return false;
+    VkDescriptorSetLayout layouts[2 * kMaps + 1];
+    VkDescriptorSet sets[2 * kMaps + 1];
+    for (auto& l : layouts) l = setLayout_;
+    VkDescriptorSetAllocateInfo allocate = {};
+    allocate.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+    allocate.descriptorPool = pool_;
+    allocate.descriptorSetCount = 2 * kMaps + 1;
+    allocate.pSetLayouts = layouts;
+    if (d.AllocateDescriptorSets(device_.device, &allocate, sets) != VK_SUCCESS) return false;
+    for (uint32_t i = 0; i < 2 * kMaps; ++i) images_[i].source = sets[i];
+    textureSet_ = sets[2 * kMaps];
+
+    VkPipelineShaderStageCreateInfo stages[2] = {};
+    stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+    stages[0].pName = "main";
+    stages[1] = stages[0];
+    stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+    VkVertexInputBindingDescription vertexBinding = {0, sizeof(Vertex), VK_VERTEX_INPUT_RATE_VERTEX};
+    VkVertexInputAttributeDescription attributes[2] = {{0, 0, VK_FORMAT_R32G32B32_SFLOAT, 0},
+                                                       {1, 0, VK_FORMAT_R32G32_SFLOAT, 3 * sizeof(float)}};
+    VkPipelineVertexInputStateCreateInfo none = {};
+    none.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
+    VkPipelineVertexInputStateCreateInfo vertices = none;
+    vertices.vertexBindingDescriptionCount = 1;
+    vertices.pVertexBindingDescriptions = &vertexBinding;
+    vertices.vertexAttributeDescriptionCount = 2;
+    vertices.pVertexAttributeDescriptions = attributes;
+    VkPipelineInputAssemblyStateCreateInfo assembly = {};
+    assembly.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+    assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkPipelineViewportStateCreateInfo viewport = {};
+    viewport.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+    viewport.viewportCount = 1;
+    viewport.scissorCount = 1;
+    VkPipelineRasterizationStateCreateInfo raster = {};
+    raster.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+    raster.polygonMode = VK_POLYGON_MODE_FILL;
+    raster.cullMode = VK_CULL_MODE_NONE;   // Cata: GxRs_Culling 0
+    raster.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    raster.lineWidth = 1.0f;
+    VkPipelineMultisampleStateCreateInfo multisample = {};
+    multisample.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+    multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineColorBlendAttachmentState attachment = {};
+    attachment.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT;
+    VkPipelineColorBlendStateCreateInfo blend = {};
+    blend.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+    blend.attachmentCount = 1;
+    blend.pAttachments = &attachment;
+    const VkDynamicState dynamics[2] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+    VkPipelineDynamicStateCreateInfo dynamic = {};
+    dynamic.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+    dynamic.dynamicStateCount = 2;
+    dynamic.pDynamicStates = dynamics;
+    VkGraphicsPipelineCreateInfo info = {};
+    info.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+    info.stageCount = 2;
+    info.pStages = stages;
+    info.pInputAssemblyState = &assembly;
+    info.pViewportState = &viewport;
+    info.pRasterizationState = &raster;
+    info.pMultisampleState = &multisample;
+    info.pColorBlendState = &blend;
+    info.pDynamicState = &dynamic;
+    info.layout = layout_;
+    info.renderPass = load_;
+    info.basePipelineIndex = -1;
+
+    // The propagation: a full-map triangle, written as it is.
+    stages[0].module = modules_[0];
+    stages[1].module = modules_[1];
+    info.pVertexInputState = &none;
+    if (d.CreateGraphicsPipelines(device_.device, pipelines::PipelineCache(), 1, &info, nullptr, &propagate_) != VK_SUCCESS) {
+        propagate_ = VK_NULL_HANDLE;
+        return false;
+    }
+    // The perturbations: added (Cata GxRs_BlendingMode 3 with an alpha of 1).
+    attachment.blendEnable = VK_TRUE;
+    attachment.srcColorBlendFactor = VK_BLEND_FACTOR_ONE;
+    attachment.dstColorBlendFactor = VK_BLEND_FACTOR_ONE;
+    attachment.colorBlendOp = VK_BLEND_OP_ADD;
+    attachment.srcAlphaBlendFactor = VK_BLEND_FACTOR_ONE;
+    attachment.dstAlphaBlendFactor = VK_BLEND_FACTOR_ONE;
+    attachment.alphaBlendOp = VK_BLEND_OP_ADD;
+    info.pVertexInputState = &vertices;
+    stages[0].module = modules_[2];
+    stages[1].module = modules_[3];
+    if (d.CreateGraphicsPipelines(device_.device, pipelines::PipelineCache(), 1, &info, nullptr, &perturb_) != VK_SUCCESS) {
+        perturb_ = VK_NULL_HANDLE;
+        return false;
+    }
+    stages[1].module = modules_[4];
+    if (d.CreateGraphicsPipelines(device_.device, pipelines::PipelineCache(), 1, &info, nullptr, &mesh_) != VK_SUCCESS) {
+        mesh_ = VK_NULL_HANDLE;
+        return false;
+    }
+    return true;
+}
+
+bool Ripples::Maps() {
+    if (images_[0].framebuffer) return true;
+    const context::Handles* h = context::Get();
+    if (!h || !h->dapi) return false;
+    const wxlvk::vk::loader::Device& d = *h->dapi;
+    for (uint32_t i = 0; i < 2 * kMaps; ++i) {
+        Image& image = images_[i];
+        WXL_VkImageDesc desc{};
+        desc.format = kMapFormat;
+        desc.width = desc.height = kTexSize;
+        desc.mipLevels = 1;
+        desc.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+        desc.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+        image.handle = api_->CreateImage(&desc, &image.info);
+        VkFramebufferCreateInfo fb = {};
+        fb.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
+        fb.renderPass = load_;   // compatible with clear_: same attachment
+        fb.attachmentCount = 1;
+        fb.pAttachments = &image.info.view;
+        fb.width = fb.height = kTexSize;
+        fb.layers = 1;
+        if (!image.handle || d.CreateFramebuffer(device_.device, &fb, nullptr, &image.framebuffer) != VK_SUCCESS) {
+            image.framebuffer = VK_NULL_HANDLE;
+            Retire(0);
+            error_ = "ripples: map allocation failed";
+            return false;
+        }
+        VkDescriptorImageInfo source = {point_, image.info.view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+        VkWriteDescriptorSet write = {};
+        write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+        write.dstSet = image.source;
+        write.descriptorCount = 1;
+        write.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+        write.pImageInfo = &source;
+        d.UpdateDescriptorSets(device_.device, 1, &write, 0, nullptr);
+    }
+    dirty_ = true;
+    return true;
+}
+
+// XTextures\Ripples\perturbTex, from the engine's decoded levels: uploaded once.
+bool Ripples::Texture(VkCommandBuffer cmd, uint64_t serial) {
+    if (textureReady_) return true;
+    const GxCataRipples& in = g_gxCataRipples;
+    if (textureHandle_ || !in.m_texels || !in.m_texWidth || !in.m_texHeight || !in.m_texLevels || in.m_texLevels > 16 ||
+        in.m_texWidth > 4096 || in.m_texHeight > 4096) {
+        return false;
+    }
+    const wxlvk::vk::loader::Device& d = *context::Get()->dapi;
+    VkDeviceSize total = 0;
+    VkBufferImageCopy regions[16] = {};
+    for (uint32_t level = 0; level < in.m_texLevels; ++level) {
+        const uint32_t w = in.m_texWidth >> level ? in.m_texWidth >> level : 1;
+        const uint32_t h = in.m_texHeight >> level ? in.m_texHeight >> level : 1;
+        regions[level].bufferOffset = total;
+        regions[level].imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, level, 0, 1};
+        regions[level].imageExtent = {w, h, 1};
+        total += VkDeviceSize(w) * h * 4;
+    }
+    WXL_VkBufferDesc bufferDesc{total, VK_BUFFER_USAGE_TRANSFER_SRC_BIT, WXL_VK_MEMORY_HOST};
+    WXL_VkBufferInfo staging{};
+    void* stagingHandle = api_->CreateBuffer(&bufferDesc, &staging);
+    if (!stagingHandle || !staging.mapped) {
+        if (stagingHandle) api_->RetireBuffer(stagingHandle, 0);
+        return false;
+    }
+    memcpy(staging.mapped, in.m_texels, static_cast<size_t>(total));
+    api_->FlushBuffer(stagingHandle);
+    WXL_VkImageDesc desc{};
+    desc.format = kTextureFormat;
+    desc.width = in.m_texWidth;
+    desc.height = in.m_texHeight;
+    desc.mipLevels = in.m_texLevels;
+    desc.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    desc.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+    textureHandle_ = api_->CreateImage(&desc, &texture_);
+    if (!textureHandle_) {
+        api_->RetireBuffer(stagingHandle, 0);
+        return false;
+    }
+    VkImageMemoryBarrier barrier = {};
+    barrier.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    barrier.srcQueueFamilyIndex = barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.image = texture_.image;
+    barrier.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, in.m_texLevels, 0, 1};
+    barrier.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    barrier.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    d.CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &barrier);
+    d.CmdCopyBufferToImage(cmd, staging.buffer, texture_.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, in.m_texLevels, regions);
+    barrier.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    barrier.newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    d.CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 0, nullptr, 0, nullptr, 1, &barrier);
+    api_->RetireBuffer(stagingHandle, serial);   // freed once this frame is done
+    VkDescriptorImageInfo image = {linear_, texture_.view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+    VkWriteDescriptorSet write = {};
+    write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    write.dstSet = textureSet_;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    write.pImageInfo = &image;
+    d.UpdateDescriptorSets(device_.device, 1, &write, 0, nullptr);
+    textureReady_ = true;
+    wxl::ScriptMgr::Log(WXL_LOG_INFO, "cata water: ripples: perturbTex %ux%u (%u levels) uploaded", in.m_texWidth, in.m_texHeight,
+                        in.m_texLevels);
+    return true;
+}
+
+void Ripples::Enable(bool enabled) {
+    if (!api_) return;
+    if (enabled != enabled_) dirty_ = true;   // a fresh start: Cata clears the maps when they are (re)made
+    enabled_ = enabled;
+    g_gxCataRipples.m_active = enabled ? 1 : 0;
+}
+
+int __cdecl Ripples::Wanted(void* self) {
+    const Ripples* r = static_cast<Ripples*>(self);
+    return r->enabled_ && g_gxCataRipples.m_wanted ? 1 : 0;
+}
+
+void __cdecl Ripples::Run(void* self, const WXL_VkStageContext* ctx) {
+    if (ctx) static_cast<Ripples*>(self)->Record(*ctx);
+}
+
+// Cata Liquid::SetDisplMapInfo: each map centred on the player, its corner snapped to its texels.
+void Ripples::SetDisplMapInfo(const float center[3]) {
+    for (uint32_t i = 0; i < kMaps; ++i) {
+        const float texSize = static_cast<float>(kTexSize);
+        const float width = kDisplSize * kDisplMapScale[i];
+        const float height = kDisplMapScale[i] * kDisplSize;
+        pos_[i][0] = center[0] - width * 0.5f;
+        pos_[i][1] = center[1] - height * 0.5f;
+        pos_[i][2] = center[2];
+        size_[i][0] = width;
+        size_[i][1] = height;
+        pos_[i][0] = std::floor(pos_[i][0] * (texSize / width)) / (texSize / width);
+        pos_[i][1] = std::floor(pos_[i][1] * (texSize / height)) / (texSize / height);
+    }
+}
+
+void Ripples::BeginPass(VkCommandBuffer cmd, uint32_t image, bool clear) {
+    const wxlvk::vk::loader::Device& d = *context::Get()->dapi;
+    VkClearValue zero = {};
+    VkRenderPassBeginInfo begin = {};
+    begin.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+    begin.renderPass = clear ? clear_ : load_;
+    begin.framebuffer = images_[image].framebuffer;
+    begin.renderArea.extent = {kTexSize, kTexSize};
+    begin.clearValueCount = clear ? 1 : 0;
+    begin.pClearValues = clear ? &zero : nullptr;
+    d.CmdBeginRenderPass(cmd, &begin, VK_SUBPASS_CONTENTS_INLINE);
+    VkViewport vp = {0.0f, 0.0f, static_cast<float>(kTexSize), static_cast<float>(kTexSize), 0.0f, 1.0f};
+    const VkRect2D scissor{{0, 0}, {kTexSize, kTexSize}};
+    d.CmdSetViewport(cmd, 0, 1, &vp);
+    d.CmdSetScissor(cmd, 0, 1, &scissor);
+}
+
+// Cata Liquid::ClearDisplMap: every map to 0.
+void Ripples::Clear(VkCommandBuffer cmd) {
+    const wxlvk::vk::loader::Device& d = *context::Get()->dapi;
+    for (uint32_t i = 0; i < 2 * kMaps; ++i) {
+        BeginPass(cmd, i, true);
+        d.CmdEndRenderPass(cmd);
+    }
+}
+
+// Cata Liquid::PerturbDisplMap: each perturbation (x, y, radius, amplitude, period) a quad of perturbTex around its
+// texel, in the map as it lies now (rawPos). In Vulkan's NDC (y down, the map's first row on top as in D3D's), without
+// D3D9's half-texel shift.
+void Ripples::Quads(const float* list, uint32_t count, uint32_t map, uint32_t time, std::vector<Vertex>& out) const {
+    if (!list || !count) return;
+    const float texSize = static_cast<float>(kTexSize);
+    const float texel = 1.0f / texSize;
+    const uint32_t elapsed = time - startTime_;
+    for (uint32_t i = 0; i < count && i < kMaxPerturbations; ++i) {
+        const float* p = list + 5 * i;
+        const float amplitude = p[3];
+        if (!(std::fabs(amplitude) >= 0.001f)) continue;
+        float sizeY = std::floor(texSize * (p[2] / size_[map][1]));
+        sizeY = sizeY >= 0.5f ? sizeY : 0.5f;
+        float sizeX = std::floor(texSize * (p[2] / size_[map][0]));
+        sizeX = sizeX >= 0.5f ? sizeX : 0.5f;
+        sizeX *= texel;
+        sizeY *= texel;
+        float u = (p[0] - rawPos_[map][0]) / size_[map][0];
+        float v = (p[1] - rawPos_[map][1]) / size_[map][1];
+        u = std::floor(texSize * u) * texel;
+        v = std::floor(texSize * v) * texel;
+        if (!std::isfinite(u) || !std::isfinite(v) || u + sizeX < 0.0f || v + sizeY < 0.0f || u - sizeX > 1.0f || v - sizeY > 1.0f) continue;
+        const float z = Height(amplitude, static_cast<uint32_t>(p[4]), map, elapsed);
+        const float x0 = (u - sizeX) * 2.0f - 1.0f, x1 = (u + sizeX) * 2.0f - 1.0f;
+        const float y0 = (v - sizeY) * 2.0f - 1.0f, y1 = (v + sizeY) * 2.0f - 1.0f;
+        const Vertex c[4] = {{x0, y0, z, 0, 0}, {x1, y0, z, 1, 0}, {x0, y1, z, 0, 1}, {x1, y1, z, 1, 1}};
+        const uint32_t order[6] = {0, 2, 1, 1, 2, 3};   // Cata's quadIndices
+        for (uint32_t k : order) out.push_back(c[k]);
+    }
+}
+
+// Cata Liquid::PerturbDisplMapMesh: the ships' hulls (world x, y per triangle corner), their height over the map.
+void Ripples::Meshes(uint32_t map, uint32_t time, std::vector<Vertex>& out) const {
+    const GxCataRipples& in = g_gxCataRipples;
+    if (!in.m_meshes || !in.m_meshVerts || !in.m_meshCount) return;
+    const uint32_t elapsed = time - startTime_;
+    for (uint32_t m = 0; m < in.m_meshCount && m < 16; ++m) {
+        const float* mesh = in.m_meshes + 4 * m;
+        const uint32_t first = static_cast<uint32_t>(mesh[0]), corners = static_cast<uint32_t>(mesh[1]);
+        if (!(std::fabs(mesh[2]) >= 0.001f) || corners % 3 || corners > 3 * 7500) continue;
+        const float z = Height(mesh[2], static_cast<uint32_t>(mesh[3]), map, elapsed);
+        for (uint32_t k = 0; k < corners; ++k) {
+            const float* p = in.m_meshVerts + 2 * (first + k);
+            const float x = ((p[0] - rawPos_[map][0]) / size_[map][0]) * 2.0f - 1.0f;
+            const float y = ((p[1] - rawPos_[map][1]) / size_[map][1]) * 2.0f - 1.0f;
+            out.push_back({x, y, z, 0, 0});
+        }
+    }
+}
+
+void Ripples::Record(const WXL_VkStageContext& ctx) {
+    GxCataRipples& io = g_gxCataRipples;
+    const context::Handles* h = context::Get();
+    if (!enabled_ || !io.m_wanted || ctx.structSize < sizeof ctx || ctx.frameSlot >= streams_.size() || !ctx.cmd || !h || !h->dapi)
+        return;
+    const wxlvk::vk::loader::Device& d = *h->dapi;
+    Stream& stream = streams_[ctx.frameSlot];
+    if (stream.lastSerial > ctx.completedSerial) {
+        error_ = "ripples: slot still in flight";
+        return;
+    }
+    if (!Maps()) return;
+    const bool texture = Texture(ctx.cmd, ctx.serial);
+    const uint32_t time = io.m_time;
+    if (!started_) {
+        started_ = true;
+        startTime_ = time;
+    }
+    SetDisplMapInfo(io.m_center);
+    if (dirty_) {
+        Clear(ctx.cmd);
+        dirty_ = false;
+        for (uint32_t i = 0; i < kMaps; ++i) lastTime_[i] = time - period_[i];
+    }
+
+    // Cata Liquid::UpdateDisplMap, its draws first written down with their vertices (the map moves between steps).
+    std::vector<Vertex> quads, meshes;
+    std::vector<Op> ops;
+    auto perturb = [&](uint32_t map, const float* list, uint32_t count, bool hulls) {
+        Op op = {Op::Perturb, map, current_[map], 0, static_cast<uint32_t>(quads.size()), 0, static_cast<uint32_t>(meshes.size()), 0, {0, 0}};
+        if (texture) Quads(list, count, map, time, quads);
+        if (hulls) Meshes(map, time, meshes);
+        op.quadCount = static_cast<uint32_t>(quads.size()) - op.quadFirst;
+        op.meshCount = static_cast<uint32_t>(meshes.size()) - op.meshFirst;
+        if (op.quadCount || op.meshCount) ops.push_back(op);
+    };
+    // This frame's events (the rain's drops: surface 0), into each map as it is now.
+    perturb(0, io.m_events, io.m_eventCount, false);
+    for (uint32_t i = 0; i < kMaps; ++i) {
+        const uint32_t period = period_[i];
+        const uint32_t elapsed = time - lastTime_[i];
+        const uint32_t steps = elapsed / period;
+        interpolation_[i] = static_cast<float>(elapsed % period) / static_cast<float>(period);
+        if (elapsed < period) continue;
+        uint32_t count;
+        if (steps > 2) {
+            count = 2;
+            lastTime_[i] = time;
+        } else {
+            count = steps;
+            if (steps < 2) lastTime_[i] += steps * period;
+            else lastTime_[i] = time;
+        }
+        while (count--) {
+            // The kept perturbations: the units on surface 0 (map 0), the hulls on surface 1 (map 1).
+            if (i == 0) perturb(0, io.m_units, io.m_unitCount, false);
+            else perturb(1, nullptr, 0, true);
+            // Cata Liquid::PropagateDisplMap: into the map's twin, the previous one read where the map was.
+            const uint32_t previous = current_[i];
+            current_[i] = ((previous - 1) & 1) + 2 * i;
+            float dx = pos_[i][0] - rawPos_[i][0];
+            float dy = pos_[i][1] - rawPos_[i][1];
+            if (dy * dy + dx * dx >= 10000.0f) dx = dy = 0.0f;
+            memcpy(rawPos_[i], pos_[i], sizeof rawPos_[i]);
+            Op op = {Op::Propagate, i, current_[i], previous, 0, 0, 0, 0, {dx / size_[i][0], dy / size_[i][1]}};
+            ops.push_back(op);
+            ++steps_;
+        }
+    }
+
+    // The vertices: this slot's stream buffer, grown when needed.
+    const size_t bytes = (quads.size() + meshes.size()) * sizeof(Vertex);
+    if (bytes) {
+        if (!stream.handle || stream.info.size < bytes) {
+            if (stream.handle) api_->RetireBuffer(stream.handle, stream.lastSerial);
+            stream = Stream();
+            WXL_VkBufferDesc desc{VkDeviceSize(bytes < 65536 ? 65536 : bytes * 2), VK_BUFFER_USAGE_VERTEX_BUFFER_BIT, WXL_VK_MEMORY_STREAM};
+            stream.handle = api_->CreateBuffer(&desc, &stream.info);
+            if (!stream.handle || !stream.info.mapped) {
+                if (stream.handle) api_->RetireBuffer(stream.handle, 0);
+                stream = Stream();
+            }
+        }
+        if (stream.handle) {
+            if (!quads.empty()) memcpy(stream.info.mapped, quads.data(), quads.size() * sizeof(Vertex));
+            if (!meshes.empty())
+                memcpy(static_cast<uint8_t*>(stream.info.mapped) + quads.size() * sizeof(Vertex), meshes.data(), meshes.size() * sizeof(Vertex));
+            api_->FlushBuffer(stream.handle);
+            stream.lastSerial = ctx.serial;
+        }
+    }
+
+    const float texel[2] = {1.0f / kTexSize, 1.0f / kTexSize};
+    for (const Op& op : ops) {
+        if (op.kind == Op::Perturb) {
+            if (!stream.handle) continue;
+            BeginPass(ctx.cmd, op.image, false);
+            const VkDeviceSize offset = 0;
+            d.CmdBindVertexBuffers(ctx.cmd, 0, 1, &stream.info.buffer, &offset);
+            if (op.quadCount) {
+                d.CmdBindPipeline(ctx.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, perturb_);
+                d.CmdBindDescriptorSets(ctx.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, layout_, 0, 1, &textureSet_, 0, nullptr);
+                d.CmdDraw(ctx.cmd, op.quadCount, 1, op.quadFirst, 0);
+            }
+            if (op.meshCount) {
+                d.CmdBindPipeline(ctx.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, mesh_);
+                d.CmdDraw(ctx.cmd, op.meshCount, 1, static_cast<uint32_t>(quads.size()) + op.meshFirst, 0);
+            }
+            d.CmdEndRenderPass(ctx.cmd);
+        } else {
+            BeginPass(ctx.cmd, op.image, false);
+            d.CmdBindPipeline(ctx.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, propagate_);
+            d.CmdBindDescriptorSets(ctx.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, layout_, 0, 1, &images_[op.source].source, 0, nullptr);
+            const float push[4] = {texel[0], texel[1], op.offset[0], op.offset[1]};
+            d.CmdPushConstants(ctx.cmd, layout_, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof push, push);
+            d.CmdDraw(ctx.cmd, 3, 1, 0, 0);
+            d.CmdEndRenderPass(ctx.cmd);
+        }
+    }
+    lastSerial_ = ctx.serial;
+
+    // Where the maps are, for the water (Cata SetDisplacementConstants), and their images on the proxies.
+    namespace proxy = wxlvk::draw::proxy;
+    for (uint32_t i = 0; i < kMaps; ++i) {
+        memcpy(io.m_rawPos[i], rawPos_[i], sizeof rawPos_[i]);
+        io.m_size[i][0] = size_[i][0];
+        io.m_size[i][1] = size_[i][1];
+        io.m_texSize[i] = kTexSize;
+        io.m_interpolation[i] = interpolation_[i];
+        const Image& image = images_[current_[i]];
+        proxy::Set(kProxySlot + i, io.m_proxy[i],
+                   {image.info.image, image.info.view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, kMapFormat, {kTexSize, kTexSize}}, ctx.serial);
+    }
+    io.m_ready = io.m_proxy[0] && io.m_proxy[1] ? 1 : 0;
+}
+
+void Ripples::Retire(uint64_t serial) {
+    const context::Handles* h = context::Get();
+    for (Image& image : images_) {
+        if (image.framebuffer && h && h->dapi) h->dapi->DestroyFramebuffer(device_.device, image.framebuffer, nullptr);
+        if (image.handle) api_->RetireImage(image.handle, serial);
+        const VkDescriptorSet keep = image.source;
+        image = Image();
+        image.source = keep;
+    }
+}
+
+void Ripples::StopAndDestroy() {
+    enabled_ = false;
+    g_gxCataRipples.m_active = 0;
+    g_gxCataRipples.m_ready = 0;
+    if (!api_) return;
+    if (registration_) {
+        api_->UnregisterStage(registration_);
+        registration_ = nullptr;
+    }
+    const context::Handles* h = context::Get();
+    Retire(lastSerial_);
+    for (Stream& s : streams_)
+        if (s.handle) api_->RetireBuffer(s.handle, s.lastSerial);
+    streams_.clear();
+    if (textureHandle_) api_->RetireImage(textureHandle_, lastSerial_);
+    textureHandle_ = nullptr;
+    textureReady_ = false;
+    if (h && h->dapi) {
+        const wxlvk::vk::loader::Device& d = *h->dapi;
+        if (propagate_) d.DestroyPipeline(device_.device, propagate_, nullptr);
+        if (perturb_) d.DestroyPipeline(device_.device, perturb_, nullptr);
+        if (mesh_) d.DestroyPipeline(device_.device, mesh_, nullptr);
+        for (VkShaderModule& m : modules_)
+            if (m) d.DestroyShaderModule(device_.device, m, nullptr);
+        if (layout_) d.DestroyPipelineLayout(device_.device, layout_, nullptr);
+        if (pool_) d.DestroyDescriptorPool(device_.device, pool_, nullptr);
+        if (setLayout_) d.DestroyDescriptorSetLayout(device_.device, setLayout_, nullptr);
+        if (point_) d.DestroySampler(device_.device, point_, nullptr);
+        if (linear_) d.DestroySampler(device_.device, linear_, nullptr);
+        if (load_) d.DestroyRenderPass(device_.device, load_, nullptr);
+        if (clear_) d.DestroyRenderPass(device_.device, clear_, nullptr);
+    }
+    propagate_ = perturb_ = mesh_ = VK_NULL_HANDLE;
+    for (VkShaderModule& m : modules_) m = VK_NULL_HANDLE;
+    layout_ = VK_NULL_HANDLE;
+    pool_ = VK_NULL_HANDLE;
+    setLayout_ = VK_NULL_HANDLE;
+    point_ = linear_ = VK_NULL_HANDLE;
+    load_ = clear_ = VK_NULL_HANDLE;
+    for (Image& image : images_) image = Image();
+    api_ = nullptr;
+}
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/CataRipples.h b/Engine/Source/Gx/CGxDeviceVulkan/hd/CataRipples.h
new file mode 100644
index 00000000..b42d3779
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/CataRipples.h
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// HD: the Cata water's dynamic displacement map under Vulkan (tranche 2): the water that answers the characters,
+// the rain and the moving ships. Cata Liquid::UpdateDisplMap and its passes (WoW/Source/LiquidSystem/
+// LiquidProcTextures.cpp of the 15595 client), at Cata's best ripple detail: two maps of 1024 x 1024 texels (RG16F:
+// x the height now, y the one before), 128 x 128 yards around the player, stepped every 25 and 50 ms. Each step adds
+// the perturbations (perturbTex quads, ship hulls) to the map and propagates it into its twin (a wave equation).
+//
+// A BeforeLiquids stage with its own passes. It reads what the engine gathered (GxCataRipples, GxSeam.h) and says
+// where the maps are; the two maps are handed to the water through proxy textures (slots 5 and 6).
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include "wxl/VkRenderApi.h"
+
+namespace HD::CataWater {
+class Ripples {
+public:
+    bool Initialize(const WXL_VkRenderApi* api);
+    void Enable(bool enabled);
+    void StopAndDestroy();   ///< after the GPU is idle (CataWaterService.cpp)
+    const char* Error() const { return error_; }
+    uint64_t Steps() const { return steps_; }
+
+private:
+    static constexpr uint32_t kMaps = 2;            // Cata GetRippleDetail() > 1
+    static constexpr uint32_t kTexSize = 1024;
+    struct Image {
+        void* handle = nullptr;
+        WXL_VkImageInfo info{};
+        VkFramebuffer framebuffer = VK_NULL_HANDLE;
+        VkDescriptorSet source = VK_NULL_HANDLE;    ///< this image as the propagation's source
+    };
+    struct Stream {
+        void* handle = nullptr;
+        WXL_VkBufferInfo info{};
+        uint64_t lastSerial = 0;
+    };
+    struct Vertex { float x, y, z, u, v; };
+
+    static int __cdecl Wanted(void* self);
+    static void __cdecl Run(void* self, const WXL_VkStageContext* ctx);
+    void Record(const WXL_VkStageContext& ctx);
+    bool Pipelines();
+    bool Maps();
+    bool Texture(VkCommandBuffer cmd, uint64_t serial);
+    void Retire(uint64_t serial);
+    void SetDisplMapInfo(const float center[3]);
+    void Clear(VkCommandBuffer cmd);
+    void Quads(const float* list, uint32_t count, uint32_t map, uint32_t time, std::vector<Vertex>& out) const;
+    void Meshes(uint32_t map, uint32_t time, std::vector<Vertex>& out) const;
+    void Perturb(VkCommandBuffer cmd, uint32_t map, const std::vector<Vertex>& quads, const std::vector<Vertex>& mesh);
+    void Propagate(VkCommandBuffer cmd, uint32_t map);
+    void BeginPass(VkCommandBuffer cmd, uint32_t image, bool clear);
+
+    const WXL_VkRenderApi* api_ = nullptr;
+    WXL_VkDeviceInfo device_{};
+    void* registration_ = nullptr;
+    bool enabled_ = false;
+    const char* error_ = "";
+    VkRenderPass load_ = VK_NULL_HANDLE, clear_ = VK_NULL_HANDLE;
+    VkDescriptorSetLayout setLayout_ = VK_NULL_HANDLE;
+    VkPipelineLayout layout_ = VK_NULL_HANDLE;
+    VkPipeline propagate_ = VK_NULL_HANDLE, perturb_ = VK_NULL_HANDLE, mesh_ = VK_NULL_HANDLE;
+    VkShaderModule modules_[5] = {};
+    VkDescriptorPool pool_ = VK_NULL_HANDLE;
+    VkSampler point_ = VK_NULL_HANDLE, linear_ = VK_NULL_HANDLE;
+    VkDescriptorSet textureSet_ = VK_NULL_HANDLE;
+    Image images_[2 * kMaps];
+    void* textureHandle_ = nullptr;
+    WXL_VkImageInfo texture_{};
+    bool textureReady_ = false;
+    std::vector<Stream> streams_;                   ///< per frame slot: the perturbations' vertices
+    uint64_t lastSerial_ = 0, steps_ = 0;
+
+    // Cata's state (LiquidProcTextures.cpp statics).
+    bool dirty_ = true;                             // Liquid::s_displMapDirty
+    uint32_t current_[kMaps] = {0, 2};              // s_displMapCurrent: the image each map is in
+    uint32_t period_[kMaps] = {25, 50};             // s_displMapPeriod
+    uint32_t lastTime_[kMaps] = {};                 // s_displMapLastTime
+    float interpolation_[kMaps] = {};               // s_displMapInterpolation
+    float pos_[kMaps][3] = {}, rawPos_[kMaps][3] = {};
+    float size_[kMaps][2] = {};
+    bool started_ = false;
+    uint32_t startTime_ = 0;                        // PerturbDisplMap's s_startTime
+};
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/CataSceneCapture.cpp b/Engine/Source/Gx/CGxDeviceVulkan/hd/CataSceneCapture.cpp
new file mode 100644
index 00000000..7bb7f912
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/CataSceneCapture.cpp
@@ -0,0 +1,288 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// HD: from ChatGPT's Cata water kit (2026-10-26), reviewed; owned and enabled by CataWaterService.cpp.
+#include "CataSceneCapture.h"
+#include <array>
+#include <cstddef>
+
+#include "shaders/CataBlur.spv.h"   // HD
+
+namespace HD::CataWater {
+bool SceneCapture::Initialize(const WXL_VkRenderApi* api, const std::vector<uint32_t>& spv) {
+    if (api_ || !api || api->apiVersion != WXL_VK_RENDER_API_VERSION ||
+        api->structSize < offsetof(WXL_VkRenderApi, UnregisterStage) + sizeof(api->UnregisterStage) ||
+        !api->GetDeviceInfo || !api->CreateImage || !api->RetireImage || !api->RegisterStage || !api->UnregisterStage ||
+        spv.size() < 5 || spv.size() > 1024 * 1024 || spv[0] != 0x07230203) {
+        error_ = "capture API/SPIR-V invalid, or service already initialized"; return false;
+    }
+    api_ = api; device_.structSize = sizeof device_;
+    if (!api_->GetDeviceInfo(&device_) || !device_.device || !device_.getDeviceProcAddr || !device_.getInstanceProcAddr ||
+        !device_.frameSlots || device_.frameSlots > 8) {
+        error_ = "capture device unavailable"; api_ = nullptr; return false;
+    }
+#define CATA_LOAD(name) name = reinterpret_cast<PFN_vk##name>(device_.getDeviceProcAddr(device_.device, "vk" #name)); \
+    if (!name) { error_ = "missing vk" #name; api_ = nullptr; return false; }
+    CATA_VK_FUNCTIONS(CATA_LOAD)
+#undef CATA_LOAD
+    auto formats = reinterpret_cast<PFN_vkGetPhysicalDeviceFormatProperties>(
+        device_.getInstanceProcAddr(device_.instance, "vkGetPhysicalDeviceFormatProperties"));
+    if (!formats) { error_ = "format query unavailable"; api_ = nullptr; return false; }
+    for (VkFormat format : {VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_R32_SFLOAT}) {
+        VkFormatProperties caps{}; formats(device_.physicalDevice, format, &caps);
+        auto required = VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+        if ((caps.optimalTilingFeatures & required) != static_cast<VkFormatFeatureFlags>(required)) {
+            error_ = "capture storage/sample format unsupported"; api_ = nullptr; return false;
+        }
+    }
+    auto failed = [&]() { error_ = "capture pipeline/resource creation failed"; StopAndDestroy(0); return false; };
+    std::array<VkDescriptorSetLayoutBinding,4> bindings{};
+    for (uint32_t i = 0; i < 4; ++i) {
+        bindings[i].binding = i; bindings[i].descriptorCount = 1; bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        bindings[i].descriptorType = i == 1 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    }
+    VkDescriptorSetLayoutCreateInfo layout{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    layout.bindingCount = 4; layout.pBindings = bindings.data();
+    if (CreateDescriptorSetLayout(device_.device,&layout,nullptr,&descriptorLayout_) != VK_SUCCESS) return failed();
+    VkPushConstantRange push{VK_SHADER_STAGE_COMPUTE_BIT,0,12};
+    VkPipelineLayoutCreateInfo pl{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    pl.setLayoutCount = 1; pl.pSetLayouts = &descriptorLayout_; pl.pushConstantRangeCount = 1; pl.pPushConstantRanges = &push;
+    if (CreatePipelineLayout(device_.device,&pl,nullptr,&pipelineLayout_) != VK_SUCCESS) return failed();
+    VkShaderModule module = VK_NULL_HANDLE;
+    VkShaderModuleCreateInfo shader{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    shader.codeSize = spv.size() * sizeof(uint32_t); shader.pCode = spv.data();
+    if (CreateShaderModule(device_.device,&shader,nullptr,&module) != VK_SUCCESS) return failed();
+    VkComputePipelineCreateInfo cp{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+    cp.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    cp.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT; cp.stage.module = module; cp.stage.pName = "main"; cp.layout = pipelineLayout_;
+    VkResult result = CreateComputePipelines(device_.device,device_.pipelineCache,1,&cp,nullptr,&pipeline_);
+    DestroyShaderModule(device_.device,module,nullptr);
+    if (result != VK_SUCCESS) return failed();
+    VkSamplerCreateInfo sampler{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+    sampler.magFilter = VK_FILTER_NEAREST; sampler.minFilter = VK_FILTER_NEAREST; sampler.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    sampler.addressModeU = sampler.addressModeV = sampler.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    if (CreateSampler(device_.device,&sampler,nullptr,&sampler_) != VK_SUCCESS) return failed();
+    std::array<VkDescriptorPoolSize,2> sizes{{{VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,3 * device_.frameSlots},
+                                           {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,device_.frameSlots}}};
+    VkDescriptorPoolCreateInfo pool{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    pool.maxSets = device_.frameSlots; pool.poolSizeCount = 2; pool.pPoolSizes = sizes.data();
+    if (CreateDescriptorPool(device_.device,&pool,nullptr,&pool_) != VK_SUCCESS) return failed();
+    slots_.resize(device_.frameSlots);
+    std::vector<VkDescriptorSetLayout> layouts(device_.frameSlots,descriptorLayout_);
+    std::vector<VkDescriptorSet> sets(device_.frameSlots);
+    VkDescriptorSetAllocateInfo allocate{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+    allocate.descriptorPool = pool_; allocate.descriptorSetCount = device_.frameSlots; allocate.pSetLayouts = layouts.data();
+    if (AllocateDescriptorSets(device_.device,&allocate,sets.data()) != VK_SUCCESS) return failed();
+    for (size_t i = 0; i < slots_.size(); ++i) slots_[i].descriptors = sets[i];
+    blurReady_ = BlurPipeline();   // HD: optional, StopAndDestroy frees whatever it made
+    WXL_VkStageDesc stage{}; stage.structSize = sizeof stage; stage.user = this;
+    stage.point = WXL_VK_POINT_BEFORE_LIQUIDS; stage.order = 10000;
+    // The current API supplies colorView only to a color-writing chain. We leave it unchanged;
+    // the redundant CopyOut is documented, not hidden behind an unsupported API flag.
+    stage.flags = WXL_VK_STAGE_NEEDS_DEPTH | WXL_VK_STAGE_WRITES_COLOR; stage.Wanted = Wanted; stage.Run = Run;
+    registration_ = api_->RegisterStage(&stage,"CataWater.SceneCapture");
+    if (!registration_) { failed(); error_ = "BeforeLiquids stage refused; patched device required"; return false; }
+    error_.clear(); return true; // remains disabled until the owner opts in
+}
+// HD: Cata's KawaseBlur pipeline: one combined sampler (the source, linear clamp), one storage image (the target).
+bool SceneCapture::BlurPipeline() {
+    std::array<VkDescriptorSetLayoutBinding,2> bindings{};
+    for (uint32_t i = 0; i < 2; ++i) {
+        bindings[i].binding = i; bindings[i].descriptorCount = 1; bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        bindings[i].descriptorType = i == 0 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    }
+    VkDescriptorSetLayoutCreateInfo layout{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    layout.bindingCount = 2; layout.pBindings = bindings.data();
+    if (CreateDescriptorSetLayout(device_.device,&layout,nullptr,&blurLayout_) != VK_SUCCESS) return false;
+    VkPushConstantRange push{VK_SHADER_STAGE_COMPUTE_BIT,0,20};
+    VkPipelineLayoutCreateInfo pl{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    pl.setLayoutCount = 1; pl.pSetLayouts = &blurLayout_; pl.pushConstantRangeCount = 1; pl.pPushConstantRanges = &push;
+    if (CreatePipelineLayout(device_.device,&pl,nullptr,&blurPipelineLayout_) != VK_SUCCESS) return false;
+    VkShaderModule module = VK_NULL_HANDLE;
+    VkShaderModuleCreateInfo shader{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    shader.codeSize = sizeof kCataBlurSpv; shader.pCode = kCataBlurSpv;
+    if (CreateShaderModule(device_.device,&shader,nullptr,&module) != VK_SUCCESS) return false;
+    VkComputePipelineCreateInfo cp{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+    cp.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    cp.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT; cp.stage.module = module; cp.stage.pName = "main"; cp.layout = blurPipelineLayout_;
+    VkResult result = CreateComputePipelines(device_.device,device_.pipelineCache,1,&cp,nullptr,&blurPipeline_);
+    DestroyShaderModule(device_.device,module,nullptr);
+    if (result != VK_SUCCESS) return false;
+    VkSamplerCreateInfo sampler{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+    sampler.magFilter = VK_FILTER_LINEAR; sampler.minFilter = VK_FILTER_LINEAR; sampler.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    sampler.addressModeU = sampler.addressModeV = sampler.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    if (CreateSampler(device_.device,&sampler,nullptr,&linear_) != VK_SUCCESS) return false;
+    const uint32_t sets = 5 * device_.frameSlots;
+    std::array<VkDescriptorPoolSize,2> sizes{{{VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,sets},{VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,sets}}};
+    VkDescriptorPoolCreateInfo pool{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    pool.maxSets = sets; pool.poolSizeCount = 2; pool.pPoolSizes = sizes.data();
+    if (CreateDescriptorPool(device_.device,&pool,nullptr,&blurPool_) != VK_SUCCESS) return false;
+    std::vector<VkDescriptorSetLayout> layouts(sets,blurLayout_);
+    std::vector<VkDescriptorSet> allocated(sets);
+    VkDescriptorSetAllocateInfo allocate{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+    allocate.descriptorPool = blurPool_; allocate.descriptorSetCount = sets; allocate.pSetLayouts = layouts.data();
+    if (AllocateDescriptorSets(device_.device,&allocate,allocated.data()) != VK_SUCCESS) return false;
+    for (size_t i = 0; i < slots_.size(); ++i)
+        for (size_t p = 0; p < 5; ++p) slots_[i].blurSets[p] = allocated[i * 5 + p];
+    return true;
+}
+// HD: Cata KawaseBlur(scene, 512x512, 0.25): the stretch into the target, then four-tap passes ping-ponged
+// target -> temp -> target ..., each 0.25 texel further out (0, 0.25, 0.5, 0.75). Cata runs a 5th pass that only
+// writes the temp; the target, which the water samples, holds the 4th, so the 5th is left out. The copy is already
+// readable (Barrier(after)).
+bool SceneCapture::Blur(VkCommandBuffer cmd, Slot& slot) {
+    if (!blurReady_ || !slot.blurHandle[0] || !slot.blurHandle[1]) return false;
+    const VkImageView src[5] = {slot.color.view, slot.blur[0].view, slot.blur[1].view, slot.blur[0].view, slot.blur[1].view};
+    std::array<VkDescriptorImageInfo,10> images{};
+    std::array<VkWriteDescriptorSet,10> writes{};
+    for (uint32_t p = 0; p < 5; ++p) {
+        images[2 * p] = {linear_,src[p],VK_IMAGE_LAYOUT_GENERAL};
+        images[2 * p + 1] = {VK_NULL_HANDLE,slot.blur[p == 0 ? 0 : (p & 1)].view,VK_IMAGE_LAYOUT_GENERAL};
+        for (uint32_t b = 0; b < 2; ++b) {
+            auto& w = writes[2 * p + b]; w.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET; w.dstSet = slot.blurSets[p]; w.dstBinding = b;
+            w.descriptorCount = 1; w.pImageInfo = &images[2 * p + b];
+            w.descriptorType = b == 0 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+        }
+    }
+    UpdateDescriptorSets(device_.device,10,writes.data(),0,nullptr);
+    std::array<VkImageMemoryBarrier,2> barriers{};
+    for (size_t i = 0; i < 2; ++i) {
+        auto& b = barriers[i]; b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+        b.oldLayout = slot.blurInitialized ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_UNDEFINED; b.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+        b.image = slot.blur[i].image; b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        b.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT; b.subresourceRange.levelCount = b.subresourceRange.layerCount = 1;
+        b.srcAccessMask = slot.blurInitialized ? VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT : 0;
+        b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    }
+    CmdPipelineBarrier(cmd,slot.blurInitialized ? VK_PIPELINE_STAGE_ALL_COMMANDS_BIT : VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                       VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,0,0,nullptr,0,nullptr,2,barriers.data());
+    CmdBindPipeline(cmd,VK_PIPELINE_BIND_POINT_COMPUTE,blurPipeline_);
+    const float texel = 1.0f / kBlurSize;
+    for (uint32_t p = 0; p < 5; ++p) {
+        if (p) {   // the previous pass's writes, read now; its reads, before this pass overwrites its source's twin
+            VkMemoryBarrier m{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+            m.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT; m.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+            CmdPipelineBarrier(cmd,VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,0,1,&m,0,nullptr,0,nullptr);
+        }
+        CmdBindDescriptorSets(cmd,VK_PIPELINE_BIND_POINT_COMPUTE,blurPipelineLayout_,0,1,&slot.blurSets[p],0,nullptr);
+        struct { float texel[2], offset[2]; uint32_t taps; } push{{texel,texel},{0,0},p == 0 ? 1u : 4u};
+        if (p > 1) push.offset[0] = push.offset[1] = (p - 1) * 0.25f * texel;
+        CmdPushConstants(cmd,blurPipelineLayout_,VK_SHADER_STAGE_COMPUTE_BIT,0,sizeof push,&push);
+        CmdDispatch(cmd,(kBlurSize + 7) / 8,(kBlurSize + 7) / 8,1);
+    }
+    VkMemoryBarrier done{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    done.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT; done.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    CmdPipelineBarrier(cmd,VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                       0,1,&done,0,nullptr,0,nullptr);
+    slot.blurInitialized = true;
+    return true;
+}
+int __cdecl SceneCapture::Wanted(void* self) { return static_cast<SceneCapture*>(self)->enabled_ ? 1 : 0; }
+void __cdecl SceneCapture::Run(void* self, const WXL_VkStageContext* ctx) {
+    if (ctx) static_cast<SceneCapture*>(self)->Record(*ctx);
+}
+void SceneCapture::Retire(Slot& s) {
+    if (s.colorHandle) api_->RetireImage(s.colorHandle,s.lastSerial);
+    if (s.depthHandle) api_->RetireImage(s.depthHandle,s.lastSerial);
+    for (uint32_t i = 0; i < 2; ++i) if (s.blurHandle[i]) api_->RetireImage(s.blurHandle[i],s.lastSerial);   // HD
+    s.blurHandle[0] = s.blurHandle[1] = nullptr; s.blur[0] = s.blur[1] = {}; s.blurInitialized = false;
+    s.colorHandle = s.depthHandle = nullptr; s.color = {}; s.depth = {}; s.extent = {};
+    s.valid = s.initialized = false; s.snapshot = {};
+}
+bool SceneCapture::Targets(Slot& slot, VkExtent2D extent) {
+    if (slot.colorHandle && slot.depthHandle && slot.extent.width == extent.width && slot.extent.height == extent.height) return true;
+    Retire(slot);
+    WXL_VkImageDesc desc{}; desc.width = extent.width; desc.height = extent.height; desc.mipLevels = 1;
+    desc.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT; desc.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+    desc.format = VK_FORMAT_R8G8B8A8_UNORM; slot.colorHandle = api_->CreateImage(&desc,&slot.color);
+    desc.format = VK_FORMAT_R32_SFLOAT; slot.depthHandle = api_->CreateImage(&desc,&slot.depth);
+    if (!slot.colorHandle || !slot.depthHandle) { Retire(slot); error_ = "capture image allocation failed"; return false; }
+    if (blurReady_) {   // HD: the blur's pair; without it the copy stays usable
+        desc.width = desc.height = kBlurSize; desc.format = VK_FORMAT_R8G8B8A8_UNORM;
+        for (uint32_t i = 0; i < 2; ++i) slot.blurHandle[i] = api_->CreateImage(&desc,&slot.blur[i]);
+    }
+    slot.extent = extent; return true;
+}
+void SceneCapture::Barrier(VkCommandBuffer cmd, const Slot& slot, bool before) {
+    std::array<VkImageMemoryBarrier,2> barriers{};
+    for (size_t i = 0; i < barriers.size(); ++i) {
+        auto& b = barriers[i]; b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+        b.oldLayout = before && !slot.initialized ? VK_IMAGE_LAYOUT_UNDEFINED : VK_IMAGE_LAYOUT_GENERAL;
+        b.newLayout = VK_IMAGE_LAYOUT_GENERAL; b.image = i ? slot.depth.image : slot.color.image;
+        b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        b.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT; b.subresourceRange.levelCount = b.subresourceRange.layerCount = 1;
+        b.srcAccessMask = before ? (slot.initialized ? VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT : 0) : VK_ACCESS_SHADER_WRITE_BIT;
+        b.dstAccessMask = before ? VK_ACCESS_SHADER_WRITE_BIT : VK_ACCESS_SHADER_READ_BIT;
+    }
+    VkPipelineStageFlags src = before ? (slot.initialized ? VK_PIPELINE_STAGE_ALL_COMMANDS_BIT : VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT)
+                                      : VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+    VkPipelineStageFlags dst = before ? VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT : VK_PIPELINE_STAGE_VERTEX_SHADER_BIT |
+        VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+    CmdPipelineBarrier(cmd,src,dst,0,0,nullptr,0,nullptr,2,barriers.data());
+}
+void SceneCapture::Record(const WXL_VkStageContext& ctx) {
+    if (!enabled_ || ctx.structSize < sizeof ctx || ctx.frameSlot >= slots_.size() || ctx.frameSlots != slots_.size() ||
+        ctx.point != WXL_VK_POINT_BEFORE_LIQUIDS || !ctx.serial || !ctx.sceneValid || !ctx.scene || !ctx.cmd ||
+        !ctx.colorView || !ctx.depthView || ctx.colorFormat != VK_FORMAT_R8G8B8A8_UNORM ||
+        !ctx.extent.width || !ctx.extent.height || ctx.extent.width > 16384 || ctx.extent.height > 16384) {
+        error_ = "capture frame inputs incomplete"; return;
+    }
+    Slot& slot = slots_[ctx.frameSlot]; slot.valid = false;
+    if (slot.lastSerial > ctx.completedSerial) { error_ = "capture slot is still in flight"; return; }
+    if (!Targets(slot,ctx.extent)) return;
+    std::array<VkDescriptorImageInfo,4> images{{
+        {VK_NULL_HANDLE,ctx.colorView,ctx.colorLayout}, {sampler_,ctx.depthView,ctx.depthLayout},
+        {VK_NULL_HANDLE,slot.color.view,VK_IMAGE_LAYOUT_GENERAL}, {VK_NULL_HANDLE,slot.depth.view,VK_IMAGE_LAYOUT_GENERAL}}};
+    std::array<VkWriteDescriptorSet,4> writes{};
+    for (uint32_t i = 0; i < 4; ++i) {
+        auto& w = writes[i]; w.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET; w.dstSet = slot.descriptors; w.dstBinding = i;
+        w.descriptorCount = 1; w.descriptorType = i == 1 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+        w.pImageInfo = &images[i];
+    }
+    UpdateDescriptorSets(device_.device,4,writes.data(),0,nullptr);
+    Barrier(ctx.cmd,slot,true);
+    CmdBindPipeline(ctx.cmd,VK_PIPELINE_BIND_POINT_COMPUTE,pipeline_);
+    CmdBindDescriptorSets(ctx.cmd,VK_PIPELINE_BIND_POINT_COMPUTE,pipelineLayout_,0,1,&slot.descriptors,0,nullptr);
+    const uint32_t push[3] = {ctx.extent.width,ctx.extent.height,ctx.swapRB};
+    CmdPushConstants(ctx.cmd,pipelineLayout_,VK_SHADER_STAGE_COMPUTE_BIT,0,sizeof push,push);
+    CmdDispatch(ctx.cmd,(ctx.extent.width + 7) / 8,(ctx.extent.height + 7) / 8,1);
+    Barrier(ctx.cmd,slot,false);
+    const bool blurred = Blur(ctx.cmd,slot);   // HD
+    slot.snapshot.blurred = blurred ? slot.blur[0].view : VK_NULL_HANDLE;
+    slot.snapshot.blurredImage = blurred ? slot.blur[0].image : VK_NULL_HANDLE;
+    slot.initialized = slot.valid = true; slot.lastSerial = lastSerial_ = ctx.serial;
+    slot.snapshot.serial = ctx.serial; slot.snapshot.extent = ctx.extent;
+    slot.snapshot.color = slot.color.view; slot.snapshot.rawDepth = slot.depth.view;
+    slot.snapshot.colorImage = slot.color.image; slot.snapshot.rawDepthImage = slot.depth.image;   // HD: step C
+    slot.snapshot.scene = *ctx.scene; slot.snapshot.viewport = ctx.viewport;
+    slot.snapshot.jitter[0] = ctx.jitter[0]; slot.snapshot.jitter[1] = ctx.jitter[1];
+    error_.clear();
+}
+const SceneCapture::Snapshot* SceneCapture::Get(uint64_t serial, VkExtent2D extent) const {
+    if (!enabled_) return nullptr;
+    for (const auto& slot : slots_) if (slot.valid && slot.snapshot.serial == serial &&
+        slot.extent.width == extent.width && slot.extent.height == extent.height) return &slot.snapshot;
+    return nullptr;
+}
+bool SceneCapture::StopAndDestroy(uint64_t completed) {
+    enabled_ = false;
+    if (!api_) return true;
+    if (registration_) { api_->UnregisterStage(registration_); registration_ = nullptr; }
+    if (completed < lastSerial_) { error_ = "capture shutdown pending GPU serial completion"; return false; }
+    for (auto& slot : slots_) Retire(slot);
+    if (pool_) DestroyDescriptorPool(device_.device,pool_,nullptr);
+    if (sampler_) DestroySampler(device_.device,sampler_,nullptr);
+    if (pipeline_) DestroyPipeline(device_.device,pipeline_,nullptr);
+    if (pipelineLayout_) DestroyPipelineLayout(device_.device,pipelineLayout_,nullptr);
+    if (descriptorLayout_) DestroyDescriptorSetLayout(device_.device,descriptorLayout_,nullptr);
+    if (blurPool_) DestroyDescriptorPool(device_.device,blurPool_,nullptr);   // HD: the blur
+    if (linear_) DestroySampler(device_.device,linear_,nullptr);
+    if (blurPipeline_) DestroyPipeline(device_.device,blurPipeline_,nullptr);
+    if (blurPipelineLayout_) DestroyPipelineLayout(device_.device,blurPipelineLayout_,nullptr);
+    if (blurLayout_) DestroyDescriptorSetLayout(device_.device,blurLayout_,nullptr);
+    blurPool_ = VK_NULL_HANDLE; linear_ = VK_NULL_HANDLE; blurPipeline_ = VK_NULL_HANDLE;
+    blurPipelineLayout_ = VK_NULL_HANDLE; blurLayout_ = VK_NULL_HANDLE; blurReady_ = false;
+    pool_ = VK_NULL_HANDLE; sampler_ = VK_NULL_HANDLE; pipeline_ = VK_NULL_HANDLE;
+    pipelineLayout_ = VK_NULL_HANDLE; descriptorLayout_ = VK_NULL_HANDLE;
+    slots_.clear(); api_ = nullptr; device_ = {}; lastSerial_ = 0;
+    return true;
+}
+}
