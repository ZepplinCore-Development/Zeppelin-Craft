+    void GetStats(Stats& out)
+    {
+        out = s.stats;
+        out.pipelines           = s.pipelineCount - s.failedCount;
+        out.translatedPipelines = s.translatedCount;
+        out.companionPipelines  = s.companionCount;
+        out.samplers            = s.samplerCount;
+        out.layouts             = s.layoutCount;
+    }
