+    // Our code index for vertex slot p (0..89): unlit ignores the light count, light counts 5..14 repeat 0..4
+    // (Blizzard's slots hold identical bytecode there, checked by test_wmo_vs.py).
+    int32_t VertexCode(int32_t p) {
+        int32_t lit = p & 1;
+        int32_t shadow = p / 30;
+        int32_t lights = ((p >> 1) % 15) % 5;
+        return lit ? 3 + 5 * shadow + lights : shadow;
+    }
+
+    void SetMacro(D3D_SHADER_MACRO* macros, int32_t i, const char* name, int32_t value, char (*values)[4]) {
+        snprintf(values[i], 4, "%d", value);
+        macros[i].Name = name;
+        macros[i].Definition = values[i];
+    }
+
+    bool Compile(D3DCompileFn compile, const char* source, const char* name, const D3D_SHADER_MACRO* macros, const char* profile, std::vector<uint8_t>& out, const char* what, int32_t index) {
+        ID3DBlob* code = nullptr;
+        ID3DBlob* errors = nullptr;
+        HRESULT hr = compile(source, strlen(source), name, macros, nullptr, "main", profile, D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+        if (FAILED(hr) || !code) {
+            snprintf(s_threadInfo, sizeof(s_threadInfo), "ERROR: %s %d: %s", what, index, errors ? static_cast<const char*>(errors->GetBufferPointer()) : "unknown");
+            if (errors) errors->Release();
+            if (code) code->Release();
+            return false;
+        }
+        if (errors) errors->Release();
+        const uint8_t* bytes = static_cast<const uint8_t*>(code->GetBufferPointer());
+        out.assign(bytes, bytes + code->GetBufferSize());
+        code->Release();
+        return true;
+    }
+
+    // Compile thread: every permutation, all or nothing.
+    void CompileAll() {
+        ULONGLONG start = GetTickCount64();
+        HMODULE module = LoadLibraryA("d3dcompiler_47.dll");
+        D3DCompileFn compile = module ? reinterpret_cast<D3DCompileFn>(GetProcAddress(module, "D3DCompile")) : nullptr;
+        if (!compile) {
+            snprintf(s_threadInfo, sizeof(s_threadInfo), "ERROR: d3dcompiler_47.dll not found, Blizzard shaders kept");
+            s_state.store(StateFailed);
+            return;
+        }
+        int32_t total = 0;
+        for (int32_t family = 0; family < 7; family++) {
+            const VertexFamily& f = kVertexFamilies[family];
+            for (int32_t c = 0; c < kVertexCodes; c++) {
+                int32_t lit = c >= 3;
+                int32_t shadow = lit ? (c - 3) / 5 : c;
+                int32_t lights = lit ? (c - 3) % 5 : 0;
+                D3D_SHADER_MACRO macros[8];
+                char values[7][4];
+                SetMacro(macros, 0, "UNIFIED", f.unified, values);
+                SetMacro(macros, 1, "REFL", f.refl, values);
+                SetMacro(macros, 2, "SPECULAR", f.specular, values);
+                SetMacro(macros, 3, "COMP", f.comp, values);
+                SetMacro(macros, 4, "LIT", lit, values);
+                SetMacro(macros, 5, "LIGHTS", lights, values);
+                SetMacro(macros, 6, "SHADOW", shadow, values);
+                macros[7].Name = nullptr;
+                macros[7].Definition = nullptr;
+                if (!Compile(compile, kVertexShader, "HdMapObjVS", macros, "vs_3_0", s_vertexCode[family][c], f.name, c)) {
+                    s_state.store(StateFailed);
+                    return;
+                }
+                HD::ShaderDump("HdMapObj", false, family, c, &s_vertexCode[family][c][0], s_vertexCode[family][c].size()); // HD
+                total++;
+            }
+        }
+        for (int32_t kind = 0; kind < kPixelKinds; kind++) {
+            for (int32_t p = 0; p < 16; p++) {
+                D3D_SHADER_MACRO macros[5];
+                char values[4][4];
+                SetMacro(macros, 0, "KIND", kind, values);
+                SetMacro(macros, 1, "SHADOW", p & 3, values);
+                SetMacro(macros, 2, "PCF", (p >> 2) & 1, values);
+                SetMacro(macros, 3, "ALPHA_TEST", p >> 3, values);
+                macros[4].Name = nullptr;
+                macros[4].Definition = nullptr;
+                if (!Compile(compile, kPixelShader, "HdMapObjPS", macros, "ps_3_0", s_pixelCode[kind][p], "MapObj pixel kind", kind * 16 + p)) {
+                    s_state.store(StateFailed);
+                    return;
+                }
+                HD::ShaderDump("HdMapObj", true, kind, p, &s_pixelCode[kind][p][0], s_pixelCode[kind][p].size()); // HD
+                total++;
+            }
+        }
+        snprintf(s_threadInfo, sizeof(s_threadInfo), "%d shaders compiled in %u ms", total, static_cast<uint32_t>(GetTickCount64() - start));
+        s_state.store(StateReady);
+    }
+
+    void ShowState(int32_t state) {
+        s_shownState = state;
+        if (!s_info) return;
+        char text[500];
+        if (state == StateCompiling) snprintf(text, sizeof(text), "compiling (Blizzard shaders until done)");
+        else if (state == StateIdle) snprintf(text, sizeof(text), "not started");
+        else if (state == StateReady && s_refusedInfo[0]) snprintf(text, sizeof(text), "%s; %s", s_threadInfo, s_refusedInfo);
+        else if (state == StateReady) snprintf(text, sizeof(text), "%s, %d in use", s_threadInfo, s_inUse);
+        else snprintf(text, sizeof(text), "%s", s_threadInfo);
+        s_info->Set(text, true, false, false, false);
+    }
+
+    void ReleaseRetired(bool all) {
+        if (s_retired.empty()) return;
+        ULONGLONG now = GetTickCount64();
+        size_t kept = 0;
+        for (size_t i = 0; i < s_retired.size(); i++) {
+            if (all || now - s_retired[i].time > 2000) s_retired[i].object->Release();
+            else s_retired[kept++] = s_retired[i];
+        }
+        s_retired.resize(kept);
+    }
+
+    // New code for this shader; its D3D object is made again from it the next time it is bound.
+    void SetCode(CGxShader* shader, const uint8_t* data, uint32_t size) {
+        if (shader->m_apiSpecific && HD::ShaderObjectOwnedByDevice()) {
+            shader->m_apiSpecific = nullptr; // HD: Vulkan: the translator's record, the device's own
+        }
+        if (shader->m_apiSpecific) {
+            // the device may still have it bound for this frame: release it a little later
+            Retired retired = { static_cast<IUnknown*>(shader->m_apiSpecific), GetTickCount64() };
+            s_retired.push_back(retired);
+            shader->m_apiSpecific = nullptr;
+        }
+        shader->m_loaded = 0;
+        shader->m_valid = 0;
+        shader->m_code.SetCount(size);
+        memcpy(shader->m_code.m_data, data, size);
+    }
+
+    // Our code for this shader, found from its name "<family>:<slot>" (CGxDevice::ShaderCreate); null if it is not
+    // a MapObj shader we know, or not shader model 3 code (a ps_2_x or OpenGL device keeps Blizzard's shaders).
+    const std::vector<uint8_t>* OurCode(CGxShader* shader, bool vertex) {
+        const char* key = shader->m_key.m_str;
+        const char* colon = key ? strchr(key, ':') : nullptr;
+        if (!colon) return nullptr;
+        size_t length = static_cast<size_t>(colon - key);
+        int32_t slot = atoi(colon + 1);
+        uint32_t version = vertex ? 0xFFFE0300u : 0xFFFF0300u;
+        if (shader->m_code.Count() < 4 || *reinterpret_cast<const uint32_t*>(shader->m_code.m_data) != version) return nullptr;
+        const std::vector<uint8_t>* code = nullptr;
+        if (vertex) {
+            for (int32_t i = 0; i < 7 && !code; i++) {
+                if (strlen(kVertexFamilies[i].name) == length && !strncmp(key, kVertexFamilies[i].name, length) && slot >= 0 && slot < 90) code = &s_vertexCode[i][VertexCode(slot)];
+            }
+        } else {
+            for (int32_t i = 0; i < 7 && !code; i++) {
+                if (strlen(kPixelFamilies[i].name) == length && !strncmp(key, kPixelFamilies[i].name, length) && slot >= 0 && slot < 16) code = &s_pixelCode[kPixelFamilies[i].kind][slot];
+            }
+        }
+        if (code && code->size() >= 4 && !HD::ShaderKnown(&(*code)[0], code->size())) return nullptr; // HD: Vulkan, untranslated
+        return code && code->size() >= 4 ? code : nullptr;
+    }
+
+    // All or nothing: one MapObj shader we cannot replace and every one goes back to Blizzard's (else a shared
+    // vertex shader would flip between ours and Blizzard's from one batch to the next). Returns false then.
+    bool Replaceable(CGxShader* shader, bool vertex) {
+        if (shader->unused_0028 == kOursMark || OurCode(shader, vertex)) return true;
+        snprintf(s_refusedInfo, sizeof(s_refusedInfo), "refused %s, Blizzard shaders kept", shader->m_key.m_str ? shader->m_key.m_str : "(no name)");
+        return false;
+    }
+
+    // Gives the shader our code (want) or Blizzard's back; returns true if it holds our code afterwards.
+    bool Apply(CGxShader* shader, bool vertex, bool want) {
+        bool ours = shader->unused_0028 == kOursMark;
+        if (want == ours) return ours;
+        ReleaseRetired(false);
+        if (!want) {
+            std::map<CGxShader*, std::vector<uint8_t> >::iterator it = s_original.find(shader);
+            if (it != s_original.end() && !it->second.empty()) SetCode(shader, &it->second[0], static_cast<uint32_t>(it->second.size()));
+            shader->unused_0028 = 0;
+            s_inUse--;
+            return false;
+        }
+        const std::vector<uint8_t>* code = OurCode(shader, vertex);
+        if (!code) return false; // checked by Replaceable before
+        s_original[shader].assign(shader->m_code.m_data, shader->m_code.m_data + shader->m_code.Count());
+        SetCode(shader, &(*code)[0], static_cast<uint32_t>(code->size()));
+        shader->unused_0028 = kOursMark;
+        s_inUse++;
+        return true;
+    }
+
+    // HD: world up (0, 0, 1) in view space, the hemisphere axis (rows a, b, c of the view matrix as in
+    // CShaderEffect::SetGlobalLighting: a direction d goes to d.x * a + d.y * b + d.z * c)
+    void ViewUp(float* up) {
+        C44Matrix view;
+        GxXformView(view);
+        up[0] = view.c0;
+        up[1] = view.c1;
+        up[2] = view.c2;
+        float length = sqrtf(up[0] * up[0] + up[1] * up[1] + up[2] * up[2]);
+        if (length > 0.0f) {
+            for (int32_t i = 0; i < 3; i++) up[i] /= length;
+        } else {
+            up[0] = 0.0f; up[1] = 0.0f; up[2] = 1.0f;
+        }
+    }
+}
+
+void HD::MapObjShadersStart() {
+    RegisterCVars();
+    int32_t expected = StateIdle;
+    if (!s_state.compare_exchange_strong(expected, StateCompiling)) return;
+    std::thread(CompileAll).detach();
+}
+
+void HD::MapObjShaders(CShaderEffect* effect, uint32_t vertexPermute, uint32_t pixelPermute, int32_t lightingMode) {
+    if (!effect || vertexPermute >= 90 || pixelPermute >= 16) return;
+    CGxShader* vs = effect->m_vertexShaders[vertexPermute];
+    CGxShader* ps = effect->m_pixelShaders[pixelPermute];
+    if (!vs || !ps) return;
+    RegisterCVars();
+    if (s_state.load() == StateIdle) HD::MapObjShadersStart(); // in case CMapObj::Initialize did not start it
+    int32_t state = s_state.load();
+    if (state != s_shownState) ShowState(state);
+
+    bool d3d9 = HD::ShaderSwapDevice(); // HD: D3D9, or Vulkan through the translated modules
+    int32_t mode = s_light ? s_light->m_intValue : 1;
+    bool want = state == StateReady && mode != 0 && d3d9 && !s_refusedInfo[0];
+    bool wasOurs = vs->unused_0028 == kOursMark && ps->unused_0028 == kOursMark;
+    int32_t inUse = s_inUse;
+    if (want && (!Replaceable(vs, true) || !Replaceable(ps, false))) {
+        want = false;
+        ShowState(state);
+    }
+
+    // the pair goes together: our vertex shader's Forever output (sun in COLOR1) needs our pixel shader
+    bool ours = Apply(vs, true, want);
+    ours = Apply(ps, false, want) && ours;
+    if (!ours) {
+        Apply(vs, true, false);
+        Apply(ps, false, false);
+    }
+    if (s_inUse != inUse || ours != wasOurs) ShowState(state);
+    if (!ours) return;
+
+    // HD: constants of our shaders, every batch (the terrain and other batches use the same registers)
+    bool exteriorLit = lightingMode == 1 || lightingMode == 2;
+    bool forever = exteriorLit && (mode == 1 || mode == 3);
+    bool test = forever && mode == 3;
+    float horizon[3];
+    float ground[3];
+    HD::TerrainHemisphere(horizon, ground);
+    float up[3];
+    ViewUp(up);
+    float vertex[20];
+    vertex[0] = 0.0f;
+    vertex[1] = 0.0f;
+    vertex[2] = forever ? 1.0f : 0.0f; // c49.z Forever lighting on this batch
+    vertex[3] = test ? 1.0f : 0.0f;    // c49.w test view (read by the pixel shader through c15.y)
+    vertex[4] = HD::LightAmbientStrength(); // c50.x
+    vertex[5] = 0.0f;
+    vertex[6] = 0.0f;
+    vertex[7] = 0.0f;
+    for (int32_t c = 0; c < 3; c++) {
+        vertex[8 + c] = horizon[c];     // c51
+        vertex[12 + c] = ground[c];     // c52
+        vertex[16 + c] = up[c];         // c53
+    }
+    vertex[11] = 0.0f;
+    vertex[15] = 0.0f;
+    vertex[19] = 0.0f;
+    g_theGxDevicePtr->ShaderConstantsSet(GxSh_Vertex, 49, vertex, 5);
+    float pixel[4] = { forever ? 1.0f : 0.0f, test ? 1.0f : 0.0f, 0.0f, 0.0f };
+    HD::PixelConstantsSet(15, pixel, 1); // HD: also the vertex row the Vulkan modules read
+}
diff --git a/WoW/Source/WorldClient/HD/HdMapObj.h b/WoW/Source/WorldClient/HD/HdMapObj.h
new file mode 100644
index 00000000..e838b7da
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdMapObj.h
@@ -0,0 +1,36 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDMAPOBJ_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDMAPOBJ_H
+
+// Waystone HD: our own building (WMO / MapObj) shaders (not part of the original client).
+// They are the 3.3.5 MapObj shaders rewritten in HLSL (checked against Blizzard's bytecode for all 7 vertex families
+// x 90 slots and 7 pixel families x 16 permutations), compiled when the game starts, with WoW Forever's lighting on
+// exterior-lit batches (SetLighting 1 or 2), the same lighting as hdTerrainLight:
+//   - the ambient comes from three colours: sky (roof facing up), horizon (walls), ground (overhangs); the client's
+//     ambient is the sky colour, horizon and ground are it times Forever's own horizon / sky and ground / sky (the
+//     same ratios as the terrain, HD::TerrainHemisphere);
+//   - a soft wrap of the sun over that ambient (x0.7 facing away from the sun .. x1.1 facing it);
+//   - the sun is cut fully by the shadow, the ambient is not touched by it (3.3.5 darkens everything to 70%).
+//   Interior batches (unlit / MOCV, SetLighting 0 and 3) and the 3.3.5 two-pass interior / exterior blend of the
+//   transition batches stay exactly Blizzard's. The vertex colour (MOCV) keeps the 3.3.5 rule of each path.
+//   hdWmoLight 1 = Forever lighting on exterior-lit batches (default)
+//              2 = our shaders with the 3.3.5 lighting: must look exactly like 0 (proves the swap changes nothing)
+//              3 = test view: exterior-lit batches show only the sun after the shadow (black in shadow)
+//              0 = Blizzard's shaders
+//   hdLightAmbient (HdTerrain's) ambient strength in Forever lighting, 1 = Forever's (a test knob, keep it at 1)
+//   hdWmoInfo  read only, compile result and how many shaders hold our code:  /run print(GetCVar("hdWmoInfo"))
+
+#include <cstdint>
+
+class CShaderEffect;
+
+namespace HD {
+    // Starts compiling our MapObj shaders on a background thread (once; called from CMapObj::Initialize).
+    void MapObjShadersStart();
+
+    // Called in CMapObj::SelectWorldShaders just before CShaderEffect::SetShaders, every batch: gives the vertex and
+    // pixel shader about to be bound our code or Blizzard's (always both together), to match hdWmoLight, and sets
+    // the constants our shaders read (vertex c49..c53, pixel c15). lightingMode = CMapObj::s_lightingMode.
+    void MapObjShaders(CShaderEffect* effect, uint32_t vertexPermute, uint32_t pixelPermute, int32_t lightingMode);
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdSky.cpp b/WoW/Source/WorldClient/HD/HdSky.cpp
new file mode 100644
index 00000000..086260e3
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdSky.cpp
@@ -0,0 +1,360 @@
+#include "WoW/Source/WorldClient/HD/HdSky.h"
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <thread>
+#include <vector>
+#include <windows.h>
+#include <d3dcompiler.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDevice/CGxShader.h"
+#include "Engine/Source/Gx/Gx.h"
+#include "Engine/Source/Gx/Types.h"
+#include "WoW/Source/WorldClient/HD/HdGxShader.h"
+#include "Engine/Source/Tempest/C44Matrix.h"
+#include "WoW/Source/WorldClient/DayNight__DNInfo.h"
+
+namespace {
+    // Source of truth: scratchpad sky/impl/shaders/hd_sky.hlsl (checked against Forever's dnsky / dnclouds DXIL).
+    const char kShader[] = R"HLSL(
+// Waystone HD sky shaders (vs_3_0 / ps_3_0): WoW Forever's dnsky and dnclouds on the 3.3.5 sky dome and cloud dome.
+// Entry points: SkyVS + SkyPS (DNSky::Render), CloudVS + CloudPS (DNClouds::Render). Bound through Gx, so the
+// client keeps its own states (blending, depth range, scissor, cloud texture and sampler).
+// Forever renders in linear light and encodes to gamma at the end; the client draws in gamma. Each Forever step is
+// done here in linear light and encoded back, so on screen it gives what Forever's shader + gamma encode gives.
+// With the Forever terms at 0 (hdSky 2) the output is exactly the fixed-function result.
+
+float4 c_mvp[4]     : register(c240); // VS: rows of world * view * projection (pos = x*r0 + y*r1 + z*r2 + r3)
+
+float4 c_sun        : register(c200); // PS: xyz = direction to the sun (or the moon at night), w = glow start (a cosine)
+float4 c_glow       : register(c201); // PS: rgb = glow colour, LINEAR; w = glow strength at and below the horizon
+float4 c_parm       : register(c202); // PS: x = glow strength above the horizon, y = dither amplitude (output units),
+                                      //     z = per-frame noise offset, w = 1 for the test view
+float4 c_cloudLight : register(c203); // PS: xyz = direction to the sun (unit), w = cloud sun scatter strength
+float4 c_cloudSun   : register(c204); // PS: rgb = cloud sun colour (gamma, 0..1)
+
+sampler2D s_cloud   : register(s0);   // the client's cloud texture (DNClouds), with the client's sampler state
+
+struct SkyVertex {
+    float4 pos : POSITION;
+    float4 col : COLOR0;    // the client's dome colour (gamma), interpolated in gamma like Forever's
+    float4 dir : TEXCOORD0; // xyz = dome point (the camera is at the origin), w = its height (0 = horizon)
+};
+
+struct CloudVertex {
+    float4 pos : POSITION;
+    float4 col : COLOR0;
+    float2 uv  : TEXCOORD0;
+    float3 nrm : TEXCOORD1; // direction of the dome point, normalized per vertex (not again per pixel, like Forever)
+};
+
+float3 Lin(float3 c) { return pow(max(c, 0.0), 2.2); }
+float3 Gam(float3 c) { return pow(max(c, 0.0), 1.0 / 2.2); }
+
+// Forever's triangular-PDF dither (sign(n) * (1 - sqrt(1 - |n|)), n uniform in -1..1 per channel). Forever reads n
+// from a 128x128 blue noise texture; here n is interleaved gradient noise (no texture in the 3.3.5 data).
+float3 Dither(float2 vpos) {
+    float k = dot(vpos + c_parm.zz, float2(0.06711056, 0.00583715));
+    float3 n = frac(52.9829189 * frac(k + float3(0.0, 0.3183099, 0.6180340))) * 2.0 - 1.0;
+    return sign(n) * (1.0 - sqrt(1.0 - abs(n)));
+}
+
+SkyVertex SkyVS(float3 p : POSITION, float4 col : COLOR0) {
+    SkyVertex o;
+    o.pos = p.x * c_mvp[0] + p.y * c_mvp[1] + p.z * c_mvp[2] + c_mvp[3];
+    o.col = col;
+    o.dir = float4(p, p.z);
+    return o;
+}
+
+// dnsky: glow toward the sun, cubic from the cone edge to the sun, stronger at the horizon; then the dither.
+float4 SkyPS(SkyVertex i, float2 vpos : VPOS) : COLOR0 {
+    float3 c = i.col.rgb;
+    float t = saturate(dot(normalize(i.dir.xyz), normalize(c_sun.xyz)) - c_sun.w);
+    float k = 0.0;
+    if (t > 0.0) {
+        float g = t / (1.0 - c_sun.w);
+        g = saturate(g * g * g);
+        k = g * lerp(c_glow.w, c_parm.x, saturate(i.dir.w * 50.0));
+        float3 l = Lin(c);
+        c = Gam(l + k * (c_glow.rgb - l));
+    }
+    if (c_parm.w > 0.5) c = k; // test view: the glow amount in grey
+    c += Dither(vpos) * c_parm.y;
+    return float4(c, i.col.a);
+}
+
+CloudVertex CloudVS(float3 p : POSITION, float4 col : COLOR0, float2 uv : TEXCOORD0) {
+    CloudVertex o;
+    o.pos = p.x * c_mvp[0] + p.y * c_mvp[1] + p.z * c_mvp[2] + c_mvp[3];
+    o.col = col;
+    o.uv = uv;
+    o.nrm = normalize(p);
+    return o;
+}
+
+// dnclouds: texture x vertex colour (the fixed-function modulate), then the sun shining through thin cloud near
+// the sun: base * (1 + sun * N.L^2 * (1 - alpha) * strength), in linear light.
+float4 CloudPS(CloudVertex i, float2 vpos : VPOS) : COLOR0 {
+    float4 t = tex2D(s_cloud, i.uv);
+    float3 c = i.col.rgb * t.rgb;
+    float a = t.a * i.col.a;
+    float d = saturate(dot(i.nrm, c_cloudLight.xyz));
+    float s = d * d * saturate(1.0 - a) * abs(c_cloudLight.w);
+    if (s > 0.0) {
+        c *= pow(1.0 + Lin(c_cloudSun.rgb) * s, 1.0 / 2.2);
+    }
+    if (c_parm.w > 0.5) c = float3(s, 0.0, 0.0); // test view: the sun scatter in red
+    c += Dither(vpos) * c_parm.y;
+    return float4(c, a);
+}
+)HLSL";
+
+    // Registers no 3.3.5 shader reads (VS c240-c243, PS c200-c204); the client's values are put back after each draw.
+    const uint32_t kVsFirst = 240;
+    const uint32_t kVsCount = 4;
+    const uint32_t kPsFirst = 200;
+    const uint32_t kPsCount = 5;
+
+    const float kNightStart = 0.9236111f; // the client's sun/moon switch (DNClouds::SetupBumpMap, hdSunPath): 22:10
+    const float kNightEnd = 0.2013889f;   // 4:50
+    const float kSwitchFade = 0.0138889f; // the glow fades out and in over 20 game minutes around the switch
+
+    enum { StateIdle, StateCompiling, StateReady, StateFailed };
+    enum { Sh_SkyVS, Sh_SkyPS, Sh_CloudVS, Sh_CloudPS, Sh_Count };
+    const char* const kEntry[Sh_Count] = { "SkyVS", "SkyPS", "CloudVS", "CloudPS" };
+    const char* const kName[Sh_Count] = { "HdSky:SkyVS", "HdSky:SkyPS", "HdSky:CloudVS", "HdSky:CloudPS" };
+
+    typedef HRESULT(WINAPI* D3DCompileFn)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*, LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+
+    std::atomic<int32_t> s_state(StateIdle);
+    std::vector<uint8_t> s_code[Sh_Count]; // written by the compile thread before s_state = StateReady
+    char s_threadInfo[300] = "";           // written by the compile thread before s_state changes to Ready/Failed
+    CGxShader* s_shaders[Sh_Count] = {};
+    bool s_shadersFailed = false;
+
+    float s_savedVs[kVsCount * 4];
+    float s_savedPs[kPsCount * 4];
+    uint32_t s_frame = 0;
+    char s_lastInfo[300] = "";
+
+    CVar* s_sky = nullptr;
+    CVar* s_glow = nullptr;
+    CVar* s_glowHorizon = nullptr;
+    CVar* s_glowSize = nullptr;
+    CVar* s_cloudSun = nullptr;
+    CVar* s_dither = nullptr;
+    CVar* s_info = nullptr;
+
+    void RegisterCVars() {
+        static bool registered = false;
+        if (registered) return;
+        registered = true;
+        HD::ShaderCVars(); // HD: hdShaderDump
+        s_sky = CVar::Register("hdSky", "HD: 1 = WoW Forever sky and clouds, 2 = our shaders with the 3.3.5 look, 3 = test view, 0 = Blizzard sky", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_glow = CVar::Register("hdSkyGlow", "HD: sun glow strength above the horizon (0 = off)", 1, "0.35", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_glowHorizon = CVar::Register("hdSkyGlowHorizon", "HD: sun glow strength at and below the horizon", 1, "0.8", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_glowSize = CVar::Register("hdSkyGlowSize", "HD: sun glow cone half-angle in degrees", 1, "50", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_cloudSun = CVar::Register("hdSkyCloudSun", "HD: sun shining through thin clouds near the sun (0 = off)", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_dither = CVar::Register("hdSkyDither", "HD: sky dither in 1/255 steps (0 = off)", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_info = CVar::Register("hdSkyInfo", "HD: hdSky status (read only)", 0, "not started", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    }
+
+    void SetInfo(const char* text) {
+        if (!s_info || !strcmp(s_lastInfo, text)) return;
+        snprintf(s_lastInfo, sizeof(s_lastInfo), "%s", text);
+        s_info->Set(text, true, false, false, false);
+    }
+
+    float Clamp(float v, float lo, float hi) {
+        return v < lo ? lo : (v > hi ? hi : v);
+    }
+
+    float CVarValue(CVar* cvar, float fallback, float lo, float hi) {
+        return cvar ? Clamp(cvar->m_floatValue, lo, hi) : fallback;
+    }
+
+    // Compile thread: the four entry points, all or nothing.
+    void CompileAll() {
+        ULONGLONG start = GetTickCount64();
+        HMODULE module = LoadLibraryA("d3dcompiler_47.dll");
+        D3DCompileFn compile = module ? reinterpret_cast<D3DCompileFn>(GetProcAddress(module, "D3DCompile")) : nullptr;
+        if (!compile) {
+            snprintf(s_threadInfo, sizeof(s_threadInfo), "ERROR: d3dcompiler_47.dll not found, Blizzard sky kept");
+            s_state.store(StateFailed);
+            return;
+        }
+        for (int32_t i = 0; i < Sh_Count; i++) {
+            bool vertex = i == Sh_SkyVS || i == Sh_CloudVS;
+            ID3DBlob* code = nullptr;
+            ID3DBlob* errors = nullptr;
+            HRESULT hr = compile(kShader, strlen(kShader), "HdSky", nullptr, nullptr, kEntry[i], vertex ? "vs_3_0" : "ps_3_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+            if (FAILED(hr) || !code) {
+                snprintf(s_threadInfo, sizeof(s_threadInfo), "ERROR: shader %s: %s", kEntry[i], errors ? static_cast<const char*>(errors->GetBufferPointer()) : "unknown");
+                if (errors) errors->Release();
+                if (code) code->Release();
+                s_state.store(StateFailed);
+                return;
+            }
+            if (errors) errors->Release();
+            const uint8_t* bytes = static_cast<const uint8_t*>(code->GetBufferPointer());
+            s_code[i].assign(bytes, bytes + code->GetBufferSize());
+            HD::ShaderDump("HdSky", !vertex, i, 0, bytes, code->GetBufferSize()); // HD: hdShaderDump
+            code->Release();
+        }
+        snprintf(s_threadInfo, sizeof(s_threadInfo), "%d shaders compiled in %u ms", static_cast<int>(Sh_Count), static_cast<uint32_t>(GetTickCount64() - start));
+        s_state.store(StateReady);
+    }
+
+    // Our shaders, made once. They live in the device's own shader list, so the device releases them and makes them
+    // again from their code like its own (device reset or re-creation).
+    bool EnsureShaders() {
+        if (s_shaders[Sh_Count - 1]) return true;
+        if (s_shadersFailed) return false;
+        int32_t state = s_state.load();
+        if (state == StateIdle) {
+            int32_t expected = StateIdle;
+            if (s_state.compare_exchange_strong(expected, StateCompiling)) std::thread(CompileAll).detach();
+            SetInfo("compiling (Blizzard sky until done)");
+            return false;
+        }
+        if (state == StateCompiling) return false;
+        if (state == StateFailed) {
+            s_shadersFailed = true;
+            SetInfo(s_threadInfo);
+            return false;
+        }
+        CGxShader* made[Sh_Count] = {};
+        for (int32_t i = 0; i < Sh_Count; i++) {
+            EGxShTarget target = i == Sh_SkyVS || i == Sh_CloudVS ? GxSh_Vertex : GxSh_Pixel;
+            CGxShader* shader = g_theGxDevicePtr->m_shaderList[target].Ptr(kName[i]);
+            if (!shader) {
+                shader = g_theGxDevicePtr->m_shaderList[target].New(kName[i], 0, 0);
+                shader->m_refCount++;
+                shader->m_target = target;
+            }
+            const std::vector<uint8_t>& code = s_code[i];
+            shader->m_code.SetCount(static_cast<uint32_t>(code.size()));
+            memcpy(shader->m_code.m_data, &code[0], code.size());
+            shader->m_loaded = 0;
+            if (!shader->Valid()) {
+                char text[300];
+                snprintf(text, sizeof(text), "ERROR: the device refused shader %s, Blizzard sky kept", kEntry[i]);
+                SetInfo(text);
+                s_shadersFailed = true;
+                return false;
+            }
+            made[i] = shader;
+        }
+        for (int32_t i = 0; i < Sh_Count; i++) s_shaders[i] = made[i];
+        return true;
+    }
+
+    // Unit direction to the sun by day, to the moon at night (the client's own choice for the cloud lighting), and
+    // how far from the sun/moon switch we are (0 at the switch, 1 from 20 game minutes away).
+    void SkyLight(float* dir, float* fade, bool* moon) {
+        DayNight::DNInfo& info = DayNight::g_dnInfo;
+        float t = info.m_dayProgression;
+        bool night = t < kNightEnd || t > kNightStart;
+        const C3Vector& pos = night ? DayNight::g_planets.m_moon.m_position : DayNight::g_planets.m_sun.m_position;
+        float x = pos.x - info.m_cameraPos.x;
+        float y = pos.y - info.m_cameraPos.y;
+        float z = pos.z - info.m_cameraPos.z;
+        float len = sqrtf(x * x + y * y + z * z);
+        if (len < 1e-4f) { x = 0.0f; y = 0.0f; z = 1.0f; len = 1.0f; }
+        dir[0] = x / len;
+        dir[1] = y / len;
+        dir[2] = z / len;
+        float toSwitch;
+        if (!night) toSwitch = fminf(t - kNightEnd, kNightStart - t);
+        else if (t < 0.5f) toSwitch = fminf(kNightEnd - t, t + 1.0f - kNightStart);
+        else toSwitch = fminf(t - kNightStart, 1.0f - t + kNightEnd);
+        *fade = Clamp(toSwitch / kSwitchFade, 0.0f, 1.0f);
+        *moon = night;
+    }
+
+    float Linear(uint8_t c) {
+        return powf(c * (1.0f / 255.0f), 2.2f);
+    }
+}
+
+bool HD::SkyBeginDraw(int32_t pass) {
+    RegisterCVars();
+    int32_t mode = s_sky ? s_sky->m_intValue : 0;
+    if (mode <= 0) {
+        SetInfo("off (Blizzard sky)");
+        return false;
+    }
+    if (!HD::ShaderSwapDevice()) { // HD: D3D9, or Vulkan through the translated modules
+        SetInfo("off: needs gxApi d3d9 or vulkan");
+        return false;
+    }
+    if (!EnsureShaders()) return false;
+
+    bool forever = mode != 2;
+    bool test = mode == 3;
+    DayNight::DNInfo& info = DayNight::g_dnInfo;
+
+    float dir[3];
+    float fade;
+    bool moon;
+    SkyLight(dir, &fade, &moon);
+
+    // Forever's terms. hdSky 2: all off, and an empty glow cone (start cosine 2), so the output is the dome colour
+    // (and the texture x colour for the clouds) exactly.
+    float storm = 1.0f - Clamp(info.m_stormBlend, 0.0f, 1.0f);
+    float glow = forever ? CVarValue(s_glow, 0.35f, 0.0f, 4.0f) * fade * storm : 0.0f;
+    float glowHorizon = forever ? CVarValue(s_glowHorizon, 0.8f, 0.0f, 4.0f) * fade * storm : 0.0f;
+    float glowCos = cosf(CVarValue(s_glowSize, 50.0f, 1.0f, 179.0f) * 0.017453292f);
+    if (glowCos > 0.999f) glowCos = 0.999f;
+    if (glow <= 0.0f && glowHorizon <= 0.0f) glowCos = 2.0f;
+    float cloudSun = forever ? CVarValue(s_cloudSun, 1.0f, 0.0f, 8.0f) * fade : 0.0f;
+    float dither = forever ? CVarValue(s_dither, 1.0f, 0.0f, 8.0f) * (1.0f / 255.0f) : 0.0f;
+    if (pass == HD::SkyPass_Dome) s_frame = (s_frame + 1) & 63; // Forever moves its noise every frame
+
+    const CImVector& sun = info.m_bands.m_sunCloudColors[0];      // sun and moon colour (band 9): the glow colour
+    const CImVector& cloudColor = info.m_bands.m_sunCloudColors[1]; // cloud sun colour (band 10)
+    float ps[kPsCount * 4] = {
+        dir[0], dir[1], dir[2], glowCos,
+        Linear(sun.r), Linear(sun.g), Linear(sun.b), glowHorizon,
+        glow, dither, static_cast<float>(s_frame) * 5.588238f, test ? 1.0f : 0.0f,
+        dir[0], dir[1], dir[2], cloudSun,
+        cloudColor.r * (1.0f / 255.0f), cloudColor.g * (1.0f / 255.0f), cloudColor.b * (1.0f / 255.0f), 0.0f,
+    };
+
+    // world * view * projection, as the fixed-function pipeline gets them (rows; the shader does x*r0 + y*r1 + z*r2 + r3)
+    const CGxMatrixStack& world = g_theGxDevicePtr->m_xforms[GxXform_World];
+    const CGxMatrixStack& view = g_theGxDevicePtr->m_xforms[GxXform_View];
+    C44Matrix mvp = world.m_mtx[world.m_level] * view.m_mtx[view.m_level] * g_theGxDevicePtr->m_projNative;
+    float vs[kVsCount * 4];
+    memcpy(vs, &mvp, sizeof(vs));
+
+    memcpy(s_savedVs, &CGxDevice::s_shadowConstants[1].constants[kVsFirst * 4], sizeof(s_savedVs));
+    memcpy(s_savedPs, &CGxDevice::s_shadowConstants[0].constants[kPsFirst * 4], sizeof(s_savedPs));
+    g_theGxDevicePtr->ShaderConstantsSet(GxSh_Vertex, kVsFirst, vs, kVsCount);
+    HD::PixelConstantsSet(kPsFirst, ps, kPsCount); // HD: also the vertex rows the Vulkan modules read
+    bool clouds = pass == HD::SkyPass_Clouds;
+    GxRsSet(GxRs_VertexShader, s_shaders[clouds ? Sh_CloudVS : Sh_SkyVS]);
+    GxRsSet(GxRs_PixelShader, s_shaders[clouds ? Sh_CloudPS : Sh_SkyPS]);
+
+    char text[300];
+    if (!forever) {
+        snprintf(text, sizeof(text), "on, 3.3.5 look (hdSky 2), %s", s_threadInfo);
+    } else {
+        snprintf(text, sizeof(text), "on%s, glow %.2f / %.2f (horizon), %.0f deg around the %s (x%.1f), cloud sun %.2f, dither %.1f/255, %s",
+                 test ? " (test view)" : "", CVarValue(s_glow, 0.35f, 0.0f, 4.0f), CVarValue(s_glowHorizon, 0.8f, 0.0f, 4.0f),
+                 CVarValue(s_glowSize, 50.0f, 1.0f, 179.0f), moon ? "moon" : "sun", fade * storm,
+                 CVarValue(s_cloudSun, 1.0f, 0.0f, 8.0f), dither * 255.0f, s_threadInfo);
+    }
+    SetInfo(text);
+    return true;
+}
+
+void HD::SkyEndDraw() {
+    if (!g_theGxDevicePtr) return;
+    g_theGxDevicePtr->ShaderConstantsSet(GxSh_Vertex, kVsFirst, s_savedVs, kVsCount);
+    HD::PixelConstantsSet(kPsFirst, s_savedPs, kPsCount); // HD
+}
diff --git a/WoW/Source/WorldClient/HD/HdSky.h b/WoW/Source/WorldClient/HD/HdSky.h
new file mode 100644
index 00000000..5a220236
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdSky.h
@@ -0,0 +1,44 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDSKY_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDSKY_H
+
+// Waystone HD: WoW Forever's sky dome and cloud shaders (dnsky, dnclouds) on the 3.3.5 sky (not part of the original
+// client). 3.3.5 draws the sky with the fixed-function pipeline; these shaders draw the same meshes, colours and
+// cloud texture, and add what Forever's shaders add:
+//   - sky: a glow toward the sun (the moon at night), growing as the cube from the edge of a cone to the sun,
+//     stronger at and below the horizon, mixed in linear light; then a 1-step dither against banding;
+//   - clouds: the sun shining through thin cloud near the sun (base x (1 + sun x N.L^2 x (1 - alpha) x strength)).
+// The sun, moon, stars, glares and zone skyboxes stay as they are (Forever's planet shader is the same modulate).
+// Forever has no volumetric or ray-marched clouds: its only cloud shader is this textured dome.
+//   hdSky             1 = Forever sky and clouds (default)
+//                     0 = Blizzard's fixed-function sky, untouched
+//                     2 = our shaders with the Forever terms off: must look exactly like 0 (proves the swap)
+//                     3 = test view: sky = glow amount in grey, clouds = sun scatter in red
+//   hdSkyGlow         glow strength above the horizon (Forever DNSky r0.y; the value Forever uses is not in its
+//                     shaders or data we have: tune against a Forever capture), 0 = no glow
+//   hdSkyGlowHorizon  glow strength at and below the horizon (Forever DNSky r2.w)
+//   hdSkyGlowSize     glow cone half-angle in degrees (Forever DNSky r0.x = its cosine)
+//   hdSkyCloudSun     sun scatter strength in thin cloud (Forever DNClouds r0.w), 0 = off
+//   hdSkyDither       dither amplitude in 1/255 steps (Forever DNSky/DNClouds r3.x), 0 = off
+//   hdSkyInfo         read only, status:  /run print(GetCVar("hdSkyInfo"))
+// The colours are the client's: with hdForever 1 they are Forever's LightData colours (sky bands, sun colour for the
+// glow, cloud sun colour for the scatter).
+
+#include <cstdint>
+
+namespace HD {
+    enum SkyPass {
+        SkyPass_Dome = 0,   // DNSky::Render (vertices: position, colour)
+        SkyPass_Clouds = 1, // DNClouds::Render (vertices: position, colour, texture coordinate)
+    };
+
+    // Called by DNSky::Render / DNClouds::Render after their render states, before the draw (inside their RsPush):
+    // binds our shaders and constants and returns true, or returns false and touches nothing (hdSky 0, shaders not
+    // compiled yet or not usable): the fixed-function draw then happens as before.
+    bool SkyBeginDraw(int32_t pass);
+
+    // Called after the draw when SkyBeginDraw returned true: gives the client its shader constants back
+    // (the shaders themselves are unbound by the caller's RsPop).
+    void SkyEndDraw();
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdTerrain.cpp b/WoW/Source/WorldClient/HD/HdTerrain.cpp
new file mode 100644
index 00000000..a03e45d4
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdTerrain.cpp
@@ -0,0 +1,960 @@
+#include "WoW/Source/WorldClient/HD/HdTerrain.h"
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <thread>
+#include <vector>
+#include <windows.h>
+#include <d3d9.h>
+#include <d3dcompiler.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDevice/CGxShader.h"
+#include "Engine/Source/Gx/Types.h"
+#include "WoW/Source/WorldClient/HD/HdGxShader.h"
+#include "Engine/Source/Tempest/C3Vector.h" // HD: hdLights
+#include "Engine/Source/Tempest/CAaSphere.h" // HD: hdLights
+#include "WoW/Source/DB/Rec/LightRec.h"
+#include "WoW/Source/WorldClient/DayNight__DNInfo.h"
+#include "WoW/Source/WorldClient/HD/HdForever.h"
+#include "WoW/Source/WorldClient/HD/HdLights.h" // HD: hdLights
+
+namespace {
+    // Terrain vertex shader. Source of truth: the 3.3.5 shader rewritten from its bytecode (Shaders\Vertex\vs_3_0\
+    // Terrain.bls), checked numerically against it for all 128 permutations, plus the Forever lighting path.
+    const char kVertexShader[] = R"HLSL(
+// Waystone HD terrain vertex shader (vs_3_0). Replaces Shaders\Vertex\vs_3_0\Terrain.bls permutation P:
+//   P = 64*POINT_LIGHTS + 16*(LAYERS-1) + 8*SPECULAR + 4*VERTEX_COLOR + 2*ENV_LAYER0 + SHADOW
+// With c49.z = 0 it computes exactly what the 3.3.5 shader does (TEXCOORD7 = 0).
+// With c49.z = 1 it lights the ground like WoW Forever's terrain shader: the ambient comes from a sky / horizon /
+// ground hemisphere and is shaded by a soft wrap of the sun (0.7 .. 1.1); the sun itself goes out separately in
+// TEXCOORD7 so the pixel shader can cut it fully in shadow instead of darkening everything to 70%.
+// HD lights (hdLights): the pixel shader lights the ground with the point lights itself, per pixel (WoW Forever's
+// light buffer maths). For that this shader also writes the camera-relative world position and the world normal:
+// HD_POS = (position - camera, normal.x), TEXCOORD0.w = normal.y (a ground normal always points up, so the pixel
+// shader rebuilds z). To fit in the pixel shader's 10 inputs our pixel shader reads the fog from TEXCOORD7.w, not
+// FOG, and the Forever / test-view flags of TEXCOORD7.w move to pixel
+// constant c16. With c53.w = 1 the 3.3.5 per-vertex point lights are left out of the Forever ambient (the pixel
+// shader does them); with c53.w = 0 nothing else changes.
+// HD: no FOG output. vs_3_0 has 11 o# registers besides PSIZE, and SHADOW with LAYERS 3 or 4 needed 12 with it
+// (error X5622). A vs_3_0 shader only ever runs with a ps_3_0 one, which never gets fixed-function fog, and our
+// pixel shader reads the fog from TEXCOORD7.w, so FOG was read by nobody.
+#ifndef LAYERS
+#define LAYERS 1
+#endif
+#ifndef POINT_LIGHTS
+#define POINT_LIGHTS 0
+#endif
+#ifndef SPECULAR
+#define SPECULAR 0
+#endif
+#ifndef VERTEX_COLOR
+#define VERTEX_COLOR 0
+#endif
+#ifndef ENV_LAYER0
+#define ENV_LAYER0 0
+#endif
+#ifndef SHADOW
+#define SHADOW 0
+#endif
+// HD lights: the free output slot for the position (TEXCOORD3 is free with SHADOW, TEXCOORD5 without)
+#if SHADOW
+#define HD_POS TEXCOORD3
+#else
+#define HD_POS TEXCOORD5
+#endif
+
+float4 cWorldView[4]  : register(c0);   // rows of (translate(-camera) * view)
+float4 cProj[4]       : register(c4);   // rows of native projection
+float4 cViewT[3]      : register(c8);   // rows of transpose(view); only read when ENV_LAYER0
+float4 cFog           : register(c12);  // x = -fogMul/(end-start), y = end/(end-start), z = density exponent
+float4 cTexOffset[5]  : register(c13);  // per tex-coord set k (c17 = m_texScale[0], always 0)
+float4 cTexScale[5]   : register(c18);  // per tex-coord set k
+float4 cChunkPos      : register(c23);  // chunk origin, world
+float4 cSunDir        : register(c24);  // view-space direction to the sun
+float4 cSunAmbient    : register(c25);
+float4 cSunDiffuse    : register(c26);
+float4 cSunSpecular   : register(c27);  // w = exponent (20)
+float4 cPointLight[9] : register(c28);  // 3 x {pos (world - camera), colour, attenuation (k0,k1,k2)}
+float4 cShadowMtx[12] : register(c37);  // 3 rows each: dyn/cascade0, band0, band1, band2
+float4 cHdLight       : register(c49);  // z = 1 Forever lighting, w = 1 test view (the pixel shader shows only the sun
+                                        // after the shadow); x, y unused
+float4 cHdLight2      : register(c50);  // x = ambient strength in Forever lighting (1 = the ambient as it is)
+float4 cHdHorizon     : register(c51);  // rgb = Forever's horizon ambient / its sky ambient, per channel
+float4 cHdGround      : register(c52);  // rgb = Forever's ground ambient / its sky ambient, per channel
+float4 cHdCamera      : register(c53);  // HD lights: xyz = camera world position (the origin of the light positions),
+                                        // w = 1 when the point lights are done per pixel (left out here)
+
+// x = term from world X, y = term from world Y. The UV a pixel shader samples with is .yx
+float2 LayerTerms(float3 p, int k)
+{
+    return (p.xy - cChunkPos.xy) * cTexScale[k].xy + cTexOffset[k].xy;
+}
+
+float3 PointLight(int i, float3 vp, float3 n)
+{
+    float3 lp = cPointLight[3 * i].x * cWorldView[0].xyz + cPointLight[3 * i].y * cWorldView[1].xyz + cPointLight[3 * i].z * cWorldView[2].xyz;
+    float3 l = lp - vp;
+    float dist = length(l);
+    float3 att = cPointLight[3 * i + 2].xyz;
+    return saturate(dot(l / dist, n)) * cPointLight[3 * i + 1].xyz / (att.x + att.y * dist + att.z * dist * dist);
+}
+
+void main(
+    float3 iPos : POSITION0,
+    float3 iNormal : NORMAL0,
+#if VERTEX_COLOR
+    float4 iColor : COLOR0,
+#endif
+    out float4 oPos : POSITION0,
+    out float4 oDiffuse : COLOR0,
+    out float4 oSpecular : COLOR1,
+    out float4 oTex0 : TEXCOORD0,
+#if SHADOW
+#if LAYERS == 1
+    out float2 oTex1 : TEXCOORD1,
+#else
+    out float4 oTex1 : TEXCOORD1,
+#endif
+#if LAYERS == 3
+    out float2 oTex2 : TEXCOORD2,
+#endif
+#if LAYERS == 4
+    out float4 oTex2 : TEXCOORD2,
+#endif
+    out float4 oShadow0 : TEXCOORD4,
+    out float4 oShadow1 : TEXCOORD5,
+    out float4 oShadow2 : TEXCOORD6,
+#else
+    out float2 oTex1 : TEXCOORD1,
+#if LAYERS >= 2
+    out float2 oTex2 : TEXCOORD2,
+#endif
+#if LAYERS >= 3
+    out float2 oTex3 : TEXCOORD3,
+#endif
+#if LAYERS >= 4
+    out float2 oTex4 : TEXCOORD4,
+#endif
+#endif
+    out float4 oHdPos : HD_POS,
+    out float4 oDirect : TEXCOORD7) // HD: no FOG output (see the top)
+{
+    float4 vp = iPos.x * cWorldView[0] + iPos.y * cWorldView[1] + iPos.z * cWorldView[2] + cWorldView[3];
+    oPos = vp.x * cProj[0] + vp.y * cProj[1] + vp.z * cProj[2] + vp.w * cProj[3];
+    float fog = min(pow(max(vp.z * cFog.x + cFog.y, 0.0), cFog.z), 1.0); // HD: goes out in TEXCOORD7.w only
+
+    // normal: worldView 3x3, NOT renormalised
+    float3 n = iNormal.x * cWorldView[0].xyz + iNormal.y * cWorldView[1].xyz + iNormal.z * cWorldView[2].xyz;
+
+#if VERTEX_COLOR
+    float3 shade = iColor.xyz;
+#else
+    float3 shade = float3(0.5, 0.5, 0.5);
+#endif
+    float3 points = float3(0.0, 0.0, 0.0);
+#if POINT_LIGHTS
+    points = points + PointLight(0, vp.xyz, n);
+    points = points + PointLight(1, vp.xyz, n);
+    points = points + PointLight(2, vp.xyz, n);
+#endif
+    // HD lights: camera-relative world position and the unit world normal for the pixel shader
+    float3 nw = normalize(iNormal);
+    oHdPos = float4(iPos - cHdCamera.xyz, nw.x);
+    oDirect = float4(0.0, 0.0, 0.0, fog);
+    [branch] if (cHdLight.z > 0.5) {
+        // HD: Forever. Ambient: horizon colour for a wall, sky colour for flat ground facing up, ground colour for an
+        // overhang; the client's ambient is the sky colour (Forever's when hdForeverLight is 1, so horizon and ground
+        // are then Forever's own colours). Then a wrap of the sun over it, and the sun on its own.
+        float3 nn = normalize(n);
+        float up = dot(normalize(cWorldView[2].xyz), nn);
+        float nl = dot(cSunDir.xyz, nn);
+        float3 sky = cSunAmbient.xyz * cHdLight2.x;
+        float3 horizon = sky * cHdHorizon.xyz;
+        float3 hemi = horizon + (sky - horizon) * saturate(up) + (sky * cHdGround.xyz - horizon) * saturate(-up);
+        float3 ambient = hemi * (nl * 0.2 + 0.9);
+        if (cHdCamera.w < 0.5) ambient = ambient + points;
+        float3 direct = cSunDiffuse.xyz * saturate(nl);
+        // like 3.3.5, a channel never goes over 1 (both parts are scaled down together)
+        float3 fit = 1.0 / max(ambient + direct, 1.0);
+        oDiffuse = float4(ambient * fit * shade, 1.0);
+        oDirect = float4(direct * fit * shade, fog);
+    } else {
+        float3 light = cSunDiffuse.xyz * saturate(dot(cSunDir.xyz, n)) + cSunAmbient.xyz;
+        light = light + points;
+        light = min(light, 1.0);
+        oDiffuse = float4(light * shade, 1.0);
+    }
+
+#if SPECULAR
+    float3 h = normalize(normalize(-vp.xyz) + cSunDir.xyz);
+    oSpecular = float4(pow(max(dot(h, n), 0.0), cSunSpecular.w) * cSunSpecular.xyz, 1.0);
+#else
+    oSpecular = float4(0.0, 0.0, 0.0, 0.0);
+#endif
+
+#if ENV_LAYER0
+    float3 r = vp.xyz - 2.0 * dot(vp.xyz, n) * n;
+    oTex0 = float4(r.x * cViewT[0].xzy + r.y * cViewT[1].xzy + r.z * cViewT[2].xzy, nw.y);
+#else
+    oTex0 = float4(LayerTerms(iPos, 0).yx, 0.0, nw.y);
+#endif
+
+#if SHADOW
+#if LAYERS == 1
+    oTex1 = LayerTerms(iPos, 1).yx;
+#else
+    oTex1 = float4(LayerTerms(iPos, 1).yx, LayerTerms(iPos, 2));
+#endif
+#if LAYERS == 3
+    oTex2 = LayerTerms(iPos, 3).yx;
+#endif
+#if LAYERS == 4
+    oTex2 = float4(LayerTerms(iPos, 3).yx, LayerTerms(iPos, 4));
+#endif
+    // HD: TEXCOORD3 (view position) is not written: no terrain pixel shader reads it, and ps_3_0 reads only 10
+    // inputs, so its slot holds HD_POS (TEXCOORD7 took the FOG slot's place).
+    oShadow0 = float4(dot(vp, cShadowMtx[0]), dot(vp, cShadowMtx[1]), dot(vp, cShadowMtx[2]), dot(vp, cShadowMtx[9]));
+    oShadow1 = float4(dot(vp, cShadowMtx[3]), dot(vp, cShadowMtx[4]), dot(vp, cShadowMtx[5]), dot(vp, cShadowMtx[10]));
+    oShadow2 = float4(dot(vp, cShadowMtx[6]), dot(vp, cShadowMtx[7]), dot(vp, cShadowMtx[8]), dot(vp, cShadowMtx[11]));
+#else
+    oTex1 = LayerTerms(iPos, 1).yx;
+#if LAYERS >= 2
+    oTex2 = LayerTerms(iPos, 2).yx;
+#endif
+#if LAYERS >= 3
+    oTex3 = LayerTerms(iPos, 3).yx;
+#endif
+#if LAYERS >= 4
+    oTex4 = LayerTerms(iPos, 4).yx;
+#endif
+#endif
+}
+)HLSL";
+
+    // Terrain pixel shaders Terrain1 (32), Terrain3 and Terrain3_pcf (96 each), same method (224 permutations checked).
+    const char kPixelShader[] = R"HLSL(
+// Waystone HD terrain pixel shader (ps_3_0). Replaces
+//   Terrain1      (SHADOW_MODE 0)    perm = 16*UNLIT_MASK + 8*BIG_ALPHA + 2*(LAYERS-1) + ENV_LAYER0
+//   Terrain3[_pcf](SHADOW_MODE 1..3) perm = 48*UNLIT_MASK + 24*BIG_ALPHA + 8*(SHADOW_MODE-1) + 2*(LAYERS-1) + ENV_LAYER0
+// PCF = 1 selects the Terrain3_pcf variant (hardware depth compare); 0 the R32F manual compare.
+// TEXCOORD7 comes from the HD vertex shader: rgb = the sun's light, w = the fog. With c16.x = 1 (Forever lighting) the sun is
+// cut fully by the shadow and the ambient (COLOR0) is left alone. c16.x = 0 (and rgb = 0) gives the 3.3.5 result exactly.
+// HD lights (hdLights): with c16.z = n > 0 the pixel shader adds n point lights (c17.., 4 registers each) the way WoW
+// Forever's light buffer does (lightbufferomni.bls), per pixel, from HD_POS = (position - camera, normal.x) and
+// TEXCOORD0.w = normal.y. Forever adds its light buffer in linear space: colour = albedo * (light^2.2 + buffer)^(1/2.2).
+// c16.z = 0 leaves the result exactly as without the lights.
+#ifndef LAYERS
+#define LAYERS 1
+#endif
+#ifndef ENV_LAYER0
+#define ENV_LAYER0 0
+#endif
+#ifndef BIG_ALPHA
+#define BIG_ALPHA 0
+#endif
+#ifndef UNLIT_MASK
+#define UNLIT_MASK 0
+#endif
+#ifndef SHADOW_MODE
+#define SHADOW_MODE 0
+#endif
+#ifndef PCF
+#define PCF 0
+#endif
+
+#define SAMPLE_BLEND (LAYERS > 1 || BIG_ALPHA || SHADOW_MODE < 2)
+// HD lights: where the vertex shader puts the position (TEXCOORD3 is free with a shadow, TEXCOORD5 without)
+#if SHADOW_MODE >= 1
+#define HD_POS TEXCOORD3
+#else
+#define HD_POS TEXCOORD5
+#endif
+#define HD_MAX_LIGHTS 4
+
+float4 cLayerLit     : register(c1);  // x,y,z,w = layer 0..3; 0 means layer is unlit (MCLY flag 0x80)
+float4 cFogColor     : register(c2);
+float4 cPcfOffset[8] : register(c3);  // xy = PCF tap offsets in shadow-map UV (c3..c10)
+float4 cHdPs         : register(c16); // HD: x = 1 Forever lighting, y = 1 test view (sun after shadow), z = point light count
+                                      // (0..4), w = 1 lights test view (only the point lights)
+float4 cHdLight[16]  : register(c17); // HD lights, 4 registers each (HdLights.h):
+                                      //  0: xyz = position - camera (world, yards), w = 1 legacy falloff 1/(0.7 d + 0.03 d^2)
+                                      //  1: rgb = colour A (near), w = attenuation start         (windowed falloff)
+                                      //  2: rgb = colour B (far),  w = 1 / (attenuation end - start)
+                                      //  3: x, y = colour blend t = saturate(d * x + y), z = cut radius, w = 1 / cut fade width
+
+#if ENV_LAYER0
+samplerCUBE sLayer0  : register(s0);
+#else
+sampler2D sLayer0    : register(s0);
+#endif
+#if LAYERS == 1
+sampler2D sBlend     : register(s1);
+#endif
+#if LAYERS >= 2
+sampler2D sLayer1    : register(s1);
+#endif
+#if LAYERS == 2
+sampler2D sBlend     : register(s2);
+#endif
+#if LAYERS >= 3
+sampler2D sLayer2    : register(s2);
+#endif
+#if LAYERS == 3
+sampler2D sBlend     : register(s3);
+#endif
+#if LAYERS >= 4
+sampler2D sLayer3    : register(s3);
+sampler2D sBlend     : register(s4);
+#endif
+#if SHADOW_MODE >= 1
+sampler2D sShadow0   : register(s5);  // m_extDynShadow (PC/NPC shadow, or near cascade in mode 3)
+#endif
+#if SHADOW_MODE >= 2
+sampler2D sShadow1   : register(s6);  // extShadowBand[0]
+sampler2D sShadow2   : register(s7);  // extShadowBand[1]
+sampler2D sShadow3   : register(s8);  // extShadowBand[2]
+#endif
+
+// one shadow tap at shadow-map UV uv for light-space depth z: 1 = lit, 0 = shadowed
+float Tap(sampler2D s, float2 uv, float z)
+{
+#if PCF
+    return tex2Dlod(s, float4(uv, z, 0.0)).x;
+#else
+    return step(z, tex2Dlod(s, float4(uv, 0.0, 0.0)).x);
+#endif
+}
+
+// centre + offsets 0,2,4,6 ; returns the SUM (0..5)
+float Sum5(sampler2D s, float2 c, float z)
+{
+    float2 uv = c * 0.5 + 0.5;
+    float sum = Tap(s, uv, z);
+    sum = sum + Tap(s, uv + cPcfOffset[0].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[2].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[4].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[6].xy, z);
+    return sum;
+}
+
+// centre + all 8 offsets ; returns the SUM (0..9)
+float Sum9(sampler2D s, float2 c, float z)
+{
+    float2 uv = c * 0.5 + 0.5;
+    float sum = Tap(s, uv, z);
+    sum = sum + Tap(s, uv + cPcfOffset[0].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[1].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[2].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[3].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[4].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[5].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[6].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[7].xy, z);
+    return sum;
+}
+
+// edge fades: 1 inside, 0 at |coord| >= 0.99 ; dyn fades over 0.70..0.99, band2 over 0.90..0.99
+float EdgeFade(float2 c)
+{
+    return saturate(max(abs(c.x), abs(c.y)) * -3.44827580 + 3.41379309);
+}
+float EdgeFade2(float2 c)
+{
+    return saturate(max(abs(c.x), abs(c.y)) * -11.1111107 + 11.0);
+}
+
+// One point light at camera-relative world position p, unit normal n: WoW Forever's lightbufferomni.bls maths
+// (permutation 1 = legacy falloff, permutation 0 = windowed falloff with a colour gradient), times our cut window.
+float3 HdPointLight(float3 p, float3 n, float4 l0, float4 l1, float4 l2, float4 l3)
+{
+    float3 l = l0.xyz - p;
+    float d2 = dot(l, l);
+    float inv = rsqrt(d2);
+    float d = inv * d2;
+    float nl = max(dot(l, n) * inv, 0.0);
+    float3 c;
+    if (l0.w > 0.5) {
+        c = l1.xyz * (nl / ((inv * 0.7 + 0.03) * d2));
+    } else {
+        float a = 1.0 - saturate((d - l1.w) * l2.w);
+        float t = saturate(d * l3.x + l3.y);
+        t = t * t * (3.0 - t * 2.0);
+        c = (l2.xyz + (l1.xyz - l2.xyz) * t) * (a * a * nl);
+    }
+    return c * saturate((l3.z - d) * l3.w);
+}
+
+// Forever: the light buffer is added in linear space to the light, then back (gamma path of terrain.bls)
+float3 HdCombine(float3 light, float3 buffer)
+{
+    return pow(pow(max(light, 0.0), 2.2) + buffer, 1.0 / 2.2);
+}
+
+void main(
+    float3 iDiffuse : COLOR0,
+    float3 iSpecular : COLOR1,
+    float4 iTex0 : TEXCOORD0,
+#if SHADOW_MODE >= 1
+#if LAYERS == 1
+#if SAMPLE_BLEND
+    float2 iTex1 : TEXCOORD1,
+#endif
+#else
+    float4 iTex1 : TEXCOORD1,
+#endif
+#if LAYERS == 3
+    float2 iTex2 : TEXCOORD2,
+#endif
+#if LAYERS == 4
+    float4 iTex2 : TEXCOORD2,
+#endif
+#if SHADOW_MODE == 1
+    float3 iShadow0 : TEXCOORD4,
+#else
+    float4 iShadow0 : TEXCOORD4,
+    float4 iShadow1 : TEXCOORD5,
+    float4 iShadow2 : TEXCOORD6,
+#endif
+#else
+    float2 iTex1 : TEXCOORD1,
+#if LAYERS >= 2
+    float2 iTex2 : TEXCOORD2,
+#endif
+#if LAYERS >= 3
+    float2 iTex3 : TEXCOORD3,
+#endif
+#if LAYERS >= 4
+    float2 iTex4 : TEXCOORD4,
+#endif
+#endif
+    float4 iHdPos : HD_POS,
+    float4 iDirect : TEXCOORD7,
+    out float4 oColor : COLOR0)
+{
+    // ---- texture coordinate sets (k = 0..LAYERS; set LAYERS is the blend/alpha texture)
+#if SHADOW_MODE >= 1
+#if SAMPLE_BLEND
+    float2 uv1 = iTex1.xy;
+#endif
+#if LAYERS >= 2
+    float2 uv2 = iTex1.wz;
+#endif
+#if LAYERS >= 3
+    float2 uv3 = iTex2.xy;
+#endif
+#if LAYERS >= 4
+    float2 uv4 = iTex2.wz;
+#endif
+#else
+    float2 uv1 = iTex1;
+#if LAYERS >= 2
+    float2 uv2 = iTex2;
+#endif
+#if LAYERS >= 3
+    float2 uv3 = iTex3;
+#endif
+#if LAYERS >= 4
+    float2 uv4 = iTex4;
+#endif
+#endif
+
+    // ---- layer textures
+#if ENV_LAYER0
+    float4 t0 = texCUBE(sLayer0, iTex0.xyz);
+#else
+    float4 t0 = tex2D(sLayer0, iTex0.xy);
+#endif
+#if LAYERS >= 2
+    float4 t1 = tex2D(sLayer1, uv1);
+#endif
+#if LAYERS >= 3
+    float4 t2 = tex2D(sLayer2, uv2);
+#endif
+#if LAYERS >= 4
+    float4 t3 = tex2D(sLayer3, uv3);
+#endif
+#if SAMPLE_BLEND
+#if LAYERS == 1
+    float4 a = tex2D(sBlend, uv1);
+#endif
+#if LAYERS == 2
+    float4 a = tex2D(sBlend, uv2);
+#endif
+#if LAYERS == 3
+    float4 a = tex2D(sBlend, uv3);
+#endif
+#if LAYERS == 4
+    float4 a = tex2D(sBlend, uv4);
+#endif
+#endif
+
+    // ---- shadow term S (1 = lit)
+#if SHADOW_MODE == 0
+    float S = a.w;
+#endif
+#if SHADOW_MODE == 1
+    float S = a.w;
+    float fade = EdgeFade(iShadow0.xy);
+    [branch] if (fade != 0.0) S = min(fade * (Sum5(sShadow0, iShadow0.xy, iShadow0.z) * 0.2 - 1.0) + 1.0, a.w);
+#endif
+#if SHADOW_MODE == 2
+    float dyn = 1.0;
+    float fade = EdgeFade(iShadow0.xy);
+    [branch] if (fade != 0.0) dyn = fade * (Sum5(sShadow0, iShadow0.xy, iShadow0.z) * 0.2 - 1.0) + 1.0;
+    float band;
+    [branch] if (max(abs(iShadow1.x), abs(iShadow1.y)) < 1.0) {
+        band = Sum5(sShadow1, iShadow1.xy, iShadow1.z) * 0.2;
+    } else {
+        [branch] if (max(abs(iShadow2.x), abs(iShadow2.y)) < 1.0) {
+            band = Sum5(sShadow2, iShadow2.xy, iShadow2.z) * 0.2;
+        } else {
+            float3 c3 = float3(iShadow0.w, iShadow1.w, iShadow2.w);
+            band = EdgeFade2(c3.xy) * (Sum5(sShadow3, c3.xy, c3.z) * 0.2 - 1.0) + 1.0;
+        }
+    }
+    float S = min(band, dyn);
+#endif
+#if SHADOW_MODE == 3
+    float S;
+    [branch] if (EdgeFade(iShadow0.xy) != 0.0) {
+        S = Sum9(sShadow0, iShadow0.xy, iShadow0.z) * 0.111111112;
+    } else {
+        [branch] if (max(abs(iShadow1.x), abs(iShadow1.y)) < 1.0) {
+            S = Sum5(sShadow1, iShadow1.xy, iShadow1.z) * 0.2;
+        } else {
+            [branch] if (max(abs(iShadow2.x), abs(iShadow2.y)) < 1.0) {
+                S = Sum5(sShadow2, iShadow2.xy, iShadow2.z) * 0.2;
+            } else {
+                float3 c3 = float3(iShadow0.w, iShadow1.w, iShadow2.w);
+                S = EdgeFade2(c3.xy) * (Sum5(sShadow3, c3.xy, c3.z) * 0.2 - 1.0) + 1.0;
+            }
+        }
+    }
+#endif
+
+    // ---- HD lights: Forever's light buffer for this pixel
+    float3 buffer = float3(0.0, 0.0, 0.0);
+    [branch] if (cHdPs.z > 0.5) {
+        float3 nw = float3(iHdPos.w, iTex0.w, sqrt(saturate(1.0 - iHdPos.w * iHdPos.w - iTex0.w * iTex0.w)));
+        nw = normalize(nw);
+        buffer = buffer + HdPointLight(iHdPos.xyz, nw, cHdLight[0], cHdLight[1], cHdLight[2], cHdLight[3]);
+        [branch] if (cHdPs.z > 1.5) {
+            buffer = buffer + HdPointLight(iHdPos.xyz, nw, cHdLight[4], cHdLight[5], cHdLight[6], cHdLight[7]);
+            [branch] if (cHdPs.z > 2.5) {
+                buffer = buffer + HdPointLight(iHdPos.xyz, nw, cHdLight[8], cHdLight[9], cHdLight[10], cHdLight[11]);
+                [branch] if (cHdPs.z > 3.5) {
+                    buffer = buffer + HdPointLight(iHdPos.xyz, nw, cHdLight[12], cHdLight[13], cHdLight[14], cHdLight[15]);
+                }
+            }
+        }
+    }
+
+    // ---- per-layer vertex lighting (only in the unlit-mask variants)
+#if UNLIT_MASK
+    float3 lit2 = (iDiffuse + iDirect.xyz * S) * 2.0;
+    [branch] if (cHdPs.z > 0.5) lit2 = HdCombine(lit2, buffer);
+    if (cLayerLit.x != 0.0) t0.xyz = t0.xyz * lit2;
+#if LAYERS >= 2
+    if (cLayerLit.y != 0.0) t1.xyz = t1.xyz * lit2;
+#endif
+#if LAYERS >= 3
+    if (cLayerLit.z != 0.0) t2.xyz = t2.xyz * lit2;
+#endif
+#if LAYERS >= 4
+    if (cLayerLit.w != 0.0) t3.xyz = t3.xyz * lit2;
+#endif
+#endif
+
+    // ---- layer blend (rgb = albedo, a = specular mask)
+#if BIG_ALPHA
+    float4 b = t0 * (1.0 - saturate(dot(a.xyz, float3(1.0, 1.0, 1.0))));
+#if LAYERS >= 2
+    b = b + t1 * a.x;
+#endif
+#if LAYERS >= 3
+    b = b + t2 * a.y;
+#endif
+#if LAYERS >= 4
+    b = b + t3 * a.z;
+#endif
+#else
+    float4 b = t0;
+#if LAYERS >= 2
+    b = lerp(b, t1, a.x);
+#endif
+#if LAYERS >= 3
+    b = lerp(b, t2, a.y);
+#endif
+#if LAYERS >= 4
+    b = lerp(b, t3, a.z);
+#endif
+#endif
+
+    // ---- combine. f = what the shadow leaves of COLOR0: 3.3.5 keeps 70% in shadow, Forever keeps the ambient whole.
+    float3 spec = b.w * iSpecular;
+    float f = lerp(S * 0.3 + 0.7, 1.0, cHdPs.x);
+#if UNLIT_MASK
+    float3 col = b.xyz * f + S * spec;
+#else
+    float3 col = b.xyz * (iDiffuse * f + iDirect.xyz * S);
+    col = col + col;
+    [branch] if (cHdPs.z > 0.5) col = b.xyz * HdCombine((iDiffuse * f + iDirect.xyz * S) * 2.0, buffer);
+    col = spec * S + col;
+#endif
+    float fog = iDirect.w;
+    oColor = float4((col - cFogColor.xyz) * fog + cFogColor.xyz, 1.0);
+    // HD: test view (hdTerrainLight 3): only the sun after the shadow, no texture, no ambient, no fog
+    if (cHdPs.y > 0.5) oColor = float4(iDirect.xyz * S * 2.0, 1.0);
+    // HD: lights test view (hdLights 3): only the point lights (gamma encoded), no texture, no fog
+    if (cHdPs.w > 0.5) oColor = float4(pow(buffer, 1.0 / 2.2), 1.0);
+}
+)HLSL";
+
+    typedef HRESULT(WINAPI* D3DCompileFn)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*, LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+
+    // Families of compiled code: 0 = vertex (128), 1 = Terrain1 (32), 2 = Terrain3 (96), 3 = Terrain3_pcf (96)
+    const int32_t kFamilyCount[4] = { 128, 32, 96, 96 };
+    const int32_t kOursMark = 0x4844544C; // 'HDTL' in CGxShader::unused_0028: the shader holds our code
+
+    enum { StateIdle, StateCompiling, StateReady, StateFailed };
+
+    std::atomic<int32_t> s_state(StateIdle);
+    std::vector<uint8_t> s_code[4][128];     // written by the compile thread before s_state = StateReady
+    char s_threadInfo[260] = "";             // written by the compile thread before s_state changes to Ready/Failed
+    int32_t s_shownState = -1;
+    int32_t s_inUse = 0;                     // shaders holding our code right now (shown in hdTerrainInfo)
+
+    std::map<CGxShader*, std::vector<uint8_t> > s_original; // Blizzard's code of each shader we changed
+    struct Retired { IUnknown* object; ULONGLONG time; };
+    std::vector<Retired> s_retired;          // D3D shaders we replaced, released a little later (may still be bound)
+
+    CVar* s_light = nullptr;
+    CVar* s_hemi = nullptr;
+    CVar* s_ambient = nullptr;
+    CVar* s_info = nullptr;
+
+    void RegisterCVars() {
+        static bool registered = false;
+        if (registered) return;
+        registered = true;
+        HD::ShaderCVars(); // HD: hdShaderDump
+        s_light = CVar::Register("hdTerrainLight", "HD: 1 = WoW Forever terrain lighting, 2 = our shaders with 3.3.5 lighting, 3 = test view (sun after shadow only), 0 = Blizzard shaders", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_ambient = CVar::Register("hdLightAmbient", "HD: ambient strength on the ground in Forever lighting, 1 = Forever's (test only)", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_hemi = CVar::Register("hdTerrainHemi", "HD test: 1 = Forever hemisphere ambient, 0 = none (horizon = ground = sky), 2 = ratios frozen", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_info = CVar::Register("hdTerrainInfo", "HD: hdTerrainLight status (read only)", 0, "not started", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    }
+
+    float Clamp(float v, float lo, float hi) {
+        return v < lo ? lo : (v > hi ? hi : v);
+    }
+
+    // Forever's sky, horizon and ground ambient for one light: clear weather blended to storm like hdFog does.
+    bool LightAmbients(const LightRec* light, int32_t time, float storm, float (*amb)[3]) {
+        if (!HD::ForeverAmbientsAt(light, 0, time, amb[0], amb[1], amb[2])) return false;
+        float stormAmb[3][3];
+        if (storm > 0.0f && HD::ForeverAmbientsAt(light, 2, time, stormAmb[0], stormAmb[1], stormAmb[2])) {
+            for (int32_t k = 0; k < 3; k++) {
+                for (int32_t c = 0; c < 3; c++) amb[k][c] += (stormAmb[k][c] - amb[k][c]) * storm;
+            }
+        }
+        return true;
+    }
+
+    // The horizon / sky and ground / sky ratios (per channel) of Forever's ambients where the camera is: the zone
+    // light, then the nearby area lights blended in by distance, nearest last (same walk as hdFog's fog). The shader
+    // multiplies the client's ambient (the sky colour) by them, so with hdForeverLight 1 it gets Forever's own horizon
+    // and ground colours. A light Forever has no setting for counts as horizon = ground = sky (no hemisphere).
+    void CurrentHemisphere(float* horizon, float* ground) {
+        float amb[3][3] = { { 1.0f, 1.0f, 1.0f }, { 1.0f, 1.0f, 1.0f }, { 1.0f, 1.0f, 1.0f } };
+        const DayNight::DNInfo& info = DayNight::g_dnInfo;
+        const TSGrowableArray<const LightRec*>& lights = DayNight::g_areaLights;
+        if (lights.m_count) {
+            int32_t time = static_cast<int32_t>(info.m_dayProgression * 2880.0f);
+            float storm = info.m_stormBlend;
+            float none[3][3] = { { 1.0f, 1.0f, 1.0f }, { 1.0f, 1.0f, 1.0f }, { 1.0f, 1.0f, 1.0f } };
+            if (!LightAmbients(lights.m_data[0], time, storm, amb)) memcpy(amb, none, sizeof(amb));
+
+            struct Near { const LightRec* light; float distSq; float weight; };
+            Near nearLights[32];
+            int32_t count = 0;
+            for (uint32_t i = 1; i < lights.m_count && count < 32; i++) {
+                const LightRec* light = lights.m_data[i];
+                float dx = info.m_lightRefPos.x - light->m_gameCoords[0];
+                float dy = info.m_lightRefPos.y - light->m_gameCoords[1];
+                float dz = info.m_lightRefPos.z - light->m_gameCoords[2];
+                float distSq = dx * dx + dy * dy + dz * dz;
+                if (distSq >= light->m_gameFalloffEnd * light->m_gameFalloffEnd) continue;
+                float distance = sqrtf(distSq);
+                float weight = 1.0f;
+                if (distance > light->m_gameFalloffStart) {
+                    float span = light->m_gameFalloffEnd - light->m_gameFalloffStart;
+                    weight = span > 0.0f ? Clamp(1.0f - (distance - light->m_gameFalloffStart) / span, 0.0f, 1.0f) : 0.0f;
+                }
+                if (weight <= 0.0f) continue;
+                nearLights[count].light = light;
+                nearLights[count].distSq = distSq;
+                nearLights[count].weight = weight;
+                count++;
+            }
+            for (int32_t i = 1; i < count; i++) {
+                Near n = nearLights[i];
+                int32_t j = i - 1;
+                while (j >= 0 && nearLights[j].distSq < n.distSq) { nearLights[j + 1] = nearLights[j]; j--; }
+                nearLights[j + 1] = n;
+            }
+            for (int32_t i = 0; i < count; i++) {
+                float other[3][3];
+                if (!LightAmbients(nearLights[i].light, time, storm, other)) memcpy(other, none, sizeof(other));
+                float w = nearLights[i].weight;
+                for (int32_t k = 0; k < 3; k++) {
+                    for (int32_t c = 0; c < 3; c++) amb[k][c] += (other[k][c] - amb[k][c]) * w;
+                }
+            }
+        }
+        for (int32_t c = 0; c < 3; c++) {
+            // a channel Forever leaves at 0 in the sky colour has no ratio: keep the sky's (1)
+            horizon[c] = amb[0][c] > 0.001f ? Clamp(amb[1][c] / amb[0][c], 0.0f, 4.0f) : 1.0f;
+            ground[c] = amb[0][c] > 0.001f ? Clamp(amb[2][c] / amb[0][c], 0.0f, 4.0f) : 1.0f;
+        }
+    }
+
+    // HD: the light walk is per frame, not per chunk or per building batch: redo it at most every 50 ms
+    // (shared by the terrain and the buildings, HdMapObj.cpp)
+    ULONGLONG s_hemiTime = 0;
+    float s_horizonRatio[3] = { 1.0f, 1.0f, 1.0f };
+    float s_groundRatio[3] = { 1.0f, 1.0f, 1.0f };
+
+    void RefreshHemisphere() {
+        ULONGLONG now = GetTickCount64();
+        if (s_hemiTime && now - s_hemiTime < 50) return;
+        s_hemiTime = now;
+        int32_t hemi = s_hemi ? s_hemi->m_intValue : 1;
+        if (hemi == 2) return; // HD test: keep the last ratios
+        CurrentHemisphere(s_horizonRatio, s_groundRatio);
+        if (hemi == 0) {
+            for (int32_t c = 0; c < 3; c++) s_horizonRatio[c] = s_groundRatio[c] = 1.0f;
+        }
+    }
+
+    void Decode(int32_t family, int32_t p, D3D_SHADER_MACRO* macros, char (*values)[4]) {
+        const char* names[6];
+        int32_t v[6];
+        int32_t n = 6;
+        if (family == 0) {
+            names[0] = "SHADOW";       v[0] = p & 1;
+            names[1] = "ENV_LAYER0";   v[1] = (p >> 1) & 1;
+            names[2] = "VERTEX_COLOR"; v[2] = (p >> 2) & 1;
+            names[3] = "SPECULAR";     v[3] = (p >> 3) & 1;
+            names[4] = "LAYERS";       v[4] = ((p >> 4) & 3) + 1;
+            names[5] = "POINT_LIGHTS"; v[5] = (p >> 6) & 1;
+        } else if (family == 1) {
+            names[0] = "ENV_LAYER0";   v[0] = p & 1;
+            names[1] = "LAYERS";       v[1] = ((p >> 1) & 3) + 1;
+            names[2] = "BIG_ALPHA";    v[2] = (p >> 3) & 1;
+            names[3] = "UNLIT_MASK";   v[3] = (p >> 4) & 1;
+            names[4] = "SHADOW_MODE";  v[4] = 0;
+            names[5] = "PCF";          v[5] = 0;
+        } else {
+            names[0] = "ENV_LAYER0";   v[0] = p & 1;
+            names[1] = "LAYERS";       v[1] = ((p >> 1) & 3) + 1;
+            names[2] = "SHADOW_MODE";  v[2] = (p % 24) / 8 + 1;
+            names[3] = "BIG_ALPHA";    v[3] = (p % 48) / 24;
+            names[4] = "UNLIT_MASK";   v[4] = p / 48;
+            names[5] = "PCF";          v[5] = family == 3;
+        }
+        for (int32_t i = 0; i < n; i++) {
+            snprintf(values[i], 4, "%d", v[i]);
+            macros[i].Name = names[i];
+            macros[i].Definition = values[i];
+        }
+        macros[n].Name = nullptr;
+        macros[n].Definition = nullptr;
+    }
+
+    // Compile thread: every permutation, all or nothing.
+    void CompileAll() {
+        ULONGLONG start = GetTickCount64();
+        HMODULE module = LoadLibraryA("d3dcompiler_47.dll");
+        D3DCompileFn compile = module ? reinterpret_cast<D3DCompileFn>(GetProcAddress(module, "D3DCompile")) : nullptr;
+        if (!compile) {
+            snprintf(s_threadInfo, sizeof(s_threadInfo), "ERROR: d3dcompiler_47.dll not found, Blizzard shaders kept");
+            s_state.store(StateFailed);
+            return;
+        }
+        static const char* kFamilyName[4] = { "Terrain (vertex)", "Terrain1", "Terrain3", "Terrain3_pcf" };
+        int32_t total = 0;
+        for (int32_t family = 0; family < 4; family++) {
+            for (int32_t p = 0; p < kFamilyCount[family]; p++) {
+                D3D_SHADER_MACRO macros[7];
+                char values[6][4];
+                Decode(family, p, macros, values);
+                const char* source = family == 0 ? kVertexShader : kPixelShader;
+                ID3DBlob* code = nullptr;
+                ID3DBlob* errors = nullptr;
+                HRESULT hr = compile(source, strlen(source), family == 0 ? "HdTerrainVS" : "HdTerrainPS", macros, nullptr, "main", family == 0 ? "vs_3_0" : "ps_3_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+                if (FAILED(hr) || !code) {
+                    snprintf(s_threadInfo, sizeof(s_threadInfo), "ERROR: %s %d: %s", kFamilyName[family], p, errors ? static_cast<const char*>(errors->GetBufferPointer()) : "unknown");
+                    if (errors) errors->Release();
+                    if (code) code->Release();
+                    s_state.store(StateFailed);
+                    return;
+                }
+                if (errors) errors->Release();
+                const uint8_t* bytes = static_cast<const uint8_t*>(code->GetBufferPointer());
+                s_code[family][p].assign(bytes, bytes + code->GetBufferSize());
+                HD::ShaderDump("HdTerrain", family != 0, family, p, bytes, code->GetBufferSize()); // HD: hdShaderDump
+                code->Release();
+                total++;
+            }
+        }
+        snprintf(s_threadInfo, sizeof(s_threadInfo), "%d shaders compiled in %u ms", total, static_cast<uint32_t>(GetTickCount64() - start));
+        s_state.store(StateReady);
+    }
+
+    void ShowState(int32_t state) {
+        s_shownState = state;
+        if (!s_info) return;
+        char text[300];
+        if (state == StateCompiling) snprintf(text, sizeof(text), "compiling (Blizzard shaders until done)");
+        else if (state == StateIdle) snprintf(text, sizeof(text), "not started");
+        else if (state == StateReady) snprintf(text, sizeof(text), "%s, %d in use", s_threadInfo, s_inUse);
+        else snprintf(text, sizeof(text), "%s", s_threadInfo);
+        s_info->Set(text, true, false, false, false);
+    }
+
+    void ReleaseRetired(bool all) {
+        if (s_retired.empty()) return;
+        ULONGLONG now = GetTickCount64();
+        size_t kept = 0;
+        for (size_t i = 0; i < s_retired.size(); i++) {
+            if (all || now - s_retired[i].time > 2000) s_retired[i].object->Release();
+            else s_retired[kept++] = s_retired[i];
+        }
+        s_retired.resize(kept);
+    }
+
+    // New code for this shader; its D3D object is made again from it the next time it is bound.
+    void SetCode(CGxShader* shader, const uint8_t* data, uint32_t size) {
+        if (shader->m_apiSpecific && HD::ShaderObjectOwnedByDevice()) {
+            shader->m_apiSpecific = nullptr; // HD: Vulkan: the translator's record, the device's own
+        }
+        if (shader->m_apiSpecific) {
+            // the device may still have it bound for this frame: release it a little later
+            Retired retired = { static_cast<IUnknown*>(shader->m_apiSpecific), GetTickCount64() };
+            s_retired.push_back(retired);
+            shader->m_apiSpecific = nullptr;
+        }
+        shader->m_loaded = 0;
+        shader->m_valid = 0;
+        shader->m_code.SetCount(size);
+        memcpy(shader->m_code.m_data, data, size);
+    }
+}
+
+void HD::TerrainShadersStart() {
+    RegisterCVars();
+    int32_t expected = StateIdle;
+    if (!s_state.compare_exchange_strong(expected, StateCompiling)) return;
+    std::thread(CompileAll).detach();
+}
+
+void HD::TerrainShader(CGxShader* shader, int32_t kind, int32_t permutation) {
+    if (!shader) return;
+    RegisterCVars();
+    int32_t state = s_state.load();
+    if (state != s_shownState) ShowState(state);
+
+    bool want = state == StateReady && s_light && s_light->m_intValue != 0;
+    bool ours = shader->unused_0028 == kOursMark;
+    if (want == ours) return;
+
+    ReleaseRetired(false);
+    if (!HD::ShaderSwapDevice()) return; // HD: D3D9, or Vulkan through the translated modules
+
+    if (!want) {
+        std::map<CGxShader*, std::vector<uint8_t> >::iterator it = s_original.find(shader);
+        if (it != s_original.end() && !it->second.empty()) SetCode(shader, &it->second[0], static_cast<uint32_t>(it->second.size()));
+        shader->unused_0028 = 0;
+        s_inUse--;
+        ShowState(state);
+        return;
+    }
+
+    int32_t family = kind == HD::TerrainVertex ? 0 : (kind == HD::TerrainPixel1 ? 1 : 2);
+    if (family == 2 && shader->m_key.m_str && strstr(shader->m_key.m_str, "_pcf")) family = 3;
+    if (permutation < 0 || permutation >= kFamilyCount[family]) return;
+
+    // Only over the shader model 3 code (a ps_2_x or OpenGL device keeps Blizzard's shaders)
+    uint32_t version = family == 0 ? 0xFFFE0300u : 0xFFFF0300u;
+    if (shader->m_code.Count() < 4 || *reinterpret_cast<const uint32_t*>(shader->m_code.m_data) != version) return;
+    const std::vector<uint8_t>& code = s_code[family][permutation];
+    if (code.size() < 4) return;
+    if (!HD::ShaderKnown(&code[0], code.size())) return; // HD: Vulkan without its translated module: Blizzard's
+
+    s_original[shader].assign(shader->m_code.m_data, shader->m_code.m_data + shader->m_code.Count());
+    SetCode(shader, &code[0], static_cast<uint32_t>(code.size()));
+    shader->unused_0028 = kOursMark;
+    s_inUse++;
+    ShowState(state);
+}
+
+void HD::TerrainVertexConstants(const CAaSphere* sphere, CM2Scene* scene, const C3Vector* camera) {
+    RegisterCVars();
+    if (!g_theGxDevicePtr) return;
+    RefreshHemisphere(); // HD: shared with the buildings (HD::TerrainHemisphere)
+
+    float constants[20];
+    constants[0] = 0.0f;
+    constants[1] = 0.0f;
+    int32_t mode = s_light ? s_light->m_intValue : 1;
+    constants[2] = mode == 1 || mode == 3 ? 1.0f : 0.0f; // Forever lighting
+    constants[3] = mode == 3 ? 1.0f : 0.0f;              // test view
+    constants[4] = HD::LightAmbientStrength();
+    constants[5] = 0.0f;
+    constants[6] = 0.0f;
+    constants[7] = 0.0f;
+    for (int32_t c = 0; c < 3; c++) {
+        constants[8 + c] = s_horizonRatio[c];
+        constants[12 + c] = s_groundRatio[c];
+    }
+    constants[11] = 0.0f;
+    constants[15] = 0.0f;
+    // HD: hdLights, per-pixel point lights only with Forever lighting (the pixel shader then does them, so the vertex
+    // shader leaves its 3 per-vertex ones out of the ambient: c53.w = 1); c53.xyz = the origin of the light positions
+    int32_t lights = mode == 1 ? HD::LightsMode() : 0;
+    bool perPixel = (lights == 1 || lights == 3) && sphere && scene && camera;
+    constants[16] = camera ? camera->x : 0.0f;
+    constants[17] = camera ? camera->y : 0.0f;
+    constants[18] = camera ? camera->z : 0.0f;
+    constants[19] = perPixel ? 1.0f : 0.0f;
+    g_theGxDevicePtr->ShaderConstantsSet(GxSh_Vertex, 49, constants, 5);
+    if (mode == 0) return; // HD: Blizzard's shaders read no pixel constant of ours
+
+    // HD: pixel c16 = (Forever lighting, test view, point light count, lights test view), c17.. = the lights
+    float pixel[4 + 16 * HD::kLightsMax];
+    int32_t count = perPixel ? HD::LightsForSphere(scene, *camera, *sphere, pixel + 4) : 0;
+    pixel[0] = constants[2];
+    pixel[1] = constants[3];
+    pixel[2] = static_cast<float>(count);
+    pixel[3] = perPixel && lights == 3 ? 1.0f : 0.0f;
+    HD::PixelConstantsSet(16, pixel, 1 + 4 * count); // HD: also the vertex rows the Vulkan modules read
+}
+
+// HD: the horizon / sky and ground / sky ratios the terrain uses now, for the buildings (HdMapObj.cpp)
+void HD::TerrainHemisphere(float* horizon, float* ground) {
+    RefreshHemisphere();
+    for (int32_t c = 0; c < 3; c++) {
+        horizon[c] = s_horizonRatio[c];
+        ground[c] = s_groundRatio[c];
+    }
+}
+
+// HD: hdLightAmbient (ambient strength in Forever lighting), for the terrain and the buildings
+float HD::LightAmbientStrength() {
+    RegisterCVars();
+    return s_ambient ? Clamp(s_ambient->m_floatValue, 0.0f, 2.0f) : 1.0f;
+}
diff --git a/WoW/Source/WorldClient/HD/HdTerrain.h b/WoW/Source/WorldClient/HD/HdTerrain.h
new file mode 100644
index 00000000..2b802e0d
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdTerrain.h
@@ -0,0 +1,54 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDTERRAIN_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDTERRAIN_H
+
+// Waystone HD: our own terrain shaders (not part of the original client).
+// They are the 3.3.5 terrain shaders rewritten in HLSL (checked against Blizzard's bytecode for all 128 vertex and
+// 224 pixel permutations), compiled when the game starts, with WoW Forever's terrain lighting added:
+//   - the ambient comes from three colours: sky (ground facing up), horizon (walls), ground (overhangs);
+//     the client's ambient is the sky colour, horizon and ground are it times Forever's own horizon / sky and
+//     ground / sky (LightData HorizonAmbientColor, GroundAmbientColor at this hour, forever_data\hd_forever_ambient.txt),
+//     so with hdForeverLight 1 the three colours are exactly Forever's;
+//   - a soft wrap of the sun over that ambient (x0.7 facing away from the sun .. x1.1 facing it);
+//   - the sun is cut fully by the shadow, the ambient is not touched by it (3.3.5 darkens everything to 70%).
+//   hdTerrainLight 1 = Forever lighting (default)
+//                  2 = our shaders with the 3.3.5 lighting: must look exactly like 0 (proves the swap changes nothing)
+//                  3 = test view: only the sun after the shadow (black in shadow), proves our shader is the one drawing
+//                  0 = Blizzard's shaders
+//   hdLightAmbient ambient strength in Forever lighting, 1 = Forever's (a test knob, keep it at 1)
+//   hdTerrainInfo  read only, compile result and how many shaders hold our code:  /run print(GetCVar("hdTerrainInfo"))
+//   hdLights (HdLights.h) with hdTerrainLight 1: lamps and fires light the ground per pixel, WoW Forever's maths
+
+#include <cstdint>
+
+class C3Vector;     // HD: hdLights
+class CAaSphere;
+class CGxShader;
+class CM2Scene;
+
+namespace HD {
+    enum TerrainShaderKind {
+        TerrainVertex = 0,   // CMap::vertexShader_Terrain[128]
+        TerrainPixel1 = 1,   // CMap::pixelShader_Terrain1[32] (no dynamic shadow)
+        TerrainPixel3 = 2,   // CMap::pixelShader_Terrain3[96] (Terrain3 or Terrain3_pcf, read from the shader's name)
+    };
+
+    // Starts compiling our terrain shaders on a background thread (once; called from CMap::Initialize).
+    void TerrainShadersStart();
+
+    // Called where the client picks a terrain shader: gives it our code or Blizzard's, to match hdTerrainLight.
+    void TerrainShader(CGxShader* shader, int32_t kind, int32_t permutation);
+
+    // Sets vertex constants c49..c53 and pixel constants c16.. for our shaders (called after the client's per-chunk
+    // terrain constants). HD: hdLights picks the point lights for the chunk's sphere from the scene's lights, with
+    // positions relative to camera (CWorldScene::s_activeWorldView).
+    void TerrainVertexConstants(const CAaSphere* sphere, CM2Scene* scene, const C3Vector* camera);
+
+    // Forever's horizon / sky and ground / sky ambient ratios (per channel) where the camera is, the ones the terrain
+    // uses (redone at most every 50 ms); also used by the buildings (HdMapObj.cpp).
+    void TerrainHemisphere(float* horizon, float* ground);
+
+    // hdLightAmbient: ambient strength in Forever lighting (1 = Forever's), for the terrain and the buildings.
+    float LightAmbientStrength();
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdTime.cpp b/WoW/Source/WorldClient/HD/HdTime.cpp
new file mode 100644
index 00000000..8cdd5125
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdTime.cpp
@@ -0,0 +1,59 @@
+#include "WoW/Source/WorldClient/HD/HdTime.h"
+#include "WoW/Source/WorldClient/DayNight__DNInfo.h"
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+
+namespace {
+    CVar* s_hdTime = nullptr;
+    CVar* s_hdSunPath = nullptr;
+    CVar* s_hdShadowSun = nullptr;
+    CVar* s_hdShadowBillboard = nullptr;
+
+    void RegisterCVars() {
+        static bool registered = false;
+        if (registered) return;
+        registered = true;
+        s_hdTime = CVar::Register("hdTime", "HD: -1 = real time, 0 to 24 = force this hour on this screen only", 1, "-1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_hdSunPath = CVar::Register("hdSunPath", "HD: 0 = original sun, 1 = the sun sits where the world light comes from (like WoW Forever)", 1, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_hdShadowSun = CVar::Register("hdShadowSun", "HD: 0 = original short shadows, 1 = shadows cast at the real sun height (long at dawn and dusk, like WoW Forever)", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_hdShadowBillboard = CVar::Register("hdShadowBillboard", "HD: 0 = original tree shadows (turn with the camera), 1 = tree leaf cards face the sun in the shadows (still), 2 = test: leaf cards cast no shadow", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    }
+
+    // Forced minutes since midnight (0 to 1439), or -1 when the override is off.
+    int32_t ForcedMinutes() {
+        RegisterCVars();
+        if (!s_hdTime) return -1;
+        float hours = s_hdTime->m_floatValue;
+        if (hours < 0.0f) return -1;
+        if (hours >= 24.0f) hours = 0.0f;
+        int32_t minutes = static_cast<int32_t>(hours * 60.0f + 0.5f);
+        return minutes >= 1440 ? 0 : minutes;
+    }
+}
+
+void HD::ApplyTimeOverride(DayNight::DNInfo* info) {
+    int32_t minutes = ForcedMinutes();
+    if (minutes < 0 || !info) return;
+    info->m_timeOfDay = static_cast<uint32_t>(minutes);
+    info->m_dayProgression = minutes * (1.0f / 1440.0f);
+}
+
+int32_t HD::OverrideMinutes(int32_t realMinutes) {
+    int32_t minutes = ForcedMinutes();
+    return minutes < 0 ? realMinutes : minutes;
+}
+
+bool HD::SunFollowsLight() {
+    RegisterCVars();
+    return s_hdSunPath && s_hdSunPath->m_intValue != 0;
+}
+
+float HD::ShadowHeightScale() {
+    RegisterCVars();
+    return s_hdShadowSun && s_hdShadowSun->m_intValue != 0 ? 1.0f : 5.0f;
+}
+
+int32_t HD::ShadowBillboardMode() {
+    RegisterCVars();
+    return s_hdShadowBillboard ? s_hdShadowBillboard->m_intValue : 0;
+}
diff --git a/WoW/Source/WorldClient/HD/HdTime.h b/WoW/Source/WorldClient/HD/HdTime.h
new file mode 100644
index 00000000..cac8a68e
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdTime.h
@@ -0,0 +1,37 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDTIME_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDTIME_H
+
+// Waystone HD: client-side time-of-day override (not part of the original client).
+//   hdTime   -1 = real server time (default)
+//            0 to 24 = force this hour on this screen only, e.g. 12 = noon, 18.5 = 18:30
+//   hdSunPath 0 = original sun (north-west, under the horizon before 5:30 and after 21:30)
+//             1 = by day (4:50 to 22:10) the sun sits where the world light comes from (north-west, 20 to 37
+//                 degrees up), like WoW Forever's sun; the sun rays and the fog glow then match the lighting
+//   hdShadowSun 0 = original shadows: the client casts them 5x steeper than the light (always short)
+//               1 = shadows cast at the light's real height (20 to 37 degrees: long, like WoW Forever)
+
+#include <cstdint>
+
+namespace DayNight { struct DNInfo; }
+
+namespace HD {
+    // Called from CGWorldFrame::UpdateDayNight after the real time has been written into info.
+    void ApplyTimeOverride(DayNight::DNInfo* info);
+
+    // Minutes since midnight to use for skybox animations: the override if active, else realMinutes.
+    int32_t OverrideMinutes(int32_t realMinutes);
+
+    // hdSunPath 1: put the sun where the world light comes from (DayNight::SetPlanets).
+    bool SunFollowsLight();
+
+    // hdShadowSun: how much CShadowQuery::Update steepens the light for the shadow maps (5 = original, 1 = real).
+    float ShadowHeightScale();
+
+    // hdShadowBillboard: billboarded M2 parts (tree leaf cards) in the shadow maps.
+    //   0 = original (they face the camera, so their shadow turns with the camera)
+    //   1 = they face the sun during the shadow pass (shadow stays still)
+    //   2 = test: they cast no shadow at all
+    int32_t ShadowBillboardMode();
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdWater.cpp b/WoW/Source/WorldClient/HD/HdWater.cpp
new file mode 100644
index 00000000..6e95f783
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdWater.cpp
@@ -0,0 +1,1426 @@
+#include "WoW/Source/WorldClient/HD/HdWater.h"
+#include "WoW/Source/WorldClient/HD/HdWaterPlanar.h" // HD: hdWaterPlanar
+#include <atomic>
+#include <cctype>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <thread>
+#include <vector>
+#include <windows.h>
+#include <d3d9.h>
+#include <d3dcompiler.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDevice/CGxShader.h"
+#include "Engine/Source/Gx/CGxDeviceD3d/CGxDeviceD3d.h"
+#include "Engine/Source/Gx/Types.h"
+#include "Engine/Source/Os/TimeManager.h"
+#include "WoW/Source/LiquidSystem/Liquid.h"
+#include "WoW/Source/WorldClient/DayNight.h"
+#include "WoW/Source/WorldClient/DayNight__DNInfo.h"
+#include "WoW/Source/WorldClient/HD/HdFog.h"
+#include "WoW/Source/WorldClient/HD/HdWaterWaves.h"
+#include "WoW/Source/WorldClient/HD/HdWaterRipples.h" // HD: ripples around swimmers and waders
+
+// HD: the shader sources below are the files of the same name (scratchpad water/impl/shaders); HdWater.cpp is made
+// from HdWater.cpp.in by embed_shaders.py, so edit the .hlsl files and run it again rather than editing them here.
+
+namespace {
+    // Vertex shader (vs_3_0): vsLiquidProcWater rewritten from its bytecode (checked against it: every output equal
+    // on 1200 random vertices, all 4 permutations), plus the view-space position for the pixel shader.
+    const char* kVertexShader =
+R"HLSL(// Waystone HD water vertex shader (vs_3_0). Replaces Shaders\Vertex\vs_3_0\vsLiquidProcWater.bls (its 4
+// permutations are the same code) when hdWater is on. Outputs 0..8 are the 3.3.5 shader rewritten from its bytecode,
+// instruction for instruction (checked numerically against Blizzard's bytecode); TEXCOORD7 is new:
+//   xyz = view-space position (camera at 0, +z forward, the same space as the projection), w = 3.3.5 wave height here.
+// Constants: the client's own (Liquid::SetShaderConstants c0..c45, the wave block at c46..c57); nothing new.
+float4 cProj[4]      : register(c0);   // rows of the native projection
+float4 cFog          : register(c4);   // x = -fogMul/(end-start), y = end/(end-start), z = density exponent
+float4 cModelView[4] : register(c5);   // rows of (model, camera-relative) * view
+float4 cTex[24]      : register(c9);   // 6 texture matrices, 4 rows each (c9 .. c32)
+float4 cPhaseA       : register(c46);  // per wave phase, first wave set (radians)
+float4 cPhaseB       : register(c47);  // per wave phase, second wave set
+float4 cWaveA[3]     : register(c48);  // first set: xy = centre, z = 1 / wavelength, w = amplitude
+float4 cWaveAFall    : register(c51);  // first set: 1 / falloff distance, per wave
+float4 cWaveBFall    : register(c52);  // second set: 1 / falloff distance, per wave
+float4 cWaveB[3]     : register(c53);  // second set: xy = centre, zw = direction
+float4 cWaveBFreq    : register(c56);  // second set: frequency, per wave
+float4 cWaveBAmp     : register(c57);  // second set: amplitude, per wave
+
+// sin as the 3.3.5 code does it: the compiler's own range reduction (frc to -pi..pi, then sincos), done once
+float WrapSin(float a)
+{
+    return sin(a);
+}
+
+float Pick(float4 v, int i)
+{
+    float r = v.x;
+    if (i == 1) r = v.y;
+    if (i == 2) r = v.z;
+    return r;
+}
+
+void main(float4 iPos : POSITION0, float4 iUv0 : TEXCOORD0, float4 iUv1 : TEXCOORD1,
+          out float4 oPos : POSITION0, out float4 oUvA : TEXCOORD0, out float4 oUvB : TEXCOORD1,
+          out float4 oUvC : TEXCOORD2, out float3 oWorld : TEXCOORD3, out float3 oT : TEXCOORD4,
+          out float3 oB : TEXCOORD5, out float3 oN : TEXCOORD6, out float4 oView : TEXCOORD7,
+          out float oFog : FOG)
+{
+    // the 3.3.5 code samples the wave field at P, at P + (0.5, 0) and at P + (0, 0.5) (yards): the heights give the
+    // tangent frame, as finite differences
+    float hP = 0.0;
+    float hX = 0.0;
+    float hY = 0.0;
+    [unroll] for (int i = 0; i < 3; i++) {
+        float4 w = cWaveA[i];
+        float2 d = iPos.xy - w.xy;
+        float fall = Pick(cWaveAFall, i);
+        float ph = Pick(cPhaseA, i);
+        float dist0 = sqrt(d.x * d.x + d.y * d.y);
+        hP += WrapSin(dist0 * w.z - ph) * (saturate(dist0 * -fall + 1.0) * w.w);
+        float dist1 = sqrt(d.y * d.y + (d.x + 0.5) * (d.x + 0.5));
+        hX += WrapSin(dist1 * w.z - ph) * (saturate(dist1 * -fall + 1.0) * w.w);
+        float dist2 = sqrt((d.y + 0.5) * (d.y + 0.5) + d.x * d.x);
+        hY += WrapSin(dist2 * w.z - ph) * (saturate(dist2 * -fall + 1.0) * w.w);
+    }
+    [unroll] for (int j = 0; j < 3; j++) {
+        float4 w = cWaveB[j];
+        float2 d = iPos.xy - w.xy;
+        float amp = Pick(cWaveBAmp, j);
+        float fall = Pick(cWaveBFall, j);
+        float freq = Pick(cWaveBFreq, j);
+        float ph = Pick(cPhaseB, j);
+        float dist0 = sqrt(d.x * d.x + d.y * d.y);
+        float a0 = amp * saturate(dist0 * -fall + 1.0);
+        float2 f = iPos.xy * freq * w.zw;
+        hP += WrapSin(f.y + f.x - ph) * a0;
+        float dist1 = sqrt(d.y * d.y + (d.x + 0.5) * (d.x + 0.5));
+        float a1 = amp * saturate(dist1 * -fall + 1.0);
+        float4 g = (iPos.xyxy * freq + float4(0.5, 0.0, 0.0, 0.5)) * w.zwzw;
+        hX += WrapSin(g.y + g.x - ph) * a1;
+        float dist2 = sqrt((d.y + 0.5) * (d.y + 0.5) + d.x * d.x);
+        float a2 = amp * saturate(dist2 * -fall + 1.0);
+        hY += WrapSin(g.w + g.z - ph) * a2;
+    }
+    float3 t = normalize(float3(1.0, 0.0, hX - hP));
+    float3 b = normalize(float3(0.0, 1.0, hY - hP));
+    oN = cross(t, b);
+    oT = t;
+    oB = b;
+
+    float4 v = iPos.y * cModelView[1];
+    v = iPos.x * cModelView[0] + v;
+    v = iPos.z * cModelView[2] + v;
+    v = v + cModelView[3];
+    float4 c = v.y * cProj[1];
+    c = v.x * cProj[0] + c;
+    c = v.z * cProj[2] + c;
+    oPos = v.w * cProj[3] + c;
+
+    // texture matrices: row x, row y, translation row (rows 0, 1, 3 of each 4x4)
+    oUvA.xy = iUv0.y * cTex[1].xy + iUv0.x * cTex[0].xy + cTex[3].xy;
+    oUvA.zw = (iUv0.y * cTex[5].xy + iUv0.x * cTex[4].xy + cTex[7].xy).yx;
+    oUvB.xy = iUv0.y * cTex[9].xy + iUv0.x * cTex[8].xy + cTex[11].xy;
+    oUvB.zw = (iUv0.y * cTex[13].xy + iUv0.x * cTex[12].xy + cTex[15].xy).yx;
+    oUvC.xy = iUv1.y * cTex[17].xy + iUv1.x * cTex[16].xy + cTex[19].xy;
+    oUvC.zw = (iUv0.y * cTex[21].xy + iUv0.x * cTex[20].xy + cTex[23].xy).yx;
+
+    oFog = min(pow(max(v.z * cFog.x + cFog.y, 0.0), cFog.z), 1.0);
+    oWorld = iPos.xyz;
+    oView = float4(v.xyz, hP);
+}
+)HLSL";
+
+    // Pixel shader (ps_3_0): HD_ORIGINAL 1 = psLiquidProcWater rewritten from its bytecode (hdWater 2, checked equal on
+    // 2000 random pixels), HD_ORIGINAL 0 = Forever's PBR water (hdWater 1).
+    const char* kPixelShader =
+R"HLSL(// Waystone HD water pixel shader (ps_3_0), used with hd_water_vs.hlsl when hdWater is on.
+//   HD_ORIGINAL 1: psLiquidProcWater.bls rewritten from its bytecode (hdWater 2: must look exactly like hdWater 0).
+//   HD_ORIGINAL 0: WoW Forever's PBR water. The lighting is Forever's deferred water shader (PBRWater, "DEF" in
+//                  water_spec.md 3.6) moved into this forward pass: ForeverWater() below is that shader's math line
+//                  for line; what feeds it (slopes, foam, sky, sun lobe) is approximated from what 3.3.5 has.
+#ifndef HD_ORIGINAL
+#define HD_ORIGINAL 0
+#endif
+#ifndef HD_FFT
+#define HD_FFT 0      // HD: 1 = slopes from the FFT wave cascades (hdWaterWaves 1) instead of the 3.3.5 normal maps
+#endif
+
+samplerCUBE cubeA   : register(s0); // 3.3.5 LiquidType texture 0 (cube)
+samplerCUBE cubeB   : register(s1); // 3.3.5 LiquidType texture 1 (cube)
+sampler2D depthRamp : register(s2); // 3.3.5 procedural depth colour ramp (texture 4)
+sampler2D lakeTex   : register(s3); // 3.3.5 animated lake/ocean texture (texture 5): alpha = 3.3.5 glint mask, our foam
+sampler2D bumpA     : register(s4); // 3.3.5 animated normal map, near
+sampler2D bumpB     : register(s5); // 3.3.5 animated normal map, far
+#if !HD_ORIGINAL
+sampler2D sceneDepth : register(s6); // HD: linear view depth of the world drawn so far (R32F, yards)
+sampler2D sceneColor : register(s7); // HD: copy of the world image drawn so far (gamma)
+#endif
+#if HD_FFT
+// HD: FFT wave cascades (HdWaterWaves.cpp): r, g = slopes dh/dx, dh/dy, b = height (yards), a = Jacobian
+sampler2D fft0 : register(s8);
+sampler2D fft1 : register(s9);
+sampler2D fft2 : register(s10);
+sampler2D fft3 : register(s11);
+#endif
+
+// the client's constants (Liquid::SetShaderConstants, CMaterialProcWater::Render)
+float4 cFogColor   : register(c4);   // 3.3.5 fog colour
+float4 cCamera     : register(c5);   // camera position (world)
+float4 cSunDirPS   : register(c6);   // direction to the sun (world)
+float4 cAmbient    : register(c7);   // CM2Lighting ambient (gamma)
+float4 cDiffuse    : register(c8);   // CM2Lighting sun colour (gamma)
+float4 cSpecular   : register(c9);   // CM2Lighting specular, w = 50
+float4 cParams0    : register(c10);  // 3.3.5 LiquidType floats 11-14 (x = near/far normal blend rate)
+float4 cParams1    : register(c11);  // 3.3.5 LiquidType floats 15-17
+#if !HD_ORIGINAL
+// HD: our constants, set by HD::WaterBindProcWater (HdWater.cpp)
+float4 cModelView3[3] : register(c12); // rows of the model -> view rotation (xyz)
+float4 cSunView    : register(c15);  // xyz = direction to the sun, view space
+float4 cScreen     : register(c16);  // 1/width, 1/height, 1 = interior water (Forever flag 128), FFT cascades (1)
+float4 cFog335     : register(c17);  // the 3.3.5 vertex fog terms (x, y, z = exponent), w = time (seconds)
+float4 cType[7]    : register(c18);  // Forever LiquidTypePBRWater: r0, r1, r2, r3, r4 (depth foam), r5 (rim foam), r10
+                                     // (colours linear; r10.w = sun specular scale, Forever cb36.x)
+float4 cSky[5]     : register(c25);  // sky colours, linear: top, middle, low band, horizon, average;
+                                     // w: [0] = debug view, [1] = body scale (hdWaterBody), [2] = reflections
+                                     // strength (hdWaterReflect)
+float4 cInterior   : register(c30);  // rgb = light on the scattering for interior water (Forever: 1), linear;
+                                     // HD: w = share of the game's own water colour in the body (hdWaterColor)
+float4 cProj       : register(c31);  // view -> screen: uv = view.xy / view.z * cProj.xy + cProj.zw
+float4 cAmbientLin : register(c32);  // cAmbient made linear (on the CPU: saves the shader's slots)
+float4 cDiffuseLin : register(c33);  // cDiffuse made linear
+float4 cWaves      : register(c34);  // HD: 1 / tile size (yards) of the 4 FFT cascades (0 = unused)
+float4 cWaves2     : register(c35);  // HD: x = whitecap Jacobian threshold, y = whitecap gain
+#if HD_FFT
+sampler2D ripples  : register(s12);  // HD: ripples around units in the water (HdWaterRipples.cpp): signed slopes
+float4 cRipples    : register(c36);  // HD: world xy -> ripple texture uv (xy scale, zw offset)
+float4 cRipples2   : register(c37);  // HD: x = ripple strength (0 = no ripple texture this frame)
+#endif
+#if HD_PLANAR
+sampler2D planarReflection : register(s13); // HD: hdWaterPlanar's mirror image (HdWaterPlanar.cpp), gamma
+float4 cPlanar : register(c38);             // HD: xy = 1 / its size
+float4 cMainToMirror[4] : register(c39);    // HD: rows: view space (this water's) -> the mirror image's clip space
+#endif
+#endif
+
+// 3.3.5: one tap of a normal map, z rebuilt from xy
+float3 DecodeN(float2 t)
+{
+    float2 n = t * 2.0 + -1.0;
+    float z = sqrt(saturate(1.0 - dot(n, n)));
+    return float3(n, z);
+}
+
+#if HD_ORIGINAL
+
+float4 main(float3 iT : TEXCOORD4, float3 iB : TEXCOORD5, float3 iN : TEXCOORD6, float4 iUvA : TEXCOORD0,
+            float4 iUvB : TEXCOORD1, float4 iUvC : TEXCOORD2, float3 iWorld : TEXCOORD3, float iFog : FOG) : COLOR0
+{
+    float4 a0 = tex2D(bumpA, iUvA.xy);
+    float4 a1 = tex2D(bumpA, iUvA.wz);
+    float4 b0 = tex2D(bumpB, iUvB.xy);
+    float4 b1 = tex2D(bumpB, iUvB.wz);
+    float2 na0 = a0.xy * 2.0 + -1.0;
+    float2 na1 = a1.wz * 2.0 + -1.0;
+    float2 nb0 = b0.xy * 2.0 + -1.0;
+    float2 nb1 = b1.wz * 2.0 + -1.0;
+    float3 nA = float3(na0, 1.0 / rsqrt(1.0 - dot(na0, na0))) + float3(na1, 1.0 / rsqrt(1.0 - dot(na1, na1)));
+    float3 nB = normalize(float3(nb0, 1.0 / rsqrt(1.0 - dot(nb0, nb0))) + float3(nb1, 1.0 / rsqrt(1.0 - dot(nb1, nb1))));
+    float3 rel = iWorld - cCamera.xyz;
+    float invH = rsqrt(dot(rel.xy, rel.xy));
+    float blend = saturate((1.0 / invH) * cParams0.x + 0.5);
+    float3 n = blend * (nA * rsqrt(dot(nA, nA)) - nB) + nB;
+    float3 N = float3(dot(iT, n), dot(iB, n), dot(iN, n));
+    float3 V = rel * invH;
+    float3 H = normalize(rel * invH + cSunDirPS.xyz);
+    float3 spec = pow(saturate(dot(H, N)), cSpecular.w) * cSpecular.rgb;
+    float F = 1.0 - saturate(dot(-V, N));
+    F = F * F;
+    float4 ramp = tex2D(depthRamp, iUvC.xy);
+    float cosI = dot(V, N);
+    float k = 1.0 - cParams0.y * cParams0.y * (1.0 - cosI * cosI);
+    float ok = k >= 0.0 ? 1.0 : 0.0;
+    float rt = 1.0 / rsqrt(k * ok);
+    float3 refr = (ok * cParams0.y) * V.xzy - (ok * cParams0.y * cosI + rt) * N.xzy;
+    float3 refl = N.xzy * -(cosI + cosI) + V.xzy;
+    float3 under = texCUBE(cubeA, refr).rgb + ramp.rgb;
+    float3 over = texCUBE(cubeB, refl).rgb;
+    float3 col = lerp(under, over, cParams0.w * F + cParams0.z);
+    float4 glint = tex2D(lakeTex, iUvC.wz);
+    col = spec * glint.a * 4.0 * (cParams1.z * F + cParams1.y) + col;
+    return float4(lerp(cFogColor.rgb, col, iFog), cParams1.x * F + ramp.a);
+}
+
+#else
+
+// ---------------------------------------------------------------------------------------------------------------
+// The inputs ForeverWater() reads where Forever reads its textures. Approximations (water_spec.md 4, Stage 2):
+float SceneDepthAt(float2 uv)  // Forever t5: linear scene view depth
+{
+    return tex2Dlod(sceneDepth, float4(uv, 0.0, 0.0)).r;
+}
+
+float3 SceneColorAt(float2 uv) // Forever t4.SampleLevel(.., 0): the scene behind the water (gamma here)
+{
+    return tex2Dlod(sceneColor, float4(uv, 0.0, 0.0)).rgb;
+}
+
+// Forever un-fogs the scene behind the water with its froxel volume (rgb = in-scatter, a = 1 - transmittance) and
+// fogs the final colour again. Our fog after the water is the 3.3.5 one (the vertex fog, FOG input), so the scene is
+// un-fogged with the 3.3.5 fog at the scene depth: in-scatter = fogColour * (1 - f), 1 - transmittance = 1 - f.
+// HD: the kept share f is held at 0.3 or more. The world image is 8 bits and other surfaces are not always fogged
+// exactly like this, so dividing by a small f (DEF allows 1/0.001) blew those errors up into a bright haze in short
+// fog (rain, night); past that the scene is taken as mostly fog, which the water's own fog then puts back.
+float4 FogAt(float viewZ)
+{
+    float f = min(pow(max(viewZ * cFog335.x + cFog335.y, 0.0), cFog335.z), 1.0);
+    f = max(f, 0.3);
+    return float4(cFogColor.rgb * (1.0 - f), 1.0 - f);
+}
+
+// HD: the un-fogged scene behind the water (gamma) to linear, kept within what the 8-bit image can hold
+float3 BgLinear(float3 c)
+{
+    return pow(saturate(c), 2.2);
+}
+
+float3 ToLinear(float3 c)      // the client draws in gamma; Forever's math is linear
+{
+    return pow(max(c, 0.0), 2.2);
+}
+
+float3 EnvAmbient()            // Forever: the reflection cube's last mip (one colour); here the client's ambient
+{
+    return cAmbientLin.rgb;
+}
+
+// The client's sky colours by elevation (world direction Rw), blurred toward their average with the roughness
+float3 SkyColours(float3 Rw, float lod)
+{
+    float e = saturate(Rw.z);
