index 00000000..7140da46
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdCataWmoStreaming.cpp
@@ -0,0 +1,18 @@
+#include "HdCataWmoStreaming.h"
+#include <cstring>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+namespace HD::CataWmoStreaming {
+namespace {
+Interest interest;bool initialized=false,enabled=false;
+bool Toggle(CVar*,const char*,const char*s,void*){if(!s||!(std::strcmp(s,"0")==0||std::strcmp(s,"1")==0))return false;enabled=s[0]=='1';interest.valid=false;return true;}
+}
+void Initialize(){if(initialized)return;auto*c=CVar::Register("hdCataWmoStreaming","HD: Cata WMO async guard + min(farclip,380.25) blocking range; 0 native",1,"0",Toggle,CATEGORY_GRAPHICS,false,nullptr,false);initialized=true;enabled=c&&c->m_intValue!=0;}
+void Shutdown(){initialized=false;enabled=false;Invalidate();}
+bool Enabled(){return initialized&&enabled;}
+void Invalidate(){interest.valid=false;}
+void Update(Point p,float farClip,float cornerDistance){interest.Update(p,farClip,cornerDistance);}
+bool Prepare(Box box,bool native){return Enabled()?interest.Prepare(box,native):native;}
+bool RootWait(Box box){return !Enabled()||interest.RootWait(box);}
+bool GroupWait(Box box,bool nativeCollision){return Enabled()?interest.GroupWait(box,nativeCollision):nativeCollision;}
+}
diff --git a/WoW/Source/WorldClient/HD/HdCataWmoStreaming.h b/WoW/Source/WorldClient/HD/HdCataWmoStreaming.h
new file mode 100644
index 00000000..8aa4b5cc
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdCataWmoStreaming.h
@@ -0,0 +1,29 @@
+// HD: Cata 15595's near blocking volume and wide asynchronous guard, typed for 3.3.5 x64.
+#pragma once
+#include <algorithm>
+#include <cmath>
+namespace HD::CataWmoStreaming {
+struct Point {float x=0,y=0,z=0;};
+struct Box {Point b,t;};
+inline bool Finite(Point p){return std::isfinite(p.x)&&std::isfinite(p.y)&&std::isfinite(p.z);}
+inline bool Valid(Box b){return Finite(b.b)&&Finite(b.t)&&b.b.x<=b.t.x&&b.b.y<=b.t.y&&b.b.z<=b.t.z;}
+inline bool Intersects(Box a,Box b){return a.b.x<=b.t.x&&a.b.y<=b.t.y&&a.b.z<=b.t.z&&a.t.x>=b.b.x&&a.t.y>=b.b.y&&a.t.z>=b.b.z;}
+inline Box Cube(Point p,float radius){return {{p.x-radius,p.y-radius,p.z-radius},{p.x+radius,p.y+radius,p.z+radius}};}
+inline float GuardDistance(float farClip,float cornerDistance){
+ float d=cornerDistance;if(farClip>d)d=1.33f*farClip;else if(d>2*farClip)d=2*farClip;return std::max(d,266.66666f);
+}
+struct Interest {
+ Box guard{},nearby{};bool valid=false;
+ void Update(Point p,float farClip,float cornerDistance){
+  valid=Finite(p)&&std::isfinite(farClip)&&farClip>0&&farClip<=2500&&std::isfinite(cornerDistance)&&cornerDistance>=0;
+  if(!valid)return;guard=Cube(p,GuardDistance(farClip,cornerDistance));nearby=Cube(p,std::min(farClip,380.25f));valid=Valid(guard)&&Valid(nearby);
+ }
+ bool Prepare(Box box,bool native)const{return valid&&Valid(box)?Intersects(guard,box):native;}
+ bool RootWait(Box box)const{return !valid||!Valid(box)||Intersects(nearby,box);}
+ // Preserve the 3.3.5 +/-150 collision safety volume as well, including small native farclip values.
+ bool GroupWait(Box box,bool nativeCollision)const{return nativeCollision||RootWait(box);}
+};
+template<class EngineBox>inline Box Convert(const EngineBox&box){return {{box.b.x,box.b.y,box.b.z},{box.t.x,box.t.y,box.t.z}};}
+void Initialize();void Shutdown();bool Enabled();void Invalidate();void Update(Point,float farClip,float cornerDistance);
+bool Prepare(Box,bool native);bool RootWait(Box);bool GroupWait(Box,bool nativeCollision);
+}
diff --git a/WoW/Source/WorldClient/HD/HdContactShadow.cpp b/WoW/Source/WorldClient/HD/HdContactShadow.cpp
new file mode 100644
index 00000000..382018e0
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdContactShadow.cpp
@@ -0,0 +1,674 @@
+// HD: Waystone HD screen-space contact shadows (see HdContactShadow.h). Written for this client on the frame of hdGI
+// (HdGI.cpp): same world depth, same view-space rebuild, same raw D3D9 work and state reset afterwards (no Get* of
+// render states and no state block: the client makes a PURE device, CGxDeviceD3d::ICreateD3dDevice). The sun shadow
+// cascades are read the way hdFog reads them for its light shafts (HdFog.cpp ShadowBand, SunVisible).
+#include "WoW/Source/WorldClient/HD/HdContactShadow.h"
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <windows.h>
+#include <d3d9.h>
+#include <d3dcompiler.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDeviceD3d/CGxDeviceD3d.h"
+#include "Engine/Source/Gx/Types.h"
+#include "Engine/Source/Gx/CGxTex.h"
+#include "Engine/Source/Services/Texture.h"
+#include "Engine/Source/ShaderEffect/ShadowCache.h"
+#include "WoW/Source/WorldClient/DayNight__DNInfo.h" // HD: the world light's colours now (follows hdTime)
+#include "WoW/Source/WorldClient/HD/HdFog.h"
+
+namespace {
+    // HD: checked with d3dcompiler_47 (ps_3_0, optimisation level 3, as below): Visibility 427 instruction slots,
+    // Generate 336, Blur 179, Apply 21 (ps_3_0 guarantees 512).
+    const char kShader[] = R"HLSL(// Waystone HD contact shadows (ps_3_0, D3D9). Four entry points over the whole world target:
+//   Visibility: (HD v3, its own pass so each shader stays under 512 slots) what the sun shadow maps say here, the
+//             way the HD shaders read them (5 taps), 1 = lit, in all four channels
+//   Generate: rgb = the share of this pixel's light that a contact shadow takes away (linear), a = what the sun
+//             shadow maps say (1 = lit); a short ray toward the world light, marched in the world depth
+//   Blur:     5-tap blur of rgb that stops at depth edges and at the shadow maps' edges (run twice: across, then
+//             down); a is kept
+//   Apply:    the world's colour times what is left of its light (multiplied by the blend unit)
+// HD (v3, max's in-game test, 2026-10-25): a contact shadow is the shaders' own shadow, the same darkness, so both
+// make one shadow. The shaders light in gamma: colour = albedo * (ambient + sun * N.L), and a shadow-map shadow
+// (S = 0) leaves of it k = 70% (3.3.5 shaders: models, grass, hdTerrainLight 2: f = S * 0.3 + 0.7) or, with WoW
+// Forever lighting on the ground (hdTerrainLight 1, HdTerrain.cpp), only the ambient: k = ambient / (ambient + sun * N.L).
+// Where the shadow maps say vis (1 = lit), the shaders already left lerp(k, 1, vis); the union with a contact shadow
+// occ is lerp(k, 1, vis * (1 - occ)), so this pass multiplies by the ratio of the two: 1 inside a shadow-map shadow
+// (nothing twice), lerp(1, k, occ) in the open, and no step in between. Surfaces turned away from the light are left
+// as they are. Characters (units) cast no contact shadows: each one is a capsule (feet, height) that the ray's hits
+// are tested against, from just above the ground up (the ground around the feet keeps its contact shadows). HD (v4):
+// they receive the world's contact shadows, as the ground they stand on does.
+// The world depth is hdFog's INTZ copy of the client's depth buffer (HD::FogGetWorldDepth).
+sampler2D DepthTex : register(s0); // INTZ world depth, point, clamp
+sampler2D MaskTex  : register(s1); // Visibility's (for Generate) / Generate's / Blur's result, point, clamp
+sampler2D Shadow0  : register(s2); // the client's sun shadow cascades (40, 160, 640 yards), as hdFog binds them
+sampler2D Shadow1  : register(s3);
+sampler2D Shadow2  : register(s4);
+float4 cScreen  : register(c0); // 1/width, 1/height of the target, depth scale A, depth offset B (z01 = raw * A + B)
+float4 cView    : register(c1); // view xy = (local uv * xy + zw) * view z  (from projection a0, b1, c0, c1)
+float4 cRect    : register(c2); // world viewport in target uv: offset xy, 1 / size zw
+float4 cDepth   : register(c3); // projection c2, -d2, sky threshold, unused
+float4 cParams  : register(c4); // ray length (yards), strength, debug, occluder thickness (yards)
+float4 cBlur    : register(c5); // blur step in uv (xy), fade start (yards), 1 / fade length
+float4 cLight   : register(c6); // view-space direction to the world light (the shadow maps' light), unused
+float4 cAmbient : register(c7); // the client's ambient light now (gamma, as the shaders), 1 = Forever ground lighting
+float4 cDiffuse : register(c8); // the client's world light colour now (gamma, as the shaders), unused
+float4 cShadow  : register(c9); // 1 = shadow maps bound, 1 = hardware depth compare (D24), unused, unused
+float4 cSmat[9] : register(c10); // view space -> shadow map, 3 rows per cascade (CShadowCache::s_shadowMatrices 3..11)
+float4 cUnit[16] : register(c19); // HD: characters near the camera: view-space feet xyz, height (yards)
+float4 cUp      : register(c35); // HD: view-space world up (xyz), number of characters in cUnit (w)
+float4 cPcf[2]  : register(c36); // HD (v3): the shaders' 5-tap PCF offsets in map uv (CShadowCache::s_pcfOffsets 0, 2 | 4, 6)
+
+// View-space position of the surface seen at uv (camera at 0, +z forward), w = 1; w = 0 for the sky and for
+// pixels outside the world viewport. (HdGI.cpp ViewPos)
+float4 ViewPos(float2 uv)
+{
+    float2 local = (uv - cRect.xy) * cRect.zw;
+    float raw = tex2Dlod(DepthTex, float4(uv, 0, 0)).r;
+    float z01 = raw * cScreen.z + cScreen.w;
+    float z = cDepth.y / max(cDepth.x - z01, 1e-7);
+    bool inside = all(local == saturate(local));
+    float w = (inside && z01 < cDepth.z) ? 1.0 : 0.0;
+    return float4((local * cView.xy + cView.zw) * z, z, w);
+}
+
+// Where a view-space point (in front of the eye) is in the target (uv): ViewPos backwards
+float2 TargetUv(float3 q)
+{
+    return ((q.xy / q.z - cView.zw) / cView.xy) / cRect.zw + cRect.xy;
+}
+
+// Interleaved gradient noise (Jimenez 2014): per-pixel start of the ray, removed by the blur.
+float Noise(float2 vpos)
+{
+    return frac(52.9829189 * frac(dot(vpos, float2(0.06711056, 0.00583715))));
+}
+
+// one tap: lit when not deeper than the map (HdFog.cpp)
+float ShadowTap(sampler2D map, float2 uv, float z)
+{
+    if (cShadow.y > 0.5) return tex2Dlod(map, float4(uv, z, 0)).r;
+    return z <= tex2Dlod(map, float4(uv, 0, 0)).r ? 1.0 : 0.0;
+}
+
+// one cascade: x, y = -1..1 across the map, z = depth to compare. HD (v3): the 5 taps the HD shaders take (HdTerrain.cpp
+// Sum5), so where their shadow ends ours ends too, with the same soft edge (no seam where the two shadows meet)
+float ShadowSample(sampler2D map, float3 c)
+{
+    float2 uv = c.xy * 0.5 + 0.5;
+    float sum = ShadowTap(map, uv, c.z);
+    sum += ShadowTap(map, uv + cPcf[0].xy, c.z);
+    sum += ShadowTap(map, uv + cPcf[0].zw, c.z);
+    sum += ShadowTap(map, uv + cPcf[1].xy, c.z);
+    sum += ShadowTap(map, uv + cPcf[1].zw, c.z);
+    return sum * 0.2;
+}
+
+// the client's sun shadow at this view-space point: 1 = lit, 0 = in shadow (the nearest cascade that holds it)
+float SunVisible(float3 p)
+{
+    if (cShadow.x < 0.5) return 1.0;
+    float4 q = float4(p, 1.0);
+    float3 c = float3(dot(q, cSmat[0]), dot(q, cSmat[1]), dot(q, cSmat[2]));
+    if (max(abs(c.x), abs(c.y)) < 0.98) return ShadowSample(Shadow0, c);
+    c = float3(dot(q, cSmat[3]), dot(q, cSmat[4]), dot(q, cSmat[5]));
+    if (max(abs(c.x), abs(c.y)) < 0.98) return ShadowSample(Shadow1, c);
+    c = float3(dot(q, cSmat[6]), dot(q, cSmat[7]), dot(q, cSmat[8]));
+    if (max(abs(c.x), abs(c.y)) < 0.98) return ShadowSample(Shadow2, c);
+    return 1.0;
+}
+
+// HD (v3): how much the view-space point p belongs to a character, 0..1: inside a capsule around its body (radius
+// 0.22 x its height, 0.3 to 1.2 yards, plus 0.1 for weapons and cloaks, soft over its outer third), and only from
+// 0.08 yards above its feet (soft up to 0.28): the ground it stands on is never taken for the character
+float InUnit(float3 p)
+{
+    float inside = 0.0;
+    [loop] for (int i = 0; i < 16; ++i) {
+        if (i >= cUp.w) break;
+        float4 u = cUnit[i];
+        float3 d = p - u.xyz;
+        float h = dot(d, cUp.xyz);
+        float3 q = d - cUp.xyz * clamp(h, 0.0, u.w);
+        float r = clamp(u.w * 0.22, 0.3, 1.2) + 0.1;
+        float w = saturate((r - length(q)) / (r * 0.35)) * saturate((h - 0.08) * 5.0);
+        inside = max(inside, w);
+    }
+    return inside;
+}
+
+// the raw depth at uv (z / w: along a flat surface it changes linearly across the screen)
+float RawDepth(float2 uv)
+{
+    return tex2Dlod(DepthTex, float4(uv, 0, 0)).r;
+}
+
+// view-space normal at uv, facing the camera. HD (v4, max's "paper" edges): on each axis the side whose depth goes on
+// in a straight line over two pixels is taken (the same surface, Bend Studio's choice); the nearest-depth side of
+// v1..v3 took the wall's depth for the ground pixel right in the corner, so its normal was wrong and its shadow went.
+float3 ViewNormal(float2 uv, float3 p)
+{
+    float2 ex = float2(cScreen.x, 0);
+    float2 ey = float2(0, cScreen.y);
+    float4 l = ViewPos(uv - ex);
+    float4 r = ViewPos(uv + ex);
+    float4 u = ViewPos(uv - ey);
+    float4 d = ViewPos(uv + ey);
+    float c0 = RawDepth(uv);
+    float el = abs(2.0 * RawDepth(uv - ex) - RawDepth(uv - 2.0 * ex) - c0) + (1.0 - l.w) * 1e9;
+    float er = abs(2.0 * RawDepth(uv + ex) - RawDepth(uv + 2.0 * ex) - c0) + (1.0 - r.w) * 1e9;
+    float eu = abs(2.0 * RawDepth(uv - ey) - RawDepth(uv - 2.0 * ey) - c0) + (1.0 - u.w) * 1e9;
+    float ed = abs(2.0 * RawDepth(uv + ey) - RawDepth(uv + 2.0 * ey) - c0) + (1.0 - d.w) * 1e9;
+    float3 dx = el < er ? p - l.xyz : r.xyz - p;
+    float3 dy = eu < ed ? p - u.xyz : d.xyz - p;
+    float3 n = cross(dx, dy);
+    n = dot(n, n) > 1e-12 ? normalize(n) : -normalize(p);
+    return dot(n, p) > 0.0 ? -n : n;
+}
+
+// HD (v3): the client's shadow maps at this pixel, a little off the surface (an error there only removes a contact shadow)
+float4 Visibility(float2 vpos : VPOS) : COLOR0
+{
+    float2 uv = (vpos + 0.5) * cScreen.xy;
+    float4 c = ViewPos(uv);
+    if (c.w < 0.5) return 1.0;
+    float3 n = ViewNormal(uv, c.xyz);
+    return SunVisible(c.xyz + n * (0.05 + 0.004 * c.z));
+}
+
+float4 Generate(float2 vpos : VPOS) : COLOR0
+{
+    float2 uv = (vpos + 0.5) * cScreen.xy;
+    float4 c = ViewPos(uv);
+    if (c.w < 0.5) return 0.0;
+    float3 p = c.xyz;
+    float3 n = ViewNormal(uv, p);
+
+    // turned away from the light (or grazing): no direct light to take away
+    float ndl = dot(n, cLight.xyz);
+    if (ndl < 0.02) return 0.0;
+    // HD (v4, max's test: "the shadow goes when I walk into it"): the characters receive the contact shadows of the
+    // world again, like the ground they stand on; they still cast none, on themselves neither (hits on them are passed)
+    // HD: the client's shadow maps first (the Visibility pass)
+    float vis = tex2Dlod(MaskTex, float4(uv, 0, 0)).a;
+
+    // the ray: from just off the surface toward the light; an occluder is a surface on screen in front of the ray
+    // by more than the depth's precision and less than an object's thickness (deeper = something behind, not on it)
+    float len = cParams.x;
+    float stepLen = len * (1.0 / 24.0);
+    float bias = 0.01 + 0.0015 * p.z;
+    float thick = cParams.w * (1.0 + 0.02 * p.z);
+    float3 o = p + n * (0.02 + 0.002 * p.z);
+    float noise = Noise(vpos);
+    float occ = 0.0;
+    [loop] for (int i = 0; i < 24; ++i) {               // HD (v4): 24 steps, finer than 16 (less noise to blur)
+        float t = (i + noise) * stepLen;
+        float3 q = o + cLight.xyz * t;
+        if (q.z < 0.25) break;                           // the ray left the view toward the camera
+        float4 s = ViewPos(TargetUv(q));
+        float delta = q.z - s.z;
+        // HD: the characters cast no contact shadow (a hit on one is passed through)
+        if (s.w > 0.5 && delta > bias && delta < thick && InUnit(s.xyz) < 0.5) {
+            // HD (v4, max's "printed" shadows): full at the contact, then fading over the far 60% of the ray, as a
+            // real contact shadow softens away from the contact (v1..v3 kept it full to 75%: a flat stamp that popped)
+            occ = 1.0 - smoothstep(0.4, 1.0, t / len);
+            break;
+        }
+    }
+    // fade out with distance (the depth gets coarse far away, and far scenery is fogged)
+    occ *= (1.0 - saturate((p.z - cBlur.z) * cBlur.w)) * cParams.y;
+    // HD (v3): k = what the shaders' own shadow leaves of this colour (gamma): Forever ground lighting keeps the
+    // ambient on the ground (facing up), the 3.3.5 shaders keep 70% (everything else)
+    float3 forever = cAmbient.rgb / max(cAmbient.rgb + cDiffuse.rgb * ndl, 1e-4);
+    float3 k = lerp(0.7, forever, cAmbient.w * saturate((dot(n, cUp.xyz) - 0.55) * 3.3));
+    float s = cParams.z > 1.5 ? 1.0 : vis;                 // test view 2: without the shadow-map check
+    // the shadows' union over what the shaders drew: lerp(k, 1, s * (1 - occ)) / lerp(k, 1, s)
+    float3 keep = (k + (1.0 - k) * s * (1.0 - occ)) / (k + (1.0 - k) * s);
+    // HD (v4): a = 0.5 + vis / 2 marks a pixel that takes contact shadows (0 = sky, turned away), for the blur
+    return float4(1.0 - keep * keep, 0.5 + 0.5 * vis);
+}
+
+float4 Blur(float2 vpos : VPOS) : COLOR0
+{
+    float2 uv = (vpos + 0.5) * cScreen.xy;
+    float4 m = tex2Dlod(MaskTex, float4(uv, 0, 0));
+    if (m.a < 0.25) return 0.0;                         // takes no contact shadow: stays so
+    float4 q[5];
+    [unroll] for (int j = 0; j < 5; ++j) q[j] = ViewPos(uv + cBlur.xy * (j - 2));
+    float z = q[2].z;
+    // HD (v4, max's "printed" shadows): the depth is followed along the surface (its slope from the nearer neighbour)
+    // instead of a fixed tolerance, so ground seen at a grazing angle is blurred too and the ray noise goes away
+    float slope = abs(q[3].z - z) < abs(z - q[1].z) ? q[3].z - z : z - q[1].z;
+    float sharp = 1.0 / (0.03 + 0.01 * z);
+    float3 total = 0.0;
+    float weights = 0.0;
+    [unroll] for (int i = 0; i < 5; ++i) {
+        float4 t = tex2Dlod(MaskTex, float4(uv + cBlur.xy * (i - 2), 0, 0));
+        const float spatial = (i == 2) ? 6.0 : ((i == 1 || i == 3) ? 4.0 : 1.0);
+        float weight = spatial * exp2(-abs(q[i].z - (z + slope * (i - 2))) * sharp) * q[i].w;
+        // HD (v4): only pixels that take contact shadows (the ones that take none would lighten an object's foot)
+        weight *= t.a >= 0.25 ? 1.0 : 0.0;
+        // HD (v3): nor across the shadow maps' edge (inside, the mask is 0: the shaders' shadow is already there)
+        weight *= saturate(1.0 - 2.0 * abs(t.a - m.a));
+        total += t.rgb * weight;
+        weights += weight;
+    }
+    return float4(total / max(weights, 1e-6), m.a);
+}
+
+// The target is 8-bit gamma (gamma 2, as hdGI): the light left, sqrt(1 - share), is the factor in gamma too.
+float4 Apply(float2 vpos : VPOS) : COLOR0
+{
+    float2 uv = (vpos + 0.5) * cScreen.xy;
+    float4 m = tex2Dlod(MaskTex, float4(uv, 0, 0));
+    float3 keep = sqrt(saturate(1.0 - m.rgb));
+    // test view 2: red where the shadow maps already shadow
+    if (cParams.z > 1.5 && m.a >= 0.25 && m.a < 0.75) keep = float3(keep.r, keep.g * 0.35, keep.b * 0.35);
+    return float4(keep, 1.0);
+}
+)HLSL";
+
+    enum { PS_Visibility, PS_Generate, PS_Blur, PS_Apply, PS_Count };
+    const char* const kEntry[PS_Count] = { "Visibility", "Generate", "Blur", "Apply" };
+    const UINT kConstRegs = 38; // c0..c37 (HD::FogInvalidateClientState re-sends c0..c33, c34..c37 are marked below)
+    const int kMaxUnits = 16; // HD: characters nearest to the camera kept out of the contact shadows
+    const float kSkyDepth = 0.99999f;
+    const float kFadeStart = 80.0f; // yards: the contact shadows fade out from here...
+    const float kFadeLength = 40.0f; // ...over this distance
+    const float kThickness = 1.0f; // yards: how thick an occluder is taken to be near the camera (a crate, a body)
+
+    typedef HRESULT(WINAPI* D3DCompileFn)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*, LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+
+    struct Target {
+        IDirect3DTexture9* tex = nullptr;
+        IDirect3DSurface9* surf = nullptr;
+    };
+
+    CVar* s_enabled = nullptr;
+    CVar* s_length = nullptr;
+    CVar* s_strength = nullptr;
+    CVar* s_units = nullptr; // HD: hdContactShadowUnits
+    CVar* s_debug = nullptr;
+    CVar* s_info = nullptr;
+    CVar* s_terrainLight = nullptr; // HD: hdTerrainLight (HdTerrain.cpp), 1 = Forever ground lighting
+    char s_lastInfo[160] = "";
+
+    std::vector<DWORD> s_code[PS_Count]; // compiled once; the shader objects are remade after a device reset
+    bool s_compileFailed = false;
+    IDirect3DPixelShader9* s_ps[PS_Count] = {};
+    Target s_mask[2];
+    UINT s_width = 0;
+    UINT s_height = 0;
+
+    void RegisterCVars() {
+        static bool registered = false;
+        if (registered) return;
+        registered = true;
+        s_enabled = CVar::Register("hdContactShadow", "HD: 1 = screen-space contact shadows, 0 = off", 1, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_length = CVar::Register("hdContactShadowLength", "HD: contact shadow ray length in yards, 1.5 = normal", 1, "1.5", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_strength = CVar::Register("hdContactShadowStrength", "HD: contact shadow strength, 1 = as dark as the shaders' own shadows (normal), 0 = none", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_units = CVar::Register("hdContactShadowUnits", "HD: 1 = characters cast contact shadows too, 0 = they only receive them (default)", 1, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_debug = CVar::Register("hdContactShadowDebug", "HD: 1 = test view, the shadow alone, 2 = the same without the shadow-map check (red = shadow maps)", 0, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_info = CVar::Register("hdContactShadowInfo", "HD: hdContactShadow status (read only)", 0, "off", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    }
+
+    void SetInfo(const char* text) {
+        if (!s_info || !strcmp(s_lastInfo, text)) return;
+        snprintf(s_lastInfo, sizeof(s_lastInfo), "%s", text);
+        s_info->Set(text, true, false, false, false);
+    }
+
+    float CVarValue(CVar* cvar, float fallback, float lo, float hi) {
+        float v = cvar ? cvar->m_floatValue : fallback;
+        if (!(v == v)) return fallback; // NaN
+        return v < lo ? lo : (v > hi ? hi : v);
+    }
+
+    IDirect3DDevice9* Device() {
+        if (!g_theGxDevicePtr || g_theGxDevicePtr->DeviceApi() != GxApi_D3d9) return nullptr;
+        return static_cast<CGxDeviceD3d*>(g_theGxDevicePtr)->m_d3dDevice;
+    }
+
+    void ReleaseTargets() {
+        for (Target& t : s_mask) {
+            if (t.surf) { t.surf->Release(); t.surf = nullptr; }
+            if (t.tex) { t.tex->Release(); t.tex = nullptr; }
+        }
+        s_width = 0;
+        s_height = 0;
+    }
+
+    void ReleaseShaders() {
+        for (IDirect3DPixelShader9*& ps : s_ps) {
+            if (ps) { ps->Release(); ps = nullptr; }
+        }
+    }
+
+    bool EnsureTargets(IDirect3DDevice9* device, UINT width, UINT height) {
+        if (s_mask[0].surf && s_mask[1].surf && s_width == width && s_height == height) return true;
+        ReleaseTargets();
+        for (Target& t : s_mask) {
+            if (FAILED(device->CreateTexture(width, height, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &t.tex, nullptr)) || !t.tex) {
+                t.tex = nullptr;
+                ReleaseTargets();
+                return false;
+            }
+            if (FAILED(t.tex->GetSurfaceLevel(0, &t.surf)) || !t.surf) {
+                t.surf = nullptr;
+                ReleaseTargets();
+                return false;
+            }
+        }
+        s_width = width;
+        s_height = height;
+        return true;
+    }
+
+    bool EnsureShaders(IDirect3DDevice9* device) {
+        if (s_ps[PS_Visibility] && s_ps[PS_Generate] && s_ps[PS_Blur] && s_ps[PS_Apply]) return true;
+        if (s_compileFailed) return false;
+        if (s_code[0].empty()) {
+            s_compileFailed = true;
+            HMODULE module = LoadLibraryA("d3dcompiler_47.dll");
+            D3DCompileFn compile = module ? reinterpret_cast<D3DCompileFn>(GetProcAddress(module, "D3DCompile")) : nullptr;
+            if (!compile) {
+                SetInfo("ERROR: d3dcompiler_47.dll not found");
+                return false;
+            }
+            for (int i = 0; i < PS_Count; i++) {
+                ID3DBlob* code = nullptr;
+                ID3DBlob* errors = nullptr;
+                HRESULT hr = compile(kShader, strlen(kShader), "HdContactShadow", nullptr, nullptr, kEntry[i], "ps_3_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+                if (FAILED(hr) || !code) {
+                    char text[160];
+                    snprintf(text, sizeof(text), "ERROR: shader %s: %s", kEntry[i], errors ? static_cast<const char*>(errors->GetBufferPointer()) : "unknown");
+                    SetInfo(text);
+                    if (errors) errors->Release();
+                    if (code) code->Release();
+                    for (std::vector<DWORD>& c : s_code) c.clear();
+                    return false;
+                }
+                if (errors) errors->Release();
+                const DWORD* p = static_cast<const DWORD*>(code->GetBufferPointer());
+                s_code[i].assign(p, p + code->GetBufferSize() / sizeof(DWORD));
+                code->Release();
+            }
+            s_compileFailed = false;
+        }
+        for (int i = 0; i < PS_Count; i++) {
+            if (!s_ps[i] && FAILED(device->CreatePixelShader(s_code[i].data(), &s_ps[i]))) {
+                s_ps[i] = nullptr;
+                ReleaseShaders();
+                s_compileFailed = true;
+                SetInfo("ERROR: CreatePixelShader failed");
+                return false;
+            }
+        }
+        return true;
+    }
+
+    // The world viewport in pixels, as CGxDeviceD3d::IXformSetViewport sets it from the client's viewport. (HdGI.cpp)
+    void WorldViewport(float* x, float* y, float* w, float* h) {
+        CGxDevice* gx = g_theGxDevicePtr;
+        const CRect& window = gx->DeviceCurWindow();
+        const CBoundingBox& vp = gx->m_viewport;
+        DWORD vx = static_cast<DWORD>(vp.m_x.m_l * window.maxX + 0.5f);
+        DWORD vy = static_cast<DWORD>((1.0f - vp.m_y.m_h) * window.maxY + 0.5f);
+        DWORD vw = static_cast<DWORD>(vp.m_x.m_h * window.maxX - vx + 0.5f);
+        DWORD vh = static_cast<DWORD>((1.0f - vp.m_y.m_l) * window.maxY - vy + 0.5f);
+        if (gx->m_textureTarget[0].m_apiSpecific || gx->m_textureTarget[1].m_apiSpecific) {
+            vy = static_cast<DWORD>(window.maxY * vp.m_y.m_l);
+        }
+        *x = static_cast<float>(vx);
+        *y = static_cast<float>(vy);
+        *w = static_cast<float>(vw);
+        *h = static_cast<float>(vh);
+    }
+
+    // HD: the client's sun shadow cascade i (CShadowCache, shadow quality high or very high), as hdFog takes it
+    // (HdFog.cpp ShadowBand); depthCompare = a D24 depth map (sampled with the hardware compare), else R32F distances.
+    IDirect3DBaseTexture9* ShadowBand(int32_t i, bool* depthCompare) {
+        if (CShadowCache::GetShadowMode() <= SHADOW_MEDIUM) return nullptr;
+        CShadowBand& band = CShadowCache::s_extShadowBands[i];
+        CTexture* texture = band.m_textures[band.m_current];
+        if (!texture) return nullptr;
+        CGxTex* gx = TextureGetGxTex(texture, 1, nullptr);
+        if (!gx || gx->m_needsCreation || !gx->m_apiSpecificData) return nullptr;
+        *depthCompare = gx->m_format == GxTex_D24X8;
+        return static_cast<IDirect3DBaseTexture9*>(gx->m_apiSpecificData);
+    }
+
+    // One full-target pass. SetRenderTarget also sets the viewport to the whole target.
+    void Pass(IDirect3DDevice9* device, IDirect3DSurface9* target, int shader, IDirect3DTexture9* mask, UINT width, UINT height) {
+        device->SetRenderTarget(0, target);
+        device->SetPixelShader(s_ps[shader]);
+        device->SetTexture(1, mask);
+        float w = static_cast<float>(width) - 0.5f;
+        float h = static_cast<float>(height) - 0.5f;
+        float quad[16] = {
+            -0.5f, -0.5f, 0.0f, 1.0f,
+            w, -0.5f, 0.0f, 1.0f,
+            -0.5f, h, 0.0f, 1.0f,
+            w, h, 0.0f, 1.0f,
+        };
+        device->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP, 2, quad, 4 * sizeof(float));
+        device->SetTexture(1, nullptr);
+    }
+}
+
+bool HD::ContactShadowWantsDepth() {
+    RegisterCVars();
+    return s_enabled && s_enabled->m_intValue != 0;
+}
+
+void HD::ContactShadowRenderOpaque() {
+    RegisterCVars();
+    if (!s_enabled || !s_enabled->m_intValue) {
+        // HD: off: no Direct3D call at all (only our own textures are let go, once)
+        if (s_mask[0].tex || s_mask[1].tex) ReleaseTargets();
+        SetInfo("off");
+        return;
+    }
+    IDirect3DDevice9* device = Device();
+    if (!device) { SetInfo("ERROR: needs gxApi d3d9"); return; }
+    HD::FogWorldDepth depth;
+    if (!HD::FogGetWorldDepth(&depth)) {
+        SetInfo("no world depth (multisampling must be 1x, INTZ needed): contact shadows skipped");
+        return;
+    }
+    const C44Matrix& proj = g_theGxDevicePtr->m_projNative;
+    // a perspective projection (zv = d2 / (z - c2), w = view z); anything else (orthographic views) is skipped
+    if (proj.a0 == 0.0f || proj.b1 == 0.0f || proj.c3 != 1.0f || proj.d3 != 0.0f || !(proj.c2 > 0.0f) || !(proj.d2 < 0.0f) ||
+        !(depth.vpMax > depth.vpMin)) {
+        SetInfo("on, projection not supported this frame: contact shadows skipped");
+        return;
+    }
+    // HD: the light the shadow maps use (CShadowQuery::Update: the client's world light, z scaled by hdShadowSun),
+    // which falls along s_sunDir; into view space with this frame's view matrix (row vectors, as hdFog), reversed
+    const C3Vector& fall = CShadowCache::s_sunDir;
+    const CGxMatrixStack& viewStack = g_theGxDevicePtr->m_xforms[GxXform_View];
+    float view[16];
+    memcpy(view, &viewStack.m_mtx[viewStack.m_level], sizeof(view));
+    float lx = -(fall.x * view[0] + fall.y * view[4] + fall.z * view[8]);
+    float ly = -(fall.x * view[1] + fall.y * view[5] + fall.z * view[9]);
+    float lz = -(fall.x * view[2] + fall.y * view[6] + fall.z * view[10]);
+    float ll = sqrtf(lx * lx + ly * ly + lz * lz);
+    if (!(ll > 1e-4f)) {
+        SetInfo("on, no world light direction yet: contact shadows skipped");
+        return;
+    }
+    lx /= ll; ly /= ll; lz /= ll;
+    if (!EnsureShaders(device)) return;
+
+    IDirect3DSurface9* color = nullptr;
+    if (FAILED(device->GetRenderTarget(0, &color)) || !color) return;
+    D3DSURFACE_DESC desc;
+    color->GetDesc(&desc);
+    if (desc.Width != depth.width || desc.Height != depth.height || desc.MultiSampleType != D3DMULTISAMPLE_NONE) {
+        color->Release();
+        SetInfo("on, world target and depth differ in size: contact shadows skipped");
+        return;
+    }
+    if (!EnsureTargets(device, desc.Width, desc.Height)) {
+        color->Release();
+        SetInfo("ERROR: contact shadow render target not supported");
+        return;
+    }
+    IDirect3DSurface9* worldDepth = nullptr;
+    device->GetDepthStencilSurface(&worldDepth);
+
+    float vx, vy, vw, vh;
+    WorldViewport(&vx, &vy, &vw, &vh);
+    if (vw < 1.0f || vh < 1.0f) { vx = 0.0f; vy = 0.0f; vw = static_cast<float>(desc.Width); vh = static_cast<float>(desc.Height); }
+    const float length = CVarValue(s_length, 1.5f, 0.25f, 6.0f);
+    const float strength = CVarValue(s_strength, 1.0f, 0.0f, 1.0f);
+    const int32_t debug = s_debug ? (s_debug->m_intValue < 0 ? 0 : (s_debug->m_intValue > 2 ? 2 : s_debug->m_intValue)) : 0;
+    // HD: the client's light this frame (CWorldScene's map light, m_light1: DayNight at the hdTime hour), in gamma
+    // as the shaders use it; and whether the ground has WoW Forever's lighting (its shadow then keeps the ambient only)
+    if (!s_terrainLight) s_terrainLight = CVar::Lookup("hdTerrainLight");
+    const bool forever = s_terrainLight && s_terrainLight->m_intValue == 1;
+    const CImVector& amb = DayNight::g_dnInfo.m_light1.m_ambient;
+    const CImVector& dif = DayNight::g_dnInfo.m_light1.m_diffuse;
+    const float ambR = amb.r * (1.0f / 255.0f), ambG = amb.g * (1.0f / 255.0f), ambB = amb.b * (1.0f / 255.0f);
+    const float difR = dif.r * (1.0f / 255.0f), difG = dif.g * (1.0f / 255.0f), difB = dif.b * (1.0f / 255.0f);
+
+    // HD: the client's sun shadow cascades (view space -> map), so what they already shadow is not shadowed again
+    IDirect3DBaseTexture9* shadowTex[3] = { nullptr, nullptr, nullptr };
+    bool depthCompare = false;
+    bool shadows = true;
+    for (int32_t i = 0; shadows && i < 3; i++) {
+        shadowTex[i] = ShadowBand(i, &depthCompare);
+        if (!shadowTex[i]) shadows = false;
+    }
+
+    const float depthScale = 1.0f / (depth.vpMax - depth.vpMin);
+    float c[kConstRegs * 4] = {
+        1.0f / desc.Width, 1.0f / desc.Height, depthScale, -depth.vpMin * depthScale,
+        2.0f / proj.a0, -2.0f / proj.b1, (-1.0f - proj.c0) / proj.a0, (1.0f - proj.c1) / proj.b1,
+        vx / desc.Width, vy / desc.Height, desc.Width / vw, desc.Height / vh,
+        proj.c2, -proj.d2, kSkyDepth, 0.0f,
+        length, strength, static_cast<float>(debug), kThickness,
+        0.0f, 0.0f, kFadeStart, 1.0f / kFadeLength,
+        lx, ly, lz, 0.0f,
+        ambR, ambG, ambB, forever ? 1.0f : 0.0f,
+        difR, difG, difB, 0.0f,
+        shadows ? 1.0f : 0.0f, depthCompare ? 1.0f : 0.0f, 0.0f, 0.0f,
+    };
+    if (shadows) memcpy(&c[40], &CShadowCache::s_shadowMatrices[3].x, 9 * 4 * sizeof(float));
+    // HD: the characters near the camera (camera-relative world -> view space, rotation only), and the world's up
+    int32_t unitCount = 0;
+    if (!s_units || !s_units->m_intValue) {
+        HD::ContactShadowUnit units[kMaxUnits];
+        unitCount = HD::ContactShadowGatherUnits(units, kMaxUnits);
+        for (int32_t i = 0; i < unitCount; i++) {
+            const HD::ContactShadowUnit& u = units[i];
+            float* r = &c[(19 + i) * 4];
+            for (int32_t j = 0; j < 3; j++) r[j] = u.x * view[j] + u.y * view[4 + j] + u.z * view[8 + j];
+            r[3] = u.height;
+        }
+    }
+    {
+        float ux = view[8], uy = view[9], uz = view[10];
+        float ul = sqrtf(ux * ux + uy * uy + uz * uz);
+        if (!(ul > 1e-6f)) { ux = 0.0f; uy = 1.0f; uz = 0.0f; ul = 1.0f; }
+        c[140] = ux / ul; c[141] = uy / ul; c[142] = uz / ul; c[143] = static_cast<float>(unitCount);
+    }
+    // HD (v3): the shaders' PCF taps (CShadowCache::InitPcfOffsets: texel steps of this shadow map size)
+    {
+        const C4Vector* o = CShadowCache::s_pcfOffsets;
+        float pcf[8] = { o[0].x, o[0].y, o[2].x, o[2].y, o[4].x, o[4].y, o[6].x, o[6].y };
+        memcpy(&c[144], pcf, sizeof(pcf));
+    }
+
+    // HD: the same states hdGI sets here (all re-sent by the client afterwards)
+    device->SetDepthStencilSurface(nullptr); // the depth texture cannot be read while it is the depth buffer
+    device->SetRenderState(D3DRS_ZENABLE, FALSE);
+    device->SetRenderState(D3DRS_ZWRITEENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHATESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+    device->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
+    device->SetRenderState(D3DRS_FOGENABLE, FALSE);
+    device->SetRenderState(D3DRS_SCISSORTESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_CLIPPLANEENABLE, 0);
+    device->SetRenderState(D3DRS_SRGBWRITEENABLE, FALSE);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, 0x0F);
+    device->SetVertexShader(nullptr);
+    device->SetFVF(D3DFVF_XYZRHW);
+    device->SetTexture(0, depth.texture);
+    for (DWORD i = 0; i < 2; i++) {
+        device->SetSamplerState(i, D3DSAMP_MINFILTER, D3DTEXF_POINT);
+        device->SetSamplerState(i, D3DSAMP_MAGFILTER, D3DTEXF_POINT);
+        device->SetSamplerState(i, D3DSAMP_MIPFILTER, D3DTEXF_NONE);
+        device->SetSamplerState(i, D3DSAMP_ADDRESSU, D3DTADDRESS_CLAMP);
+        device->SetSamplerState(i, D3DSAMP_ADDRESSV, D3DTADDRESS_CLAMP);
+        device->SetSamplerState(i, D3DSAMP_SRGBTEXTURE, FALSE);
+    }
+    for (DWORD i = 0; i < 3; i++) {
+        // HD: as hdFog: a D24 map is filtered (the hardware compare then gives soft edges); R32F distances are not
+        DWORD filter = depthCompare ? D3DTEXF_LINEAR : D3DTEXF_POINT;
+        device->SetTexture(2 + i, shadowTex[i]);
+        device->SetSamplerState(2 + i, D3DSAMP_MINFILTER, filter);
+        device->SetSamplerState(2 + i, D3DSAMP_MAGFILTER, filter);
+        device->SetSamplerState(2 + i, D3DSAMP_MIPFILTER, D3DTEXF_NONE);
+        device->SetSamplerState(2 + i, D3DSAMP_ADDRESSU, D3DTADDRESS_CLAMP);
+        device->SetSamplerState(2 + i, D3DSAMP_ADDRESSV, D3DTADDRESS_CLAMP);
+        device->SetSamplerState(2 + i, D3DSAMP_SRGBTEXTURE, FALSE);
+    }
+    device->SetPixelShaderConstantF(0, c, kConstRegs);
+    Pass(device, s_mask[1].surf, PS_Visibility, nullptr, desc.Width, desc.Height); // HD (v3): the shadow maps' answer first
+    Pass(device, s_mask[0].surf, PS_Generate, s_mask[1].tex, desc.Width, desc.Height);
+    c[20] = 1.0f / desc.Width; c[21] = 0.0f;
+    device->SetPixelShaderConstantF(5, &c[20], 1);
+    Pass(device, s_mask[1].surf, PS_Blur, s_mask[0].tex, desc.Width, desc.Height);
+    c[20] = 0.0f; c[21] = 1.0f / desc.Height;
+    device->SetPixelShaderConstantF(5, &c[20], 1);
+    Pass(device, s_mask[0].surf, PS_Blur, s_mask[1].tex, desc.Width, desc.Height);
+
+    // HD: the world's colour times what is left of its light (blend: colour * source); the test views write the
+    // shadow alone; the alpha (glow mask) is kept
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, D3DCOLORWRITEENABLE_RED | D3DCOLORWRITEENABLE_GREEN | D3DCOLORWRITEENABLE_BLUE);
+    if (!debug) {
+        device->SetRenderState(D3DRS_ALPHABLENDENABLE, TRUE);
+        device->SetRenderState(D3DRS_SEPARATEALPHABLENDENABLE, FALSE);
+        device->SetRenderState(D3DRS_BLENDOP, D3DBLENDOP_ADD);
+        device->SetRenderState(D3DRS_SRCBLEND, D3DBLEND_ZERO);
+        device->SetRenderState(D3DRS_DESTBLEND, D3DBLEND_SRCCOLOR);
+    }
+    Pass(device, color, PS_Apply, s_mask[0].tex, desc.Width, desc.Height);
+    device->SetTexture(0, nullptr);
+    for (DWORD i = 2; i < 5; i++) device->SetTexture(i, nullptr);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, 0x0F);
+
+    // the world's targets back (SetRenderTarget reset the viewport and the scissor rectangle)
+    device->SetRenderTarget(0, color);
+    device->SetDepthStencilSurface(worldDepth);
+    color->Release();
+    if (worldDepth) worldDepth->Release();
+    // HD: the client turns the depth test on once at start-up and never again (see HdFog.cpp)
+    device->SetRenderState(D3DRS_ZENABLE, D3DZB_TRUE);
+    CGxDeviceD3d* gx = static_cast<CGxDeviceD3d*>(g_theGxDevicePtr);
+    gx->m_viewportDirty = 1;
+    gx->m_scissorRectDirty = 1;
+    HD::FogInvalidateClientState();
+    // HD: our constants go past the c0..c33 hdFog marks: make the client send c34..c37 again too
+    ShadowConstants& ps = CGxDevice::s_shadowConstants[0];
+    ps.dirtyMin = 0;
+    if (ps.dirtyMax < kConstRegs - 1) ps.dirtyMax = kConstRegs - 1;
+    char text[160];
+    snprintf(text, sizeof(text), "on%s, shadow maps %s, ground shadow %s, characters %s, v4",
+             debug == 2 ? ", test view (hdContactShadowDebug 2)" : (debug ? ", test view (hdContactShadowDebug 1)" : ""),
+             shadows ? (depthCompare ? "D24" : "R32F") : "none (shadow quality below high: no check)",
+             forever ? "Forever (ambient)" : "3.3.5 (70%)",
+             (s_units && s_units->m_intValue) ? "cast too" : "receive only");
+    SetInfo(text);
+}
+
+void HD::ContactShadowReleaseDeviceResources() {
+    ReleaseTargets();
+    ReleaseShaders();
+}
diff --git a/WoW/Source/WorldClient/HD/HdContactShadow.h b/WoW/Source/WorldClient/HD/HdContactShadow.h
new file mode 100644
index 00000000..4ded0cd2
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdContactShadow.h
@@ -0,0 +1,48 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDCONTACTSHADOW_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDCONTACTSHADOW_H
+
+// Waystone HD: screen-space contact shadows (not part of the original client). D3D9 only, off by default.
+// The small shadows the sun shadow maps are too coarse for (the foot of a crate, a character's feet, a rail on a
+// wall, the gap under a cart): from every pixel a short ray is marched toward the world light in the world depth,
+// as Days Gone did (Bend Studio, "screen space shadows"). Where it passes behind something drawn on screen, the
+// pixel loses its share of the world light (what the client's direct light adds over its ambient), never more.
+// HD: no double shadow: the client's own sun shadow maps (CShadowCache, the cascades hdFog reads too) are looked up
+// first; where they already shadow, nothing is added. The light is the one the shadow maps use (CShadowCache::
+// s_sunDir, the client's world light, hdShadowSun included) and its colours are DayNight's (m_light1 at the hdTime
+// hour): at night the client's light is the moon's, and the shadows follow its strength.
+// HD (v3, max's in-game tests, 2026-10-25): a contact shadow has exactly the darkness of the shaders' own shadow-map
+// shadow (70% kept by the 3.3.5 shaders, the ambient alone on WoW Forever ground, hdTerrainLight 1), so both are one
+// shadow with no step where they meet; characters (players, creatures, NPCs) cast no contact shadows.
+// HD (v4, max's in-game test of v3): characters receive the world's contact shadows like the ground they stand on;
+// the shadow goes right into an object's corner and never onto its face; it softens away from the contact instead
+// of ending like a stamp.
+// Drawn on the opaque world (terrain, buildings, models of the first pass, grass) before hdGI, so the bounce sees
+// the shadows and nothing is darkened twice. Only what is on screen casts (the limit of every screen-space method);
+// it fades out from 80 to 120 yards. Reads the world depth that HdFog captures (INTZ, multisampling 1x).
+//   hdContactShadow          0 = off (default), 1 = on
+//   hdContactShadowLength    ray length in yards, 1.5 = normal (0.25 to 6)
+//   hdContactShadowStrength  1 = as dark as the shaders' own shadows (normal), 0 = none (0 to 1)
+//   hdContactShadowUnits     0 = characters only receive (default), 1 = characters cast contact shadows too
+//   hdContactShadowDebug     1 = test view: the shadow alone (white = untouched), 2 = the same without the
+//                            shadow-map check (red where the shadow maps already shadow)
+//   hdContactShadowInfo      read only, status:  /run print(GetCVar("hdContactShadowInfo"))
+
+namespace HD {
+    // HD: a character for the contact shadows: feet position relative to the camera (world axes: x north, y west,
+    // z up, yards) and its height
+    struct ContactShadowUnit {
+        float x, y, z;
+        float height;
+    };
+    // HD: the visible characters nearest to the camera, at most max of them (HdContactShadowUnits.cpp). Returns how many.
+    int ContactShadowGatherUnits(ContactShadowUnit* out, int max);
+    // True when hdContactShadow needs the world depth this frame (HdFog::FogBeginWorld).
+    bool ContactShadowWantsDepth();
+    // Called by CGWorldFrame::OnWorldRender after CWorldScene::RenderDetailDoodads, before HD::GIRenderOpaque.
+    // Does nothing at all when hdContactShadow is 0.
+    void ContactShadowRenderOpaque();
+    // Called by the D3D9 device before it releases its resources (through HD::FogReleaseDeviceResources).
+    void ContactShadowReleaseDeviceResources();
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdContactShadowUnits.cpp b/WoW/Source/WorldClient/HD/HdContactShadowUnits.cpp
new file mode 100644
index 00000000..388f8922
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdContactShadowUnits.cpp
@@ -0,0 +1,56 @@
+// HD: Waystone HD contact shadows: the characters (units) near the camera, kept out of the contact shadows
+// (HdContactShadow.h). Apart from HdContactShadow.cpp so that file needs none of the game's object headers.
+#include "WoW/Source/WorldClient/HD/HdContactShadow.h"
+#include "Engine/Source/Tempest/C3Vector.h"
+#include "WoW/Source/ObjectMgrClient/ObjectMgrClient.h"
+#include "WoW/Source/Ui/WorldFrame.h"
+
+namespace {
+    struct Gather {
+        HD::ContactShadowUnit* out;
+        float dist2[64];
+        int count;
+        int max;
+        C3Vector camera;
+    };
+
+    // keeps the max units nearest to the camera
+    int32_t EnumUnit(WOWGUID guid, void* param) {
+        Gather& g = *static_cast<Gather*>(param);
+        CGObject_C* object = ClntObjMgrObjectPtr(guid, TYPEMASK_UNIT, __FILE__, __LINE__);
+        if (!object) return 1;
+        C3Vector pos = object->GetPosition();
+        float height = object->m_height * object->m_scale;
+        if (!(height > 0.1f) || height > 40.0f) height = 2.0f; // model not loaded yet: a person's size
+        float x = pos.x - g.camera.x, y = pos.y - g.camera.y, z = pos.z - g.camera.z;
+        float d2 = x * x + y * y + z * z;
+        int slot = g.count;
+        if (g.count >= g.max) {
+            slot = 0;
+            for (int i = 1; i < g.count; i++) {
+                if (g.dist2[i] > g.dist2[slot]) slot = i;
+            }
+            if (g.dist2[slot] <= d2) return 1;
+        } else {
+            g.count++;
+        }
+        g.out[slot].x = x;
+        g.out[slot].y = y;
+        g.out[slot].z = z;
+        g.out[slot].height = height;
+        g.dist2[slot] = d2;
+        return 1;
+    }
+}
+
+int HD::ContactShadowGatherUnits(HD::ContactShadowUnit* out, int max) {
+    if (max > 64) max = 64;
+    if (max <= 0 || !ClntObjMgrGetCurrent() || !CGWorldFrame::s_currentWorldFrame || !CGWorldFrame::s_currentWorldFrame->m_camera) return 0;
+    Gather g;
+    g.out = out;
+    g.count = 0;
+    g.max = max;
+    CGWorldFrame::GetCameraPosition(&g.camera);
+    ClntObjMgrEnumVisibleObjects(&EnumUnit, &g);
+    return g.count;
+}
diff --git a/WoW/Source/WorldClient/HD/HdDetailDoodad.cpp b/WoW/Source/WorldClient/HD/HdDetailDoodad.cpp
new file mode 100644
index 00000000..1e02c185
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdDetailDoodad.cpp
@@ -0,0 +1,642 @@
+#include "WoW/Source/WorldClient/HD/HdDetailDoodad.h"
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <thread>
+#include <vector>
+#include <windows.h>
+#include <d3d9.h>
+#include <d3dcompiler.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDevice/CGxShader.h"
+#include "Engine/Source/Gx/Types.h"
+#include "WoW/Source/WorldClient/HD/HdGxShader.h"
+#include "Engine/Source/Tempest/C44Matrix.h"
+#include "WoW/Source/WorldClient/DetailDoodad.h"
+#include "WoW/Source/WorldClient/HD/HdGrassWind.h"
+#include "WoW/Source/WorldClient/HD/HdTerrain.h"
+
+namespace {
+    // Grass vertex shader. Source of truth: the 3.3.5 shader rewritten from its bytecode
+    // (Shaders/Vertex/vs_3_0/DetailDoodad.bls), checked numerically against it for every slot, plus the Forever lighting.
+    // (Generated by make_hd_detaildoodad.py from hd_grass_vs.hlsl; MSVC takes at most 16 KB per string piece.)
+    const char kVertexShader[] =
+        R"HLSL(// Waystone HD grass (detail doodad) vertex shader (vs_3_0). Replaces Shaders\Vertex\vs_3_0\DetailDoodad.bls,
+// slot = 3 * POINT_LIGHTS + SHADOW  (CDetailDoodad::SetupVertexShader: SHADOW = min(shadow mode, 2); the client
+// always asks for POINT_LIGHTS 0, slots 3..5 are ported too so a swap is all or nothing).
+// The vertex normal is the normal of the terrain triangle under the tuft (CMapChunk::CreateDetailDoodads), the vertex
+// colour is the terrain's vertex shading x 2 and its alpha the baked terrain shadow (0 or 1).
+// With c49.z = 0 it computes exactly what the 3.3.5 shader does (COLOR1.yzw = 0 as Blizzard writes).
+// With c49.z = 1 it lights the grass like WoW Forever's detaildoodad.bls (the same lighting as its terrain): the
+// ambient comes from a sky / horizon / ground hemisphere shaded by a soft wrap of the sun (0.7 .. 1.1), and the sun
+// goes out separately in COLOR1.yzw (unused by every 3.3.5 grass pixel shader) so the pixel shader can cut it fully
+// in shadow instead of darkening everything to 70%.
+#ifndef SHADOW
+#define SHADOW 0
+#endif
+#ifndef POINT_LIGHTS
+#define POINT_LIGHTS 0
+#endif
+
+float4 cWorldView[4]  : register(c0);   // rows of world * view (CDetailDoodad::SShaderConstants)
+float4 cProj[4]       : register(c4);   // rows of the projection
+float4 cFog           : register(c8);   // x scale, y bias, z power (off = 0, 1, 1)
+float4 cFade          : register(c9);   // x scale, y bias: alpha fade over the last 15% of detailDoodadDist
+float4 cSunDir        : register(c10);  // view-space direction towards the sun
+float4 cSunAmbient    : register(c11);  // the client's ambient (Forever's sky colour)
+float4 cSunDiffuse    : register(c12);  // the sun's colour
+float4 cPoint[9]      : register(c14);  // 3 point lights: position (world axes, camera relative), colour, attenuation
+float4 cShadowMtx[12] : register(c23);  // dyn rows c23..25, bands c26..31, band 2 coordinates c32..34
+float4 cHdLight       : register(c49);  // HD: z = 1 Forever lighting; x, y, w unused here
+float4 cHdLight2      : register(c50);  // HD: x = ambient strength in Forever lighting (1 = the ambient as it is)
+float4 cHdHorizon     : register(c51);  // HD: rgb = Forever's horizon ambient / its sky ambient, per channel
+float4 cHdGround      : register(c52);  // HD: rgb = Forever's ground ambient / its sky ambient, per channel
+// HD: grass wind and parting (HdGrassWind.cpp; adapted from wxl-grasswind by iThorgrim, WarcraftXL, GPLv3)
+float4 cWind0         : register(c53);  // HD: xy = chunk corner mod 64 yd (random seed), w = wave 1 phase at the chunk corner
+float4 cWind1         : register(c54);  // HD: xyz = player relative to the chunk corner, w = lean at the player (0 = off)
+float4 cWind2         : register(c55);  // HD: x = 1 / radius, y = radius, z = 1 / cone height, w = min height
+float4 cWind3         : register(c56);  // HD: wave 1: xy = direction * amplitude, zw = direction * 2 pi / wavelength
+float4 cWind4         : register(c57);  // HD: wave 2, same
+float4 cWind5         : register(c58);  // HD: x = anchor, y = 1 / (1 - anchor), z = variance, w = distance fade
+float4 cWind6         : register(c59);  // HD: x = wave 2 phase at the chunk corner, y = phase spread, z = lean, w = 1 on
+
+#if POINT_LIGHTS
+// point light i at view position vp, normal n (3.3.5: light direction normalised, n not; 1 / (k0 + k1 d + k2 d^2))
+float3 PointLight(int i, float3 vp, float3 n)
+{
+    float3 p = cPoint[3 * i].x * cWorldView[0].xyz + cPoint[3 * i].y * cWorldView[1].xyz + cPoint[3 * i].z * cWorldView[2].xyz;
+    float3 l = p - vp;
+    float r = rsqrt(dot(l, l));
+    float d = 1.0 / r;
+    l = l * r;
+    float4 k = cPoint[3 * i + 2];
+    float att = 1.0 / ((d * d) * k.z + (k.y * d + k.x));
+    return (saturate(dot(l, n)) * cPoint[3 * i + 1].xyz) * att;
+}
+#endif
+
+// HD: world-plane offset of a grass vertex (position lp in the chunk, uv, view depth): wind + parting around the
+// player. uv.y is 1 at the foot of the blade and 0 at its tip, so the foot stays put on any slope.
+float2 GrassOffset(float3 lp, float2 uv, float depth)
+{
+    float blade = saturate((1.0 - uv.y - cWind5.x) * cWind5.y);
+    float w = blade * blade / (1.0 + abs(depth) * cWind5.w);
+    float2 seed = lp.xy + cWind0.xy;
+    float h = frac(seed.x * 0.737 + seed.y * 1.311);
+    float amp = (1.0 - cWind5.z * 0.5) + h * cWind5.z;
+    float j = h * cWind6.y;
+    float s1 = sin(dot(lp.xy, cWind3.zw) + j + cWind0.w) + cWind6.z;
+    float s2 = sin(dot(lp.xy, cWind4.zw) + j + cWind6.x);
+    float2 offset = (cWind3.xy * s1 + cWind4.xy * s2) * (w * amp);
+
+    float2 d = lp.xy - cWind1.xy;
+    float dist = sqrt(dot(d, d) + 0.001);
+    float high = saturate((lp.z - cWind1.z - cWind2.w) * cWind2.z);
+    // x blade: on a slope uphill of the player the foot of the blade would be "high" too, it must not move
+    float push = cWind1.w * (1.0 - saturate(dist * cWind2.x)) * high * blade;
+    return offset + d * (push / dist);
+}
+
+void main(
+    float3 iPos : POSITION0,
+    float3 iNormal : NORMAL0,
+    float4 iColor : COLOR0,
+    float2 iTex0 : TEXCOORD0,
+    out float4 oPos : POSITION0,
+    out float4 oColor : COLOR0,
+    out float4 oColor2 : COLOR1,
+    out float2 oTex0 : TEXCOORD0,
+#if SHADOW
+    out float3 oViewPos : TEXCOORD1,
+    out float3 oNormal : TEXCOORD2,
+#if SHADOW == 1
+    out float3 oShadow0 : TEXCOORD3,
+#else
+    out float4 oShadow0 : TEXCOORD3,
+    out float4 oShadow1 : TEXCOORD4,
+    out float4 oShadow2 : TEXCOORD5,
+#endif
+#endif
+    out float oFog : FOG)
+{
+    float4 vp = iPos.x * cWorldView[0] + iPos.y * cWorldView[1] + iPos.z * cWorldView[2] + cWorldView[3];
+    // HD: wind + parting, moved in the world plane (rows 0 and 1 of world * view are the world x and y axes in view
+    // space: the grass world matrix is a pure translation). Before oPos so fog, fade and received shadows follow.
+    [branch] if (cWind6.w > 0.5) {
+        float2 gw = GrassOffset(iPos, iTex0, vp.z);
+        vp.xyz += gw.x * cWorldView[0].xyz + gw.y * cWorldView[1].xyz;
+    }
+    oPos = vp.x * cProj[0] + vp.y * cProj[1] + vp.z * cProj[2] + vp.w * cProj[3];
+    float fade = saturate(vp.z * cFade.x + cFade.y);
+    oFog = min(pow(max(vp.z * cFog.x + cFog.y, 0.0), cFog.z), 1.0);
+
+    // normal: worldView 3x3, NOT renormalised (3.3.5)
+    float3 n = iNormal.x * cWorldView[0].xyz + iNormal.y * cWorldView[1].xyz + iNormal.z * cWorldView[2].xyz;
+
+#if POINT_LIGHTS
+    float3 p0 = PointLight(0, vp.xyz, n);
+    float3 p1 = PointLight(1, vp.xyz, n);
+    float3 p2 = PointLight(2, vp.xyz, n);
+#endif
+    oColor2 = float4(fade, 0.0, 0.0, 0.0);
+    [branch] if (cHdLight.z > 0.5) {
+        // HD: Forever (detaildoodad.bls = its terrain formula). Ambient: horizon colour for a wall, sky colour for
+        // ground facing up, ground colour for an overhang; the client's ambient is the sky colour (Forever's when
+        // hdForeverLight is 1, so horizon and ground are then Forever's own colours). Then a wrap of the sun over it,
+        // and the sun on its own in COLOR1.yzw.
+        float3 nn = normalize(n);
+        float up = dot(normalize(cWorldView[2].xyz), nn);
+        float nl = dot(cSunDir.xyz, nn);
+        float3 sky = cSunAmbient.xyz * cHdLight2.x;
+        float3 horizon = sky * cHdHorizon.xyz;
+        float3 hemi = horizon + (sky - horizon) * saturate(up) + (sky * cHdGround.xyz - horizon) * saturate(-up);
+        float3 ambient = hemi * (nl * 0.2 + 0.9);
+#if POINT_LIGHTS
+        ambient = ambient + (p0 + p1 + p2);
+#endif
+        float3 direct = cSunDiffuse.xyz * saturate(nl);
+        // like 3.3.5 (min of the light and 1), a channel never goes over 1: both parts are scaled down together
+        float3 fit = 1.0 / max(ambient + direct, 1.0);
+        oColor = float4(ambient * fit * iColor.xyz, iColor.w);
+        oColor2.yzw = direct * fit * iColor.xyz;
+    } else {
+        float3 light = cSunDiffuse.xyz * saturate(dot(cSunDir.xyz, n)) + cSunAmbient.xyz;
+#if POINT_LIGHTS
+        // 3.3.5 order: sun + ambient, then each light added in turn
+        light = p0 + light;
+        light = p1 + light;
+        light = p2 + light;
+#endif
+        light = min(light, 1.0);
+        oColor = float4(light * iColor.xyz, iColor.w);
+    }
+    oTex0 = iTex0;
+
+#if SHADOW
+    oViewPos = vp.xyz;
+    oNormal = n;
+    float4 sp = float4(vp.xyz, 1.0);
+#if SHADOW == 1
+    oShadow0 = float3(dot(sp, cShadowMtx[0]), dot(sp, cShadowMtx[1]), dot(sp, cShadowMtx[2]));
+#else
+    oShadow0 = float4(dot(sp, cShadowMtx[0]), dot(sp, cShadowMtx[1]), dot(sp, cShadowMtx[2]), dot(sp, cShadowMtx[9]));
+    oShadow1 = float4(dot(sp, cShadowMtx[3]), dot(sp, cShadowMtx[4]), dot(sp, cShadowMtx[5]), dot(sp, cShadowMtx[10]));
+    oShadow2 = float4(dot(sp, cShadowMtx[6]), dot(sp, cShadowMtx[7]), dot(sp, cShadowMtx[8]), dot(sp, cShadowMtx[11]));
+#endif
+#endif
+}
+)HLSL";
+
+    // Grass pixel shader (8 slots), same method.
+    const char kPixelShader[] =
+        R"HLSL(// Waystone HD grass (detail doodad) pixel shader (ps_3_0). Replaces Shaders\Pixel\ps_3_0\DetailDoodad.bls,
+// slot = SHADOW + 4 * PCF  (CDetailDoodad::InitializeRenderState).
+//   SHADOW 0 none (baked terrain shadow only), 1 player shadow, 2 player shadow + 3 sun bands, 3 near cascade + 3 sun
+//   bands; PCF 1 = hardware depth compare (D24) instead of the R32F manual compare.
+// COLOR0.w is the baked terrain shadow (0 or 1), COLOR1.x the distance fade (alpha), COLOR1.yzw comes from the HD
+// vertex shader: the sun's light (Forever lighting only).
+// With c15.x = 0 it computes exactly what the 3.3.5 shader does: the shadow S darkens the whole light to 70%.
+// With c15.x = 1 (Forever lighting, detaildoodad.bls) the sun is cut fully by the shadow, the baked terrain shadow
+// included, and the ambient (COLOR0) is left alone: light = saturate(COLOR0 + COLOR1.yzw * min(S, baked)).
+// c15.y = 1 is the test view: only the sun after the shadow.
+#ifndef SHADOW
+#define SHADOW 0
+#endif
+#ifndef PCF
+#define PCF 0
+#endif
+
+float4 cFogColor     : register(c2);   // rgb = fog colour
+float4 cCutoff       : register(c3);   // view-space plane: past it the shadow fades out
+float4 cSunDirView   : register(c4);   // view-space sun direction (shadow facing term)
+float4 cPcfOffset[8] : register(c5);   // xy = PCF tap offsets in shadow-map UV (c5..c12)
+float4 cHdPs         : register(c15);  // HD: x = 1 Forever lighting, y = 1 test view
+
+sampler2D sTex0      : register(s0);
+#if SHADOW >= 1
+sampler2D sShadow0   : register(s4);   // dynamic (player) shadow, or near cascade in mode 3
+#endif
+#if SHADOW >= 2
+sampler2D sShadow1   : register(s5);   // sun shadow band 0
+sampler2D sShadow2   : register(s6);   // band 1
+sampler2D sShadow3   : register(s7);   // band 2
+#endif
+
+#if SHADOW >= 1
+// one shadow tap at shadow-map UV uv for light-space depth z: 1 = lit, 0 = shadowed
+float Tap(sampler2D s, float2 uv, float z)
+{
+#if PCF
+    return tex2Dlod(s, float4(uv, z, 0.0)).x;
+#else
+    return step(z, tex2Dlod(s, float4(uv, 0.0, 0.0)).x);
+#endif
+}
+
+// centre + offsets 0,2,4,6 ; returns the SUM (0..5)
+float Sum5(sampler2D s, float2 c, float z)
+{
+    float2 uv = c * 0.5 + 0.5;
+    float sum = Tap(s, uv, z);
+    sum = sum + Tap(s, uv + cPcfOffset[0].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[2].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[4].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[6].xy, z);
+    return sum;
+}
+
+// centre + all 8 offsets ; returns the SUM (0..9)
+float Sum9(sampler2D s, float2 c, float z)
+{
+    float2 uv = c * 0.5 + 0.5;
+    float sum = Tap(s, uv, z);
+    sum = sum + Tap(s, uv + cPcfOffset[0].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[1].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[2].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[3].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[4].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[5].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[6].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[7].xy, z);
+    return sum;
+}
+
+// edge fades (the float32 constants of the 3.3.5 shaders, written out in full)
+float EdgeFade(float2 c)
+{
+    return saturate(max(abs(c.x), abs(c.y)) * -3.4482758045196533 + 3.4137930870056152);
+}
+#endif
+#if SHADOW >= 2
+float EdgeFade2(float2 c)
+{
+    return saturate(max(abs(c.x), abs(c.y)) * -11.11111068725586 + 11.0);
+}
+#endif
+
+void main(
+    float4 iColor : COLOR0,
+    float4 iColor2 : COLOR1,
+    float2 iTex0 : TEXCOORD0,
+#if SHADOW
+    float3 iViewPos : TEXCOORD1,
+    float3 iNormal : TEXCOORD2,
+#if SHADOW == 1
+    float3 iShadow0 : TEXCOORD3,
+#else
+    float4 iShadow0 : TEXCOORD3,
+    float4 iShadow1 : TEXCOORD4,
+    float4 iShadow2 : TEXCOORD5,
+#endif
+#endif
+    float iFog : FOG,
+    out float4 oColor : COLOR0)
+{
+    float4 t = tex2D(sTex0, iTex0);
+    float alpha = t.w * iColor2.x;
+
+    // ---- shadow term S (1 = lit). The baked terrain shadow (COLOR0.w) is S itself without dynamic shadows and
+    // bounds it with the player shadow (3.3.5); the sun bands of modes 2 and 3 replace it.
+#if SHADOW == 0
+    float S = iColor.w;
+#else
+    float S = 1.0;
+    float fade = EdgeFade(iShadow0.xy);
+#if SHADOW == 1 || SHADOW == 2
+#if SHADOW == 1
+    S = iColor.w;
+#endif
+    [branch] if (fade > 0.0099999997764825821) {
+        [branch] if (10.0 < iViewPos.z) {
+            S = fade * (Sum5(sShadow0, iShadow0.xy, iShadow0.z) * 0.20000000298023224 - 1.0) + 1.0;
+        } else {
+            S = fade * (Sum9(sShadow0, iShadow0.xy, iShadow0.z) * 0.1111111119389534 - 1.0) + 1.0;
+        }
+#if SHADOW == 1
+        S = min(S, iColor.w);
+#endif
+    }
+#else
+    [branch] if (fade > 0.0) {
+        S = Sum5(sShadow0, iShadow0.xy, iShadow0.z) * 0.20000000298023224;
+    }
+#endif
+    // past the cutoff plane the shadow fades out
+    S = lerp(S, 1.0, saturate(dot(iViewPos, cCutoff.xyz) + cCutoff.w));
+#if SHADOW >= 2
+    float band;
+    [branch] if (max(abs(iShadow1.x), abs(iShadow1.y)) < 1.0) {
+        band = Sum5(sShadow1, iShadow1.xy, iShadow1.z) * 0.20000000298023224;
+    } else {
+        [branch] if (max(abs(iShadow2.x), abs(iShadow2.y)) < 1.0) {
+            band = Sum5(sShadow2, iShadow2.xy, iShadow2.z) * 0.20000000298023224;
+        } else {
+            float3 c3 = float3(iShadow0.w, iShadow1.w, iShadow2.w);
+            band = EdgeFade2(c3.xy) * (Sum5(sShadow3, c3.xy, c3.z) * 0.20000000298023224 - 1.0) + 1.0;
+        }
+    }
+    S = min(band, S);
+#endif
+    // surfaces seen edge-on from the sun lose the shadow (down to the baked one in mode 1)
+    float facing = 1.2000000476837158 - abs(dot(cSunDirView.xyz, iNormal));
+    facing = facing * facing;
+#if SHADOW == 1
+    S = lerp(S, iColor.w, saturate(facing * facing));
+#else
+    S = lerp(S, 1.0, saturate(facing * facing));
+#endif
+#endif
+    float3 light = iColor.xyz * (S * 0.30000001192092896 + 0.699999988079071);
+
+    // HD: Forever: the shadow takes only the sun, the baked terrain shadow too; the ambient stays whole
+    float sun = min(S, iColor.w);
+    [branch] if (cHdPs.x > 0.5) {
+        light = saturate(iColor.xyz + iColor2.yzw * sun);
+    }
+
+    // ---- combine (3.3.5: texture x light, the vertex colour already holds the x2; then the fog)
+    float3 col = t.xyz * light;
+    oColor = float4((col - cFogColor.xyz) * iFog + cFogColor.xyz, alpha);
+    // HD: test view (hdGrassLight 3): only the sun after the shadow, no texture, no ambient, no fog
+    if (cHdPs.y > 0.5) oColor.xyz = iColor2.yzw * sun;
+}
+)HLSL";
+
+    typedef HRESULT(WINAPI* D3DCompileFn)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*, LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+
+    // CDetailDoodad::s_vertexShader[6]: slot = 3 * point lights + min(shadow mode, 2)
+    // CDetailDoodad::s_pixelShader[8]: slot = shadow mode + 4 * PCF
+    const int32_t kVertexSlots = 6;
+    const int32_t kPixelSlots = 8;
+    const int32_t kOursMark = 0x48444444; // 'HDDD' in CGxShader::unused_0028: the shader holds our code
+
+    enum { StateIdle, StateCompiling, StateReady, StateFailed };
+
+    std::atomic<int32_t> s_state(StateIdle);
+    std::vector<uint8_t> s_vertexCode[kVertexSlots]; // written by the compile thread before s_state = StateReady
+    std::vector<uint8_t> s_pixelCode[kPixelSlots];
+    char s_threadInfo[260] = "";             // written by the compile thread before s_state changes to Ready/Failed
+    char s_refusedInfo[200] = "";            // a grass shader we cannot replace: then none is replaced (all or nothing)
+    int32_t s_shownState = -1;
+    int32_t s_inUse = 0;                     // shaders holding our code right now (shown in hdGrassInfo)
+    bool s_ours = false;                     // all 14 grass shaders hold our code (vertex constants are needed)
+    float s_vertexConstants[44];             // c49..c52 for this frame (DetailDoodadShaders), HD: c53..c59 grass wind per chunk
+
+    std::map<CGxShader*, std::vector<uint8_t> > s_original; // Blizzard's code of each shader we changed
+    struct Retired { IUnknown* object; ULONGLONG time; };
+    std::vector<Retired> s_retired;          // D3D shaders we replaced, released a little later (may still be bound)
+
+    CVar* s_light = nullptr;
+    CVar* s_info = nullptr;
+
+    void RegisterCVars() {
+        static bool registered = false;
+        if (registered) return;
+        registered = true;
+        HD::ShaderCVars(); // HD: hdShaderDump
+        s_light = CVar::Register("hdGrassLight", "HD: 1 = WoW Forever lighting on grass, 2 = our shaders with 3.3.5 lighting, 3 = test view (sun after shadow only), 0 = Blizzard shaders", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_info = CVar::Register("hdGrassInfo", "HD: hdGrassLight status (read only)", 0, "not started", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        HD::GrassWindRegister(); // HD: grass wind cvars
+    }
+
+    void SetMacro(D3D_SHADER_MACRO* macros, int32_t i, const char* name, int32_t value, char (*values)[4]) {
+        snprintf(values[i], 4, "%d", value);
+        macros[i].Name = name;
+        macros[i].Definition = values[i];
+    }
+
+    bool Compile(D3DCompileFn compile, const char* source, const char* name, const D3D_SHADER_MACRO* macros, const char* profile, std::vector<uint8_t>& out, const char* what, int32_t index) {
+        ID3DBlob* code = nullptr;
+        ID3DBlob* errors = nullptr;
+        HRESULT hr = compile(source, strlen(source), name, macros, nullptr, "main", profile, D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+        if (FAILED(hr) || !code) {
+            snprintf(s_threadInfo, sizeof(s_threadInfo), "ERROR: %s %d: %s", what, index, errors ? static_cast<const char*>(errors->GetBufferPointer()) : "unknown");
+            if (errors) errors->Release();
+            if (code) code->Release();
+            return false;
+        }
+        if (errors) errors->Release();
+        const uint8_t* bytes = static_cast<const uint8_t*>(code->GetBufferPointer());
+        out.assign(bytes, bytes + code->GetBufferSize());
+        code->Release();
+        return true;
+    }
+
+    // Compile thread: every slot, all or nothing.
+    void CompileAll() {
+        ULONGLONG start = GetTickCount64();
+        HMODULE module = LoadLibraryA("d3dcompiler_47.dll");
+        D3DCompileFn compile = module ? reinterpret_cast<D3DCompileFn>(GetProcAddress(module, "D3DCompile")) : nullptr;
+        if (!compile) {
+            snprintf(s_threadInfo, sizeof(s_threadInfo), "ERROR: d3dcompiler_47.dll not found, Blizzard shaders kept");
+            s_state.store(StateFailed);
+            return;
+        }
+        int32_t total = 0;
+        for (int32_t p = 0; p < kVertexSlots; p++) {
+            D3D_SHADER_MACRO macros[3];
+            char values[2][4];
+            SetMacro(macros, 0, "SHADOW", p % 3, values);
+            SetMacro(macros, 1, "POINT_LIGHTS", p / 3, values);
+            macros[2].Name = nullptr;
+            macros[2].Definition = nullptr;
+            if (!Compile(compile, kVertexShader, "HdGrassVS", macros, "vs_3_0", s_vertexCode[p], "DetailDoodad vertex", p)) {
+                s_state.store(StateFailed);
+                return;
+            }
+            HD::ShaderDump("HdGrass", false, 0, p, &s_vertexCode[p][0], s_vertexCode[p].size()); // HD
+            total++;
+        }
+        for (int32_t p = 0; p < kPixelSlots; p++) {
+            D3D_SHADER_MACRO macros[3];
+            char values[2][4];
+            SetMacro(macros, 0, "SHADOW", p & 3, values);
+            SetMacro(macros, 1, "PCF", p >> 2, values);
+            macros[2].Name = nullptr;
+            macros[2].Definition = nullptr;
+            if (!Compile(compile, kPixelShader, "HdGrassPS", macros, "ps_3_0", s_pixelCode[p], "DetailDoodad pixel", p)) {
+                s_state.store(StateFailed);
+                return;
+            }
+            HD::ShaderDump("HdGrass", true, 0, p, &s_pixelCode[p][0], s_pixelCode[p].size()); // HD
+            total++;
+        }
+        snprintf(s_threadInfo, sizeof(s_threadInfo), "%d shaders compiled in %u ms", total, static_cast<uint32_t>(GetTickCount64() - start));
+        s_state.store(StateReady);
+    }
+
+    void ShowState(int32_t state) {
+        s_shownState = state;
+        if (!s_info) return;
+        char text[500];
+        if (state == StateCompiling) snprintf(text, sizeof(text), "compiling (Blizzard shaders until done)");
+        else if (state == StateIdle) snprintf(text, sizeof(text), "not started");
+        else if (state == StateReady && s_refusedInfo[0]) snprintf(text, sizeof(text), "%s; %s", s_threadInfo, s_refusedInfo);
+        else if (state == StateReady) snprintf(text, sizeof(text), "%s, %d in use", s_threadInfo, s_inUse);
+        else snprintf(text, sizeof(text), "%s", s_threadInfo);
+        s_info->Set(text, true, false, false, false);
+    }
+
+    void ReleaseRetired(bool all) {
+        if (s_retired.empty()) return;
+        ULONGLONG now = GetTickCount64();
+        size_t kept = 0;
+        for (size_t i = 0; i < s_retired.size(); i++) {
+            if (all || now - s_retired[i].time > 2000) s_retired[i].object->Release();
+            else s_retired[kept++] = s_retired[i];
+        }
+        s_retired.resize(kept);
+    }
+
+    // New code for this shader; its D3D object is made again from it the next time it is bound.
+    void SetCode(CGxShader* shader, const uint8_t* data, uint32_t size) {
+        if (shader->m_apiSpecific && HD::ShaderObjectOwnedByDevice()) {
+            shader->m_apiSpecific = nullptr; // HD: Vulkan: the translator's record, the device's own
+        }
+        if (shader->m_apiSpecific) {
+            // the device may still have it bound for this frame: release it a little later
+            Retired retired = { static_cast<IUnknown*>(shader->m_apiSpecific), GetTickCount64() };
+            s_retired.push_back(retired);
+            shader->m_apiSpecific = nullptr;
+        }
+        shader->m_loaded = 0;
+        shader->m_valid = 0;
+        shader->m_code.SetCount(size);
+        memcpy(shader->m_code.m_data, data, size);
+    }
+
+    // Our code for the grass shader in this slot; null if it is not shader model 3 code (a ps_2_x or OpenGL device
+    // keeps Blizzard's shaders).
+    const std::vector<uint8_t>* OurCode(CGxShader* shader, bool vertex, int32_t slot) {
+        if (!shader) return nullptr;
+        uint32_t version = vertex ? 0xFFFE0300u : 0xFFFF0300u;
+        if (shader->m_code.Count() < 4 || *reinterpret_cast<const uint32_t*>(shader->m_code.m_data) != version) return nullptr;
+        const std::vector<uint8_t>* code = vertex ? &s_vertexCode[slot] : &s_pixelCode[slot];
+        if (code->size() >= 4 && !HD::ShaderKnown(&(*code)[0], code->size())) return nullptr; // HD: Vulkan, untranslated
+        return code->size() >= 4 ? code : nullptr;
+    }
+
+    // Gives the shader our code (want) or Blizzard's back; returns true if it holds our code afterwards.
+    bool Apply(CGxShader* shader, bool vertex, int32_t slot, bool want) {
+        if (!shader) return false;
+        bool ours = shader->unused_0028 == kOursMark;
+        if (want == ours) return ours;
+        ReleaseRetired(false);
+        if (!want) {
+            std::map<CGxShader*, std::vector<uint8_t> >::iterator it = s_original.find(shader);
+            if (it != s_original.end() && !it->second.empty()) SetCode(shader, &it->second[0], static_cast<uint32_t>(it->second.size()));
+            shader->unused_0028 = 0;
+            s_inUse--;
+            return false;
+        }
+        const std::vector<uint8_t>* code = OurCode(shader, vertex, slot);
+        if (!code) return false; // checked by AllReplaceable before
+        s_original[shader].assign(shader->m_code.m_data, shader->m_code.m_data + shader->m_code.Count());
+        SetCode(shader, &(*code)[0], static_cast<uint32_t>(code->size()));
+        shader->unused_0028 = kOursMark;
+        s_inUse++;
+        return true;
+    }
+
+    // All or nothing: one grass shader we cannot replace and every one stays Blizzard's (our pixel shader needs our
+    // vertex shader's sun in COLOR1). Returns false then.
+    bool AllReplaceable() {
+        for (int32_t p = 0; p < kVertexSlots + kPixelSlots; p++) {
+            bool vertex = p < kVertexSlots;
+            int32_t slot = vertex ? p : p - kVertexSlots;
+            CGxShader* shader = vertex ? CDetailDoodad::s_vertexShader[slot] : CDetailDoodad::s_pixelShader[slot];
+            if (shader && shader->unused_0028 == kOursMark) continue;
+            if (!OurCode(shader, vertex, slot)) {
+                snprintf(s_refusedInfo, sizeof(s_refusedInfo), "refused DetailDoodad %s %d, Blizzard shaders kept", vertex ? "vertex" : "pixel", slot);
+                return false;
+            }
+        }
+        return true;
+    }
+
+    // Every grass shader to our code (want) or Blizzard's; true if all of them hold ours afterwards.
+    bool ApplyAll(bool want) {
+        bool all = true;
+        for (int32_t p = 0; p < kVertexSlots; p++) all = Apply(CDetailDoodad::s_vertexShader[p], true, p, want) && all;
+        for (int32_t p = 0; p < kPixelSlots; p++) all = Apply(CDetailDoodad::s_pixelShader[p], false, p, want) && all;
+        return all;
+    }
+}
+
+void HD::DetailDoodadShadersStart() {
+    RegisterCVars();
+    int32_t expected = StateIdle;
+    if (!s_state.compare_exchange_strong(expected, StateCompiling)) return;
+    std::thread(CompileAll).detach();
+}
+
+void HD::DetailDoodadShaders() {
+    RegisterCVars();
+    if (s_state.load() == StateIdle) HD::DetailDoodadShadersStart(); // in case CDetailDoodad::Initialize did not start it
+    int32_t state = s_state.load();
+    if (state != s_shownState) ShowState(state);
+
+    int32_t mode = s_light ? s_light->m_intValue : 1;
+    if (mode == 0 && s_inUse == 0) {
+        // HD: Blizzard's shaders and nothing of ours in place: touch nothing (no extra D3D call)
+        s_ours = false;
+        return;
+    }
+    bool d3d9 = HD::ShaderSwapDevice(); // HD: D3D9, or Vulkan through the translated modules
+    bool want = state == StateReady && mode != 0 && d3d9 && !s_refusedInfo[0];
+    int32_t inUse = s_inUse;
+    if (want && !AllReplaceable()) {
+        want = false;
+        ShowState(state);
+    }
+    bool ours = ApplyAll(want);
+    if (want && !ours) ours = ApplyAll(false); // one did not take ours: all go back to Blizzard's
+    s_ours = ours;
+    if (s_inUse != inUse) ShowState(state);
+    if (!ours) return;
+
+    // HD: constants of our shaders. Pixel c15 now (the grass pixel shader is bound once for all grass); vertex
+    // c49..c52 after the client's constants of each chunk (DetailDoodadVertexConstants: terrain and buildings use the
+    // same registers between two grass frames).
+    bool forever = mode == 1 || mode == 3;
+    bool test = mode == 3;
+    float horizon[3];
+    float ground[3];
+    HD::TerrainHemisphere(horizon, ground);
+    float* v = s_vertexConstants;
+    v[0] = 0.0f;
+    v[1] = 0.0f;
+    v[2] = forever ? 1.0f : 0.0f;       // c49.z Forever lighting
+    v[3] = test ? 1.0f : 0.0f;          // c49.w test view (read by the pixel shader through c15.y)
+    v[4] = HD::LightAmbientStrength();  // c50.x
+    v[5] = 0.0f;
+    v[6] = 0.0f;
+    v[7] = 0.0f;
+    for (int32_t c = 0; c < 3; c++) {
+        v[8 + c] = horizon[c];          // c51
+        v[12 + c] = ground[c];          // c52
+    }
+    v[11] = 0.0f;
+    v[15] = 0.0f;
+    HD::GrassWindPrepare(); // HD: wind phases and player position for this frame (c53..c59 per chunk)
+    float pixel[4] = { forever ? 1.0f : 0.0f, test ? 1.0f : 0.0f, 0.0f, 0.0f };
+    HD::PixelConstantsSet(15, pixel, 1); // HD: also the vertex row the Vulkan modules read
+}
+
+void HD::DetailDoodadVertexConstants(const C44Matrix& world) {
+    if (!s_ours) return;
+    // HD: c53..c59 grass wind for this chunk (world = translation chunk corner - s_activeWorldView)
+    HD::GrassWindConstants(world.d0, world.d1, world.d2, s_vertexConstants + 16);
+    g_theGxDevicePtr->ShaderConstantsSet(GxSh_Vertex, 49, s_vertexConstants, 11);
+}
+
+void HD::DetailDoodadShadersForget() {
+    if (s_inUse) ApplyAll(false);
+    s_ours = false;
+    s_original.clear();
+    s_inUse = 0;
+    ReleaseRetired(true);
+}
diff --git a/WoW/Source/WorldClient/HD/HdDetailDoodad.h b/WoW/Source/WorldClient/HD/HdDetailDoodad.h
new file mode 100644
index 00000000..aefc0c90
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdDetailDoodad.h
@@ -0,0 +1,54 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDDETAILDOODAD_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDDETAILDOODAD_H
+
+// Waystone HD: our own grass (detail doodad) shaders (not part of the original client).
+// They are the 3.3.5 DetailDoodad shaders rewritten in HLSL (checked against Blizzard's bytecode for all 6 vertex
+// and 8 pixel slots), compiled when the game starts, with WoW Forever's grass lighting (its detaildoodad shader
+// lights grass exactly like its terrain, so the grass matches hdTerrainLight):
+//   - the ambient comes from three colours: sky (ground facing up), horizon (walls), ground (overhangs); the client's
+//     ambient is the sky colour, horizon and ground are it times Forever's own horizon / sky and ground / sky (the
+//     same ratios as the terrain, HD::TerrainHemisphere); the normal is the terrain's under the tuft, as in 3.3.5;
+//   - a soft wrap of the sun over that ambient (x0.7 facing away from the sun .. x1.1 facing it);
+//   - the sun is cut fully by the shadow (player shadow, sun bands and the baked terrain shadow), the ambient is not
+//     touched by it (3.3.5 darkens everything to 70%).
+//   The fade at the end of the grass distance, the texture, the vertex colour and the fog stay exactly Blizzard's.
+//   hdGrassLight 1 = Forever lighting (default)
+//                2 = our shaders with the 3.3.5 lighting: must look exactly like 0 (proves the swap changes nothing)
+//                3 = test view: only the sun after the shadow (black in shadow, no texture), proves our shader draws
+//                0 = Blizzard's shaders
+//   hdLightAmbient (HdTerrain's) ambient strength in Forever lighting, 1 = Forever's (a test knob, keep it at 1)
+//   hdGrassWind, hdGrassWindSpeed, hdGrassWindDirection, hdGrassWindStrength, hdGrassReact, hdGrassReactRadius:
+//                HD: wind in the grass and grass parting around the player, see HdGrassWind.h
+//   hdGrassInfo  read only, compile result and how many shaders hold our code:  /run print(GetCVar("hdGrassInfo"))
+
+#include <cstdint>
+
+class C44Matrix;
+
+namespace HD {
+    // Starts compiling our grass shaders on a background thread (once; called from CDetailDoodad::Initialize).
+    void DetailDoodadShadersStart();
+
+    // Called in CDetailDoodad::InitializeRenderState just before the grass pixel shader is bound, once per frame:
+    // gives the 6 vertex and 8 pixel grass shaders our code or Blizzard's (all of them together), to match
+    // hdGrassLight, and sets pixel constant c15. With hdGrassLight 0 and nothing of ours in place it does nothing.
+    void DetailDoodadShaders();
+
+    // Called in CDetailDoodad::SetupVertexShader after the client's grass constants: vertex constants c49..c52 of our
+    // vertex shader, HD: and c53..c59 grass wind for this chunk (HdGrassWind.h; world = the chunk's grass world
+    // matrix) (nothing when Blizzard's shaders are in place).
+    void DetailDoodadVertexConstants(const C44Matrix& world);
+
+    // Called in CDetailDoodad::Destroy before the shaders are released: gives them Blizzard's code back.
+    void DetailDoodadShadersForget();
+
+    // hdGrassBuffers (DetailDoodad.cpp): called in CWorldScene::RenderDetailDoodads before the first grass draw,
+    // fills the persistent grass buffers of the frame so no fill lands between two draws of the same pool.
+    void DetailDoodadPrepareBuffers();
+
+    // HD: hdGrassKeep. Frames a chunk's grass stays (buffers filled, instances placed) after it was last drawn,
+    // instead of 3.3.5's 10 (buffers) and 20 (instances): turning the camera then finds it ready. 0 = native.
+    uint32_t DetailDoodadKeepFrames();
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdFog.cpp b/WoW/Source/WorldClient/HD/HdFog.cpp
new file mode 100644
index 00000000..35e5e3c7
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdFog.cpp
@@ -0,0 +1,932 @@
+#include "WoW/Source/WorldClient/HD/HdFog.h"
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <windows.h>
+#include <d3d9.h>
+#include <d3dcompiler.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDeviceD3d/CGxDeviceD3d.h"
+#include "Engine/Source/Gx/Types.h"
+#include "WoW/Source/WorldClient/DayNight__DNInfo.h"
+#include "WoW/Source/WorldClient/HD/HdBloom.h"
+#include "WoW/Source/WorldClient/HD/HdGrade.h"
+#include "WoW/Source/WorldClient/HD/HdForever.h"
+#include "WoW/Source/WorldClient/HD/HdWater.h" // HD: hdWater needs the world depth too
+#include "WoW/Source/WorldClient/HD/HdGI.h" // HD: hdGI needs the world depth too
+#include "WoW/Source/WorldClient/HD/HdContactShadow.h" // HD: hdContactShadow needs the world depth too
+#include "WoW/Source/DB/Rec/LightRec.h"
+#include "Engine/Source/Gx/CGxTex.h"
+#include "Engine/Source/Services/Texture.h"
+#include "Engine/Source/ShaderEffect/ShadowCache.h"
+
+// Defined in CGxDeviceD3d.cpp: called before the D3D9 device releases its resources.
+extern void (*g_hdBeforeReleaseD3d)();
+// Defined in CGxDeviceD3d.cpp: lets us choose the depth buffer when the client switches render targets.
+extern IDirect3DSurface9* (*g_hdDepthOverride)(IDirect3DSurface9* color, IDirect3DSurface9* depth);
+// Defined in CGxDeviceD3d.cpp: true while DeviceRestoreDepthSurface calls g_hdDepthOverride.
+extern bool g_hdDepthRestoring;
+// Defined in CGxDeviceD3d.cpp: called before every scene clear.
+extern void (*g_hdOnClear)(DWORD flags);
+
+namespace {
+    // Pixel shader registers c0..c33 (see kShader).
+    const UINT kConstRegs = 34;
+    const D3DFORMAT kIntz = static_cast<D3DFORMAT>(MAKEFOURCC('I', 'N', 'T', 'Z'));
+    // HD: Forever's fog range (yards): the distance ramp runs over it and the sky is fogged up to it
+    const float kFogRange = 5000.0f;
+    // HD: Forever draws its fog in HDR (the sun scatter carries the sun's strength) and then exposes the frame;
+    // our image is not HDR, so both colour terms get a fixed scale, measured on the Forever capture at Amani Pass
+    // 5:48 (setting 7624): the haze there has exactly the sun colour's ratios (G/R 0.55-0.60 at 25-45 degrees
+    // from the sun, no trace of the teal base colour), which needs the sun term about 26x the base colour,
+    // and the haze 25 degrees from the sun is 0.71 (linear red). One capture: check against a second time of day.
+    // 2026-10-19 second pass: with these first values the frame was far brighter and hazier than Forever's
+    // (brightness percentiles 50/75 = 139/228 against Forever's 78/150); max's slider test (density 0.2, sun 0.45,
+    // base 0.6) gave 80/125. The defaults now sit between the two, at about Forever's distribution.
+    const float kFogBaseScale = 0.034f;
+    const float kFogSunScale = 0.88f;
+    // Forever's density column per yard (coa-vfog reads it as x 0.01; that fogged everything past 40 yards here)
+    const float kFogDensityScale = 0.0035f;
+
+    // HD: WoW Forever's global fog, as its own shader computes it (volumefogglobalfog + volumefogcomposite,
+    // extracted from the Forever client). Per layer (LightDataGlobalVolumeFog, forever_data\hd_forever_fog.txt):
+    //   density d = density * coverage past the start distance * (1 + strength * (share of the fog range)^exponent)
+    //               * top fade exp(-topRate * (z - topHeight)) * bottom fade exp(bottomRate * (z - bottomHeight))
+    //   colour    = base colour + sun colour * intensity * phase(toward the sun, g)
+    // The layers add up, the ray is integrated like Forever's froxel volume (L += T * colour * (1 - e^-d), T *= e^-d),
+    // and the scene becomes scene * T + L, in linear light.
+    // Forever marches a froxel volume with a sun shadow map and a phase table; here the march is per pixel
+    // (32 steps, denser near the camera like Forever's slices) and the phase is Henyey-Greenstein scaled to 1
+    // toward the sun. HD: layers with the sun shadow flag use the client's own sun shadow maps (CShadowCache,
+    // 3 cascades of 40, 160 and 640 yards) at every step, like Forever's shader: in shadow the layer takes its
+    // shadow colour and shadow density and loses the sun colour, which draws the light shafts.
+    const char* kShader = R"HLSL(
+sampler2D depthTex : register(s0);
+sampler2D sceneTex : register(s1);
+sampler2D shadow0 : register(s2); // the client's sun shadow cascades (40, 160, 640 yards)
+sampler2D shadow1 : register(s3);
+sampler2D shadow2 : register(s4);
+float4 c_screen : register(c0);  // 1/width, 1/height, proj c2, proj d2
+float4 c_proj   : register(c1);  // proj a0, proj b1, proj c0, proj c1
+float4 c_rot0   : register(c2);  // view -> world rotation, row 0
+float4 c_rot1   : register(c3);  // row 1
+float4 c_rot2   : register(c4);  // row 2
+float4 c_cam    : register(c5);  // camera position (z = height), far clip
+float4 c_sun    : register(c6);  // direction to the sun
+float4 c_vp     : register(c7);  // viewport depth range min z, max z, debug mode, unused
+float4 c_range  : register(c8);  // fog range (yards), 1 / fog range
+float4 c_layer[15] : register(c9); // per layer, 5 registers:
+                                   // base colour (linear) + density per yard,
+                                   // sun colour (linear, x intensity) + g,
+                                   // start, ramp strength, ramp exponent, 1 = sun shadow,
+                                   // top rate per yard, top height, bottom rate per yard, bottom height,
+                                   // base colour in shadow + density factor in shadow
+float4 c_smat[9]   : register(c24); // view space -> shadow map, 3 rows per cascade (CShadowCache::s_shadowMatrices 3..11)
+float4 c_shadow    : register(c33); // 1 = shadow maps bound, 1 = hardware depth compare (D24), sun up 0..1
+
+// one cascade: x, y = -1..1 across the map, z = depth to compare (lit when not deeper than the map)
+float ShadowSample(sampler2D map, float3 c) {
+    float2 uv = c.xy * 0.5 + 0.5;
+    if (c_shadow.y > 0.5) return tex2Dlod(map, float4(uv, c.z, 0)).r;
+    return c.z <= tex2Dlod(map, float4(uv, 0, 0)).r ? 1.0 : 0.0;
+}
+
+// sun light reaching this view-space point: 1 = lit, 0 = in shadow (the nearest cascade that holds it)
+float SunVisible(float3 p) {
+    if (c_shadow.x < 0.5) return 1.0;
+    float4 q = float4(p, 1.0);
+    float3 c = float3(dot(q, c_smat[0]), dot(q, c_smat[1]), dot(q, c_smat[2]));
+    if (max(abs(c.x), abs(c.y)) < 0.98) return ShadowSample(shadow0, c);
+    c = float3(dot(q, c_smat[3]), dot(q, c_smat[4]), dot(q, c_smat[5]));
+    if (max(abs(c.x), abs(c.y)) < 0.98) return ShadowSample(shadow1, c);
+    c = float3(dot(q, c_smat[6]), dot(q, c_smat[7]), dot(q, c_smat[8]));
+    if (max(abs(c.x), abs(c.y)) < 0.98) return ShadowSample(shadow2, c);
+    return 1.0;
+}
+
+// Henyey-Greenstein, 1 toward the sun
+float Phase(float c, float g) {
+    g = clamp(g, -0.95, 0.95);
+    float k = (1.0 - g) / sqrt(max(1.0 + g * g - 2.0 * g * c, 1e-4));
+    return k * k * k;
+}
+
+float4 main(float2 vpos : VPOS) : COLOR0 {
+    float2 uv = (vpos + 0.5) * c_screen.xy;
+    float raw = tex2D(depthTex, uv).r;
+    // the world viewport only uses depth c_vp.x..c_vp.y (0..0.94): back to the projection's 0..1
+    float z = saturate((raw - c_vp.x) / max(c_vp.y - c_vp.x, 1e-4));
+    float2 ndc = float2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
+    float3 v = float3((ndc.x - c_proj.z) / c_proj.x, (ndc.y - c_proj.w) / c_proj.y, 1.0);
+    // view depth from the depth buffer: z = c2 + d2 / zv
+    float denom = z - c_screen.z;
+    float zv = abs(c_screen.w / (abs(denom) < 1e-7 ? 1e-7 : denom));
+    bool sky = raw >= 0.99999 || zv >= c_cam.w;
+    zv = min(zv, c_cam.w);
+    float3 w = v.x * c_rot0.xyz + v.y * c_rot1.xyz + v.z * c_rot2.xyz;
+    float dist = zv * length(w);
+    float3 dir = normalize(w);
+
+    if (c_vp.z > 1.5 && c_vp.z < 2.5) {
+        // hdFogDebug 2: raw depth buffer value (white = near), pure blue where nothing was drawn
+        return raw >= 0.999999 ? float4(0, 0, 1, 1) : float4(saturate((1.0 - raw) * 200.0).xxx, 1);
+    }
+    float3 vdir = v / length(v); // view-space direction (same length as the world one)
+    if (c_vp.z > 3.5) {
+        // hdFogDebug 4: the sun shadow the fog sees on each surface (black = shadow), must match the world's shadows
+        return sky ? float4(0, 0, 1, 1) : float4(SunVisible(v * zv).xxx, 1);
+    }
+    if (c_vp.z > 0.5 && c_vp.z < 1.5) {
+        // hdFogDebug 1: distance in grey (black = near, white = far clip), sky in red
+        return sky ? float4(1, 0, 0, 1) : float4(saturate(dist / c_cam.w).xxx, 1);
+    }
+
+    // each layer's colour only depends on the direction
+    float cosSun = dot(dir, c_sun.xyz);
+    float3 sun0 = c_layer[1].rgb * Phase(cosSun, c_layer[1].w);
+    float3 sun1 = c_layer[6].rgb * Phase(cosSun, c_layer[6].w);
+    float3 sun2 = c_layer[11].rgb * Phase(cosSun, c_layer[11].w);
+    float3 useShadow = float3(c_layer[2].w, c_layer[7].w, c_layer[12].w);
+
+    // the sky is fogged up to the fog range, like Forever's volume behind the far clip
+    float D = sky ? c_range.x : min(dist, c_range.x);
+    // where in each step the shadow is tested: dithered per pixel (interleaved gradient noise), so 32 steps
+    // give fine grain instead of bands across the light shafts
+    float jitter = frac(52.9829189 * frac(dot(vpos, float2(0.06711056, 0.00583715))));
+    float T = 1.0;
+    float3 L = 0.0;
+    float t0 = 0.0;
+    [loop] for (int s = 1; s <= 32; s++) {
+        float u = s / 32.0;
+        float t1 = D * u * u;
+        float seg = max(t1 - t0, 1e-3);
+        float tm = 0.5 * (t0 + t1);
+        float h = c_cam.z + dir.z * tm;
+        float3 d;
+        float3 start = float3(c_layer[2].x, c_layer[7].x, c_layer[12].x);
+        // part of this step past each layer's start distance
+        float3 cov = saturate((t1 - start) / seg);
+        float3 x = saturate((tm - start) * c_range.y);
