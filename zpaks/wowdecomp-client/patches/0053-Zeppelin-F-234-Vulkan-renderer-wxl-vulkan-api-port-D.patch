+    bool HandWrittenRow(const char* name, bool pixel)
+    {
+        if (!name || !*name) return false;
+        for (const ShaderRow& r : kShaderRows)
+            if (std::strcmp(pixel ? r.ps : r.vs, name) == 0) return true;
+        return false;
+    }
