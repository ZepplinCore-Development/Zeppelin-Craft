+    // Same search as the client's GetBandTimeRange (Lights.cpp), with up to 32 keys.
+    void BandTimeRange(const int32_t* times, int32_t count, int32_t time, int32_t& index, float& t, int32_t& next) {
+        next = 0;
+        t = 0.0f;
+        index = 0;
+        if (count <= 0) return;
+        do {
+            int32_t start = times[index];
+            next = (index + 1) % count;
+            int32_t end = times[next];
+            if (end > start) {
+                if (time >= start && time <= end) {
+                    t = static_cast<float>(time - start) / (end - start);
+                    return;
+                }
+            } else if (time <= end || time >= start) {
+                end += 2880;
+                if (time < start) time += 2880;
+                t = static_cast<float>(time - start) / (end - start);
+                return;
+            }
+            index++;
+        } while (index < count);
+    }
+
+    // A band's colour at this time (0..1), blended between its two time keys like ForeverIntBand. False when empty.
+    bool BandColorAt(const Band& b, int32_t time, float* out) {
+        if (!b.count) return false;
+        int32_t index;
+        float t;
+        int32_t next;
+        BandTimeRange(b.time, b.count, time, index, t, next);
+        float from[3];
+        float to[3];
+        SetColor(from, b.color[index]);
+        SetColor(to, b.color[next]);
+        for (int32_t c = 0; c < 3; c++) out[c] = from[c] + (to[c] - from[c]) * t;
+        return true;
+    }
+
+    // HD: hdForeverForce, a Forever setting to use for every light (0 = none). For zones Forever has no light
+    // for in our data (Eversong, Ghostlands): try a setting by hand and compare with a Forever capture.
+    int32_t ForcedSetting() {
+        return s_force && s_force->m_intValue > 0 ? s_force->m_intValue : 0;
+    }
+
+    // The Forever setting for this light and slot (0 = none). A slot with none falls back to slot 0 when asked.
+    int32_t SettingFor(const LightRec* light, int32_t slot, bool fallbackToSlot0) {
+        int32_t forced = ForcedSetting();
+        if (forced) return forced;
+        auto found = s_lights.find(light->m_id);
+        if (found == s_lights.end() || found->second.map != light->m_continentID) return 0;
+        int32_t foreverId = found->second.slots[slot];
+        if (!foreverId && fallbackToSlot0 && slot != 0) foreverId = found->second.slots[0]; // e.g. no storm setting: clear weather
+        return foreverId;
+    }
+
+    const HdRecord* FindRecord(const LightParamsRec* params) {
+        if (!params || params->m_id < kMarker) return nullptr;
+        uint32_t index = static_cast<uint32_t>(params->m_id - kMarker);
+        return index < s_records.size() ? s_records[index] : nullptr;
+    }
+}
+
+const LightParamsRec* HD::ForeverLightParams(const LightRec* light, int32_t slot, const LightParamsRec* original) {
+    RegisterCVars();
+    if (!s_enabled || !s_enabled->m_intValue || !light || !original || slot < 0 || slot > 7) return original;
+    if (!s_triedLoad) Load();
+
+    int32_t foreverId = SettingFor(light, slot, false);
+    if (!foreverId) return original;
+    auto setting = s_settings.find(foreverId);
+    if (setting == s_settings.end()) return original;
+
+    uint64_t key = (static_cast<uint64_t>(static_cast<uint32_t>(original->m_id)) << 32) | static_cast<uint32_t>(foreverId);
+    HdRecord*& record = s_recordByPair[key];
+    if (!record) {
+        record = new HdRecord();
+        memcpy(&record->rec, original, sizeof(LightParamsRec)); // skybox, glow, water alpha stay 3.3.5
+        record->realId = original->m_id;
+        record->setting = setting->second;
+        record->rec.m_id = kMarker + static_cast<int32_t>(s_records.size());
+        s_records.push_back(record);
+    }
+    return &record->rec;
+}
+
+int32_t HD::RealLightParamsId(const LightParamsRec* params) {
+    const HdRecord* record = FindRecord(params);
+    return record ? record->realId : params->m_id;
+}
+
+bool HD::ForeverIntBand(const LightParamsRec* params, int32_t band, int32_t time, CImVector* color) {
+    const HdRecord* record = FindRecord(params);
+    if (!record || band < 0 || band >= kBands) return false;
+    const Band& b = record->setting->bands[band];
+    if (!b.count) return false;
+
+    int32_t index;
+    float t;
+    int32_t next;
+    BandTimeRange(b.time, b.count, time, index, t, next);
+
+    uint32_t from = b.color[index];
+    uint32_t to = b.color[next];
+    int32_t fr = (from >> 16) & 0xFF, fg = (from >> 8) & 0xFF, fb = from & 0xFF;
+    int32_t tr = (to >> 16) & 0xFF, tg = (to >> 8) & 0xFF, tb = to & 0xFF;
+    int32_t r = CMath::fint_((tr - fr) * t + fr);
+    int32_t g = CMath::fint_((tg - fg) * t + fg);
+    int32_t bl = CMath::fint_((tb - fb) * t + fb);
+    *color = CImVector(static_cast<uint8_t>(bl & 0xFF), static_cast<uint8_t>(g & 0xFF), static_cast<uint8_t>(r & 0xFF), 0xFF);
+    return true;
+}
+
+float HD::ForeverBandWeight(int32_t band) {
+    if (band != 0 && band != 1) return 1.0f;
+    RegisterCVars();
+    float weight = s_light ? s_light->m_floatValue : 0.0f;
+    return weight < 0.0f ? 0.0f : (weight > 1.0f ? 1.0f : weight);
+}
+
+bool HD::ForeverAmbientsAt(const LightRec* light, int32_t slot, int32_t time, float* sky, float* horizon, float* ground) {
+    RegisterCVars();
+    if (!s_enabled || !s_enabled->m_intValue || !light || slot < 0 || slot > 7) return false;
+    if (!s_triedLoad) Load();
+
+    int32_t foreverId = SettingFor(light, slot, true);
+    if (!foreverId) return false;
+    auto setting = s_settings.find(foreverId);
+    if (setting == s_settings.end() || !BandColorAt(setting->second->bands[1], time, sky)) return false;
+    // A colour Forever leaves black (or has no key for) is the sky colour
+    if (!BandColorAt(setting->second->bands[18], time, horizon) || horizon[0] + horizon[1] + horizon[2] <= 0.0f) {
+        for (int32_t c = 0; c < 3; c++) horizon[c] = sky[c];
+    }
+    if (!BandColorAt(setting->second->bands[19], time, ground) || ground[0] + ground[1] + ground[2] <= 0.0f) {
+        for (int32_t c = 0; c < 3; c++) ground[c] = sky[c];
+    }
+    return true;
+}
+
+bool HD::ForeverFogAt(const LightRec* light, int32_t slot, int32_t time, ForeverFog* out) {
+    RegisterCVars();
+    if (!s_triedLoad) Load();
+    if (!light || slot < 0 || slot > 7) return false;
+
+    int32_t foreverId = SettingFor(light, slot, true);
+    if (!foreverId) return false;
+    auto fog = s_fog.find(foreverId);
+    if (fog == s_fog.end() || fog->second.empty()) return false;
+
+    const std::vector<FogKey>& keys = fog->second;
+    int32_t times[kMaxKeys];
+    int32_t count = static_cast<int32_t>(keys.size() < kMaxKeys ? keys.size() : kMaxKeys);
+    for (int32_t i = 0; i < count; i++) times[i] = keys[i].time;
+
+    int32_t index;
+    float t;
+    int32_t next;
+    BandTimeRange(times, count, time, index, t, next);
+    const FogKey& a = keys[index];
+    const FogKey& b = keys[next];
+
+    out->setting = foreverId;
+    out->count = a.count > b.count ? a.count : b.count;
+    for (int32_t i = 0; i < 3; i++) {
+        out->layers[i] = a.layers[i];
+        LerpFogLayer(out->layers[i], b.layers[i], t);
+    }
+    return true;
+}
+
+void HD::LerpFogLayer(ForeverFogLayer& a, const ForeverFogLayer& b, float t) {
+    if (!a.flags && !b.flags) return;
+    if (!b.flags) {
+        // HD: the layer fades out: keep its look, lose its density
+        a.density *= 1.0f - t;
+        return;
+    }
+    if (!a.flags) {
+        float density = b.density * t;
+        a = b;
+        a.density = density;
+        return;
+    }
+    if (t >= 0.5f) a.flags = b.flags;
+    for (int32_t c = 0; c < 3; c++) {
+        a.diffuse[c] += (b.diffuse[c] - a.diffuse[c]) * t;
+        a.emissive[c] += (b.emissive[c] - a.emissive[c]) * t;
+        a.shadow[c] += (b.shadow[c] - a.shadow[c]) * t;
+    }
+    a.start += (b.start - a.start) * t;
+    a.density += (b.density - a.density) * t;
+    a.shadowMul += (b.shadowMul - a.shadowMul) * t;
+    a.topRate += (b.topRate - a.topRate) * t;
+    a.topHeight += (b.topHeight - a.topHeight) * t;
+    a.bottomRate += (b.bottomRate - a.bottomRate) * t;
+    a.bottomHeight += (b.bottomHeight - a.bottomHeight) * t;
+    a.intensity += (b.intensity - a.intensity) * t;
+    a.g += (b.g - a.g) * t;
+    a.strength += (b.strength - a.strength) * t;
+    a.exponent += (b.exponent - a.exponent) * t;
+}
+
+bool HD::ForeverGradingAt(const LightRec* light, int32_t slot, int32_t time, int32_t* lutA, int32_t* lutB, float* t) {
+    RegisterCVars();
+    if (!s_triedLoad) Load();
+    if (!light || slot < 0 || slot > 7) return false;
+
+    int32_t foreverId = SettingFor(light, slot, true);
+    if (!foreverId) return false;
+    auto grading = s_grading.find(foreverId);
+    if (grading == s_grading.end() || grading->second.empty()) return false;
+
+    const std::vector<GradeKey>& keys = grading->second;
+    int32_t times[kMaxKeys];
+    int32_t count = static_cast<int32_t>(keys.size() < kMaxKeys ? keys.size() : kMaxKeys);
+    for (int32_t i = 0; i < count; i++) times[i] = keys[i].time;
+
+    int32_t index;
+    int32_t next;
+    BandTimeRange(times, count, time, index, *t, next);
+    *lutA = keys[index].lut;
+    *lutB = keys[next].lut;
+    return true;
+}
diff --git a/WoW/Source/WorldClient/HD/HdForever.h b/WoW/Source/WorldClient/HD/HdForever.h
new file mode 100644
index 00000000..fd62fcde
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdForever.h
@@ -0,0 +1,91 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDFOREVER_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDFOREVER_H
+
+// Waystone HD: WoW Forever light colours (not part of the original client).
+//   hdForever      0 = original 3.3.5 lights (default)
+//                  1 = lights that also exist in WoW Forever use Forever's colours
+//                      (sun, ambient, sky, fog colour, sun and cloud colours).
+//                      Fog distance, shadows, clouds layers and water keep the 3.3.5 values.
+//                      Lights Forever does not have (TBC, WotLK, Turtle) are not touched.
+//   hdForeverForce 0 = Forever setting by light (default); a setting id = use it for every light, also for
+//                  hdFog and hdGrade (to match zones Forever has no light for in our data, e.g. Ghostlands)
+//   hdForeverLight 1 = the world (ground, models, buildings) gets Forever's sun and ambient colours (default),
+//                  0 = the 3.3.5 ones, in between = a mix. Sky, fog, clouds use Forever whenever hdForever is 1.
+//                  Forever lights the world with 3 ambient colours (sky, horizon, ground; hdTerrainLight does it on the
+//                  ground) and cuts the sun in shadow. The turquoise ground of the first Amani Pass test (2026-10-19)
+//                  came from forcing setting 7624, which has the same sky and fog as 7618 but a yellow-green sun and
+//                  teal ambient like the underwater settings (light slot 1); 7618 looks like the clear-weather one.
+//   hdForeverInfo  read only, what was loaded:  /run print(GetCVar("hdForeverInfo"))
+// Data file: forever_data\hd_forever_light.txt (made by forever_tools\make_hd_forever_light.py).
+// Ambient:   forever_data\hd_forever_ambient.txt (made by forever_tools\make_hd_forever_ambient.py), horizon and
+//            ground ambient colours for the terrain lighting (hdTerrainLight).
+// Clouds:    forever_data\hd_forever_sky.txt (made by forever_tools\make_hd_forever_sky.py), band 12 (cloud base colour)
+//            from Forever's CloudEmissiveColor, loaded like hd_forever_light.txt (optional; used by the clouds, see HdSky.h).
+// Fog file:  forever_data\hd_forever_fog.txt (made by forever_tools\make_hd_forever_fog.py), used by hdFog.
+
+#include <cstdint>
+
+class CImVector;
+class LightParamsRec;
+class LightRec;
+
+namespace HD {
+    // Called by DayNight::GetLightParams. Returns the record to use for this light and slot:
+    // `original` when hdForever is off or Forever has nothing for it, else an HD record.
+    const LightParamsRec* ForeverLightParams(const LightRec* light, int32_t slot, const LightParamsRec* original);
+
+    // The 3.3.5 LightParams ID behind a record (the HD records keep the 3.3.5 one for bands Forever leaves empty).
+    int32_t RealLightParamsId(const LightParamsRec* params);
+
+    // True (and *color set) when this band comes from Forever for this record.
+    bool ForeverIntBand(const LightParamsRec* params, int32_t band, int32_t time, CImVector* color);
+
+    // How much of Forever's colour to use for this band (0 = 3.3.5 colour, 1 = Forever's): hdForeverLight for
+    // the world light bands (0 sun, 1 ambient), 1 for the others.
+    float ForeverBandWeight(int32_t band);
+
+    // Forever's three ambient colours (0..1) for this light and slot at this time (0-2880 half-minutes), as its terrain
+    // shader gets them: sky = LightData AmbientColor, horizon = HorizonAmbientColor, ground = GroundAmbientColor,
+    // blended between Forever's time keys. A horizon or ground colour Forever leaves black is the sky colour.
+    // False when hdForever is 0 or Forever has no setting for this light (sky/horizon/ground untouched).
+    bool ForeverAmbientsAt(const LightRec* light, int32_t slot, int32_t time, float* sky, float* horizon, float* ground);
+
+    // One Forever fog layer (LightDataGlobalVolumeFog), as Forever's global fog shader reads it (GlobalFogParams).
+    // Only the layers the Forever client draws (flag 8) are in the file. Colours 0..1, values unscaled.
+    struct ForeverFogLayer {
+        int32_t flags;            // 1 = sun shadow (shadow colour/density when the sun is down), 2 = heights relative
+                                  // to the player, 4 = noise, 8 = drawn; 0 = no layer here
+        float diffuse[3];         // sun-lit colour, added toward the sun (column 1)
+        float emissive[3];        // base colour (column 2)
+        float shadow[3];          // base colour in shadow (column 3)
+        float start;              // distance where the layer starts, yards (column 5)
+        float density;            // x 0.01 = per yard (column 6)
+        float shadowMul;          // density in shadow (column 7)
+        float topRate, topHeight; // thins above topHeight: exp(-topRate * 0.01 * (z - topHeight)) (columns 8, 10)
+        float bottomRate, bottomHeight; // thins below bottomHeight (columns 11, 12)
+        float intensity;          // sun scatter strength (column 14)
+        float g;                  // phase: 0 = even, 0.9 = strongly toward the sun (column 15)
+        float strength, exponent; // denser with distance: 1 + strength * (distance share)^exponent (columns 25, 26)
+    };
+
+    // Blend two fog layers (t = 0 keeps a, 1 gives b). A missing layer (flags 0) takes the other's colours,
+    // so it only fades in by density.
+    void LerpFogLayer(ForeverFogLayer& a, const ForeverFogLayer& b, float t);
+
+    struct ForeverFog {
+        int32_t count;
+        int32_t setting;
+        ForeverFogLayer layers[3];
+    };
+
+    // Forever's fog for this light and slot at this time (0-2880 half-minutes), interpolated between
+    // Forever's time keys. False when Forever has no fog for this light (TBC, WotLK, Turtle lights).
+    bool ForeverFogAt(const LightRec* light, int32_t slot, int32_t time, ForeverFog* out);
+
+    // Forever's colour grading for this light and slot at this time (0-2880 half-minutes): the LUTs of the two
+    // time keys around it (forever_data\grading\<lut>.blp) and how far between them (0 = lutA, 1 = lutB).
+    // False when Forever has no grading for this light. Data: forever_data\hd_forever_grading.txt.
+    bool ForeverGradingAt(const LightRec* light, int32_t slot, int32_t time, int32_t* lutA, int32_t* lutB, float* t);
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdGI.cpp b/WoW/Source/WorldClient/HD/HdGI.cpp
new file mode 100644
index 00000000..d4bb1fce
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdGI.cpp
@@ -0,0 +1,467 @@
+// HD: Waystone HD screen-space GI, one colour bounce (see HdGI.h). Written for this client on the frame of hdAO; the
+// order of the raw D3D9 work and the state reset afterwards are the ones hdWater's depth pass uses in the same place
+// of the frame (HdWater.cpp LineariseDepth), which is known to work in game: no Get* of render states and no state
+// block, because the client makes a PURE device (CGxDeviceD3d::ICreateD3dDevice), where Direct3D does not promise
+// either.
+#include "WoW/Source/WorldClient/HD/HdGI.h"
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <windows.h>
+#include <d3d9.h>
+#include <d3dcompiler.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDeviceD3d/CGxDeviceD3d.h"
+#include "Engine/Source/Gx/Types.h"
+#include "WoW/Source/WorldClient/DayNight__DNInfo.h" // HD: the ambient light now (follows hdTime)
+#include "WoW/Source/WorldClient/HD/HdFog.h"
+
+namespace {
+    // HD: checked with d3dcompiler_47 (ps_3_0, optimisation level 3, as below): Generate 238 instruction slots,
+    // Blur 143, Apply 44 (ps_3_0 guarantees 512).
+    const char kShader[] = R"HLSL(// Waystone HD screen-space GI (ps_3_0, D3D9). Three entry points over the whole world target:
+//   Generate: the light bounced once onto this pixel by what is around it on screen (8 samples in 3D, in the half
+//             sphere over the normal rebuilt from the depth), linear colour
+//   Blur:     5-tap blur that stops at depth edges (run twice: across, then down)
+//   Apply:    the world's colour with the bounce added, in linear: colour + albedo * bounce * strength
+// HD: the bounce is what the surfaces around send beyond the client's ambient light: the ambient term of the image
+// already stands for an average light coming from all around (sky and ground), so only the part of a neighbour's
+// light above that ambient is added (counted once). At night the ambient and the surfaces are both dark: nothing is
+// added, except next to surfaces that are lit more than the ambient (torch-lit walls, lit windows, the sunlit side at
+// dawn). Nothing is taken away either (the part below the ambient would darken corners, an ambient occlusion).
+// The world depth is hdFog's INTZ copy of the client's depth buffer (HD::FogGetWorldDepth); the colours are a copy of
+// the world target as drawn so far (HD::FogCopyWorldColor).
+sampler2D DepthTex : register(s0); // INTZ world depth, point, clamp
+sampler2D GITex    : register(s1); // the bounce (rgb), point, clamp
+sampler2D SceneTex : register(s2); // the world drawn so far (gamma), point, clamp
+float4 cScreen : register(c0); // 1/width, 1/height of the target, depth scale A, depth offset B (z01 = raw * A + B)
+float4 cView   : register(c1); // view xy = (local uv * xy + zw) * view z  (from projection a0, b1, c0, c1)
+float4 cRect   : register(c2); // world viewport in target uv: offset xy, 1 / size zw
+float4 cDepth  : register(c3); // projection c2, -d2, sky threshold, unused
+float4 cParams : register(c4); // radius (yards), strength, debug (1 = test view), blur sharpness (1/yards)
+float4 cBlur   : register(c5); // blur step in uv (xy), fade start (yards), 1 / fade length
+float4 cLight  : register(c6); // HD: rgb = the client's ambient light now (DayNight, linear), a = brightest albedo
+
+// View-space position of the surface seen at uv (camera at 0, +z forward), w = 1; w = 0 for the sky and for
+// pixels outside the world viewport.
+float4 ViewPos(float2 uv)
+{
+    float2 local = (uv - cRect.xy) * cRect.zw;
+    float raw = tex2Dlod(DepthTex, float4(uv, 0, 0)).r;
+    float z01 = raw * cScreen.z + cScreen.w;           // back to the projection's 0..1 (world uses 0..0.94)
+    float z = cDepth.y / max(cDepth.x - z01, 1e-7);    // zv = d2 / (z01 - c2)
+    bool inside = all(local == saturate(local));
+    float w = (inside && z01 < cDepth.z) ? 1.0 : 0.0;
+    return float4((local * cView.xy + cView.zw) * z, z, w);
+}
+
+// Where a view-space point (in front of the eye) is in the target (uv): ViewPos backwards
+float2 TargetUv(float3 q)
+{
+    return ((q.xy / q.z - cView.zw) / cView.xy) / cRect.zw + cRect.xy;
+}
+
+// Interleaved gradient noise (Jimenez 2014): per-pixel rotation, removed by the blur.
+float Noise(float2 vpos)
+{
+    return frac(52.9829189 * frac(dot(vpos, float2(0.06711056, 0.00583715))));
+}
+
+float4 Generate(float2 vpos : VPOS) : COLOR0
+{
+    float2 uv = (vpos + 0.5) * cScreen.xy;
+    float4 c = ViewPos(uv);
+    if (c.w < 0.5) return float4(0, 0, 0, 1);
+    float3 p = c.xyz;
+
+    // normal from the neighbours on the side closest in depth (does not bend across silhouettes)
+    float4 l = ViewPos(uv - float2(cScreen.x, 0));
+    float4 r = ViewPos(uv + float2(cScreen.x, 0));
+    float4 u = ViewPos(uv - float2(0, cScreen.y));
+    float4 d = ViewPos(uv + float2(0, cScreen.y));
+    float3 dx = (abs(p.z - l.z) * l.w + (1.0 - l.w) * 1e9 < abs(r.z - p.z) * r.w + (1.0 - r.w) * 1e9) ? p - l.xyz : r.xyz - p;
+    float3 dy = (abs(p.z - u.z) * u.w + (1.0 - u.w) * 1e9 < abs(d.z - p.z) * d.w + (1.0 - d.w) * 1e9) ? p - u.xyz : d.xyz - p;
+    float3 n = cross(dx, dy);
+    n = dot(n, n) > 1e-12 ? normalize(n) : -normalize(p);
+    n = dot(n, p) > 0.0 ? -n : n;                        // facing the camera
+    // a frame around the normal: the samples are spread over the surface, then lifted off it
+    float3 t = normalize(cross(n, abs(n.y) < 0.9 ? float3(0, 1, 0) : float3(1, 0, 0)));
+    float3 b = cross(n, t);
+
+    float noise = Noise(vpos);
+    float sa, ca;
+    sincos(noise * 0.78539816, sa, ca);                  // the first direction turned by 0..45 degrees per pixel
+    float scale = noise;
+    float3 sum = 0.0;
+    float cover = 0.0;                                   // HD: how much of the view around is taken by those surfaces
+    [loop] for (int i = 0; i < 8; ++i) {
+        scale = frac(scale + 0.618034);                  // 0.25..1 of the radius, below
+        float3 s = p + ((t * ca + b * sa) * 0.8 + n * 0.6) * (cParams.x * (scale * 0.75 + 0.25));
+        float2 uvS = TargetUv(float3(s.xy, max(s.z, 0.2)));
+        float4 q = ViewPos(uvS);
+        float3 v = q.xyz - p;
+        float dist2 = max(dot(v, v), 1e-4);
+        float facing = saturate(dot(n, v) * rsqrt(dist2));       // light arriving from the sample's direction
+        float falloff = saturate(1.0 - dist2 / (cParams.x * cParams.x));
+        float3 col = tex2Dlod(SceneTex, float4(uvS, 0, 0)).rgb;  // the surface seen there
+        float wgt = facing * falloff * q.w;
+        sum += col * col * wgt;                                  // gamma 2 to linear (cheap)
+        cover += wgt;
+        float c2 = ca * 0.70710678 - sa * 0.70710678;            // next direction, 45 degrees on
+        sa = ca * 0.70710678 + sa * 0.70710678;
+        ca = c2;
+    }
+    // 8 samples, cosine weighted: x 2 / 8. HD: minus the ambient the image already has from those directions
+    float3 gi = max(sum - cLight.rgb * cover, 0.0) * 0.25;
+    // fade out with distance (the depth gets coarse far away, and far scenery is already fogged)
+    gi *= 1.0 - saturate((p.z - cBlur.z) * cBlur.w);
+    return float4(sqrt(saturate(gi)), 1.0);                      // stored with gamma 2 (8-bit target)
+}
+
+float4 Blur(float2 vpos : VPOS) : COLOR0
+{
+    float2 uv = (vpos + 0.5) * cScreen.xy;
+    float4 c = ViewPos(uv);
+    if (c.w < 0.5) return float4(0, 0, 0, 1);
+    float sharp = cParams.w / (1.0 + 0.02 * c.z);       // depth tolerance grows with distance
+    float3 total = 0.0;
+    float weights = 0.0;
+    [unroll] for (int i = -2; i <= 2; ++i) {
+        float2 tuv = uv + cBlur.xy * i;
+        float4 q = ViewPos(tuv);
+        const float spatial = (i == 0) ? 6.0 : ((i == -1 || i == 1) ? 4.0 : 1.0);
+        float weight = spatial * exp2(-abs(q.z - c.z) * sharp) * q.w;
+        total += tex2Dlod(GITex, float4(tuv, 0, 0)).rgb * weight;
+        weights += weight;
+    }
+    return float4(total / max(weights, 1e-6), 1.0);
+}
+
+// HD: the receiving surface's own colour (albedo) is not kept by this renderer (it draws lit colours straight
+// away). Estimate: its colour divided by the ambient light (exact for a surface lit by the ambient alone, the shaded
+// side, where a bounce shows most), held at cLight.a of brightness at most (keeping its hue), which also covers the
+// sunlit and torch-lit surfaces, whose colour is more than the ambient. Never a division by a light close to 0.
+float4 Apply(float2 vpos : VPOS) : COLOR0
+{
+    float2 uv = (vpos + 0.5) * cScreen.xy;
+    float3 g = tex2Dlod(GITex, float4(uv, 0, 0)).rgb;
+    float3 gi = g * g;                                           // back to linear
+    float3 c = tex2Dlod(SceneTex, float4(uv, 0, 0)).rgb;
+    float3 lin = c * c;
+    float lum = dot(lin, float3(0.2126, 0.7152, 0.0722));
+    float3 albedo = lin / max(max(cLight.rgb, lum / cLight.a), 1e-4);
+    float3 o = sqrt(lin + albedo * gi * cParams.y);             // the target is 8-bit gamma (no sRGB write)
+    // test views: 1 = the bounce alone (x 4), 2 = the albedo estimate
+    if (cParams.z > 0.5) o = sqrt(saturate(gi * 4.0));
+    if (cParams.z > 1.5) o = sqrt(albedo);
+    return float4(o, 1.0);
+}
+)HLSL";
+
+    enum { PS_Generate, PS_Blur, PS_Apply, PS_Count };
+    const char* const kEntry[PS_Count] = { "Generate", "Blur", "Apply" };
+    const UINT kConstRegs = 7; // c0..c6 (HD::FogInvalidateClientState re-sends c0..c33)
+    const float kSkyDepth = 0.99999f;
+    const float kFadeStart = 150.0f; // yards: the bounce fades out from here...
+    const float kFadeLength = 100.0f; // ...over this distance
+    const float kMaxAlbedo = 0.5f; // HD: brightest albedo assumed for a receiving surface (linear; 0.71 in gamma)
+
+    typedef HRESULT(WINAPI* D3DCompileFn)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*, LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+
+    struct Target {
+        IDirect3DTexture9* tex = nullptr;
+        IDirect3DSurface9* surf = nullptr;
+    };
+
+    CVar* s_enabled = nullptr;
+    CVar* s_radius = nullptr;
+    CVar* s_strength = nullptr;
+    CVar* s_debug = nullptr;
+    CVar* s_info = nullptr;
+    char s_lastInfo[160] = "";
+
+    std::vector<DWORD> s_code[PS_Count]; // compiled once; the shader objects are remade after a device reset
+    bool s_compileFailed = false;
+    IDirect3DPixelShader9* s_ps[PS_Count] = {};
+    Target s_gi[2];
+    UINT s_width = 0;
+    UINT s_height = 0;
+
+    void RegisterCVars() {
+        static bool registered = false;
+        if (registered) return;
+        registered = true;
+        s_enabled = CVar::Register("hdGI", "HD: 1 = screen-space global illumination (one colour bounce), 0 = off", 1, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_radius = CVar::Register("hdGIRadius", "HD: bounce reach in yards, 4 = normal", 1, "4", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_strength = CVar::Register("hdGIStrength", "HD: bounce strength, 1 = normal", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_debug = CVar::Register("hdGIDebug", "HD: 1 = test view, the bounced light alone, 2 = test view, the surface colour estimate", 0, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_info = CVar::Register("hdGIInfo", "HD: hdGI status (read only)", 0, "off", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    }
+
+    void SetInfo(const char* text) {
+        if (!s_info || !strcmp(s_lastInfo, text)) return;
+        snprintf(s_lastInfo, sizeof(s_lastInfo), "%s", text);
+        s_info->Set(text, true, false, false, false);
+    }
+
+    float CVarValue(CVar* cvar, float fallback, float lo, float hi) {
+        float v = cvar ? cvar->m_floatValue : fallback;
+        if (!(v == v)) return fallback; // NaN
+        return v < lo ? lo : (v > hi ? hi : v);
+    }
+
+    IDirect3DDevice9* Device() {
+        if (!g_theGxDevicePtr || g_theGxDevicePtr->DeviceApi() != GxApi_D3d9) return nullptr;
+        return static_cast<CGxDeviceD3d*>(g_theGxDevicePtr)->m_d3dDevice;
+    }
+
+    void ReleaseTargets() {
+        for (Target& t : s_gi) {
+            if (t.surf) { t.surf->Release(); t.surf = nullptr; }
+            if (t.tex) { t.tex->Release(); t.tex = nullptr; }
+        }
+        s_width = 0;
+        s_height = 0;
+    }
+
+    void ReleaseShaders() {
+        for (IDirect3DPixelShader9*& ps : s_ps) {
+            if (ps) { ps->Release(); ps = nullptr; }
+        }
+    }
+
+    bool EnsureTargets(IDirect3DDevice9* device, UINT width, UINT height) {
+        if (s_gi[0].surf && s_gi[1].surf && s_width == width && s_height == height) return true;
+        ReleaseTargets();
+        for (Target& t : s_gi) {
+            if (FAILED(device->CreateTexture(width, height, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &t.tex, nullptr)) || !t.tex) {
+                t.tex = nullptr;
+                ReleaseTargets();
+                return false;
+            }
+            if (FAILED(t.tex->GetSurfaceLevel(0, &t.surf)) || !t.surf) {
+                t.surf = nullptr;
+                ReleaseTargets();
+                return false;
+            }
+        }
+        s_width = width;
+        s_height = height;
+        return true;
+    }
+
+    bool EnsureShaders(IDirect3DDevice9* device) {
+        if (s_ps[PS_Generate] && s_ps[PS_Blur] && s_ps[PS_Apply]) return true;
+        if (s_compileFailed) return false;
+        if (s_code[0].empty()) {
+            s_compileFailed = true;
+            HMODULE module = LoadLibraryA("d3dcompiler_47.dll");
+            D3DCompileFn compile = module ? reinterpret_cast<D3DCompileFn>(GetProcAddress(module, "D3DCompile")) : nullptr;
+            if (!compile) {
+                SetInfo("ERROR: d3dcompiler_47.dll not found");
+                return false;
+            }
+            for (int i = 0; i < PS_Count; i++) {
+                ID3DBlob* code = nullptr;
+                ID3DBlob* errors = nullptr;
+                HRESULT hr = compile(kShader, strlen(kShader), "HdGI", nullptr, nullptr, kEntry[i], "ps_3_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+                if (FAILED(hr) || !code) {
+                    char text[160];
+                    snprintf(text, sizeof(text), "ERROR: shader %s: %s", kEntry[i], errors ? static_cast<const char*>(errors->GetBufferPointer()) : "unknown");
+                    SetInfo(text);
+                    if (errors) errors->Release();
+                    if (code) code->Release();
+                    for (std::vector<DWORD>& c : s_code) c.clear();
+                    return false;
+                }
+                if (errors) errors->Release();
+                const DWORD* p = static_cast<const DWORD*>(code->GetBufferPointer());
+                s_code[i].assign(p, p + code->GetBufferSize() / sizeof(DWORD));
+                code->Release();
+            }
+            s_compileFailed = false;
+        }
+        for (int i = 0; i < PS_Count; i++) {
+            if (!s_ps[i] && FAILED(device->CreatePixelShader(s_code[i].data(), &s_ps[i]))) {
+                s_ps[i] = nullptr;
+                ReleaseShaders();
+                s_compileFailed = true;
+                SetInfo("ERROR: CreatePixelShader failed");
+                return false;
+            }
+        }
+        return true;
+    }
+
+    // The world viewport in pixels, as CGxDeviceD3d::IXformSetViewport sets it from the client's viewport.
+    void WorldViewport(float* x, float* y, float* w, float* h) {
+        CGxDevice* gx = g_theGxDevicePtr;
+        const CRect& window = gx->DeviceCurWindow();
+        const CBoundingBox& vp = gx->m_viewport;
+        DWORD vx = static_cast<DWORD>(vp.m_x.m_l * window.maxX + 0.5f);
+        DWORD vy = static_cast<DWORD>((1.0f - vp.m_y.m_h) * window.maxY + 0.5f);
+        DWORD vw = static_cast<DWORD>(vp.m_x.m_h * window.maxX - vx + 0.5f);
+        DWORD vh = static_cast<DWORD>((1.0f - vp.m_y.m_l) * window.maxY - vy + 0.5f);
+        if (gx->m_textureTarget[0].m_apiSpecific || gx->m_textureTarget[1].m_apiSpecific) {
+            vy = static_cast<DWORD>(window.maxY * vp.m_y.m_l);
+        }
+        *x = static_cast<float>(vx);
+        *y = static_cast<float>(vy);
+        *w = static_cast<float>(vw);
+        *h = static_cast<float>(vh);
+    }
+
+    // One full-target pass. SetRenderTarget also sets the viewport to the whole target.
+    void Pass(IDirect3DDevice9* device, IDirect3DSurface9* target, int shader, IDirect3DTexture9* gi, UINT width, UINT height) {
+        device->SetRenderTarget(0, target);
+        device->SetPixelShader(s_ps[shader]);
+        device->SetTexture(1, gi);
+        float w = static_cast<float>(width) - 0.5f;
+        float h = static_cast<float>(height) - 0.5f;
+        float quad[16] = {
+            -0.5f, -0.5f, 0.0f, 1.0f,
+            w, -0.5f, 0.0f, 1.0f,
+            -0.5f, h, 0.0f, 1.0f,
+            w, h, 0.0f, 1.0f,
+        };
+        device->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP, 2, quad, 4 * sizeof(float));
+        device->SetTexture(1, nullptr);
+    }
+}
+
+bool HD::GIWantsDepth() {
+    RegisterCVars();
+    return s_enabled && s_enabled->m_intValue != 0;
+}
+
+void HD::GIRenderOpaque() {
+    RegisterCVars();
+    if (!s_enabled || !s_enabled->m_intValue) {
+        // HD: off: no Direct3D call at all (only our own textures are let go, once)
+        if (s_gi[0].tex || s_gi[1].tex) ReleaseTargets();
+        SetInfo("off");
+        return;
+    }
+    IDirect3DDevice9* device = Device();
+    if (!device) { SetInfo("ERROR: needs gxApi d3d9"); return; }
+    HD::FogWorldDepth depth;
+    if (!HD::FogGetWorldDepth(&depth)) {
+        SetInfo("no world depth (multisampling must be 1x, INTZ needed): GI skipped");
+        return;
+    }
+    const C44Matrix& proj = g_theGxDevicePtr->m_projNative;
+    // a perspective projection (zv = d2 / (z - c2), w = view z); anything else (orthographic views) is skipped
+    if (proj.a0 == 0.0f || proj.b1 == 0.0f || proj.c3 != 1.0f || proj.d3 != 0.0f || !(proj.c2 > 0.0f) || !(proj.d2 < 0.0f) ||
+        !(depth.vpMax > depth.vpMin)) {
+        SetInfo("on, projection not supported this frame: GI skipped");
+        return;
+    }
+    if (!EnsureShaders(device)) return;
+
+    IDirect3DSurface9* color = nullptr;
+    if (FAILED(device->GetRenderTarget(0, &color)) || !color) return;
+    D3DSURFACE_DESC desc;
+    color->GetDesc(&desc);
+    if (desc.Width != depth.width || desc.Height != depth.height || desc.MultiSampleType != D3DMULTISAMPLE_NONE) {
+        color->Release();
+        SetInfo("on, world target and depth differ in size: GI skipped");
+        return;
+    }
+    if (!EnsureTargets(device, desc.Width, desc.Height)) {
+        color->Release();
+        SetInfo("ERROR: GI render target not supported");
+        return;
+    }
+    // the colours that bounce: the world as drawn so far (hdFog's scene texture, which hdWater fills again later)
+    IDirect3DTexture9* scene = HD::FogCopyWorldColor(color, desc.Width, desc.Height);
+    if (!scene) {
+        color->Release();
+        SetInfo("ERROR: GI scene copy failed: GI skipped");
+        return;
+    }
+    IDirect3DSurface9* worldDepth = nullptr;
+    device->GetDepthStencilSurface(&worldDepth);
+
+    float vx, vy, vw, vh;
+    WorldViewport(&vx, &vy, &vw, &vh);
+    if (vw < 1.0f || vh < 1.0f) { vx = 0.0f; vy = 0.0f; vw = static_cast<float>(desc.Width); vh = static_cast<float>(desc.Height); }
+    const float radius = CVarValue(s_radius, 4.0f, 0.5f, 12.0f);
+    const float strength = CVarValue(s_strength, 1.0f, 0.0f, 4.0f);
+    const int32_t debug = s_debug ? (s_debug->m_intValue < 0 ? 0 : (s_debug->m_intValue > 2 ? 2 : s_debug->m_intValue)) : 0;
+    // HD: the client's ambient light this frame (CWorldScene's map light, m_light1: DayNight at the hdTime hour, after
+    // the zone lights and the sun glare), made linear like the shader's colours (gamma 2)
+    const CImVector& amb = DayNight::g_dnInfo.m_light1.m_ambient;
+    const float ambR = amb.r * (1.0f / 255.0f), ambG = amb.g * (1.0f / 255.0f), ambB = amb.b * (1.0f / 255.0f);
+    const float depthScale = 1.0f / (depth.vpMax - depth.vpMin);
+    float c[kConstRegs * 4] = {
+        1.0f / desc.Width, 1.0f / desc.Height, depthScale, -depth.vpMin * depthScale,
+        2.0f / proj.a0, -2.0f / proj.b1, (-1.0f - proj.c0) / proj.a0, (1.0f - proj.c1) / proj.b1,
+        vx / desc.Width, vy / desc.Height, desc.Width / vw, desc.Height / vh,
+        proj.c2, -proj.d2, kSkyDepth, 0.0f,
+        radius, strength, static_cast<float>(debug), 1.0f / (radius * 0.2f),
+        0.0f, 0.0f, kFadeStart, 1.0f / kFadeLength,
+        ambR * ambR, ambG * ambG, ambB * ambB, kMaxAlbedo,
+    };
+
+    // HD: the same states hdWater's depth pass sets here (all re-sent by the client afterwards), plus the blend
+    device->SetDepthStencilSurface(nullptr); // the depth texture cannot be read while it is the depth buffer
+    device->SetRenderState(D3DRS_ZENABLE, FALSE);
+    device->SetRenderState(D3DRS_ZWRITEENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHATESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+    device->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
+    device->SetRenderState(D3DRS_FOGENABLE, FALSE);
+    device->SetRenderState(D3DRS_SCISSORTESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_CLIPPLANEENABLE, 0);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, 0x0F);
+    device->SetVertexShader(nullptr);
+    device->SetFVF(D3DFVF_XYZRHW);
+    device->SetTexture(0, depth.texture);
+    device->SetTexture(2, scene);
+    for (DWORD i = 0; i < 3; i++) {
+        device->SetSamplerState(i, D3DSAMP_MINFILTER, D3DTEXF_POINT);
+        device->SetSamplerState(i, D3DSAMP_MAGFILTER, D3DTEXF_POINT);
+        device->SetSamplerState(i, D3DSAMP_MIPFILTER, D3DTEXF_NONE);
+        device->SetSamplerState(i, D3DSAMP_ADDRESSU, D3DTADDRESS_CLAMP);
+        device->SetSamplerState(i, D3DSAMP_ADDRESSV, D3DTADDRESS_CLAMP);
+    }
+    device->SetPixelShaderConstantF(0, c, kConstRegs);
+    Pass(device, s_gi[0].surf, PS_Generate, nullptr, desc.Width, desc.Height);
+    c[20] = 1.0f / desc.Width; c[21] = 0.0f;
+    device->SetPixelShaderConstantF(5, &c[20], 1);
+    Pass(device, s_gi[1].surf, PS_Blur, s_gi[0].tex, desc.Width, desc.Height);
+    c[20] = 0.0f; c[21] = 1.0f / desc.Height;
+    device->SetPixelShaderConstantF(5, &c[20], 1);
+    Pass(device, s_gi[0].surf, PS_Blur, s_gi[1].tex, desc.Width, desc.Height);
+
+    // HD: the world's colour written again with the bounce in it (Apply reads the copy, s2; no blending: was
+    // dst + dst * bounce, which scaled the bounce by the light the surface already had, so shaded surfaces got
+    // almost none); the alpha (glow mask) is kept
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, D3DCOLORWRITEENABLE_RED | D3DCOLORWRITEENABLE_GREEN | D3DCOLORWRITEENABLE_BLUE);
+    Pass(device, color, PS_Apply, s_gi[0].tex, desc.Width, desc.Height);
+    device->SetTexture(0, nullptr);
+    device->SetTexture(2, nullptr);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, 0x0F);
+
+    // the world's targets back (SetRenderTarget reset the viewport and the scissor rectangle)
+    device->SetRenderTarget(0, color);
+    device->SetDepthStencilSurface(worldDepth);
+    color->Release();
+    if (worldDepth) worldDepth->Release();
+    // HD: the client turns the depth test on once at start-up and never again (see HdFog.cpp)
+    device->SetRenderState(D3DRS_ZENABLE, D3DZB_TRUE);
+    CGxDeviceD3d* gx = static_cast<CGxDeviceD3d*>(g_theGxDevicePtr);
+    gx->m_viewportDirty = 1;
+    gx->m_scissorRectDirty = 1;
+    HD::FogInvalidateClientState();
+    SetInfo(debug == 2 ? "on, test view (hdGIDebug 2)" : (debug ? "on, test view (hdGIDebug 1)" : "on"));
+}
+
+void HD::GIReleaseDeviceResources() {
+    ReleaseTargets();
+    ReleaseShaders();
+}
diff --git a/WoW/Source/WorldClient/HD/HdGI.h b/WoW/Source/WorldClient/HD/HdGI.h
new file mode 100644
index 00000000..0622793f
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdGI.h
@@ -0,0 +1,32 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDGI_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDGI_H
+
+// Waystone HD: screen-space global illumination, one colour bounce (not part of the original client). D3D9 only,
+// off by default. The light that the opaque world already shows on screen is bounced once onto its neighbours: a red
+// wall tints the ground next to it, a lit sandy floor warms the underside of a bridge. 8 samples per pixel taken in
+// 3D around the surface (in the half sphere over its normal, so the reach does not shrink when the ground is seen at
+// a grazing angle), normals rebuilt from the depth, 2 blur passes that stop at depth edges, then added to the opaque
+// world (terrain, buildings, models of the first pass, grass) before the water and the transparent models.
+// Only what is on screen can bounce (the limit of every screen-space method); it fades out from 150 to 250 yards.
+// HD: it follows the hour (hdTime, DayNight): what bounces is the light of the surfaces around beyond the client's
+// ambient light of the moment (the ambient is already in the image), added in linear times an estimate of the
+// receiving surface's own colour. At night only what is lit more than the ambient bounces (torch- and lamp-lit
+// surfaces, hdLights' light on the ground); the flames themselves are drawn after this pass and do not bounce.
+// Reads the world depth that HdFog captures (INTZ, multisampling 1x), as hdWater and hdRays do.
+//   hdGI          0 = off (default), 1 = on
+//   hdGIRadius    reach in yards, 4 = normal (0.5 to 12)
+//   hdGIStrength  1 = normal (0 to 4)
+//   hdGIDebug     1 = test view: the bounced light alone (x4), 2 = test view: the surface colour estimate
+//   hdGIInfo      read only, status:  /run print(GetCVar("hdGIInfo"))
+
+namespace HD {
+    // True when hdGI needs the world depth this frame (HdFog::FogBeginWorld).
+    bool GIWantsDepth();
+    // Called by CGWorldFrame::OnWorldRender after CWorldScene::RenderDetailDoodads (the opaque world is drawn).
+    // Does nothing at all when hdGI is 0.
+    void GIRenderOpaque();
+    // Called by the D3D9 device before it releases its resources (through HD::FogReleaseDeviceResources).
+    void GIReleaseDeviceResources();
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdGrade.cpp b/WoW/Source/WorldClient/HD/HdGrade.cpp
new file mode 100644
index 00000000..9c429852
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdGrade.cpp
@@ -0,0 +1,434 @@
+#include "WoW/Source/WorldClient/HD/HdGrade.h"
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <unordered_map>
+#include <vector>
+#include <windows.h>
+#include <d3d9.h>
+#include <d3dcompiler.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDeviceD3d/CGxDeviceD3d.h"
+#include "Engine/Source/Gx/Types.h"
+#include "WoW/Source/WorldClient/DayNight__DNInfo.h"
+#include "WoW/Source/WorldClient/HD/HdForever.h"
+#include "WoW/Source/DB/Rec/LightRec.h"
+
+namespace {
+    // Pixel shader registers c0..c1 (see kShader).
+    const UINT kConstRegs = 2;
+    const int32_t kLutWidth = 1024;
+    const int32_t kLutHeight = 32;
+
+    // HD: a 32x32x32 LUT laid out as 32 slices side by side: x = red + 32 * blue, y = green (checked on
+    // Forever's files: their corners are exact identity values). Two LUTs blended (two lights or two times).
+    const char* kShader = R"HLSL(
+sampler2D sceneTex : register(s0);
+sampler2D lutA : register(s1);
+sampler2D lutB : register(s2);
+float4 c_screen : register(c0); // 1/width, 1/height
+float4 c_grade  : register(c1); // blend lutA -> lutB, strength, debug (1 = split screen), unused
+
+float3 Lut(sampler2D lut, float3 c) {
+    float b = saturate(c.b) * 31.0;
+    float b0 = floor(b);
+    float b1 = min(b0 + 1.0, 31.0);
+    float2 uv = float2((saturate(c.r) * 31.0 + 0.5) / 1024.0, (saturate(c.g) * 31.0 + 0.5) / 32.0);
+    float3 x0 = tex2D(lut, uv + float2(b0 * 32.0 / 1024.0, 0)).rgb;
+    float3 x1 = tex2D(lut, uv + float2(b1 * 32.0 / 1024.0, 0)).rgb;
+    return lerp(x0, x1, b - b0);
+}
+
+float4 main(float2 vpos : VPOS) : COLOR0 {
+    float2 uv = (vpos + 0.5) * c_screen.xy;
+    float3 c = tex2D(sceneTex, uv).rgb;
+    if (c_grade.z > 0.5 && uv.x < 0.5) {
+        // split screen: a thin white line in the middle
+        return float4(uv.x > 0.5 - c_screen.x * 2.0 ? float3(1, 1, 1) : c, 1);
+    }
+    float3 g = lerp(Lut(lutA, c), Lut(lutB, c), c_grade.x);
+    return float4(saturate(lerp(c, g, c_grade.y)), 1);
+}
+)HLSL";
+
+    typedef HRESULT(WINAPI* D3DCompileFn)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*, LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+
+    CVar* s_enabled = nullptr;
+    CVar* s_strength = nullptr;
+    CVar* s_debug = nullptr;
+    CVar* s_force = nullptr;
+    CVar* s_info = nullptr;
+
+    IDirect3DPixelShader9* s_shader = nullptr;
+    bool s_shaderFailed = false;
+    IDirect3DTexture9* s_sceneTex = nullptr; // copy of the world image
+    IDirect3DSurface9* s_sceneSurf = nullptr;
+    UINT s_width = 0;
+    UINT s_height = 0;
+    std::unordered_map<int32_t, IDirect3DTexture9*> s_luts; // LUT id -> texture (nullptr = file missing); 0 = identity
+    char s_lastInfo[200] = "";
+
+    void RegisterCVars() {
+        static bool registered = false;
+        if (registered) return;
+        registered = true;
+        s_enabled = CVar::Register("hdGrade", "HD: 1 = WoW Forever colour grading, 0 = original", 1, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_strength = CVar::Register("hdGradeStrength", "HD: colour grading strength, 1 = Forever", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_debug = CVar::Register("hdGradeDebug", "HD: 1 = split screen, left original, right graded", 0, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_force = CVar::Register("hdGradeLut", "HD: 0 = Forever's LUT for this place, else force this LUT id everywhere", 1, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_info = CVar::Register("hdGradeInfo", "HD: hdGrade status (read only)", 0, "off", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    }
+
+    void SetInfo(const char* text) {
+        if (!s_info || !strcmp(s_lastInfo, text)) return;
+        snprintf(s_lastInfo, sizeof(s_lastInfo), "%s", text);
+        s_info->Set(text, true, false, false, false);
+    }
+
+    float Clamp(float v, float lo, float hi) {
+        return v < lo ? lo : (v > hi ? hi : v);
+    }
+
+    IDirect3DDevice9* Device() {
+        if (!g_theGxDevicePtr || g_theGxDevicePtr->DeviceApi() != GxApi_D3d9) return nullptr;
+        return static_cast<CGxDeviceD3d*>(g_theGxDevicePtr)->m_d3dDevice;
+    }
+
+    void ReleaseScene() {
+        if (s_sceneSurf) { s_sceneSurf->Release(); s_sceneSurf = nullptr; }
+        if (s_sceneTex) { s_sceneTex->Release(); s_sceneTex = nullptr; }
+        s_width = 0;
+        s_height = 0;
+    }
+
+    void ReleaseLuts() {
+        for (auto& lut : s_luts) {
+            if (lut.second) lut.second->Release();
+        }
+        s_luts.clear();
+    }
+
+    bool EnsureShader(IDirect3DDevice9* device) {
+        if (s_shader) return true;
+        if (s_shaderFailed) return false;
+        s_shaderFailed = true;
+
+        HMODULE module = LoadLibraryA("d3dcompiler_47.dll");
+        D3DCompileFn compile = module ? reinterpret_cast<D3DCompileFn>(GetProcAddress(module, "D3DCompile")) : nullptr;
+        if (!compile) {
+            SetInfo("ERROR: d3dcompiler_47.dll not found");
+            return false;
+        }
+        ID3DBlob* code = nullptr;
+        ID3DBlob* errors = nullptr;
+        HRESULT hr = compile(kShader, strlen(kShader), "HdGrade", nullptr, nullptr, "main", "ps_3_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+        if (FAILED(hr) || !code) {
+            char text[200];
+            snprintf(text, sizeof(text), "ERROR: shader: %s", errors ? static_cast<const char*>(errors->GetBufferPointer()) : "unknown");
+            SetInfo(text);
+            if (errors) errors->Release();
+            if (code) code->Release();
+            return false;
+        }
+        if (errors) errors->Release();
+        hr = device->CreatePixelShader(static_cast<const DWORD*>(code->GetBufferPointer()), &s_shader);
+        code->Release();
+        if (FAILED(hr)) {
+            s_shader = nullptr;
+            SetInfo("ERROR: CreatePixelShader failed");
+            return false;
+        }
+        s_shaderFailed = false;
+        return true;
+    }
+
+    // Reads forever_data\grading\<id>.blp (BLP2, uncompressed BGRA, 1024x32) into texels (BGRA, 1024x32).
+    bool ReadLutFile(int32_t id, std::vector<uint8_t>& texels) {
+        char path[2][96];
+        snprintf(path[0], sizeof(path[0]), "forever_data\\grading\\%d.blp", id);
+        snprintf(path[1], sizeof(path[1]), "..\\..\\forever_data\\grading\\%d.blp", id);
+        FILE* file = nullptr;
+        for (int i = 0; i < 2 && !file; i++) file = fopen(path[i], "rb");
+        if (!file) return false;
+        std::vector<uint8_t> data;
+        uint8_t buffer[4096];
+        size_t got;
+        while ((got = fread(buffer, 1, sizeof(buffer), file)) > 0) data.insert(data.end(), buffer, buffer + got);
+        fclose(file);
+
+        const size_t size = static_cast<size_t>(kLutWidth) * kLutHeight * 4;
+        if (data.size() < 148 || memcmp(data.data(), "BLP2", 4) != 0 || data[8] != 3) return false;
+        uint32_t width, height, offset;
+        memcpy(&width, &data[12], 4);
+        memcpy(&height, &data[16], 4);
+        memcpy(&offset, &data[20], 4);
+        if (width != kLutWidth || height != kLutHeight || offset + size > data.size()) return false;
+        texels.assign(data.begin() + offset, data.begin() + offset + size);
+        return true;
+    }
+
+    // The LUT texture for this id (0 = identity, no change). nullptr when the file is missing or broken.
+    IDirect3DTexture9* Lut(IDirect3DDevice9* device, int32_t id) {
+        auto found = s_luts.find(id);
+        if (found != s_luts.end()) return found->second;
+
+        std::vector<uint8_t> texels;
+        bool ok = true;
+        if (id == 0) {
+            texels.resize(static_cast<size_t>(kLutWidth) * kLutHeight * 4);
+            for (int32_t y = 0; y < kLutHeight; y++) {
+                for (int32_t x = 0; x < kLutWidth; x++) {
+                    uint8_t* t = &texels[(static_cast<size_t>(y) * kLutWidth + x) * 4];
+                    t[0] = static_cast<uint8_t>(((x / 32) * 255 + 15) / 31); // blue
+                    t[1] = static_cast<uint8_t>((y * 255 + 15) / 31);        // green
+                    t[2] = static_cast<uint8_t>(((x % 32) * 255 + 15) / 31); // red
+                    t[3] = 255;
+                }
+            }
+        } else {
+            ok = ReadLutFile(id, texels);
+        }
+
+        IDirect3DTexture9* tex = nullptr;
+        if (ok && SUCCEEDED(device->CreateTexture(kLutWidth, kLutHeight, 1, 0, D3DFMT_A8R8G8B8, D3DPOOL_MANAGED, &tex, nullptr)) && tex) {
+            D3DLOCKED_RECT rect;
+            if (SUCCEEDED(tex->LockRect(0, &rect, nullptr, 0))) {
+                for (int32_t y = 0; y < kLutHeight; y++) {
+                    memcpy(static_cast<uint8_t*>(rect.pBits) + y * rect.Pitch, &texels[static_cast<size_t>(y) * kLutWidth * 4], kLutWidth * 4);
+                }
+                tex->UnlockRect(0);
+            } else {
+                tex->Release();
+                tex = nullptr;
+            }
+        }
+        s_luts[id] = tex;
+        return tex;
+    }
+
+    // HD: how much of each LUT is wanted here. Up to 16 LUTs, then the two strongest are drawn.
+    struct LutWeights {
+        int32_t id[16];
+        float weight[16];
+        int32_t count = 0;
+
+        void Add(int32_t lut, float w) {
+            if (w <= 0.0f) return;
+            for (int32_t i = 0; i < count; i++) {
+                if (id[i] == lut) { weight[i] += w; return; }
+            }
+            if (count < 16) { id[count] = lut; weight[count] = w; count++; }
+        }
+
+        void Scale(float f) {
+            for (int32_t i = 0; i < count; i++) weight[i] *= f;
+        }
+    };
+
+    // One light's grading (clear weather blended to storm), as weights. No Forever grading = identity (0).
+    void AddLight(LutWeights& luts, const LightRec* light, int32_t time, float storm, float weight) {
+        for (int32_t pass = 0; pass < 2; pass++) {
+            float w = weight * (pass == 0 ? 1.0f - storm : storm);
+            if (w <= 0.0f) continue;
+            int32_t a, b;
+            float t;
+            if (HD::ForeverGradingAt(light, pass == 0 ? 0 : 2, time, &a, &b, &t)) {
+                luts.Add(a, w * (1.0f - t));
+                luts.Add(b, w * t);
+            } else {
+                luts.Add(0, w);
+            }
+        }
+    }
+
+    // Same light choice as the fog (HdFog CurrentForeverFog): the zone light, then the nearby area lights
+    // blended in by distance like DayNight::BlendAreaLight, farthest first so the nearest wins.
+    void CurrentLuts(LutWeights& luts) {
+        const DayNight::DNInfo& info = DayNight::g_dnInfo;
+        const TSGrowableArray<const LightRec*>& lights = DayNight::g_areaLights;
+        if (!lights.m_count) return;
+        int32_t time = static_cast<int32_t>(info.m_dayProgression * 2880.0f);
+        float storm = Clamp(info.m_stormBlend, 0.0f, 1.0f);
+        AddLight(luts, lights.m_data[0], time, storm, 1.0f);
+
+        struct Near { const LightRec* light; float distSq; float weight; };
+        Near nearLights[32];
+        int32_t count = 0;
+        for (uint32_t i = 1; i < lights.m_count && count < 32; i++) {
+            const LightRec* light = lights.m_data[i];
+            float dx = info.m_lightRefPos.x - light->m_gameCoords[0];
+            float dy = info.m_lightRefPos.y - light->m_gameCoords[1];
+            float dz = info.m_lightRefPos.z - light->m_gameCoords[2];
+            float distSq = dx * dx + dy * dy + dz * dz;
+            if (distSq >= light->m_gameFalloffEnd * light->m_gameFalloffEnd) continue;
+            float distance = sqrtf(distSq);
+            float weight = 1.0f;
+            if (distance > light->m_gameFalloffStart) {
+                float span = light->m_gameFalloffEnd - light->m_gameFalloffStart;
+                weight = span > 0.0f ? Clamp(1.0f - (distance - light->m_gameFalloffStart) / span, 0.0f, 1.0f) : 0.0f;
+            }
+            if (weight <= 0.0f) continue;
+            nearLights[count].light = light;
+            nearLights[count].distSq = distSq;
+            nearLights[count].weight = weight;
+            count++;
+        }
+        for (int32_t i = 1; i < count; i++) {
+            Near n = nearLights[i];
+            int32_t j = i - 1;
+            while (j >= 0 && nearLights[j].distSq < n.distSq) { nearLights[j + 1] = nearLights[j]; j--; }
+            nearLights[j + 1] = n;
+        }
+        for (int32_t i = 0; i < count; i++) {
+            luts.Scale(1.0f - nearLights[i].weight);
+            AddLight(luts, nearLights[i].light, time, storm, nearLights[i].weight);
+        }
+    }
+
+    // Our draw changed D3D state behind the client's back: make it send everything again.
+    void InvalidateClientState() {
+        CGxDeviceD3d* gx = static_cast<CGxDeviceD3d*>(g_theGxDevicePtr);
+        memset(gx->m_deviceStates, 0xFF, sizeof(gx->m_deviceStates));
+        gx->m_d3dCurrentVertexDecl = nullptr;
+        gx->m_d3dCurrentIndexBuf = nullptr;
+        for (int i = 0; i < 8; i++) gx->m_d3dVertexStreamBuf[i] = nullptr;
+        ShadowConstants& ps = CGxDevice::s_shadowConstants[0];
+        ps.dirtyMin = 0;
+        if (ps.dirtyMax < kConstRegs - 1) ps.dirtyMax = kConstRegs - 1;
+        gx->IRsForceUpdate();
+    }
+}
+
+void HD::GradeWorld() {
+    RegisterCVars();
+    if (!s_enabled || !s_enabled->m_intValue) {
+        if (s_sceneTex) ReleaseScene();
+        SetInfo("off");
+        return;
+    }
+
+    IDirect3DDevice9* device = Device();
+    if (!device) {
+        SetInfo("ERROR: needs gxApi d3d9");
+        return;
+    }
+    if (device->TestCooperativeLevel() != D3D_OK) {
+        ReleaseScene();
+        return;
+    }
+    if (!EnsureShader(device)) return;
+
+    // HD: which Forever LUTs here, the two strongest
+    LutWeights luts;
+    int32_t forced = s_force ? s_force->m_intValue : 0;
+    if (forced > 0) luts.Add(forced, 1.0f); // HD: test a LUT anywhere (e.g. zones Forever has no data for)
+    else CurrentLuts(luts);
+    int32_t first = -1, second = -1;
+    for (int32_t i = 0; i < luts.count; i++) {
+        if (first < 0 || luts.weight[i] > luts.weight[first]) { second = first; first = i; }
+        else if (second < 0 || luts.weight[i] > luts.weight[second]) second = i;
+    }
+    int32_t debug = s_debug ? s_debug->m_intValue : 0;
+    if (first < 0 || (luts.id[first] == 0 && (second < 0 || luts.id[second] == 0))) {
+        SetInfo("on, no Forever grading for this light (TBC, WotLK or Turtle zone)");
+        if (!debug) return;
+    }
+    int32_t idA = first >= 0 ? luts.id[first] : 0;
+    int32_t idB = second >= 0 ? luts.id[second] : idA;
+    float wA = first >= 0 ? luts.weight[first] : 1.0f;
+    float wB = second >= 0 ? luts.weight[second] : 0.0f;
+    float blend = wA + wB > 0.0f ? wB / (wA + wB) : 0.0f;
+    IDirect3DTexture9* texA = Lut(device, idA);
+    IDirect3DTexture9* texB = Lut(device, idB);
+    if (!texA || !texB) {
+        char text[200];
+        snprintf(text, sizeof(text), "ERROR: forever_data\\grading\\%d.blp missing or not a 1024x32 BGRA BLP", texA ? idB : idA);
+        SetInfo(text);
+        return;
+    }
+
+    IDirect3DSurface9* target = nullptr;
+    if (FAILED(device->GetRenderTarget(0, &target)) || !target) return;
+    D3DSURFACE_DESC desc;
+    target->GetDesc(&desc);
+    if (!s_sceneTex || desc.Width != s_width || desc.Height != s_height) {
+        ReleaseScene();
+        if (FAILED(device->CreateTexture(desc.Width, desc.Height, 1, D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &s_sceneTex, nullptr)) || !s_sceneTex) {
+            s_sceneTex = nullptr;
+            target->Release();
+            SetInfo("ERROR: could not create the grading texture");
+            return;
+        }
+        s_sceneTex->GetSurfaceLevel(0, &s_sceneSurf);
+        s_width = desc.Width;
+        s_height = desc.Height;
+    }
+
+    D3DVIEWPORT9 viewport;
+    device->GetViewport(&viewport);
+    device->StretchRect(target, nullptr, s_sceneSurf, nullptr, D3DTEXF_POINT);
+
+    float strength = s_strength ? Clamp(s_strength->m_floatValue, 0.0f, 2.0f) : 1.0f;
+    float c[kConstRegs * 4] = {
+        1.0f / desc.Width, 1.0f / desc.Height, 0.0f, 0.0f,
+        blend, strength, static_cast<float>(debug), 0.0f,
+    };
+
+    // Full-screen pass over the world, no depth, no blend, keep alpha (used by the glow).
+    device->SetRenderState(D3DRS_ZENABLE, FALSE);
+    device->SetRenderState(D3DRS_ZWRITEENABLE, FALSE);
+    device->SetRenderState(D3DRS_STENCILENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHATESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);
+    device->SetRenderState(D3DRS_CULLMODE, D3DCULL_NONE);
+    device->SetRenderState(D3DRS_FOGENABLE, FALSE);
+    device->SetRenderState(D3DRS_SCISSORTESTENABLE, FALSE);
+    device->SetRenderState(D3DRS_CLIPPLANEENABLE, 0);
+    device->SetRenderState(D3DRS_SRGBWRITEENABLE, FALSE);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, D3DCOLORWRITEENABLE_RED | D3DCOLORWRITEENABLE_GREEN | D3DCOLORWRITEENABLE_BLUE);
+    device->SetVertexShader(nullptr);
+    device->SetPixelShader(s_shader);
+    device->SetFVF(D3DFVF_XYZRHW);
+    IDirect3DBaseTexture9* textures[3] = { s_sceneTex, texA, texB };
+    for (DWORD i = 0; i < 3; i++) {
+        device->SetTexture(i, textures[i]);
+        D3DTEXTUREFILTERTYPE filter = i == 0 ? D3DTEXF_POINT : D3DTEXF_LINEAR;
+        device->SetSamplerState(i, D3DSAMP_MINFILTER, filter);
+        device->SetSamplerState(i, D3DSAMP_MAGFILTER, filter);
+        device->SetSamplerState(i, D3DSAMP_MIPFILTER, D3DTEXF_NONE);
+        device->SetSamplerState(i, D3DSAMP_ADDRESSU, D3DTADDRESS_CLAMP);
+        device->SetSamplerState(i, D3DSAMP_ADDRESSV, D3DTADDRESS_CLAMP);
+        device->SetSamplerState(i, D3DSAMP_SRGBTEXTURE, FALSE);
+    }
+    device->SetPixelShaderConstantF(0, c, kConstRegs);
+    device->SetRenderTarget(0, target); // same target, but this also sets the viewport to all of it
+
+    float w = static_cast<float>(desc.Width) - 0.5f;
+    float h = static_cast<float>(desc.Height) - 0.5f;
+    float quad[16] = {
+        -0.5f, -0.5f, 0.0f, 1.0f,
+        w, -0.5f, 0.0f, 1.0f,
+        -0.5f, h, 0.0f, 1.0f,
+        w, h, 0.0f, 1.0f,
+    };
+    device->DrawPrimitiveUP(D3DPT_TRIANGLESTRIP, 2, quad, 4 * sizeof(float));
+
+    for (DWORD i = 0; i < 3; i++) device->SetTexture(i, nullptr);
+    device->SetRenderState(D3DRS_COLORWRITEENABLE, 0x0F);
+    // HD: the client turns the depth buffer on once at start-up and never again (see HdFog.cpp)
+    device->SetRenderState(D3DRS_ZENABLE, D3DZB_TRUE);
+    device->SetViewport(&viewport);
+    target->Release();
+    InvalidateClientState();
+
+    char text[200];
+    snprintf(text, sizeof(text), "on, LUT %d (%.0f%%) + LUT %d (%.0f%%), strength %.2f%s", idA, (1.0f - blend) * 100.0f, idB, blend * 100.0f, strength, debug ? ", split screen" : "");
+    SetInfo(text);
+}
+
+void HD::GradeReleaseDeviceResources() {
+    ReleaseScene();
+    ReleaseLuts();
+}
