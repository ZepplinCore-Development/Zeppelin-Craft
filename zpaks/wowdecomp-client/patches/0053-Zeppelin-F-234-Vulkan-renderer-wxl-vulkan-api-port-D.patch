+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "native/present/Internal.hpp"
+
+using namespace wxlvk::native::present::detail;
+
+namespace wxlvk::native::present
+{
+    // --- queries ---------------------------------------------------------------------------------------
+
+    bool QueryStart(QueryRun& run)
+    {
+        if (!EnsureFrame()) return false;
+        QueryForget(run);
+        if (s.queryPools[0] == VK_NULL_HANDLE)
+        {
+            VkQueryPoolCreateInfo info = {};
+            info.sType      = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+            info.queryType  = VK_QUERY_TYPE_OCCLUSION;
+            info.queryCount = kQueriesPerSlot;
+            for (uint32_t i = 0; i < kFramesInFlight; ++i)
+            {
+                const VkResult r = s.dapi->CreateQueryPool(s.device, &info, nullptr, &s.queryPools[i]);
+                if (r != VK_SUCCESS)
+                {
+                    s.queryPools[i] = VK_NULL_HANDLE;
+                    wxl::ScriptMgr::Log(WXL_LOG_ERROR, "native: queries: vkCreateQueryPool failed (%s); "
+                                        "occlusion queries answer 0", ResultName(r));
+                    return false;
+                }
+            }
+            // D3D9's occlusion query is an exact sample count, and the glare divides it by the quad's
+            // area: precise whenever the device allows it.
+            const context::Handles* h = context::Get();
+            s.queryControl = h && h->occlusionQueryPrecise ? VK_QUERY_CONTROL_PRECISE_BIT : 0u;
+            // This frame's pool was not reset at its open (it did not exist): reset ahead of the frame.
+            // The other slot's is reset at its own next open.
+            VkCommandBuffer pre = PrePass();
+            if (!pre) return false;
+            s.dapi->CmdResetQueryPool(pre, s.queryPools[s.fi], 0, kQueriesPerSlot);
+            wxl::ScriptMgr::Log(WXL_LOG_DEBUG, "native: queries: occlusion query pools made (%u per frame "
+                                "slot, %s); the first engine query began at serial %llu", kQueriesPerSlot,
+                                s.queryControl ? "precise" : "not precise: the device has no occlusionQueryPrecise",
+                                static_cast<unsigned long long>(s.serial));
+        }
+        if (s.activeRun && s.activeRun != &run)
+        {
+            QueryStop(*s.activeRun);
+            ++s.stats.queryNested;
+        }
+        run = QueryRun();
+        run.serial = s.serial;
+        run.slot   = s.fi;
+        run.active = true;
+        if (s.runCount[s.fi] < kMaxRunsPerSlot)
+        {
+            s.runs[s.fi][s.runCount[s.fi]++] = &run;
+            run.registered = true;
+        }
+        else
+            run.overflow = true;   // not harvested at the slot's reopen: read before then, or lost
+        s.activeRun = &run;
+        ++s.stats.queriesBegun;
+        if (s.passOpen) QueryBeginVk(run);
+        return true;
+    }
+
+    void QueryStop(QueryRun& run)
+    {
+        if (!run.active) return;
+        QueryEndVk(run);
+        run.active = false;
+        if (s.activeRun == &run) s.activeRun = nullptr;
+    }
+
+    void QueryForget(QueryRun& run)
+    {
+        if (run.active) QueryStop(run);
+        if (s.activeRun == &run) s.activeRun = nullptr;
+        Unregister(run);
+    }
+
+    bool QueryReady(QueryRun& run)
+    {
+        if (run.serial == 0) return true;   // never issued: D3D's new query is signalled
+        if (run.active) return false;
+        if (run.harvested) return true;
+        if (!run.registered && s.serial >= run.serial + kFramesInFlight)
+        {
+            // Not on a harvest list (more runs than it holds) and its slot reopened since: lost.
+            run.samples   = 0;
+            run.harvested = true;
+            return true;
+        }
+        if (run.serial > s.completed) Poll();
+        if (run.serial > s.completed) return false;
+        return Harvest(run, false);
+    }
+
+    bool QueryActive() { return s.activeRun != nullptr && s.activeRun->active; }
+
+    void NoteQueryDraw(bool drawn)
+    {
+        if (!s.activeRun) return;
+        ++s.activeRun->draws;
+        if (drawn) ++s.activeRun->drawn;
+    }
+
+    bool QueryInPass() { return s.activeRun != nullptr && s.activeRun->inPass; }
+
+    uint32_t PassDepthKind(VkFormat& format)
+    {
+        format = VK_FORMAT_UNDEFINED;
+        if (!s.passOpen || !s.passHasDepth) return 0;
+        format = s.passDepth.format;
+        if (s.passDepth.back) return 1;
+        if (s.passDepth.tex) return 2;
+        return 3;
+    }
+
+    bool QueryWait(QueryRun& run)
+    {
+        if (QueryReady(run)) return true;
+        if (run.active) return false;
+        if (s.open && run.serial == s.serial)
+        {
+            if (!FlushAndWait()) return false;
+            return Harvest(run, true);
+        }
+        if (!WaitSerial(run.serial)) return false;
+        return Harvest(run, false) || Harvest(run, true);
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/present/ReadBack.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/present/ReadBack.cpp
new file mode 100644
index 00000000..1383925a
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/present/ReadBack.cpp
@@ -0,0 +1,248 @@
+// The present path's targets, copies and read-backs.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "native/present/Internal.hpp"
+
+using namespace wxlvk::native::present::detail;
+
+namespace wxlvk::native::present
+{
+    // --- targets, copies, read-back -------------------------------------------------------------------
+
+    void SetTarget(const TargetDesc& t)
+    {
+        if (SameTarget(t, s.target)) return;
+        EndPass();
+        s.target = t;
+    }
+
+    const TargetDesc& Target() { return s.target; }
+
+    bool OnBackBuffer() { return s.passOpen ? s.passColour.back : s.target.colour == nullptr; }
+
+    void ForgetImage(const texture::Image* image)
+    {
+        if (!image) return;
+        if (s.passOpen && (s.passColour.tex == image || (s.passHasDepth && s.passDepth.tex == image))) EndPass();
+        if (s.target.colour == image || s.target.depthImage == image)
+        {
+            s.target.invalid     = true;
+            s.target.colour      = s.target.colour == image ? nullptr : s.target.colour;
+            s.target.depthImage  = s.target.depthImage == image ? nullptr : s.target.depthImage;
+            s.target.colourStamp = nullptr;
+            s.target.depthStamp  = nullptr;
+        }
+    }
+
+    void ForgetView(VkImageView view, uint64_t lastUsed)
+    {
+        if (!s.dapi) return;
+        DropFramebuffersNaming(view, lastUsed, false);
+    }
+
+    void RetireView(VkImageView view, uint64_t lastUsed)
+    {
+        if (view == VK_NULL_HANDLE || !s.dapi) return;
+        DropFramebuffersNaming(view, lastUsed, false);
+        Retired e;
+        e.kind   = Kind::View;
+        e.view   = view;
+        e.serial = lastUsed;
+        Retire(e);
+    }
+
+    VkFormat DepthTextureFormat()
+    {
+        const context::Handles* h = context::Get();
+        if (!h || !h->iapi || !h->iapi->GetPhysicalDeviceFormatProperties) return VK_FORMAT_UNDEFINED;
+        EnsureDepthFormat();
+        const VkFormatFeatureFlags need = VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT |
+                                          VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+        // The back depth's own format first (one pass class with the back buffer when a depth
+        // texture is drawn with the back colour); single-aspect only, see texture::CreateTarget.
+        const VkFormat candidates[] = { s.depthFormat, VK_FORMAT_D32_SFLOAT, VK_FORMAT_D16_UNORM };
+        for (VkFormat f : candidates)
+        {
+            if (f != VK_FORMAT_D32_SFLOAT && f != VK_FORMAT_D16_UNORM) continue;
+            VkFormatProperties fp = {};
+            h->iapi->GetPhysicalDeviceFormatProperties(h->physical, f, &fp);
+            if ((fp.optimalTilingFeatures & need) == need) return f;
+        }
+        return VK_FORMAT_UNDEFINED;
+    }
+
+    bool BackBufferReadable()
+    {
+        if (!s.ownBack || s.backImage == VK_NULL_HANDLE)
+        {
+            const context::Handles* h = context::Get();
+            if (h && h->swapchain != VK_NULL_HANDLE && h->extent.width && h->extent.height && EnsureFrame())
+                EnsureImageObjects(*h);
+        }
+        return s.ownBack && s.backImage != VK_NULL_HANDLE;
+    }
+
+    bool BackBuffer(VkCommandBuffer cmd, VkImageLayout layout, VkImage& image, VkFormat& format, VkExtent2D& extent)
+    {
+        if (!cmd || !BackBufferReadable()) return false;
+        if (s.passOpen && s.passColour.back) EndPass();   // the caller's Outside() did this already
+        if (s.backLayout == VK_IMAGE_LAYOUT_UNDEFINED)
+        {
+            // Never drawn since it was (re)made: a copy or a read-back of it would hand over whatever
+            // the memory held. Black, as a first pass on it and the present copy make it.
+            Barrier(cmd, s.backImage, VK_IMAGE_ASPECT_COLOR_BIT, 1, 1, VK_IMAGE_LAYOUT_UNDEFINED,
+                    VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, true);
+            VkClearColorValue black = {};
+            black.float32[3] = 1.0f;
+            VkImageSubresourceRange range = {};
+            range.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+            range.levelCount = 1;
+            range.layerCount = 1;
+            s.dapi->CmdClearColorImage(cmd, s.backImage, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &black, 1, &range);
+            s.backLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+        }
+        if (s.backLayout != layout)
+            Barrier(cmd, s.backImage, VK_IMAGE_ASPECT_COLOR_BIT, 1, 1, s.backLayout, layout,
+                    s.backLayout == VK_IMAGE_LAYOUT_UNDEFINED);
+        s.backLayout  = layout;
+        s.backTouched = true;
+        image  = s.backImage;
+        format = s.colourFormat;
+        extent = s.extent;
+        return true;
+    }
+
+    bool BackBufferInfo(VkFormat& format, VkExtent2D& extent)
+    {
+        if (!s.ownBack || s.backImage == VK_NULL_HANDLE || s.noImage) return false;
+        format = s.colourFormat;
+        extent = s.extent;
+        return true;
+    }
+
+    bool SceneDepth(VkCommandBuffer cmd, VkImageLayout layout, VkImageView& view, VkFormat& format)
+    {
+        if (!cmd || !s.depthSampled || s.depthView == VK_NULL_HANDLE) return false;
+        // Not written this frame (the next pass would discard it) or never: nothing to read.
+        if (s.depthFresh || s.depthLayout == VK_IMAGE_LAYOUT_UNDEFINED) return false;
+        if (s.passOpen && s.passHasDepth && s.passDepth.back) EndPass();
+        if (s.depthLayout != layout)
+            Barrier(cmd, s.depthImage, AspectOf(s.depthFormat), 1, 1, s.depthLayout, layout, false);
+        s.depthLayout = layout;
+        s.backTouched = true;
+        view   = s.depthView;
+        format = s.depthFormat;
+        return true;
+    }
+
+    void Transition(VkCommandBuffer cmd, texture::Image& image, VkImageLayout to)
+    {
+        if (!cmd || image.handle == VK_NULL_HANDLE || image.layout == to) return;
+        Barrier(cmd, image.handle, AspectOf(image.format), image.levels, image.layers, image.layout, to,
+                image.layout == VK_IMAGE_LAYOUT_UNDEFINED);
+        image.layout = to;
+    }
+
+    bool FlushAndWait()
+    {
+        if (!s.open) return true;
+        if (s.failed) return false;
+        wxlvk::native::perf::Scope timed(wxlvk::native::perf::kFlush);
+        if (s.acquired)
+        {
+            // The direct path: a submit now would have to consume the acquire's semaphore.
+            ++s.stats.flushRefused;
+            return false;
+        }
+        const context::Handles* h = context::Get();
+        const loader::Device&   d = *s.dapi;
+        FrameSlot&              slot = s.slots[s.fi];
+        if (s.passOpen)
+        {
+            s.breakView = s.passColour.view;
+            EndPass();
+            ++s.stats.passBreaks;
+            ++s.breaksThisFrame;
+        }
+        VkCommandBuffer buffers[2];
+        uint32_t        count = 0;
+        if (s.preBegun)
+        {
+            EndPrePass(slot);
+            VkResult r = d.EndCommandBuffer(slot.pre);
+            if (r != VK_SUCCESS)
+            {
+                Fail("vkEndCommandBuffer (pre-pass, flush)", r);
+                return false;
+            }
+            buffers[count++] = slot.pre;
+        }
+        // Everything the GPU wrote is made visible to the host reads that follow the wait.
+        VkMemoryBarrier m = {};
+        m.sType         = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+        m.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+        m.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+        d.CmdPipelineBarrier(slot.main, VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                             VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &m, 0, nullptr, 0, nullptr);
+        VkResult r = d.EndCommandBuffer(slot.main);
+        if (r != VK_SUCCESS)
+        {
+            Fail("vkEndCommandBuffer (flush)", r);
+            return false;
+        }
+        buffers[count++] = slot.main;
+        FlushRings(slot);
+        r = d.ResetFences(s.device, 1, &slot.fence);
+        if (r != VK_SUCCESS)
+        {
+            Fail("vkResetFences (flush)", r);
+            return false;
+        }
+        VkSubmitInfo submit = {};
+        submit.sType              = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+        submit.commandBufferCount = count;
+        submit.pCommandBuffers    = buffers;
+        wxlvk::host::SubmitExtras hostLink;   // WXL_HOST: a composite's timeline wait and signal; else nothing
+        wxlvk::host::DecorateSubmit(submit, hostLink);
+        r = d.QueueSubmit(h->graphicsQueue, 1, &submit, slot.fence);
+        wxlvk::host::AfterSubmit(hostLink, r == VK_SUCCESS);
+        if (r != VK_SUCCESS)
+        {
+            Fail("vkQueueSubmit (flush)", r);
+            return false;
+        }
+        r = d.WaitForFences(s.device, 1, &slot.fence, VK_TRUE, UINT64_MAX);
+        if (r != VK_SUCCESS)
+        {
+            Fail("vkWaitForFences (flush)", r);
+            return false;
+        }
+        ++s.stats.flushes;
+        // The same frame goes on: same serial, same slot, its pools and staging spans untouched (the
+        // GPU is done with them, nothing reset them).
+        VkCommandBufferBeginInfo begin = {};
+        begin.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+        begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+        r = d.BeginCommandBuffer(slot.main, &begin);
+        if (r != VK_SUCCESS)
+        {
+            Fail("vkBeginCommandBuffer (after a flush)", r);
+            return false;
+        }
+        s.preBegun = false;
+        return true;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/present/Resolve.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/present/Resolve.cpp
new file mode 100644
index 00000000..9f4f43fd
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/present/Resolve.cpp
@@ -0,0 +1,151 @@
+// Resolving the current target into the pass's colour and depth sides.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "native/present/Internal.hpp"
+
+namespace wxlvk::native::present::detail
+{
+    // --- resolving the current target ------------------------------------------------------------------
+
+    bool BackColour(Side& out)
+    {
+        if (s.noImage) return false;
+        const context::Handles* h = context::Get();
+        if (!h || h->swapchain == VK_NULL_HANDLE || h->extent.width == 0 || h->extent.height == 0
+            || !EnsureImageObjects(*h))
+        {
+            s.noImage = true;
+            ++s.stats.noImage;
+            return false;
+        }
+        out = Side();
+        out.back   = true;
+        out.format = s.colourFormat;
+        out.extent = s.extent;
+        if (s.ownBack)
+        {
+            out.image   = s.backImage;
+            out.view    = s.backView;
+            out.layout  = &s.backLayout;
+            out.discard = s.backLayout == VK_IMAGE_LAYOUT_UNDEFINED;
+            out.clear   = out.discard;   // a back buffer never drawn: black
+        }
+        else
+        {
+            if (!Acquire()) return false;
+            out.image   = s.images[s.image];
+            out.view    = s.views[s.image];
+            out.layout  = &s.swapLayout;
+            out.discard = s.swapLayout == VK_IMAGE_LAYOUT_UNDEFINED;
+            out.clear   = out.discard;
+        }
+        return out.view != VK_NULL_HANDLE;
+    }
+
+    bool BackDepth(Side& out)
+    {
+        if (s.depthView == VK_NULL_HANDLE)
+        {
+            const context::Handles* h = context::Get();
+            if (!h || h->swapchain == VK_NULL_HANDLE || !EnsureImageObjects(*h)) return false;
+        }
+        if (s.depthView == VK_NULL_HANDLE) return false;
+        out = Side();
+        out.back    = true;
+        out.image   = s.depthImage;
+        out.view    = s.depthView;
+        out.format  = s.depthFormat;
+        out.extent  = s.extent;
+        out.layout  = &s.depthLayout;
+        out.aspect  = AspectOf(s.depthFormat);
+        // Discarded and cleared to the far plane at its first use in a frame.
+        out.discard = s.depthFresh || s.depthLayout == VK_IMAGE_LAYOUT_UNDEFINED;
+        out.clear   = out.discard;
+        return true;
+    }
+
+    /// D3D's +0x3B38: one depth image for every colour target without a depth texture, grown to the
+    /// largest target asked for, never shrunk.
+    bool Offscreen(Side& out, VkExtent2D need)
+    {
+        EnsureDepthFormat();
+        if (s.depthFormat == VK_FORMAT_UNDEFINED) return false;
+        if (s.offImage == VK_NULL_HANDLE || s.offExtent.width < need.width || s.offExtent.height < need.height)
+        {
+            const VkExtent2D grow = { need.width > s.offExtent.width ? need.width : s.offExtent.width,
+                                      need.height > s.offExtent.height ? need.height : s.offExtent.height };
+            if (s.offImage != VK_NULL_HANDLE)
+            {
+                // Earlier passes of this very frame may have used it: retired by the open serial.
+                DropFramebuffersNaming(s.offView, s.serial, false);
+                Retired e;
+                e.kind     = Kind::Raw;
+                e.raw      = s.offImage;
+                e.view     = s.offView;
+                e.rawBlock = s.offBlock;
+                e.serial   = s.serial;
+                Retire(e);
+                s.offImage = VK_NULL_HANDLE;
+                s.offView  = VK_NULL_HANDLE;
+                s.offBlock = memory::Block();
+            }
+            if (!MakeRaw(s.depthFormat, grow, VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT, s.offImage, s.offView,
+                         s.offBlock, "offscreen depth"))
+            {
+                s.offExtent = VkExtent2D{ 0, 0 };
+                return false;
+            }
+            s.offExtent = grow;
+            s.offLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+            ++s.stats.offscreenGrows;
+            wxl::ScriptMgr::Log(WXL_LOG_DEBUG, "native: frame: offscreen depth (colour targets without a "
+                                "depth texture) is now %ux%u %s", grow.width, grow.height,
+                                wxlvk::vk::FormatName(s.depthFormat));
+        }
+        out = Side();
+        out.image   = s.offImage;
+        out.view    = s.offView;
+        out.format  = s.depthFormat;
+        out.extent  = s.offExtent;
+        out.layout  = &s.offLayout;
+        out.aspect  = AspectOf(s.depthFormat);
+        out.discard = s.offLayout == VK_IMAGE_LAYOUT_UNDEFINED;
+        out.clear   = out.discard;
+        return true;
+    }
+
+    void TextureSide(texture::Image* img, VkImageView view, uint64_t* stamp, Side& out)
+    {
+        out = Side();
+        out.image   = img->handle;
+        out.view    = view;
+        out.format  = img->format;
+        out.extent  = img->extent;
+        out.layout  = &img->layout;
+        out.levels  = img->levels;
+        out.layers  = img->layers;
+        out.aspect  = AspectOf(img->format);
+        out.tex     = img;
+        out.stamp   = stamp;
+        out.discard = img->layout == VK_IMAGE_LAYOUT_UNDEFINED;
+        out.clear   = out.discard && IsDepth(img->format);
+    }
+
+    VkExtent2D Min(VkExtent2D a, VkExtent2D b)
+    {
+        return VkExtent2D{ a.width < b.width ? a.width : b.width, a.height < b.height ? a.height : b.height };
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/present/Retire.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/present/Retire.cpp
new file mode 100644
index 00000000..46b89821
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/present/Retire.cpp
@@ -0,0 +1,150 @@
+// Retirement by frame serial, and the staging and upload rings.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#include "native/present/Internal.hpp"
+
+namespace wxlvk::native::present::detail
+{
+    // --- retirement and the staging ring ---------------------------------------------------------------
+
+    void DestroyRetired(Retired& e)
+    {
+        const loader::Device& d = *s.dapi;
+        switch (e.kind)
+        {
+            case Kind::Image:
+                texture::DestroyIdle(e.img);
+                ++s.stats.retiredImages;
+                break;
+            case Kind::Buffer:
+                memory::DestroyBuffer(e.buf);
+                ++s.stats.retiredBuffers;
+                break;
+            case Kind::Framebuffer:
+                if (e.fb != VK_NULL_HANDLE) d.DestroyFramebuffer(s.device, e.fb, nullptr);
+                break;
+            case Kind::View:
+                if (e.view != VK_NULL_HANDLE) d.DestroyImageView(s.device, e.view, nullptr);
+                break;
+            case Kind::Raw:
+                if (e.view != VK_NULL_HANDLE) d.DestroyImageView(s.device, e.view, nullptr);
+                if (e.raw != VK_NULL_HANDLE) d.DestroyImage(s.device, e.raw, nullptr);
+                memory::Free(e.rawBlock);
+                break;
+        }
+    }
+
+    void CollectRetired()
+    {
+        uint32_t keep = 0;
+        for (uint32_t i = 0; i < s.retiredCount; ++i)
+        {
+            Retired& e = s.retired[i];
+            if (e.serial <= s.completed)
+            {
+                DestroyRetired(e);
+                continue;
+            }
+            if (keep != i) s.retired[keep] = e;
+            ++keep;
+        }
+        for (uint32_t i = keep; i < s.retiredCount; ++i) s.retired[i] = Retired();
+        s.retiredCount = keep;
+    }
+
+    /// The common half of every retirement: destroyed at once when its frame is known complete.
+    void Retire(Retired& e)
+    {
+        // The open frame's serial is never completed, so a resource it named waits for it. The
+        // fences are polled only when the serial was submitted -- for the open frame's (a zone
+        // change retires thousands of objects inside one frame) no poll can help.
+        if (e.serial > s.completed && e.serial <= s.submitted) Poll();
+        if (e.serial <= s.completed)
+        {
+            DestroyRetired(e);
+            ++s.stats.retiredAtOnce;
+            return;
+        }
+        if (!RetireRoom())
+        {
+            ++s.stats.retireLeaked;
+            return;
+        }
+        s.retired[s.retiredCount++] = e;
+        if (s.retiredCount > s.stats.retirePeak) s.stats.retirePeak = s.retiredCount;
+    }
+
+    /// The upload ring's half of ResetStaging (same rule, its own keep count).
+    void ResetUploads(FrameSlot& slot)
+    {
+        uint32_t keep = 0;
+        for (uint32_t i = 0; i < slot.upCount; ++i)
+        {
+            Chunk& c = slot.up[i];
+            if (i >= kKeepUpChunks && c.used == 0)
+            {
+                memory::DestroyBuffer(c.buffer);
+                --s.stats.uploadChunks;
+                continue;
+            }
+            c.used = 0;
+            if (keep != i)
+            {
+                slot.up[keep] = c;
+                c = Chunk();
+            }
+            ++keep;
+        }
+        slot.upCount  = keep;
+        slot.upCursor = 0;
+    }
+
+    /// The CPU's writes into both rings made visible before a submit -- a no-op on a coherent
+    /// type (every desktop adapter offers one), the flush the non-coherent fallback needs.
+    void FlushRings(FrameSlot& slot)
+    {
+        for (uint32_t i = 0; i < slot.chunkCount; ++i)
+            if (slot.chunks[i].used) memory::FlushHost(slot.chunks[i].buffer.block);
+        for (uint32_t i = 0; i < slot.upCount; ++i)
+            if (slot.up[i].used) memory::FlushHost(slot.up[i].buffer.block);
+    }
+
+    void ResetStaging(FrameSlot& slot)
+    {
+        ResetUploads(slot);
+        // The slot's fence was just waited: nothing reads any of its chunks any more.
+        uint32_t keep = 0;
+        for (uint32_t i = 0; i < slot.chunkCount; ++i)
+        {
+            Chunk& c = slot.chunks[i];
+            if (i >= kKeepChunks && c.used == 0)
+            {
+                memory::DestroyBuffer(c.buffer);
+                --s.stats.stagingChunks;
+                continue;
+            }
+            c.used = 0;
+            if (keep != i)
+            {
+                slot.chunks[keep] = c;
+                c = Chunk();
+            }
+            ++keep;
+        }
+        slot.chunkCount  = keep;
+        slot.chunkCursor = 0;
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/present/State.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/native/present/State.cpp
