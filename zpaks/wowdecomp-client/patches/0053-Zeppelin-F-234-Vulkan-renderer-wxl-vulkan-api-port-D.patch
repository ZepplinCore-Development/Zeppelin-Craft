+// HD: with a file named hd_dump_shaders next to the exe, every shader the client loads is appended to
+// hd_shader_dump.bin ("HDSH", name length, file name, permutation, code size, D3D bytecode) so the HD passes can
+// be written against the original shaders. Local study only, never shared.
+static void HdDumpShaders(const char* filename, CGxShader** shaders, uint32_t permutations) {
+    static int32_t enabled = -1;
+    if (enabled < 0) {
+        FILE* flag = fopen("hd_dump_shaders", "rb");
+        enabled = flag != nullptr;
+        if (flag) fclose(flag);
+    }
+    if (!enabled) return;
+
+    FILE* out = fopen("hd_shader_dump.bin", "ab");
+    if (!out) return;
+    uint32_t nameLength = static_cast<uint32_t>(strlen(filename));
+    for (uint32_t i = 0; i < permutations; i++) {
+        uint32_t size = shaders[i]->m_code.Count();
+        fwrite("HDSH", 1, 4, out);
+        fwrite(&nameLength, 4, 1, out);
+        fwrite(filename, 1, nameLength, out);
+        fwrite(&i, 4, 1, out);
+        fwrite(&size, 4, 1, out);
+        if (size) fwrite(shaders[i]->m_code.m_data, 1, size, out);
+    }
+    fclose(out);
+}
+
