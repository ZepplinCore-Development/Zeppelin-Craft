+ debug=Var("hdSunDebug","0 normal, 1 sun, 2 contact, 3 combined, 4 coverage, 5 shaded colour, 6 sunlit colour, 7 engine colour","0",0);strength=Var("hdSunStrength","HD Vulkan shadow replacement strength 0..1","1");
