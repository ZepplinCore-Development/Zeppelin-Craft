+        uint32_t src=pass==7||pass>=9?6:5,dst=pass==6||pass==8?6:5;
+        VkImageView ao=pass==10&&temporal?s->historyInfo[current].view:slot.images[src].view;
+        VkImageView output=pass==9?s->historyInfo[current].view:slot.images[pass<5?pass:dst].view;
+        VkDescriptorImageInfo images[11]{};images[0]={s->sampler,ctx.depthView,ctx.depthLayout};
+        for(uint32_t i=0;i<5;++i)images[i+1]={s->sampler,slot.images[i].view,VK_IMAGE_LAYOUT_GENERAL};
+        images[6]={s->sampler,normal,normalLayout};images[7]={s->sampler,ao,VK_IMAGE_LAYOUT_GENERAL};
+        images[8]={VK_NULL_HANDLE,output,VK_IMAGE_LAYOUT_GENERAL};images[9]={VK_NULL_HANDLE,ctx.colorView,ctx.colorLayout};
+        images[10]={s->sampler,s->historyInfo[previous].view,VK_IMAGE_LAYOUT_GENERAL};
+        VkWriteDescriptorSet writes[11]{};for(uint32_t i=0;i<11;++i){auto&d=writes[i];d.sType=VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;d.dstSet=slot.sets[pass];d.dstBinding=i;d.descriptorCount=1;d.descriptorType=i<8||i==10?VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;d.pImageInfo=&images[i];}
+        s->UpdateDescriptorSets(s->device.device,11,writes,0,nullptr);
+        uint32_t pipeline=pass==0?0:pass<5?1:pass==5?2+std::min(settings.quality,3u):pass<9?6:pass==9?8:7;
+        Constants push=c;push.flags[0]=pass<5?pass:(pass==8?1:0);uint32_t block=pass<5?1u<<pass:1;
+        if(pass==9){std::memcpy(push.screen,reprojection,16);std::memcpy(push.depth,reprojection+4,16);std::memcpy(push.params,reprojection+8,16);
+            push.blur[0]=16;push.blur[1]=reuse?1.0f:0.0f;push.blur[2]=.02f;push.blur[3]=.04f;} // max frames, history usable, clamp margin, depth tolerance
+        uint32_t w=pass==10?s->width:(s->aoWidth+block-1)/block,h=pass==10?s->height:(s->aoHeight+block-1)/block;
+        s->CmdBindPipeline(ctx.cmd,VK_PIPELINE_BIND_POINT_COMPUTE,s->pipeline[pipeline]);s->CmdBindDescriptorSets(ctx.cmd,VK_PIPELINE_BIND_POINT_COMPUTE,s->pipelineLayout,0,1,&slot.sets[pass],0,nullptr);
+        s->CmdPushConstants(ctx.cmd,s->pipelineLayout,VK_SHADER_STAGE_COMPUTE_BIT,0,sizeof push,&push);s->CmdDispatch(ctx.cmd,(w+7)/8,(h+7)/8,1);s->Between(ctx.cmd);
+    }
+    slot.initialized=true;
+    if(temporal){s->historyIndex=current;s->historySerial=ctx.serial;}else s->historySerial=0;
+    for(int i=0;i<16;++i){s->previousView[i]=ctx.scene->view[i];s->previousProjection[i]=ctx.scene->projection[i];}
+    s->previousViewport=ctx.viewport;s->previousJitter[0]=settings.extraJitterX;s->previousJitter[1]=settings.extraJitterY;s->havePrevious=true;
+    s->error="";return true;
+}
+bool Effect::Shutdown(uint64_t completed) {
+    auto* s=state_;if(!s) return true;
+    if(completed<s->lastSerial) {s->error="shutdown pending completed serial";return false;}
+    for(auto& slot:s->slots) for(auto handle:slot.handles) if(handle) s->api->RetireImage(handle,slot.serial);
+    for(auto handle:s->history) if(handle) s->api->RetireImage(handle,s->lastSerial);
+    if(s->pool) s->DestroyDescriptorPool(s->device.device,s->pool,nullptr);
+    if(s->sampler) s->DestroySampler(s->device.device,s->sampler,nullptr);
+    for(auto pipeline:s->pipeline) if(pipeline) s->DestroyPipeline(s->device.device,pipeline,nullptr);
+    if(s->pipelineLayout) s->DestroyPipelineLayout(s->device.device,s->pipelineLayout,nullptr);
+    if(s->setLayout) s->DestroyDescriptorSetLayout(s->device.device,s->setLayout,nullptr);
+    delete s;state_=nullptr;return true;
+}
+uint64_t Effect::LastUsed() const {return state_?state_->lastSerial:0;}
+uint64_t Effect::ImageAllocations() const {return state_?state_->allocations:0;}
+const char* Effect::Error() const {return state_?state_->error:"not initialized";}
+
+#ifndef HD_AO_STANDALONE
+namespace {
+Effect effect;
+Settings config;
+const WXL_VkRenderApi* renderApi=nullptr;
+void* registration=nullptr;
+CVar *enabled=nullptr,*radius=nullptr,*strength=nullptr,*debug=nullptr,*half=nullptr,*normals=nullptr,*info=nullptr,*quality=nullptr,*temporal=nullptr;
+bool gbRequested=false;
+const char* lastInfo="";
+CVar* Var(const char* name,const char* help,const char* value,uint32_t flags=1) {
+    if(auto* existing=CVar::LookupRegistered(name)) return existing;
+    return CVar::Register(name,help,flags,value,nullptr,CATEGORY_GRAPHICS,false,nullptr,false);
+}
+void Info(const char* value) {
+    if(info && std::strcmp(lastInfo,value)) {info->Set(value,true,false,false,false);lastInfo=value;}
+}
+int __cdecl Wanted(void*) {return config.enabled?1:0;}
+void __cdecl Stage(void*,const WXL_VkStageContext* ctx) {if(ctx) Record(*ctx);}
+}
+bool Init() {
+    if(registration) return true;
+    enabled=Var("hdAO","HD: ambient occlusion, 0 off / 1 on","0");
+    radius=Var("hdAORadius","HD: AO radius in yards (0.25..6)","1");
+    strength=Var("hdAOStrength","HD: AO strength (0..3)","0.85");
+    debug=Var("hdAODebug","HD: 1 shows AO alone","0",0);
+    half=Var("hdAOHalfRes","HD: GTAO: 0 full resolution / 1 bilateral half resolution","0");
+    normals=Var("hdAONormals","HD: 0 depth normals (reference) / 1 valid wxl G-buffer normals","0");
+    quality=Var("hdAOQuality","HD: XeGTAO 0 low / 1 medium / 2 high / 3 ultra","1");
+    temporal=Var("hdAOTemporal","HD: GTAO 1 accumulates over frames (removes the grain) / 0 single frame","1");
+    info=Var("hdAOInfo","HD: ambient occlusion status","off",0);
+    renderApi=wxl::ScriptMgr::GetInterface<const WXL_VkRenderApi>(WXL_VK_RENDER_API_NAME,WXL_VK_RENDER_API_VERSION);
+    if(!renderApi || renderApi->structSize<offsetof(WXL_VkRenderApi,UnregisterStage)+sizeof(renderApi->UnregisterStage) ||
+        !renderApi->RegisterStage || !renderApi->UnregisterStage || !effect.Init(renderApi)) {Info("AO Vulkan: Init failed");return false;}
+    WXL_VkStageDesc desc{};desc.structSize=sizeof desc;desc.point=WXL_VK_POINT_AFTER_OPAQUE_WORLD;desc.order=100;
+    desc.flags=WXL_VK_STAGE_NEEDS_DEPTH|WXL_VK_STAGE_WRITES_COLOR;desc.Wanted=Wanted;desc.Run=Stage;
+    registration=renderApi->RegisterStage(&desc,"HD.AO");
+    if(!registration) {effect.Shutdown(0);Info("AO Vulkan: stage registration failed");return false;}
+    Info("off");return true;
+}
+void Resize() {
+    if(!registration) return;
+    config.enabled=enabled && enabled->m_intValue!=0;
+    config.radius=radius?radius->m_floatValue:1;config.strength=strength?strength->m_floatValue:.85f;
+    config.quality=quality?uint32_t(std::clamp(quality->m_intValue,0,3)):1;
+    config.temporal=!temporal || temporal->m_intValue!=0;
+    config.debug=debug && debug->m_intValue!=0;config.halfResolution=half && half->m_intValue!=0;
+    config.useGBufferNormals=normals && normals->m_intValue!=0;
+    bool want=config.enabled && config.useGBufferNormals;
+    bool gbApi=renderApi->structSize>=offsetof(WXL_VkRenderApi,RequestGBuffer)+sizeof(renderApi->RequestGBuffer) && renderApi->RequestGBuffer;
+    if(gbApi && want!=gbRequested) {renderApi->RequestGBuffer(want?1:0);gbRequested=want;}
+    if(!config.enabled) {Info("off");return;}
+    VkFormat format{};VkExtent2D extent{};
+    if(!wxlvk::native::present::BackBufferInfo(format,extent) || !effect.Resize(extent.width,extent.height,config.halfResolution))
+        Info("AO Vulkan: Resize failed; frame skipped");
+}
+void Record(const WXL_VkStageContext& ctx) {
+    if(!effect.Record(ctx,config)) {Info(effect.Error());return;}
+    static const char* const names[2][2][2]={{{"Vulkan XeGTAO: full resolution","Vulkan XeGTAO: full resolution, temporal"},
+        {"Vulkan XeGTAO: bilateral half resolution","Vulkan XeGTAO: bilateral half resolution, temporal"}},
+        {{"Vulkan XeGTAO: debug","Vulkan XeGTAO: debug, temporal"},{"Vulkan XeGTAO: debug, half resolution","Vulkan XeGTAO: debug, half resolution, temporal"}}};
+    Info(names[config.debug][config.halfResolution][config.temporal]);
+}
+void SetSubpixelOffset(float x,float y) {config.extraJitterX=x;config.extraJitterY=y;}
+bool Shutdown() {
+    if(!renderApi && !registration) return true;
+    if(registration) {renderApi->UnregisterStage(registration);registration=nullptr;}
+    if(gbRequested && renderApi && renderApi->RequestGBuffer) {renderApi->RequestGBuffer(0);gbRequested=false;}
+    // Engine-owner shutdown only: ask the backend to finish its own submitted serial, not vkQueueWaitIdle.
+    // An open frame must be submitted by the backend first; this path never runs inside Record/Resize.
+    if(effect.LastUsed()>wxlvk::native::present::Completed()) {
+        if(wxlvk::native::present::FrameOpen() && !wxlvk::native::present::FlushAndWait()) return false;
+        if(!wxlvk::native::present::WaitSerial(effect.LastUsed())) return false;
+    }
+    bool okay=effect.Shutdown(wxlvk::native::present::Completed());
+    if(okay) {renderApi=nullptr;config.enabled=false;Info("off");}
+    return okay;
+}
+#endif
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanAO.h b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanAO.h
