+namespace
+{
+    using namespace wxlvk::vk::manifest;
+
+    /// The most records the table holds. The client's archives hold 1578 byte-distinct records across
+    /// every archive; 2048 leaves room for custom patch archives and a re-run that splits a container.
+    /// HD: 4096, for the HD materials' own records beside them (tools/bls_tools/hd_blobs.py, ~800).
+    constexpr uint32_t kMaxRecords = 4096;
+
+    /// The most name entries. 3105 names in the archives (every Name:perm plus the bare Name of each
+    /// record 0), many folded onto shared records; 4096 is the bound. HD: 8192, with the HD records' names.
+    constexpr uint32_t kMaxNames = 8192;
+
+    /// The manifest's place, relative to the DLL (src/common/ModulePath.hpp).
+    constexpr const char* kManifestRelative = "shaders\\translated\\manifest.txt";
+
+    constexpr uint16_t kNoName = 0xFFFF;
+
+    /// The contract's semantic spellings, indexed by Semantic.
+    constexpr const char* kSemanticNames[kSemanticCount] = {
+        "position0", "normal0", "color0", "color1",
+        "texcoord0", "texcoord1", "texcoord2", "texcoord3",
+        "texcoord4", "texcoord5", "texcoord6", "texcoord7",
+        "blendweight0", "blendindices0", "fog0", "psize0",
+    };
+
+    struct State
+    {
+        Record   records[kMaxRecords] = {};
+        uint32_t recordCount          = 0;
+        Name     names[kMaxNames]     = {};
+        uint32_t nameCount            = 0;
+        Stats    stats                = {};
+        bool     attempted            = false;
+        bool     loaded               = false;
+    };
+    State s;
+
+    /**
+     * Reads a whole file. Plain CRT I/O, once per session; the file is tens of kilobytes.
+     *
+     * @param string path : the file
+     * @param string& out : receives the bytes
+     * @return bool ok : false when the file could not be opened or read
+     */
+    bool ReadWhole(const std::string& path, std::string& out)
+    {
+        FILE* f = nullptr;
+        if (fopen_s(&f, path.c_str(), "rb") != 0 || !f) return false;
+
+        bool ok = false;
+        do
+        {
+            if (std::fseek(f, 0, SEEK_END) != 0) break;
+            const long size = std::ftell(f);
+            if (size < 0) break;
+            if (std::fseek(f, 0, SEEK_SET) != 0) break;
+            try
+            {
+                out.resize(static_cast<size_t>(size));
+            }
+            catch (const std::bad_alloc&)
+            {
+                break;
+            }
+            if (size > 0 && std::fread(&out[0], 1, out.size(), f) != out.size()) break;
+            ok = true;
+        } while (false);
+
+        std::fclose(f);
+        return ok;
+    }
+
+    /**
+     * Splits one line into at most `cap` tokens on spaces and tabs, dropping a '#' comment.
+     * The line is modified in place (NULs written at token ends).
+     *
+     * @param char* line : NUL-terminated, writable
+     * @param char** tokens : receives pointers into `line`
+     * @param uint32 cap : capacity of `tokens`
+     * @return uint32 count : tokens found (0 for a blank or comment-only line)
+     */
+    uint32_t Tokenise(char* line, char** tokens, uint32_t cap)
+    {
+        if (char* hash = std::strchr(line, '#')) *hash = '\0';
+
+        uint32_t n = 0;
+        char*    p = line;
+        while (*p && n < cap)
+        {
+            while (*p == ' ' || *p == '\t' || *p == '\r') ++p;
+            if (!*p) break;
+            tokens[n++] = p;
+            while (*p && *p != ' ' && *p != '\t' && *p != '\r') ++p;
+            if (*p) *p++ = '\0';
+        }
+        return n;
+    }
+
+    /**
+     * A semantic token's bit position.
+     *
+     * @param string token : e.g. "texcoord3"
+     * @param uint32& out : receives the Semantic value
+     * @return bool ok : false for a spelling outside the contract
+     */
+    bool ParseSemantic(const char* token, uint32_t& out)
+    {
+        for (uint32_t i = 0; i < kSemanticCount; ++i)
+        {
+            if (std::strcmp(token, kSemanticNames[i]) == 0)
+            {
+                out = i;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Copies a bounded string, always terminating; refuses one that would not fit rather than
+     * truncating, because a truncated md5 or path names a different file.
+     */
+    template <size_t N>
+    bool CopyBounded(char (&dst)[N], const char* src)
+    {
+        const size_t len = std::strlen(src);
+        if (len + 1 > N) return false;
+        std::memcpy(dst, src, len + 1);
+        return true;
+    }
+
+    /**
+     * Whether a token is 32 lowercase hex characters -- the one spelling ByMd5() will be asked
+     * with, so a manifest that spells a hash in uppercase is normalised here rather than missed.
+     */
+    bool NormaliseMd5(char* token)
+    {
+        if (std::strlen(token) != 32) return false;
+        for (char* p = token; *p; ++p)
+        {
+            if (*p >= 'A' && *p <= 'F') *p = static_cast<char>(*p - 'A' + 'a');
+            const bool hex = (*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f');
+            if (!hex) return false;
+        }
+        return true;
+    }
+
+    /**
+     * One `record` line into a fresh Record.
+     *
+     * @param char** t : the tokens, t[0] == "record"
+     * @param uint32 n : how many
+     * @param Record& r : receives the fields; untouched on failure
+     * @return bool ok
+     */
+    bool ParseRecord(char** t, uint32_t n, Record& r)
+    {
+        if (n < 7) return false;
+
+        Record out = {};
+        out.firstName = kNoName;
+        out.companion = kNoRecord;
+
+        if (!NormaliseMd5(t[1]) || !CopyBounded(out.md5, t[1])) return false;
+
+        if (std::strcmp(t[2], "vertex") == 0)     out.kind = Kind::Vertex;
+        else if (std::strcmp(t[2], "pixel") == 0) out.kind = Kind::Pixel;
+        else return false;
+
+        // `ff` is a pixel record by construction (the generated fixed-function pixel stage); an
+        // ff vertex record is a contradiction and is refused like any other bad profile.
+        if (std::strcmp(t[3], "vs_3_0") == 0)      out.profile = Profile::Vs30;
+        else if (std::strcmp(t[3], "ps_3_0") == 0) out.profile = Profile::Ps30;
+        else if (std::strcmp(t[3], "vs_2_0") == 0) out.profile = Profile::Vs20;
+        else if (std::strcmp(t[3], "ps_2_0") == 0) out.profile = Profile::Ps20;
+        else if (std::strcmp(t[3], "ff") == 0 && out.kind == Kind::Pixel) out.profile = Profile::Ff;
+        else return false;
+
+        if (!CopyBounded(out.spv, t[4])) return false;
+
+        // vconst= and pconst= may come in either order; both are required.
+        bool haveV = false, haveP = false;
+        for (uint32_t i = 5; i < n; ++i)
+        {
+            if (std::strncmp(t[i], "vconst=", 7) == 0)
+            {
+                const long v = std::strtol(t[i] + 7, nullptr, 10);
+                if (v != 64 && v != 256) return false;
+                out.vconst = static_cast<uint16_t>(v);
+                haveV      = true;
+            }
+            else if (std::strncmp(t[i], "pconst=", 7) == 0)
+            {
+                const long p = std::strtol(t[i] + 7, nullptr, 10);
+                if (p <= 0 || p > 16) return false;
+                out.pconst = static_cast<uint16_t>(p);
+                haveP      = true;
+            }
+        }
+        if (!haveV || !haveP) return false;
+
+        r = out;
+        return true;
+    }
+
+    /**
+     * One attribute line (name / sampler / input / output / reads / flag) applied to the current
+     * record.
+     *
+     * @param char** t : the tokens
+     * @param uint32 n : how many
+     * @param Record& r : the record the line belongs to
+     * @param uint32 recordIndex : its index, for the name table
+     * @return bool ok : false for a line that did not parse (the record keeps what it had)
+     */
+    bool ParseAttribute(char** t, uint32_t n, Record& r, uint32_t recordIndex)
+    {
+        if (std::strcmp(t[0], "name") == 0)
+        {
+            if (n != 2) return false;
+            if (s.nameCount >= kMaxNames)
+            {
+                ++s.stats.truncated;
+                return true; // not a parse failure: the table is full
+            }
+            Name& e = s.names[s.nameCount];
+            if (!CopyBounded(e.name, t[1])) return false;
+            e.record = static_cast<uint16_t>(recordIndex);
+            e.hash   = HashName(e.name);
+            if (r.firstName == kNoName) r.firstName = static_cast<uint16_t>(s.nameCount);
+            ++r.nameCount;
+            ++s.nameCount;
+            ++s.stats.names;
+            return true;
+        }
+        if (std::strcmp(t[0], "sampler") == 0)
+        {
+            if (n != 3) return false;
+            char*      end  = nullptr;
+            const long slot = std::strtol(t[1], &end, 10);
+            if (!end || *end || slot < 0 || slot > 15) return false;
+            const bool cube = std::strcmp(t[2], "cube") == 0;
+            if (!cube && std::strcmp(t[2], "2d") != 0) return false;
+            r.samplerMask |= static_cast<uint16_t>(1u << slot);
+            if (cube) r.cubeMask |= static_cast<uint16_t>(1u << slot);
+            return true;
+        }
+        if (std::strcmp(t[0], "input") == 0)
+        {
+            // The register token (vN) is informative only: the location is fixed by semantic.
+            if (n != 3) return false;
+            uint32_t sem = 0;
+            if (!ParseSemantic(t[1], sem)) return false;
+            r.inputMask |= 1u << sem;
+            return true;
+        }
+        if (std::strcmp(t[0], "output") == 0 || std::strcmp(t[0], "reads") == 0)
+        {
+            if (n != 2) return false;
+            uint32_t sem = 0;
+            if (!ParseSemantic(t[1], sem)) return false;
+            if (t[0][0] == 'o') r.outputMask |= 1u << sem;
+            else                r.readsMask  |= 1u << sem;
+            return true;
+        }
+        if (std::strcmp(t[0], "flag") == 0)
+        {
+            // Any flag on any record: a flag the stage does not use on that kind is kept, not
+            // refused, so a future emitter run that moves one does not skip the line.
+            if (n != 2) return false;
+            if (std::strcmp(t[1], "fixed_fog") == 0)         r.fixedFog = true;
+            else if (std::strcmp(t[1], "point_size") == 0)   r.pointSize = true;
+            else if (std::strcmp(t[1], "point_sprite") == 0) r.pointSprite = true;
+            else return false;
+            return true;
+        }
+        if (std::strcmp(t[0], "companion") == 0)
+        {
+            // Kept as the md5 for now: the companion blocks come after the vertex rows that name
+            // them (the shipped file puts them last), so the index is resolved once the whole
+            // file has been read (LinkCompanions). Only a vertex row can have one.
+            if (n != 2 || r.kind != Kind::Vertex) return false;
+            if (!NormaliseMd5(t[1]) || !CopyBounded(r.companionMd5, t[1])) return false;
+            return true;
+        }
+        if (std::strcmp(t[0], "bones") == 0)
+        {
+            // Only a 256-row vertex row has one: the variant is that module on the 64-row block.
+            if (n != 2 || r.kind != Kind::Vertex || r.vconst != 256) return false;
+            if (!CopyBounded(r.bones, t[1])) return false;
+            ++s.stats.bones;
+            return true;
+        }
+        if (std::strcmp(t[0], "wind") == 0)
+        {
+            // A vertex record's (the bend) or an M2 pixel record's (the leaves' shimmer and light).
+            if (n != 2) return false;
+            if (!CopyBounded(r.wind, t[1])) return false;
+            ++s.stats.wind;
+            return true;
+        }
+        if (std::strcmp(t[0], "shadowwind") == 0 || std::strcmp(t[0], "shadowwindbones") == 0)
+        {
+            // The tree-wind variants' shadow variants (shadowgen.py). The attribute lines are sorted,
+            // so these come BEFORE their `wind` / `windbones` lines: the flag is set here and checked
+            // against the wind variant once the whole file is read (DropOrphanShadowWind).
+            if (n != 2 || r.kind != Kind::Vertex) return false;
+            if (t[0][10] == '\0') r.shadowWind = true;
+            else                  r.shadowWindBones = true;
+            return true;
+        }
+        if (std::strcmp(t[0], "shadow") == 0 || std::strcmp(t[0], "shadowbones") == 0)
+        {
+            // The draw replay's variants: names that follow from the module's own (shadowgen.py).
+            if (n != 2 || r.kind != Kind::Vertex) return false;
+            if (t[0][6] == '\0')
+            {
+                r.shadow = true;
+                ++s.stats.shadow;
+            }
+            else
+            {
+                if (r.bones[0] == '\0') return false;
+                r.shadowBones = true;
+            }
+            return true;
+        }
+        if (std::strncmp(t[0], "gbuf", 4) == 0)
+        {
+            // The G-buffer variants (tools/gbuffer): names that follow from the module's own, like the
+            // shadow ones. A vertex record's four, a pixel record's `gbuf` and `gbufwind`. The line may
+            // precede the `bones` / `wind` one it derives from: checked once the file is read (DropOrphanGBuf).
+            if (n != 2) return false;
+            const char* v = t[0] + 4;
+            if (*v == '\0')
+            {
+                r.gbuf = true;
+                ++s.stats.gbuf;
+            }
+            else if (std::strcmp(v, "bones") == 0)
+            {
+                if (r.kind != Kind::Vertex) return false;
+                r.gbufBones = true;
+            }
+            else if (std::strcmp(v, "wind") == 0)
+                r.gbufWind = true;
+            else if (std::strcmp(v, "windbones") == 0)
+            {
+                if (r.kind != Kind::Vertex) return false;
+                r.gbufWindBones = true;
+            }
+            else
+                return false;
+            return true;
+        }
+        if (std::strcmp(t[0], "windbones") == 0)
+        {
+            if (n != 2 || r.kind != Kind::Vertex || r.vconst != 256) return false;
+            if (!CopyBounded(r.windBones, t[1])) return false;
+            return true;
+        }
+        return false;
+    }
+
+    /**
+     * Clears a `shadowwind` / `shadowwindbones` flag whose record has no `wind` / `windbones`
+     * variant to derive it from, after the whole file is in the table (the lines come in sorted
+     * order, the shadow ones first).
+     */
+    void DropOrphanShadowWind()
+    {
+        for (uint32_t i = 0; i < s.recordCount; ++i)
+        {
+            Record& r = s.records[i];
+            if (r.wind[0] == '\0')      r.shadowWind      = false;
+            if (r.windBones[0] == '\0') r.shadowWindBones = false;
+        }
+    }
+
+    /// Clears a G-buffer flag whose record has no variant to derive it from (a `gbufbones` without
+    /// `bones`, a `gbufwind` without `wind`, a `gbufwindbones` without `windbones`).
+    void DropOrphanGBuf()
+    {
+        for (uint32_t i = 0; i < s.recordCount; ++i)
+        {
+            Record& r = s.records[i];
+            if (r.bones[0] == '\0')     r.gbufBones     = false;
+            if (r.wind[0] == '\0')      r.gbufWind      = false;
+            if (r.windBones[0] == '\0') r.gbufWindBones = false;
+        }
+    }
+
+    /**
+     * Resolves every `companion` md5 to a record index, after the whole file is in the table.
+     * A md5 that names no record, or names one that is not an `ff` pixel record, leaves the
+     * row without a companion (kNoRecord) and is counted and logged: such a vertex row's
+     * `ps == ""` draws are then skipped and named by the pipeline side.
+     */
+    void LinkCompanions()
+    {
+        for (uint32_t i = 0; i < s.recordCount; ++i)
+        {
+            Record& r = s.records[i];
+            r.companion = kNoRecord;
+            if (r.kind != Kind::Vertex || r.companionMd5[0] == '\0') continue;
+
+            for (uint32_t j = 0; j < s.recordCount; ++j)
+            {
+                const Record& c = s.records[j];
+                if (c.kind == Kind::Pixel && c.profile == Profile::Ff
+                    && std::memcmp(c.md5, r.companionMd5, 32) == 0)
+                {
+                    r.companion = static_cast<uint16_t>(j);
+                    break;
+                }
+            }
+            if (r.companion == kNoRecord)
+            {
+                ++s.stats.companionsUnresolved;
+                wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                    "vulkan: manifest: vertex record %s (%s) names companion %s, "
+                                    "which is not an ff pixel record in this file; its draws with "
+                                    "no pixel shader stay unsupported",
+                                    r.md5, FirstName(r), r.companionMd5);
+            }
+            else
+                ++s.stats.companions;
+        }
+    }
+}
+
+namespace wxlvk::vk::manifest
+{
+    uint32_t HashName(const char* str)
+    {
+        uint32_t h = 2166136261u;
+        for (const char* p = str; *p; ++p) h = (h ^ static_cast<uint8_t>(*p)) * 16777619u;
+        return h;
+    }
+
+    bool Load()
+    {
+        if (s.attempted) return s.loaded;
+        s.attempted = true;
+
+        const std::string path = wxlvk::path::Resolve(kManifestRelative);
+        std::string       text;
+        if (!ReadWhole(path, text))
+        {
+            // A deployment without the translator's output: only the hand-written rows can draw.
+            wxl::ScriptMgr::Log(WXL_LOG_WARN,
+                                "vulkan: manifest: no manifest at \"%s\"; no translated module "
+                                "will be used, only the hand-written pipelines draw",
+                                path.c_str());
+            return false;
+        }
+
+        // Line by line, in place. A `record` line opens a record; every other line applies to the
+        // record most recently opened. Blank lines are the contract's block separators and carry
+        // no meaning here, so a manifest without them parses the same.
+        Record*  current      = nullptr;
+        uint32_t currentIndex = 0;
+        bool     dropping     = false; // the current record did not fit: skip its attributes
+        uint32_t lineNo       = 0;
+
+        size_t pos = 0;
+        while (pos < text.size())
+        {
+            size_t end = text.find('\n', pos);
+            if (end == std::string::npos) end = text.size();
+            std::string line = text.substr(pos, end - pos);
+            pos = end + 1;
+            ++lineNo;
+
+            char* tokens[16];
+            const uint32_t n = Tokenise(&line[0], tokens, 16);
+            if (n == 0) continue;
+
+            if (std::strcmp(tokens[0], "record") == 0)
+            {
+                dropping = false;
+                current  = nullptr;
+                if (s.recordCount >= kMaxRecords)
+                {
+                    ++s.stats.truncated;
+                    dropping = true;
+                    continue;
+                }
+                Record r = {};
+                if (!ParseRecord(tokens, n, r))
+                {
+                    ++s.stats.skipped;
+                    dropping = true;
+                    continue;
+                }
+                currentIndex              = s.recordCount;
+                s.records[s.recordCount++] = r;
+                current                   = &s.records[currentIndex];
+                ++s.stats.records;
+                if (r.kind == Kind::Vertex) ++s.stats.vertex;
+                else                        ++s.stats.pixel;
+                if (r.profile == Profile::Ff) ++s.stats.ff;
+                continue;
+            }
+
+            if (dropping) continue;
+            if (!current)
+            {
+                ++s.stats.skipped; // an attribute before any record
+                continue;
+            }
+            if (!ParseAttribute(tokens, n, *current, currentIndex))
+            {
+                ++s.stats.skipped;
+                if (s.stats.skipped <= 8)
+                    wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: manifest: line %u did not parse: \"%s\"",
+                                        lineNo, tokens[0]);
+            }
+        }
+
+        // The companion links and the shadow-wind check, once every record is in the table.
+        LinkCompanions();
+        DropOrphanShadowWind();
+        DropOrphanGBuf();
+
+        s.loaded = s.recordCount > 0;
+
+        wxl::ScriptMgr::Log(s.loaded ? WXL_LOG_DEBUG : WXL_LOG_WARN,
+                            "vulkan: manifest: \"%s\": %u record(s) (%u vertex, %u pixel, of which "
+                            "%u generated ff), %u companion(s) linked (%u unresolved), %u bone-palette "
+                            "variant(s), %u name(s), %u line(s) skipped, %u entr%s truncated (tables of "
+                            "%u records and %u names)",
+                            path.c_str(), s.stats.records, s.stats.vertex, s.stats.pixel, s.stats.ff,
+                            s.stats.companions, s.stats.companionsUnresolved, s.stats.bones, s.stats.names,
+                            s.stats.skipped, s.stats.truncated,
+                            s.stats.truncated == 1 ? "y" : "ies", kMaxRecords, kMaxNames);
+        if (s.stats.gbuf)
+            wxl::ScriptMgr::Log(WXL_LOG_DEBUG, "vulkan: manifest: %u record(s) carry G-buffer variants (tools/gbuffer)",
+                                s.stats.gbuf);
+        return s.loaded;
+    }
+
+    const Record* Companion(const Record& r)
+    {
+        if (!s.loaded || r.kind != Kind::Vertex || r.companion == kNoRecord) return nullptr;
+        if (r.companion >= s.recordCount) return nullptr;
+        return &s.records[r.companion];
+    }
+
+    const Record* FfStage(bool pointSprite)
+    {
+        if (!s.loaded) return nullptr;
+        for (uint32_t i = 0; i < s.recordCount; ++i)
+        {
+            const Record& r = s.records[i];
+            if (r.kind == Kind::Pixel && r.profile == Profile::Ff && r.pointSprite == pointSprite) return &r;
+        }
+        return nullptr;
+    }
+
+    bool Loaded() { return s.loaded; }
+
+    const Record* ByMd5(const char* md5)
+    {
+        if (!s.loaded || !md5) return nullptr;
+        for (uint32_t i = 0; i < s.recordCount; ++i)
+            if (std::memcmp(s.records[i].md5, md5, 32) == 0) return &s.records[i];
+        return nullptr;
+    }
+
+    const Record* ByName(const char* name, Kind kind)
+    {
+        if (!s.loaded || !name || !*name) return nullptr;
+        const uint32_t h = HashName(name);
+        for (uint32_t i = 0; i < s.nameCount; ++i)
+        {
+            const Name& e = s.names[i];
+            if (e.hash != h || std::strcmp(e.name, name) != 0) continue;
+            const Record& r = s.records[e.record];
+            if (r.kind == kind) return &r;
+        }
+        return nullptr;
+    }
+
+    const char* FirstName(const Record& r)
+    {
+        if (r.firstName == kNoName || r.firstName >= s.nameCount) return r.md5;
+        return s.names[r.firstName].name;
+    }
+
+    const char* SemanticName(uint32_t semantic)
+    {
+        return semantic < kSemanticCount ? kSemanticNames[semantic] : "?";
+    }
+
+    void GetStats(Stats& out) { out = s.stats; }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Manifest.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Manifest.hpp
new file mode 100644
index 00000000..184de6bd
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Manifest.hpp
@@ -0,0 +1,278 @@
+// The translated-module manifest: what the offline DX9 -> SPIR-V emitter produced, as fixed tables.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+#pragma once
+
+#include <cstdint>
+
+// The client's DX9 shader bytecode is translated offline (tools/bls_tools/translate.py) into one
+// SPIR-V module per byte-distinct record, and the DLL finds those modules through a manifest keyed by
+// the MD5 of the record's bytes (docs/architecture.md, "Shaders"). This file is the DLL's side of
+// that contract: it reads shaders/translated/manifest.txt next to the DLL once, into fixed tables,
+// and answers two questions -- "which record has this hash?" (asked once per slot-72 create, by
+// src/shaders/Translated.cpp) and "which record carries this name?" (the fallback when no create was
+// ever seen for a name).
+//
+// The manifest's text format, verbatim from the contract with the emitter: blocks separated by a
+// blank line, lines of space-separated tokens, '#' to end of line is a comment.
+//
+//   record <md5> <vertex|pixel> <vs_3_0|ps_3_0|vs_2_0|ps_2_0|ff> <spv path, forward slashes> vconst=<64|256> pconst=16
+//   name <Name:perm>               repeatable; also the bare <Name> for record 0 of a container
+//   sampler <slot 0..15> <2d|cube> pixel only, repeatable
+//   input <semantic> <vN>          vertex only, repeatable
+//   output <semantic>              vertex only, repeatable
+//   reads <semantic>               pixel only, repeatable
+//   flag <fixed_fog|point_size|point_sprite>  optional
+//   companion <md5>                vertex only: the `ff` pixel record to bind when the draw's
+//                                  pixel shader name is ""
+//   bones <spv path>               vertex only, vconst=256: the bone-palette variant of the module,
+//                                  reading every constant past c63 from set 2 binding 0 (a storage
+//                                  buffer, b[i] = c(31 + i)) and declaring the 64-row uniform block
+//   wind <spv path>                vertex only: the tree-wind variant, the position bent in model
+//                                  space right before the module's own transform (set 3;
+//                                  src/vulkan/Wind.hpp)
+//   shadow <spv path>              vertex only: the draw replay's variant (shadowgen.py), the clip
+//                                  position re-projected by a push-range matrix: <spv>.shadow.spv
+//   shadowbones <spv path>         vertex only, with `bones`: the same of the bone-palette variant
+//   shadowwind <spv path>          vertex only, with `wind`: the tree-wind variant's, <wind>.shadow.spv,
+//                                  its matrix after the wind's push values (offset 16)
+//   shadowwindbones <spv path>     vertex only, with `windbones`: the same of that variant
+//   windbones <spv path>           vertex only, with `bones`: the same of the bone-palette variant
+//                                  (a pixel record's `wind` is its leaves' half: bound only with a
+//                                  vertex `wind` variant, which writes the varying it reads)
+//   gbuf <spv path>                the G-buffer variant (tools/gbuffer): a vertex record's, with the
+//                                  view normal and the light term as extra varyings, or a pixel
+//                                  record's, writing the albedo, normal and light attachments beside
+//                                  the colour: <spv>.gbuf.spv
+//   gbufbones / gbufwind / gbufwindbones <spv path>   vertex only: the same of its `bones` / `wind` /
+//                                  `windbones` variant; a pixel record's `gbufwind` is the same of its
+//                                  `wind` half
+//
+// Profile `ff` is a pixel record the emitter GENERATED rather than
+// translated: the fixed-function pixel cascade, in the translated varying interface, for the
+// vs_2_0 weather records the engine draws with no pixel shader at all. It has no bytecode (its
+// md5 is of its GLSL text) and so is never matched at a create; the vertex record's `companion`
+// line is the only way to reach it. Its names are "<vertex name>@ff", never an engine name. The
+// flags: `fixed_fog` on a vertex row says it writes fog0 as D3D's oFog, on an ff row that it
+// blends toward p[15].rgb while p[15].w > 0; `point_size` on a vertex row says it writes
+// gl_PointSize and the draw is a point list; `point_sprite` on an ff row that it samples stage
+// 0 at gl_PointCoord and reads no texcoord. The companion blocks come after the vertex rows
+// that name them, so the link is resolved once the whole file is read.
+//
+// Semantics: position0 normal0 color0 color1 texcoord0..texcoord7 blendweight0 blendindices0 fog0
+// psize0. They are kept as bit masks, because every consumer asks set questions of them: the
+// pipeline builder declares the vertex attributes a module's inputs name and checks the pixel
+// module's reads against the vertex module's outputs.
+//
+// No Vulkan, no engine, no device: this is a parser over a text file and can run at extension
+// load, before any of those exist. Fixed tables rather than vectors, as everywhere in src/vulkan/,
+// because address space is the scarce resource in this 32-bit process; the bounds are generous
+// against the client's archives (1578 records, ~2700 names) and a manifest that exceeds them is truncated
+// with a warning rather than refused.
+namespace wxlvk::vk::manifest
+{
+    /// The semantics the contract names, as bit positions. The order is the contract's.
+    enum Semantic : uint32_t
+    {
+        kPosition0     = 0,
+        kNormal0       = 1,
+        kColor0        = 2,
+        kColor1        = 3,
+        kTexcoord0     = 4,  ///< texcoord0..texcoord7 are 4..11
+        kBlendWeight0  = 12,
+        kBlendIndices0 = 13,
+        kFog0          = 14,
+        kPsize0        = 15,
+        kSemanticCount = 16,
+    };
+
+    /// Which stage a record is for.
+    enum class Kind : uint8_t
+    {
+        Vertex = 0,
+        Pixel  = 1,
+    };
+
+    /// The DX9 profile the record was decoded from -- or Ff, the generated fixed-function pixel
+    /// stage that decodes from nothing.
+    enum class Profile : uint8_t
+    {
+        Vs30, Ps30, Vs20, Ps20, Ff,
+    };
+
+    /// "No record": the value of Record::companion on every row without a `companion` line.
+    constexpr uint16_t kNoRecord = 0xFFFF;
+
+    /// The longest `name` token kept, NUL included. The longest engine name is
+    /// "Combiners_Opaque_AddAlpha_Alpha:15" (34); draw::Cmd bounds its names the same way.
+    constexpr uint32_t kNameChars = 40;
+
+    /// The longest spv path kept, NUL included: "pixel/" + 32 hex + ".spv" is 42.
+    constexpr uint32_t kPathChars = 128;   ///< "vertex/<32 hex>.bones.wind.spv" is 54; room to spare
+
+    /// One byte-distinct record the emitter translated.
+    struct Record
+    {
+        char     md5[33];          ///< lowercase hex, NUL-terminated
+        char     spv[kPathChars];  ///< relative to shaders/translated/, forward slashes
+        Kind     kind;
+        Profile  profile;
+        uint16_t vconst;           ///< 64 or 256: rows of regs.v[] the vertex module declares
+        uint16_t pconst;           ///< 16: rows of regs.p[]
+        uint16_t samplerMask;      ///< pixel: bit s set for `sampler s ...`
+        uint16_t cubeMask;         ///< pixel: bit s set when that sampler is a cube
+        uint32_t inputMask;        ///< vertex: bit Semantic set for each `input`
+        uint32_t outputMask;       ///< vertex: bit Semantic set for each `output`
+        uint32_t readsMask;        ///< pixel: bit Semantic set for each `reads`
+        bool     fixedFog;         ///< `flag fixed_fog`
+        bool     pointSize;        ///< `flag point_size`: vertex row writes gl_PointSize; the draw is a point list
+        bool     pointSprite;      ///< `flag point_sprite`: ff row samples stage 0 at gl_PointCoord
+        uint16_t firstName;        ///< index of its first name entry, or 0xFFFF
+        uint16_t nameCount;        ///< how many name entries it owns (not necessarily consecutive)
+        uint16_t companion;        ///< vertex: index of its `ff` companion record, or kNoRecord
+        char     companionMd5[33]; ///< vertex: the `companion` line's md5 as written, "" when none
+        char     bones[kPathChars]; ///< vertex: the `bones` variant's spv path, "" when none
+        char     wind[kPathChars];  ///< vertex: the `wind` variant's spv path, "" when none
+        char     windBones[kPathChars]; ///< vertex: the `windbones` variant's (of `bones`), "" when none
+        /// vertex: a `shadow` line (shadowgen.py) -- `spv` with ".shadow.spv" for ".spv" is the draw
+        /// replay's variant; `shadowBones` the same of the `bones` variant. Flags, not paths: the
+        /// names follow from the module's own, and the table is static.
+        bool     shadow;
+        bool     shadowBones;
+        /// vertex: `shadowwind` / `shadowwindbones` -- `wind` / `windBones` with ".shadow.spv" for ".spv".
+        bool     shadowWind;
+        bool     shadowWindBones;
+        /// The G-buffer variants (tools/gbuffer): a vertex record's `gbuf` / `gbufbones` / `gbufwind` /
+        /// `gbufwindbones` (`spv` / `bones` / `wind` / `windBones` with ".gbuf.spv" for ".spv"), a pixel
+        /// record's `gbuf` / `gbufwind` (`spv` / `wind` likewise). Flags: the names follow from the module's own.
+        bool     gbuf;
+        bool     gbufBones;
+        bool     gbufWind;
+        bool     gbufWindBones;
+    };
+
+    /// The bone-palette variant's storage buffer: b[i] is vertex register c(kBoneBase + i), for
+    /// kBoneRows rows (the translator's BONE_BASE / BONE_ROWS).
+    constexpr uint32_t kBoneBase = 31;
+    constexpr uint32_t kBoneRows = 256 - kBoneBase;
+
+    /// One `name` line: an engine name ("Diffuse_T1:11", or the bare "Diffuse_T1") and its record.
+    struct Name
+    {
+        char     name[kNameChars];
+        uint16_t record;
+        uint32_t hash; ///< FNV-1a of `name`, compared before the string
+    };
+
+    /**
+     * Reads shaders/translated/manifest.txt next to the DLL, once. Idempotent: the second call
+     * returns the first's answer without touching the file.
+     *
+     * A missing file is logged as "no manifest" (a warning); with no manifest every lookup below
+     * answers null and only the hand-written pipelines draw. A malformed line is
+     * skipped and counted; the file is never refused whole for one bad line, because a partial
+     * manifest still names the records it does carry.
+     *
+     * @return bool loaded : true when at least one record was read
+     */
+    bool Load();
+
+    /// Whether Load() found a manifest with at least one record.
+    bool Loaded();
+
+    /**
+     * The record with this content hash.
+     *
+     * @param string md5 : 32 lowercase hex characters
+     * @return pointer record : null when unknown or when nothing is loaded
+     */
+    const Record* ByMd5(const char* md5);
+
+    /**
+     * The record carrying this engine name for this stage. Vertex and pixel records can share a
+     * name ("UI" is both), which is why the kind is part of the key.
+     *
+     * @param string name : as CGxShader +0x18 spells it
+     * @param Kind kind : the stage
+     * @return pointer record : null when no name entry matches or nothing is loaded
+     */
+    const Record* ByName(const char* name, Kind kind);
+
+    /**
+     * The `ff` companion a vertex record names: the generated fixed-function pixel stage to
+     * bind when the draw's pixel shader name is "".
+     *
+     * @param Record& r : a vertex record
+     * @return pointer record : its companion, or null when it has none or the md5 named no record
+     */
+    const Record* Companion(const Record& r);
+
+    /**
+     * A generated `ff` pixel stage by kind, for a vertex record with no `companion` line drawn
+     * with no pixel shader: D3D runs the same fixed-function stage 0 after any vertex shader.
+     *
+     * @param bool pointSprite : the point-sprite stage (stage 0 at gl_PointCoord) or the
+     *        texcoord0 one (fixed_fog)
+     * @return pointer record : the first such record, or null when the manifest has none
+     */
+    const Record* FfStage(bool pointSprite);
+
+    /**
+     * A record's first name, for a log line.
+     *
+     * @param Record& r : the record
+     * @return string name : its first `name` token, or its md5 when it has none
+     */
+    const char* FirstName(const Record& r);
+
+    /**
+     * A semantic's spelling in the contract, for a log line.
+     *
+     * @param uint32 semantic : a Semantic value
+     * @return string name : e.g. "texcoord1"; "?" outside the table
+     */
+    const char* SemanticName(uint32_t semantic);
+
+    /**
+     * FNV-1a of a NUL-terminated string, the hash the name table and src/shaders/Translated.cpp's
+     * registry both compare before the string. One definition so the two agree.
+     *
+     * @param string s : the string
+     * @return uint32 hash
+     */
+    uint32_t HashName(const char* s);
+
+    /// Counts, for the Install() line.
+    struct Stats
+    {
+        uint32_t records;    ///< records read
+        uint32_t vertex;     ///< of which vertex
+        uint32_t pixel;      ///< of which pixel (the ff companions among them)
+        uint32_t ff;         ///< of the pixel records, those of profile `ff` (generated companions)
+        uint32_t names;      ///< name entries read
+        uint32_t skipped;    ///< lines that did not parse
+        uint32_t truncated;  ///< records or names dropped because a table was full
+        uint32_t companions; ///< vertex records whose `companion` md5 resolved to an ff record
+        uint32_t companionsUnresolved; ///< `companion` lines whose md5 named no record in the file
+        uint32_t bones;      ///< vertex records with a `bones` variant
+        uint32_t wind;       ///< vertex records with a `wind` variant
+        uint32_t shadow;     ///< vertex records with a `shadow` variant (and `shadowbones`)
+        uint32_t gbuf;       ///< records with a `gbuf` variant (vertex and pixel)
+    };
+
+    /// The counts since Load().
+    void GetStats(Stats& out);
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Memory.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Memory.cpp
new file mode 100644
index 00000000..35977726
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Memory.cpp
@@ -0,0 +1,414 @@
+// Device memory: the memory-type choice, a sub-allocator over a few large blocks, and buffers.
+// Copyright (C) 2026 WarcraftXL
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, either version 3 of the License, or
+// (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+
+#include "vulkan/memory/Internal.hpp"
+
+using namespace wxlvk::vk::memory::detail;
+
+namespace wxlvk::vk::memory
+{
+    bool Init()
+    {
+        if (s.ready) return true;
+
+        const context::Handles* h = context::Get();
+        if (!h || !h->iapi || !h->dapi)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: memory: Init() without a device; declining");
+            return false;
+        }
+        if (!HaveEntryPoints(*h->iapi, *h->dapi)) return false;
+
+        s.device = h->device;
+        s.dapi   = h->dapi;
+
+        h->iapi->GetPhysicalDeviceMemoryProperties(h->physical, &s.props);
+
+        VkPhysicalDeviceProperties props = {};
+        h->iapi->GetPhysicalDeviceProperties(h->physical, &props);
+        // Both are powers of two by spec; the floor of 1 only protects RoundUp() from a zero a
+        // broken driver might report, which would turn every mask into "align to everything".
+        s.granularity    = props.limits.bufferImageGranularity ? props.limits.bufferImageGranularity : 1;
+        s.atom           = props.limits.nonCoherentAtomSize ? props.limits.nonCoherentAtomSize : 1;
+        s.maxAllocations = props.limits.maxMemoryAllocationCount;
+
+        LogTable();
+
+        // Resolved against "any resource" here, for the log and for the decline. Each Allocate()
+        // resolves again against its own memoryTypeBits, because a resource is allowed to exclude
+        // the type that suits most others, and the answer for it may then differ.
+        bool ok = true;
+        const Where wheres[] = { Where::DeviceLocal, Where::HostVisible, Where::Stream };
+        for (Where w : wheres)
+        {
+            const char*    why  = "";
+            const uint32_t type = Resolve(0xFFFFFFFFu, w, why);
+            if (type == kNoType)
+            {
+                wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: memory: %s -> no usable memory type; declining",
+                                    WhereName(w));
+                ok = false;
+                continue;
+            }
+
+            char text[128];
+            const VkMemoryType& t = s.props.memoryTypes[type];
+            const bool fallback   = std::strncmp(why, "FALLBACK", 8) == 0;
+            wxl::ScriptMgr::Log(fallback ? WXL_LOG_WARN : WXL_LOG_DEBUG,
+                                "vulkan: memory: %s -> type %u (heap %u, %llu MiB, %s): %s", WhereName(w), type,
+                                t.heapIndex, MiB(s.props.memoryHeaps[t.heapIndex].size),
+                                PropertyText(t.propertyFlags, text, sizeof text), why);
+        }
+
+        if (!ok)
+        {
+            s.device = nullptr;
+            s.dapi   = nullptr;
+            return false;
+        }
+
+        s.ready = true;
+        return true;
+    }
+
+    bool Allocate(const VkMemoryRequirements& req, Where where, Block& out)
+    {
+        if (!s.ready)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: memory: Allocate() before Init()");
+            return false;
+        }
+        if (req.size == 0)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: memory: Allocate() of zero bytes");
+            return false;
+        }
+
+        const char*    why  = "";
+        const uint32_t type = Resolve(req.memoryTypeBits, where, why);
+        if (type == kNoType)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: memory: no %s type in memoryTypeBits 0x%08X",
+                                WhereName(where), req.memoryTypeBits);
+            return false;
+        }
+
+        // Alignment. req.alignment is the offset the resource must be bound at, and it is not a
+        // suggestion: bind a buffer at a misaligned offset and vkBindBufferMemory is invalid usage
+        // that most drivers accept silently, after which the GPU reads from the rounded-down
+        // address -- a texture shifted by a few texels, a vertex buffer whose first vertices are
+        // the previous resource's tail. Nothing errors; the picture is just wrong.
+        //
+        // bufferImageGranularity. Allocate() is not told whether the caller is binding a buffer or
+        // an image, so the alternative of separate block lists per resource kind is not available
+        // through this API. Instead no two sub-allocations may ever share a granularity page:
+        // every start is aligned to the granularity and every size padded to it. Then a linear
+        // buffer and an optimal-tiling image can never be neighbours within one page, whichever
+        // the caller made. On NVIDIA the granularity is 1 and this costs nothing; where it is
+        // larger (1 KiB to 64 KiB on some adapters) it costs at most one page of slack per
+        // allocation, logged at Init() so the waste is explainable.
+        //
+        // nonCoherentAtomSize is not folded in: FlushHost() rounds its own range to the atom and
+        // clamps to the block, so it needs no help from placement.
+        const VkDeviceSize align  = req.alignment > s.granularity ? req.alignment : s.granularity;
+        const VkDeviceSize padded = RoundUp(req.size, s.granularity);
+
+        uint32_t     slot   = kMaxSlots;
+        VkDeviceSize offset = 0;
+
+        if (padded > BlockSize(where))
+        {
+            // Bigger than a block: its own VkDeviceMemory, sized to the request rather than rounded
+            // to a block multiple, because the slack of a dedicated block is never reused.
+            slot = NewSlot(type, where, padded, true);
+            if (slot == kMaxSlots) return false;
+            if (!Carve(s.slots[slot], padded, align, offset))
+            {
+                DropSlot(*s.dapi, slot);
+                return false;
+            }
+        }
+        else
+        {
+            for (uint32_t i = 0; i < kMaxSlots; ++i)
+            {
+                Slot& candidate = s.slots[i];
+                if (candidate.memory == VK_NULL_HANDLE || candidate.dedicated) continue;
+                if (candidate.where != where || candidate.typeIndex != type) continue;
+                if (candidate.capacity - candidate.inUse < padded) continue;
+                if (Carve(candidate, padded, align, offset))
+                {
+                    slot = i;
+                    break;
+                }
+            }
+
+            if (slot == kMaxSlots)
+            {
+                slot = NewSlot(type, where, BlockSize(where), false);
+                if (slot == kMaxSlots) return false;
+                if (!Carve(s.slots[slot], padded, align, offset))
+                {
+                    // Unreachable for a fresh block -- padded <= capacity and offset 0 is aligned to
+                    // anything -- but cheap to keep honest.
+                    DropSlot(*s.dapi, slot);
+                    return false;
+                }
+            }
+        }
+
+        const Slot& owner = s.slots[slot];
+        out.memory = owner.memory;
+        out.offset = offset;
+        out.size   = req.size;
+        out.mapped = owner.base ? static_cast<char*>(owner.base) + static_cast<size_t>(offset) : nullptr;
+        out.owner  = slot;
+        out.index  = s.generation[slot];
+        return true;
+    }
+
+    void Free(const Block& block)
+    {
+        if (block.memory == VK_NULL_HANDLE || block.size == 0) return;
+        if (!s.ready || block.owner >= kMaxSlots) return;
+
+        Slot& slot = s.slots[block.owner];
+        if (slot.memory != block.memory || s.generation[block.owner] != block.index)
+        {
+            // A block from a dedicated slot since released and reused.
+            // Returning its span would hand someone else's live bytes to the next Allocate().
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: memory: Free() of a stale block ignored");
+            return;
+        }
+
+        // The same padding Allocate() applied; see the bufferImageGranularity comment there.
+        Release(slot, block.offset, RoundUp(block.size, s.granularity));
+
+        // A dedicated block is released as soon as it empties: its size was the one resource's, so
+        // it is unlikely to be reused, and holding it -- mapped, if host-visible -- would keep its
+        // address space for nothing. An ordinary block that empties waits for Tick().
+        if (slot.dedicated && slot.inUse == 0)
+        {
+            DropSlot(*s.dapi, block.owner);
+            ++s.dedicatedFreed;
+        }
+    }
+
+    void Tick()
+    {
+        if (!s.ready) return;
+        ++s.tick;
+        // A block that has stayed empty for kReturnAfterTicks presents goes back to the driver,
+        // except the kSpareBlocks lowest-indexed empty ones per (type, class): the reserved figure
+        // follows what is in use, a host-visible block's address space comes back, and a class
+        // that refills at once still finds a block. A dedicated block never waits here (Free()
+        // releases it the moment it empties).
+        for (uint32_t i = 0; i < kMaxSlots; ++i)
+        {
+            const Slot& slot = s.slots[i];
+            if (slot.memory == VK_NULL_HANDLE || slot.dedicated || slot.inUse != 0) continue;
+            if (s.tick - slot.emptySince < kReturnAfterTicks) continue;
+
+            uint32_t sparesBefore = 0;
+            for (uint32_t k = 0; k < i; ++k)
+            {
+                const Slot& o = s.slots[k];
+                if (o.memory != VK_NULL_HANDLE && !o.dedicated && o.inUse == 0 && o.typeIndex == slot.typeIndex
+                    && o.where == slot.where)
+                    ++sparesBefore;
+            }
+            if (sparesBefore < kSpareBlocks) continue;
+
+            const VkDeviceSize bytes = slot.capacity;
+            DropSlot(*s.dapi, i);
+            ++s.returnedBlocks;
+            s.returnedBytes += bytes;
+        }
+    }
+
+    bool CreateBuffer(VkDeviceSize size, VkBufferUsageFlags usage, Where where, Buffer& out)
+    {
+        if (!s.ready)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: memory: CreateBuffer() before Init()");
+            return false;
+        }
+        if (size == 0)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: memory: CreateBuffer() of zero bytes");
+            return false;
+        }
+
+        const loader::Device& d = *s.dapi;
+
+        VkBufferCreateInfo info = {};
+        info.sType       = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+        info.size        = size;
+        info.usage       = usage;
+        // EXCLUSIVE: every user is on the graphics family. A separate transfer queue would need
+        // either CONCURRENT here or an ownership transfer, and neither exists yet to need it.
+        info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+
+        VkBuffer handle = VK_NULL_HANDLE;
+        VkResult r = d.CreateBuffer(s.device, &info, nullptr, &handle);
+        if (r != VK_SUCCESS) return Fail("vkCreateBuffer", r);
+
+        VkMemoryRequirements req = {};
+        d.GetBufferMemoryRequirements(s.device, handle, &req);
+
+        Block block;
+        if (!Allocate(req, where, block))
+        {
+            d.DestroyBuffer(s.device, handle, nullptr);
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: memory: no memory for a %llu-byte %s buffer",
+                                static_cast<unsigned long long>(size), WhereName(where));
+            return false;
+        }
+
+        r = d.BindBufferMemory(s.device, handle, block.memory, block.offset);
+        if (r != VK_SUCCESS)
+        {
+            Free(block);
+            d.DestroyBuffer(s.device, handle, nullptr);
+            return Fail("vkBindBufferMemory", r);
+        }
+
+        out.handle = handle;
+        out.block  = block;
+        out.size   = size;
+        return true;
+    }
+
+    void DestroyBuffer(Buffer& buf)
+    {
+        if (buf.handle == VK_NULL_HANDLE && buf.block.memory == VK_NULL_HANDLE) return;
+
+        if (buf.handle != VK_NULL_HANDLE)
+        {
+            // Through the context, and only while vulkan-1.dll is still mapped: a buffer destroyed
+            // from a static destructor at process exit must not call into an unloaded loader.
+            const context::Handles* h = context::Get();
+            if (h && h->dapi && h->dapi->DestroyBuffer && loader::StillMapped())
+                h->dapi->DestroyBuffer(h->device, buf.handle, nullptr);
+        }
+
+        Free(buf.block);
+        buf = Buffer();
+    }
+
+    bool Staging(VkDeviceSize size, Buffer*& out)
+    {
+        if (s.staging.handle != VK_NULL_HANDLE && s.staging.size >= size)
+        {
+            out = &s.staging;
+            return true;
+        }
+        if (!s.ready)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: memory: Staging() before Init()");
+            return false;
+        }
+
+        // Grow geometrically while that stays modest, so a sequence of slightly larger uploads does
+        // not regrow on every call; past kStagingLarge, grow to exactly what is asked, because
+        // doubling a mapped buffer there would double an address-space cost nobody needed.
+        VkDeviceSize want = RoundUp(size ? size : 1, kMiB);
+        if (want < kStagingFloor) want = kStagingFloor;
+        const VkDeviceSize doubled = s.staging.size * 2;
+        if (doubled > want && doubled <= kStagingLarge) want = doubled;
+
+        Buffer fresh;
+        if (!CreateBuffer(want, VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                          Where::HostVisible, fresh))
+        {
+            // The old buffer, if any, is left as it was: a failed growth does not take away the
+            // capacity a smaller upload could still use.
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "vulkan: memory: staging growth to %llu MiB failed", MiB(want));
+            return false;
+        }
+
+        const VkDeviceSize was = s.staging.size;
+        DestroyBuffer(s.staging);
+        s.staging = fresh;
+
+        wxl::ScriptMgr::Log(want > kStagingLarge ? WXL_LOG_WARN : WXL_LOG_DEBUG,
+                            "vulkan: memory: staging buffer %llu -> %llu MiB (persistently mapped: that much "
+                            "address space for the session)",
+                            MiB(was), MiB(want));
+        out = &s.staging;
+        return true;
+    }
+
+    bool FlushHost(const Block& block)
+    {
+        if (block.memory == VK_NULL_HANDLE || !s.ready || block.owner >= kMaxSlots) return true;
+
+        const Slot& slot = s.slots[block.owner];
+        if (slot.memory != block.memory || !slot.base) return true;
+        if (slot.flags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) return true;
+
+        // The range rules for a non-coherent flush: offset a multiple of nonCoherentAtomSize, and
+        // size either a multiple of it or reaching exactly the end of the allocation. Round out to
+        // the atom, and use VK_WHOLE_SIZE when rounding would pass the end -- a block's capacity
+        // need not itself be a multiple of the atom.
+        const VkDeviceSize start = RoundDown(block.offset, s.atom);
+        const VkDeviceSize end   = RoundUp(block.offset + block.size, s.atom);
+
+        VkMappedMemoryRange range = {};
+        range.sType  = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+        range.memory = slot.memory;
+        range.offset = start;
+        range.size   = end >= slot.capacity ? VK_WHOLE_SIZE : end - start;
+
+        const VkResult r = s.dapi->FlushMappedMemoryRanges(s.device, 1, &range);
+        if (r != VK_SUCCESS) return Fail("vkFlushMappedMemoryRanges", r);
+        return true;
+    }
+
+    void Stats(uint64_t& vkAllocateMemoryCalls, uint64_t& bytesReserved, uint64_t& bytesInUse)
+    {
+        vkAllocateMemoryCalls = s.allocateCalls;
+        bytesReserved         = s.reserved;
+        bytesInUse            = s.inUse;
+    }
+
+    void GetDetail(Detail& out)
+    {
+        out = Detail();
+        out.reservedPeak   = s.reservedPeak;
+        out.mapped         = s.mapped;
+        out.mappedPeak     = s.mappedPeak;
+        out.returnedBlocks = s.returnedBlocks;
+        out.returnedBytes  = s.returnedBytes;
+        out.dedicatedFreed = s.dedicatedFreed;
+        out.spanGrowths    = s.spanGrowths;
+        out.spanPeak       = s.spanPeak;
+        for (const Slot& slot : s.slots)
+        {
+            if (slot.memory == VK_NULL_HANDLE) continue;
+            ++out.blocks;
+            if (slot.dedicated) ++out.dedicatedBlocks;
+            else if (slot.inUse == 0) ++out.emptyBlocks;
+            if (slot.where == Where::DeviceLocal) out.deviceLocal += slot.capacity;
+            if (slot.typeIndex < s.props.memoryTypeCount)
+            {
+                const uint32_t heap = s.props.memoryTypes[slot.typeIndex].heapIndex;
+                if (heap < VK_MAX_MEMORY_HEAPS) out.heapReserved[heap] += slot.capacity;
+            }
+        }
+    }
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Memory.hpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Memory.hpp
