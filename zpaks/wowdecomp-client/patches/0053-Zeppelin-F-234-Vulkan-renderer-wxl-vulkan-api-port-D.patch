@@ -0,0 +1,23 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDGRADE_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDGRADE_H
+
+// Waystone HD: WoW Forever colour grading (not part of the original client). D3D9 only.
+//   hdGrade          0 = off (default); 1 = Forever's colour grading LUT where Forever has one
+//   hdGradeStrength  1 = Forever's look, 0 = original colours (0 to 2)
+//   hdGradeDebug     1 = split screen: left half original, right half graded (to compare)
+//   hdGradeLut       0 = Forever's LUT for this place (default); a LUT id (e.g. 8286666) = force it everywhere
+//   hdGradeInfo      read only, the LUTs in use:  /run print(GetCVar("hdGradeInfo"))
+//
+// The LUTs come from WoW Forever's LightData (column 32, forever_data\hd_forever_grading.txt made by
+// forever_tools\make_hd_forever_grading.py; the files are forever_data\grading\<id>.blp, 1024x32, 32 slices
+// of blue). Picked like the fog: zone light, nearby area lights by distance, storm. Lights Forever does not
+// have keep the original colours. Drawn over the finished world after hdBloom, before chat bubbles and the UI.
+
+namespace HD {
+    // Called by CGWorldFrame::OnWorldRender right after HD::BloomWorld.
+    void GradeWorld();
+    // Called by the D3D9 device before it releases its resources (through HD::FogReleaseDeviceResources).
+    void GradeReleaseDeviceResources();
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdGrassWind.cpp b/WoW/Source/WorldClient/HD/HdGrassWind.cpp
new file mode 100644
index 00000000..2f8d7594
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdGrassWind.cpp
@@ -0,0 +1,169 @@
+// Waystone HD: grass wind and grass parting around the player.
+// Algorithm and default values adapted from wxl-grasswind (WarcraftXL, by iThorgrim), GPLv3:
+// this program is free software: you can redistribute it and/or modify it under the terms of the GNU General Public
+// License as published by the Free Software Foundation, either version 3 of the License, or (at your option) any later
+// version. It is distributed WITHOUT ANY WARRANTY. See <https://www.gnu.org/licenses/>.
+#include "WoW/Source/WorldClient/HD/HdGrassWind.h"
+#include <cmath>
+#include <windows.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "WoW/Source/ObjectMgrClient/ObjectMgrClient.h"
+#include "WoW/Source/Object/ObjectClient/Object_C.h"
+#include "WoW/Source/UIUtil/Camera.h"
+#include "WoW/Source/Ui/WorldFrame.h"
+#include "WoW/Source/WorldClient/World.h"
+
+namespace {
+    const double kTwoPi = 6.283185307179586;
+
+    // WarcraftXL's defaults (GrassWind.hpp)
+    const float kAmplitude = 0.06f;        // wave 1 sway at the tip, yards
+    const float kWavelength = 18.0f;       // wave 1 length, yards
+    const float kCrossAmplitude = 0.02f;   // wave 2 sway, yards
+    const float kCrossWavelength = 6.5f;   // wave 2 length, yards
+    const float kCrossAngle = 35.0f;       // wave 2 heading, degrees from wave 1
+    const float kCrossSpeed = 1.37f;       // wave 2 speed / wave 1 speed
+    const float kLean = 0.35f;             // downwind lean, fraction of wave 1
+    const float kVariance = 0.6f;          // per-blade amplitude spread (0.7 .. 1.3)
+    const float kDistanceFade = 0.015f;    // sway / (1 + depth * this)
+    const float kAnchor = 0.3f;            // foot part of the blade that never moves
+    const float kJitter = 1.7f;            // per-blade phase spread, radians
+    const float kPushCentre = 0.5f;        // lean at the player, yards (0 at the radius)
+    const float kConeHeight = 0.5f;        // height above the player's feet where the lean is full
+    const float kMinHeight = 0.3f;         // lower than this above the player's feet: no lean
+
+    CVar* s_wind = nullptr;
+    CVar* s_speed = nullptr;
+    CVar* s_direction = nullptr;
+    CVar* s_strength = nullptr;
+    CVar* s_react = nullptr;
+    CVar* s_radius = nullptr;
+
+    // this frame (GrassWindPrepare)
+    ULONGLONG s_lastTick = 0;
+    double s_phase1 = 0.0;                 // wave phases, advanced each frame (a speed change does not jump)
+    double s_phase2 = 0.0;
+    float s_dir1[2] = { 0.0f, 0.0f };      // wave directions * 2 pi / wavelength
+    float s_dir2[2] = { 0.0f, 0.0f };
+    float s_amp1[2] = { 0.0f, 0.0f };      // wave directions * amplitude
+    float s_amp2[2] = { 0.0f, 0.0f };
+    float s_on = 0.0f;
+    bool s_havePlayer = false;
+    C3Vector s_player;
+    float s_push = 0.0f;
+    float s_radiusValue = 2.0f;
+
+    float Clamp(float v, float lo, float hi) {
+        return v < lo ? lo : (v > hi ? hi : v);
+    }
+
+    // same object as ShadowQuery.cpp's GetViewerPosition: what the camera follows (the player, or the player's vehicle)
+    bool PlayerPosition(C3Vector* position) {
+        CGCamera* camera = CGWorldFrame::GetActiveCamera();
+        if (!camera) return false;
+        CGObject_C* object = ClntObjMgrObjectPtr(camera->m_targetGUID, TYPEMASK_OBJECT, __FILE__, __LINE__);
+        if (!object) return false;
+        *position = object->GetPosition();
+        return true;
+    }
+}
+
+void HD::GrassWindRegister() {
+    static bool registered = false;
+    if (registered) return;
+    registered = true;
+    s_wind = CVar::Register("hdGrassWind", "HD: 1 = wind in the grass, 0 = off", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    s_speed = CVar::Register("hdGrassWindSpeed", "HD: grass wind wave speed, yards per second", 1, "3", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    s_direction = CVar::Register("hdGrassWindDirection", "HD: grass wind heading, degrees", 1, "45", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    s_strength = CVar::Register("hdGrassWindStrength", "HD: grass wind sway multiplier (1 = default)", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    s_react = CVar::Register("hdGrassReact", "HD: 1 = grass parts around the player, 0 = off", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    s_radius = CVar::Register("hdGrassReactRadius", "HD: radius of the grass parting, yards", 1, "2", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+}
+
+void HD::GrassWindPrepare() {
+    HD::GrassWindRegister();
+    ULONGLONG now = GetTickCount64();
+    double dt = s_lastTick ? (now - s_lastTick) * 0.001 : 0.0;
+    s_lastTick = now;
+    if (dt > 0.25) dt = 0.25; // a hitch or a loading screen does not make the grass jump
+
+    bool wind = s_wind ? s_wind->m_intValue != 0 : true;
+    float speed = s_speed ? s_speed->m_floatValue : 3.0f;
+    float heading = s_direction ? s_direction->m_floatValue : 45.0f;
+    float strength = s_strength ? Clamp(s_strength->m_floatValue, 0.0f, 50.0f) : 1.0f;
+    if (!wind) strength = 0.0f;
+
+    float a1 = static_cast<float>(heading * (kTwoPi / 360.0));
+    float a2 = static_cast<float>((heading + kCrossAngle) * (kTwoPi / 360.0));
+    float k1 = static_cast<float>(kTwoPi / kWavelength);
+    float k2 = static_cast<float>(kTwoPi / kCrossWavelength);
+    s_dir1[0] = std::cos(a1) * k1;
+    s_dir1[1] = std::sin(a1) * k1;
+    s_dir2[0] = std::cos(a2) * k2;
+    s_dir2[1] = std::sin(a2) * k2;
+    s_amp1[0] = std::cos(a1) * kAmplitude * strength;
+    s_amp1[1] = std::sin(a1) * kAmplitude * strength;
+    s_amp2[0] = std::cos(a2) * kCrossAmplitude * strength;
+    s_amp2[1] = std::sin(a2) * kCrossAmplitude * strength;
+
+    // the waves travel downwind: sin(k . p - k v t)
+    s_phase1 = std::fmod(s_phase1 - k1 * speed * dt, kTwoPi);
+    s_phase2 = std::fmod(s_phase2 - k2 * speed * kCrossSpeed * dt, kTwoPi);
+
+    bool react = s_react ? s_react->m_intValue != 0 : true;
+    s_radiusValue = s_radius ? Clamp(s_radius->m_floatValue, 0.1f, 20.0f) : 2.0f;
+    s_havePlayer = react && PlayerPosition(&s_player);
+    s_push = s_havePlayer ? kPushCentre : 0.0f;
+    s_on = (strength > 0.0f || s_push > 0.0f) ? 1.0f : 0.0f;
+}
+
+void HD::GrassWindConstants(float chunkOffsetX, float chunkOffsetY, float chunkOffsetZ, float* out) {
+    // the chunk's corner in world coordinates (the blade positions are relative to it)
+    double ox = static_cast<double>(chunkOffsetX) + CWorldScene::s_activeWorldView.x;
+    double oy = static_cast<double>(chunkOffsetY) + CWorldScene::s_activeWorldView.y;
+    double oz = static_cast<double>(chunkOffsetZ) + CWorldScene::s_activeWorldView.z;
+
+    // world coordinates go to 17000 yards: the waves' phase at the chunk corner is worked out here in double and
+    // wrapped, the shader only adds k . (position in the chunk), so the sway stays smooth and seamless from chunk
+    // to chunk (exact same field as k . world position)
+    float phase1 = static_cast<float>(std::fmod(ox * s_dir1[0] + oy * s_dir1[1] + s_phase1, kTwoPi));
+    float phase2 = static_cast<float>(std::fmod(ox * s_dir2[0] + oy * s_dir2[1] + s_phase2, kTwoPi));
+
+    float* c = out;
+    // c53: xy = chunk corner wrapped to 64 yards (per-blade random seed only), z unused, w = wave 1 phase here
+    c[0] = static_cast<float>(std::fmod(ox, 64.0));
+    c[1] = static_cast<float>(std::fmod(oy, 64.0));
+    c[2] = 0.0f;
+    c[3] = phase1;
+    // c54: xyz = player relative to the chunk corner, w = lean at the player (0 = no parting)
+    c[4] = s_havePlayer ? static_cast<float>(s_player.x - ox) : 0.0f;
+    c[5] = s_havePlayer ? static_cast<float>(s_player.y - oy) : 0.0f;
+    c[6] = s_havePlayer ? static_cast<float>(s_player.z - oz) : 0.0f;
+    c[7] = s_push;
+    // c55: x = 1 / radius, y = radius, z = 1 / cone height, w = min height
+    c[8] = 1.0f / s_radiusValue;
+    c[9] = s_radiusValue;
+    c[10] = 1.0f / kConeHeight;
+    c[11] = kMinHeight;
+    // c56: wave 1: xy = direction * amplitude, zw = direction * 2 pi / wavelength
+    c[12] = s_amp1[0];
+    c[13] = s_amp1[1];
+    c[14] = s_dir1[0];
+    c[15] = s_dir1[1];
+    // c57: wave 2, same
+    c[16] = s_amp2[0];
+    c[17] = s_amp2[1];
+    c[18] = s_dir2[0];
+    c[19] = s_dir2[1];
+    // c58: x = anchor, y = 1 / (1 - anchor), z = variance, w = distance fade per yard
+    c[20] = kAnchor;
+    c[21] = 1.0f / (1.0f - kAnchor);
+    c[22] = kVariance;
+    c[23] = kDistanceFade;
+    // c59: x = wave 2 phase here, y = per-blade phase spread, z = lean, w = 1 when wind or parting is on
+    c[24] = phase2;
+    c[25] = kJitter;
+    c[26] = kLean;
+    c[27] = s_on;
+}
diff --git a/WoW/Source/WorldClient/HD/HdGrassWind.h b/WoW/Source/WorldClient/HD/HdGrassWind.h
new file mode 100644
index 00000000..4df52e90
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdGrassWind.h
@@ -0,0 +1,34 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDGRASSWIND_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDGRASSWIND_H
+
+// Waystone HD: grass wind and grass parting around the player (not part of the original client).
+// Algorithm and default values adapted from wxl-grasswind (WarcraftXL, by iThorgrim, GPLv3,
+// https://www.gnu.org/licenses/): WarcraftXL patches Blizzard's grass bytecode, here the same motion lives in our own
+// HLSL grass vertex shader (HdDetailDoodad.cpp, function GrassOffset) and the constants go in c53..c59.
+//   - wind: two travelling sine waves in the world plane plus a small downwind lean; the blade bends with
+//     ((1 - uv.y - anchor) / (1 - anchor))^2 (uv.y is 1 at the foot of the blade, 0 at its tip), so the foot never
+//     moves, on flat ground or on a slope; a per-blade spread of amplitude and phase, less sway far away;
+//   - parting: blades inside a radius around the camera's target (the player, or what the player rides) lean away from it,
+//     strongest at the centre, only the part of the blade higher than 0.3 yd above the player's feet, and times
+//     the blade weight (not in WarcraftXL: on a slope above the player the foot of the blade must not move either).
+//   hdGrassWind 1 = wind on (default), 0 = off
+//   hdGrassWindSpeed      wave speed in yards per second (default 3)
+//   hdGrassWindDirection  where the wind goes, degrees in the world plane (default 45)
+//   hdGrassWindStrength   sway multiplier (default 1 = WarcraftXL's amplitudes)
+//   hdGrassReact 1 = grass parts around the player (default), 0 = off
+//   hdGrassReactRadius    radius of the parting in yards (default 2)
+// Works only while our grass shaders are in place (hdGrassLight 1, 2 or 3).
+
+namespace HD {
+    // Registers the cvars above (once).
+    void GrassWindRegister();
+
+    // Once per frame, before the grass chunks are drawn: advances the wave phases, reads the player's position.
+    void GrassWindPrepare();
+
+    // c53..c59 (28 floats) for one grass chunk. chunkOffset = the chunk's translation in the grass world matrix
+    // (CWorldScene::RenderDetailDoodads: chunk->m_topLeftCoords - CWorldScene::s_activeWorldView).
+    void GrassWindConstants(float chunkOffsetX, float chunkOffsetY, float chunkOffsetZ, float* out);
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdGxShader.cpp b/WoW/Source/WorldClient/HD/HdGxShader.cpp
new file mode 100644
index 00000000..424f0878
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdGxShader.cpp
@@ -0,0 +1,77 @@
+#include "WoW/Source/WorldClient/HD/HdGxShader.h"
+#include <atomic>
+#include <cstdio>
+#include <windows.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/Gx.h"
+#include "Engine/Source/Gx/GxSeam.h"
+#include "Engine/Source/Gx/Types.h"
+
+namespace {
+    // The first pixel register the translated modules do not carry, and the vertex row it is read from.
+    const uint32_t kPixelHighFirst = 13;
+    const uint32_t kPixelHighRow = 64;
+    const uint32_t kPixelHighLast = 204; // 64 + (204 - 13) = 255, the last vertex row
+
+    CVar* s_dump = nullptr;
+    std::atomic<int32_t> s_dumpOn(0);
+
+    bool DumpCallback(CVar*, const char*, const char* value, void*) {
+        s_dumpOn.store(value && value[0] == '1' ? 1 : 0);
+        return true;
+    }
+}
+
+void HD::ShaderCVars() {
+    static bool registered = false;
+    if (registered) return;
+    registered = true;
+    s_dump = CVar::Register("hdShaderDump", "HD: 1 = write the HD shaders to Vulkan\\hd-blobs\\ for the Vulkan translator", 1, "0", DumpCallback, CATEGORY_GRAPHICS, false, nullptr, false);
+    if (s_dump) s_dumpOn.store(s_dump->m_intValue != 0 ? 1 : 0);
+}
+
+bool HD::VulkanDevice() {
+    return g_theGxDevicePtr && g_theGxDevicePtr->DeviceApi() == GxApi_Vulkan;
+}
+
+bool HD::ShaderSwapDevice() {
+    if (!g_theGxDevicePtr) return false;
+    EGxApi api = g_theGxDevicePtr->DeviceApi();
+    return api == GxApi_D3d9 || api == GxApi_D3d9Ex || api == GxApi_Vulkan;
+}
+
+bool HD::ShaderKnown(const uint8_t* code, size_t size) {
+    if (!HD::VulkanDevice()) return true;
+    return g_gxShaderKnown && code && size && g_gxShaderKnown(code, static_cast<uint32_t>(size)) != 0;
+}
+
+bool HD::ShaderObjectOwnedByDevice() {
+    return HD::VulkanDevice();
+}
+
+void HD::PixelConstantsSet(uint32_t first, const float* data, uint32_t count) {
+    if (!g_theGxDevicePtr || !count) return;
+    g_theGxDevicePtr->ShaderConstantsSet(GxSh_Pixel, first, data, count);
+    if (!HD::VulkanDevice() || first + count <= kPixelHighFirst) return;
+
+    uint32_t skip = first < kPixelHighFirst ? kPixelHighFirst - first : 0;
+    uint32_t start = first + skip;
+    if (start > kPixelHighLast) return;
+    uint32_t rows = count - skip;
+    if (start + rows - 1 > kPixelHighLast) rows = kPixelHighLast - start + 1;
+    g_theGxDevicePtr->ShaderConstantsSet(GxSh_Vertex, kPixelHighRow + (start - kPixelHighFirst), data + 4 * skip, rows);
+}
+
+void HD::ShaderDump(const char* material, bool pixel, int32_t a, int32_t b, const uint8_t* code, size_t size) {
+    if (!s_dumpOn.load() || !material || !code || !size) return;
+    CreateDirectoryA("Vulkan", nullptr);
+    CreateDirectoryA("Vulkan\\hd-blobs", nullptr);
+    char path[MAX_PATH];
+    snprintf(path, sizeof(path), "Vulkan\\hd-blobs\\%s-%s-%d-%d.bin", material, pixel ? "ps" : "vs", a, b);
+    FILE* file = fopen(path, "wb");
+    if (!file) return;
+    fwrite(code, 1, size, file);
+    fclose(file);
+}
diff --git a/WoW/Source/WorldClient/HD/HdGxShader.h b/WoW/Source/WorldClient/HD/HdGxShader.h
new file mode 100644
index 00000000..793dab02
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdGxShader.h
@@ -0,0 +1,40 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDGXSHADER_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDGXSHADER_H
+
+// Waystone HD: what the HD materials (HdTerrain, HdMapObj, HdDetailDoodad, HdSky) need from the graphics device when
+// they put their own shader code into a CGxShader, on D3D9 and on the Vulkan device (gxApi vulkan, CGxDeviceVulkan).
+//   - Vulkan draws DX9 bytecode through modules translated offline (Vulkan\shaders\translated\): a material swaps
+//     its code in only when the device knows it (ShaderKnown), so an untranslated one keeps Blizzard's shader.
+//   - The translated pixel modules read c0..c12 only; an HD pixel shader's c13 and up are read from vertex rows
+//     64 + (N - 13) instead (tools/bls_tools/hd_blobs.py), which PixelConstantsSet fills too under Vulkan.
+//   hdShaderDump   1 = write every HD shader the materials compile to Vulkan\hd-blobs\ (the translator's input)
+
+#include <cstddef>
+#include <cstdint>
+
+class CGxShader;
+
+namespace HD {
+    void ShaderCVars();
+
+    // The device is the Vulkan one (gxApi vulkan).
+    bool VulkanDevice();
+
+    // The device runs the HD materials' code: D3D9, D3D9Ex, or Vulkan.
+    bool ShaderSwapDevice();
+
+    // The device can draw this code (always on D3D9; on Vulkan, when its translated module exists).
+    bool ShaderKnown(const uint8_t* code, size_t size);
+
+    // Under Vulkan a CGxShader's API object is the translator's manifest record, owned by the device: nothing to
+    // release. Returns true when the caller must not release the old object.
+    bool ShaderObjectOwnedByDevice();
+
+    // ShaderConstantsSet(GxSh_Pixel, ...), plus the vertex-row copy of c13 and up under Vulkan.
+    void PixelConstantsSet(uint32_t first, const float* data, uint32_t count);
+
+    // hdShaderDump 1: Vulkan\hd-blobs\<material>-<vs|ps>-<a>-<b>.bin. Safe on the compile threads.
+    void ShaderDump(const char* material, bool pixel, int32_t a, int32_t b, const uint8_t* code, size_t size);
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdLights.cpp b/WoW/Source/WorldClient/HD/HdLights.cpp
new file mode 100644
index 00000000..2a723821
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdLights.cpp
@@ -0,0 +1,205 @@
+#include "WoW/Source/WorldClient/HD/HdLights.h"
+#include <cmath>
+#include <cstdio>
+#include <unordered_map>
+#include <vector>
+#include <windows.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Model2/M2Light.h"
+#include "Engine/Source/Model2/M2Scene.h"
+#include "Engine/Source/Tempest/C3Vector.h"
+#include "Engine/Source/Tempest/CAaSphere.h"
+
+// Pixel constants of one light (4 float4, what HdPointLight in the terrain pixel shader reads):
+//   0: xyz = position - camera (world, yards), w = 1 legacy falloff colour * N.L / (0.7 d + 0.03 d^2)
+//   1: rgb = colour A, w = attenuation start            (windowed falloff, lightbufferomni permutation 0:
+//   2: rgb = colour B, w = 1 / (attenuation end - start)  (1 - saturate((d - start) / (end - start)))^2 * N.L,
+//   3: x, y = colour blend t = saturate(d * x + y)         colour = lerp(B, A, smoothstep(t)); not used by M2 lights)
+//      z = radius where the light ends, w = 1 / fade width (our cut: Forever's legacy falloff never reaches 0, its
+//      light volume ends it; its size is not known yet)
+
+namespace {
+    struct FrameLight {
+        C3Vector pos;      // world
+        C3Vector color;    // CM2Light::m_dirColor (diffuse colour * intensity * model alpha), as 3.3.5 uses it
+        float strength;    // brightest channel
+        float radius;      // where it ends (hdLightsRadius, or from its colour)
+        float fade;        // fade width at the end
+    };
+
+    const float kGatherDistance = 300.0f; // lights farther than this from the camera are left out
+    const float kEndLight = 0.02f;        // automatic radius: where colour / (0.7 d + 0.03 d^2) falls to this
+    const float kMinRadius = 2.0f;
+    const float kMaxRadius = 32.0f;
+    const uint32_t kNoFrame = 0xFFFFFFFFu;
+
+    CVar* s_mode = nullptr;
+    CVar* s_radius = nullptr;
+    CVar* s_info = nullptr;
+
+    std::vector<FrameLight> s_frame;       // this frame's lights
+    // HD: the last animated state of each model light. A lamp's model is animated only while it is drawn, and
+    // SelectLights hides (unlinks) a light its model did not animate this frame: a lamp just off screen stopped
+    // lighting the ground in view, so the ground's colour changed with the camera angle. Kept until the model
+    // leaves the scene (HD::LightsForget).
+    struct KnownLight {
+        C3Vector pos;
+        C3Vector color;
+        uint32_t frame;    // the frame it was last seen in the grid
+    };
+    std::unordered_map<const CM2Light*, KnownLight> s_known;
+    const CM2Scene* s_knownScene = nullptr;
+    const CM2Scene* s_frameScene = nullptr;
+    uint32_t s_frameStamp = kNoFrame;
+    int32_t s_otherFalloff = 0;            // this frame's lights whose attenuation is not CM2Light's 0 / 0.7 / 0.03
+    int32_t s_mostPerDraw = 0;             // most lights one draw took since the info was last shown
+    ULONGLONG s_infoTime = 0;
+
+    void RegisterCVars() {
+        static bool registered = false;
+        if (registered) return;
+        registered = true;
+        s_mode = CVar::Register("hdLights", "HD: 1 = lamps and fires light the ground per pixel (WoW Forever), 2 = light path with no light (must equal 0), 3 = test view (lights only), 0 = 3.3.5 per-vertex lights", 1, "1", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_radius = CVar::Register("hdLightsRadius", "HD: yards where a lamp's light ends, 0 = from its colour", 1, "0", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+        s_info = CVar::Register("hdLightsInfo", "HD: hdLights status (read only)", 0, "no light yet", nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+    }
+
+    float Radius(float strength) {
+        float fixed = s_radius ? s_radius->m_floatValue : 0.0f;
+        if (fixed > 0.0f) return fixed;
+        // 0.03 r^2 + 0.7 r = strength / kEndLight
+        float r = (sqrtf(0.49f + 0.12f * strength / kEndLight) - 0.7f) / 0.06f;
+        return r < kMinRadius ? kMinRadius : (r > kMaxRadius ? kMaxRadius : r);
+    }
+
+    void AddFrameLight(const C3Vector& pos, const C3Vector& c, const C3Vector& camera) {
+        float dx = pos.x - camera.x;
+        float dy = pos.y - camera.y;
+        float dz = pos.z - camera.z;
+        if (dx * dx + dy * dy + dz * dz > kGatherDistance * kGatherDistance) return;
+        float strength = c.x > c.y ? c.x : c.y;
+        if (c.z > strength) strength = c.z;
+        if (!(strength > 0.0f)) return;
+        FrameLight frameLight;
+        frameLight.pos = pos;
+        frameLight.color = c;
+        frameLight.strength = strength;
+        frameLight.radius = Radius(strength);
+        frameLight.fade = frameLight.radius * 0.25f;
+        s_frame.push_back(frameLight);
+    }
+
+    // The lights CM2Scene::SelectLights would give anything this frame: point lights in the light grid, visible,
+    // and animated this frame (or not owned by a model). Unlike SelectLights it never hides a stale light.
+    // HD: plus the lamps whose model was not animated this frame, at their last animated state (s_known).
+    void GatherFrame(const CM2Scene* scene, const C3Vector& camera) {
+        s_frame.clear();
+        s_otherFalloff = 0;
+        if (scene != s_knownScene) {
+            s_known.clear();
+            s_knownScene = scene;
+        }
+        uint32_t frame = scene->m_frameStamp;
+        if (scene->m_lightGrid) {
+            for (uint32_t cell = 0; cell < 64 * 64; cell++) {
+                for (const CM2Light* light = scene->m_lightGrid[cell]; light; light = light->m_lightNext) {
+                    if (light->m_scene && light->m_stamp != frame) continue; // stale: from s_known below
+                    if (!light->m_visible || light->m_type != M2LIGHT_POINT) continue;
+                    if (light->m_scene) {
+                        KnownLight& known = s_known[light];
+                        known.pos = light->m_pos;
+                        known.color = light->m_dirColor;
+                        known.frame = frame;
+                    }
+                    if (light->m_constantAttenuation != 0.0f || light->m_linearAttenuation != 0.7f || light->m_quadraticAttenuation != 0.03f) s_otherFalloff++;
+                    AddFrameLight(light->m_pos, light->m_dirColor, camera);
+                }
+            }
+        }
+        for (std::unordered_map<const CM2Light*, KnownLight>::iterator it = s_known.begin(); it != s_known.end();) {
+            if (it->second.frame == frame) { ++it; continue; }
+            // animated this frame but not in the grid: its model hid it (switched off)
+            if (it->first->m_stamp == frame) { it = s_known.erase(it); continue; }
+            AddFrameLight(it->second.pos, it->second.color, camera);
+            ++it;
+        }
+    }
+
+    void ShowInfo(const C3Vector& camera) {
+        ULONGLONG now = GetTickCount64();
+        if (!s_info || (s_infoTime && now - s_infoTime < 500)) return;
+        s_infoTime = now;
+        char text[300];
+        int32_t nearest = -1;
+        float best = 0.0f;
+        for (size_t i = 0; i < s_frame.size(); i++) {
+            float dx = s_frame[i].pos.x - camera.x;
+            float dy = s_frame[i].pos.y - camera.y;
+            float dz = s_frame[i].pos.z - camera.z;
+            float d = dx * dx + dy * dy + dz * dz;
+            if (nearest < 0 || d < best) { nearest = static_cast<int32_t>(i); best = d; }
+        }
+        int32_t n = snprintf(text, sizeof(text), "hdLights %d: %u lights, up to %d per draw, %d other falloff", HD::LightsMode(), static_cast<uint32_t>(s_frame.size()), s_mostPerDraw, s_otherFalloff);
+        if (nearest >= 0 && n > 0 && n < static_cast<int32_t>(sizeof(text))) {
+            const FrameLight& l = s_frame[nearest];
+            snprintf(text + n, sizeof(text) - n, "; nearest %.1f yd at (%.2f, %.2f, %.2f) colour (%.3f, %.3f, %.3f) radius %.1f", sqrtf(best), l.pos.x, l.pos.y, l.pos.z, l.color.x, l.color.y, l.color.z, l.radius);
+        }
+        s_info->Set(text, true, false, false, false);
+        s_mostPerDraw = 0;
+    }
+}
+
+int32_t HD::LightsMode() {
+    RegisterCVars();
+    int32_t mode = s_mode ? s_mode->m_intValue : 1;
+    return mode < 0 || mode > 3 ? 0 : mode;
+}
+
+int32_t HD::LightsForSphere(CM2Scene* scene, const C3Vector& camera, const CAaSphere& sphere, float* out) {
+    RegisterCVars();
+    if (!scene) return 0;
+    if (scene != s_frameScene || scene->m_frameStamp != s_frameStamp) {
+        s_frameScene = scene;
+        s_frameStamp = scene->m_frameStamp;
+        GatherFrame(scene, camera);
+        ShowInfo(camera);
+    }
+
+    // the strongest lights at the sphere's nearest point (brightest first)
+    int32_t picked[kLightsMax];
+    float score[kLightsMax];
+    int32_t count = 0;
+    for (size_t i = 0; i < s_frame.size(); i++) {
+        const FrameLight& l = s_frame[i];
+        float dx = l.pos.x - sphere.c.x;
+        float dy = l.pos.y - sphere.c.y;
+        float dz = l.pos.z - sphere.c.z;
+        float reach = l.radius + sphere.r;
+        float distSq = dx * dx + dy * dy + dz * dz;
+        if (distSq >= reach * reach) continue;
+        float d = sqrtf(distSq) - sphere.r;
+        if (d < 1.0f) d = 1.0f;
+        float s = l.strength / (0.7f * d + 0.03f * d * d);
+        if (count == kLightsMax && s <= score[kLightsMax - 1]) continue;
+        int32_t j = count < kLightsMax ? count++ : kLightsMax - 1;
+        while (j > 0 && score[j - 1] < s) { score[j] = score[j - 1]; picked[j] = picked[j - 1]; j--; }
+        score[j] = s;
+        picked[j] = static_cast<int32_t>(i);
+    }
+
+    for (int32_t k = 0; k < count; k++) {
+        const FrameLight& l = s_frame[picked[k]];
+        float* c = out + 16 * k;
+        c[0] = l.pos.x - camera.x;  c[1] = l.pos.y - camera.y;  c[2] = l.pos.z - camera.z;  c[3] = 1.0f;
+        c[4] = l.color.x;           c[5] = l.color.y;           c[6] = l.color.z;           c[7] = 0.0f;
+        c[8] = l.color.x;           c[9] = l.color.y;           c[10] = l.color.z;          c[11] = 0.0f;
+        c[12] = 0.0f;               c[13] = 1.0f;               c[14] = l.radius;           c[15] = 1.0f / l.fade;
+    }
+    if (count > s_mostPerDraw) s_mostPerDraw = count;
+    return count;
+}
+
+void HD::LightsForget(const CM2Light* light) {
+    s_known.erase(light);
+}
diff --git a/WoW/Source/WorldClient/HD/HdLights.h b/WoW/Source/WorldClient/HD/HdLights.h
new file mode 100644
index 00000000..0e8b3fc7
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdLights.h
@@ -0,0 +1,43 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDLIGHTS_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDLIGHTS_H
+
+// Waystone HD: lamps, lanterns, braziers and fires light the world around them, like in WoW Forever (not part of
+// the original client).
+// The lights are the client's own M2 point lights (the M2Light of a lamppost model, animated by CM2Model), the ones
+// 3.3.5 already gives the ground per vertex (3 nearest per chunk, clamped, gamma space: barely visible). Forever
+// draws each of them into a light buffer, per pixel, with lightbufferomni.bls: colour * N.L / (0.7 d + 0.03 d^2)
+// (the same falloff as CM2Light's attenuation 0 / 0.7 / 0.03), and adds that buffer to the ground in linear space:
+// albedo * (light^2.2 + buffer)^(1/2.2). Our pixel shaders do the same maths per pixel for the few lights near the
+// thing they draw: HD::LightsForSphere picks them from this frame's lights and packs them as pixel constants.
+//   hdLights 1 = per-pixel lights (Forever's maths) on the ground, with hdTerrainLight 1 (default)
+//            2 = the light path with no light: must look exactly like 0 (proves the wiring changes nothing)
+//            3 = test view: the ground shows only the point lights (no texture, no sun, no fog)
+//            0 = off: 3.3.5's per-vertex point lights
+//   hdLightsRadius  yards where a light ends (faded over its last quarter); 0 = from its colour (default)
+//   hdLightsInfo    read only, this frame's lights and the nearest one's values:  /run print(GetCVar("hdLightsInfo"))
+
+#include <cstdint>
+
+class C3Vector;
+class CAaSphere;
+class CM2Scene;
+
+class CM2Light;
+
+namespace HD {
+    // Lights one draw can take (4 pixel constants each).
+    const int32_t kLightsMax = 4;
+
+    // hdLights (0..3).
+    int32_t LightsMode();
+
+    // Up to kLightsMax of this frame's point lights that reach `sphere` (world), strongest first, packed for the
+    // pixel shader in out[16 * kLightsMax] (4 float4 per light, layout in HdLights.cpp), positions relative to
+    // `camera`. Returns how many. The frame's lights are gathered from `scene` the first time it is called in a frame.
+    int32_t LightsForSphere(CM2Scene* scene, const C3Vector& camera, const CAaSphere& sphere, float* out);
+
+    // A model's light leaves its scene (detached or freed): forget its last animated state.
+    void LightsForget(const CM2Light* light);
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdMapObj.cpp b/WoW/Source/WorldClient/HD/HdMapObj.cpp
new file mode 100644
index 00000000..54bfe62b
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdMapObj.cpp
@@ -0,0 +1,769 @@
+#include "WoW/Source/WorldClient/HD/HdMapObj.h"
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <thread>
+#include <vector>
+#include <windows.h>
+#include <d3d9.h>
+#include <d3dcompiler.h>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Gx/CGxDevice/CGxShader.h"
+#include "Engine/Source/Gx/Gx.h"
+#include "Engine/Source/Gx/Types.h"
+#include "WoW/Source/WorldClient/HD/HdGxShader.h"
+#include "Engine/Source/ShaderEffect/ShaderEffect.h"
+#include "Engine/Source/Tempest/C44Matrix.h"
+#include "WoW/Source/WorldClient/HD/HdTerrain.h"
+
+namespace {
+    // MapObj vertex shader. Source of truth: the 3.3.5 shaders rewritten from their bytecode (the 7 MapObj*.bls
+    // families of Shaders/Vertex/vs_3_0), checked numerically against them for every slot, plus the Forever lighting.
+    // (Generated by make_hd_mapobj.py from hd_wmo_vs.hlsl; MSVC takes at most 16 KB per string piece.)
+    const char kVertexShader[] =
+        R"HLSL(// Waystone HD building (WMO / MapObj) vertex shader (vs_3_0). Replaces the 7 Shaders\Vertex\vs_3_0\MapObj*.bls
+// families, permutation P = LIT + 2 * (LIGHTS + 15 * SHADOW)  (CMapObj::SelectWorldShaders; LIGHTS 5..14 repeat 0..4).
+//   family                     UNIFIED REFL SPECULAR COMP
+//   MapObjDiffuse_T1              0     0      0      0
+//   MapObjDiffuse_T1_Refl         0     1      0      0
+//   MapObjSpecular_T1             0     0      1      0
+//   MapObjUDiffuse_T1             1     0      0      0
+//   MapObjUDiffuse_T1_Refl        1     1      0      0
+//   MapObjUSpecular_T1            1     0      1      0
+//   MapObjUDiffuse_Comp           1     0      0      1
+// With c49.z = 0 it computes exactly what the 3.3.5 shader does (COLOR1 = 0 where 3.3.5 writes none).
+// With c49.z = 1 (set only for exterior-lit batches, SetLighting 1 or 2) it lights the building like WoW Forever:
+// the ambient comes from a sky / horizon / ground hemisphere shaded by a soft wrap of the sun (0.7 .. 1.1), and the
+// sun goes out separately in COLOR1.rgb so the pixel shader can cut it fully in shadow instead of darkening
+// everything to 70%. The vertex colour (MOCV) keeps the 3.3.5 rule of each path: classic multiplies the light by it,
+// unified adds it.
+#ifndef UNIFIED
+#define UNIFIED 0
+#endif
+#ifndef REFL
+#define REFL 0
+#endif
+#ifndef SPECULAR
+#define SPECULAR 0
+#endif
+#ifndef COMP
+#define COMP 0
+#endif
+#ifndef LIT
+#define LIT 0
+#endif
+#ifndef LIGHTS
+#define LIGHTS 0
+#endif
+#ifndef SHADOW
+#define SHADOW 0
+#endif
+
+// texture coordinates after the first one(s) move up by one in the Refl and Comp families
+#define SHIFT (REFL || COMP)
+// the normal is needed for the light, the reflection and the shadow facing term
+#define NEED_NORMAL (LIT || REFL || SHADOW)
+
+float4 cProj[4]       : register(c2);   // rows of the projection (CShaderEffect::UpdateProjMatrix)
+float4 cAmbient       : register(c10);  // SetLighting: ambient (mode 1 light1.ambient, 2 mid1, 3 MOHD colour)
+float4 cDiffuse       : register(c11);  // SetLighting: sun colour (mode 1 light1.diffuse, 2 mid0, 3 black)
+float4 cSunDir        : register(c12);  // view-space sun direction; the light falls along it (shaders use -c12)
+float4 cSpecular      : register(c13);  // rgb = specular colour, w = power (14)
+float4 cLightColor[4] : register(c17);  // local lights (CShaderEffect::ComputeLocalLights)
+float4 cLightPos[4]   : register(c21);  // view space
+float4 cLightAtt0     : register(c25);  // constant attenuation of light 0..3 in x..w
+float4 cLightAtt1     : register(c26);  // linear
+float4 cLightAtt2     : register(c27);  // quadratic
+float4 cMatDiffuse    : register(c28);  // unified: material diffuse (0x7F7F7F)
+float4 cEmissive      : register(c29);  // (s_emissiveAmbient + SIDN) / 2
+float4 cFog           : register(c30);  // x scale, y bias, z power
+float4 cWorldView[3]  : register(c31);  // rows of transpose(world * view)
+float4 cShadowMtx[12] : register(c224); // dyn rows c224..226, bands c227..232, band 2 coordinates c233..235
+float4 cHdLight       : register(c49);  // z = 1 Forever lighting on this batch (exterior-lit only); x, y, w unused here
+float4 cHdLight2      : register(c50);  // x = ambient strength in Forever lighting (1 = the ambient as it is)
+float4 cHdHorizon     : register(c51);  // rgb = Forever's horizon ambient / its sky ambient, per channel
+float4 cHdGround      : register(c52);  // rgb = Forever's ground ambient / its sky ambient, per channel
+float4 cHdUp          : register(c53);  // xyz = world up (0, 0, 1) in view space (the hemisphere axis)
+
+#if LIGHTS
+// local light i at view position vp, normal n; k = its constant, linear and quadratic attenuation
+// (3.3.5: no saturate per light, attenuation 1 / (k0 + k1 d + k2 d^2))
+float3 LocalLight(int i, float k0, float k1, float k2, float3 vp, float3 n)
+{
+    float3 l = cLightPos[i].xyz - vp;
+    float d2 = dot(l, l);
+    float r = rsqrt(d2);
+    float d = d2 * r;
+    return cLightColor[i].xyz * (max(dot(l, n) * r, 0.0) * (1.0 / (k0 + k1 * d + k2 * d2)));
+}
+#endif
+
+void main(
+    float4 iPos : POSITION0,
+#if NEED_NORMAL
+    float3 iNormal : NORMAL0,
+#endif
+    float4 iColor : COLOR0,
+#if COMP
+    float4 iColor2 : COLOR1,
+#endif
+    float2 iTex0 : TEXCOORD0,
+#if COMP
+    float2 iTex1 : TEXCOORD1,
+#endif
+    out float4 oPos : POSITION0,
+    out float4 oColor : COLOR0,
+    out float4 oColor2 : COLOR1,
+    out float2 oTex0 : TEXCOORD0,
+#if SHIFT
+    out float2 oTex1 : TEXCOORD1,
+#endif
+#if SHADOW
+#if SHIFT
+    out float3 oViewPos : TEXCOORD2,
+    out float3 oNormal : TEXCOORD3,
+#if SHADOW == 1
+    out float3 oShadow0 : TEXCOORD4,
+#else
+    out float4 oShadow0 : TEXCOORD4,
+    out float4 oShadow1 : TEXCOORD5,
+    out float4 oShadow2 : TEXCOORD6,
+#endif
+#else
+    out float3 oViewPos : TEXCOORD1,
+    out float3 oNormal : TEXCOORD2,
+#if SHADOW == 1
+    out float3 oShadow0 : TEXCOORD3,
+#else
+    out float4 oShadow0 : TEXCOORD3,
+    out float4 oShadow1 : TEXCOORD4,
+    out float4 oShadow2 : TEXCOORD5,
+#endif
+#endif
+#endif
+    out float oFog : FOG)
+{
+    float4 vp = float4(dot(cWorldView[0], iPos), dot(cWorldView[1], iPos), dot(cWorldView[2], iPos), 1.0);
+    oPos = float4(dot(cProj[0], vp), dot(cProj[1], vp), dot(cProj[2], vp), dot(cProj[3], vp));
+    oFog = min(pow(max(vp.z * cFog.x + cFog.y, 0.0), cFog.z), 1.0);
+
+#if NEED_NORMAL
+    // normal: worldView 3x3, renormalised
+    float3 n = normalize(float3(dot(cWorldView[0].xyz, iNormal), dot(cWorldView[1].xyz, iNormal), dot(cWorldView[2].xyz, iNormal)));
+#endif
+
+    oColor2 = float4(0.0, 0.0, 0.0, 0.0);
+#if COMP
+    oColor2 = iColor2;
+#endif
+
+#if LIT
+    float3 points = float3(0.0, 0.0, 0.0);
+#if LIGHTS >= 1
+    points = points + LocalLight(0, cLightAtt0.x, cLightAtt1.x, cLightAtt2.x, vp.xyz, n);
+#endif
+#if LIGHTS >= 2
+    points = points + LocalLight(1, cLightAtt0.y, cLightAtt1.y, cLightAtt2.y, vp.xyz, n);
+#endif
+#if LIGHTS >= 3
+    points = points + LocalLight(2, cLightAtt0.z, cLightAtt1.z, cLightAtt2.z, vp.xyz, n);
+#endif
+#if LIGHTS >= 4
+    points = points + LocalLight(3, cLightAtt0.w, cLightAtt1.w, cLightAtt2.w, vp.xyz, n);
+#endif
+    float nl = dot(-cSunDir.xyz, n);
+    [branch] if (cHdLight.z > 0.5) {
+        // HD: Forever. Ambient: horizon colour for a wall, sky colour for a roof facing up, ground colour for an
+        // overhang; the client's ambient is the sky colour (Forever's when hdForeverLight is 1, so horizon and ground
+        // are then Forever's own colours). Then a wrap of the sun over it, and the sun on its own in COLOR1.
+        float up = dot(normalize(cHdUp.xyz), n);
+        float3 sky = cAmbient.xyz * cHdLight2.x;
+        float3 horizon = sky * cHdHorizon.xyz;
+        float3 hemi = horizon + (sky - horizon) * saturate(up) + (sky * cHdGround.xyz - horizon) * saturate(-up);
+        float3 ambient = hemi * (nl * 0.2 + 0.9) + points;
+        float3 direct = cDiffuse.xyz * saturate(nl);
+        // like 3.3.5 (saturate of the light), a channel never goes over 1: both parts are scaled down together
+        float3 fit = 1.0 / max(ambient + direct, 1.0);
+#if UNIFIED
+        oColor = float4(saturate(cMatDiffuse.xyz * (ambient * fit) + iColor.xyz + cEmissive.xyz), saturate(iColor.w));
+        oColor2.xyz = saturate(cMatDiffuse.xyz * (direct * fit));
+#else
+        oColor = float4(saturate(iColor.xyz * (ambient * fit) + cEmissive.xyz), saturate(iColor.w));
+        oColor2.xyz = saturate(iColor.xyz * (direct * fit));
+#endif
+    } else {
+        float3 light = saturate(cDiffuse.xyz * saturate(nl) + cAmbient.xyz + points);
+#if UNIFIED
+        oColor = float4(saturate(cMatDiffuse.xyz * light + iColor.xyz + cEmissive.xyz), saturate(iColor.w));
+#else
+        oColor = float4(saturate(iColor.xyz * light + cEmissive.xyz), saturate(iColor.w));
+#endif
+#if SPECULAR
+        float3 h = normalize(normalize(vp.xyz) + cSunDir.xyz);
+        oColor2 = float4(pow(saturate(dot(n, -h)), cSpecular.w) * cSpecular.xyz, 1.0);
+#endif
+    }
+#else
+    oColor = iColor;
+#endif
+
+    oTex0 = iTex0;
+#if REFL
+    float3 e = normalize(vp.xyz);
+    oTex1 = (e - n * (2.0 * dot(e, n))).xy;
+#endif
+#if COMP
+    oTex1 = iTex1;
+#endif
+
+#if SHADOW
+    oViewPos = vp.xyz;
+    oNormal = n;
+#if SHADOW == 1
+    oShadow0 = float3(dot(vp, cShadowMtx[0]), dot(vp, cShadowMtx[1]), dot(vp, cShadowMtx[2]));
+#else
+    oShadow0 = float4(dot(vp, cShadowMtx[0]), dot(vp, cShadowMtx[1]), dot(vp, cShadowMtx[2]), dot(vp, cShadowMtx[9]));
+    oShadow1 = float4(dot(vp, cShadowMtx[3]), dot(vp, cShadowMtx[4]), dot(vp, cShadowMtx[5]), dot(vp, cShadowMtx[10]));
+    oShadow2 = float4(dot(vp, cShadowMtx[6]), dot(vp, cShadowMtx[7]), dot(vp, cShadowMtx[8]), dot(vp, cShadowMtx[11]));
+#endif
+#endif
+}
+)HLSL";
+
+    // MapObj pixel shaders (7 families x 16 permutations), same method.
+    const char kPixelShader[] =
+        R"HLSL(// Waystone HD building (WMO / MapObj) pixel shader (ps_3_0). Replaces the 7 Shaders\Pixel\ps_3_0\MapObj*.bls
+// families, permutation P = SHADOW + 4 * PCF + 8 * ALPHA_TEST  (CShaderEffect::SelectShadowShader).
+//   KIND 0 = MapObjDiffuse      (alpha = texture alpha * vertex alpha)
+//        1 = MapObjSpecular, MapObjMetal, MapObjOpaque (byte-identical in 3.3.5; alpha = vertex alpha)
+//        2 = MapObjEnv          (+ texture alpha * environment texture)
+//        3 = MapObjEnvMetal     (+ texture alpha * texture * environment texture)
+//        4 = MapObjComposite    (two textures blended by COLOR1.w)
+//   SHADOW 0 none, 1 player shadow, 2 player shadow + 3 sun bands, 3 near cascade + 3 sun bands; PCF 1 = hardware
+//   depth compare (D24) instead of the R32F manual compare; ALPHA_TEST 1 = discard below c2.w in the shader.
+// COLOR1.rgb comes from the HD vertex shader: the sun's light (Forever lighting only).
+// With c15.x = 0 it computes exactly what the 3.3.5 shader does: the shadow S darkens the whole light to 70%.
+// With c15.x = 1 (exterior-lit batch, Forever lighting) the sun is cut fully by the shadow and the ambient (COLOR0)
+// is left alone: light = saturate(COLOR0 + COLOR1 * S). c15.y = 1 is the test view: only the sun after the shadow.
+#ifndef KIND
+#define KIND 0
+#endif
+#ifndef SHADOW
+#define SHADOW 0
+#endif
+#ifndef PCF
+#define PCF 0
+#endif
+#ifndef ALPHA_TEST
+#define ALPHA_TEST 0
+#endif
+
+#define TWO_TEX (KIND >= 2)
+
+float4 cFogColor     : register(c2);   // rgb = fog colour, w = alpha reference (ALPHA_TEST)
+float4 cCutoff       : register(c3);   // view-space plane: past it the shadow fades out
+float4 cSunDirView   : register(c4);   // view-space sun direction (shadow facing term)
+float4 cPcfOffset[8] : register(c5);   // xy = PCF tap offsets in shadow-map UV (c5..c12)
+float4 cHdPs         : register(c15);  // HD: x = 1 Forever lighting on this batch, y = 1 test view
+
+sampler2D sTex0      : register(s0);
+#if TWO_TEX
+sampler2D sTex1      : register(s1);   // environment (Env, EnvMetal) or second texture (Composite)
+#endif
+#if SHADOW >= 1
+sampler2D sShadow0   : register(s4);   // dynamic (player) shadow, or near cascade in mode 3
+#endif
+#if SHADOW >= 2
+sampler2D sShadow1   : register(s5);   // sun shadow band 0
+sampler2D sShadow2   : register(s6);   // band 1
+sampler2D sShadow3   : register(s7);   // band 2
+#endif
+
+// one shadow tap at shadow-map UV uv for light-space depth z: 1 = lit, 0 = shadowed
+float Tap(sampler2D s, float2 uv, float z)
+{
+#if PCF
+    return tex2Dlod(s, float4(uv, z, 0.0)).x;
+#else
+    return step(z, tex2Dlod(s, float4(uv, 0.0, 0.0)).x);
+#endif
+}
+
+// centre + offsets 0,2,4,6 ; returns the SUM (0..5)
+float Sum5(sampler2D s, float2 c, float z)
+{
+    float2 uv = c * 0.5 + 0.5;
+    float sum = Tap(s, uv, z);
+    sum = sum + Tap(s, uv + cPcfOffset[0].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[2].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[4].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[6].xy, z);
+    return sum;
+}
+
+// centre + all 8 offsets ; returns the SUM (0..9)
+float Sum9(sampler2D s, float2 c, float z)
+{
+    float2 uv = c * 0.5 + 0.5;
+    float sum = Tap(s, uv, z);
+    sum = sum + Tap(s, uv + cPcfOffset[0].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[1].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[2].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[3].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[4].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[5].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[6].xy, z);
+    sum = sum + Tap(s, uv + cPcfOffset[7].xy, z);
+    return sum;
+}
+
+// edge fades (the float32 constants of the 3.3.5 shaders, written out in full)
+float EdgeFade(float2 c)
+{
+    return saturate(max(abs(c.x), abs(c.y)) * -3.4482758045196533 + 3.4137930870056152);
+}
+float EdgeFade2(float2 c)
+{
+    return saturate(max(abs(c.x), abs(c.y)) * -11.11111068725586 + 11.0);
+}
+
+void main(
+    float4 iColor : COLOR0,
+    float4 iColor2 : COLOR1,
+    float2 iTex0 : TEXCOORD0,
+#if TWO_TEX
+    float2 iTex1 : TEXCOORD1,
+#endif
+#if SHADOW
+#if TWO_TEX
+    float3 iViewPos : TEXCOORD2,
+    float3 iNormal : TEXCOORD3,
+#if SHADOW == 1
+    float3 iShadow0 : TEXCOORD4,
+#else
+    float4 iShadow0 : TEXCOORD4,
+    float4 iShadow1 : TEXCOORD5,
+    float4 iShadow2 : TEXCOORD6,
+#endif
+#else
+    float3 iViewPos : TEXCOORD1,
+    float3 iNormal : TEXCOORD2,
+#if SHADOW == 1
+    float3 iShadow0 : TEXCOORD3,
+#else
+    float4 iShadow0 : TEXCOORD3,
+    float4 iShadow1 : TEXCOORD4,
+    float4 iShadow2 : TEXCOORD5,
+#endif
+#endif
+#endif
+    float iFog : FOG,
+    out float4 oColor : COLOR0)
+{
+    // ---- textures and alpha
+#if KIND == 4
+    float4 t = lerp(tex2D(sTex1, iTex1), tex2D(sTex0, iTex0), iColor2.w);
+#else
+    float4 t = tex2D(sTex0, iTex0);
+#endif
+#if KIND == 0 || KIND == 4
+    float alpha = t.w * iColor.w;
+#else
+    float alpha = iColor.w;
+#endif
+#if ALPHA_TEST
+    clip(alpha - cFogColor.w);
+#endif
+
+    // ---- shadow term S (1 = lit)
+    float S = 1.0;
+#if SHADOW
+    float fade = EdgeFade(iShadow0.xy);
+#if SHADOW == 1 || SHADOW == 2
+    [branch] if (fade > 0.0099999997764825821) {
+        [branch] if (10.0 < iViewPos.z) {
+            S = fade * (Sum5(sShadow0, iShadow0.xy, iShadow0.z) * 0.20000000298023224 - 1.0) + 1.0;
+        } else {
+            S = fade * (Sum9(sShadow0, iShadow0.xy, iShadow0.z) * 0.1111111119389534 - 1.0) + 1.0;
+        }
+#if SHADOW == 1
+        S = min(S, 1.0);
+#endif
+    }
+#else
+    [branch] if (fade > 0.0) {
+        S = Sum5(sShadow0, iShadow0.xy, iShadow0.z) * 0.20000000298023224;
+    }
+#endif
+    // past the cutoff plane the shadow fades out
+    S = lerp(S, 1.0, saturate(dot(iViewPos, cCutoff.xyz) + cCutoff.w));
+#if SHADOW >= 2
+    float band;
+    [branch] if (max(abs(iShadow1.x), abs(iShadow1.y)) < 1.0) {
+        band = Sum5(sShadow1, iShadow1.xy, iShadow1.z) * 0.20000000298023224;
+    } else {
+        [branch] if (max(abs(iShadow2.x), abs(iShadow2.y)) < 1.0) {
+            band = Sum5(sShadow2, iShadow2.xy, iShadow2.z) * 0.20000000298023224;
+        } else {
+            float3 c3 = float3(iShadow0.w, iShadow1.w, iShadow2.w);
+            band = EdgeFade2(c3.xy) * (Sum5(sShadow3, c3.xy, c3.z) * 0.20000000298023224 - 1.0) + 1.0;
+        }
+    }
+    S = min(band, S);
+#endif
+    // surfaces seen edge-on from the sun lose the shadow
+    float facing = 1.2000000476837158 - abs(dot(cSunDirView.xyz, iNormal));
+    facing = facing * facing;
+    S = lerp(S, 1.0, saturate(facing * facing));
+    float3 light = iColor.xyz * (S * 0.30000001192092896 + 0.699999988079071);
+#else
+    float3 light = iColor.xyz;
+#endif
+
+    // HD: Forever (exterior-lit batch): the shadow takes only the sun, the ambient stays whole
+    [branch] if (cHdPs.x > 0.5) {
+        light = saturate(iColor.xyz + iColor2.xyz * S);
+    }
+
+    // ---- combine (3.3.5: 2 x texture x light, + the environment term, then the fog)
+    float3 col = t.xyz * light;
+    col = col + col;
+#if KIND == 2
+    col = col + t.w * tex2D(sTex1, iTex1).xyz;
+#endif
+#if KIND == 3
+    col = col + (t.w * t.xyz) * tex2D(sTex1, iTex1).xyz;
+#endif
+    oColor = float4((col - cFogColor.xyz) * iFog + cFogColor.xyz, alpha);
+    // HD: test view (hdWmoLight 3): only the sun after the shadow, no texture, no ambient, no fog
+    if (cHdPs.y > 0.5) oColor.xyz = iColor2.xyz * S * 2.0;
+}
+)HLSL";
