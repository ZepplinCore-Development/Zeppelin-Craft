+// Zeppelin F-223A: the video menu's cost measurement (ZepHDOptions.lua, Performance page) writes each result line to
+// hdBenchLog; it is appended to Logs\Bench.log with the time, for the menu's measured costs.
+bool BenchLog(CVar*,const char*,const char*s,void*){
+ if(s&&*s){if(FILE*f=std::fopen("Logs\\Bench.log","ab")){char stamp[32];Stamp(stamp,sizeof stamp);std::fprintf(f,"%s %s\r\n",stamp,s);std::fclose(f);}}
+ return true;
+}
 void Initialize(){
  if(initialized)return;
+ CVar::Register("hdBenchLog","HD: a line set here is appended to Logs\\Bench.log (the menu's cost measurement)",0x80,"",BenchLog,CATEGORY_GRAPHICS,false,nullptr,false);
  CVar*toggle=CVar::Register("hdCataRenderPerf","HD: CPU stages; Logs/CataRenderPerf.log every 2s, no FPS limit changes",1,"0",Toggle,CATEGORY_GRAPHICS,false,nullptr,false);
  info=CVar::Register("hdCataRenderPerfInfo","HD: last CPU measurements (milliseconds per scene render)",0x80,"off",nullptr,CATEGORY_GRAPHICS,false,nullptr,false);
  initialized=true;enabled=toggle&&toggle->m_intValue!=0;g_gxGpuTimerWanted=enabled?1:0;Reset();
@@ -149,6 +156,8 @@ void FrameEnd(){
   if(g_gxGpuFrame&&g_gxGpuFrame(&gpu))std::snprintf(gpuText,sizeof gpuText,"gpu_ms avg=%.2f max=%.2f",gpu.m_avgMs,gpu.m_maxMs);
   std::fprintf(logFile,"%s renderer=%s fps=%.1f frame_ms avg=%.2f p50=%.2f p95=%.2f p99=%.2f max=%.2f | cpu_ms world=%.2f scene=%.2f outside_world=%.2f | %s\r\n",
