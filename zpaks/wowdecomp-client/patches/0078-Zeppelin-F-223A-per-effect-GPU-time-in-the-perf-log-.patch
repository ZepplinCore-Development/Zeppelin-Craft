@@ -23,6 +24,11 @@ bool Read(GxGpuFrame* out) {
     out->m_frames = static_cast<uint32_t>(stats.frames);
     return true;
 }
+
+// Zeppelin F-223A: the stage chain's per-window GPU times (wxl/src/stages/Chain.cpp WindowLine).
+uint32_t StageTimes(char* out, uint32_t size) {
+    return static_cast<uint32_t>(wxlvk::stages::chain::WindowLine(out, size));
+}
 }
 
 void Init() {
@@ -40,10 +46,12 @@ void Init() {
         }
     }
     g_gxGpuFrame = &Read;
+    g_gxStageTimes = &StageTimes;
 }
 
 void Shutdown() {
     if (g_gxGpuFrame == &Read) g_gxGpuFrame = nullptr;
+    if (g_gxStageTimes == &StageTimes) g_gxStageTimes = nullptr;
     s_api = nullptr;
 }
