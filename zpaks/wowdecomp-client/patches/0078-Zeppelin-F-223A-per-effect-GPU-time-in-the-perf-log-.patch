+  // Zeppelin F-223A: each Vulkan effect's own GPU time this window (per run), so its cost shows without toggling it.
+  if(g_gxStageTimes){char stages[1024];if(g_gxStageTimes(stages,sizeof stages))std::fprintf(logFile,"gpu_stages_ms%s (GPU time of each Vulkan effect, average per frame it ran)\r\n",stages);}
   const Settings current=Snapshot();
   if(current!=lastSettings){
    std::fprintf(logFile,"%s settings changed:",stamp);
