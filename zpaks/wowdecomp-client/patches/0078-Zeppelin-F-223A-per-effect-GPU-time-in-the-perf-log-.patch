 }
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Timing.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Timing.cpp
index 1e8e3837..77147d02 100644
--- a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Timing.cpp
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Timing.cpp
@@ -86,6 +86,8 @@ namespace
         lane.sumMs += ms;
         if (ms > lane.maxMs) lane.maxMs = ms;
         ++lane.samples;
+        lane.winSumMs += ms; // Zeppelin F-223A
+        ++lane.winSamples;
     }
 
     /// Reads the lanes the slot's previous run wrote, without waiting.
@@ -140,6 +142,16 @@ namespace wxlvk::stages::timing
 
     const Lane& Get(uint32_t lane) { return g.lanes[lane < kLanes ? lane : 0]; }
 
+    double WindowTake(uint32_t lane, uint64_t& samples)
+    {
+        Lane& l = g.lanes[lane < kLanes ? lane : 0];
+        samples = l.winSamples;
+        const double avg = l.winSamples ? l.winSumMs / static_cast<double>(l.winSamples) : 0.0;
+        l.winSumMs = 0.0;
+        l.winSamples = 0;
+        return avg;
+    }
+
     void Reset()
     {
         for (Lane& l : g.lanes)
