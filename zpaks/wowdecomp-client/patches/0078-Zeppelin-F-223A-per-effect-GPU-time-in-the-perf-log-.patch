diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Chain.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Chain.cpp
index 9c3ec9bc..78d39f7c 100644
--- a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Chain.cpp
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/stages/Chain.cpp
@@ -28,6 +28,7 @@
 
 #include "wxl/Script.hpp"
 
+#include <cstdio>
 #include <cstring>
 
 namespace
@@ -448,6 +449,26 @@ namespace wxlvk::stages::chain
         ReleaseIdle();
     }
 
+    size_t WindowLine(char* out, size_t size)
+    {
+        if (!out || !size) return 0;
+        out[0] = '\0';
+        if (!timing::Available()) return 0;
+        size_t used = 0;
+        for (uint32_t i = 0; i < g.count && used + 1 < size; ++i)
+        {
+            const Stage& s = *g.order[i];
+            uint64_t samples = 0;
+            const double ms = timing::WindowTake(s.lane, samples);
+            if (!samples) continue;
+            const char* name = std::strncmp(s.name, "HD.", 3) == 0 ? s.name + 3 : s.name;
+            const int n = std::snprintf(out + used, size - used, " %s=%.3f", name, ms);
+            if (n < 0 || static_cast<size_t>(n) >= size - used) break;
+            used += static_cast<size_t>(n);
+        }
+        return used;
+    }
+
     void LogStats()
     {
         for (uint32_t p = 0; p < kPoints; ++p)
