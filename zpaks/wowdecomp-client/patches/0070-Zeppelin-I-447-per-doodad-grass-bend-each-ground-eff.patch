@@ -81,14 +82,28 @@ float3 PointLight(int i, float3 vp, float3 n)
 }
 #endif
 
-// Zeppelin F-237: world-plane offset of a grass vertex (position lp in the chunk, uv): the wind grid, bilinear, with
-// a per-blade flutter that grows in gusts, plus the parting around the nearest units. uv.y is 1 at the foot of the
-// blade and 0 at its tip, so the foot stays put on any slope.
-float2 GrassOffset(float3 lp, float2 uv)
+// Zeppelin I-447: the vertex colour's alpha carries the baked terrain shadow and the vertex's bend, written by
+// CDetailDoodadInstBatch::FillVertices from each doodad's own model (HD::GrassBendCodes): lit = 255 - code,
+// shadowed = code, code = bend (0..63, 0 at the foot, 63 at the tip) + 64 when the doodad takes no wind (parting only).
+// Returns the shadow (0 or 1) in x, the bend weight in y and the wind scale (0 or 1) in z.
+float3 GrassBend(float a)
+{
+    float a8 = floor(a * 255.0 + 0.5);
+    float lit = a8 > 127.5 ? 1.0 : 0.0;
+    float code = lit > 0.5 ? 255.0 - a8 : a8;
+    float noWind = code > 63.5 ? 1.0 : 0.0;
+    float bend = (code - 64.0 * noWind) * (1.0 / 63.0);
+    return float3(lit, bend * bend, 1.0 - noWind);
+}
+
+// Zeppelin F-237: world-plane offset of a grass vertex (position lp in the chunk, bend from GrassBend): the wind grid,
+// bilinear, with a per-blade flutter that grows in gusts, plus the parting around the nearest units. The bend is 0 at
+// the foot of the doodad and 1 at its tip, so the foot stays put on any slope (I-447: measured from the doodad's model,
+// not from uv.y, so atlas cards bend too and flat doodads stay still).
+float2 GrassOffset(float3 lp, float3 bend)
 {
     float3 wp = lp + cWind0.xyz;
-    float blade = saturate((1.0 - uv.y - cWind1.x) * cWind1.y);
-    float w = blade * blade;
+    float w = bend.y;
 
     // wind grid lookup, bilinear, clamped to the grid's edge
     float2 g = clamp(wp.xy * cWind2.xy - cWind2.zw, 0.0, 6.999);
@@ -99,7 +114,7 @@ float2 GrassOffset(float3 lp, float2 uv)
     // flutter: a per-blade phase (by position), stronger in gusts
     float phase = cWind0.w * cWind3.x + dot(wp.xy, cWind3.yz);
     float flutter = (wind.z + 0.3) * cWind1.w;
-    float2 offset = wind.xy * (cWind1.z + flutter * sin(phase));
+    float2 offset = wind.xy * ((cWind1.z + flutter * sin(phase)) * bend.z);
 
     // parting: each unit pushes blades away within its radius, only near its own height
     float2 push = 0.0;
@@ -141,10 +156,12 @@ void main(
     out float oFog : FOG)
 {
     float4 vp = iPos.x * cWorldView[0] + iPos.y * cWorldView[1] + iPos.z * cWorldView[2] + cWorldView[3];
+    // Zeppelin I-447: the baked shadow and the bend out of the alpha (GrassBend)
