     // HD: wind + parting, moved in the world plane (rows 0 and 1 of world * view are the world x and y axes in view
     // space: the grass world matrix is a pure translation). Before oPos so fog, fade and received shadows follow.
     [branch] if (cWind6.w > 0.5) {
-        float2 gw = GrassOffset(iPos, iTex0);
+        float2 gw = GrassOffset(iPos, bend);
         vp.xyz += gw.x * cWorldView[0].xyz + gw.y * cWorldView[1].xyz;
     }
     oPos = vp.x * cProj[0] + vp.y * cProj[1] + vp.z * cProj[2] + vp.w * cProj[3];
@@ -178,7 +195,7 @@ void main(
         float3 direct = cSunDiffuse.xyz * saturate(nl);
         // like 3.3.5 (min of the light and 1), a channel never goes over 1: both parts are scaled down together
         float3 fit = 1.0 / max(ambient + direct, 1.0);
-        oColor = float4(ambient * fit * iColor.xyz, iColor.w);
+        oColor = float4(ambient * fit * iColor.xyz, bend.x);
         oColor2.yzw = direct * fit * iColor.xyz;
     } else {
         float3 light = cSunDiffuse.xyz * saturate(dot(cSunDir.xyz, n)) + cSunAmbient.xyz;
@@ -189,7 +206,7 @@ void main(
         light = p2 + light;
 #endif
         light = min(light, 1.0);
-        oColor = float4(light * iColor.xyz, iColor.w);
+        oColor = float4(light * iColor.xyz, bend.x);
     }
     oTex0 = iTex0;
 
@@ -401,6 +418,7 @@ void main(
     int32_t s_shownState = -1;
     int32_t s_inUse = 0;                     // shaders holding our code right now (shown in hdGrassInfo)
     bool s_ours = false;                     // all 14 grass shaders hold our code (vertex constants are needed)
+    bool s_bendEncoded = false;              // Zeppelin I-447: grass buffers are filled with the bend in the alpha
     float s_vertexConstants[44];             // c49..c52 for this frame (DetailDoodadShaders), HD: c53..c59 grass wind per chunk
 
     std::map<CGxShader*, std::vector<uint8_t> > s_original; // Blizzard's code of each shader we changed
@@ -613,6 +631,10 @@ void HD::DetailDoodadShaders() {
     if (mode == 0 && s_inUse == 0) {
         // HD: Blizzard's shaders and nothing of ours in place: touch nothing (no extra D3D call)
