diff --git a/WoW/Source/WorldClient/HD/HdGrassWind.cpp b/WoW/Source/WorldClient/HD/HdGrassWind.cpp
index 38646848..9e04851e 100644
--- a/WoW/Source/WorldClient/HD/HdGrassWind.cpp
+++ b/WoW/Source/WorldClient/HD/HdGrassWind.cpp
@@ -8,12 +8,18 @@
 #include <cmath>
 #include <cstdio>
 #include <cstdint>
+#include <cstring>
 #include <iterator>
+#include <string>
 #include <unordered_map>
+#include <utility>
+#include <vector>
 #include <windows.h>
 #include "Engine/Source/ConsoleBase/ConsoleVar.h"
 #include "Engine/Source/ConsoleBase/Types.h"
 #include "Engine/Source/Gx/CGxDevice/CGxDevice.h"
+#include "Engine/Source/Model2/M2Data.h"
+#include "WoW/Source/WorldClient/HD/HdDataFile.h"
 #include "WoW/Source/WorldClient/HD/HdLivingWind.h"
 #include "WoW/Source/WorldClient/HD/HdLivingWorld.h"
 #include "WoW/Source/WorldClient/World.h"
@@ -23,7 +29,7 @@ namespace {
     const float kAmplitude = 0.35f;        // tip displacement in yards at wind strength 1
     const float kFlutter = 0.08f;          // extra per-blade shimmer, yards
     const float kFlutterSpeed = 3.0f;      // shimmer speed, radians per second
-    const float kAnchor = 0.3f;            // bottom fraction of a blade that never moves (the UV rule; HD's value)
+    const float kAnchor = 0.3f;            // bottom fraction of a blade (root to tip) that never moves
     const float kPushStrength = 0.5f;      // how far blades lean away from a unit, yards
     const float kMinRadius = 0.5f;         // smallest push radius, yards
     const float kMountedScale = 2.0f;      // extra radius factor while mounted
@@ -65,6 +71,156 @@ namespace {
     uint64_t CellKey(int cx, int cy) {
         return (static_cast<uint64_t>(static_cast<uint32_t>(cx)) << 32) | static_cast<uint32_t>(cy);
     }
+
+    // --- Zeppelin I-447: per-doodad bend (Living Azeroth features/GrassDoodads.cpp, measured here from the model the
+    // client builds the grass from instead of through its offsets) ---------------------------------------------------
+    constexpr float kRootTipBand = 0.12f;  // lowest / highest fraction of the height = root / tip
+    constexpr float kFlatHeight = 0.15f;   // shorter than this a doodad does not sway (pebbles, flat decals)
+    constexpr uint8_t kNoWindBit = 64;
+    enum OverrideFlags : uint32_t { kNoWind = 0x01, kNoPush = 0x02, kFlip = 0x10 };
+
+    struct Override {
+        uint32_t flags = 0;
+        float stiffness = 0.0f;            // 0 flexible .. 1 rigid
+        float rootV = -1.0f;               // -1 = measured
+        float tipV = -1.0f;
+    };
+
+    struct Bend {
+        const void* modelKey = nullptr;    // the model's shared data it was measured from
+        std::vector<uint8_t> codes;        // per skin vertex
+        float height = 0.0f, rootV = 1.0f, tipV = 0.0f;
+        bool flat = false, mapped = false, overridden = false, wind = true, push = true;
+    };
+
+    std::vector<Bend> s_bends;             // by GroundEffectDoodad ID
+    std::unordered_map<uint32_t, Override> s_overrides;
+    bool s_overridesTried = false;
+    uint32_t s_measured = 0, s_flat = 0, s_unmapped = 0;
+    CVar* s_bendShow = nullptr;
+    CVar* s_bendInfo = nullptr;
+    int32_t s_bendShown = -2;
+    uint32_t s_bendInfoMeasured = 0xFFFFFFFFu;
+
+    // DBFilesClient\GroundEffectDoodadWind.cdbc: ID, Flags, Stiffness, RootV, TipV (WDBC, 4-byte fields).
+    void LoadOverrides() {
+        s_overridesTried = true;
+        std::string data;
+        if (!HD::DataFile::Read("DBFilesClient\\GroundEffectDoodadWind.cdbc", data)) return;
+        if (data.size() < 20 || std::memcmp(data.data(), "WDBC", 4) != 0) return;
+        uint32_t header[4];
+        std::memcpy(header, data.data() + 4, sizeof(header));
+        const uint32_t count = header[0], fields = header[1], recordSize = header[2];
+        if (fields < 5 || recordSize < 20 || 20 + uint64_t(count) * recordSize > data.size()) return;
+        for (uint32_t i = 0; i < count; ++i) {
+            uint32_t v[5];
+            std::memcpy(v, data.data() + 20 + size_t(i) * recordSize, sizeof(v));
+            Override o;
+            o.flags = v[1];
+            std::memcpy(&o.stiffness, &v[2], sizeof(float));
+            std::memcpy(&o.rootV, &v[3], sizeof(float));
+            std::memcpy(&o.tipV, &v[4], sizeof(float));
+            s_overrides[v[0]] = o;
+        }
+    }
+
+    void Measure(uint32_t id, Bend& b, const M2Data* data, const M2SkinProfile* skin) {
+        const uint32_t count = skin->m_vertices.m_count;
+        b.codes.assign(count, 0);
+        if (!count) return;
+        // root and tip from the model: bounds, then the mean V of the lowest and highest bands
+        float minZ = 1e30f, maxZ = -1e30f;
+        for (uint32_t j = 0; j < count; ++j) {
+            const float z = data->m_vertices[skin->m_vertices[j]].m_position.z;
+            if (z < minZ) minZ = z;
+            if (z > maxZ) maxZ = z;
+        }
+        const float band = (maxZ - minZ) * kRootTipBand;
+        float rootSum = 0.0f, tipSum = 0.0f;
+        uint32_t rootN = 0, tipN = 0;
+        for (uint32_t j = 0; j < count; ++j) {
+            const M2Vertex& v = data->m_vertices[skin->m_vertices[j]];
+            if (v.m_position.z <= minZ + band) { rootSum += v.m_texcoord[0].y; ++rootN; }
+            if (v.m_position.z >= maxZ - band) { tipSum += v.m_texcoord[0].y; ++tipN; }
+        }
+        b.height = maxZ - minZ;
+        b.rootV = rootN ? rootSum / rootN : 1.0f;
+        b.tipV = tipN ? tipSum / tipN : 0.0f;
+        b.flat = b.height < kFlatHeight;
+        const bool valid = std::fabs(b.tipV - b.rootV) > 0.01f || b.flat;
+
+        // effective values: measured, or the override row
+        float rootV = b.rootV, tipV = b.tipV, stiffness = 0.0f;
+        bool flip = false;
+        auto it = s_overrides.find(id);
+        b.overridden = it != s_overrides.end();
+        if (!b.overridden) {
+            b.mapped = valid;
+            b.wind = b.push = !b.flat;
+        } else {
+            const Override& o = it->second;
+            if (o.rootV >= 0.0f) rootV = o.rootV;
+            if (o.tipV >= 0.0f) tipV = o.tipV;
+            b.mapped = valid || (o.rootV >= 0.0f && o.tipV >= 0.0f); // a manual mapping makes it usable
+            b.wind = !(o.flags & kNoWind);
+            b.push = !(o.flags & kNoPush);
+            flip = (o.flags & kFlip) != 0;
+            stiffness = o.stiffness < 0.0f ? 0.0f : (o.stiffness > 1.0f ? 1.0f : o.stiffness);
+        }
+        if (!b.mapped) {
+            // no usable root / tip: the old rule, foot at v = 1, tip at v = 0, full wind and parting
+            rootV = 1.0f;
+            tipV = 0.0f;
+            b.wind = b.push = true;
+            flip = false;
+            stiffness = 0.0f;
+        }
+        if (flip) std::swap(rootV, tipV);
+        if (!b.wind && !b.push) return; // never moves (codes stay 0)
+        // a doodad with wind but no parting cannot be told apart in the 7 bits: it keeps both
+        const float span = tipV - rootV;
+        const float inv = std::fabs(span) > 1e-4f ? 1.0f / span : 0.0f;
+        const float flex = std::sqrt(1.0f - stiffness); // the shader squares the code: weight x (1 - stiffness)
+        const uint8_t noWind = b.wind ? 0 : kNoWindBit;
+        for (uint32_t j = 0; j < count; ++j) {
+            const float v = data->m_vertices[skin->m_vertices[j]].m_texcoord[0].y;
+            float t = (v - rootV) * inv;
+            t = t < 0.0f ? 0.0f : (t > 1.0f ? 1.0f : t);
+            float blade = (t - kAnchor) / (1.0f - kAnchor);
+            blade = blade < 0.0f ? 0.0f : (blade > 1.0f ? 1.0f : blade);
+            const int q = static_cast<int>(blade * flex * 63.0f + 0.5f);
+            b.codes[j] = static_cast<uint8_t>((q > 63 ? 63 : q) | noWind);
+        }
+    }
+
+    void ShowBendInfo() {
+        if (!s_bendInfo) return;
+        const int32_t show = s_bendShow ? s_bendShow->m_intValue : 0;
+        if (show == s_bendShown && s_measured == s_bendInfoMeasured) return;
+        s_bendShown = show;
+        s_bendInfoMeasured = s_measured;
+        char text[400];
+        int n = snprintf(text, sizeof(text), "%u doodads measured (%u flat, %u old rule), %u override rows", s_measured, s_flat,
+            s_unmapped, static_cast<unsigned>(s_overrides.size()));
+        if (show > 0) {
+            const Bend* b = static_cast<uint32_t>(show) < s_bends.size() && s_bends[show].modelKey ? &s_bends[show] : nullptr;
+            if (!b) {
+                snprintf(text + n, sizeof(text) - n, "; doodad %d not measured yet", show);
+            } else {
+                uint8_t lo = 255, hi = 0;
+                for (uint8_t c : b->codes) {
+                    const uint8_t q = c & 63;
+                    if (q < lo) lo = q;
+                    if (q > hi) hi = q;
+                }
