+// SPDX-License-Identifier: GPL-3.0-or-later
+// Zeppelin I-442: depth-only sun contact shadows under Vulkan (see HdVulkanContact.h). The passes are HdContact.comp's:
+// generate (ray + the client's shadow maps), blur across, blur down, apply -- the D3D9 version's four, as compute.
+#include "HdVulkanContact.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <new>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/Services/Texture.h"
+#include "Engine/Source/ShaderEffect/ShadowCache.h"
+#include "WoW/Source/WorldClient/DayNight__DNInfo.h"
+#include "WoW/Source/WorldClient/HD/HdContactShadow.h"
+#include "native/Present.hpp"
+#include "native/Slots.hpp"
+#include "vulkan/Texture.hpp"
+
+namespace HD::VulkanContact {
+namespace {
+#include "shaders/contact/HdContact.spv.h"
+constexpr uint32_t MaxSlots = 8, PassCount = 4, MaxUnits = 16;
+constexpr float SkyDepth = .99999f, FadeStart = 80.0f, FadeLength = 40.0f;
+
+struct alignas(16) Constants {
+    float screen[4], view[4], rect[4], depth[4], params[4], blur[4], light[4], ambient[4], diffuse[4], shadow[4];
+    float smat[9][4], unit[MaxUnits][4], up[4], pcf[2][4];
+};
+static_assert(sizeof(Constants) == 38 * 16, "std140 Params in HdContact.comp");
+
+struct Impl {
+    const WXL_VkRenderApi* api = nullptr;
+    WXL_VkDeviceInfo device{};
+    VkDescriptorSetLayout setLayout = VK_NULL_HANDLE;
+    VkPipelineLayout pipelineLayout = VK_NULL_HANDLE;
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    VkSampler sampler = VK_NULL_HANDLE;
+    VkPipeline pipeline = VK_NULL_HANDLE;
+    struct Slot {
+        void* handles[2]{};
+        WXL_VkImageInfo images[2]{};
+        VkDescriptorSet sets[PassCount]{};
+        void* uniform = nullptr;
+        WXL_VkBufferInfo buffer{};
+        bool initialized = false;
+        uint64_t serial = 0;
+    };
+    std::array<Slot, MaxSlots> slots{};
+    uint32_t width = 0, height = 0, failedWidth = 0, failedHeight = 0;
+    uint64_t lastSerial = 0;
+#define CT_FUNCTIONS(X) \
+    X(CreateDescriptorSetLayout) X(DestroyDescriptorSetLayout) X(CreatePipelineLayout) X(DestroyPipelineLayout) \
+    X(CreateDescriptorPool) X(DestroyDescriptorPool) X(AllocateDescriptorSets) X(UpdateDescriptorSets) \
+    X(CreateSampler) X(DestroySampler) X(CreateShaderModule) X(DestroyShaderModule) \
+    X(CreateComputePipelines) X(DestroyPipeline) X(CmdPipelineBarrier) X(CmdBindPipeline) \
+    X(CmdBindDescriptorSets) X(CmdPushConstants) X(CmdDispatch)
+#define CT_DECLARE(n) PFN_vk##n n = nullptr;
+    CT_FUNCTIONS(CT_DECLARE)
+#undef CT_DECLARE
+};
+
+Impl* g = nullptr;
+void* registration = nullptr;
+Settings config;
+char status[160] = "off";
+
+void SetStatus(const char* s) { std::snprintf(status, sizeof status, "%s", s); }
+
+bool Resize(uint32_t w, uint32_t h) {
+    if (!g || !w || !h || w > 16384 || h > 16384) return false;
+    if (g->width == w && g->height == h) return true;
+    if (g->failedWidth == w && g->failedHeight == h) return false;
+    std::array<std::array<void*, 2>, MaxSlots> handles{};
+    std::array<std::array<WXL_VkImageInfo, 2>, MaxSlots> images{};
+    WXL_VkImageDesc desc{VK_FORMAT_R8G8B8A8_UNORM, w, h, 1, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT, VK_IMAGE_ASPECT_COLOR_BIT};
+    bool okay = true;
+    for (uint32_t i = 0; i < g->device.frameSlots && okay; ++i)
+        for (uint32_t j = 0; j < 2; ++j)
+            if (!(handles[i][j] = g->api->CreateImage(&desc, &images[i][j]))) { okay = false; break; }
+    if (!okay) {
+        for (auto& slot : handles) for (auto handle : slot) if (handle) g->api->RetireImage(handle, 0);
+        g->failedWidth = w; g->failedHeight = h;
+        return false;
+    }
+    for (uint32_t i = 0; i < g->device.frameSlots; ++i) {
+        auto& slot = g->slots[i];
+        for (uint32_t j = 0; j < 2; ++j) {
+            if (slot.handles[j]) g->api->RetireImage(slot.handles[j], slot.serial);
+            slot.handles[j] = handles[i][j]; slot.images[j] = images[i][j];
+        }
+        slot.initialized = false;
+    }
+    g->width = w; g->height = h; g->failedWidth = g->failedHeight = 0;
+    return true;
+}
+
+// One of the client's sun shadow cascades as a sampled R32F image (shadow quality high or very high), as the full
+// path's CaptureNativeMaps finds them; null when it is missing or not readable now.
+const wxlvk::vk::texture::Image* Band(int i) {
+    if (CShadowCache::GetShadowMode() <= SHADOW_MEDIUM) return nullptr;
+    CShadowBand& band = CShadowCache::s_extShadowBands[i];
+    CTexture* texture = band.m_textures[band.m_current];
+    if (!texture) return nullptr;
+    const wxlvk::vk::texture::Image* image = nullptr;
+    auto* gx = TextureGetGxTex(texture, 1, nullptr);
+    if (!gx || !wxlvk::native::impl::ResolveTexture(gx, image) || !image || image->format != VK_FORMAT_R32_SFLOAT || !image->view) return nullptr;
+    if (image->layout != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL && image->layout != VK_IMAGE_LAYOUT_GENERAL) return nullptr;
+    return image;
+}
+
+bool BuildConstants(const WXL_VkStageContext& ctx, Constants& c, bool& shadows, uint32_t& units, bool& forever) {
+    if (!ctx.sceneValid || !ctx.scene || !ctx.extent.width || !ctx.extent.height) return false;
+    const float* p = ctx.scene->projection;
+    const auto& vp = ctx.viewport;
+    for (int i = 0; i < 16; ++i) if (!std::isfinite(p[i])) return false;
+    // a perspective projection (z_view = d2 / (z - c2)); anything else is skipped, as on D3D9
+    if (p[0] == 0 || p[5] == 0 || p[11] != 1 || p[15] != 0 || p[10] <= 0 || p[14] >= 0 || vp.width <= 0 || vp.height <= 0 || vp.maxDepth <= vp.minDepth) return false;
+    c = Constants{};
+    c.screen[0] = 1.0f / ctx.extent.width; c.screen[1] = 1.0f / ctx.extent.height;
+    c.screen[2] = 1 / (vp.maxDepth - vp.minDepth); c.screen[3] = -vp.minDepth * c.screen[2];
+    c.view[0] = 2 / p[0]; c.view[1] = -2 / p[5]; c.view[2] = (-1 - p[8]) / p[0]; c.view[3] = (1 - p[9]) / p[5];
+    c.rect[0] = vp.x * c.screen[0]; c.rect[1] = vp.y * c.screen[1]; c.rect[2] = ctx.extent.width / vp.width; c.rect[3] = ctx.extent.height / vp.height;
+    c.depth[0] = p[10]; c.depth[1] = -p[14]; c.depth[2] = SkyDepth; c.depth[3] = ctx.swapRB ? 1.0f : 0.0f;
+    c.params[0] = std::clamp(config.length, .25f, 6.0f); c.params[1] = std::clamp(config.strength, 0.0f, 1.0f);
+    c.params[2] = static_cast<float>(config.debug); c.params[3] = std::clamp(config.thickness, .05f, 4.0f);
+    c.blur[0] = 24.0f; c.blur[2] = FadeStart; c.blur[3] = 1.0f / FadeLength;   // 24 ray steps, as on D3D9
+    // the light the shadow maps use (CShadowQuery::Update: the world light, hdShadowSun included), which falls along
+    // s_sunDir; into view space with the frame's own view matrix (row vectors), reversed -- as the D3D9 version does
+    // (s_sunDirViewSpace is made with whatever view the stack held when the shadows were updated)
+    const float* view = ctx.scene->view;
+    const C3Vector& fall = CShadowCache::s_sunDir;
+    for (int j = 0; j < 3; ++j) c.light[j] = -(fall.x * view[j] + fall.y * view[4 + j] + fall.z * view[8 + j]);
+    const float ll = std::sqrt(c.light[0] * c.light[0] + c.light[1] * c.light[1] + c.light[2] * c.light[2]);
+    if (!(ll > 1e-4f)) return false;
+    for (int j = 0; j < 3; ++j) c.light[j] /= ll;
+    // the client's light now (DayNight's m_light1, gamma as the shaders use it); Forever ground lighting keeps the ambient
+    static CVar* terrainLight = nullptr;
+    if (!terrainLight) terrainLight = CVar::Lookup("hdTerrainLight");
+    forever = terrainLight && terrainLight->m_intValue == 1;
+    const CImVector& amb = DayNight::g_dnInfo.m_light1.m_ambient;
+    const CImVector& dif = DayNight::g_dnInfo.m_light1.m_diffuse;
+    c.ambient[0] = amb.r / 255.0f; c.ambient[1] = amb.g / 255.0f; c.ambient[2] = amb.b / 255.0f; c.ambient[3] = forever ? 1.0f : 0.0f;
+    c.diffuse[0] = dif.r / 255.0f; c.diffuse[1] = dif.g / 255.0f; c.diffuse[2] = dif.b / 255.0f;
+    // the client's sun shadow cascades (view space -> map), so what they already shadow is not shadowed again
+    shadows = Band(0) && Band(1) && Band(2);
+    c.shadow[0] = shadows ? 1.0f : 0.0f;
+    if (shadows) std::memcpy(c.smat, &CShadowCache::s_shadowMatrices[3].x, sizeof c.smat);
+    // the characters near the camera (camera-relative world -> view space, rotation only) and the world's up
+    // (the D3D9 version's hdContactShadowUnits 1 -- characters cast too -- is honoured when that cvar exists)
+    static CVar* unitsCast = nullptr;
+    if (!unitsCast) unitsCast = CVar::Lookup("hdContactShadowUnits");
+    HD::ContactShadowUnit list[MaxUnits];
+    units = unitsCast && unitsCast->m_intValue ? 0u : static_cast<uint32_t>(std::max(0, HD::ContactShadowGatherUnits(list, MaxUnits)));
+    for (uint32_t i = 0; i < units; ++i) {
+        for (int j = 0; j < 3; ++j) c.unit[i][j] = list[i].x * view[j] + list[i].y * view[4 + j] + list[i].z * view[8 + j];
+        c.unit[i][3] = list[i].height;
+    }
+    float ux = view[8], uy = view[9], uz = view[10], ul = std::sqrt(ux * ux + uy * uy + uz * uz);
+    if (!(ul > 1e-6f)) { ux = 0; uy = 1; uz = 0; ul = 1; }
+    c.up[0] = ux / ul; c.up[1] = uy / ul; c.up[2] = uz / ul; c.up[3] = static_cast<float>(units);
+    const C4Vector* o = CShadowCache::s_pcfOffsets;
+    c.pcf[0][0] = o[0].x; c.pcf[0][1] = o[0].y; c.pcf[0][2] = o[2].x; c.pcf[0][3] = o[2].y;
+    c.pcf[1][0] = o[4].x; c.pcf[1][1] = o[4].y; c.pcf[1][2] = o[6].x; c.pcf[1][3] = o[6].y;
+    const float* f = reinterpret_cast<const float*>(&c);
+    for (size_t i = 0; i < sizeof c / sizeof(float); ++i) if (!std::isfinite(f[i])) return false;
+    return true;
+}
+
+void Record(const WXL_VkStageContext& ctx) {
+    if (!g || !config.enabled) return;
+    if (ctx.structSize < offsetof(WXL_VkStageContext, jitter) || !ctx.cmd || !ctx.colorView || !ctx.depthView || !ctx.serial ||
+        ctx.frameSlot >= g->device.frameSlots || ctx.colorFormat != VK_FORMAT_R8G8B8A8_UNORM || ctx.colorLayout != VK_IMAGE_LAYOUT_GENERAL) {
+        SetStatus("contact skipped: frame or depth unavailable");
+        return;
+    }
+    if (!Resize(ctx.extent.width, ctx.extent.height)) { SetStatus("contact skipped: image allocation failed"); return; }
+    auto& slot = g->slots[ctx.frameSlot];
+    if (slot.serial == ctx.serial || slot.serial > ctx.completedSerial) { SetStatus("contact skipped: slot in flight"); return; }
+    Constants c;
+    bool shadows = false, forever = false;
+    uint32_t units = 0;
+    if (!BuildConstants(ctx, c, shadows, units, forever)) { SetStatus("contact skipped: projection / light unsupported this frame"); return; }
+    std::memcpy(slot.buffer.mapped, &c, sizeof c);
+    g->api->FlushBuffer(slot.uniform);
+
+    // the slot's two masks to GENERAL (their first use discards), ordered after the stage's earlier writes
+    std::array<VkImageMemoryBarrier, 2> barriers{};
+    for (uint32_t i = 0; i < 2; ++i) {
+        auto& b = barriers[i];
+        b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+        b.oldLayout = slot.initialized ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_UNDEFINED;
+        b.newLayout = VK_IMAGE_LAYOUT_GENERAL; b.image = slot.images[i].image;
+        b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        b.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT; b.subresourceRange.levelCount = b.subresourceRange.layerCount = 1;
+        b.srcAccessMask = slot.initialized ? VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT : 0;
+        b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    }
+    g->CmdPipelineBarrier(ctx.cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers.data());
+    VkMemoryBarrier between{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    between.srcAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    between.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+
+    const wxlvk::vk::texture::Image* maps[3] = {Band(0), Band(1), Band(2)};
+    // generate 0 -> mask 0, blur across 0 -> 1, blur down 1 -> 0, apply from 0
+    static const uint32_t src[PassCount] = {1, 0, 1, 0}, dst[PassCount] = {0, 1, 0, 1};
+    for (uint32_t pass = 0; pass < PassCount; ++pass) {
+        VkDescriptorImageInfo images[7]{};
+        images[0] = {g->sampler, ctx.depthView, ctx.depthLayout};
+        for (int i = 0; i < 3; ++i)
+            images[1 + i] = shadows && maps[i] ? VkDescriptorImageInfo{g->sampler, maps[i]->view, maps[i]->layout}
+                                               : VkDescriptorImageInfo{g->sampler, ctx.depthView, ctx.depthLayout};
+        images[4] = {g->sampler, slot.images[src[pass]].view, VK_IMAGE_LAYOUT_GENERAL};
+        images[5] = {VK_NULL_HANDLE, slot.images[dst[pass]].view, VK_IMAGE_LAYOUT_GENERAL};
+        images[6] = {VK_NULL_HANDLE, ctx.colorView, ctx.colorLayout};
+        VkDescriptorBufferInfo buffer{slot.buffer.buffer, 0, sizeof c};
+        VkWriteDescriptorSet writes[8]{};
+        for (uint32_t i = 0; i < 8; ++i) {
+            auto& w = writes[i];
+            w.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET; w.dstSet = slot.sets[pass]; w.dstBinding = i; w.descriptorCount = 1;
+            w.descriptorType = i < 5 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER : (i < 7 ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER);
+            if (i < 7) w.pImageInfo = &images[i]; else w.pBufferInfo = &buffer;
+        }
+        g->UpdateDescriptorSets(g->device.device, 8, writes, 0, nullptr);
+        const uint32_t flags[4] = {pass, 0, 0, 0};
+        g->CmdBindPipeline(ctx.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, g->pipeline);
+        g->CmdBindDescriptorSets(ctx.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, g->pipelineLayout, 0, 1, &slot.sets[pass], 0, nullptr);
+        g->CmdPushConstants(ctx.cmd, g->pipelineLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof flags, flags);
+        g->CmdDispatch(ctx.cmd, (g->width + 7) / 8, (g->height + 7) / 8, 1);
+        g->CmdPipelineBarrier(ctx.cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &between, 0, nullptr, 0, nullptr);
+    }
+    slot.initialized = true;
+    slot.serial = g->lastSerial = ctx.serial;
+    char text[160];
+    std::snprintf(text, sizeof text, "shadow maps %s, ground shadow %s, characters receive only (%u near)%s",
+                  shadows ? "R32F" : "none (shadow quality below high: no check)", forever ? "Forever (ambient)" : "3.3.5 (70%)",
+                  units, config.debug ? ", test view (hdSunDebug 2)" : "");
+    SetStatus(text);
+}
+
+int __cdecl Wanted(void*) { return g && config.enabled ? 1 : 0; }
+void __cdecl Stage(void*, const WXL_VkStageContext* ctx) { if (ctx) Record(*ctx); }
+
+void Destroy() {
+    if (!g) return;
+    for (auto& slot : g->slots) {
+        for (auto handle : slot.handles) if (handle) g->api->RetireImage(handle, slot.serial);
+        if (slot.uniform) g->api->RetireBuffer(slot.uniform, slot.serial);
+    }
+    if (g->pool) g->DestroyDescriptorPool(g->device.device, g->pool, nullptr);
+    if (g->sampler) g->DestroySampler(g->device.device, g->sampler, nullptr);
+    if (g->pipeline) g->DestroyPipeline(g->device.device, g->pipeline, nullptr);
+    if (g->pipelineLayout) g->DestroyPipelineLayout(g->device.device, g->pipelineLayout, nullptr);
+    if (g->setLayout) g->DestroyDescriptorSetLayout(g->device.device, g->setLayout, nullptr);
+    delete g;
+    g = nullptr;
+}
+}
+
+bool Init(const WXL_VkRenderApi* api) {
+    if (g) return true;
+    if (!api || api->structSize < offsetof(WXL_VkRenderApi, RetireImage) + sizeof(api->RetireImage) || !api->GetDeviceInfo || !api->CreateImage ||
+        !api->RetireImage || !api->CreateBuffer || !api->RetireBuffer || !api->FlushBuffer || !api->RegisterStage) return false;
+    g = new (std::nothrow) Impl();
+    if (!g) return false;
+    g->api = api;
+    g->device.structSize = sizeof g->device;
+    if (!api->GetDeviceInfo(&g->device) || !g->device.device || !g->device.getDeviceProcAddr || !g->device.frameSlots || g->device.frameSlots > MaxSlots) {
+        delete g; g = nullptr; return false;
+    }
+#define CT_LOAD(n) g->n = reinterpret_cast<PFN_vk##n>(g->device.getDeviceProcAddr(g->device.device, "vk" #n)); if (!g->n) { delete g; g = nullptr; return false; }
+    CT_FUNCTIONS(CT_LOAD)
+#undef CT_LOAD
+    auto fail = [](const char* why) { SetStatus(why); Destroy(); return false; };
+    std::array<VkDescriptorSetLayoutBinding, 8> bindings{};
+    for (uint32_t i = 0; i < 8; ++i) {
+        bindings[i].binding = i; bindings[i].descriptorCount = 1; bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        bindings[i].descriptorType = i < 5 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER : (i < 7 ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER);
+    }
+    VkDescriptorSetLayoutCreateInfo sl{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    sl.bindingCount = 8; sl.pBindings = bindings.data();
+    if (g->CreateDescriptorSetLayout(g->device.device, &sl, nullptr, &g->setLayout) != VK_SUCCESS) return fail("contact: descriptor layout");
+    VkPushConstantRange push{VK_SHADER_STAGE_COMPUTE_BIT, 0, 16};
+    VkPipelineLayoutCreateInfo pl{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    pl.setLayoutCount = 1; pl.pSetLayouts = &g->setLayout; pl.pushConstantRangeCount = 1; pl.pPushConstantRanges = &push;
+    if (g->CreatePipelineLayout(g->device.device, &pl, nullptr, &g->pipelineLayout) != VK_SUCCESS) return fail("contact: pipeline layout");
+    VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    ci.codeSize = sizeof kHdContact; ci.pCode = kHdContact;
+    VkShaderModule module = VK_NULL_HANDLE;
+    if (g->CreateShaderModule(g->device.device, &ci, nullptr, &module) != VK_SUCCESS) return fail("contact: shader module");
+    VkComputePipelineCreateInfo cp{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+    cp.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO; cp.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+    cp.stage.module = module; cp.stage.pName = "main"; cp.layout = g->pipelineLayout;
+    const VkResult result = g->CreateComputePipelines(g->device.device, g->device.pipelineCache, 1, &cp, nullptr, &g->pipeline);
+    g->DestroyShaderModule(g->device.device, module, nullptr);
+    if (result != VK_SUCCESS) return fail("contact: compute pipeline");
+    // point sampling, clamped: the depth, the R32F distances and the masks are all read texel for texel
+    VkSamplerCreateInfo sampler{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+    sampler.magFilter = sampler.minFilter = VK_FILTER_NEAREST; sampler.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    sampler.addressModeU = sampler.addressModeV = sampler.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    if (g->CreateSampler(g->device.device, &sampler, nullptr, &g->sampler) != VK_SUCCESS) return fail("contact: sampler");
+    const uint32_t count = PassCount * g->device.frameSlots;
+    VkDescriptorPoolSize sizes[3] = {{VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 5 * count}, {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 2 * count}, {VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, count}};
+    VkDescriptorPoolCreateInfo pool{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    pool.maxSets = count; pool.poolSizeCount = 3; pool.pPoolSizes = sizes;
+    if (g->CreateDescriptorPool(g->device.device, &pool, nullptr, &g->pool) != VK_SUCCESS) return fail("contact: descriptor pool");
+    std::array<VkDescriptorSetLayout, MaxSlots * PassCount> layouts{};
+    layouts.fill(g->setLayout);
+    std::array<VkDescriptorSet, MaxSlots * PassCount> sets{};
+    VkDescriptorSetAllocateInfo alloc{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+    alloc.descriptorPool = g->pool; alloc.descriptorSetCount = count; alloc.pSetLayouts = layouts.data();
+    if (g->AllocateDescriptorSets(g->device.device, &alloc, sets.data()) != VK_SUCCESS) return fail("contact: descriptor sets");
+    for (uint32_t i = 0; i < g->device.frameSlots; ++i) {
+        for (uint32_t j = 0; j < PassCount; ++j) g->slots[i].sets[j] = sets[i * PassCount + j];
+        WXL_VkBufferDesc desc{sizeof(Constants), VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT, WXL_VK_MEMORY_HOST};
+        auto& slot = g->slots[i];
+        slot.uniform = api->CreateBuffer(&desc, &slot.buffer);
+        if (!slot.uniform || !slot.buffer.mapped) return fail("contact: constant buffer");
+    }
+    // after the full path's stage (order 50): the two never run in the same frame
+    WXL_VkStageDesc stage{};
+    stage.structSize = sizeof stage; stage.point = WXL_VK_POINT_AFTER_OPAQUE_WORLD; stage.order = 55;
+    stage.flags = WXL_VK_STAGE_NEEDS_DEPTH | WXL_VK_STAGE_WRITES_COLOR; stage.Wanted = Wanted; stage.Run = Stage;
+    registration = api->RegisterStage(&stage, "HD.SunContactDepth");
+    if (!registration) return fail("contact: stage registration failed");
+    SetStatus("off");
+    return true;
+}
+
+void Configure(const Settings& settings) {
+    config = settings;
+    if (!config.enabled) SetStatus("off");
+}
+
+const char* Status() { return status; }
+
+bool Shutdown() {
+    if (!g) return true;
+    if (registration && g->api->UnregisterStage) { g->api->UnregisterStage(registration); registration = nullptr; }
+    if (g->lastSerial > wxlvk::native::present::Completed()) {
+        if (wxlvk::native::present::FrameOpen() && !wxlvk::native::present::FlushAndWait()) return false;
+        if (!wxlvk::native::present::WaitSerial(g->lastSerial)) return false;
+    }
+    config.enabled = false;
+    Destroy();
+    SetStatus("off");
+    return true;
+}
+}
