diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/contact/HdContact.comp b/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/contact/HdContact.comp
new file mode 100644
index 00000000..9df62214
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/contact/HdContact.comp
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Zeppelin I-442: depth-only sun contact shadows under Vulkan (hd/HdVulkanContact.cpp), for when the G-buffer sun
+// shadows cannot run (MSAA on). A compute port of the D3D9 Waystone HD contact shadows (WoW/Source/WorldClient/HD/
+// HdContactShadow.cpp, v4 as tuned in game): same ray, same "union with the shaders' own shadow" darkness, same blur,
+// same character capsules. One module, four passes by push constant: 0 generate (with the shadow maps' answer),
+// 1 blur across, 2 blur down, 3 apply (the frame times what is left of its light).
+#version 450
+layout(local_size_x=8,local_size_y=8) in;
+layout(set=0,binding=0) uniform sampler2D depthTex;   // the resolved scene depth (sample 0 under MSAA), raw D3D depth
+layout(set=0,binding=1) uniform sampler2D shadow0;    // the client's sun shadow cascades, R32F distances
+layout(set=0,binding=2) uniform sampler2D shadow1;
+layout(set=0,binding=3) uniform sampler2D shadow2;
+layout(set=0,binding=4) uniform sampler2D maskSrc;    // the previous pass's mask
+layout(rgba8,set=0,binding=5) uniform writeonly image2D maskDst;
+layout(rgba8,set=0,binding=6) uniform image2D sceneColour;
+layout(std140,set=0,binding=7) uniform Params {
+ vec4 screen;   // 1/width, 1/height, depth scale A, depth offset B (z01 = raw * A + B)
+ vec4 view;     // view xy = (local uv * xy + zw) * view z
+ vec4 rect;     // world viewport in target uv: offset xy, 1 / size zw
+ vec4 depth;    // projection c2, -d2, sky threshold, swapRB
+ vec4 params;   // ray length (yards), strength, debug, occluder thickness (yards)
+ vec4 blur;     // x ray steps (24), unused, fade start (yards), 1 / fade length
+ vec4 light;    // view-space direction to the world light
+ vec4 ambient;  // the client's ambient light now (gamma); w = 1: Forever ground lighting
+ vec4 diffuse;  // the client's world light colour now (gamma)
+ vec4 shadow;   // x 1 = shadow maps bound
+ vec4 smat[9];  // view space -> shadow map, 3 rows per cascade
+ vec4 unit[16]; // characters near the camera: view-space feet xyz, height
+ vec4 up;       // view-space world up xyz, number of characters
+ vec4 pcf[2];   // the shaders' 5-tap PCF offsets in map uv
+} c;
+layout(push_constant) uniform Pass {uvec4 flags;} pc;   // x pass
+
+vec4 ViewPos(vec2 uv){
+ vec2 local=(uv-c.rect.xy)*c.rect.zw;
+ float raw=textureLod(depthTex,uv,0).r;float z01=raw*c.screen.z+c.screen.w;float z=c.depth.y/max(c.depth.x-z01,1e-7);
+ bool inside=all(equal(local,clamp(local,0.0,1.0)));
+ return vec4((local*c.view.xy+c.view.zw)*z,z,(inside&&z01<c.depth.z)?1.0:0.0);
+}
+vec2 TargetUv(vec3 q){return ((q.xy/q.z-c.view.zw)/c.view.xy)/c.rect.zw+c.rect.xy;}
+float Noise(vec2 vpos){return fract(52.9829189*fract(dot(vpos,vec2(0.06711056,0.00583715))));}
+float Tap(int i,vec2 uv,float z){float d=i==0?textureLod(shadow0,uv,0).r:(i==1?textureLod(shadow1,uv,0).r:textureLod(shadow2,uv,0).r);return z<=d?1.0:0.0;}
+float ShadowSample(int i,vec3 q){vec2 uv=q.xy*.5+.5;return (Tap(i,uv,q.z)+Tap(i,uv+c.pcf[0].xy,q.z)+Tap(i,uv+c.pcf[0].zw,q.z)+Tap(i,uv+c.pcf[1].xy,q.z)+Tap(i,uv+c.pcf[1].zw,q.z))*.2;}
+float SunVisible(vec3 p){
+ if(c.shadow.x<.5)return 1.0;vec4 q=vec4(p,1);
+ for(int i=0;i<3;++i){vec3 s=vec3(dot(q,c.smat[3*i]),dot(q,c.smat[3*i+1]),dot(q,c.smat[3*i+2]));if(max(abs(s.x),abs(s.y))<.98)return ShadowSample(i,s);}
+ return 1.0;
+}
+float InUnit(vec3 p){
+ float inside=0;
+ // loop bounds from the constants, not literals: an unrolled 24 x 16 nest made a compute shader that took
+ // minutes to compile (llvmpipe) for nothing
+ int count=min(int(c.up.w),16);
+ for(int i=0;i<count;++i){vec4 u=c.unit[i];vec3 d=p-u.xyz;float h=dot(d,c.up.xyz);vec3 q=d-c.up.xyz*clamp(h,0.0,u.w);
+  float r=clamp(u.w*.22,.3,1.2)+.1;float w=clamp((r-length(q))/(r*.35),0.0,1.0)*clamp((h-.08)*5.0,0.0,1.0);inside=max(inside,w);}
+ return inside;
+}
+float RawDepth(vec2 uv){return textureLod(depthTex,uv,0).r;}
+vec3 ViewNormal(vec2 uv,vec3 p){
+ vec2 ex=vec2(c.screen.x,0),ey=vec2(0,c.screen.y);
+ vec4 l=ViewPos(uv-ex),r=ViewPos(uv+ex),u=ViewPos(uv-ey),d=ViewPos(uv+ey);float c0=RawDepth(uv);
+ float el=abs(2*RawDepth(uv-ex)-RawDepth(uv-2*ex)-c0)+(1-l.w)*1e9,er=abs(2*RawDepth(uv+ex)-RawDepth(uv+2*ex)-c0)+(1-r.w)*1e9;
+ float eu=abs(2*RawDepth(uv-ey)-RawDepth(uv-2*ey)-c0)+(1-u.w)*1e9,ed=abs(2*RawDepth(uv+ey)-RawDepth(uv+2*ey)-c0)+(1-d.w)*1e9;
+ vec3 dx=el<er?p-l.xyz:r.xyz-p,dy=eu<ed?p-u.xyz:d.xyz-p;vec3 n=cross(dx,dy);
+ n=dot(n,n)>1e-12?normalize(n):-normalize(p);return dot(n,p)>0?-n:n;
+}
+vec4 Generate(ivec2 px){
+ vec2 uv=(vec2(px)+.5)*c.screen.xy;vec4 v=ViewPos(uv);if(v.w<.5)return vec4(0);
+ vec3 p=v.xyz,n=ViewNormal(uv,p);float ndl=dot(n,c.light.xyz);if(ndl<.02)return vec4(0);
+ float vis=SunVisible(p+n*(.05+.004*p.z));
+ float len=c.params.x,stepLen=len/max(c.blur.x,1.0),bias=.01+.0015*p.z,thick=c.params.w*(1.0+.02*p.z);
+ vec3 o=p+n*(.02+.002*p.z);float noise=Noise(vec2(px)),occ=0;
+ int steps=int(c.blur.x);
+ for(int i=0;i<steps;++i){float t=(float(i)+noise)*stepLen;vec3 q=o+c.light.xyz*t;if(q.z<.25)break;
+  vec4 s=ViewPos(TargetUv(q));float delta=q.z-s.z;
+  if(s.w>.5&&delta>bias&&delta<thick&&InUnit(s.xyz)<.5){occ=1.0-smoothstep(.4,1.0,t/len);break;}}
+ occ*=(1.0-clamp((p.z-c.blur.z)*c.blur.w,0.0,1.0))*c.params.y;
+ vec3 forever=c.ambient.rgb/max(c.ambient.rgb+c.diffuse.rgb*ndl,vec3(1e-4));
+ vec3 k=mix(vec3(.7),forever,c.ambient.w*clamp((dot(n,c.up.xyz)-.55)*3.3,0.0,1.0));
+ float s=c.params.z>1.5?1.0:vis;
+ vec3 keep=(k+(1.0-k)*s*(1.0-occ))/(k+(1.0-k)*s);
+ return vec4(1.0-keep*keep,.5+.5*vis);
+}
+vec4 Blur(ivec2 px,vec2 axis){
+ vec2 uv=(vec2(px)+.5)*c.screen.xy;vec4 m=textureLod(maskSrc,uv,0);if(m.a<.25)return vec4(0);
+ vec4 q[5];for(int j=0;j<5;++j)q[j]=ViewPos(uv+axis*float(j-2));float z=q[2].z;
+ float slope=abs(q[3].z-z)<abs(z-q[1].z)?q[3].z-z:z-q[1].z;float sharp=1.0/(.03+.01*z);
+ vec3 total=vec3(0);float weights=0;
+ for(int i=0;i<5;++i){vec4 t=textureLod(maskSrc,uv+axis*float(i-2),0);float spatial=i==2?6.0:((i==1||i==3)?4.0:1.0);
+  float w=spatial*exp2(-abs(q[i].z-(z+slope*float(i-2)))*sharp)*q[i].w;w*=t.a>=.25?1.0:0.0;w*=clamp(1.0-2.0*abs(t.a-m.a),0.0,1.0);
+  total+=t.rgb*w;weights+=w;}
+ return vec4(total/max(weights,1e-6),m.a);
+}
+void main(){
+ ivec2 px=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(px,imageSize(sceneColour))))return;
+ uint pass=pc.flags.x;
+ if(pass==0u){imageStore(maskDst,px,Generate(px));return;}
+ if(pass==1u){imageStore(maskDst,px,Blur(px,vec2(c.screen.x,0)));return;}
+ if(pass==2u){imageStore(maskDst,px,Blur(px,vec2(0,c.screen.y)));return;}
+ // the frame is 8-bit gamma (gamma 2, as hdGI): the light left, sqrt(1 - share), is the factor in gamma too
+ vec4 m=textureLod(maskSrc,(vec2(px)+.5)*c.screen.xy,0);vec3 keep=sqrt(clamp(1.0-m.rgb,0.0,1.0));
+ if(c.depth.w>.5)keep=keep.bgr;
+ vec4 colour=imageLoad(sceneColour,px);
+ // test view 3 (hdSunDebug 4, coverage): grey = takes contact shadows (brighter = sunlit by the maps), black = sky / turned away
+ if(c.params.z>2.5){imageStore(sceneColour,px,vec4(vec3(m.a),colour.a));return;}
+ if(c.params.z>.5){vec3 k=keep;if(c.params.z>1.5&&m.a>=.25&&m.a<.75)k=vec3(k.r,k.g*.35,k.b*.35);imageStore(sceneColour,px,vec4(k,colour.a));return;}
+ imageStore(sceneColour,px,vec4(colour.rgb*keep,colour.a));
+}
