+// SPDX-License-Identifier: GPL-3.0-or-later
+// Zeppelin I-442: depth-only sun contact shadows under Vulkan, for when the G-buffer sun shadows (HdVulkanShadows) cannot
+// run -- MSAA on. A compute port of the D3D9 Waystone HD contact shadows (WoW/Source/WorldClient/HD/HdContactShadow.cpp,
+// v4): a short ray toward the world light marched in the resolved scene depth; where it passes behind something on
+// screen the pixel loses its share of the direct light (the darkness of the shaders' own shadow), never where the
+// client's sun shadow maps already shadow it; characters receive but do not cast; blurred along the surface.
+// Driven by HdVulkanShadows (hdSunShadows 1, hdSunContact 1, the full path blocked): it registers its own stage at
+// AfterOpaqueWorld and reads hdSunContactLength / Thickness / Strength.
+#pragma once
+#include <cstdint>
+#include "wxl/VkRenderApi.h"
+namespace HD::VulkanContact {
+struct Settings {
+    bool enabled = false;
+    float length = 1.5f;      // hdSunContactLength, yards
+    float thickness = 1.0f;   // occluder thickness near the camera, yards (hdSunContactThickness / 0.08 x 1 yard)
+    float strength = 1.0f;    // hdSunContactStrength
+    uint32_t debug = 0;       // hdSunDebug 2 -> 1 (the shadow alone), anything else 0
+};
+bool Init(const WXL_VkRenderApi* api);   // registers the stage (off until Configure enables it)
+void Configure(const Settings& settings);
+const char* Status();                     // the last frame's outcome, for hdSunInfo
+bool Shutdown();
+}
