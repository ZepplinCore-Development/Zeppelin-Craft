Date: Mon, 19 Oct 2026 02:04:56 +0000
Subject: [PATCH] Zeppelin F-200: play movies of any frame size

- Sizes other than the six stock 1024/800 layouts use one non-power-of-two texture (layout 6) at the video's own aspect
- Previously any other size failed silently in OpenVideo

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ByrZ7GxoHC9wfGdkRwtqCX
---
 Engine/Source/Frame/CSimpleMovieFrame.cpp | 67 +++++++++++++++++++++--
 1 file changed, 61 insertions(+), 6 deletions(-)

diff --git a/Engine/Source/Frame/CSimpleMovieFrame.cpp b/Engine/Source/Frame/CSimpleMovieFrame.cpp
index dd20c1d..855b679 100644
--- a/Engine/Source/Frame/CSimpleMovieFrame.cpp
+++ b/Engine/Source/Frame/CSimpleMovieFrame.cpp
@@ -216,6 +216,35 @@ static uint32_t s_frameOffset[6] = { 0x4B00, 0x18000, 0x19000, 0, 0x10680, 0x260
 // STATIC: 0x00A24188
 static uint16_t s_indices[4] = { 0, 1, 2, 3 };
 
+// Not in the original (F-200): any frame size other than the six stock ones plays as one non-power-of-two texture the
+// size of the video (layout 6), drawn at the video's own aspect ratio. Only one movie plays at a time, so the layout's
+// tables are filled per video in OpenVideo.
+static const uint32_t ZEP_LAYOUT_ANY = 6;
+static MOVIETEXTUREINFO s_zepTextureInfo;
+static MOVIEUPDATERECT s_zepUpdateRect;
+
+static uint32_t MovieTextureCount(uint32_t layout) {
+    return layout == ZEP_LAYOUT_ANY ? 1 : s_textureCount[layout];
+}
+
+static const MOVIEUPDATERECT& MovieUpdateRect(uint32_t layout, uint32_t i) {
+    return layout == ZEP_LAYOUT_ANY ? s_zepUpdateRect : s_updateRects[layout][i];
+}
+
+// Full width, height from the video's aspect ratio (y is later scaled by the screen's aspect compensation, which is 1.0
+// at 4:3); shrunk to fit when the video is taller than the screen allows.
+static MOVIETEXTURERECT MovieZepRect(uint32_t width, uint32_t height, float aspect) {
+    float halfHeight = (2.0f / 3.0f) * static_cast<float>(height) / static_cast<float>(width);
+    float scale = 1.0f;
+
+    if (halfHeight * aspect > 0.5f) {
+        scale = 0.5f / (halfHeight * aspect);
+    }
+
+    float left = (1.0f - scale) * 0.5f;
+    return { left, left + scale, halfHeight * scale, -halfHeight * scale };
+}
+
