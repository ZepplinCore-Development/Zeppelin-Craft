diff --git a/Extensions/HelloWorld/src/HelloWorldObject.cpp b/Extensions/HelloWorld/src/HelloWorldObject.cpp
new file mode 100644
index 0000000..7103825
--- /dev/null
+++ b/Extensions/HelloWorld/src/HelloWorldObject.cpp
@@ -0,0 +1,51 @@
+#include "WoW/Source/Extension/ExtensionMgr.h"
+#include "WoW/Source/Object/ObjectClient/Object_C.h"
+
+namespace {
+
+// Logs the first few objects the server creates (kind and low guid), counts the per-frame
+// updates, and reports the create/remove/destroy balance when objects go away.
+class HelloWorldObjectScript : public ObjectScript {
+    public:
+    HelloWorldObjectScript() : ObjectScript("HelloWorldObjectScript") {}
+
+    void OnObjectCreated(CGObject_C& object) override {
+        m_created++;
+
+        if (m_created <= 5) {
+            sExtensionMgr->Log("HelloWorld: OnObjectCreated type 0x%02X guid 0x%08X%08X", object.m_obj->m_type, static_cast<uint32_t>(object.m_obj->m_guid.m_guid >> 32), static_cast<uint32_t>(object.m_obj->m_guid.m_guid));
+        }
+    }
+
+    void OnObjectUpdate(CGObject_C& object, uint32_t time) override {
+        m_updates++;
+
+        if (m_updates == 1) {
+            sExtensionMgr->Log("HelloWorld: OnObjectUpdate (first, t=%u)", time);
+        }
+    }
+
+    void OnObjectRemoved(CGObject_C& object) override {
+        m_removed++;
+    }
+
+    void OnObjectDestroy(CGObject_C& object) override {
+        m_destroyed++;
+
+        if (m_destroyed % 100 == 0) {
+            sExtensionMgr->Log("HelloWorld: objects %u created, %u removed, %u destroyed, %u update(s)", m_created, m_removed, m_destroyed, m_updates);
+        }
+    }
+
+    private:
+    uint32_t m_created = 0;
+    uint32_t m_updates = 0;
+    uint32_t m_removed = 0;
+    uint32_t m_destroyed = 0;
+};
+
+}
+
+void AddHelloWorldObjectScripts() {
+    new HelloWorldObjectScript();
+}
diff --git a/Extensions/HelloWorld/src/HelloWorldTerrain.cpp b/Extensions/HelloWorld/src/HelloWorldTerrain.cpp
new file mode 100644
index 0000000..49ac1bf
--- /dev/null
+++ b/Extensions/HelloWorld/src/HelloWorldTerrain.cpp
@@ -0,0 +1,37 @@
+#include "WoW/Source/Extension/ExtensionMgr.h"
+#include "WoW/Source/WorldClient/MapArea.h"
+
+namespace {
+
+// Logs the first tiles as their ADT is parsed, with the placement counts the tile carries, and
+// keeps the loaded/unloaded balance.
+class HelloWorldTerrainScript : public TerrainScript {
+    public:
+    HelloWorldTerrainScript() : TerrainScript("HelloWorldTerrainScript") {}
+
+    void OnTerrainTileLoaded(CMapArea& area) override {
+        m_loaded++;
+
+        if (m_loaded <= 5) {
+            sExtensionMgr->Log("HelloWorld: OnTerrainTileLoaded tile %d,%d (%u doodad(s), %u wmo(s))", area.m_index.x, area.m_index.y, area.m_doodadDefCount, area.m_mapObjDefCount);
+        }
+    }
+
+    void OnTerrainTileUnload(CMapArea& area) override {
+        m_unloaded++;
+
+        if (m_unloaded <= 3 || m_unloaded % 50 == 0) {
+            sExtensionMgr->Log("HelloWorld: OnTerrainTileUnload tile %d,%d (%u loaded, %u unloaded so far)", area.m_index.x, area.m_index.y, m_loaded, m_unloaded);
+        }
+    }
+
+    private:
+    uint32_t m_loaded = 0;
+    uint32_t m_unloaded = 0;
+};
+
+}
+
+void AddHelloWorldTerrainScripts() {
+    new HelloWorldTerrainScript();
+}
