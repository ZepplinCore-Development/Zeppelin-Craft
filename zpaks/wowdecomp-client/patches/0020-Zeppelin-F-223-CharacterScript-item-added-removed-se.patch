new file mode 100644
index 0000000..9ae44ac
--- /dev/null
+++ b/WoW/Source/Extension/ScriptDefines/CharacterScript.cpp
@@ -0,0 +1,16 @@
+#include "WoW/Source/Extension/ScriptDefines/CharacterScript.h"
+#include "WoW/Source/Extension/ExtensionMgr.h"
+#include "WoW/Source/Extension/ExtensionMgrMacros.h"
+
+void ExtensionMgr::OnCharacterItemAdded(CCharacterComponent* component, uint32_t itemSlot, const ItemDisplayInfoRec* displayRec) {
+    CALL_HOOKS(CharacterScript, script->OnCharacterItemAdded(*component, itemSlot, *displayRec));
+}
+
+void ExtensionMgr::OnCharacterItemRemoved(CCharacterComponent* component, uint32_t itemSlot) {
+    CALL_HOOKS(CharacterScript, script->OnCharacterItemRemoved(*component, itemSlot));
+}
+
+CharacterScript::CharacterScript(const char* name) : ScriptObject(name) {
+    ScriptRegistry<CharacterScript>::AddScript(this);
+    sExtensionMgr->Log("Extensions: registered CharacterScript %s", name);
+}
diff --git a/WoW/Source/Extension/ScriptDefines/CharacterScript.h b/WoW/Source/Extension/ScriptDefines/CharacterScript.h
new file mode 100644
index 0000000..bc6c54d
--- /dev/null
+++ b/WoW/Source/Extension/ScriptDefines/CharacterScript.h
@@ -0,0 +1,30 @@
+#ifndef WOW_SOURCE_EXTENSION_SCRIPTDEFINES_CHARACTERSCRIPT_H
+#define WOW_SOURCE_EXTENSION_SCRIPTDEFINES_CHARACTERSCRIPT_H
+
+#include <cstdint>
+#include "WoW/Source/Extension/ScriptObject.h"
+
+class CCharacterComponent;
+class ItemDisplayInfoRec;
+
+// The character dressing pipeline (WoW/Common/ComponentCore): one CCharacterComponent dresses one
+// character model (component.m_data.m_model) for players, character-display NPCs, the character
+// select and create screens and the dressing room. Items are added and removed per ITEM_SLOT (0 head
+// ... 10 cape, 11 quiver); the stock client attaches models only for the head, shoulders, quiver and
+// hand items, and turns every other slot into texture layers and geosets.
+class CharacterScript : public ScriptObject {
+    protected:
+    explicit CharacterScript(const char* name);
+
+    public:
+    // End of CCharacterComponent::AddItem(ITEM_SLOT, const ItemDisplayInfoRec*, int32_t): the stock
+    // models, textures and geosets of the slot are set up; component.m_itemDisplayID[itemSlot] is
+    // displayRec.m_id. itemSlot is an ITEM_SLOT value.
+    virtual void OnCharacterItemAdded(CCharacterComponent& component, uint32_t itemSlot, const ItemDisplayInfoRec& displayRec) {}
+
+    // Start of CCharacterComponent::RemoveItem for an occupied slot, before the stock client clears it
+    // (component.m_itemDisplayID[itemSlot] is still the item being removed).
+    virtual void OnCharacterItemRemoved(CCharacterComponent& component, uint32_t itemSlot) {}
+};
+
+#endif
