diff --git a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Shaders.cpp b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Shaders.cpp
index fb4493fb..1e78bffc 100644
--- a/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Shaders.cpp
+++ b/Engine/Source/Gx/CGxDeviceVulkan/wxl/src/vulkan/Shaders.cpp
@@ -164,6 +164,78 @@ namespace
 
 namespace
 {
+    /**
+     * Zeppelin I-442: a fragment module whose inputs are interpolated at each sample's position -- the per-sample
+     * variant the supersampled alpha test (hdAlphaAA 2) draws with. Vulkan's sample shading alone runs the shader
+     * per sample but may still interpolate an undecorated input at the pixel centre, which leaves every sample of
+     * a pixel with the same texel and the same discard: the edge stays hard. So every user Input variable that is
+     * not built in, flat, centroid or already per-sample gets `OpDecorate %v Sample`, and the module declares
+     * SampleRateShading (the device enables that feature, vulkan/context/Logical.cpp). A mechanical patch of the
+     * module as loaded: the translated modules and the hand-written rows are not rebuilt.
+     *
+     * @param vector& words : the module; patched in place
+     * @return uint32 : the inputs decorated (0: nothing to do, the module unchanged)
+     */
+    uint32_t PatchSampleInterpolation(std::vector<uint32_t>& words)
+    {
+        constexpr uint32_t kOpCapability = 17, kOpDecorate = 71, kOpMemberDecorate = 72, kOpVariable = 59,
+                           kOpTypePointer = 32, kOpTypeStruct = 30, kOpFunction = 54;
+        constexpr uint32_t kCapSampleRateShading = 35, kStorageInput = 1;
+        constexpr uint32_t kDecBuiltIn = 11, kDecFlat = 14, kDecCentroid = 16, kDecSample = 17;
+        if (words.size() < 5) return 0;
+        const uint32_t bound = words[3];
+        std::vector<uint8_t> skip(bound, 0), isStruct(bound, 0);
+        std::vector<uint32_t> pointee(bound, 0), inputs;
+        bool hasCap = false;
+        size_t firstCapEnd = 0, firstAnnotation = 0;
+        for (size_t i = 5; i < words.size();)
+        {
+            const uint32_t op = words[i] & 0xFFFFu, n = words[i] >> 16;
+            if (n == 0 || i + n > words.size()) return 0;   // malformed: leave it alone
+            if (op == kOpCapability)
+            {
+                if (words[i + 1] == kCapSampleRateShading) hasCap = true;
+                if (!firstCapEnd) firstCapEnd = i + n;
+            }
+            else if ((op == kOpDecorate || op == kOpMemberDecorate) && !firstAnnotation) firstAnnotation = i;
+            if (op == kOpDecorate && n >= 3 && words[i + 1] < bound)
+            {
+                const uint32_t d = words[i + 2];
+                if (d == kDecBuiltIn || d == kDecFlat || d == kDecCentroid || d == kDecSample) skip[words[i + 1]] = 1;
+            }
+            else if (op == kOpTypeStruct && n >= 2 && words[i + 1] < bound) isStruct[words[i + 1]] = 1;
+            else if (op == kOpTypePointer && n >= 4 && words[i + 1] < bound) pointee[words[i + 1]] = words[i + 3];
+            else if (op == kOpVariable && n >= 4 && words[i + 3] == kStorageInput && words[i + 2] < bound)
+            {
+                inputs.push_back(words[i + 2]);   // pairs: the variable's id, its pointer type
+                inputs.push_back(words[i + 1]);
+            }
+            else if (op == kOpFunction) break;   // no globals after the first function
+            i += n;
+        }
+        if (!firstCapEnd || !firstAnnotation) return 0;
+        std::vector<uint32_t> decorations;
+        for (size_t k = 0; k + 1 < inputs.size(); k += 2)
+        {
+            const uint32_t id = inputs[k], type = inputs[k + 1];
+            if (skip[id]) continue;
+            const uint32_t target = type < bound ? pointee[type] : 0;
+            if (target < bound && isStruct[target]) continue;   // a block (built-ins live in those)
+            decorations.push_back((3u << 16) | kOpDecorate);
+            decorations.push_back(id);
+            decorations.push_back(kDecSample);
+        }
+        if (decorations.empty()) return 0;
+        // The annotations first (they come after the capabilities, so the capability's index still holds).
+        words.insert(words.begin() + static_cast<std::ptrdiff_t>(firstAnnotation), decorations.begin(), decorations.end());
+        if (!hasCap)
+        {
+            const uint32_t cap[2] = { (2u << 16) | kOpCapability, kCapSampleRateShading };
+            words.insert(words.begin() + static_cast<std::ptrdiff_t>(firstCapEnd), cap, cap + 2);
+        }
+        return static_cast<uint32_t>(decorations.size() / 3);
+    }
+
