@@ -265,8 +339,9 @@ namespace
         e.module = module;
         e.failed = false;
 
-        wxl::ScriptMgr::Log(WXL_LOG_DEBUG, "vulkan: shaders: loaded \"%s\": %llu bytes of SPIR-V",
-                            key, static_cast<unsigned long long>(bytes.size()));
+        wxl::ScriptMgr::Log(WXL_LOG_DEBUG, "vulkan: shaders: loaded \"%s\": %llu bytes of SPIR-V%s",
+                            key, static_cast<unsigned long long>(bytes.size()),
+                            perSample ? (patched ? ", inputs per sample" : ", per sample (nothing to patch)") : "");
         return module;
     }
 }
@@ -346,4 +421,15 @@ namespace wxlvk::vk::shaders
         std::snprintf(relative, sizeof relative, "shaders\\%s", path);
         return Load(path, relative);
