@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Zeppelin I-442: hdAlphaAA -- antialiasing of the alpha test on the multisampled Vulkan passes (I-442's MSAA).
+//
+// The engine's alpha test reaches Vulkan as a discard in every pixel module (translated stock shaders, the HD blobs
+// such as HdGrass, ff.frag, combiners_mod.frag): `if (misc.x > 0 && a < misc.x) discard`, misc.x = alphaRef / 255 from
+// the draw's uniform slice. MSAA alone leaves that edge hard, since the discard decides per pixel. Two remedies that
+// need no retranslation, both pipeline state on the alpha-tested draws of an N-sample pass only (vulkan/pipelines
+// MakeKey bits 3 / 4); a 1x pass never changes:
+//   1  alpha to coverage: misc.x is zeroed for those draws so nothing is discarded, and the fragment's alpha becomes
+//      the sample mask. Cheap; edges as soft as the texture's own alpha ramp (no sharpening: that would need a
+//      change in every translated module).
+//   2  supersampled alpha test (sample shading at rate 1): the shader, its texture fetch at each sample's position
+//      and its discard run once per sample -- NVIDIA's transparency supersampling under D3D9. The sharpest, and the
+//      foliage keeps its exact thickness; costs N shader runs per covered pixel for those draws. Falls back to 1
+//      on a device without sampleRateShading.
+#include "HdVulkanAlphaAA.h"
+#include <cstdio>
+#include <cstring>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "native/Present.hpp"
+#include "vulkan/Pipelines.hpp"
+
+namespace HD::VulkanAlphaAA {
+namespace {
+CVar* mode = nullptr;
+CVar* info = nullptr;
+char lastInfo[96] = "";
+CVar* Var(const char* name, const char* help, const char* value, uint32_t flags = 1) {
+    if (auto* old = CVar::LookupRegistered(name)) return old;
+    return CVar::Register(name, help, flags, value, nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+}
+void Info(const char* value) {
+    if (info && std::strcmp(lastInfo, value)) {
+        std::snprintf(lastInfo, sizeof lastInfo, "%s", value);
+        info->Set(lastInfo, true, false, false, false);
+    }
+}
+}
+
+void Update() {
+    if (!mode) {
+        mode = Var("hdAlphaAA", "HD: Vulkan MSAA on alpha-tested grass/leaves: 0 off, 1 alpha to coverage, 2 supersampled alpha test", "2");
+        info = Var("hdAlphaAAInfo", "HD: alpha-test antialiasing status", "off", 0x80);
+    }
+    const int requested = mode ? mode->m_intValue : 0;
+    const uint32_t used = wxlvk::vk::pipelines::SetAlphaAA(requested > 0 ? static_cast<uint32_t>(requested) : 0u);
+    const uint32_t samples = wxlvk::native::present::MultisampleCount();
+    char line[96];
+    if (samples <= 1)
+        std::snprintf(line, sizeof line, "off: no MSAA (gxMultisample 1)");
+    else if (used == 0)
+        std::snprintf(line, sizeof line, "off");
+    else
+        std::snprintf(line, sizeof line, "%s at %ux%s", used == 2 ? "supersampled alpha test" : "alpha to coverage", samples,
+                      requested == 2 && used == 1 ? " (no sampleRateShading)" : "");
+    Info(line);
+}
+}
