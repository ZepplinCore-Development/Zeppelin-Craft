+#!/usr/bin/env python3
+"""Zeppelin F-223A: HdVulkanFog.comp -> HdVulkanFog.spv.h (FOG_PASS 0..3), as the original header was made
+(glslangValidator -V --target-env vulkan1.0 -DFOG_PASS=n). --check compares against the current header instead."""
+import os, re, struct, subprocess, sys, tempfile
+HERE = os.path.dirname(os.path.abspath(__file__))
+G = os.path.expanduser('~/.local/glslang/bin/glslangValidator')
+NAMES = ['kHdVulkanFog', 'kHdVulkanFogMarch', 'kHdVulkanFogBlurH', 'kHdVulkanFogComposite']
+arrays = []
+with tempfile.TemporaryDirectory() as t:
+    for n, name in enumerate(NAMES):
+        out = os.path.join(t, '%d.spv' % n)
+        r = subprocess.run([G, '-V', '--target-env', 'vulkan1.0', '-DFOG_PASS=%d' % n, '-o', out, os.path.join(HERE, 'HdVulkanFog.comp')], capture_output=True, text=True)
+        if r.returncode: sys.exit(r.stdout + r.stderr)
+        d = open(out, 'rb').read()
+        arrays.append(list(struct.unpack('<%dI' % (len(d) // 4), d)))
+path = os.path.join(HERE, 'HdVulkanFog.spv.h')
+if '--check' in sys.argv:
+    text = open(path).read()
+    for name, words in zip(NAMES, arrays):
+        body = text.split('static const uint32_t %s[] = {' % name)[1].split('};')[0]
+        old = [int(x, 16) for x in re.findall(r'0x([0-9a-fA-F]+)u', body)]
+        print(name, 'SAME' if old == words else 'DIFFERENT (%d vs %d words)' % (len(old), len(words)))
+    sys.exit(0)
+head = open(path).read().split('static const uint32_t')[0]
+lines = [head.rstrip('\n')]
+for name, words in zip(NAMES, arrays):
+    lines.append('static const uint32_t %s[] = {' % name)
+    for k in range(0, len(words), 8):
+        lines.append('    ' + ', '.join('0x%08xu' % w for w in words[k:k + 8]) + ',')
+    lines.append('};')
+open(path, 'w').write('\n'.join(lines) + '\n')
+print('wrote', path)
