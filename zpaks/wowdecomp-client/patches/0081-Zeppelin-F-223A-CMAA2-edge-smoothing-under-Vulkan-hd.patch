diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanCMAA2.cpp b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanCMAA2.cpp
new file mode 100644
index 00000000..2223ec58
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanCMAA2.cpp
@@ -0,0 +1,317 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Zeppelin F-223A: CMAA2 under Vulkan (see HdVulkanCMAA2.h). Intel's host sequence (vaCMAA2DX11.cpp) on Vulkan:
+//   1 EdgesColor2x2CS            reads the colour, writes the edges and resets the list heads
+//   2 ComputeDispatchArgsCS (2,1,1) -> indirect arguments for 3
+//   3 ProcessCandidatesCS        (indirect) finds the shapes, appends the blends
+//   4 ComputeDispatchArgsCS (1,2,1) -> indirect arguments for 5, clears the counters for the next frame
+//   5 DeferredColorApply2x2CS    (indirect) writes the blended colours back into the same image
+// The working images and buffers are shared by the frames (one queue: the frames run in order, the barrier at the
+// start of each run orders it after the last); the descriptor sets are per frame slot.
+#include "HdVulkanCMAA2.h"
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <new>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "native/Present.hpp"
+#include "wxl/Script.hpp"
+#include "wxl/VkRenderApi.h"
+
+namespace HD::VulkanCMAA2 {
+namespace {
+#include "shaders/cmaa2/CMAA2.spv.h"
+constexpr uint32_t MaxSlots = 8, PipelineCount = 4;
+constexpr uint32_t KernelOut = 16 - 2;   // CMAA2_CS_INPUT_KERNEL_SIZE_X/Y - 2
+// Set 0, as glslang placed them (cmaa2_spv.py prints them): u0..u7 then t0 at 10.
+enum Binding : uint32_t {ColorOut = 0, Edges = 1, Candidates = 2, Locations = 3, Items = 4, Heads = 5, Control = 6, Indirect = 7, ColorIn = 10};
+constexpr uint32_t BindingCount = 9;
+constexpr uint32_t kBindings[BindingCount] = {ColorOut, Edges, Candidates, Locations, Items, Heads, Control, Indirect, ColorIn};
+
+struct State {
+    const WXL_VkRenderApi* api = nullptr;
+    WXL_VkDeviceInfo device{};
+    VkDescriptorSetLayout setLayout = VK_NULL_HANDLE;
+    VkPipelineLayout pipelineLayout = VK_NULL_HANDLE;
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    VkPipeline pipelines[PipelineCount]{};
+    VkDescriptorSet sets[MaxSlots]{};
+    uint64_t slotSerial[MaxSlots]{};
+    // the working set, for one size
+    void* edgesHandle = nullptr; WXL_VkImageInfo edges{};
+    void* headsHandle = nullptr; WXL_VkImageInfo heads{};
+    void* buffers[5]{}; WXL_VkBufferInfo bufferInfo[5]{};   // candidates, locations, items, control, indirect
+    uint32_t width = 0, height = 0, failedWidth = 0, failedHeight = 0;
+    bool fresh = true;          // the working set was just made: images UNDEFINED, control buffer not zeroed
+    uint64_t last = 0;
+#define CM_FUNCTIONS(X) \
+    X(CreateDescriptorSetLayout) X(DestroyDescriptorSetLayout) X(CreatePipelineLayout) X(DestroyPipelineLayout) \
+    X(CreateDescriptorPool) X(DestroyDescriptorPool) X(AllocateDescriptorSets) X(UpdateDescriptorSets) \
+    X(CreateShaderModule) X(DestroyShaderModule) X(CreateComputePipelines) X(DestroyPipeline) \
+    X(CmdPipelineBarrier) X(CmdBindPipeline) X(CmdBindDescriptorSets) X(CmdDispatch) X(CmdDispatchIndirect) X(CmdFillBuffer)
+#define CM_DECLARE(n) PFN_vk##n n = nullptr;
+    CM_FUNCTIONS(CM_DECLARE)
+#undef CM_DECLARE
+};
+
+State* s = nullptr;
+void* registration = nullptr;
+CVar* enabled = nullptr;
+CVar* info = nullptr;
+char lastInfo[200] = "";
+
+CVar* Var(const char* name, const char* help, const char* value, uint32_t flags = 1) {
+    if (auto* existing = CVar::LookupRegistered(name)) return existing;
+    return CVar::Register(name, help, flags, value, nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+}
+void Info(const char* value) {
+    if (info && std::strcmp(lastInfo, value)) {std::snprintf(lastInfo, sizeof lastInfo, "%s", value); info->Set(lastInfo, true, false, false, false);}
+}
+
+void ReleaseWorkingSet(uint64_t serial) {
+    if (s->edgesHandle) s->api->RetireImage(s->edgesHandle, serial);
+    if (s->headsHandle) s->api->RetireImage(s->headsHandle, serial);
+    for (auto& b : s->buffers) if (b) s->api->RetireBuffer(b, serial);
+    s->edgesHandle = s->headsHandle = nullptr;
+    for (auto& b : s->buffers) b = nullptr;
+    s->width = s->height = 0;
+}
+
+// Intel's sizes (the "99.99% safe" ones): candidates w*h/4, blend items w*h/2 (uint2), list heads (w*h+3)/6.
+bool Resize(uint32_t w, uint32_t h) {
+    if (s->width == w && s->height == h) return true;
+    if (s->failedWidth == w && s->failedHeight == h) return false;
+    ReleaseWorkingSet(s->last);
+    const VkImageUsageFlags storage = VK_IMAGE_USAGE_STORAGE_BIT;
+    WXL_VkImageDesc edges{VK_FORMAT_R32_UINT, (w + 1) / 2, h, 1, storage, VK_IMAGE_ASPECT_COLOR_BIT};
+    WXL_VkImageDesc heads{VK_FORMAT_R32_UINT, (w + 1) / 2, (h + 1) / 2, 1, storage, VK_IMAGE_ASPECT_COLOR_BIT};
+    const VkDeviceSize pixels = VkDeviceSize(w) * h;
+    const VkBufferUsageFlags ssbo = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+    WXL_VkBufferDesc buffers[5] = {
+        {std::max<VkDeviceSize>(pixels / 4, 1) * 4, ssbo, WXL_VK_MEMORY_DEVICE_LOCAL},
+        {std::max<VkDeviceSize>((pixels + 3) / 6, 1) * 4, ssbo, WXL_VK_MEMORY_DEVICE_LOCAL},
+        {std::max<VkDeviceSize>(pixels / 2, 1) * 8, ssbo, WXL_VK_MEMORY_DEVICE_LOCAL},
+        {16 * 4, ssbo | VK_BUFFER_USAGE_TRANSFER_DST_BIT, WXL_VK_MEMORY_DEVICE_LOCAL},
+        {4 * 4, ssbo | VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT, WXL_VK_MEMORY_DEVICE_LOCAL},
+    };
+    bool okay = (s->edgesHandle = s->api->CreateImage(&edges, &s->edges)) && (s->headsHandle = s->api->CreateImage(&heads, &s->heads));
+    for (uint32_t i = 0; i < 5 && okay; ++i) okay = (s->buffers[i] = s->api->CreateBuffer(&buffers[i], &s->bufferInfo[i])) != nullptr;
+    if (!okay) {
+        ReleaseWorkingSet(0);
+        s->failedWidth = w; s->failedHeight = h;
+        return false;
+    }
+    s->width = w; s->height = h; s->failedWidth = s->failedHeight = 0;
+    s->fresh = true;
+    return true;
+}
+
+void Barrier(VkCommandBuffer cmd, VkPipelineStageFlags dstStage, VkAccessFlags dstAccess) {
+    VkMemoryBarrier b{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    b.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    b.dstAccessMask = dstAccess;
+    s->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, dstStage, 0, 1, &b, 0, nullptr, 0, nullptr);
+}
+
+bool Record(const WXL_VkStageContext& ctx) {
+    if (ctx.structSize < offsetof(WXL_VkStageContext, jitter) || !ctx.cmd || !ctx.colorView || !ctx.serial ||
+        ctx.frameSlot >= s->device.frameSlots || ctx.colorFormat != VK_FORMAT_R8G8B8A8_UNORM || ctx.colorLayout != VK_IMAGE_LAYOUT_GENERAL) {
+        Info("CMAA2 skipped: no colour image this frame");
+        return false;
+    }
+    const uint32_t w = ctx.extent.width, h = ctx.extent.height;
+    if (!w || !h || w > 16384 || h > 16384 || !Resize(w, h)) {Info("CMAA2 skipped: working memory allocation failed"); return false;}
+    if (s->slotSerial[ctx.frameSlot] > ctx.completedSerial) {Info("CMAA2 skipped: slot in flight"); return false;}
+    const VkCommandBuffer cmd = ctx.cmd;
+
+    // the slot's descriptors: the colour view can change with the back buffer, the working set with the size
+    VkDescriptorImageInfo images[BindingCount]{};
+    VkDescriptorBufferInfo buffers[BindingCount]{};
+    VkWriteDescriptorSet writes[BindingCount]{};
+    for (uint32_t i = 0; i < BindingCount; ++i) {
+        auto& wr = writes[i];
+        wr.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET; wr.dstSet = s->sets[ctx.frameSlot]; wr.dstBinding = kBindings[i]; wr.descriptorCount = 1;
+        switch (kBindings[i]) {
+        case ColorOut: images[i] = {VK_NULL_HANDLE, ctx.colorView, VK_IMAGE_LAYOUT_GENERAL}; wr.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE; break;
+        case ColorIn: images[i] = {VK_NULL_HANDLE, ctx.colorView, VK_IMAGE_LAYOUT_GENERAL}; wr.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE; break;
+        case Edges: images[i] = {VK_NULL_HANDLE, s->edges.view, VK_IMAGE_LAYOUT_GENERAL}; wr.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE; break;
+        case Heads: images[i] = {VK_NULL_HANDLE, s->heads.view, VK_IMAGE_LAYOUT_GENERAL}; wr.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE; break;
+        default: {
+            const uint32_t b = kBindings[i] == Candidates ? 0 : kBindings[i] == Locations ? 1 : kBindings[i] == Items ? 2 : kBindings[i] == Control ? 3 : 4;
+            buffers[i] = {s->bufferInfo[b].buffer, 0, VK_WHOLE_SIZE};
+            wr.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        }
+        }
+        if (wr.descriptorType == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER) wr.pBufferInfo = &buffers[i]; else wr.pImageInfo = &images[i];
+    }
+    s->UpdateDescriptorSets(s->device.device, BindingCount, writes, 0, nullptr);
+
+    // after everything the frame did to the colour and to the working set (the last frame's passes included)
+    {
+        VkMemoryBarrier all{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+        all.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        all.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+        std::array<VkImageMemoryBarrier, 2> layouts{};
+        uint32_t count = 0;
+        if (s->fresh) {
+            for (VkImage image : {s->edges.image, s->heads.image}) {
+                auto& b = layouts[count++];
+                b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER; b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED; b.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+                b.image = image; b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+                b.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT; b.subresourceRange.levelCount = b.subresourceRange.layerCount = 1;
+                b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+            }
+        }
+        s->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+                              1, &all, 0, nullptr, count, count ? layouts.data() : nullptr);
+    }
+    if (s->fresh) {
+        // the counters start at zero once; from then on pass 4 clears them for the next frame
+        s->CmdFillBuffer(cmd, s->bufferInfo[3].buffer, 0, VK_WHOLE_SIZE, 0);
+        VkMemoryBarrier filled{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+        filled.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+        filled.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+        s->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &filled, 0, nullptr, 0, nullptr);
+        s->fresh = false;
+    }
+
+    s->CmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s->pipelineLayout, 0, 1, &s->sets[ctx.frameSlot], 0, nullptr);
+    const VkPipelineStageFlags indirectStages = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_DRAW_INDIRECT_BIT;
+    const VkAccessFlags indirectAccess = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_INDIRECT_COMMAND_READ_BIT;
+    const VkAccessFlags rw = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    // 1 edges
+    s->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s->pipelines[0]);
+    s->CmdDispatch(cmd, (w + KernelOut * 2 - 1) / (KernelOut * 2), (h + KernelOut * 2 - 1) / (KernelOut * 2), 1);
+    Barrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, rw);
+    // 2 arguments for 3
+    s->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s->pipelines[1]);
+    s->CmdDispatch(cmd, 2, 1, 1);
+    Barrier(cmd, indirectStages, indirectAccess);
+    // 3 shapes
+    s->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s->pipelines[2]);
+    s->CmdDispatchIndirect(cmd, s->bufferInfo[4].buffer, 0);
+    Barrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, rw);
+    // 4 arguments for 5 (and the counters cleared)
+    s->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s->pipelines[1]);
+    s->CmdDispatch(cmd, 1, 2, 1);
+    Barrier(cmd, indirectStages, indirectAccess);
+    // 5 blends into the colour
+    s->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s->pipelines[3]);
+    s->CmdDispatchIndirect(cmd, s->bufferInfo[4].buffer, 0);
+    Barrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT);
+
+    s->slotSerial[ctx.frameSlot] = s->last = ctx.serial;
+    char text[160];
+    std::snprintf(text, sizeof text, "on: %ux%u, high quality preset", w, h);
+    Info(text);
+    return true;
+}
+
+int __cdecl Wanted(void*) {
+    const bool on = s && enabled && enabled->m_intValue != 0;
+    if (!on) Info("off");
+    return on ? 1 : 0;
+}
+void __cdecl Stage(void*, const WXL_VkStageContext* ctx) {if (ctx && s) Record(*ctx);}
+
+void Destroy() {
+    if (!s) return;
+    ReleaseWorkingSet(s->last);
+    for (auto p : s->pipelines) if (p) s->DestroyPipeline(s->device.device, p, nullptr);
+    if (s->pool) s->DestroyDescriptorPool(s->device.device, s->pool, nullptr);
+    if (s->pipelineLayout) s->DestroyPipelineLayout(s->device.device, s->pipelineLayout, nullptr);
+    if (s->setLayout) s->DestroyDescriptorSetLayout(s->device.device, s->setLayout, nullptr);
+    delete s;
+    s = nullptr;
+}
+
+bool Create(const WXL_VkRenderApi* api) {
+    s = new (std::nothrow) State();
+    if (!s) return false;
+    s->api = api;
+    s->device.structSize = sizeof s->device;
+    if (!api->GetDeviceInfo(&s->device) || !s->device.device || !s->device.getDeviceProcAddr || !s->device.frameSlots || s->device.frameSlots > MaxSlots) {
+        delete s; s = nullptr; return false;
+    }
+#define CM_LOAD(n) s->n = reinterpret_cast<PFN_vk##n>(s->device.getDeviceProcAddr(s->device.device, "vk" #n)); if (!s->n) { delete s; s = nullptr; return false; }
+    CM_FUNCTIONS(CM_LOAD)
+#undef CM_LOAD
+    std::array<VkDescriptorSetLayoutBinding, BindingCount> bindings{};
+    for (uint32_t i = 0; i < BindingCount; ++i) {
+        auto& b = bindings[i];
+        b.binding = kBindings[i]; b.descriptorCount = 1; b.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        b.descriptorType = kBindings[i] == ColorIn ? VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE
+                         : (kBindings[i] == ColorOut || kBindings[i] == Edges || kBindings[i] == Heads) ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE
+                         : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    }
+    VkDescriptorSetLayoutCreateInfo sl{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    sl.bindingCount = BindingCount; sl.pBindings = bindings.data();
+    if (s->CreateDescriptorSetLayout(s->device.device, &sl, nullptr, &s->setLayout) != VK_SUCCESS) return false;
+    VkPipelineLayoutCreateInfo pl{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    pl.setLayoutCount = 1; pl.pSetLayouts = &s->setLayout;
+    if (s->CreatePipelineLayout(s->device.device, &pl, nullptr, &s->pipelineLayout) != VK_SUCCESS) return false;
+    const uint32_t* code[PipelineCount] = {kCmaa2Edges, kCmaa2DispatchArgs, kCmaa2ProcessCandidates, kCmaa2DeferredApply};
+    const size_t bytes[PipelineCount] = {sizeof kCmaa2Edges, sizeof kCmaa2DispatchArgs, sizeof kCmaa2ProcessCandidates, sizeof kCmaa2DeferredApply};
+    const char* entries[PipelineCount] = {"EdgesColor2x2CS", "ComputeDispatchArgsCS", "ProcessCandidatesCS", "DeferredColorApply2x2CS"};
+    for (uint32_t i = 0; i < PipelineCount; ++i) {
+        VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+        ci.codeSize = bytes[i]; ci.pCode = code[i];
+        VkShaderModule module = VK_NULL_HANDLE;
+        if (s->CreateShaderModule(s->device.device, &ci, nullptr, &module) != VK_SUCCESS) return false;
+        VkComputePipelineCreateInfo cp{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+        cp.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO; cp.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+        cp.stage.module = module; cp.stage.pName = entries[i]; cp.layout = s->pipelineLayout;
+        const VkResult r = s->CreateComputePipelines(s->device.device, s->device.pipelineCache, 1, &cp, nullptr, &s->pipelines[i]);
+        s->DestroyShaderModule(s->device.device, module, nullptr);
+        if (r != VK_SUCCESS) return false;
+    }
+    const uint32_t slots = s->device.frameSlots;
+    VkDescriptorPoolSize sizes[3] = {{VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 3 * slots}, {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, slots},
+                                     {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 5 * slots}};
+    VkDescriptorPoolCreateInfo pool{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    pool.maxSets = slots; pool.poolSizeCount = 3; pool.pPoolSizes = sizes;
+    if (s->CreateDescriptorPool(s->device.device, &pool, nullptr, &s->pool) != VK_SUCCESS) return false;
+    std::array<VkDescriptorSetLayout, MaxSlots> layouts{};
+    layouts.fill(s->setLayout);
+    VkDescriptorSetAllocateInfo alloc{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+    alloc.descriptorPool = s->pool; alloc.descriptorSetCount = slots; alloc.pSetLayouts = layouts.data();
+    return s->AllocateDescriptorSets(s->device.device, &alloc, s->sets) == VK_SUCCESS;
+}
+}
+
+bool Init() {
+    enabled = Var("hdCMAA", "HD (Vulkan): CMAA2 edge smoothing on the finished world (after MSAA), 0 off / 1 on", "0");
+    info = Var("hdCMAAInfo", "HD (Vulkan): CMAA2 status (read only)", "off", 0x80);
+    if (s) return true;
+    const WXL_VkRenderApi* api = wxl::ScriptMgr::GetInterface<const WXL_VkRenderApi>(WXL_VK_RENDER_API_NAME, WXL_VK_RENDER_API_VERSION);
+    if (!api || api->structSize < offsetof(WXL_VkRenderApi, UnregisterStage) + sizeof(api->UnregisterStage) || !api->GetDeviceInfo ||
+        !api->CreateImage || !api->RetireImage || !api->CreateBuffer || !api->RetireBuffer || !api->RegisterStage || !api->UnregisterStage) {
+        Info("CMAA2: the render API is missing");
+        return false;
+    }
+    if (!Create(api)) {Destroy(); Info("CMAA2: initialization failed"); return false;}
+    WXL_VkStageDesc desc{};
+    desc.structSize = sizeof desc; desc.point = WXL_VK_POINT_BEFORE_UI; desc.order = 900; // after every other BeforeUi stage
+    desc.flags = WXL_VK_STAGE_WRITES_COLOR; desc.Wanted = Wanted; desc.Run = Stage;
+    registration = api->RegisterStage(&desc, "HD.CMAA2");
+    if (!registration) {Destroy(); Info("CMAA2: stage registration failed"); return false;}
+    Info("off");
+    return true;
+}
+
+bool Shutdown() {
+    if (!s && !registration) return true;
+    if (registration && s) {s->api->UnregisterStage(registration);}
+    registration = nullptr;
+    if (s) {
+        if (s->last > wxlvk::native::present::Completed()) {
+            if (wxlvk::native::present::FrameOpen() && !wxlvk::native::present::FlushAndWait()) return false;
+            if (!wxlvk::native::present::WaitSerial(s->last)) return false;
+        }
+        Destroy();
+    }
+    Info("off");
+    return true;
+}
+}
