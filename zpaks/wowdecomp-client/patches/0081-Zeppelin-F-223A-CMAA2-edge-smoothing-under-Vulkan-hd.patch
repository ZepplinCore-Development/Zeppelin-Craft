@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Zeppelin F-223A: CMAA2.hlsl (Intel, Apache-2.0) -> CMAA2.spv.h, one SPIR-V array per entry point.
+
+glslang's HLSL front end (~/.local/glslang/bin/glslangValidator) compiles each compute entry point; its
+[[vk::image_format]] support is missing, so the colour output's storage image (float, emitted Rgba32f) is patched to
+Rgba8 to match the back buffer's R8G8B8A8_UNORM view; the uint storage images stay R32ui (the stage makes them
+R32_UINT). Prints every entry point's bindings so HdVulkanCMAA2.cpp's layout can be checked against them.
+Usage: python3 cmaa2_spv.py  (writes CMAA2.spv.h beside this file)
+"""
+import os, struct, subprocess, sys, tempfile
+HERE = os.path.dirname(os.path.abspath(__file__))
+GLSLANG = os.path.expanduser('~/.local/glslang/bin/glslangValidator')
+ENTRIES = [('EdgesColor2x2CS', 'kCmaa2Edges'), ('ComputeDispatchArgsCS', 'kCmaa2DispatchArgs'),
+           ('ProcessCandidatesCS', 'kCmaa2ProcessCandidates'), ('DeferredColorApply2x2CS', 'kCmaa2DeferredApply')]
+DEFINES = ['CMAA2_UAV_STORE_TYPED=1', 'CMAA2_UAV_STORE_TYPED_UNORM_FLOAT=1', 'CMAA2_UAV_STORE_CONVERT_TO_SRGB=0',
+           'CMAA2_STATIC_QUALITY_PRESET=2', 'CMAA2_EXTRA_SHARPNESS=0']
+FMT_RGBA32F, FMT_RGBA8 = 1, 4
+TYPES = {25: 'image', 26: 'sampler', 30: 'struct'}
+
+def compile_entry(entry, out):
+    cmd = [GLSLANG, '-D', '-V', '-S', 'comp', '-e', entry, '--target-env', 'vulkan1.1',
+           '--shift-texture-binding', '10', '--shift-sampler-binding', '20', '--shift-UAV-binding', '0', '-o', out]
+    cmd += ['-D' + d for d in DEFINES] + [os.path.join(HERE, 'CMAA2.hlsl')]
+    r = subprocess.run(cmd, capture_output=True, text=True)
+    if r.returncode or not os.path.exists(out):
+        sys.exit('glslang failed for %s:\n%s%s' % (entry, r.stdout, r.stderr))
+
+def patch_and_bindings(words):
+    words = list(words)
+    i, imgs, names, binding, typeof, ptr = 5, {}, {}, {}, {}, {}
+    while i < len(words):
+        op, n = words[i] & 0xFFFF, words[i] >> 16
+        a = words[i + 1:i + n]
+        if op == 25:                                  # OpTypeImage: id, sampled type, dim, depth, arrayed, ms, sampled, format
+            if a[6] == 2 and a[7] == FMT_RGBA32F:
+                words[i + 8] = FMT_RGBA8
+            imgs[a[0]] = 'storage image' if a[6] == 2 else 'sampled image'
+        elif op == 26: imgs[a[0]] = 'sampler'
+        elif op == 32: ptr[a[0]] = a[2]               # OpTypePointer id, storage class, type
+        elif op == 59: typeof[a[1]] = a[0]            # OpVariable result type, id
+        elif op == 71 and a[1] == 33: binding[a[0]] = a[2]
+        i += n
+    out = []
+    for var, b in sorted(binding.items(), key=lambda kv: kv[1]):
+        t = ptr.get(typeof.get(var), None)
+        out.append((b, imgs.get(t, 'storage buffer')))
+    return words, out
+
+lines = ['// Generated by cmaa2_spv.py from CMAA2.hlsl (Intel CMAA2, Apache-2.0; see LICENSE-CMAA2.txt). Do not edit.',
+         '// Defines: ' + ' '.join(DEFINES), '#pragma once', '#include <cstdint>']
+with tempfile.TemporaryDirectory() as tmp:
+    for entry, name in ENTRIES:
+        spv = os.path.join(tmp, entry + '.spv')
+        compile_entry(entry, spv)
+        data = open(spv, 'rb').read()
+        words, binds = patch_and_bindings(struct.unpack('<%dI' % (len(data) // 4), data))
+        print('%-26s %s' % (entry, ', '.join('%d %s' % b for b in binds)))
+        lines.append('// %s: bindings %s' % (entry, ', '.join('%d %s' % b for b in binds)))
+        lines.append('static const uint32_t %s[] = {' % name)
+        for k in range(0, len(words), 8):
+            lines.append('    ' + ','.join('0x%08x' % w for w in words[k:k + 8]) + ',')
+        lines.append('};')
+open(os.path.join(HERE, 'CMAA2.spv.h'), 'w').write('\n'.join(lines) + '\n')
