+++ b/WoW/Common/ComponentCore/ZepCustomizations.h
@@ -0,0 +1,57 @@
+#ifndef WOW_COMMON_COMPONENTCORE_ZEPCUSTOMIZATIONS_H
+#define WOW_COMMON_COMPONENTCORE_ZEPCUSTOMIZATIONS_H
+
+// Not in the original (F-230): split facial features. Zeppelin\CharCustomizations.txt says, per race and sex,
+// which geoset slots a player may set on top of the legacy CharacterFacialHairStyles row, the geoset group each
+// slot owns and the geoset each of its choices shows. Without the file every lookup is nullptr and characters
+// render exactly as stock.
+
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+struct CharacterPreferences;
+
+struct ZepChoice {
+    uint16_t geoset;
+    uint16_t swapFrom;      // 0 = no swap
+    uint16_t swapTo;
+};
+
+struct ZepSlotDef {
+    uint8_t slot;
+    uint8_t type;           // option type id (label), §1 of the F-230 spec
+    uint8_t group;          // geoset group owned (non-link slots)
+    uint8_t follow;         // the stock helmet-hide group this slot obeys
+    bool link;              // on/off slot: value 1 off, 2 on
+    std::vector<ZepChoice> choices;
+    std::vector<std::pair<uint8_t, uint8_t>> linkPairs;    // dest group, src group
+
+    // choices the creator cycles through (a link slot has off / on)
+    uint32_t Count() const { return this->link ? 2 : static_cast<uint32_t>(this->choices.size()); }
+};
+
+struct ZepRaceDef {
+    enum Mode { LEGACY, TEXTURE, HIDDEN };
+    Mode mode = LEGACY;
+    bool hasFacial = false;     // a "facial" line exists
+    uint8_t labelType = 0;
+    int32_t baseVariation = 0;
+    std::vector<int32_t> textureFilter;
+    ZepSlotDef* slots[6] = {};
+    std::vector<std::pair<uint16_t, uint16_t>> implies;    // src geoset, dst geoset
+};
+
+// Lazy-loads the file on the first call. nullptr when the file is missing or the race/sex has no lines.
+const ZepRaceDef* ZepCustomizationsGet(uint32_t race, uint32_t sex);
+
+// The active slot value of a slot (1..Count()), 0 when unset, undefined or out of range.
+uint32_t ZepSlotValue(const ZepRaceDef* def, const CharacterPreferences& prefs, uint32_t slot);
+
+// OBJECT_FIELD_PADDING of a player: nibble s = slot s (s = 0..5), byte 3 = jewellery layer.
+void ZepUnpackPadding(uint32_t pad, CharacterPreferences& prefs);
+
+// The HelmetGeosetVisData m_hideGeoset[] index of a stock geoset group, -1 when the group has none.
+int32_t ZepFollowBit(uint32_t group);
+
+#endif
