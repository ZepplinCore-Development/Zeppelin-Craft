+
+// Not in the original (F-230): split facial features. The legacy CharacterFacialHairStyles row has set groups
+// 1, 2, 3, 16 and 17; every geoset slot the character has set (Zeppelin\CharCustomizations.txt) overrides the
+// group it owns, a chosen piece of jewellery may swap its host mesh (pierced ear), unset slots keep the legacy
+// look through the file's imply lines, and on/off link slots copy a variant from one group into another.
+void CCharacterComponent::ApplyZepCustomizations() {
+    const CharacterPreferences& prefs = this->m_data.m_preferences;
+    const ZepRaceDef* def = ZepCustomizationsGet(prefs.m_raceID, prefs.m_sexID);
+
+    if (!def) {
+        return;
+    }
+
+    uint32_t* geosets = this->m_data.m_geosets;
+    geosets[14] = 1400;     // no legacy column feeds group 14
+
+    for (uint32_t s = 0; s < 6; s++) {
+        const ZepSlotDef* slot = def->slots[s];
+        uint32_t v = ZepSlotValue(def, prefs, s);
+
+        if (slot && !slot->link && v) {
+            uint32_t geoset = slot->choices[v - 1].geoset;
+            geosets[slot->group] = geoset ? geoset : slot->group * 100;
+        }
+    }
+
+    for (uint32_t s = 0; s < 6; s++) {
+        const ZepSlotDef* slot = def->slots[s];
+        uint32_t v = ZepSlotValue(def, prefs, s);
+
+        if (slot && !slot->link && v && slot->choices[v - 1].swapFrom) {
+            for (int32_t i = 0; i < 19; i++) {
+                if (geosets[i] == slot->choices[v - 1].swapFrom) {
+                    geosets[i] = slot->choices[v - 1].swapTo;
+                }
+            }
+        }
+    }
+
+    for (const auto& imply : def->implies) {
+        uint32_t target = imply.second / 100;
+        bool owned = false;
+
+        for (uint32_t s = 0; s < 6 && !owned; s++) {
+            const ZepSlotDef* slot = def->slots[s];
+
+            if (!slot || !ZepSlotValue(def, prefs, s)) {
+                continue;
+            }
+
+            if (!slot->link) {
+                owned = slot->group == target;
+            } else {
+                for (const auto& pair : slot->linkPairs) {
+                    owned = owned || pair.first == target;
+                }
+            }
+        }
+
+        if (!owned && geosets[imply.first / 100] == imply.first) {
+            geosets[target] = imply.second;
+        }
+    }
+
+    for (uint32_t s = 0; s < 6; s++) {
+        const ZepSlotDef* slot = def->slots[s];
+        uint32_t v = ZepSlotValue(def, prefs, s);
+
+        if (!slot || !slot->link || !v) {
+            continue;
+        }
+
+        for (const auto& pair : slot->linkPairs) {
+            geosets[pair.first] = v == 2 ? pair.first * 100 + geosets[pair.second] % 100 : pair.first * 100;
+        }
+    }
+
+    this->m_flags |= 0x4;
+}
+
+// Not in the original (F-230): AddHelm's m_hideGeoset[] rule for the groups the geoset slots own. A set slot hides
+// when the helm hides the stock group it follows; an implied geoset hides with its source group.
+void CCharacterComponent::HideZepCustomizationsUnderHelm(uint32_t raceMask, const int32_t* hideGeoset) {
+    const CharacterPreferences& prefs = this->m_data.m_preferences;
+    const ZepRaceDef* def = ZepCustomizationsGet(prefs.m_raceID, prefs.m_sexID);
+
+    if (!def) {
+        return;
+    }
+
+    uint32_t* geosets = this->m_data.m_geosets;
+    bool ownedSet[19] = {};
+
+    for (uint32_t s = 0; s < 6; s++) {
+        const ZepSlotDef* slot = def->slots[s];
+
+        if (!slot || !ZepSlotValue(def, prefs, s)) {
+            continue;
+        }
+
+        int32_t bit = ZepFollowBit(slot->follow);
+        bool hide = bit >= 0 && (raceMask & hideGeoset[bit]);
+
+        if (!slot->link) {
+            ownedSet[slot->group] = true;
+
+            if (hide) {
+                geosets[slot->group] = slot->group * 100;
+            }
+        } else {
+            for (const auto& pair : slot->linkPairs) {
+                ownedSet[pair.first] = true;
+
+                if (hide) {
+                    geosets[pair.first] = pair.first * 100;
+                }
+            }
+        }
+    }
+
+    for (const auto& imply : def->implies) {
+        uint32_t target = imply.second / 100;
+        int32_t bit = ZepFollowBit(imply.first / 100);
+
+        if (!ownedSet[target] && geosets[target] == imply.second && bit >= 0 && (raceMask & hideGeoset[bit])) {
+            geosets[target] = target * 100;
+        }
+    }
 }
 
