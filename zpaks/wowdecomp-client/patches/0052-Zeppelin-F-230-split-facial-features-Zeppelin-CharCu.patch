index 00000000..77e1ce6b
--- /dev/null
+++ b/WoW/Common/ComponentCore/ZepCustomizations.cpp
@@ -0,0 +1,351 @@
+// Not in the original (F-230): loader and lookups for Zeppelin\CharCustomizations.txt (split facial features).
+// Grammar (one record per line, '#' comments, unknown keywords ignored, first record "version 1"):
+//   facial <race> <sex> legacy  <labelType>
+//   facial <race> <sex> texture <labelType> <v>[,<v>...]
+//   facial <race> <sex> hidden  <baseVariation>
+//   slot   <race> <sex> <slot> <type> <group> <follow>
+//   choice <race> <sex> <slot> <geoset> [host=<geoset>] [swap=<from>:<to>]
+//   link   <race> <sex> <slot> <type> <follow> <dest>:<src>[,<dest>:<src>...]
+//   imply  <race> <sex> <srcGeoset> <dstGeoset>
+
+#include "WoW/Common/ComponentCore/ZepCustomizations.h"
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include "Engine/Source/BlizzardCore/SFile2-Core.h"
+#include "WoW/Source/Extension/ExtensionMgr.h"
+#include "WoW/Source/Glue/Types.h"
+
+namespace {
+
+constexpr uint32_t kMaxRace = 64;
+
+std::mutex s_lock;
+bool s_loaded = false;
+ZepRaceDef* s_defs[kMaxRace][2] = {};
+
+bool GroupOk(uint32_t group) {
+    return group == 1 || group == 2 || group == 3 || group == 14 || group == 16;
+}
+
+bool FollowOk(uint32_t follow) {
+    return ZepFollowBit(follow) >= 0;
+}
+
+ZepRaceDef* Def(uint32_t race, uint32_t sex, bool create) {
+    if (race >= kMaxRace || sex > 1) {
+        return nullptr;
+    }
+
+    if (!s_defs[race][sex] && create) {
+        s_defs[race][sex] = new ZepRaceDef();
+    }
+
+    return s_defs[race][sex];
+}
+
+std::vector<std::string> Split(const std::string& text, char sep) {
+    std::vector<std::string> out;
+    std::string item;
+    std::istringstream in(text);
+
+    while (std::getline(in, item, sep)) {
+        if (!item.empty()) {
+            out.push_back(item);
+        }
+    }
+
+    return out;
+}
+
+uint32_t Num(const std::string& token) {
+    return static_cast<uint32_t>(std::strtoul(token.c_str(), nullptr, 10));
+}
+
+void Parse(const std::string& text) {
+    std::istringstream lines(text);
+    std::string line;
+    bool versionSeen = false;
+    uint32_t lineNo = 0;
+    uint32_t records = 0;
+
+    while (std::getline(lines, line)) {
+        lineNo++;
+        size_t hash = line.find('#');
+
+        if (hash != std::string::npos) {
+            line.resize(hash);
+        }
+
+        std::vector<std::string> t;
+        {
+            std::istringstream words(line);
+            std::string word;
+
+            while (words >> word) {
+                t.push_back(word);
+            }
+        }
+
+        if (t.empty()) {
+            continue;
+        }
+
+        if (!versionSeen) {
+            if (t[0] != "version" || t.size() < 2) {
+                sExtensionMgr->Log("F-230: CharCustomizations.txt line %u: first record is not 'version', file ignored", lineNo);
+                return;
+            }
+
+            if (Num(t[1]) > 1) {
+                sExtensionMgr->Log("F-230: CharCustomizations.txt version %u is newer than this client (1), file ignored", Num(t[1]));
+                return;
+            }
+
+            versionSeen = true;
+            continue;
+        }
+
+        const std::string& kw = t[0];
+
+        if (kw != "facial" && kw != "slot" && kw != "choice" && kw != "link" && kw != "imply") {
+            continue;   // forward compatible
+        }
+
+        if (t.size() < 4) {
+            sExtensionMgr->Log("F-230: CharCustomizations.txt line %u: too few tokens", lineNo);
+            continue;
+        }
+
+        ZepRaceDef* def = Def(Num(t[1]), Num(t[2]), true);
+
+        if (!def) {
+            sExtensionMgr->Log("F-230: CharCustomizations.txt line %u: bad race/sex", lineNo);
+            continue;
+        }
+
+        records++;
+
+        if (kw == "facial") {
+            def->hasFacial = true;
+
+            if (t[3] == "legacy" && t.size() >= 5) {
+                def->mode = ZepRaceDef::LEGACY;
+                def->labelType = static_cast<uint8_t>(Num(t[4]));
+            } else if (t[3] == "texture" && t.size() >= 6) {
+                def->mode = ZepRaceDef::TEXTURE;
+                def->labelType = static_cast<uint8_t>(Num(t[4]));
+                def->textureFilter.clear();
+
+                for (const std::string& v : Split(t[5], ',')) {
+                    def->textureFilter.push_back(static_cast<int32_t>(Num(v)));
+                }
+            } else if (t[3] == "hidden" && t.size() >= 5) {
+                def->mode = ZepRaceDef::HIDDEN;
+                def->baseVariation = static_cast<int32_t>(Num(t[4]));
+            } else {
+                def->hasFacial = false;
+                sExtensionMgr->Log("F-230: CharCustomizations.txt line %u: bad facial record", lineNo);
+            }
+        } else if (kw == "slot") {
+            if (t.size() < 7) {
+                sExtensionMgr->Log("F-230: CharCustomizations.txt line %u: bad slot record", lineNo);
+                continue;
+            }
+
+            uint32_t slot = Num(t[3]), group = Num(t[5]), follow = Num(t[6]);
+
+            if (slot >= 6 || !GroupOk(group) || !FollowOk(follow) || def->slots[slot]) {
+                sExtensionMgr->Log("F-230: CharCustomizations.txt line %u: slot %u rejected (range, group, follow or duplicate)", lineNo, slot);
+                continue;
+            }
+
+            ZepSlotDef* s = new ZepSlotDef();
+            s->slot = static_cast<uint8_t>(slot);
+            s->type = static_cast<uint8_t>(Num(t[4]));
+            s->group = static_cast<uint8_t>(group);
+            s->follow = static_cast<uint8_t>(follow);
+            s->link = false;
+            def->slots[slot] = s;
+        } else if (kw == "choice") {
+            if (t.size() < 5) {
+                continue;
+            }
+
+            uint32_t slot = Num(t[3]);
+            ZepSlotDef* s = slot < 6 ? def->slots[slot] : nullptr;
+
+            if (!s || s->link) {
+                sExtensionMgr->Log("F-230: CharCustomizations.txt line %u: choice for an undefined slot %u", lineNo, slot);
+                continue;
+            }
+
+            ZepChoice c = {};
+            c.geoset = static_cast<uint16_t>(Num(t[4]));
+
+            if (c.geoset != 0 && c.geoset / 100 != s->group) {
+                sExtensionMgr->Log("F-230: CharCustomizations.txt line %u: geoset %u is not in group %u", lineNo, c.geoset, s->group);
+                continue;
+            }
+
+            for (size_t i = 5; i < t.size(); i++) {
+                if (t[i].compare(0, 5, "swap=") == 0) {
+                    size_t colon = t[i].find(':');
+
+                    if (colon != std::string::npos) {
+                        uint32_t from = Num(t[i].substr(5, colon - 5));
+                        uint32_t to = Num(t[i].substr(colon + 1));
+
+                        if (from / 100 < 19 && to / 100 == from / 100) {
+                            c.swapFrom = static_cast<uint16_t>(from);
+                            c.swapTo = static_cast<uint16_t>(to);
+                        }
+                    }
+                }
+                // host= is documentation for the fit check; ignored in v1
+            }
+
+            s->choices.push_back(c);
+        } else if (kw == "link") {
+            if (t.size() < 7) {
+                sExtensionMgr->Log("F-230: CharCustomizations.txt line %u: bad link record", lineNo);
+                continue;
+            }
+
+            uint32_t slot = Num(t[3]), follow = Num(t[5]);
+
+            if (slot >= 6 || !FollowOk(follow) || def->slots[slot]) {
+                sExtensionMgr->Log("F-230: CharCustomizations.txt line %u: link slot %u rejected", lineNo, slot);
+                continue;
+            }
+
+            ZepSlotDef* s = new ZepSlotDef();
+            s->slot = static_cast<uint8_t>(slot);
+            s->type = static_cast<uint8_t>(Num(t[4]));
+            s->group = 0;
+            s->follow = static_cast<uint8_t>(follow);
+            s->link = true;
+
+            for (const std::string& pair : Split(t[6], ',')) {
+                size_t colon = pair.find(':');
+
+                if (colon == std::string::npos) {
+                    continue;
+                }
+
+                uint32_t dest = Num(pair.substr(0, colon)), src = Num(pair.substr(colon + 1));
+
+                if (GroupOk(dest) && src < 19) {
+                    s->linkPairs.emplace_back(static_cast<uint8_t>(dest), static_cast<uint8_t>(src));
+                }
+            }
+
+            if (s->linkPairs.empty()) {
+                delete s;
+                continue;
+            }
+
+            def->slots[slot] = s;
+        } else if (kw == "imply") {
+            uint32_t src = Num(t[3]);
+            uint32_t dst = t.size() >= 5 ? Num(t[4]) : 0;
+
+            if (src / 100 >= 19 || !GroupOk(dst / 100)) {
+                sExtensionMgr->Log("F-230: CharCustomizations.txt line %u: bad imply", lineNo);
+                continue;
+            }
+
+            def->implies.emplace_back(static_cast<uint16_t>(src), static_cast<uint16_t>(dst));
+        }
+    }
+
+    // a slot holds a nibble: more than 15 choices cannot be stored
+    uint32_t slots = 0;
+
+    for (auto& races : s_defs) {
+        for (ZepRaceDef* def : races) {
+            if (!def) {
+                continue;
+            }
+
+            for (ZepSlotDef*& s : def->slots) {
+                if (s && (s->Count() == 0 || s->Count() > 15)) {
+                    sExtensionMgr->Log("F-230: CharCustomizations.txt: slot %u with %u choices dropped (1..15 allowed)", s->slot, s->Count());
+                    delete s;
+                    s = nullptr;
+                }
+
+                slots += s ? 1 : 0;
+            }
+        }
+    }
+
+    sExtensionMgr->Log("F-230: CharCustomizations.txt loaded, %u records, %u slots", records, slots);
+}
+
+void Load() {
+    SFileImpl* file = nullptr;
+
+    if (!SFileOpenFile("Zeppelin\\CharCustomizations.txt", &file) || !file) {
+        sExtensionMgr->Log("F-230: no Zeppelin\\CharCustomizations.txt, legacy facial features only");
+        return;
+    }
+
+    std::string text(SFileGetFileSize(file, nullptr), '\0');
+    uint32_t read = 0;
+
+    if (!text.empty()) {
+        SFileReadFile(file, text.data(), static_cast<uint32_t>(text.size()), &read, nullptr, 0);
+    }
+
+    SFileCloseFile(file);
+    text.resize(read);
+    Parse(text);
+}
+
+}   // namespace
+
+const ZepRaceDef* ZepCustomizationsGet(uint32_t race, uint32_t sex) {
+    {
+        std::lock_guard<std::mutex> guard(s_lock);
+
+        if (!s_loaded) {
+            s_loaded = true;
+            Load();
+        }
+    }
+
+    return Def(race, sex, false);
+}
+
+uint32_t ZepSlotValue(const ZepRaceDef* def, const CharacterPreferences& prefs, uint32_t slot) {
+    if (!def || slot >= 6 || !def->slots[slot]) {
+        return 0;
+    }
+
+    uint32_t v = prefs.m_zepSlot[slot];
+    return v >= 1 && v <= def->slots[slot]->Count() ? v : 0;
+}
+
+void ZepUnpackPadding(uint32_t pad, CharacterPreferences& prefs) {
+    for (uint32_t s = 0; s < 6; s++) {
+        prefs.m_zepSlot[s] = static_cast<uint8_t>((pad >> (4 * s)) & 0xF);
+    }
+
+    prefs.m_jewelleryId = static_cast<uint8_t>(pad >> 24);
+}
+
+int32_t ZepFollowBit(uint32_t group) {
+    switch (group) {
+        case 0: return 0;
+        case 1: return 1;
+        case 2: return 2;
+        case 3: return 3;
+        case 7: return 4;
+        case 16: return 5;
+        case 17: return 6;
+        default: return -1;
+    }
+}
