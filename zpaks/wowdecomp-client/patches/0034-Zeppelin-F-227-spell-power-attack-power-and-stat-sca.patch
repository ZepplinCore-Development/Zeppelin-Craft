@@ -3747,6 +3920,10 @@ void Spell_C_GetMinMaxPoints(const SpellRec* spell, uint32_t effectIndex, float*
             Spell_C_ModifySpellValue(spell, maxValue, 23);
         }
 
+        if (!isPet && !isUnit) {
+            ZepAddCasterBonus(spell, effectIndex, minValue, maxValue); // Not in the original (F-227): SP/AP/stat, before DAMAGE/DOT mods
+        }
+
         if (damage) {
             if (periodic) {
                 Spell_C_ModifySpellValue(spell, minValue, 22);
