+// Zeppelin F-223B: the stock shadow levels split into independent CVars. extShadowQuality stays as the preset: changing
+// it writes these to the stock combination, after which each one can be changed on its own.
+enum ShadowSplitVar {
+    SHADOW_SPLIT_CHAR,           // hdShadowChar          0 off, 1 = 1024, 2 = 2048
+    SHADOW_SPLIT_CHAR_RADIUS,    // hdShadowCharRadius    yards
+    SHADOW_SPLIT_WORLD,          // hdShadowWorld         0 off, 1 = 1024, 2 = 2048
+    SHADOW_SPLIT_WORLD_UPDATE,   // hdShadowWorldUpdate   0 tiles after moving, 1 every frame
+    SHADOW_SPLIT_WORLD_CASTERS,  // hdShadowWorldCasters  0..2
+    SHADOW_SPLIT_WORLD_DISTANCE, // hdShadowWorldDistance cascade size scale
+    SHADOW_SPLIT_UNIT_DIM,       // hdShadowUnitDim       0/1
+    NUM_SHADOW_SPLIT_VARS
+};
+
+static CVar* s_shadowSplitVars[NUM_SHADOW_SPLIT_VARS];
+
+static void ShadowPresetValue(uint32_t which, uint32_t mode, char* buffer, size_t size) {
+    const CShadowCache::SplitSettings& preset = CShadowCache::s_presets[mode];
+
+    switch (which) {
+        case SHADOW_SPLIT_CHAR: SStrPrintf(buffer, size, "%d", preset.charShadows ? (preset.charSize >= 2048 ? 2 : 1) : 0); break;
+        case SHADOW_SPLIT_CHAR_RADIUS: SStrPrintf(buffer, size, "%g", preset.charRadius); break;
+        case SHADOW_SPLIT_WORLD: SStrPrintf(buffer, size, "%d", preset.worldShadows ? (preset.worldSize >= 2048 ? 2 : 1) : 0); break;
+        case SHADOW_SPLIT_WORLD_UPDATE: SStrPrintf(buffer, size, "%d", preset.worldEveryFrame); break;
+        case SHADOW_SPLIT_WORLD_CASTERS: SStrPrintf(buffer, size, "%d", preset.worldCasters); break;
+        case SHADOW_SPLIT_WORLD_DISTANCE: SStrPrintf(buffer, size, "%g", preset.worldDistance); break;
+        default: SStrPrintf(buffer, size, "%d", preset.unitDimming); break;
+    }
+}
+
+// Writes the preset into the registered hdShadow* CVars (their callbacks fill CShadowCache::s_split).
+static void WriteShadowPreset(uint32_t mode) {
+    char value[32];
+
+    for (uint32_t i = 0; i < NUM_SHADOW_SPLIT_VARS; i++) {
+        if (s_shadowSplitVars[i]) {
+            ShadowPresetValue(i, mode, value, sizeof(value));
+            s_shadowSplitVars[i]->Set(value, true, false, false, true);
+        }
+    }
+}
+
+static bool ShadowSplitCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    CShadowCache::SplitSettings& split = CShadowCache::s_split;
+    int32_t number = SStrToInt(value);
+    float scale = SStrToFloat(value);
+
+    switch (static_cast<uint32_t>(reinterpret_cast<uintptr_t>(arg))) {
+        case SHADOW_SPLIT_CHAR:
+            if (number < 0 || number > 2) return false;
+            split.charShadows = number > 0;
+            split.charSize = number >= 2 ? 2048 : 1024;
+            break;
+        case SHADOW_SPLIT_CHAR_RADIUS:
+            if (scale < 5.0f || scale > 80.0f) return false;
+            split.charRadius = scale;
+            break;
+        case SHADOW_SPLIT_WORLD:
+            if (number < 0 || number > 2) return false;
+            split.worldShadows = number > 0;
+            split.worldSize = number >= 2 ? 2048 : 1024; // off: 1024, what Soft Sun Shadows force on (stock MEDIUM-HIGH)
+            break;
+        case SHADOW_SPLIT_WORLD_UPDATE:
+            if (number < 0 || number > 1) return false;
+            split.worldEveryFrame = number;
+            break;
+        case SHADOW_SPLIT_WORLD_CASTERS:
+            if (number < 0 || number > 2) return false;
+            split.worldCasters = number;
+            break;
+        case SHADOW_SPLIT_WORLD_DISTANCE:
+            if (scale < 0.25f || scale > 4.0f) return false;
+            split.worldDistance = scale;
+            break;
+        default:
+            split.unitDimming = number != 0;
+            break;
+    }
+
+    CShadowCache::ApplySplitSettings();
+
+    return true;
+}
+
+static void RegisterShadowSplitCVars() {
+    static const struct {
+        const char* name;
+        const char* help;
+    } s_vars[NUM_SHADOW_SPLIT_VARS] = {
+        { "hdShadowChar", "Character shadows (the live map around you): 0 off, 1 = 1024, 2 = 2048" },
+        { "hdShadowCharRadius", "Yards around you the character shadow map covers (stock 20)" },
+        { "hdShadowWorld", "World sun shadows (3 cascades): 0 off, 1 = 1024, 2 = 2048" },
+        { "hdShadowWorldUpdate", "World sun shadows: 0 = redrawn in tiles after you move, 1 = every frame" },
+        { "hdShadowWorldCasters", "World sun shadow casters: 0 buildings and solid objects, 1 + foliage near you, 2 + foliage everywhere and characters" },
+        { "hdShadowWorldDistance", "World sun shadow cascade size scale (1 = 40 / 160 / 640 yards)" },
+        { "hdShadowUnitDim", "Darken characters standing in baked terrain shadow" },
+    };
+
+    uint32_t preset = CWorldParam::cvar_extShadowQuality ? CWorldParam::cvar_extShadowQuality->m_intValue : 0;
+
+    if (preset >= NUM_SHADOW_MODES) {
+        preset = SHADOW_LOWEST;
+    }
+
+    // A config written before the split has extShadowQuality only: the new CVars start as its preset.
+    bool missing = false;
+    char value[32];
+
+    for (uint32_t i = 0; i < NUM_SHADOW_SPLIT_VARS; i++) {
+        missing = missing || !CVar::Lookup(s_vars[i].name);
+        ShadowPresetValue(i, SHADOW_LOWEST, value, sizeof(value));
+        s_shadowSplitVars[i] = CVar::Register(s_vars[i].name, s_vars[i].help, 1, value, ShadowSplitCallback, CATEGORY_GRAPHICS, false, reinterpret_cast<void*>(static_cast<uintptr_t>(i)), false);
+    }
+
+    if (missing) {
+        WriteShadowPreset(preset);
+    }
+}
