+// Zeppelin F-223B: the stock levels as split settings, in the order of SplitSettings. Preset 0..5 = extShadowQuality.
+//                                                      char size  radius world size  every casters dist  dim
+const CShadowCache::SplitSettings CShadowCache::s_presets[NUM_SHADOW_MODES] = {
+    { 0, 1024, 20.0f, 0, 1024, 0, 1, 1.0f, 1 }, // LOWEST
+    { 1, 1024, 20.0f, 0, 1024, 0, 1, 1.0f, 1 }, // LOW
+    { 1, 2048, 20.0f, 0, 1024, 0, 1, 1.0f, 0 }, // MEDIUM
+    { 1, 1024, 20.0f, 1, 1024, 0, 1, 1.0f, 0 }, // MEDIUM-HIGH
+    { 1, 2048, 20.0f, 1, 2048, 0, 1, 1.0f, 0 }, // HIGH
+    { 1, 2048, 20.0f, 1, 2048, 1, 2, 1.0f, 0 }, // VERY HIGH
+};
+
+CShadowCache::SplitSettings CShadowCache::s_split = CShadowCache::s_presets[SHADOW_LOWEST];
+int32_t CShadowCache::s_worldForced;
+CTexture* CShadowCache::s_pcfBandTarget;
+uint32_t CShadowCache::s_charMapSize = 1024;
+uint32_t CShadowCache::s_bandMapSize = 1024;
+
+// Zeppelin F-223B: the effective mode the split settings stand for. Every stock test of s_shadowMode (shader value,
+// band textures, tile or full updates) then follows the settings. Falls back like the stock slider when the device
+// cannot do the cascades.
+void CShadowCache::ApplySplitSettings() {
+    const SplitSettings& split = CShadowCache::s_split;
+    EShadowMode mode = SHADOW_LOWEST;
+
+    if (split.worldShadows || CShadowCache::s_worldForced) {
+        mode = split.worldEveryFrame ? SHADOW_VERY_HIGH : (split.worldSize >= 2048 ? SHADOW_HIGH : SHADOW_MEDIUM_HIGH);
+
+        if (!CShadowCache::ValidateShadowMode(mode)) {
+            mode = SHADOW_LOWEST;
+        }
+    }
+
+    if (mode == SHADOW_LOWEST && split.charShadows) {
+        mode = split.charSize >= 2048 ? SHADOW_MEDIUM : SHADOW_LOW;
+    }
+
+    if (!CShadowCache::ValidateShadowMode(mode)) {
+        mode = SHADOW_LOWEST;
+    }
+
+    CShadowCache::s_shadowMode = mode;
+    CShadowCache::s_recreateTextures = 1;
+}
+
+void CShadowCache::SetWorldShadowsForced(int32_t forced) {
+    CShadowCache::s_worldForced = forced;
+    CShadowCache::ApplySplitSettings();
+}
+
+// Zeppelin F-223B: what the player map (20 yards around the camera target) draws. 1 = units, 4 = foliage and indoor
+// buildings, 8 = buildings, solid doodads and terrain. Stock: 1 (LOW, MEDIUM), 5 (MEDIUM-HIGH, HIGH), 13 (VERY HIGH).
+int32_t CShadowCache::PlayerMapQueryFlags() {
+    int32_t flags = CShadowCache::CharacterShadows() ? 0x1 : 0;
+
+    if (CShadowCache::WorldShadows()) {
+        if (CShadowCache::s_split.worldCasters >= 2) {
+            flags |= 0xC;
+        } else if (CShadowCache::s_split.worldCasters == 1) {
+            flags |= 0x4;
+        }
+    }
+
+    return flags;
+}
+
+// Zeppelin F-223B: what the cascades draw. Stock: 8 in tiles (MEDIUM-HIGH, HIGH), 13 every frame (VERY HIGH). Units
+// never go into tiles: a tile is kept until you move, they would leave their shadow behind.
+int32_t CShadowCache::BandQueryFlags() {
+    int32_t flags = CShadowCache::s_split.worldCasters >= 2 ? 0xC : 0x8;
+
+    if (!CShadowCache::BandsEveryFrame()) {
+        return flags | CShadowCache::QUERY_CACHED_BAND;
+    }
+
+    if (CShadowCache::s_split.worldCasters >= 2 && CShadowCache::CharacterShadows()) {
+        flags |= 0x1;
+    }
+
+    return flags;
+}
