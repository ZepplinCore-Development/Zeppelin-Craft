+// Custom (Zeppelin F-236, from Medviten's wowdecomp fork): see Unit_C.h. Any display using the altered race's character model (the model of its ChrRaces male/female
+// display) marks the altered form, so a transform aura into e.g. a human NPC creature counts too; the client then
+// builds the player's own character of that race instead of the NPC's fixed look.
+bool CGUnit_C::IsInAlteredForm() const {
+    if (!(this->m_obj->m_type & TYPEMASK_PLAYER)) {
+        return false;
+    }
+
+    uint32_t altered = ClientGetAlteredFormRace(this->m_unit->m_unitFieldBytes0[0]);
+    ChrRacesRec* alteredRec = altered ? g_chrRacesDB.GetRecord(altered) : nullptr;
+
+    if (!alteredRec) {
+        return false;
+    }
+
+    int32_t displayId = this->GetLocalDisplayID();
+
+    if (!displayId || displayId == static_cast<int32_t>(this->m_unit->m_unitFieldNativedisplayid)) {
+        return false;
+    }
+
+    if (displayId == alteredRec->m_maleDisplayID || displayId == alteredRec->m_femaleDisplayID) {
+        return true;
+    }
+
+    CreatureDisplayInfoRec* displayRec = g_creatureDisplayInfoDB.GetRecord(displayId);
+    CreatureDisplayInfoRec* maleRec = g_creatureDisplayInfoDB.GetRecord(alteredRec->m_maleDisplayID);
+    CreatureDisplayInfoRec* femaleRec = g_creatureDisplayInfoDB.GetRecord(alteredRec->m_femaleDisplayID);
+
+    return displayRec && ((maleRec && displayRec->m_modelID == maleRec->m_modelID) || (femaleRec && displayRec->m_modelID == femaleRec->m_modelID));
+}
+
+// Zeppelin F-236: the server sets bit 31 of OBJECT_FIELD_PADDING while a worgen is in the human form (Two Forms,
+// aura 302) and writes the stored human look into the appearance fields in the same update, so the bit and the look
+// always arrive together. Ported from Medviten's wowdecomp fork (aura-keyed there), used with the author's permission.
+bool CGUnit_C::HasAlteredFormBit() const {
+    return (this->m_obj->m_type & TYPEMASK_PLAYER) && (this->m_obj->m_pad & 0x80000000u);
+}
+
+// Custom: see Unit_C.h. Cataclysm 0x005B5070, keyed on the form bit and ClientGetAlteredFormRace instead of
+// m_currentClientRace(Flags)
+int32_t CGUnit_C::GetCurrentClientNativeDisplayID() const {
+    int32_t nativeId = this->m_unit->m_unitFieldNativedisplayid;
+
+    if (!this->HasAlteredFormBit()) {
+        return nativeId;
+    }
+
+    uint32_t altered = ClientGetAlteredFormRace(this->m_unit->m_unitFieldBytes0[0]);
+    ChrRacesRec* alteredRec = altered ? g_chrRacesDB.GetRecord(altered) : nullptr;
+
+    if (!alteredRec) {
+        return nativeId;
+    }
+
+    int32_t displayId = this->m_unit->m_unitFieldBytes0[2] ? alteredRec->m_femaleDisplayID : alteredRec->m_maleDisplayID;
+    return displayId ? displayId : nativeId;
+}
+
+// Custom: see Unit_C.h. Cataclysm 0x005BB8D0, keeping this client's m_displayId override
+int32_t CGUnit_C::GetLocalDisplayID() const {
+    int32_t displayId = this->m_displayId;
+
+    if (!displayId || this->m_unit->m_unitFieldNativedisplayid != this->m_unit->m_unitFieldDisplayid) {
+        displayId = this->m_unit->m_unitFieldDisplayid;
+    }
+
+    if (displayId == static_cast<int32_t>(this->m_unit->m_unitFieldNativedisplayid)) {
+        displayId = this->GetCurrentClientNativeDisplayID();
+    }
+
+    return displayId;
+}
+
+// Custom: see Unit_C.h. Cataclysm 0x005BEEA0 without the display transition and casting checks
+bool CGUnit_C::IsMountSelf() const {
+    int32_t mountDisplayId = this->m_mountDisplayId;
+
+    if (mountDisplayId <= 0) {
+        return false;
+    }
+
+    return mountDisplayId == static_cast<int32_t>(this->m_unit->m_unitFieldNativedisplayid) || mountDisplayId == this->GetLocalDisplayID();
+}
+
+// Custom: Cataclysm's s_animSetMountSelfGround (0x00CA7DC0) as a map from the anims this client chooses. Swimming and
+// flying keep the unit's own anims, which these models have no MountSelf versions of.
+static const uint32_t s_mountSelfAnims[][2] = {
+    { ANIM_STAND, 618 },
+    { ANIM_WALK, 620 },
+    { ANIM_RUN, 622 },
+    { ANIM_SPRINT, 624 },
+    { ANIM_SHUFFLE_LEFT, 630 },
+    { ANIM_SHUFFLE_RIGHT, 632 },
+    { ANIM_WALKBACKWARDS, 634 },
+    { ANIM_JUMP, 638 },
+    { ANIM_JUMP_START, 640 },
+    { ANIM_JUMP_END, 642 },
+    { ANIM_JUMP_LAND_RUN, 644 },
+    { ANIM_FALL, 648 },
+};
+
+// Custom: see Unit_C.h. Keeps the anim when the model has no MountSelf version of it (e.g. female Worgen have no
+// MountSelf sprint, so they sprint with the MountSelf run)
+uint32_t CGUnit_C::GetMountSelfAnim(uint32_t anim) const {
+    CM2Model* model = this->m_worldModel;
+
+    if (!model) {
+        return anim;
+    }
+
+    for (uint32_t i = 0; i < sizeof(s_mountSelfAnims) / sizeof(s_mountSelfAnims[0]); i++) {
+        if (s_mountSelfAnims[i][0] != anim) {
+            continue;
+        }
+
+        if (model->HasSequence(s_mountSelfAnims[i][1])) {
+            return s_mountSelfAnims[i][1];
+        }
+
+        if (anim == ANIM_SPRINT) {
+            return this->GetMountSelfAnim(ANIM_RUN);
+        }
+
+        return anim;
+    }
+
+    return anim;
+}
