+        HASHKEY_NONE key;
+        USEABLESTYLE* useable = CGBarberShop::m_useableStyles.Ptr(rec->m_type, key);
+
+        if (!useable) {
+            useable = CGBarberShop::m_useableStyles.New(rec->m_type, key, 0, 0);
+        }
+
+        STYLEREC* style = useable->m_styles.NewNode(2, 0, 0);
