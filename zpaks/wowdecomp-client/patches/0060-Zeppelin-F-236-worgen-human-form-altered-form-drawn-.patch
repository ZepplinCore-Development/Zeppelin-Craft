+}
+
+// Not in the original (Zeppelin F-236): puts the native or the altered form in front. The form in front is
+// m_character, attached to the scene; the other is kept unattached in m_alteredCharacter.
+void CCharacterCreation::SetViewingAlteredForm(bool altered) {
+    if (altered == CCharacterCreation::m_viewingAltered || !CCharacterCreation::m_alteredCharacter || !CCharacterCreation::m_character) {
+        return;
+    }
+
+    CM2Model* background = CCharacterCreation::m_charCustomizeFrame ? CCharacterCreation::m_charCustomizeFrame->m_model : nullptr;
+
+    if (CCharacterCreation::m_character->m_data.m_model && CCharacterCreation::m_character->m_data.m_model->m_attachParent) {
+        CCharacterCreation::m_character->m_data.m_model->DetachFromParent();
+    }
+
+    CCharacterComponent* front = CCharacterCreation::m_alteredCharacter;
+    CCharacterCreation::m_alteredCharacter = CCharacterCreation::m_character;
+    CCharacterCreation::m_character = front;
+    CCharacterCreation::m_viewingAltered = altered;
+
+    CCharacterCreation::m_prevSkinIndex = front->m_data.m_preferences.m_skinID;
+    CCharacterCreation::m_prevFaceIndex = front->m_data.m_preferences.m_faceId;
+    CCharacterCreation::m_prevHairColorIndex = front->m_data.m_preferences.m_hairColorId;
+    CCharacterCreation::m_prevHairStyleIndex = front->m_data.m_preferences.m_hairStyleId;
+    CCharacterCreation::m_prevFacialHairIndex = front->m_data.m_preferences.m_facialHairId;
+
+    CCharacterCreation::SetCharacterFacing(CCharacterCreation::m_charFacing);
+    CCharacterCreation::Dress();    // the outfit toggle and class outfit as the form now in front shows them
+    front->RenderPrep(0);
+
+    if (background && front->m_data.m_model) {
+        front->m_data.m_model->AttachToParent(background, 0, nullptr, 0);
+    }
+
+    CGlueLoading::StartLoad(front, 1);
+}
+
+// Not in the original (Zeppelin F-236): keeps the altered form's look (per sex) and frees it; the native form ends up in front
+void CCharacterCreation::ZepAlteredFormDrop() {
+    CCharacterCreation::SetViewingAlteredForm(false);
+
+    CCharacterComponent* altered = CCharacterCreation::m_alteredCharacter;
+
+    if (!altered) {
+        return;
+    }
+
+    uint32_t sex = altered->m_data.m_preferences.m_sexID < 2 ? altered->m_data.m_preferences.m_sexID : 0;
+
+    if (!CCharacterCreation::s_alteredPrefs[sex]) {
+        CCharacterCreation::s_alteredPrefs[sex] = new CharacterPreferences();
+    }
+
+    altered->GetPreferences(CCharacterCreation::s_alteredPrefs[sex]);
+
+    if (altered->m_data.m_model && altered->m_data.m_model->m_attachParent) {
+        altered->m_data.m_model->DetachFromParent();
+    }
+
+    CCharacterComponent::FreeComponent(altered);
+    CCharacterCreation::m_alteredCharacter = nullptr;
+}
+
+// Not in the original (Zeppelin F-236): builds the altered (human) form of a new character whose race has one, from the
+// look kept for that sex (first time: the altered race's defaults), dressed like the native form and not attached
+void CCharacterCreation::ZepAlteredFormBuild() {
+    if (CCharacterCreation::m_alteredCharacter || !CCharacterCreation::m_character || CCharacterCreation::m_existingCharacterIndex >= 0 || !CCharacterCreation::m_charCustomizeFrame) {
+        return;
+    }
+
+    const CharacterPreferences& native = CCharacterCreation::m_character->m_data.m_preferences;
+    uint32_t alteredRace = ClientGetAlteredFormRace(native.m_raceID);
+    uint32_t sex = native.m_sexID < 2 ? native.m_sexID : 0;
+    CreatureModelDataRec* modelRec = alteredRace ? GetModelDataRec(alteredRace, sex) : nullptr;
+
+    if (!modelRec || !*modelRec->m_modelName) {
+        return;
+    }
+
+    ComponentData data;
+
+    if (CCharacterCreation::s_alteredPrefs[sex]) {
+        data.SetPreferences(CCharacterCreation::s_alteredPrefs[sex]);
+    }
+
+    data.m_preferences.m_raceID = alteredRace;
+    data.m_preferences.m_sexID = sex;
+    data.m_preferences.m_classId = CCharacterCreation::m_selectedClassID;
+    CCharacterComponent::ValidateComponentData(&data, COMPONENT_CONTEXT_0);
+
+    data.m_model = CCharacterCreation::m_charCustomizeFrame->GetScene()->CreateModel(modelRec->m_modelName, 0);
+
+    if (!data.m_model) {
+        return;
+    }
+
+    data.m_model->m_lightingCallback = &CCharacterSelection::GenericLightingCallback;
+    data.m_model->m_lightingArg = CCharacterCreation::m_charCustomizeFrame->m_lightArray2;
+    data.m_model->SetBoneSequence(0xFFFFFFFF, 0, 0, 0, 1.0f, 1, 1);
+    data.m_flags |= 0x2;
+
+    CCharacterComponent* altered = CCharacterComponent::AllocComponent();
+    altered->Init(&data, nullptr);
+    CCharacterCreation::m_alteredCharacter = altered;
+
+    // Dress works on the form in front: put the altered form there for it, without attaching it
+    CCharacterComponent* native_ = CCharacterCreation::m_character;
+    CCharacterCreation::m_character = altered;
+    CCharacterCreation::Dress();
+    CCharacterCreation::m_character = native_;
+
+    altered->RenderPrep(0);
+}
