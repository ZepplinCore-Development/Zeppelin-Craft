+    }
+}
+
+// Not in the original (F-151): an eye colour (CharSections base_section 5, colour 0) or marking (base_section 6,
+// colour = skin) the character may have. Marking 0 is "none" and has no record; so is eye 0 of a race without
+// eye records.
+bool CCharacterComponent::FaceLayerValid(const CharacterPreferences& prefs, COMPONENT_VARIATIONS variation, int32_t index, COMPONENT_CONTEXT context) {
+    if (index < 0) {
+        return false;
+    }
+
+    int32_t numVariations = ComponentGetNumVariations(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, variation);
+
+    if (index == 0 && (variation == VARIATION_MARKINGS || numVariations == 0)) {
+        return true;
+    }
+
+    int32_t color = variation == VARIATION_EYES ? 0 : static_cast<int32_t>(prefs.m_skinID);
+    CharSectionsRec* rec = ComponentGetSectionsRecord(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, variation, index, color, nullptr);
+
+    return rec && ComponentFlagsMatch(rec->m_flags, GetSelectionFromContext(context, prefs.m_classId));
+}
+
+// Not in the original (F-151): loads the eye colour and marking layers of the current choices. A choice with no
+// record (no marking) clears its layer; the caller marks the head sections dirty.
+void CCharacterComponent::LoadFaceLayers(const char* debug) {
+    const CharacterPreferences& prefs = this->m_data.m_preferences;
+
+    this->LoadBaseVariation(VARIATION_EYES, 0, prefs.m_eyeId, 0, SECTION_HEAD_LOWER, debug);
+    this->LoadBaseVariation(VARIATION_EYES, 1, prefs.m_eyeId, 0, SECTION_HEAD_UPPER, debug);
+    this->LoadBaseVariation(VARIATION_MARKINGS, 0, prefs.m_markingId, prefs.m_skinID, SECTION_HEAD_LOWER, debug);
+    this->LoadBaseVariation(VARIATION_MARKINGS, 1, prefs.m_markingId, prefs.m_skinID, SECTION_HEAD_UPPER, debug);
+}
+
+// Not in the original (F-151): steps the eye colour or marking choice by one in the direction of delta, past
+// choices the character may not have, wrapping round.
+bool CCharacterComponent::CycleFaceLayer(COMPONENT_VARIATIONS variation, int32_t delta, COMPONENT_CONTEXT context) {
+    CharacterPreferences& prefs = this->m_data.m_preferences;
+    uint32_t& value = variation == VARIATION_EYES ? prefs.m_eyeId : prefs.m_markingId;
+    int32_t numVariations = ComponentGetNumVariations(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, variation);
+    int32_t step = delta > 0 ? 1 : -1;
+    int32_t index = static_cast<int32_t>(value);
+
+    for (int32_t i = 1; i < numVariations; i++) {
+        index = (index + step + numVariations) % numVariations;
+
+        if (CCharacterComponent::FaceLayerValid(prefs, variation, index, context)) {
+            value = static_cast<uint32_t>(index);
+
+            if (!(this->m_data.m_flags & 0x1)) {
+                this->LoadFaceLayers(nullptr);
+            }
+
+            this->SetDirtySections(0x300);
+            return true;
+        }
+    }
+
+    return false;
+}
+
+// Not in the original (F-151): a random eye colour or marking among those the character may have.
+bool CCharacterComponent::SetRandomFaceLayer(COMPONENT_VARIATIONS variation, COMPONENT_CONTEXT context) {
+    CharacterPreferences& prefs = this->m_data.m_preferences;
+    int32_t numVariations = ComponentGetNumVariations(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, variation);
+    int32_t* valid = static_cast<int32_t*>(alloca(sizeof(int32_t) * (numVariations + 1)));
+    int32_t numValid = 0;
+
+    for (int32_t i = 0; i < numVariations; i++) {
+        if (CCharacterComponent::FaceLayerValid(prefs, variation, i, context)) {
+            valid[numValid++] = i;
+        }
+    }
+
+    if (numValid <= 0) {
+        return false;
+    }
+
+    (variation == VARIATION_EYES ? prefs.m_eyeId : prefs.m_markingId) = static_cast<uint32_t>(valid[CRandom::dice_(numValid, g_rndSeed)]);
+
+    if (!(this->m_data.m_flags & 0x1)) {
+        this->LoadFaceLayers(nullptr);
+    }
+
+    this->SetDirtySections(0x300);
+    return true;
 }
 
