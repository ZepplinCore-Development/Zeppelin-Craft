diff --git a/Engine/Source/BlizzardCore/SFile2-Core.cpp b/Engine/Source/BlizzardCore/SFile2-Core.cpp
index 6e6fa9e..815460d 100644
--- a/Engine/Source/BlizzardCore/SFile2-Core.cpp
+++ b/Engine/Source/BlizzardCore/SFile2-Core.cpp
@@ -1022,6 +1022,13 @@ int32_t STORMAPI SFile::FileExistsEx(const char* name, uint32_t flags) {
     char path[260];
     uint32_t type;
 
+    // Not in the original: an existence check follows the same redirect as an open.
+    char redirected[260];
+
+    if (sExtensionMgr->OnFileOpen(name, redirected, sizeof(redirected))) {
+        name = redirected;
+    }
+
     return System_SFile2::FindFile(name, path, sizeof(path), flags, &type, nullptr);
 }
 
@@ -1145,6 +1152,13 @@ int32_t STORMAPI SFile::FileExists(const char* name) {
     char path[260];
     uint32_t type;
 
+    // Not in the original: an existence check follows the same redirect as an open.
+    char redirected[260];
+
+    if (sExtensionMgr->OnFileOpen(name, redirected, sizeof(redirected))) {
+        name = redirected;
+    }
+
     return System_SFile2::FindFile(name, path, sizeof(path), 0, &type, nullptr);
 }
 
