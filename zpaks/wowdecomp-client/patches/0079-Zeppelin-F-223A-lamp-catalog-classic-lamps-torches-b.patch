+    // Zeppelin F-223A: the lamp catalog (Zeppelin\LampCatalog.txt, PATCH-V; built by zep-vulkan-shaders/lamp-catalog):
+    // world models that look like a light source but carry no M2 light (1393 of 1430 stock lamp-like models). One
+    // line a model: path|x|y|z|r|g|b|flags, the light's place in model space, colour * intensity on CM2Light's scale
+    // (m_dirColor; stock fires 0.47 0.29 0.13), f = a flame (flickers).
+    struct CatalogLamp {
+        std::string path;  // lower case, backslashes
+        C3Vector pos;
+        C3Vector color;
+        bool flicker;
+    };
+    std::unordered_map<std::string, CatalogLamp> s_catalogLamps;
+    bool s_catalogLoaded = false;
+    // Per shared model: its catalog lamp or null. Checked against the file name on use, since a freed CM2Shared's
+    // address can come back for another model.
+    std::unordered_map<const CM2Shared*, const CatalogLamp*> s_catalogOf;
+
+    std::string LowerPath(const char* path) {
+        std::string out(path ? path : "");
+        for (char& c : out) {
+            if (c == '/') c = '\\';
+            else if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
+        }
+        return out;
+    }
+
+    void LoadCatalog() {
+        if (s_catalogLoaded) return;
+        s_catalogLoaded = true;
+        std::string text;
+        if (!HD::DataFile::Read("Zeppelin\\LampCatalog.txt", text)) return;
+        size_t at = 0;
+        char line[512];
+        while (HD::DataFile::Gets(text, at, line, sizeof(line))) {
+            if (line[0] == '#' || line[0] == '\r' || line[0] == '\n') continue;
+            char* field[8] = {};
+            int32_t n = 0;
+            char* p = line;
+            field[n++] = p;
+            for (; *p && n < 8; p++) {
+                if (*p == '|') { *p = '\0'; field[n++] = p + 1; }
+            }
+            for (p = field[n - 1]; *p; p++) if (*p == '\r' || *p == '\n') *p = '\0';
+            if (n < 7) continue;
+            CatalogLamp lamp;
+            lamp.path = LowerPath(field[0]);
+            lamp.pos = C3Vector(static_cast<float>(atof(field[1])), static_cast<float>(atof(field[2])), static_cast<float>(atof(field[3])));
+            lamp.color = C3Vector(static_cast<float>(atof(field[4])), static_cast<float>(atof(field[5])), static_cast<float>(atof(field[6])));
+            lamp.flicker = n > 7 && strchr(field[7], 'f') != nullptr;
+            s_catalogLamps[lamp.path] = lamp;
+        }
+    }
+
+    const CatalogLamp* CatalogFor(const CM2Shared* shared) {
+        std::unordered_map<const CM2Shared*, const CatalogLamp*>::iterator it = s_catalogOf.find(shared);
+        if (it != s_catalogOf.end()) {
+            if (!it->second || _stricmp(it->second->path.c_str(), shared->m_fileName) == 0) return it->second;
+            // the address now belongs to another model: look again
+        }
+        const CatalogLamp* found = nullptr;
+        std::unordered_map<std::string, CatalogLamp>::const_iterator c = s_catalogLamps.find(LowerPath(shared->m_fileName));
+        if (c != s_catalogLamps.end()) found = &c->second;
+        s_catalogOf[shared] = found;
+        return found;
+    }
+
+    // A flame's brightness over time: 0.82 .. 1.0, its own phase per lamp (from its position).
+    float Flicker(const C3Vector& pos) {
+        float t = static_cast<float>(GetTickCount64() % 3600000ull) * 0.001f;
+        float seed = pos.x * 0.37f + pos.y * 0.71f + pos.z * 0.13f;
+        float wave = 0.5f * sinf(t * 7.3f + seed) + 0.3f * sinf(t * 13.1f + seed * 1.7f) + 0.2f * sinf(t * 23.7f + seed * 2.3f);
+        return 0.91f + 0.09f * wave;
+    }
+
+    void GatherCatalog(const CM2Scene* scene, const C3Vector& camera) {
+        if (!s_catalog || s_catalog->m_intValue == 0) return;
+        LoadCatalog();
+        if (s_catalogLamps.empty()) return;
+        for (CM2Model* model = scene->m_modelList; model; model = model->m_sceneNext) {
+            const CM2Shared* shared = model->m_shared;
+            if (!shared || !shared->m_data || model->m_attachParent) continue; // loaded world props only, not held items
+            const C44Matrix& m = model->m_worldTransform;
+            // cheap distance test first (the model's origin)
+            float ox = m.d0 - camera.x, oy = m.d1 - camera.y, oz = m.d2 - camera.z;
+            if (ox * ox + oy * oy + oz * oz > kGatherDistance * kGatherDistance) continue;
+            const CatalogLamp* lamp = CatalogFor(shared);
+            if (!lamp) continue;
+            const C3Vector& l = lamp->pos;
+            C3Vector pos(l.x * m.a0 + l.y * m.b0 + l.z * m.c0 + m.d0,
+                         l.x * m.a1 + l.y * m.b1 + l.z * m.c1 + m.d1,
+                         l.x * m.a2 + l.y * m.b2 + l.z * m.c2 + m.d2);
+            // a bigger model, a bigger flame: scale the light by the square root of the model's scale (capped)
+            float scale = sqrtf(m.a0 * m.a0 + m.a1 * m.a1 + m.a2 * m.a2);
+            float k = sqrtf(scale < 0.25f ? 0.25f : (scale > 4.0f ? 4.0f : scale));
+            if (lamp->flicker) k *= Flicker(pos);
+            size_t before = s_frame.size();
+            AddFrameLight(pos, C3Vector(lamp->color.x * k, lamp->color.y * k, lamp->color.z * k), camera);
+            if (s_frame.size() != before) s_catalogLights++;
+        }
+    }
+
     // The lights CM2Scene::SelectLights would give anything this frame: point lights in the light grid, visible,
     // and animated this frame (or not owned by a model). Unlike SelectLights it never hides a stale light.
     // HD: plus the lamps whose model was not animated this frame, at their last animated state (s_known).
     void GatherFrame(const CM2Scene* scene, const C3Vector& camera) {
         s_frame.clear();
         s_otherFalloff = 0;
+        s_catalogLights = 0;
         if (scene != s_knownScene) {
             s_known.clear();
             s_knownScene = scene;
@@ -124,6 +235,7 @@ namespace {
             AddFrameLight(it->second.pos, it->second.color, camera);
             ++it;
         }
+        GatherCatalog(scene, camera); // Zeppelin F-223A
     }
 
     void ShowInfo(const C3Vector& camera) {
@@ -140,7 +252,7 @@ namespace {
             float d = dx * dx + dy * dy + dz * dz;
             if (nearest < 0 || d < best) { nearest = static_cast<int32_t>(i); best = d; }
         }
-        int32_t n = snprintf(text, sizeof(text), "hdLights %d: %u lights, up to %d per draw, %d other falloff", HD::LightsMode(), static_cast<uint32_t>(s_frame.size()), s_mostPerDraw, s_otherFalloff);
+        int32_t n = snprintf(text, sizeof(text), "hdLights %d: %u lights (%d from the lamp catalog of %u), up to %d per draw, %d other falloff", HD::LightsMode(), static_cast<uint32_t>(s_frame.size()), s_catalogLights, static_cast<uint32_t>(s_catalogLamps.size()), s_mostPerDraw, s_otherFalloff);
         if (nearest >= 0 && n > 0 && n < static_cast<int32_t>(sizeof(text))) {
             const FrameLight& l = s_frame[nearest];
             snprintf(text + n, sizeof(text) - n, "; nearest %.1f yd at (%.2f, %.2f, %.2f) colour (%.3f, %.3f, %.3f) radius %.1f", sqrtf(best), l.pos.x, l.pos.y, l.pos.z, l.color.x, l.color.y, l.color.z, l.radius);
