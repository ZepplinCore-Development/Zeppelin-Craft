+// Not in the original (F-230): loads the painted part of each set facial-hair slot choice that names one
+// (CharCustomizations.txt "choice ... tex=<piece>": CharSections base_section 10, type = piece, colour = hair colour;
+// texture_1 FaceLower, texture_2 FaceUpper). A hair colour without the piece row draws no paint for it.
+void CCharacterComponent::LoadZepFacialPieces(const char* debug) {
+    const CharacterPreferences& prefs = this->m_data.m_preferences;
+    const ZepRaceDef* def = ZepCustomizationsGet(prefs.m_raceID, prefs.m_sexID);
+    bool changed = false;
+
+    for (uint32_t s = 0; s < 6; s++) {
+        CharacterBaseVariation& piece = this->m_zepPiece[s];
+
+        for (void*& texture : piece.m_texture) {
+            if (texture) {
+                TextureCacheDestroyTexture(texture);
+                texture = nullptr;
+                changed = true;
+            }
+        }
+
+        if (!def || !def->pieceTextures || prefs.m_zepNpc || (this->m_data.m_flags & 0x1)) {
+            continue;
+        }
+
+        const ZepSlotDef* slot = def->slots[s];
+        uint32_t v = ZepSlotValue(def, prefs, s);
+
+        if (!slot || slot->link || !v || slot->choices[v - 1].piece < 0) {
+            continue;
+        }
+
+        CharSectionsRec* rec = ComponentGetSectionsRecord(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, VARIATION_FACIAL_PIECE, slot->choices[v - 1].piece, prefs.m_hairColorId, nullptr);
+
+        for (int32_t i = 0; rec && i < 2; i++) {
+            if (*rec->m_textureName[i]) {
+                strcpy(s_pathEnd, rec->m_textureName[i]);
+                piece.m_texture[i] = TextureCacheCreateTexture(s_path);
+                changed = true;
+
+                if (!piece.m_texture[i]) {
+                    DebugLog("**** Unable to Load Texture %s\n", s_path);
+                }
+            }
+        }
+    }
+
+    if (changed) {
+        this->SetDirtySections(0x300);
+    }
+}
+
+// Not in the original (F-230): a player of a race whose slot choices carry their own painted parts draws those
+// instead of the legacy facial-hair texture once any slot is set (the parts are cut from those textures). NPCs and
+// characters without slot values keep the legacy texture.
+bool CCharacterComponent::ZepPiecesReplaceFacial() const {
+    const CharacterPreferences& prefs = this->m_data.m_preferences;
+
+    if (prefs.m_zepNpc) {
+        return false;
+    }
+
+    const ZepRaceDef* def = ZepCustomizationsGet(prefs.m_raceID, prefs.m_sexID);
+
+    if (!def || !def->pieceTextures) {
+        return false;
+    }
+
+    for (uint32_t s = 0; s < 6; s++) {
+        if (ZepSlotValue(def, prefs, s)) {
+            return true;
+        }
+    }
+
+    return false;
+}
