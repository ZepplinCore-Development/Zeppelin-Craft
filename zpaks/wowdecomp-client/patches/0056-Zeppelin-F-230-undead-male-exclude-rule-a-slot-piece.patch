         }
     }
 
@@ -337,6 +360,44 @@ void ZepUnpackPadding(uint32_t pad, CharacterPreferences& prefs) {
     prefs.m_jewelleryId = static_cast<uint8_t>(pad >> 24);
 }
 
+bool ZepGeosetExcluded(const ZepRaceDef* def, const uint32_t* geosets, uint32_t geoset) {
+    if (!def || !geoset) {
+        return false;
+    }
+
+    for (const auto& ex : def->excludes) {
+        if (geosets[ex.first / 100] != ex.first) {
+            continue;
+        }
+
+        for (uint16_t drop : ex.second) {
+            if (drop == geoset) {
+                return true;
+            }
+        }
+    }
+
+    return false;
+}
+
+bool ZepNpcLegacyGlow(const CharacterPreferences& prefs) {
+    if (!prefs.m_zepNpc) {
+        return false;
+    }
+
+    const ZepRaceDef* def = ZepCustomizationsGet(prefs.m_raceID, prefs.m_sexID);
+    return def && def->eyeRowGlow;
+}
+
+bool ZepEyeRowGlowOnly(const CharacterPreferences& prefs) {
+    if (prefs.m_zepNpc) {
+        return false;
+    }
+
+    const ZepRaceDef* def = ZepCustomizationsGet(prefs.m_raceID, prefs.m_sexID);
+    return def && def->eyeRowGlow;
+}
+
 int32_t ZepFollowBit(uint32_t group) {
     switch (group) {
         case 0: return 0;
