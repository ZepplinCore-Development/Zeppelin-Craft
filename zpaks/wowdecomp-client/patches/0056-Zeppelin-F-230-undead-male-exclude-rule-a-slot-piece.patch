-    if (ComponentGetNumVariations(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, VARIATION_EYES) > 0) {
+    // (F-230: not for an NPC of a race whose file says "eyeglow eyerow": it keeps the stock glow)
+    if (ComponentGetNumVariations(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, VARIATION_EYES) > 0 && !ZepNpcLegacyGlow(prefs)) {
