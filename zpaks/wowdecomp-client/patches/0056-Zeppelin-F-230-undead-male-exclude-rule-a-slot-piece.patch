@@ -110,7 +112,8 @@ void Parse(const std::string& text) {
 
         const std::string& kw = t[0];
 
-        if (kw != "facial" && kw != "slot" && kw != "choice" && kw != "link" && kw != "imply") {
+        if (kw != "facial" && kw != "slot" && kw != "choice" && kw != "link" && kw != "imply" && kw != "exclude"
