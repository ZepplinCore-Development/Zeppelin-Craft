 }
 
 
@@ -993,6 +1057,10 @@ static int32_t Script_SetCharCustomizationFilter(lua_State* L) {
         CharCustomizationCycleAllowed(type, 1);
     }
 
+    if (ZepRevalidateSlots()) {     // Not in the original (F-230): exclude records
+        CGlueLoading::StartLoad(CCharacterCreation::m_character, 1);
+    }
+
     return 0;
 }
 
