     } else if (this->m_data.m_preferences.m_classId == 6) {
@@ -3734,6 +3736,9 @@ void CCharacterComponent::GeosRenderPrep() {
     for (int32_t i = 0; i < 19; i++) {
         if (i == 17 && eyeGlow) {
             this->m_data.m_model->SetGeometryVisible(1703, 1703, 1);
+        } else if (i == 17 && ZepEyeRowGlowOnly(prefs)) {
+            // Not in the original (F-230): "eyeglow eyerow" - a player's eye without a glow has none, whatever the
+            // facial row's group 17 says
         } else {
             this->m_data.m_model->SetGeometryVisible(this->m_data.m_geosets[i], this->m_data.m_geosets[i], 1);
         }
@@ -4266,6 +4271,28 @@ void CCharacterComponent::ApplyZepCustomizations() {
         }
     }
 
+    // exclude: a slot piece that does not fit what else shows (a jaw spike on a missing jaw, forehead bolts under
+    // a head wrap) is hidden, whatever set it: the creator skips it, but the barber or an old character may not
+    for (const auto& ex : def->excludes) {
+        if (geosets[ex.first / 100] != ex.first) {
+            continue;
+        }
+
+        for (uint16_t drop : ex.second) {
+            uint32_t group = drop / 100;
+            bool owned = false;
+
+            for (uint32_t s = 0; s < 6 && !owned; s++) {
+                const ZepSlotDef* slot = def->slots[s];
+                owned = slot && !slot->link && slot->group == group && ZepSlotValue(def, prefs, s);
+            }
+
+            if (owned && geosets[group] == drop) {
+                geosets[group] = group * 100;
+            }
+        }
+    }
+
     this->m_flags |= 0x4;
 }
 
