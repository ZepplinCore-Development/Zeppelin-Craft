+// Whether a character's eye glow comes from the stock rules, not its eye row: a CreatureDisplayInfoExtra NPC of a
+// race / sex whose file says "eyeglow eyerow".
+bool ZepNpcLegacyGlow(const CharacterPreferences& prefs);
+
+// Whether a player's eye row alone decides its eye glow ("eyeglow eyerow"; false for an NPC of that race).
+bool ZepEyeRowGlowOnly(const CharacterPreferences& prefs);
+
 // The HelmetGeosetVisData m_hideGeoset[] index of a stock geoset group, -1 when the group has none.
 int32_t ZepFollowBit(uint32_t group);
 
