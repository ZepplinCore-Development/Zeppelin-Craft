             }
 
             def->implies.emplace_back(static_cast<uint16_t>(src), static_cast<uint16_t>(dst));
+        } else if (kw == "exclude") {
+            uint32_t keep = Num(t[3]);
+            std::vector<uint16_t> drops;
+
+            for (const std::string& d : t.size() >= 5 ? Split(t[4], ',') : std::vector<std::string>()) {
+                uint32_t drop = Num(d);
+
+                if (drop && GroupOk(drop / 100)) {
+                    drops.push_back(static_cast<uint16_t>(drop));
