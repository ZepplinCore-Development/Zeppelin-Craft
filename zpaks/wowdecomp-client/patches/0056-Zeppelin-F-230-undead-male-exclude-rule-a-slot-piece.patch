     CharSectionsRec* eyeRec = ComponentGetSectionsRecord(CCharacterComponent::s_chrVarArray, prefs.m_raceID, prefs.m_sexID, VARIATION_EYES, prefs.m_eyeId, 0, nullptr);
 
