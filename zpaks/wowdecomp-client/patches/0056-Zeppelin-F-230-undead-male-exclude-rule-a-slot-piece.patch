diff --git a/Engine/Source/Model2/M2Model.cpp b/Engine/Source/Model2/M2Model.cpp
index 1556af65..ee0c5c05 100644
--- a/Engine/Source/Model2/M2Model.cpp
+++ b/Engine/Source/Model2/M2Model.cpp
@@ -749,6 +749,26 @@ void CM2Model::SetWorldTransform(const C3Vector& position, float rotation, float
     matrix.d2 = position.z;
 }
 
+// Not in the original (F-230): whether an M2 texture's file name names an eye glow ("...EyeGlow...", any case)
+static bool ZepIsEyeGlowName(const M2Array<char>& name) {
+    static const char kNeedle[] = "eyeglow";
+    const char* s = name.m_count ? name.Data() : nullptr;
+
+    for (uint32_t i = 0; s && i + 7 <= name.m_count; i++) {
+        uint32_t k = 0;
+
+        while (k < 7 && s[i + k] && (s[i + k] | 0x20) == kNeedle[k]) {
+            k++;
+        }
+
+        if (k == 7) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
 // VERIFY: ceb10740 manual
 // OFFSET: 0x00825260
 void CM2Model::ReplaceTexture(uint32_t type, CTexture* texture) {
@@ -769,12 +789,18 @@ void CM2Model::ReplaceTexture(uint32_t type, CTexture* texture) {
     }
 
     M2Data* data = this->m_shared->m_data;
+    bool glowOnly = (type & CM2Model::ZEP_REPLACE_EYEGLOW) != 0;     // Not in the original (F-230)
+    type &= ~CM2Model::ZEP_REPLACE_EYEGLOW;
 
     for (uint32_t i = 0; i < data->m_textures.m_count; i++) {
         if (data->m_textures[i].m_type != type) {
             continue;
         }
 
+        if (glowOnly && !ZepIsEyeGlowName(data->m_textures[i].m_filename)) {     // Not in the original (F-230)
+            continue;
+        }
+
         if (this->m_textures[i]) {
             HandleClose(reinterpret_cast<HOBJECT>(this->m_textures[i]));
         }
@@ -790,6 +816,11 @@ void CM2Model::ReplaceTexture(uint32_t type, CTexture* texture) {
         }
     }
 
+    if (glowOnly) {     // Not in the original (F-230): eye glow planes only
+        this->m_fFlags &= ~0x10u;
+        return;
+    }
+
     for (uint32_t i = 0; i < data->m_ribbons.m_count; i++) {
         this->m_ribbonEmitters[i]->ReplaceTexture(type, texture);
     }
