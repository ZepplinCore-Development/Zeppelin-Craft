@@ -51,6 +57,16 @@ uint32_t ZepSlotValue(const ZepRaceDef* def, const CharacterPreferences& prefs,
 // OBJECT_FIELD_PADDING of a player: nibble s = slot s (s = 0..5), byte 3 = jewellery layer.
 void ZepUnpackPadding(uint32_t pad, CharacterPreferences& prefs);
 
