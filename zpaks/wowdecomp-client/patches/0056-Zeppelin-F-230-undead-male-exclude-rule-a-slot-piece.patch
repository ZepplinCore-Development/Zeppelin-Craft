 static int32_t CharCustomizationCurrent(CHAR_CUSTOMIZATION_TYPE type) {
@@ -671,6 +692,48 @@ static void ZepReapplyFacial() {
     character->ApplyZepCustomizations();    // also when the legacy row is missing (SetBeardStyle applies only with a row)
 }
 
+// Not in the original (F-230): after any change, a slot whose choice is no longer allowed (an exclude record hides
+// it beside the new jaw or head wrap) moves to its first allowed choice (index 0 = none). True when one moved.
+static bool ZepRevalidateSlots() {
+    if (!CCharacterCreation::m_character) {
+        return false;
+    }
+
+    CharacterPreferences& prefs = CCharacterCreation::m_character->m_data.m_preferences;
+    const ZepRaceDef* def = ZepCustomizationsGet(prefs.m_raceID, prefs.m_sexID);
+    bool moved = false;
+
+    for (int32_t pass = 0; def && pass < 6; pass++) {
+        bool changed = false;
+
+        for (int32_t s = 0; s < 6; s++) {
+            uint32_t count = def->slots[s] ? def->slots[s]->Count() : 0;
+            CHAR_CUSTOMIZATION_TYPE type = static_cast<CHAR_CUSTOMIZATION_TYPE>(CHAR_CUSTOMIZATION_ZEP_SLOT0 + s);
+
+            if (!count || !prefs.m_zepSlot[s] || CharCustomizationAllowed(type, prefs.m_zepSlot[s] - 1)) {
+                continue;
+            }
+
+            for (uint32_t i = 0; i < count; i++) {
+                if (CharCustomizationAllowed(type, static_cast<int32_t>(i))) {
+                    prefs.m_zepSlot[s] = static_cast<uint8_t>(i + 1);
+                    changed = true;
+                    break;
+                }
+            }
+        }
+
+        if (!changed) {
+            break;
+        }
+
+        ZepReapplyFacial();
+        moved = true;
+    }
+
+    return moved;
+}
+
 // Not in the original (F-230): steps a geoset slot by one choice in the direction of delta, past choices the
