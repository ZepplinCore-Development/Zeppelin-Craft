 // HelloWorld: the smallest possible extension. It registers one script of every type and logs the
 // hooks it receives, so the discovery -> registration -> dispatch chain of each context can be
 // checked end to end in Logs\Extensions.log. It is the template for a real extension; it does
-// nothing else on purpose. Per-frame hooks log their first call and a count afterwards, never
-// every frame.
+// nothing else on purpose. Per-frame and per-object hooks log their first calls and counts
+// afterwards, never every call.
 
+void AddHelloWorldAssetScripts();
+void AddHelloWorldClientDBScripts();
 void AddHelloWorldClientScripts();
-void AddHelloWorldWorldScripts();
-void AddHelloWorldRenderScripts();
-void AddHelloWorldNetScripts();
 void AddHelloWorldLuaScripts();
+void AddHelloWorldModelScripts();
+void AddHelloWorldNetScripts();
+void AddHelloWorldRenderScripts();
+void AddHelloWorldWorldScripts();
 
 // The entry point the generated loader calls: Add<DirectoryName>Extension(). Instantiate every
 // script of the extension from here; a script registers itself in its constructor and the registry
 // owns it from then on.
 void AddHelloWorldExtension() {
+    AddHelloWorldAssetScripts();
+    AddHelloWorldClientDBScripts();
     AddHelloWorldClientScripts();
-    AddHelloWorldWorldScripts();
-    AddHelloWorldRenderScripts();
-    AddHelloWorldNetScripts();
     AddHelloWorldLuaScripts();
+    AddHelloWorldModelScripts();
+    AddHelloWorldNetScripts();
+    AddHelloWorldRenderScripts();
+    AddHelloWorldWorldScripts();
 }
diff --git a/Extensions/HelloWorld/src/HelloWorldAsset.cpp b/Extensions/HelloWorld/src/HelloWorldAsset.cpp
new file mode 100644
index 0000000..1df1abe
--- /dev/null
+++ b/Extensions/HelloWorld/src/HelloWorldAsset.cpp
@@ -0,0 +1,54 @@
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/Storm/H/storm.h"
+#include "WoW/Source/Extension/ExtensionMgr.h"
+
+namespace {
+
+// The CVar that turns the demonstration redirect on. It is read on every file open, from any
+// thread that opens files, so the pointer is cached once and only m_intValue is read.
+CVar* s_redirectCursor;
+
+// Registers the CVar (ClientScript::OnStartup is where CVars belong) and, when it is set,
+// redirects the pointer cursor texture to the attack cursor: with
+//   SET helloWorldRedirectCursor "1"
+// in Config.wtf the login screen shows the attack cursor, which proves the redirect took effect
+// at the SFile level without any other change. Every open is counted and the first few logged.
+class HelloWorldAssetStartup : public ClientScript {
+    public:
+    HelloWorldAssetStartup() : ClientScript("HelloWorldAssetStartup") {}
+
+    void OnStartup() override {
+        s_redirectCursor = CVar::Register("helloWorldRedirectCursor", "HelloWorld: open Interface\\Cursor\\Attack.blp in place of Point.blp", 0, "0", nullptr, 0, false, nullptr, false);
+    }
+};
+
+class HelloWorldAssetScript : public AssetScript {
+    public:
+    HelloWorldAssetScript() : AssetScript("HelloWorldAssetScript") {}
+
+    bool OnFileOpen(const char* name, char* redirect, uint32_t redirectSize) override {
+        m_opens++;
+
+        if (m_opens <= 5) {
+            sExtensionMgr->Log("HelloWorld: OnFileOpen %s", name);
+        }
+
+        if (s_redirectCursor && s_redirectCursor->m_intValue && !SStrCmpI(name, "Interface\\Cursor\\Point.blp", STORM_MAX_STR)) {
+            SStrCopy(redirect, "Interface\\Cursor\\Attack.blp", redirectSize);
+            sExtensionMgr->Log("HelloWorld: OnFileOpen redirected %s -> %s", name, redirect);
+            return true;
+        }
+
+        return false;
+    }
+
+    private:
+    uint32_t m_opens = 0;
+};
+
+}
+
+void AddHelloWorldAssetScripts() {
+    new HelloWorldAssetStartup();
+    new HelloWorldAssetScript();
+}
diff --git a/Extensions/HelloWorld/src/HelloWorldClientDB.cpp b/Extensions/HelloWorld/src/HelloWorldClientDB.cpp
new file mode 100644
index 0000000..8c78f4a
--- /dev/null
+++ b/Extensions/HelloWorld/src/HelloWorldClientDB.cpp
@@ -0,0 +1,37 @@
+#include "WoW/Source/DB/WowClientDB.h"
+#include "WoW/Source/Extension/ExtensionMgr.h"
+
+namespace {
+
+// Logs the first few stores as they load with their record counts, then the total when the
+// stock set is complete. An extension store would be a WowClientDB<MyRec> global loaded from
+// OnClientDBInitialize (see ClientDBScript.h for the record contract).
+class HelloWorldClientDBScript : public ClientDBScript {
+    public:
+    HelloWorldClientDBScript() : ClientDBScript("HelloWorldClientDBScript") {}
+
+    void OnClientDBLoaded(WowClientDB_Base& db, const char* fileName) override {
+        m_loaded++;
+
+        if (m_loaded <= 3) {
+            sExtensionMgr->Log("HelloWorld: OnClientDBLoaded %s (%d record(s), ids %d..%d)", fileName, db.m_numRecords, db.m_minID, db.m_maxID);
+        }
+    }
+
+    void OnClientDBInitialize() override {
+        sExtensionMgr->Log("HelloWorld: OnClientDBInitialize, %u store(s) loaded so far", m_loaded);
+    }
+
+    void OnClientDBShutdown() override {
+        sExtensionMgr->Log("HelloWorld: OnClientDBShutdown, %u store(s) loaded in total", m_loaded);
+    }
+
+    private:
+    uint32_t m_loaded = 0;
+};
+
+}
+
+void AddHelloWorldClientDBScripts() {
+    new HelloWorldClientDBScript();
+}
diff --git a/Extensions/HelloWorld/src/HelloWorldModel.cpp b/Extensions/HelloWorld/src/HelloWorldModel.cpp
new file mode 100644
index 0000000..cc7a2af
--- /dev/null
+++ b/Extensions/HelloWorld/src/HelloWorldModel.cpp
@@ -0,0 +1,67 @@
+#include "Engine/Source/Model2/M2Data.h"
+#include "Engine/Source/Model2/M2Shared.h"
+#include "WoW/Source/Extension/ExtensionMgr.h"
+
+namespace {
+
+// Logs the first few model files as their .m2 and .skin arrive, with what the native objects
+// expose at that point, and keeps instance counts so the create/load/destroy balance can be read
+// in the log.
+class HelloWorldModelScript : public ModelScript {
+    public:
+    HelloWorldModelScript() : ModelScript("HelloWorldModelScript") {}
+
+    void OnModelSharedLoaded(CM2Shared& shared) override {
+        m_sharedLoaded++;
+
+        if (m_sharedLoaded <= 3) {
+            sExtensionMgr->Log("HelloWorld: OnModelSharedLoaded %s (%u bytes, %u bone(s), %u sequence(s), %u texture(s))", shared.m_fileName, shared.m_fileSize, shared.m_data->m_bones.m_count, shared.m_data->m_sequences.m_count, shared.m_data->m_textures.m_count);
+        }
+    }
+
+    void OnModelSkinLoaded(CM2Shared& shared) override {
+        m_skinsLoaded++;
+
+        if (m_skinsLoaded <= 3) {
+            sExtensionMgr->Log("HelloWorld: OnModelSkinLoaded %s (%u section(s), %u batch(es))", shared.m_fileName, shared.m_skinData->m_skinSections.m_count, shared.m_skinData->m_batches.m_count);
+        }
+    }
+
+    void OnModelSharedDestroy(CM2Shared& shared) override {
+        m_sharedDestroyed++;
+    }
+
+    void OnModelCreated(CM2Model& model) override {
+        m_created++;
+    }
+
+    void OnModelLoaded(CM2Model& model) override {
+        m_loaded++;
+
+        if (m_loaded == 1) {
+            sExtensionMgr->Log("HelloWorld: OnModelLoaded (first instance)");
+        }
+    }
+
+    void OnModelDestroy(CM2Model& model) override {
+        m_destroyed++;
+
+        if (m_destroyed % 500 == 0) {
+            sExtensionMgr->Log("HelloWorld: models %u created, %u loaded, %u destroyed; files %u loaded, %u skins, %u freed", m_created, m_loaded, m_destroyed, m_sharedLoaded, m_skinsLoaded, m_sharedDestroyed);
+        }
+    }
+
+    private:
+    uint32_t m_sharedLoaded = 0;
+    uint32_t m_skinsLoaded = 0;
+    uint32_t m_sharedDestroyed = 0;
+    uint32_t m_created = 0;
+    uint32_t m_loaded = 0;
+    uint32_t m_destroyed = 0;
+};
+
+}
+
+void AddHelloWorldModelScripts() {
+    new HelloWorldModelScript();
+}
