-// Not handled: external skeletons (SKID: the load is refused, the model is not drawn), LOD skins
-// (LDV1: profile 0, the full-detail skin, is always used) and per-emitter blend states past the
+// External skeletons (SKID): the .skel (resolved by FileDataID, else <model stem>.skel) has its SKS1,
+// SKB1 and SKA1 chunks spliced into the body; streamed sequences of such a model take their bone and
+// attachment keys from the .anim file's AFSB / AFSA chunks. A skeleton with a parent (SKPD) shares
+// the parent's streamed animations, which are laid out for the parent's bones: those are not loaded.
+//
+// Not handled: LOD skins (LDV1: profile 0, the full-detail skin, is always used) and per-emitter blend states past the
 // stock table (mapped to the nearest stock mode).
 
 #include <cmath>
@@ -80,7 +84,12 @@ constexpr uint32_t kHdrVersion = 0x04;
 constexpr uint32_t kHdrFlags = 0x10;
 constexpr uint32_t kHdrSequences = 0x1C;
 constexpr uint32_t kHdrSequenceLookup = 0x24;
+constexpr uint32_t kHdrLoops = 0x14;
 constexpr uint32_t kHdrBones = 0x2C;
+constexpr uint32_t kHdrKeyBoneLookup = 0x34;
+constexpr uint32_t kHdrAttachments = 0xF0;
+constexpr uint32_t kHdrAttachmentLookup = 0xF8;
+constexpr uint32_t kAttachmentStride = 0x28;
 constexpr uint32_t kHdrNumSkinProfiles = 0x44;
 constexpr uint32_t kHdrTextures = 0x50;
 constexpr uint32_t kHdrMaterials = 0x70;
@@ -139,6 +148,7 @@ std::mutex s_lock;
 std::unordered_map<uint32_t, std::string> s_paths;
 bool s_pathsLoaded = false;
 std::unordered_set<const CM2Shared*> s_modern;
+std::unordered_set<const CM2Shared*> s_skeletal;  // bones and attachments came from a .skel
 uint32_t s_models = 0;
 uint32_t s_refused = 0;
 
@@ -229,6 +239,8 @@ struct Body {
 };
 
 struct Outcome {
+    bool skeleton = false;
+    bool parentSkeleton = false;
     uint32_t texResolved = 0;
     uint32_t texUnresolved = 0;
     uint32_t cameras = 0;
@@ -564,6 +576,154 @@ void CollapsePropBones(Body& body) {
