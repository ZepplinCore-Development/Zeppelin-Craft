+    // Not in the original (F-162 modern-wmo): end of the group file, for SkipModernGroupChunks
+    const uint8_t* end = static_cast<const uint8_t*>(this->m_filePtr) + this->m_fileSize;
+    chunk = SkipModernGroupChunks(chunk, end); // Not in the original (F-162 modern-wmo): step over MOBS etc.
 
     if (flags & 0x200) {
         this->m_lightRefList = reinterpret_cast<uint16_t*>(&chunk->m_data);
         this->m_lightRefListCount = chunk->m_size >> 1;
         chunk = reinterpret_cast<SIffChunk*>(reinterpret_cast<uint8_t*>(&chunk->m_data) + chunk->m_size);
+        chunk = SkipModernGroupChunks(chunk, end); // Not in the original (F-162 modern-wmo): step over modern-only chunks
     }
 
     if (flags & 0x800) {
         this->m_doodadRefList = reinterpret_cast<uint16_t*>(&chunk->m_data);
         this->m_doodadRefListCount = chunk->m_size >> 1;
         chunk = reinterpret_cast<SIffChunk*>(reinterpret_cast<uint8_t*>(&chunk->m_data) + chunk->m_size);
+        chunk = SkipModernGroupChunks(chunk, end); // Not in the original (F-162 modern-wmo): step over modern-only chunks
     }
 
     if (flags & 0x1) {
@@ -306,12 +365,14 @@ void CMapObjGroup::CreateOptionalDataPointers(SIffChunk* dataChunk) {
         uint32_t faceSize = chunk->m_size;
         uint16_t* faces = reinterpret_cast<uint16_t*>(&chunk->m_data);
