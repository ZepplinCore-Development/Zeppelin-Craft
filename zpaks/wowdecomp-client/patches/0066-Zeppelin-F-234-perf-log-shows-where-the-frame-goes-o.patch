 constexpr const char* counterNames[NC]={"wmoDefs","wmoGroups","rootWaits","groupWaits","asyncReads","horizonAll","horizonCandidates","horizonFallbacks","horizonMismatch","grassChunks","grassDraws","grassFills","grassSingleModel","grassMixedModels","grassInsts","grassPackVertices","grassPackAcquires","grassPackFull","grassPackIndices","grassPackIndexFull","grassPackEvicts","grassFillSkipped","cullChunksTested","cullChunksKept","cullClipUpdates","cullDoodadsTested"};
 uint64_t Now(){return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());}
 // Zeppelin F-234: each image's wall time this window, for the percentiles.
@@ -73,6 +77,34 @@ bool Toggle(CVar*,const char*,const char*s,void*){
 }
 float Percentile(std::vector<float>&v,double q){if(v.empty())return 0;size_t i=std::min(v.size()-1,size_t(q*(v.size()-1)+0.5));std::nth_element(v.begin(),v.begin()+i,v.end());return v[i];}
 double Ms(Stage s,double f){return timing[size_t(s)].ns/1e6/f;}
+// Zeppelin F-234: where the frame goes outside the world. UI draw = the UI's render less the world inside it; other = the
+// rest of the frame (network, objects, timers, input, the scheduler). Lua events overlap the other parts.
+void WriteOutside(double f){
+ const double frame=Ms(Stage::Frame,f),world=Ms(Stage::WorldFrame,f),update=Ms(Stage::UiUpdate,f),present=Ms(Stage::Present,f);
+ const double draw=std::max(0.0,Ms(Stage::UiRender,f)-world),other=std::max(0.0,frame-world-update-draw-present);
+ std::fprintf(logFile,"outside_ms ui_update=%.2f ui_draw=%.2f present_wait=%.2f other=%.2f lua_events=%.2f (lua_events overlaps the others; present_wait includes VSync and maxFPS)\r\n",
+  update,draw,present,other,Ms(Stage::LuaEvents,f));
+}
+// Zeppelin F-234: each addon's Lua CPU, from the client's own profiler (GetAddOnCPUUsage; scriptProfile 1 and a /reload).
+// Milliseconds per frame this window, the heaviest first. The profiler itself costs some CPU while it is on.
+std::map<std::string,double> addonTotals;
+void WriteAddons(double f){
+ CVar*profile=CVar::Lookup("scriptProfile");
+ if(!profile||profile->m_intValue!=1){addonTotals.clear();std::fputs("addons_ms off (/console scriptProfile 1, then /reload)\r\n",logFile);return;}
+ lua_State*L=FrameScript_GetContext();if(!L)return;
+ lua_gcupdatetimes(L);
+ std::vector<std::pair<double,std::string>> spent;double total=0;bool first=addonTotals.empty();
+ for(uint32_t i=0,n=GetNumAddOns();i<n;++i){
+  const char*name=GetAddOnByIndex(i);const char*tag=name?GetAddOnName(name):nullptr;if(!tag)continue;
+  const double now=lua_gcgettime(L,tag);auto it=addonTotals.find(name);const double before=it==addonTotals.end()?now:it->second;
+  addonTotals[name]=now;const double d=now>before?now-before:0.0;if(d>0){spent.emplace_back(d/f,name);total+=d/f;}
+ }
+ if(first){std::fputs("addons_ms starting (totals from the next window)\r\n",logFile);return;}
+ std::sort(spent.begin(),spent.end(),[](const auto&a,const auto&b){return a.first>b.first;});
+ std::fprintf(logFile,"addons_ms total=%.3f%s",total,total==0?" (0: the profiler starts after a /reload)":"");
+ for(size_t i=0;i<spent.size()&&i<15;++i)std::fprintf(logFile," %s=%.3f",spent[i].second.c_str(),spent[i].first);
+ std::fputs("\r\n",logFile);
+}
 }
 void Initialize(){
  if(initialized)return;
@@ -87,9 +119,13 @@ void End(Stage stage,uint64_t start){
  if(!enabled||!start||size_t(stage)>=NS)return;
  const auto elapsed=Now()-start;auto&t=timing[size_t(stage)];t.ns+=elapsed;++t.calls;if(elapsed>t.maximum)t.maximum=elapsed;
 }
+namespace {int32_t luaDepth=0;uint64_t luaStart=0;}
+void LuaEventEnter(){if(luaDepth++==0)luaStart=Begin();}
+void LuaEventLeave(){if(luaDepth>0&&--luaDepth==0&&luaStart){End(Stage::LuaEvents,luaStart);luaStart=0;}}
 void Add(Counter c,uint64_t n){if(enabled&&size_t(c)<NC)counters[size_t(c)]+=n;}
 // Wall time from one scene render to the next: everything the client does for one image, present and caps included.
 void FrameStart(){
+ luaDepth=0;luaStart=0; // Zeppelin F-234: a dispatch left by longjmp does not stop the count for good
  if(!enabled){lastFrame=0;return;}
  const uint64_t now=Now();if(lastFrame){End(Stage::Frame,lastFrame);frameMs.push_back(float((now-lastFrame)/1e6));}lastFrame=now;
 }
@@ -120,6 +156,7 @@ void FrameEnd(){
    for(const auto&kv:lastSettings)if(!current.count(kv.first))std::fprintf(logFile," %s=%s->(default)",kv.first.c_str(),kv.second.c_str());
    std::fputs("\r\n",logFile);lastSettings=current;
   }
+  WriteOutside(f);WriteAddons(f); // Zeppelin F-234
   std::fprintf(logFile,"window_ms=%.3f scenes=%llu; inclusive CPU scopes, render excludes present/cap\r\n",(now-window)/1e6,static_cast<unsigned long long>(frames));
   for(size_t i=0;i<NS;++i)std::fprintf(logFile,"%s ms/scene=%.5f max_call_ms=%.5f calls=%llu\r\n",names[i],timing[i].ns/1e6/f,timing[i].maximum/1e6,static_cast<unsigned long long>(timing[i].calls));
   for(size_t i=0;i<NC;++i)std::fprintf(logFile,"%s=%llu ",counterNames[i],static_cast<unsigned long long>(counters[i]));
