+// wxl-modern-adt's FixupMh2o on our copy of the block (instance offsets are relative to its data).
+void NormaliseMh2o(uint8_t* data, uint32_t size, const char* tileName) {
+    constexpr uint32_t kInstance = 0x18;
+    constexpr uint32_t kLvfBytes[4] = { 5, 8, 1, 9 };
+
+    if (size < 256 * 12) {
+        return;
+    }
+
+    uint32_t layers = 0, degraded = 0, dropped = 0;
+
+    for (uint32_t c = 0; c < 256; c++) {
+        uint32_t offset = Rd32(data + c * 12);
+        uint32_t count = std::min<uint32_t>(Rd32(data + c * 12 + 4), 16);
+
+        if (!offset || !count || offset > size || count * kInstance > size - offset) {
+            continue;
+        }
+
+        for (uint32_t i = 0; i < count; i++) {
+            uint8_t* inst = data + offset + i * kInstance;
+            uint16_t type = Rd16(inst);
+            uint16_t lvf = Rd16(inst + 2);
+            layers++;
+
+            if (lvf >= 42) {
+                if (lvf == 42) {
+                    lvf = 2;  // the client's hardcoded ocean object
+                } else {
+                    const auto* end = kLiquidObjectRedirect + std::size(kLiquidObjectRedirect);
+                    const auto* it = std::lower_bound(kLiquidObjectRedirect, end, uint32_t(lvf), [](const LiquidObjectRedirect& e, uint32_t id) { return e.objectId < id; });
+
+                    if (it != end && it->objectId == lvf) {
+                        type = it->liquidType;
+                        lvf = it->lvf;
+                    } else {
+                        const auto* tend = kLiquidTypeLvf + std::size(kLiquidTypeLvf);
+                        const auto* t = std::lower_bound(kLiquidTypeLvf, tend, type, [](const LiquidTypeLvf& e, uint16_t id) { return e.liquidType < id; });
+                        lvf = (t != tend && t->liquidType == type) ? t->lvf : (Rd32(inst + 0x14) ? 0 : 2);
+                    }
+                }
+            }
+
+            // No vertex stream: the flat, fully deep format is the only one with a no-data path.
+            if (!Rd32(inst + 0x14)) {
+                lvf = 2;
+            }
+
+            uint32_t vertexData = Rd32(inst + 0x14);
+
+            if (vertexData) {
+                uint32_t need = (uint32_t(inst[0xE]) + 1) * (uint32_t(inst[0xF]) + 1) * (lvf < 4 ? kLvfBytes[lvf] : 0);
+
+                if (lvf >= 4 || vertexData > size || need > size - vertexData) {
+                    Wr32(inst + 0x14, 0);
+                    lvf = 2;
+                    dropped++;
+                }
+            }
+
+            uint32_t exists = Rd32(inst + 0x10);
+
+            if (exists && (exists > size || (uint32_t(inst[0xE]) * inst[0xF] + 7) / 8 > size - exists)) {
+                Wr32(inst + 0x10, 0);
+                dropped++;
+            }
+
+            if (!LiquidTypeUsable(type)) {
+                type = lvf == 1 ? 3 : 1;
+                degraded++;
+            }
+
+            Wr16(inst, type);
+            Wr16(inst + 2, lvf);
+        }
+    }
+
+    if (degraded || dropped) {
+        sExtensionMgr->Log("ZepModernAdt: %s liquid: %u of %u layer(s) fell back to a base type, %u out-of-range offset(s) dropped", tileName, degraded, layers, dropped);
+    }
+}
 
