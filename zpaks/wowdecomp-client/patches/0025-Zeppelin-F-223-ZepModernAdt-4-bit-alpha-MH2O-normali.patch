+bool LiquidTypeUsable(uint32_t id) {
+    const LiquidTypeRec* rec = id <= static_cast<uint32_t>(g_liquidTypeDB.m_maxID) ? g_liquidTypeDB.GetRecord(id) : nullptr;
+    return rec && rec->m_materialID >= 1 && rec->m_materialID <= 3;
