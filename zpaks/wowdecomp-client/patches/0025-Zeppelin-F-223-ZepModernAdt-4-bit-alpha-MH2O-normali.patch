+// The _tex0 / _obj0 reads of one tile, queued on the async file service ahead of the root.
+struct Companion {
+    CAsyncObject* object = nullptr;
+    std::vector<uint8_t> bytes;
+};
+
+struct Prefetch {
+    Companion part[2];  // _tex0, _obj0
+};
+
+std::unordered_map<CMapArea*, Prefetch> s_prefetch;
+uint32_t s_prefetchHits;
+uint32_t s_prefetchMisses;
+uint32_t s_prefetchWaits;
+
+void CompanionLoaded(void*) {}
+
+// Waits for a queued companion read to finish on the reader threads. A read not started yet is moved
+// to the head of its queue first. This never runs the poll handler (unlike AsyncFileReadWait), so it is
+// safe inside the root's own completion callback. False after 5 s.
+bool WaitCompanion(CAsyncObject* object) {
+    if (!object->m_isRead && !object->m_isCurrent) {
+        AsyncFileReadObject(object, 1);
+    }
+
+    for (uint32_t waited = 0; !object->m_isRead || object->m_isCurrent; waited++) {
+        if (waited >= 5000) {
+            return false;
+        }
+
+        OsSleep(1);
+    }
+
+    return true;
+}
+
+void CompanionName(const char* rootName, uint32_t part, char* out, size_t size) {
+    size_t stem = std::strlen(rootName) - 4;  // drop ".adt"
+    std::snprintf(out, size, "%.*s%s", static_cast<int>(stem), rootName, part == 0 ? "_tex0.adt" : "_obj0.adt");
+}
+
+void Release(Companion& c) {
+    if (c.object) {
+        AsyncFileReadDestroyObject(c.object);  // waits out a read in progress, closes the file
+        c.object = nullptr;
+    }
+}
