+                uint8_t lo = static_cast<uint8_t>(std::min(15, (full[k] + 8) / 17));
+                uint8_t hi = static_cast<uint8_t>(std::min(15, (full[k + 1] + 8) / 17));
+                alphaOut.push_back(static_cast<uint8_t>(lo | (hi << 4)));
+            }
