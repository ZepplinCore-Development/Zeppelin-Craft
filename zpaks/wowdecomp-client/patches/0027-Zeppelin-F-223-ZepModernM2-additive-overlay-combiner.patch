@@ -24,8 +24,12 @@
 // Every skin, 3.3.5 ones included, also gets the bone-budget split: a section drawing more than 75
 // bones is partitioned into sub-sections that fit the vertex shader bone palette.
 //
+// The additive-overlay combiner (source shader effects 21/33/35) draws with WXL's compiled overlay
+// shader pair on a rigid (one-bone) section; a skinned section keeps the base pair, since that vertex
+// shader reads no bone weights. ZEP_M2_OVERLAY_OFF in the environment disables it for comparisons.
+//
 // Not handled: external skeletons (SKID: the load is refused, the model is not drawn), LOD skins
-// (LDV1: profile 0, the full-detail skin, is always used), the additive-overlay combiner (WXL CombinerPatch) and per-emitter blend states past the
+// (LDV1: profile 0, the full-detail skin, is always used) and per-emitter blend states past the
 // stock table (mapped to the nearest stock mode).
 
 #include <cmath>
@@ -40,10 +44,15 @@
