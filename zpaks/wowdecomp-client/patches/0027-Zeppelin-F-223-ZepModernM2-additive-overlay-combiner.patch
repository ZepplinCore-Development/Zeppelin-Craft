+// The overlay shader pair, created on first use. A rigid batch only: the vertex shader transforms by
+// the first matrix of the section's bone palette and reads no weights.
+CGxShader* s_overlayShaders[2];
+bool s_overlayFailed;
+bool s_overlayDisabled = std::getenv("ZEP_M2_OVERLAY_OFF") != nullptr;
+
+CGxShader* MakeShader(EGxShTarget target, const uint8_t* code, uint32_t size) {
+    CGxShader* shader = new CGxShader();
+    shader->m_target = target;
+    shader->m_code.SetCount(size);
+    std::memcpy(shader->m_code.m_data, code, size);
+    g_theGxDevicePtr->IShaderCreate(shader);
+    return shader;
+}
+
+bool OverlayShaders() {
+    if (!s_overlayShaders[0] && !s_overlayFailed) {
+        s_overlayShaders[0] = MakeShader(GxSh_Vertex, kCombinersModAddAlphaVs, sizeof(kCombinersModAddAlphaVs));
+        s_overlayShaders[1] = MakeShader(GxSh_Pixel, kCombinersModAddAlphaPs, sizeof(kCombinersModAddAlphaPs));
+        s_overlayFailed = !s_overlayShaders[0]->m_valid || !s_overlayShaders[1]->m_valid;
+        sExtensionMgr->Log("ZepModernM2: additive-overlay shaders %s", s_overlayFailed ? "FAILED to compile, overlay batches keep their base pair" : "created");
+    }
+
+    return !s_overlayFailed;
+}
