-// HD: main-thread CPU times, inclusive scopes; no Vulkan queries or presentation waits.
+// HD: main-thread CPU times, inclusive scopes, plus (Zeppelin F-234) the GPU's frame time from the device's timestamp
+// queries, frame-time percentiles, wall-clock stamps, and the renderer and graphics settings in force: one session
+// header when the log opens, a line whenever a setting changes, so a Vulkan run and a D3D9 run can be compared.
 #include "HdCataRenderPerf.h"
+#include <algorithm>
 #include <array>
 #include <chrono>
 #include <cstdio>
 #include <cstring>
+#include <map>
