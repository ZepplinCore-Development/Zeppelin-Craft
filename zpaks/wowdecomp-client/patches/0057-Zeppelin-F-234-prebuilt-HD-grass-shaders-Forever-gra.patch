diff --git a/Engine/Source/Gx/GxSeam.h b/Engine/Source/Gx/GxSeam.h
index 9b0845dc..4441c20c 100644
--- a/Engine/Source/Gx/GxSeam.h
+++ b/Engine/Source/Gx/GxSeam.h
@@ -45,6 +45,19 @@ inline Fn GxSeamBracket(EGxSeam seam) {
 // Vulkan\shaders\translated\manifest.txt); null otherwise. The HD materials ask it before swapping their code in.
 extern int32_t (*g_gxShaderKnown)(const void* code, uint32_t size);
 
+// Zeppelin F-234: the GPU's time per frame for the perf log (hdCataRenderPerf), from timestamp queries: the window's
+// average and maximum in milliseconds since the last call, and the adapter's name. Set by the device that measures it
+// (Vulkan: CGxDeviceVulkan/hd/HdVulkanPerf.cpp; D3D9: CGxDeviceD3d/GpuFrameTimerD3d9.cpp, armed by g_gxGpuTimerWanted);
+// null otherwise. False when no frame was timed since the last call.
+struct GxGpuFrame {
+    float m_avgMs;
+    float m_maxMs;
+    uint32_t m_frames;
+    char m_adapter[128];
+};
+extern bool (*g_gxGpuFrame)(GxGpuFrame* out);
+extern int32_t g_gxGpuTimerWanted;   // the perf log is on: the D3D9 device times its frames
+
 // HD: the Cata water's reflection plane, shared by the engine (WoW/Source/WorldClient/HD/HdCataMirror.cpp) and the
 // Vulkan device (CGxDeviceVulkan/hd/CataMirror.cpp). The device sets m_wanted while hdCataWater is on and its mirror
 // is up; the engine then picks the plane of the nearest flat outdoor water each frame, before the liquid pass, and
