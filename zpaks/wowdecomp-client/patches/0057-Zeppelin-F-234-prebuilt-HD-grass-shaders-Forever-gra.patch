--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanPerf.cpp
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "HdVulkanPerf.h"
+#include <cstdio>
+#include <cstring>
+#include "Engine/Source/Gx/GxSeam.h"
+#include "wxl/Script.hpp"
+#include "wxl/VkRenderApi.h"
+
+namespace HD::VulkanPerf {
+namespace {
+const WXL_VkRenderApi* s_api = nullptr;
+char s_adapter[128] = "";
+
+bool Read(GxGpuFrame* out) {
+    if (!out || !s_api || !s_api->GetFrameStats) return false;
+    WXL_VkFrameStats stats{};
+    stats.structSize = sizeof stats;
+    std::memset(out, 0, sizeof *out);
+    std::snprintf(out->m_adapter, sizeof out->m_adapter, "%s", s_adapter);
+    if (!s_api->GetFrameStats(&stats) || !(stats.flags & WXL_VK_FRAME_GPU_TIMED) || stats.gpuFrameAvgMs < 0) return false;
+    out->m_avgMs = stats.gpuFrameAvgMs;
+    out->m_maxMs = stats.gpuFrameMaxMs;
+    out->m_frames = static_cast<uint32_t>(stats.frames);
+    return true;
+}
+}
+
+void Init() {
+    s_api = wxl::ScriptMgr::GetInterface<const WXL_VkRenderApi>(WXL_VK_RENDER_API_NAME, WXL_VK_RENDER_API_VERSION);
+    if (!s_api) return;
+    s_adapter[0] = '\0';
+    WXL_VkDeviceInfo info{};
+    info.structSize = sizeof info;
+    if (s_api->GetDeviceInfo && s_api->GetDeviceInfo(&info) && info.physicalDevice && info.getInstanceProcAddr) {
+        auto properties = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties>(info.getInstanceProcAddr(info.instance, "vkGetPhysicalDeviceProperties"));
+        if (properties) {
+            VkPhysicalDeviceProperties props{};
+            properties(info.physicalDevice, &props);
+            std::snprintf(s_adapter, sizeof s_adapter, "%s", props.deviceName);
+        }
+    }
+    g_gxGpuFrame = &Read;
+}
+
+void Shutdown() {
+    if (g_gxGpuFrame == &Read) g_gxGpuFrame = nullptr;
+    s_api = nullptr;
+}
+}
