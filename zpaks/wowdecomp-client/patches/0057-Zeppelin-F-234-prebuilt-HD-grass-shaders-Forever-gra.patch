diff --git a/Engine/Source/Gx/CGxDeviceD3d/GpuFrameTimerD3d9.cpp b/Engine/Source/Gx/CGxDeviceD3d/GpuFrameTimerD3d9.cpp
new file mode 100644
index 00000000..2fbe6db6
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceD3d/GpuFrameTimerD3d9.cpp
@@ -0,0 +1,134 @@
+#include "Engine/Source/Gx/CGxDeviceD3d/GpuFrameTimerD3d9.h"
+#include <cstdio>
+#include <cstring>
+#include "Engine/Source/Gx/GxSeam.h"
+
+namespace GpuFrameTimerD3d9 {
+namespace {
+constexpr int kSets = 4;
+
+struct Set {
+    IDirect3DQuery9* disjoint = nullptr;
+    IDirect3DQuery9* frequency = nullptr;
+    IDirect3DQuery9* begin = nullptr;
+    IDirect3DQuery9* end = nullptr;
+    bool open = false;      // begun, waiting for its end
+    bool pending = false;   // ended, waiting for its results
+};
+
+IDirect3DDevice9* s_device = nullptr;
+Set s_sets[kSets];
+int s_current = -1;
+bool s_failed = false;
+char s_adapter[128] = "";
+double s_sumMs = 0.0, s_maxMs = 0.0;
+uint32_t s_frames = 0;
+
+void Free(IDirect3DQuery9*& q) {
+    if (q) q->Release();
+    q = nullptr;
+}
+
+bool Create() {
+    for (Set& s : s_sets) {
+        if (FAILED(s_device->CreateQuery(D3DQUERYTYPE_TIMESTAMPDISJOINT, &s.disjoint)) ||
+            FAILED(s_device->CreateQuery(D3DQUERYTYPE_TIMESTAMPFREQ, &s.frequency)) ||
+            FAILED(s_device->CreateQuery(D3DQUERYTYPE_TIMESTAMP, &s.begin)) ||
+            FAILED(s_device->CreateQuery(D3DQUERYTYPE_TIMESTAMP, &s.end))) {
+            return false;
+        }
+    }
+    IDirect3D9* d3d = nullptr;
+    D3DDEVICE_CREATION_PARAMETERS creation;
+    if (SUCCEEDED(s_device->GetDirect3D(&d3d)) && d3d) {
+        D3DADAPTER_IDENTIFIER9 identifier;
+        if (SUCCEEDED(s_device->GetCreationParameters(&creation)) && SUCCEEDED(d3d->GetAdapterIdentifier(creation.AdapterOrdinal, 0, &identifier))) {
+            snprintf(s_adapter, sizeof(s_adapter), "%s", identifier.Description);
+        }
+        d3d->Release();
+    }
+    return true;
+}
+
+// A finished set's frame time, without waiting: false while the GPU has not got there.
+void Harvest(Set& s) {
+    if (!s.pending) return;
+    BOOL disjoint = TRUE;
+    UINT64 frequency = 0, begin = 0, end = 0;
+    if (s.end->GetData(&end, sizeof(end), 0) != S_OK) return;
+    if (s.begin->GetData(&begin, sizeof(begin), 0) != S_OK || s.frequency->GetData(&frequency, sizeof(frequency), 0) != S_OK ||
+        s.disjoint->GetData(&disjoint, sizeof(disjoint), 0) != S_OK) {
+        return;
+    }
+    s.pending = false;
+    if (disjoint || !frequency || end < begin) return;
+    const double ms = double(end - begin) * 1000.0 / double(frequency);
+    s_sumMs += ms;
+    if (ms > s_maxMs) s_maxMs = ms;
+    s_frames++;
+}
+
+bool Read(GxGpuFrame* out) {
+    if (!out) return false;
+    for (Set& s : s_sets) Harvest(s);
+    memset(out, 0, sizeof(*out));
+    snprintf(out->m_adapter, sizeof(out->m_adapter), "%s", s_adapter);
+    out->m_frames = s_frames;
+    const bool timed = s_frames != 0;
+    if (timed) {
+        out->m_avgMs = static_cast<float>(s_sumMs / s_frames);
+        out->m_maxMs = static_cast<float>(s_maxMs);
+    }
+    s_sumMs = s_maxMs = 0.0;
+    s_frames = 0;
+    return timed;
+}
+}
+
+void Release() {
+    for (Set& s : s_sets) {
+        Free(s.disjoint);
+        Free(s.frequency);
+        Free(s.begin);
+        Free(s.end);
+        s.open = s.pending = false;
+    }
+    s_device = nullptr;
+    s_current = -1;
+    if (g_gxGpuFrame == &Read) g_gxGpuFrame = nullptr;
+}
+
+void Present(IDirect3DDevice9* device) {
+    if (!g_gxGpuTimerWanted || s_failed || !device) {
+        if (s_device) Release();
+        return;
+    }
+    if (device != s_device) {
+        Release();
+        s_device = device;
+        if (!Create()) {
+            Release();
+            s_failed = true;   // no timestamp queries on this adapter: the log says so (no GPU column)
+            return;
+        }
+        g_gxGpuFrame = &Read;
+    }
+    // The frame that ends here.
+    if (s_current >= 0 && s_sets[s_current].open) {
+        Set& s = s_sets[s_current];
+        s.end->Issue(D3DISSUE_END);
+        s.frequency->Issue(D3DISSUE_END);
+        s.disjoint->Issue(D3DISSUE_END);
+        s.open = false;
+        s.pending = true;
+    }
+    for (Set& s : s_sets) Harvest(s);
+    // The next frame, on a set whose results are in (or dropped if the GPU is that far behind).
+    s_current = (s_current + 1) % kSets;
+    Set& next = s_sets[s_current];
+    next.pending = false;
+    next.disjoint->Issue(D3DISSUE_BEGIN);
+    next.begin->Issue(D3DISSUE_END);
+    next.open = true;
+}
+}
