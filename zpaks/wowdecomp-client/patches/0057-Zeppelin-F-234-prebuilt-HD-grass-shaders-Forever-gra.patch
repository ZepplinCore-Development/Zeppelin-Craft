+#ifndef ENGINE_SOURCE_GX_CGXDEVICED3D_GPUFRAMETIMERD3D9_H
+#define ENGINE_SOURCE_GX_CGXDEVICED3D_GPUFRAMETIMERD3D9_H
+
+#include <d3d9.h>
+
+// Zeppelin F-234: the D3D9 devices' GPU frame time for the perf log (g_gxGpuFrame, GxSeam.h). Timestamp queries
+// from one Present to the next, read back a few frames later without waiting. D3D9 timestamps are taken where the
+// GPU reaches them, so a frame the CPU is slow to feed counts its idle gaps: CPU-bound, it reads as the frame time.
+// Only while g_gxGpuTimerWanted; Release() before the device is reset or released.
+namespace GpuFrameTimerD3d9 {
+void Present(IDirect3DDevice9* device);
+void Release();
+}
+
+#endif
