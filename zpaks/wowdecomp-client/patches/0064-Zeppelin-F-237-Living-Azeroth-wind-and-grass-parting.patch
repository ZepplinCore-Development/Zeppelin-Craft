-// HD: world-plane offset of a grass vertex (position lp in the chunk, uv, view depth): wind + parting around the
-// player. uv.y is 1 at the foot of the blade and 0 at its tip, so the foot stays put on any slope.
-float2 GrassOffset(float3 lp, float2 uv, float depth)
+// Zeppelin F-237: world-plane offset of a grass vertex (position lp in the chunk, uv): the wind grid, bilinear, with
+// a per-blade flutter that grows in gusts, plus the parting around the nearest units. uv.y is 1 at the foot of the
+// blade and 0 at its tip, so the foot stays put on any slope.
+float2 GrassOffset(float3 lp, float2 uv)
 {
-    float blade = saturate((1.0 - uv.y - cWind5.x) * cWind5.y);
-    float w = blade * blade / (1.0 + abs(depth) * cWind5.w);
-    float2 seed = lp.xy + cWind0.xy;
-    float h = frac(seed.x * 0.737 + seed.y * 1.311);
-    float amp = (1.0 - cWind5.z * 0.5) + h * cWind5.z;
-    float j = h * cWind6.y;
-    float s1 = sin(dot(lp.xy, cWind3.zw) + j + cWind0.w) + cWind6.z;
-    float s2 = sin(dot(lp.xy, cWind4.zw) + j + cWind6.x);
-    float2 offset = (cWind3.xy * s1 + cWind4.xy * s2) * (w * amp);
-
-    float2 d = lp.xy - cWind1.xy;
-    float dist = sqrt(dot(d, d) + 0.001);
-    float high = saturate((lp.z - cWind1.z - cWind2.w) * cWind2.z);
-    // x blade: on a slope uphill of the player the foot of the blade would be "high" too, it must not move
-    float push = cWind1.w * (1.0 - saturate(dist * cWind2.x)) * high * blade;
-    return offset + d * (push / dist);
+    float3 wp = lp + cWind0.xyz;
+    float blade = saturate((1.0 - uv.y - cWind1.x) * cWind1.y);
+    float w = blade * blade;
+
+    // wind grid lookup, bilinear, clamped to the grid's edge
+    float2 g = clamp(wp.xy * cWind2.xy - cWind2.zw, 0.0, 6.999);
+    float2 f = frac(g);
+    int i = (int)(g.y - f.y) * 8 + (int)(g.x - f.x);
+    float4 wind = lerp(lerp(cWindGrid[i], cWindGrid[i + 1], f.x), lerp(cWindGrid[i + 8], cWindGrid[i + 9], f.x), f.y);
+
+    // flutter: a per-blade phase (by position), stronger in gusts
+    float phase = cWind0.w * cWind3.x + dot(wp.xy, cWind3.yz);
+    float flutter = (wind.z + 0.3) * cWind1.w;
+    float2 offset = wind.xy * (cWind1.z + flutter * sin(phase));
+
+    // parting: each unit pushes blades away within its radius, only near its own height
+    float2 push = 0.0;
+    float2 toPlayer = wp.xy - cWind4.xy;
+    [branch] if (dot(toPlayer, toPlayer) < cWind5.x) {
+        [loop] for (int k = 0; k < 16; k++) {
+            float4 a = cActors[k];
+            float2 d = wp.xy - a.xy;
+            float dist = sqrt(dot(d, d) + 0.001);
+            float fall = max(1.0 - dist / max(a.w, 0.001), 0.0);
+            float near = saturate(cWind5.y - abs(wp.z - a.z));
+            push += d * (fall * near / dist);
+        }
+    }
+    offset += push * cWind3.w;
+    return offset * w;
 }
 
