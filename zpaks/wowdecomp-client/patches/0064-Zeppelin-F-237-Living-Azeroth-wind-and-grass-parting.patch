diff --git a/WoW/Source/WorldClient/HD/HdLivingWind.cpp b/WoW/Source/WorldClient/HD/HdLivingWind.cpp
new file mode 100644
index 00000000..ec748d26
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdLivingWind.cpp
@@ -0,0 +1,307 @@
+// Zeppelin F-237 (Living Azeroth): the wind. Ported from wxl-seyris-living-azeroth (Morfium-G, GPL-3.0, used with the
+// author's permission): env/Wind.cpp (profile, steady wind, gusts) and env/Shelter.cpp (roofs, lee). The model and its
+// constants are Seyris's; the WDBC is read here instead of through wxl-seyris-tools.
+#include "WoW/Source/WorldClient/HD/HdLivingWind.h"
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <vector>
+#include "WoW/Source/WorldClient/HD/HdDataFile.h"
+#include "WoW/Source/WorldClient/HD/HdLivingWorld.h"
+
+namespace HD::Living::Wind {
+namespace {
+    constexpr float kPi = 3.14159265358979f;
+
+    // --- WindProfile.cdbc ------------------------------------------------------------------------------------------
+    // Columns: ID, ScopeType (0 global / 1 map / 2 area), ScopeID, the profile floats in Field order, Flags[, Comment].
+    enum Field { GroundMin, GroundMax, AloftMin, AloftMax, AloftHeight, WeatherInfluence, GustStrength, GustFrequency,
+                 TerrainWeight, LockedDirection, LockStrength, FieldCount };
+    enum Scope { kScopeGlobal = 0, kScopeMap = 1, kScopeArea = 2 };
+
+    struct Row {
+        int32_t scopeType = 0;
+        int32_t scopeId = 0;
+        float v[FieldCount] = {};
+    };
+    struct Resolved {
+        float value[FieldCount] = {};
+    };
+
+    std::vector<Row> s_rows;
+    bool s_tried = false, s_loaded = false;
+    char s_info[200] = "not loaded";
+
+    Resolved s_target, s_current;
+    bool s_haveCurrent = false;
+    float s_time = 0.0f, s_strengthMultiplier = 1.0f;
+    float s_steadyGround = 0.0f, s_steadyAloft = 0.0f, s_bearing = 0.0f;
+
+    float Clamp01(float x) { return x < 0.0f ? 0.0f : (x > 1.0f ? 1.0f : x); }
+    float Lerp(float a, float b, float t) { return a + (b - a) * t; }
+    float AngleDelta(float a, float b) {
+        float d = std::fmod(b - a, 360.0f);
+        if (d > 180.0f) d -= 360.0f;
+        if (d < -180.0f) d += 360.0f;
+        return d;
+    }
+
+    // --- value noise (deterministic, cheap) -------------------------------------------------------------------------
+    float Hash(int32_t x, int32_t y) {
+        uint32_t h = static_cast<uint32_t>(x) * 374761393u + static_cast<uint32_t>(y) * 668265263u;
+        h = (h ^ (h >> 13)) * 1274126177u;
+        h ^= h >> 16;
+        return static_cast<float>(h & 0xFFFFFFu) / static_cast<float>(0xFFFFFF);
+    }
+    float Smooth(float t) { return t * t * (3.0f - 2.0f * t); }
+    float Noise1(float x) {
+        const float fx = std::floor(x);
+        const int32_t i = static_cast<int32_t>(fx);
+        return Lerp(Hash(i, 0), Hash(i + 1, 0), Smooth(x - fx));
+    }
+    float Noise2(float x, float y) {
+        const float fx = std::floor(x), fy = std::floor(y);
+        const int32_t ix = static_cast<int32_t>(fx), iy = static_cast<int32_t>(fy);
+        const float tx = Smooth(x - fx), ty = Smooth(y - fy);
+        const float a = Lerp(Hash(ix, iy), Hash(ix + 1, iy), tx);
+        const float b = Lerp(Hash(ix, iy + 1), Hash(ix + 1, iy + 1), tx);
+        return Lerp(a, b, ty);
+    }
+    float Fbm2(float x, float y) {
+        return 0.55f * Noise2(x, y) + 0.3f * Noise2(x * 2.1f + 7.3f, y * 2.1f - 3.1f) + 0.15f * Noise2(x * 4.3f - 1.7f, y * 4.3f + 5.9f);
+    }
+
+    // --- profile resolution -----------------------------------------------------------------------------------------
+    void Apply(Resolved& r, const Row& row) {
+        for (int f = 0; f < FieldCount; ++f) {
+            if (row.v[f] >= 0.0f) r.value[f] = row.v[f]; // negative = inherit
+        }
+    }
+    const Row* FindRow(int scopeType, int32_t scopeId) {
+        for (const Row& row : s_rows) {
+            if (row.scopeType == scopeType && (scopeType == kScopeGlobal || row.scopeId == scopeId)) return &row;
+        }
+        return nullptr;
+    }
+    Resolved Resolve(const Snapshot& snap) {
+        Resolved r; // everything 0: no wind without a Global row
+        if (const Row* g = FindRow(kScopeGlobal, 0)) Apply(r, *g);
+        if (const Row* m = FindRow(kScopeMap, snap.mapId)) Apply(r, *m);
+        for (int i = snap.areaCount - 1; i >= 0; --i) { // least specific first: the sub-area has the last word
+            if (const Row* a = FindRow(kScopeArea, static_cast<int32_t>(snap.areaChain[i]))) Apply(r, *a);
+        }
+        return r;
+    }
+    void BlendToward(float dt) {
+        if (!s_haveCurrent) {
+            s_current = s_target;
+            s_haveCurrent = true;
+            return;
+        }
+        const float k = 1.0f - std::exp(-dt / 1.5f); // ~1.5 s to settle after crossing a border
+        for (int f = 0; f < FieldCount; ++f) {
+            if (f == LockedDirection) s_current.value[f] += AngleDelta(s_current.value[f], s_target.value[f]) * k;
+            else s_current.value[f] = Lerp(s_current.value[f], s_target.value[f], k);
+        }
+    }
+    float MapBaseBearing(int mapId) { return Hash(mapId, 91) * 360.0f; }
+
+    // --- shelter (env/Shelter.cpp) ----------------------------------------------------------------------------------
+    namespace shelter {
+        constexpr float kCell = 4.0f;            // yards, horizontal and vertical
+        constexpr float kRoofSearch = 40.0f;     // how far up a roof still counts
+        constexpr float kRecheckAfter = 10.0f;   // seconds; map objects stream in after the terrain
+        constexpr float kEvictRange = 120.0f;    // yards from the player
+        constexpr unsigned kRayBudget = 64;      // traces per frame
+        constexpr float kLeeHeight = 1.5f;       // lee ray: starts this high, runs kLeeReach upwind, rising kLeeAngle
+        constexpr float kLeeReach = 15.0f;
+        constexpr float kLeeAngleDeg = 15.0f;
+        constexpr float kLeeStrength = 0.85f;    // wind removed right behind an obstacle
+        constexpr int kSectors = 8;              // 45-degree wind sectors cached separately
+
+        struct Entry { float open; float tracedAt; float x, y; };
+        std::unordered_map<uint64_t, Entry> s_roof;
+        std::unordered_map<uint64_t, Entry> s_lee[kSectors];
+        float s_time = 0.0f;
+        unsigned s_rays = 0;
+
+        int32_t Cell(float v) { return static_cast<int32_t>(std::floor(v / kCell)); }
+        uint64_t Key(int32_t cx, int32_t cy, int32_t cz) {
+            const uint64_t ux = static_cast<uint64_t>(cx + (1 << 20)) & 0x1FFFFF;
+            const uint64_t uy = static_cast<uint64_t>(cy + (1 << 20)) & 0x1FFFFF;
+            const uint64_t uz = static_cast<uint64_t>(cz + (1 << 20)) & 0x1FFFFF;
+            return (ux << 42) | (uy << 21) | uz;
+        }
+        float LeeFactor(float hitFraction) { return 1.0f - kLeeStrength * (1.0f - Clamp01(hitFraction)); }
+
+        // Never trace from below the terrain at the cell's centre: on a steep slope the ray would start underground.
+        float Base(float x, float y, float z) {
+            float ground = z;
+            return HeightAt(x, y, z, &ground) && ground > z ? ground : z;
+        }
+
+        void BeginFrame(const float center[3], float dt) {
+            s_time += (dt > 0.0f && dt < 1.0f) ? dt : 0.0f;
+            s_rays = 0;
+            const float r2 = kEvictRange * kEvictRange;
+            auto evict = [&](std::unordered_map<uint64_t, Entry>& map) {
+                for (auto it = map.begin(); it != map.end();) {
+                    const float dx = it->second.x - center[0], dy = it->second.y - center[1];
+                    if (dx * dx + dy * dy > r2) it = map.erase(it);
+                    else ++it;
+                }
+            };
+            evict(s_roof);
+            for (auto& map : s_lee) evict(map);
+        }
+
+        float Openness(const float pos[3]) {
+            const int32_t cx = Cell(pos[0]), cy = Cell(pos[1]), cz = Cell(pos[2]);
+            const uint64_t key = Key(cx, cy, cz);
+            auto it = s_roof.find(key);
+            if (it != s_roof.end() && s_time - it->second.tracedAt <= kRecheckAfter) return it->second.open;
+            if (s_rays >= kRayBudget) return it != s_roof.end() ? it->second.open : 1.0f;
+            ++s_rays;
+            const float x = (cx + 0.5f) * kCell, y = (cy + 0.5f) * kCell;
+            const float z = Base(x, y, pos[2]);
+            const float from[3] = { x, y, z + 0.5f }; // half a yard up: not the floor it stands on
+            const float to[3] = { x, y, z + kRoofSearch };
+            const float open = Trace(from, to, nullptr) ? 0.0f : 1.0f;
+            s_roof[key] = Entry{ open, s_time, x, y };
+            return open;
+        }
+
+        float Lee(const float pos[3], float windDirX, float windDirY) {
+            // the sector the wind comes FROM, so a slowly drifting wind reuses its rays
+            float angle = std::atan2(-windDirY, -windDirX);
+            if (angle < 0.0f) angle += 2.0f * kPi;
+            const int sector = static_cast<int>(angle / (2.0f * kPi / kSectors) + 0.5f) % kSectors;
+            const int32_t cx = Cell(pos[0]), cy = Cell(pos[1]), cz = Cell(pos[2]);
+            const uint64_t key = Key(cx, cy, cz);
+            auto& map = s_lee[sector];
+            auto it = map.find(key);
+            if (it != map.end() && s_time - it->second.tracedAt <= kRecheckAfter) return LeeFactor(it->second.open);
+            if (s_rays >= kRayBudget) return it != map.end() ? LeeFactor(it->second.open) : 1.0f;
+            ++s_rays;
+            const float sectorAngle = sector * (2.0f * kPi / kSectors);
+            const float ux = std::cos(sectorAngle), uy = std::sin(sectorAngle);
+            const float rise = kLeeReach * std::tan(kLeeAngleDeg * kPi / 180.0f);
+            const float x = (cx + 0.5f) * kCell, y = (cy + 0.5f) * kCell;
+            const float base = Base(x, y, pos[2]);
+            const float from[3] = { x, y, base + kLeeHeight };
+            const float to[3] = { x + ux * kLeeReach, y + uy * kLeeReach, base + kLeeHeight + rise };
+            float fraction = 1.0f;
+            if (!Trace(from, to, &fraction)) fraction = 1.0f;
+            map[key] = Entry{ fraction, s_time, x, y };
+            return LeeFactor(fraction);
+        }
+    }
+
+    // Reads the WDBC: 4-byte fields, Comment (a string) last when present.
+    bool ReadTable(const std::string& data) {
+        if (data.size() < 20 || std::memcmp(data.data(), "WDBC", 4) != 0) return false;
+        uint32_t header[4];
+        std::memcpy(header, data.data() + 4, sizeof(header));
+        const uint32_t count = header[0], fields = header[1], recordSize = header[2];
+        if (fields < 15 || recordSize < fields * 4 || 20 + uint64_t(count) * recordSize > data.size()) return false;
+        for (uint32_t i = 0; i < count; ++i) {
+            uint32_t v[15];
+            std::memcpy(v, data.data() + 20 + size_t(i) * recordSize, sizeof(v));
+            Row row;
+            row.scopeType = static_cast<int32_t>(v[1]);
+            row.scopeId = static_cast<int32_t>(v[2]);
+            for (int f = 0; f < FieldCount; ++f) std::memcpy(&row.v[f], &v[3 + f], sizeof(float));
+            s_rows.push_back(row);
+        }
+        return true;
+    }
+}
+
+bool LoadProfiles() {
+    s_tried = true;
+    s_rows.clear();
+    s_loaded = false;
+    std::string data;
+    if (!HD::DataFile::Read("DBFilesClient\\WindProfile.cdbc", data)) {
+        std::snprintf(s_info, sizeof(s_info), "no wind: DBFilesClient\\WindProfile.cdbc not found");
+        return false;
+    }
+    if (!ReadTable(data)) {
+        s_rows.clear();
+        std::snprintf(s_info, sizeof(s_info), "no wind: WindProfile.cdbc is not a WDBC this reads");
+        return false;
+    }
+    s_loaded = true;
+    s_haveCurrent = false;
+    std::snprintf(s_info, sizeof(s_info), "%u profile rows", static_cast<unsigned>(s_rows.size()));
+    return true;
+}
+
+void Update(float dt) {
+    if (!s_tried) LoadProfiles();
+    if (dt < 0.0f || dt > 1.0f) dt = 1.0f / 60.0f; // hitches and the first frame
+    s_time += dt;
+    const Snapshot& snap = Current();
+    s_target = Resolve(snap);
+    BlendToward(dt);
+    const float* p = s_current.value;
+
+    shelter::BeginFrame(snap.playerPos, dt);
+
+    // Where in [min, max] the steady wind sits: a slow wander in the lower-middle part, pushed toward max by weather.
+    float rangePos = 0.2f + 0.5f * Noise1(s_time / 40.0f + 17.3f);
+    rangePos += (1.0f - rangePos) * Clamp01(snap.weatherIntensity * p[WeatherInfluence]);
+    s_steadyGround = Lerp(p[GroundMin], p[GroundMax], rangePos);
+    s_steadyAloft = Lerp(p[AloftMin], p[AloftMax], rangePos);
+
+    // Prevailing direction: a per-map base that wanders +-60 degrees over minutes, pulled toward the locked one.
+    float bearing = MapBaseBearing(snap.mapId) + 60.0f * (Noise1(s_time / 90.0f + 3.1f) * 2.0f - 1.0f);
+    bearing += AngleDelta(bearing, p[LockedDirection]) * Clamp01(p[LockStrength]);
+    s_bearing = std::fmod(bearing + 360.0f, 360.0f);
+}
+
+Sample At(const float pos[3], float heightAboveGround) {
+    Sample s;
+    const float* p = s_current.value;
+    const float aloftT = p[AloftHeight] > 0.0f ? Clamp01(heightAboveGround / p[AloftHeight]) : 0.0f;
+    const float steady = Lerp(s_steadyGround, s_steadyAloft, aloftT);
+
+    // Bearing (clockwise from north = +X) to a world vector: east is -Y.
+    const float rad = s_bearing * kPi / 180.0f;
+    const float dx = std::cos(rad), dy = -std::sin(rad);
+    const float px = -dy, py = dx;
+
+    // Gusts: a noise field stretched along the wind, scrolled downwind faster as the wind grows.
+    const float freq = p[GustFrequency] > 0.05f ? p[GustFrequency] : 0.05f;
+    const float speed = 4.0f + 16.0f * steady; // yards per second
+    const float u = pos[0] * dx + pos[1] * dy;
+    const float v = pos[0] * px + pos[1] * py;
+    const float along = 50.0f / freq, across = 35.0f / freq;
+    const float n = Fbm2((u - s_time * speed) / along, v / across);
+    s.gust = Clamp01((n - 0.5f) * 3.0f);
+
+    // Gusts veer the direction a little too.
+    const float veer = (Noise2((u - s_time * speed) / 80.0f + 31.0f, v / 80.0f) - 0.5f) * 20.0f * (0.5f + s.gust) * kPi / 180.0f;
+    s.dirX = dx * std::cos(veer) - dy * std::sin(veer);
+    s.dirY = dx * std::sin(veer) + dy * std::cos(veer);
+    // No rays where there is no wind, and no lee ray under a roof. The lee uses the steady direction, so its rays stay.
+    s.open = steady > 0.0f ? shelter::Openness(pos) : 1.0f;
+    s.lee = (steady > 0.0f && s.open > 0.0f) ? shelter::Lee(pos, dx, dy) : 1.0f;
+    s.strength = steady * (1.0f + p[GustStrength] * s.gust) * s.open * s.lee * s_strengthMultiplier;
+    return s;
+}
+
+const char* Info() {
+    static char text[260];
+    if (!s_loaded) return s_info;
+    std::snprintf(text, sizeof(text), "%s; steady %.2f, toward %.0f deg, weather %.2f", s_info, s_steadyGround, s_bearing,
+                  Current().weatherIntensity);
+    return text;
+}
+
+void SetStrengthMultiplier(float multiplier) {
+    s_strengthMultiplier = multiplier < 0.0f ? 0.0f : multiplier;
+}
+}
diff --git a/WoW/Source/WorldClient/HD/HdLivingWind.h b/WoW/Source/WorldClient/HD/HdLivingWind.h
new file mode 100644
index 00000000..bc43a00c
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdLivingWind.h
@@ -0,0 +1,38 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDLIVINGWIND_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDLIVINGWIND_H
+
+// Zeppelin F-237 (Living Azeroth): the wind. Ported from wxl-seyris-living-azeroth (Morfium-G, GPL-3.0, used with the
+// author's permission): env/Wind.cpp and env/Shelter.cpp.
+//   - WindProfile.cdbc (DBFilesClient\, read from the MPQs): Global / Map / Area rows, the most specific wins, a
+//     negative field inherits from the next scope up. Without a Global row there is no wind.
+//   - A steady wind that wanders inside the profile's range and is pushed up by weather, a per-map prevailing direction
+//     that wanders +-60 degrees (pulled to LockedDirection by LockStrength), gusts that travel downwind and veer it.
+//   - Shelter: a roof within 40 yd overhead calms the ground under it; lee: a wall or cliff up to 15 yd upwind takes
+//     most of the wind behind it. Both are line traces, cached per 4 yd cell, at most 64 a frame.
+// Directions are compass bearings the wind blows TOWARD: 0 = north (+X), 90 = east (-Y). Main thread only.
+
+namespace HD::Living::Wind {
+    struct Sample {
+        float dirX = 1.0f, dirY = 0.0f;   // unit vector the wind blows toward (world x, y)
+        float strength = 0.0f;            // 0 = calm; 1 = a strong wind (the grass bends its full amplitude)
+        float gust = 0.0f;                // 0..1, how much of a gust is passing
+        float open = 1.0f;                // 0 = under a roof
+        float lee = 1.0f;                 // 1 = no obstacle upwind
+    };
+
+    // (Re)loads WindProfile.cdbc; called by the first Update. Returns false (and keeps no wind) without the file.
+    bool LoadProfiles();
+
+    // Once per frame, after HD::Living::Refresh().
+    void Update(float dt);
+
+    // The wind at a world position (heightAboveGround blends the ground wind into the wind aloft).
+    Sample At(const float pos[3], float heightAboveGround = 0.0f);
+
+    // For the status line.
+    const char* Info();
+
+    void SetStrengthMultiplier(float multiplier);
+}
+
+#endif
diff --git a/WoW/Source/WorldClient/HD/HdLivingWorld.cpp b/WoW/Source/WorldClient/HD/HdLivingWorld.cpp
new file mode 100644
index 00000000..fb164a6c
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdLivingWorld.cpp
@@ -0,0 +1,153 @@
+// Zeppelin F-237 (Living Azeroth): the world around the player. Ported from wxl-seyris-living-azeroth (Morfium-G,
+// GPL-3.0, used with the author's permission): env/WorldQuery.cpp, env/Actors.cpp, env/TerrainHeight.cpp.
+#include "WoW/Source/WorldClient/HD/HdLivingWorld.h"
+#include <cmath>
+#include "Engine/Source/Tempest/C3Vector.h"
+#include "WoW/Source/DB/DBClient/DBClient.h"
+#include "WoW/Source/DB/Rec/AreaTableRec.h"
+#include "WoW/Source/Object/ObjectClient/Player_C.h"
+#include "WoW/Source/Object/ObjectClient/Unit_C.h"
+#include "WoW/Source/ObjectMgrClient/ObjectMgrClient.h"
+#include "WoW/Source/WorldClient/Map.h"
+#include "WoW/Source/WorldClient/MapWeather.h"
+#include "WoW/Source/WorldClient/World.h"
+
+namespace HD::Living {
+namespace {
+    constexpr float kActorRange = 45.0f;          // the grass shader skips parting farther than this from the player
+    constexpr float kWeatherKnee = 0.25f;         // Weather::Update: nothing reacts below it, (i - 0.25) * 4/3 above
+
+    Snapshot s_snap;
+    Actor s_actors[kMaxActors];
+    int s_actorCount = 0;
+
+    struct Gather {
+        C3Vector center;
+        Actor found[64];
+        int count = 0;
+    };
+
+    // Keeps the nearest 64 units; sorted and cut to kMaxActors after the walk.
+    int32_t EnumUnit(WOWGUID guid, void* param) {
+        Gather& g = *static_cast<Gather*>(param);
+        CGUnit_C* unit = static_cast<CGUnit_C*>(ClntObjMgrObjectPtr(guid, TYPEMASK_UNIT, __FILE__, __LINE__));
+        if (!unit || !unit->m_unit) return 1;
+        C3Vector pos = unit->GetPosition();
+        float dx = pos.x - g.center.x, dy = pos.y - g.center.y, dz = pos.z - g.center.z;
+        float d2 = dx * dx + dy * dy + dz * dz;
+        if (d2 > kActorRange * kActorRange) return 1;
+        int slot = g.count;
+        if (g.count >= 64) {
+            slot = 0;
+            for (int i = 1; i < g.count; i++) {
+                if (g.found[i].distance > g.found[slot].distance) slot = i;
+            }
+            if (g.found[slot].distance * g.found[slot].distance <= d2) return 1;
+        } else {
+            g.count++;
+        }
+        Actor& a = g.found[slot];
+        a.pos[0] = pos.x;
+        a.pos[1] = pos.y;
+        a.pos[2] = pos.z;
+        float radius = unit->m_unit->m_unitFieldBoundingradius;
+        a.radius = radius > 0.01f && radius < 20.0f ? radius : 0.5f;
+        a.mounted = unit->IsMounted() != 0;
+        a.isPlayer = unit->m_obj && (unit->m_obj->m_type & TYPEMASK_PLAYER) != 0;
+        a.distance = std::sqrt(d2);
+        return 1;
+    }
+
+    void RefreshActors() {
+        s_actorCount = 0;
+        if (!s_snap.inWorld || !ClntObjMgrGetCurrent()) return;
+        static Gather g;
+        g.count = 0;
+        g.center = C3Vector(s_snap.playerPos[0], s_snap.playerPos[1], s_snap.playerPos[2]);
+        ClntObjMgrEnumVisibleObjects(&EnumUnit, &g);
+        // nearest first (a handful of units: insertion sort)
+        for (int i = 1; i < g.count; i++) {
+            Actor a = g.found[i];
+            int j = i - 1;
+            while (j >= 0 && g.found[j].distance > a.distance) {
+                g.found[j + 1] = g.found[j];
+                j--;
+            }
+            g.found[j + 1] = a;
+        }
+        s_actorCount = g.count < kMaxActors ? g.count : kMaxActors;
+        for (int i = 0; i < s_actorCount; i++) s_actors[i] = g.found[i];
+    }
+
+    // The area and its parents, as the client's own zone lookup walks them (World.cpp area ambience).
+    int AreaChain(uint32_t area, uint32_t* out, int max) {
+        int n = 0;
+        while (area && n < max) {
+            bool seen = false;
+            for (int i = 0; i < n; i++) seen = seen || out[i] == area;
+            if (seen) break;
+            out[n++] = area;
+            AreaTableRec* rec = g_areaTableDB.GetRecord(area);
+            if (!rec) break;
+            area = rec->m_parentAreaID;
+        }
+        return n;
+    }
+}
+
+const Snapshot& Refresh() {
+    Snapshot s;
+    s.mapId = World::QueryMapId();
+    CGPlayer_C* player = ClntObjMgrGetCurrent() ? ClntObjMgrGetActivePlayerObj() : nullptr;
+    if (player) {
+        CGUnit_C* unit = static_cast<CGUnit_C*>(player);
+        s.inWorld = true;
+        C3Vector pos = unit->GetPosition();
+        s.playerPos[0] = pos.x;
+        s.playerPos[1] = pos.y;
+        s.playerPos[2] = pos.z;
+        if (unit->m_worldObject) {
+            uint32_t area = 0;
+            if (CMap::QueryAreaId(unit->m_worldObject, area) && area) s.areaCount = AreaChain(area, s.areaChain, kMaxAreaChain);
+            s.outdoors = World::QueryOutdoors(unit->m_worldObject) != 0;
+        }
+    }
+    if (const Weather* w = World::s_weather) {
+        const float raw = w->m_intensity;
+        s.weatherIntensity = raw <= kWeatherKnee ? 0.0f : (raw >= 1.0f ? 1.0f : (raw - kWeatherKnee) / (1.0f - kWeatherKnee));
+        s.weatherType = w->GetType();
+    }
+    s_snap = s;
+    RefreshActors();
+    return s_snap;
+}
+
+const Snapshot& Current() {
+    return s_snap;
+}
+
+int Actors(const Actor** out) {
+    if (out) *out = s_actors;
+    return s_actorCount;
+}
+
+bool Trace(const float from[3], const float to[3], float* fraction) {
+    C3Vector a(from[0], from[1], from[2]), b(to[0], to[1], to[2]), hit;
+    float t = 1.0f;
+    // 0x111: terrain + map objects + their doodads (Missile_C's line of flight)
+    const bool any = World::Intersect(a, b, &hit, &t, 0x111, nullptr) != 0;
+    if (fraction) *fraction = any ? t : 1.0f;
+    return any;
+}
+
+bool HeightAt(float x, float y, float z, float* height) {
+    // Down through the world from above z, as the client's own ground projection (World ProjectPositionCallback).
+    const float from[3] = { x, y, z + 60.0f };
+    const float to[3] = { x, y, z - 60.0f };
+    C3Vector a(from[0], from[1], from[2]), b(to[0], to[1], to[2]), hit;
+    float t = 1.0f;
+    if (!World::Intersect(a, b, &hit, &t, 0x100111, nullptr)) return false;
+    if (height) *height = from[2] + (to[2] - from[2]) * t;
+    return true;
+}
+}
diff --git a/WoW/Source/WorldClient/HD/HdLivingWorld.h b/WoW/Source/WorldClient/HD/HdLivingWorld.h
new file mode 100644
index 00000000..fbc29899
--- /dev/null
+++ b/WoW/Source/WorldClient/HD/HdLivingWorld.h
@@ -0,0 +1,48 @@
+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDLIVINGWORLD_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDLIVINGWORLD_H
+
+// Zeppelin F-237 (Living Azeroth): what the world looks like around the player, for the wind, the grass and later
+// the snow. Ported from wxl-seyris-living-azeroth (Morfium-G, GPL-3.0, used with the author's permission):
+// env/WorldQuery, env/Actors and env/TerrainHeight, here as direct calls into the client instead of offsets.
+// Main thread only (the object manager and the map are read).
+
+#include <cstdint>
+
+namespace HD::Living {
+    constexpr int kMaxAreaChain = 8;
+    constexpr int kMaxActors = 16;
+
+    struct Snapshot {
+        bool inWorld = false;
+        int32_t mapId = -1;
+        float playerPos[3] = {};
+        uint32_t areaChain[kMaxAreaChain] = {};   // the player's area first, then its parents (sub-area -> zone)
+        int areaCount = 0;
+        bool outdoors = true;
+        float weatherIntensity = 0.0f;            // 0..1, the engine's dead zone below its knee taken out
+        uint32_t weatherType = 0;                 // 0 none, 1 rain, 2 snow, 3 sand
+    };
+
+    struct Actor {
+        float pos[3] = {};
+        float radius = 0.5f;                      // the server's bounding radius (UNIT_FIELD_BOUNDINGRADIUS)
+        bool mounted = false;
+        bool isPlayer = false;
+        float distance = 0.0f;                    // to the player, yards
+    };
+
+    // Once per frame, before the wind and the grass read it.
+    const Snapshot& Refresh();
+    const Snapshot& Current();
+
+    // Every unit within range of center, nearest first (at most kMaxActors). Refreshed by Refresh.
+    int Actors(const Actor** out);
+
+    // A line through the world (terrain, map objects and their doodads): true on a hit, *fraction along it (0..1).
+    bool Trace(const float from[3], const float to[3], float* fraction);
+
+    // The terrain (or liquid surface) height at x, y, searching around z. False where nothing is loaded.
+    bool HeightAt(float x, float y, float z, float* height);
+}
+
+#endif
