diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanData.cpp b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanData.cpp
new file mode 100644
index 00000000..5f85f617
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanData.cpp
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "HdVulkanData.h"
+#include <cstdio>
+#include "Engine/Source/BlizzardCore/SFile2-Core.h"
+#include "common/ModulePath.hpp"
+
+namespace HD::VulkanData {
+namespace {
+// The whole loose file, plain CRT I/O.
+bool ReadLoose(const std::string& path, std::string& out) {
+    FILE* f = nullptr;
+    if (fopen_s(&f, path.c_str(), "rb") != 0 || !f) return false;
+    bool ok = false;
+    if (std::fseek(f, 0, SEEK_END) == 0) {
+        const long size = std::ftell(f);
+        if (size >= 0 && std::fseek(f, 0, SEEK_SET) == 0) {
+            out.resize(static_cast<size_t>(size));
+            ok = size == 0 || std::fread(&out[0], 1, out.size(), f) == out.size();
+        }
+    }
+    std::fclose(f);
+    if (!ok) out.clear();
+    return ok;
+}
+}
+
+bool Read(const char* relative, std::string& out) {
+    out.clear();
+    if (!relative || !*relative) return false;
+
+    // MPQ names use backslashes; the manifest writes forward ones.
+    std::string name = "Vulkan\\";
+    name += relative;
+    for (char& c : name) if (c == '/') c = '\\';
+
+    void* data = nullptr;
+    uint32_t size = 0;
+    if (SFile::LoadFile(name.c_str(), &data, &size, 0, nullptr) && data) {
+        out.assign(static_cast<const char*>(data), size);
+        SFile::Unload(data);
+        return true;
+    }
+    return ReadLoose(wxlvk::path::Resolve(name.c_str() + 7), out);
+}
+}
