--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanData.h
@@ -0,0 +1,9 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <string>
+namespace HD::VulkanData {
+// F-234: the Vulkan backend's data files (shaders\*.spv, shaders\translated\...) ship in an MPQ as
+// Vulkan\<relative>. Read() looks there first, then for the loose file in Vulkan\ next to the exe
+// (a developer's tree). relative uses either slash, e.g. "shaders\\translated\\manifest.txt".
+bool Read(const char* relative, std::string& out);
+}
