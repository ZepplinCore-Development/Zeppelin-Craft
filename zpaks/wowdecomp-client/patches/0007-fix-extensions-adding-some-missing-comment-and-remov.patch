From: iThorgrim <contact@warlog.dev>
Date: Fri, 16 Oct 2026 14:12:25 +0200
Subject: [PATCH] fix(extensions): adding some missing comment and remove
 duplicate file

---
 Engine/Source/Scrn/Layer.cpp                     | 2 ++
 Extensions/ExtensionsLoader.cpp.in               | 3 +++
 "Extensions/ExtensionsLoader.cpp.in\342\200\216" | 9 ---------
 3 files changed, 5 insertions(+), 9 deletions(-)
 delete mode 100644 "Extensions/ExtensionsLoader.cpp.in\342\200\216"

diff --git a/Engine/Source/Scrn/Layer.cpp b/Engine/Source/Scrn/Layer.cpp
index a58c4a7..a073d05 100644
--- a/Engine/Source/Scrn/Layer.cpp
+++ b/Engine/Source/Scrn/Layer.cpp
@@ -156,6 +156,7 @@ static int32_t CaptureScreen() {
 // OFFSET: 0x004A8720
 static int32_t OnPaint(const void* data, void* param) {
     if (GxHasContext() && GxIsWindowVisible()) {
+        // Not in the original: nothing of this frame is drawn yet.
         sExtensionMgr->OnFrameBegin(s_elapsedSec);
 
         HSRGN rgn;
@@ -214,6 +215,7 @@ static int32_t OnPaint(const void* data, void* param) {
         GxXformSetViewport(minX, maxX, minY, maxY, minZ, maxZ);
         GxuFontUpdate();
 
+        // Not in the original: every layer has painted, the scene is not presented yet.
         sExtensionMgr->OnFrameEnd();
 
         if (!s_noPresent) {
diff --git a/Extensions/ExtensionsLoader.cpp.in b/Extensions/ExtensionsLoader.cpp.in
index 43c69e1..3e7c012 100644
--- a/Extensions/ExtensionsLoader.cpp.in
+++ b/Extensions/ExtensionsLoader.cpp.in
@@ -1,3 +1,6 @@
+// Generated by Extensions/CMakeLists.txt from Extensions/ExtensionsLoader.cpp.in at configure time.
+// Do not edit: add or remove an Extensions/<Name>/src/ directory and reconfigure instead.
+
 #include "WoW/Source/Extension/ExtensionLoader.h"
 
 // Entry points, one per compiled-in extension
diff --git "a/Extensions/ExtensionsLoader.cpp.in\342\200\216" "b/Extensions/ExtensionsLoader.cpp.in\342\200\216"
deleted file mode 100644
index 9999154..0000000
--- "a/Extensions/ExtensionsLoader.cpp.in\342\200\216"
+++ /dev/null
@@ -1,9 +0,0 @@
-#include "WoW/Source/Extension/ExtensionLoader.h"
-
-// Entry points, one per compiled-in extension
-@EXTENSION_FORWARD_DECL@
-const EXTENSIONENTRY g_extensionEntries[] = {
-@EXTENSION_ENTRIES@    { nullptr, nullptr },
-};
-
-const uint32_t g_extensionCount = @EXTENSION_COUNT@;
\ No newline at end of file
