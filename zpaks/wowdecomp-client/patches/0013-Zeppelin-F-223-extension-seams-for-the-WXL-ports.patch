diff --git a/WoW/Source/Extension/ScriptDefines/ItemScript.h b/WoW/Source/Extension/ScriptDefines/ItemScript.h
new file mode 100644
index 0000000..28d4da9
--- /dev/null
+++ b/WoW/Source/Extension/ScriptDefines/ItemScript.h
@@ -0,0 +1,25 @@
+#ifndef WOW_SOURCE_EXTENSION_SCRIPTDEFINES_ITEMSCRIPT_H
+#define WOW_SOURCE_EXTENSION_SCRIPTDEFINES_ITEMSCRIPT_H
+
+#include <cstdint>
+#include "WoW/Source/Extension/ScriptObject.h"
+
+class ScalingStatValuesRec;
+
+// Item values the client computes itself rather than reading from the server (WoW/Source/UIUtil/
+// Tooltip.cpp): the scaling ("heirloom") stat getters behind item tooltips and the character pane's
+// item comparisons. The server computes the same values for the real stats, so a script that changes
+// one must match the server's formula or the tooltip and the applied value disagree.
+class ItemScript : public ScriptObject {
+    protected:
+    explicit ItemScript(const char* name);
+
+    public:
+    // End of GetScalingStatArmor: values is the ScalingStatValues row for the item's level, flags the
+    // item's ScalingStatValue mask, armor the stock result (the curve picked by flags & 0xF801E0, 0 for
+    // none). The stock switch ignores every other bit, so a script may give unused bits a meaning.
+    // Scripts run in registration order, each seeing the previous one's armor.
+    virtual void OnScalingStatArmor(const ScalingStatValuesRec& values, uint32_t flags, int32_t& armor) {}
+};
+
+#endif
