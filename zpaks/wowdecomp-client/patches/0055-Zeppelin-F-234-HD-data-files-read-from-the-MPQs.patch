+#ifndef WOW_SOURCE_WORLDCLIENT_HD_HDDATAFILE_H
+#define WOW_SOURCE_WORLDCLIENT_HD_HDDATAFILE_H
+
+#include <cstddef>
+#include <string>
+
+// Zeppelin F-234: the HD data files (forever_data\..., CataWater\...) ship in an MPQ under the same path.
+// Read() looks there first, then for the loose file next to the exe or two levels up (a developer's tree).
+namespace HD::DataFile {
+bool Read(const char* path, std::string& out);
+// fgets over a Read() buffer: copies the next line (with its '\n') into line; false at the end.
+bool Gets(const std::string& text, size_t& pos, char* line, size_t size);
+}
+
+#endif
