@@ -0,0 +1,53 @@
+#include "WoW/Source/WorldClient/HD/HdDataFile.h"
+#include <cstdio>
+#include <cstring>
+#include "Engine/Source/BlizzardCore/SFile2-Core.h"
+
+namespace HD::DataFile {
+namespace {
+bool ReadLoose(const char* path, std::string& out) {
+    FILE* file = fopen(path, "rb");
+    if (!file) return false;
+    bool ok = false;
+    if (fseek(file, 0, SEEK_END) == 0) {
+        const long size = ftell(file);
+        if (size >= 0 && fseek(file, 0, SEEK_SET) == 0) {
+            out.resize(static_cast<size_t>(size));
+            ok = size == 0 || fread(&out[0], 1, out.size(), file) == out.size();
+        }
+    }
+    fclose(file);
+    if (!ok) out.clear();
+    return ok;
+}
+}
+
+bool Read(const char* path, std::string& out) {
+    out.clear();
+    if (!path || !*path) return false;
+
+    void* data = nullptr;
+    uint32_t size = 0;
+    if (SFile::LoadFile(path, &data, &size, 0, nullptr) && data) {
+        out.assign(static_cast<const char*>(data), size);
+        SFile::Unload(data);
+        return true;
+    }
+    if (ReadLoose(path, out)) return true;
+    std::string up = "..\\..\\";
+    up += path;
+    return ReadLoose(up.c_str(), out);
+}
+
+bool Gets(const std::string& text, size_t& pos, char* line, size_t size) {
+    if (!line || size < 2 || pos >= text.size()) return false;
+    size_t n = 0;
+    while (n + 1 < size && pos < text.size()) {
+        const char c = text[pos++];
+        line[n++] = c;
+        if (c == '\n') break;
+    }
+    line[n] = '\0';
+    return true;
+}
+}
