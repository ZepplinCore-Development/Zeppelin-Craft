@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Zeppelin F-223A: temporal anti-aliasing (hd/HdVulkanTAA.cpp). Built into HdTAA.spv.h by
+// Zeppelin-Tools/wowdecomp-build/shader-work/taa_spv.py (glslang, --target-env vulkan1.0); edit this file, not the header.
+//
+// The world is drawn with a sub-pixel jitter (8 Halton offsets, native/render/Jitter.cpp). Each pixel keeps a history
+// (RGBA16F, two images, ping-pong) that follows the scene: the pixel's position is rebuilt from the depth and carried to
+// where it was last frame with one matrix (current pixel -> previous clip, both unjittered). The history read there
+// (Catmull-Rom) is clipped to the colour box of the current 3x3 neighbourhood (variance clipping in YCoCg), which is what
+// stops moving things -- grass in the wind, characters -- from smearing, then blended with the current pixel.
+//   pass 0  resolve: frame (jittered) + previous history -> current history
+//   pass 1  output:  current history -> frame, with a sharpen clamped to the neighbourhood (offsets the blend's softness)
+//   pass 2  motion debug: the reprojection distance as colour (hdTAADebug 1)
+#version 450
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(binding = 0, rgba8) uniform image2D Frame;          // the frame (R8G8B8A8_UNORM, swapRB-agnostic maths)
+layout(binding = 1) uniform sampler2D Depth;               // the scene depth, raw (viewport depth range)
+layout(binding = 2) uniform sampler2D HistoryPrev;         // last frame's history (linear, clamp)
+layout(binding = 3, rgba16f) uniform image2D HistoryCur;   // this frame's history
+
+layout(push_constant) uniform Push {
+    vec4 m[4];       // current NDC (x, y, z, 1) -> previous clip: prevClip[j] = dot(ndc, m[j])
+    vec4 vpCur;      // unjittered viewport now: x, y, width, height (pixels)
+    vec4 vpPrev;     // the same, last frame
+    vec4 depthRange; // x min depth, y max depth (the world's viewport range), z 1 / (max - min), w unused
+    vec4 params;     // x current weight (0.04 .. 1), y sharpen (0 .. 1), z history valid, w pass
+} c;
+
+ivec2 Size() { return imageSize(Frame); }
+vec3 Load(ivec2 p) { return imageLoad(Frame, clamp(p, ivec2(0), Size() - 1)).rgb; }
+
+vec3 ToYCoCg(vec3 c) { return vec3(dot(c, vec3(.25, .5, .25)), dot(c, vec3(.5, 0, -.5)), dot(c, vec3(-.25, .5, -.25))); }
+vec3 FromYCoCg(vec3 c) { return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }
+
+// Catmull-Rom from 5 bilinear taps (the corners' weights are small and dropped).
+vec3 CatmullRom(vec2 uv, vec2 texSize) {
+    vec2 pos = uv * texSize, t1 = floor(pos - .5) + .5, f = pos - t1;
+    vec2 w0 = f * (-.5 + f * (1. - .5 * f)), w1 = 1. + f * f * (-2.5 + 1.5 * f);
+    vec2 w2 = f * (.5 + f * (2. - 1.5 * f)), w3 = f * f * (-.5 + .5 * f);
+    vec2 w12 = w1 + w2, t12 = (t1 + w2 / w12) / texSize, t0 = (t1 - 1.) / texSize, t3 = (t1 + 2.) / texSize;
+    vec3 r = textureLod(HistoryPrev, vec2(t12.x, t0.y), 0.).rgb * (w12.x * w0.y)
+           + textureLod(HistoryPrev, vec2(t0.x, t12.y), 0.).rgb * (w0.x * w12.y)
+           + textureLod(HistoryPrev, t12, 0.).rgb * (w12.x * w12.y)
+           + textureLod(HistoryPrev, vec2(t3.x, t12.y), 0.).rgb * (w3.x * w12.y)
+           + textureLod(HistoryPrev, vec2(t12.x, t3.y), 0.).rgb * (w12.x * w3.y);
+    float w = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
+    return max(r / max(w, 1e-4), vec3(0));
+}
+
+// Clips q towards the box's centre (Playdead's clip, not a clamp: it keeps the hue of the history).
+vec3 ClipBox(vec3 lo, vec3 hi, vec3 q) {
+    vec3 centre = .5 * (hi + lo), extent = .5 * (hi - lo) + 1e-4, v = q - centre;
+    vec3 a = abs(v / extent);
+    float m = max(a.x, max(a.y, a.z));
+    return m > 1. ? centre + v / m : q;
+}
+
+// The pixel's previous position (pixel index units) from its depth d; false when off the previous screen.
+bool Reproject(ivec2 p, float d, out vec2 prev) {
+    vec2 ndcXY = vec2((float(p.x) + .5 - c.vpCur.x - .5 * c.vpCur.z) / (.5 * c.vpCur.z),
+                      -(float(p.y) + .5 - c.vpCur.y - .5 * c.vpCur.w) / (.5 * c.vpCur.w));
+    float z = clamp((d - c.depthRange.x) * c.depthRange.z, 0., 1.);
+    vec4 ndc = vec4(ndcXY, z, 1.);
+    vec4 clip = vec4(dot(ndc, c.m[0]), dot(ndc, c.m[1]), dot(ndc, c.m[2]), dot(ndc, c.m[3]));
+    if (clip.w <= 1e-6) return false;
+    vec2 n = clip.xy / clip.w;
+    prev = vec2(n.x * .5 * c.vpPrev.z + c.vpPrev.x + .5 * c.vpPrev.z - .5, -n.y * .5 * c.vpPrev.w + c.vpPrev.y + .5 * c.vpPrev.w - .5);
+    return all(greaterThanEqual(prev, vec2(-.5))) && all(lessThan(prev, vec2(Size()) - .5));
+}
+
+void main() {
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(p, Size()))) return;
+    uint pass = uint(c.params.w + .5);
+
+    if (pass == 1u) {
+        // Output: the history, sharpened within its own 3x3 range, alpha of the frame kept.
+        vec3 r = imageLoad(HistoryCur, p).rgb, lo = r, hi = r, sum = vec3(0);
+        for (int y = -1; y <= 1; ++y) for (int x = -1; x <= 1; ++x) {
+            if (x == 0 && y == 0) continue;
+            vec3 q = imageLoad(HistoryCur, clamp(p + ivec2(x, y), ivec2(0), Size() - 1)).rgb;
+            if (x == 0 || y == 0) sum += q;
+            lo = min(lo, q); hi = max(hi, q);
+        }
+        vec3 o = clamp(r + c.params.y * (r - .25 * sum), lo, hi);
+        imageStore(Frame, p, vec4(o, imageLoad(Frame, p).a));
+        return;
+    }
+
+    // Neighbourhood: colour moments in YCoCg; the nearest depth (0 is near) picks the reprojection, so a thin
+    // foreground edge drags its own history with it.
+    vec3 cur = Load(p), m1 = vec3(0), m2 = vec3(0);
+    float best = 2.;
+    for (int y = -1; y <= 1; ++y) for (int x = -1; x <= 1; ++x) {
+        vec3 q = ToYCoCg(Load(p + ivec2(x, y)));
+        m1 += q; m2 += q * q;
+        float d = texelFetch(Depth, clamp(p + ivec2(x, y), ivec2(0), Size() - 1), 0).r;
+        best = min(best, d);
+    }
+    m1 /= 9.; m2 /= 9.;
+    vec3 sigma = sqrt(max(m2 - m1 * m1, vec3(0)));
+
+    vec2 prev;
+    bool valid = c.params.z > .5 && Reproject(p, best, prev);
+    if (pass == 2u) {
+        vec2 motion = valid ? prev - vec2(p) : vec2(0);
+        imageStore(HistoryCur, p, vec4(valid ? clamp(abs(motion) * .125, 0., 1.) : vec2(1, 0), valid ? 0. : 1., 1.));
+        return;
+    }
+    vec3 result = cur;
+    if (valid) {
+        vec3 hist = ToYCoCg(CatmullRom((prev + .5) / vec2(Size()), vec2(Size())));
+        vec3 curY = ToYCoCg(cur);
+        hist = ClipBox(m1 - sigma, m1 + sigma, hist);
+        // More of the current frame when the camera moved fast (less history to trust), never below the set weight.
+        float speed = length(prev - vec2(p));
+        float alpha = clamp(c.params.x + speed * .01, c.params.x, .5);
+        // Luma weighting (Karis): bright outliers do not flicker through the history.
+        float wc = alpha / (1. + curY.x), wh = (1. - alpha) / (1. + hist.x);
+        result = max(FromYCoCg((curY * wc + hist * wh) / (wc + wh)), vec3(0));
+    }
+    imageStore(HistoryCur, p, vec4(result, 1.));
+}
