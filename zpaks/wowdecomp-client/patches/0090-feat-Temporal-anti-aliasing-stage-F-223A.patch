diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanTAA.cpp b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanTAA.cpp
new file mode 100644
index 00000000..50de0a2d
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanTAA.cpp
@@ -0,0 +1,354 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Zeppelin F-223A: temporal anti-aliasing under Vulkan (see HdVulkanTAA.h).
+//   pass 0 (2 with hdTAADebug)  frame + depth + previous history -> current history
+//   pass 1                      current history -> frame (sharpened)
+// History: two RGBA16F images, written alternately; the previous one is read through a linear sampler. It is kept only
+// across consecutive frames with a camera (any gap, size change or off/on starts it again from the current frame).
+// The reprojection is one matrix: current unjittered NDC (pixel + raw depth) -> world (inverse of this frame's
+// view x projection) -> previous clip (last frame's view x projection), row vectors as WXL_VkSceneConstants keeps them.
+#include "HdVulkanTAA.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <new>
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "native/Present.hpp"
+#include "wxl/Script.hpp"
+#include "wxl/VkRenderApi.h"
+
+namespace HD::VulkanTAA {
+namespace {
+#include "shaders/taa/HdTAA.spv.h"
+constexpr uint32_t MaxSlots = 8, BindingCount = 4;
+
+struct Push {
+    float m[4][4];
+    float vpCur[4], vpPrev[4], depthRange[4], params[4];
+};
+static_assert(sizeof(Push) == 128, "the push range is 128 bytes");
+
+struct State {
+    const WXL_VkRenderApi* api = nullptr;
+    WXL_VkDeviceInfo device{};
+    VkDescriptorSetLayout setLayout = VK_NULL_HANDLE;
+    VkPipelineLayout pipelineLayout = VK_NULL_HANDLE;
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    VkPipeline pipeline = VK_NULL_HANDLE;
+    VkSampler nearest = VK_NULL_HANDLE, linear = VK_NULL_HANDLE;
+    VkDescriptorSet sets[MaxSlots]{};
+    uint64_t slotSerial[MaxSlots]{};
+    void* historyHandle[2]{}; WXL_VkImageInfo history[2]{};
+    uint32_t width = 0, height = 0, failedWidth = 0, failedHeight = 0;
+    bool fresh = true;          // the history images were just made (UNDEFINED)
+    uint32_t current = 0;       // the history written this frame
+    bool havePrevious = false;  // last frame ran: its camera and history are usable
+    double prevViewProj[16]{};
+    float prevVp[4]{};
+    uint64_t last = 0;
+    bool jitterAsked = false;
+    bool lastDebug = false;     // the history holds motion, not colour, after a debug frame
+#define TAA_FUNCTIONS(X) \
+    X(CreateDescriptorSetLayout) X(DestroyDescriptorSetLayout) X(CreatePipelineLayout) X(DestroyPipelineLayout) \
+    X(CreateDescriptorPool) X(DestroyDescriptorPool) X(AllocateDescriptorSets) X(UpdateDescriptorSets) \
+    X(CreateShaderModule) X(DestroyShaderModule) X(CreateComputePipelines) X(DestroyPipeline) \
+    X(CreateSampler) X(DestroySampler) X(CmdPipelineBarrier) X(CmdBindPipeline) X(CmdBindDescriptorSets) \
+    X(CmdPushConstants) X(CmdDispatch)
+#define TAA_DECLARE(n) PFN_vk##n n = nullptr;
+    TAA_FUNCTIONS(TAA_DECLARE)
+#undef TAA_DECLARE
+};
+
+State* s = nullptr;
+void* registration = nullptr;
+CVar *enabled = nullptr, *blend = nullptr, *sharpen = nullptr, *debug = nullptr, *info = nullptr;
+char lastInfo[200] = "";
+
+CVar* Var(const char* name, const char* help, const char* value, uint32_t flags = 1) {
+    if (auto* existing = CVar::LookupRegistered(name)) return existing;
+    return CVar::Register(name, help, flags, value, nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+}
+void Info(const char* value) {
+    if (info && std::strcmp(lastInfo, value)) {std::snprintf(lastInfo, sizeof lastInfo, "%s", value); info->Set(lastInfo, true, false, false, false);}
+}
+
+// 4x4 inverse (row-major), false when singular.
+bool Invert(const double a[16], double out[16]) {
+    double inv[16];
+    inv[0] = a[5]*a[10]*a[15] - a[5]*a[11]*a[14] - a[9]*a[6]*a[15] + a[9]*a[7]*a[14] + a[13]*a[6]*a[11] - a[13]*a[7]*a[10];
+    inv[4] = -a[4]*a[10]*a[15] + a[4]*a[11]*a[14] + a[8]*a[6]*a[15] - a[8]*a[7]*a[14] - a[12]*a[6]*a[11] + a[12]*a[7]*a[10];
+    inv[8] = a[4]*a[9]*a[15] - a[4]*a[11]*a[13] - a[8]*a[5]*a[15] + a[8]*a[7]*a[13] + a[12]*a[5]*a[11] - a[12]*a[7]*a[9];
+    inv[12] = -a[4]*a[9]*a[14] + a[4]*a[10]*a[13] + a[8]*a[5]*a[14] - a[8]*a[6]*a[13] - a[12]*a[5]*a[10] + a[12]*a[6]*a[9];
+    inv[1] = -a[1]*a[10]*a[15] + a[1]*a[11]*a[14] + a[9]*a[2]*a[15] - a[9]*a[3]*a[14] - a[13]*a[2]*a[11] + a[13]*a[3]*a[10];
+    inv[5] = a[0]*a[10]*a[15] - a[0]*a[11]*a[14] - a[8]*a[2]*a[15] + a[8]*a[3]*a[14] + a[12]*a[2]*a[11] - a[12]*a[3]*a[10];
+    inv[9] = -a[0]*a[9]*a[15] + a[0]*a[11]*a[13] + a[8]*a[1]*a[15] - a[8]*a[3]*a[13] - a[12]*a[1]*a[11] + a[12]*a[3]*a[9];
+    inv[13] = a[0]*a[9]*a[14] - a[0]*a[10]*a[13] - a[8]*a[1]*a[14] + a[8]*a[2]*a[13] + a[12]*a[1]*a[10] - a[12]*a[2]*a[9];
+    inv[2] = a[1]*a[6]*a[15] - a[1]*a[7]*a[14] - a[5]*a[2]*a[15] + a[5]*a[3]*a[14] + a[13]*a[2]*a[7] - a[13]*a[3]*a[6];
+    inv[6] = -a[0]*a[6]*a[15] + a[0]*a[7]*a[14] + a[4]*a[2]*a[15] - a[4]*a[3]*a[14] - a[12]*a[2]*a[7] + a[12]*a[3]*a[6];
+    inv[10] = a[0]*a[5]*a[15] - a[0]*a[7]*a[13] - a[4]*a[1]*a[15] + a[4]*a[3]*a[13] + a[12]*a[1]*a[7] - a[12]*a[3]*a[5];
+    inv[14] = -a[0]*a[5]*a[14] + a[0]*a[6]*a[13] + a[4]*a[1]*a[14] - a[4]*a[2]*a[13] - a[12]*a[1]*a[6] + a[12]*a[2]*a[5];
+    inv[3] = -a[1]*a[6]*a[11] + a[1]*a[7]*a[10] + a[5]*a[2]*a[11] - a[5]*a[3]*a[10] - a[9]*a[2]*a[7] + a[9]*a[3]*a[6];
+    inv[7] = a[0]*a[6]*a[11] - a[0]*a[7]*a[10] - a[4]*a[2]*a[11] + a[4]*a[3]*a[10] + a[8]*a[2]*a[7] - a[8]*a[3]*a[6];
+    inv[11] = -a[0]*a[5]*a[11] + a[0]*a[7]*a[9] + a[4]*a[1]*a[11] - a[4]*a[3]*a[9] - a[8]*a[1]*a[7] + a[8]*a[3]*a[5];
+    inv[15] = a[0]*a[5]*a[10] - a[0]*a[6]*a[9] - a[4]*a[1]*a[10] + a[4]*a[2]*a[9] + a[8]*a[1]*a[6] - a[8]*a[2]*a[5];
+    const double det = a[0]*inv[0] + a[1]*inv[4] + a[2]*inv[8] + a[3]*inv[12];
+    if (!std::isfinite(det) || std::fabs(det) < 1e-30) return false;
+    for (int i = 0; i < 16; ++i) out[i] = inv[i] / det;
+    return true;
+}
+
+void ReleaseHistory(uint64_t serial) {
+    for (auto& h : s->historyHandle) {if (h) s->api->RetireImage(h, serial); h = nullptr;}
+    s->width = s->height = 0;
+    s->havePrevious = false;
+}
+
+bool Resize(uint32_t w, uint32_t h) {
+    if (s->width == w && s->height == h) return true;
+    if (s->failedWidth == w && s->failedHeight == h) return false;
+    ReleaseHistory(s->last);
+    WXL_VkImageDesc desc{VK_FORMAT_R16G16B16A16_SFLOAT, w, h, 1, VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT, VK_IMAGE_ASPECT_COLOR_BIT};
+    bool okay = true;
+    for (uint32_t i = 0; i < 2 && okay; ++i) okay = (s->historyHandle[i] = s->api->CreateImage(&desc, &s->history[i])) != nullptr;
+    if (!okay) {ReleaseHistory(0); s->failedWidth = w; s->failedHeight = h; return false;}
+    s->width = w; s->height = h; s->failedWidth = s->failedHeight = 0;
+    s->fresh = true;
+    return true;
+}
+
+void Barrier(VkCommandBuffer cmd, VkPipelineStageFlags dstStage, VkAccessFlags dstAccess) {
+    VkMemoryBarrier b{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    b.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    b.dstAccessMask = dstAccess;
+    s->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, dstStage, 0, 1, &b, 0, nullptr, 0, nullptr);
+}
+
+bool Record(const WXL_VkStageContext& ctx) {
+    if (ctx.structSize < offsetof(WXL_VkStageContext, jitter) + sizeof ctx.jitter || !ctx.cmd || !ctx.colorView || !ctx.serial ||
+        ctx.frameSlot >= s->device.frameSlots || ctx.colorFormat != VK_FORMAT_R8G8B8A8_UNORM || ctx.colorLayout != VK_IMAGE_LAYOUT_GENERAL) {
+        Info("TAA skipped: no colour image this frame"); s->havePrevious = false; return false;
+    }
+    if (!ctx.depthView || !ctx.scene || !ctx.sceneValid || ctx.viewport.width <= 0.0f || ctx.viewport.height <= 0.0f) {
+        Info("TAA skipped: no scene depth or camera this frame"); s->havePrevious = false; return false;
+    }
+    const uint32_t w = ctx.extent.width, h = ctx.extent.height;
+    if (!w || !h || w > 16384 || h > 16384 || !Resize(w, h)) {Info("TAA skipped: history allocation failed"); return false;}
+    if (s->slotSerial[ctx.frameSlot] > ctx.completedSerial) {Info("TAA skipped: slot in flight"); s->havePrevious = false; return false;}
+    const VkCommandBuffer cmd = ctx.cmd;
+
+    // The reprojection: this frame's unjittered NDC -> world -> last frame's clip.
+    Push push{};
+    double viewProj[16], inverse[16];
+    for (int i = 0; i < 16; ++i) viewProj[i] = ctx.scene->viewProj[i];
+    const bool showMotion = debug && debug->m_intValue != 0;
+    // The camera history survives the debug view (it needs it); the colour history does not survive a switch out of it.
+    const bool consecutive = s->havePrevious && ctx.serial == s->last + 1 && !s->fresh && !(s->lastDebug && !showMotion);
+    bool valid = consecutive && Invert(viewProj, inverse);
+    if (valid) {
+        double m[16];
+        for (int r = 0; r < 4; ++r) for (int c = 0; c < 4; ++c) {
+            double v = 0; for (int k = 0; k < 4; ++k) v += inverse[r * 4 + k] * s->prevViewProj[k * 4 + c];
+            m[r * 4 + c] = v;
+        }
+        for (int j = 0; j < 4; ++j) for (int i = 0; i < 4; ++i) {
+            push.m[j][i] = static_cast<float>(m[i * 4 + j]);   // column j: prevClip[j] = dot(ndc, column j)
+            if (!std::isfinite(push.m[j][i])) valid = false;
+        }
+    }
+    const float vpCur[4] = {ctx.viewport.x - ctx.jitter[0], ctx.viewport.y - ctx.jitter[1], ctx.viewport.width, ctx.viewport.height};
+    std::memcpy(push.vpCur, vpCur, sizeof vpCur);
+    std::memcpy(push.vpPrev, valid ? s->prevVp : vpCur, sizeof vpCur);
+    const float range = ctx.viewport.maxDepth - ctx.viewport.minDepth;
+    push.depthRange[0] = ctx.viewport.minDepth; push.depthRange[1] = ctx.viewport.maxDepth;
+    push.depthRange[2] = range > 1e-6f ? 1.0f / range : 1.0f;
+    push.params[0] = blend ? std::clamp(blend->m_floatValue, 0.04f, 1.0f) : 0.1f;
+    push.params[1] = sharpen ? std::clamp(sharpen->m_floatValue, 0.0f, 1.0f) : 0.3f;
+    push.params[2] = valid ? 1.0f : 0.0f;
+
+    const uint32_t cur = s->current, prev = cur ^ 1u;
+    VkDescriptorImageInfo images[BindingCount] = {
+        {VK_NULL_HANDLE, ctx.colorView, VK_IMAGE_LAYOUT_GENERAL},
+        {s->nearest, ctx.depthView, ctx.depthLayout},
+        {s->linear, s->history[prev].view, VK_IMAGE_LAYOUT_GENERAL},
+        {VK_NULL_HANDLE, s->history[cur].view, VK_IMAGE_LAYOUT_GENERAL},
+    };
+    const VkDescriptorType types[BindingCount] = {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+                                                 VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE};
+    VkWriteDescriptorSet writes[BindingCount]{};
+    for (uint32_t i = 0; i < BindingCount; ++i) {
+        auto& wr = writes[i];
+        wr.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET; wr.dstSet = s->sets[ctx.frameSlot]; wr.dstBinding = i; wr.descriptorCount = 1;
+        wr.descriptorType = types[i]; wr.pImageInfo = &images[i];
+    }
+    s->UpdateDescriptorSets(s->device.device, BindingCount, writes, 0, nullptr);
+
+    // After everything the frame did to the colour (and last frame's history writes); the new history images to GENERAL.
+    {
+        VkMemoryBarrier all{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+        all.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        all.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+        std::array<VkImageMemoryBarrier, 2> layouts{};
+        uint32_t count = 0;
+        if (s->fresh) {
+            for (uint32_t i = 0; i < 2; ++i) {
+                auto& b = layouts[count++];
+                b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER; b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED; b.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+                b.image = s->history[i].image; b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+                b.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT; b.subresourceRange.levelCount = b.subresourceRange.layerCount = 1;
+                b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+            }
+            s->fresh = false;
+        }
+        s->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &all, 0, nullptr,
+                              count, count ? layouts.data() : nullptr);
+    }
+    s->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s->pipeline);
+    s->CmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s->pipelineLayout, 0, 1, &s->sets[ctx.frameSlot], 0, nullptr);
+    const uint32_t gx = (w + 7) / 8, gy = (h + 7) / 8;
+    push.params[3] = showMotion ? 2.0f : 0.0f;
+    s->CmdPushConstants(cmd, s->pipelineLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof push, &push);
+    s->CmdDispatch(cmd, gx, gy, 1);
+    Barrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+    push.params[3] = 1.0f;
+    if (showMotion) push.params[1] = 0.0f;
+    s->CmdPushConstants(cmd, s->pipelineLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof push, &push);
+    s->CmdDispatch(cmd, gx, gy, 1);
+    Barrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT);
+
+    // This frame becomes the previous one.
+    std::memcpy(s->prevViewProj, viewProj, sizeof viewProj);
+    std::memcpy(s->prevVp, vpCur, sizeof vpCur);
+    s->havePrevious = true;
+    s->lastDebug = showMotion;
+    s->current = prev;
+    s->slotSerial[ctx.frameSlot] = s->last = ctx.serial;
+    char text[160];
+    std::snprintf(text, sizeof text, "on: %ux%u, jitter %s%s%s", w, h,
+                  (ctx.jitter[0] != 0.0f || ctx.jitter[1] != 0.0f) ? "on" : "not yet",
+                  valid ? ", history in use" : ", history starting", showMotion ? ", motion view" : "");
+    Info(text);
+    return true;
+}
+
+int __cdecl Wanted(void*) {
+    const bool on = s && enabled && enabled->m_intValue != 0;
+    // The jitter is asked for only while TAA is on (it would show as a sub-pixel shake without the resolve).
+    if (s && on != s->jitterAsked && s->api->structSize >= offsetof(WXL_VkRenderApi, RequestJitter) + sizeof(s->api->RequestJitter) && s->api->RequestJitter) {
+        s->api->RequestJitter(on ? 1 : 0);
+        s->jitterAsked = on;
+    }
+    if (!on) {Info("off"); if (s) s->havePrevious = false;}
+    return on ? 1 : 0;
+}
+void __cdecl Stage(void*, const WXL_VkStageContext* ctx) {if (ctx && s) Record(*ctx);}
+
+void Destroy() {
+    if (!s) return;
+    if (s->jitterAsked && s->api->RequestJitter) {s->api->RequestJitter(0); s->jitterAsked = false;}
+    ReleaseHistory(s->last);
+    if (s->pipeline) s->DestroyPipeline(s->device.device, s->pipeline, nullptr);
+    if (s->nearest) s->DestroySampler(s->device.device, s->nearest, nullptr);
+    if (s->linear) s->DestroySampler(s->device.device, s->linear, nullptr);
+    if (s->pool) s->DestroyDescriptorPool(s->device.device, s->pool, nullptr);
+    if (s->pipelineLayout) s->DestroyPipelineLayout(s->device.device, s->pipelineLayout, nullptr);
+    if (s->setLayout) s->DestroyDescriptorSetLayout(s->device.device, s->setLayout, nullptr);
+    delete s;
+    s = nullptr;
+}
+
+bool Create(const WXL_VkRenderApi* api) {
+    s = new (std::nothrow) State();
+    if (!s) return false;
+    s->api = api;
+    s->device.structSize = sizeof s->device;
+    if (!api->GetDeviceInfo(&s->device) || !s->device.device || !s->device.getDeviceProcAddr || !s->device.frameSlots || s->device.frameSlots > MaxSlots) {
+        delete s; s = nullptr; return false;
+    }
+#define TAA_LOAD(n) s->n = reinterpret_cast<PFN_vk##n>(s->device.getDeviceProcAddr(s->device.device, "vk" #n)); if (!s->n) { delete s; s = nullptr; return false; }
+    TAA_FUNCTIONS(TAA_LOAD)
+#undef TAA_LOAD
+    VkDescriptorSetLayoutBinding bindings[BindingCount]{};
+    const VkDescriptorType types[BindingCount] = {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+                                                 VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE};
+    for (uint32_t i = 0; i < BindingCount; ++i) {
+        bindings[i].binding = i; bindings[i].descriptorCount = 1; bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        bindings[i].descriptorType = types[i];
+    }
+    VkDescriptorSetLayoutCreateInfo sl{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    sl.bindingCount = BindingCount; sl.pBindings = bindings;
+    if (s->CreateDescriptorSetLayout(s->device.device, &sl, nullptr, &s->setLayout) != VK_SUCCESS) return false;
+    VkPushConstantRange range{VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(Push)};
+    VkPipelineLayoutCreateInfo pl{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    pl.setLayoutCount = 1; pl.pSetLayouts = &s->setLayout; pl.pushConstantRangeCount = 1; pl.pPushConstantRanges = &range;
+    if (s->CreatePipelineLayout(s->device.device, &pl, nullptr, &s->pipelineLayout) != VK_SUCCESS) return false;
+    VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    ci.codeSize = sizeof kHdTAA; ci.pCode = kHdTAA;
+    VkShaderModule module = VK_NULL_HANDLE;
+    if (s->CreateShaderModule(s->device.device, &ci, nullptr, &module) != VK_SUCCESS) return false;
+    VkComputePipelineCreateInfo cp{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+    cp.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO; cp.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+    cp.stage.module = module; cp.stage.pName = "main"; cp.layout = s->pipelineLayout;
+    const VkResult r = s->CreateComputePipelines(s->device.device, s->device.pipelineCache, 1, &cp, nullptr, &s->pipeline);
+    s->DestroyShaderModule(s->device.device, module, nullptr);
+    if (r != VK_SUCCESS) return false;
+    for (int i = 0; i < 2; ++i) {
+        VkSamplerCreateInfo sc{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+        sc.magFilter = sc.minFilter = i ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+        sc.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+        sc.addressModeU = sc.addressModeV = sc.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+        sc.maxLod = 0.0f;
+        if (s->CreateSampler(s->device.device, &sc, nullptr, i ? &s->linear : &s->nearest) != VK_SUCCESS) return false;
+    }
+    const uint32_t slots = s->device.frameSlots;
+    VkDescriptorPoolSize sizes[2] = {{VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 2 * slots}, {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 2 * slots}};
+    VkDescriptorPoolCreateInfo pool{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    pool.maxSets = slots; pool.poolSizeCount = 2; pool.pPoolSizes = sizes;
+    if (s->CreateDescriptorPool(s->device.device, &pool, nullptr, &s->pool) != VK_SUCCESS) return false;
+    std::array<VkDescriptorSetLayout, MaxSlots> layouts{};
+    layouts.fill(s->setLayout);
+    VkDescriptorSetAllocateInfo alloc{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+    alloc.descriptorPool = s->pool; alloc.descriptorSetCount = slots; alloc.pSetLayouts = layouts.data();
+    return s->AllocateDescriptorSets(s->device.device, &alloc, s->sets) == VK_SUCCESS;
+}
+}
+
+bool Init() {
+    enabled = Var("hdTAA", "HD (Vulkan): temporal anti-aliasing (jittered world, history clipped to the neighbourhood), 0 off / 1 on", "0");
+    blend = Var("hdTAABlend", "HD (Vulkan): TAA weight of the current frame, 0.04 .. 1 (lower = smoother, more history)", "0.1");
+    sharpen = Var("hdTAASharpen", "HD (Vulkan): TAA sharpening of the resolved image, 0 .. 1", "0.3");
+    debug = Var("hdTAADebug", "HD (Vulkan): 1 shows the TAA reprojection (red/green motion, blue = no history)", "0", 0);
+    info = Var("hdTAAInfo", "HD (Vulkan): TAA status (read only)", "off", 0x80);
+    if (s) return true;
+    const WXL_VkRenderApi* api = wxl::ScriptMgr::GetInterface<const WXL_VkRenderApi>(WXL_VK_RENDER_API_NAME, WXL_VK_RENDER_API_VERSION);
+    if (!api || api->structSize < offsetof(WXL_VkRenderApi, RequestJitter) + sizeof(api->RequestJitter) || !api->GetDeviceInfo ||
+        !api->CreateImage || !api->RetireImage || !api->RegisterStage || !api->UnregisterStage || !api->RequestJitter) {
+        Info("TAA: the render API is missing");
+        return false;
+    }
+    if (!Create(api)) {Destroy(); Info("TAA: initialization failed"); return false;}
+    WXL_VkStageDesc desc{};
+    desc.structSize = sizeof desc; desc.point = WXL_VK_POINT_BEFORE_UI; desc.order = 850; // after the scene effects, before CMAA2 (900)
+    desc.flags = WXL_VK_STAGE_NEEDS_DEPTH | WXL_VK_STAGE_WRITES_COLOR; desc.Wanted = Wanted; desc.Run = Stage;
+    registration = api->RegisterStage(&desc, "HD.TAA");
+    if (!registration) {Destroy(); Info("TAA: stage registration failed"); return false;}
+    Info("off");
+    return true;
+}
+
+bool Shutdown() {
+    if (!s && !registration) return true;
+    if (registration && s) {s->api->UnregisterStage(registration);}
+    registration = nullptr;
+    if (s) {
+        if (s->last > wxlvk::native::present::Completed()) {
+            if (wxlvk::native::present::FrameOpen() && !wxlvk::native::present::FlushAndWait()) return false;
+            if (!wxlvk::native::present::WaitSerial(s->last)) return false;
+        }
+        Destroy();
+    }
+    Info("off");
+    return true;
+}
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanTAA.h b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanTAA.h
new file mode 100644
index 00000000..6c34ce0b
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanTAA.h
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Zeppelin F-223A: temporal anti-aliasing as a Vulkan stage at BeforeUi (order 850: after the scene effects, before CMAA2
+// and the interface). While on it asks the device for the world's sub-pixel jitter (8 Halton offsets) and resolves each
+// frame against a history carried by the camera's motion (depth reprojection) and clipped to the current neighbourhood's
+// colours, so edges, thin foliage and lamp halos settle instead of crawling. Shader: shaders/taa/HdVulkanTAA.comp
+// (shader-work/taa_spv.py builds HdTAA.spv.h).
+//   hdTAA          0 off (default) / 1 on
+//   hdTAABlend     the current frame's weight, 0.04 .. 1 (default 0.1: about ten frames of history)
+//   hdTAASharpen   0 .. 1 (default 0.3): sharpening of the resolved image, clamped to the neighbourhood
+//   hdTAADebug     1 shows the reprojection (red/green = motion in x/y, blue = no history)
+//   hdTAAInfo      status (read only)
+#pragma once
+namespace HD::VulkanTAA {
+bool Init();      // registers the CVars and the stage (Vulkan device creation)
+bool Shutdown();  // idempotent
+}
