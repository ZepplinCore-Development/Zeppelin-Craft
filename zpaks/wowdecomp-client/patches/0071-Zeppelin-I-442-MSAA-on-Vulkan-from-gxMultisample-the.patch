+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+#version 450
+
+layout(set = 0, binding = 0) uniform sampler2D source;
+layout(location = 0) out vec4 outColor;
+
+// Run once per pixel (no sample shading): the one value lands in every covered sample, so an edge the
+// resolve already smoothed stays smooth and later draws are antialiased on top of it.
+void main()
+{
+    outColor = texelFetch(source, ivec2(gl_FragCoord.xy), 0);
+}
