+{
+    void SetMultisample(uint32_t samples)
+    {
+        if (samples < 1) samples = 1;
+        if (s.msaaRequested == samples) return;
+        s.msaaRequested = samples;
+        s.msaaLoggedReq = 0;
+        // The images are made with the back buffer: the next rebuild makes them at the new count.
+        if (s.imageCount) s.rebuild = true;
+    }
+
+    void NoteModelScene(bool open) { s.msaaModel = open; }
+
+    uint32_t PassSamples() { return s.passOpen ? s.passSamples : 1u; }
+
+    uint32_t MultisampleCount() { return s.msaaFailed ? 1u : s.msaaSamples; }
+}
