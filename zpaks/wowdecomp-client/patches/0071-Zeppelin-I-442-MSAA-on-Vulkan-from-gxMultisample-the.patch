+
+// How MSAA works on this device (I-442, F-234).
+//
+// gxMultisample reaches DeviceSetFormat as the format's sample count; it is clamped to what the device
+// offers for colour and depth attachments and for sampled depth (the depth resolve samples it), and only
+// the own-back-buffer path takes it. With a count of 1 nothing here runs and every pass is what it was.
+//
+// The multisampled colour and depth stand beside the single-sampled back buffer and depth. While the MSAA
+// window is open -- the world scene (NoteWorld) or the glue's character model (NoteModelScene) -- a pass on
+// the back colour with the back depth, or with no depth, draws into them through a class of its own (the
+// N-sample pass class, whose pipelines rasterise at N). Everything else is untouched: texture targets,
+// the back colour with a texture or the offscreen depth, the interface after the world, the present.
+//
+// The two copies are kept coherent rather than one being authoritative:
+//   - resolve on read: a 1x use of the back colour or depth (BackBuffer, SceneDepth, a 1x pass, the
+//     present) first resolves the MSAA copy into it when that is newer -- vkCmdResolveImage for the colour,
+//     a full-screen pass writing sample 0 into the 1x depth (Vulkan 1.0 has no depth resolve). Every reader
+//     keeps reading the 1x images in the layouts it always did.
+//   - seed on write: a 1x use that may write (a 1x pass, BackBuffer to TRANSFER_DST: a stage's copy-back,
+//     the host composite) marks the MSAA copy stale, and the next MSAA pass first draws the 1x image into
+//     every sample (a re-seed). So a stage that writes the frame mid-world (fog, AO, bloom, grade) keeps
+//     the world's later draws antialiased, at one full-screen pass per write.
+//   - a frame's first MSAA pass seeds only what the 1x image holds this frame: drawn (seeded), only
+//     cleared (the MSAA copy is cleared to the same colour), untouched (cleared to black, as the 1x back
+//     buffer's first use is) -- and nothing when the pass's own clear covers the whole image.
+// A G-buffer frame (hdSunShadows, hdAONormals) stays single-sampled throughout: the G-buffer attachments
+// are 1x and share the class with the colour. Phase 2 would multisample them.
+
+namespace wxlvk::native::present::detail
+{
+    namespace
+    {
+        enum Set : uint32_t
+        {
+            kSetSeedColour = 0,   ///< samples the 1x back buffer
+            kSetSeedDepth  = 1,   ///< samples the 1x back depth
+            kSetResolve    = 2,   ///< samples the MSAA depth
+        };
+
+        void LogOnce(const char* what)
+        {
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "native: frame: MSAA: %s; the frame renders single-sampled for the session", what);
+        }
+
+        bool Refuse(const char* what, VkResult r)
+        {
+            s.msaaFailed = true;
+            wxl::ScriptMgr::Log(WXL_LOG_WARN, "native: frame: MSAA: %s failed (%s); the frame renders single-sampled for the "
+                                "session", what, ResultName(r));
+            return false;
+        }
+
+        VkShaderModule Module(const uint32_t* words, size_t bytes)
+        {
+            VkShaderModuleCreateInfo info = {};
+            info.sType    = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+            info.codeSize = bytes;
+            info.pCode    = words;
+            VkShaderModule m = VK_NULL_HANDLE;
+            if (s.dapi->CreateShaderModule(s.device, &info, nullptr, &m) != VK_SUCCESS) return VK_NULL_HANDLE;
+            return m;
+        }
+
+        /// The session's objects that do not name an image: the modules, the set layout, the pipeline
+        /// layout, the pool and its three sets, the sampler. Made once.
+        bool EnsureShared()
+        {
+            if (s.msaaFailed) return false;
+            if (s.msaaSampler != VK_NULL_HANDLE) return true;
+            const loader::Device& d = *s.dapi;
+            VkResult r = VK_SUCCESS;
+            s.msaaModules[0] = Module(kMsaaFullscreenVert, sizeof kMsaaFullscreenVert);
+            s.msaaModules[1] = Module(kMsaaSeedColourFrag, sizeof kMsaaSeedColourFrag);
+            s.msaaModules[2] = Module(kMsaaSeedDepthFrag, sizeof kMsaaSeedDepthFrag);
+            s.msaaModules[3] = Module(kMsaaResolveDepthFrag, sizeof kMsaaResolveDepthFrag);
+            for (VkShaderModule m : s.msaaModules)
+                if (m == VK_NULL_HANDLE) return Refuse("vkCreateShaderModule (the helper passes)", VK_ERROR_INITIALIZATION_FAILED);
+
+            VkDescriptorSetLayoutBinding b = {};
+            b.binding         = 0;
+            b.descriptorType  = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+            b.descriptorCount = 1;
+            b.stageFlags      = VK_SHADER_STAGE_FRAGMENT_BIT;
+            VkDescriptorSetLayoutCreateInfo li = {};
+            li.sType        = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+            li.bindingCount = 1;
+            li.pBindings    = &b;
+            r = d.CreateDescriptorSetLayout(s.device, &li, nullptr, &s.msaaDsl);
+            if (r != VK_SUCCESS) return Refuse("vkCreateDescriptorSetLayout", r);
+            VkPipelineLayoutCreateInfo pl = {};
+            pl.sType          = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+            pl.setLayoutCount = 1;
+            pl.pSetLayouts    = &s.msaaDsl;
+            r = d.CreatePipelineLayout(s.device, &pl, nullptr, &s.msaaLayout);
+            if (r != VK_SUCCESS) return Refuse("vkCreatePipelineLayout", r);
+            VkDescriptorPoolSize size = { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 3 };
+            VkDescriptorPoolCreateInfo pi = {};
+            pi.sType         = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+            pi.maxSets       = 3;
+            pi.poolSizeCount = 1;
+            pi.pPoolSizes    = &size;
+            r = d.CreateDescriptorPool(s.device, &pi, nullptr, &s.msaaPool);
+            if (r != VK_SUCCESS) return Refuse("vkCreateDescriptorPool", r);
+            const VkDescriptorSetLayout layouts[3] = { s.msaaDsl, s.msaaDsl, s.msaaDsl };
+            VkDescriptorSetAllocateInfo ai = {};
+            ai.sType              = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+            ai.descriptorPool     = s.msaaPool;
+            ai.descriptorSetCount = 3;
+            ai.pSetLayouts        = layouts;
+            r = d.AllocateDescriptorSets(s.device, &ai, s.msaaSet);
+            if (r != VK_SUCCESS) return Refuse("vkAllocateDescriptorSets", r);
+            // texelFetch only: the sampler is never used to filter, but a combined image sampler needs one.
+            VkSamplerCreateInfo si = {};
+            si.sType        = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
+            si.magFilter    = VK_FILTER_NEAREST;
+            si.minFilter    = VK_FILTER_NEAREST;
+            si.mipmapMode   = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+            si.addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+            si.addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+            si.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+            r = d.CreateSampler(s.device, &si, nullptr, &s.msaaSampler);
+            if (r != VK_SUCCESS)
+            {
+                s.msaaSampler = VK_NULL_HANDLE;
+                return Refuse("vkCreateSampler", r);
+            }
+            return true;
+        }
+
+        /// One attachment, DONT_CARE in (every pixel is written), STORE out, in its attachment layout at both
+        /// ends; the dependency orders it after earlier attachment writes, transfers and shader reads of the
+        /// same image (the other frame in flight, a stage's read of the 1x depth).
+        VkRenderPass HelperPass(VkFormat format, uint32_t samples, bool depth)
+        {
+            VkAttachmentDescription a = {};
+            a.format         = format;
+            a.samples        = static_cast<VkSampleCountFlagBits>(samples);
+            a.loadOp         = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+            a.storeOp        = VK_ATTACHMENT_STORE_OP_STORE;
+            a.stencilLoadOp  = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+            a.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+            const VkImageLayout layout = depth ? VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL : VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+            a.initialLayout  = layout;
+            a.finalLayout    = layout;
+            VkAttachmentReference ref = { 0, layout };
+            VkSubpassDescription sub = {};
+            sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+            if (depth)
+                sub.pDepthStencilAttachment = &ref;
+            else
+            {
+                sub.colorAttachmentCount = 1;
+                sub.pColorAttachments    = &ref;
+            }
+            const VkPipelineStageFlags att = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT |
+                                             VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT;
+            VkSubpassDependency dep = {};
+            dep.srcSubpass    = VK_SUBPASS_EXTERNAL;
+            dep.dstSubpass    = 0;
+            dep.srcStageMask  = att | VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT |
+                                VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+            dep.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
+                                VK_ACCESS_TRANSFER_WRITE_BIT;
+            dep.dstStageMask  = att;
+            dep.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT |
+                                VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+            VkRenderPassCreateInfo info = {};
+            info.sType           = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+            info.attachmentCount = 1;
+            info.pAttachments    = &a;
+            info.subpassCount    = 1;
+            info.pSubpasses      = &sub;
+            info.dependencyCount = 1;
+            info.pDependencies   = &dep;
+            VkRenderPass pass = VK_NULL_HANDLE;
+            const VkResult r = s.dapi->CreateRenderPass(s.device, &info, nullptr, &pass);
+            if (r != VK_SUCCESS)
+            {
+                Refuse("vkCreateRenderPass (a helper pass)", r);
+                return VK_NULL_HANDLE;
+            }
+            return pass;
+        }
+
+        VkFramebuffer HelperFb(VkRenderPass pass, VkImageView view)
+        {
+            VkFramebufferCreateInfo info = {};
+            info.sType           = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
+            info.renderPass      = pass;
+            info.attachmentCount = 1;
+            info.pAttachments    = &view;
+            info.width           = s.extent.width;
+            info.height          = s.extent.height;
+            info.layers          = 1;
+            VkFramebuffer fb = VK_NULL_HANDLE;
+            const VkResult r = s.dapi->CreateFramebuffer(s.device, &info, nullptr, &fb);
+            if (r != VK_SUCCESS)
+            {
+                Refuse("vkCreateFramebuffer (a helper pass)", r);
+                return VK_NULL_HANDLE;
+            }
+            return fb;
+        }
+
+        /// A full-screen triangle at `samples`: the colour seed (fragment module 1), or a depth write with the
+        /// test ALWAYS (modules 2 and 3).
+        VkPipeline HelperPipe(VkRenderPass pass, uint32_t samples, uint32_t fragment, bool depth)
+        {
+            VkPipelineShaderStageCreateInfo st[2] = {};
+            st[0].sType  = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+            st[0].stage  = VK_SHADER_STAGE_VERTEX_BIT;
+            st[0].module = s.msaaModules[0];
+            st[0].pName  = "main";
+            st[1]        = st[0];
+            st[1].stage  = VK_SHADER_STAGE_FRAGMENT_BIT;
+            st[1].module = s.msaaModules[fragment];
+            VkPipelineVertexInputStateCreateInfo vi = {};
+            vi.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
+            VkPipelineInputAssemblyStateCreateInfo ia = {};
+            ia.sType    = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+            ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+            VkPipelineViewportStateCreateInfo vp = {};
+            vp.sType         = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+            vp.viewportCount = 1;
+            vp.scissorCount  = 1;
+            VkPipelineRasterizationStateCreateInfo rs = {};
+            rs.sType       = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+            rs.polygonMode = VK_POLYGON_MODE_FILL;
+            rs.cullMode    = VK_CULL_MODE_NONE;
+            rs.frontFace   = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+            rs.lineWidth   = 1.0f;
+            VkPipelineMultisampleStateCreateInfo ms = {};
+            ms.sType                = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+            ms.rasterizationSamples = static_cast<VkSampleCountFlagBits>(samples);
+            VkPipelineDepthStencilStateCreateInfo ds = {};
+            ds.sType            = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO;
+            ds.depthTestEnable  = depth ? VK_TRUE : VK_FALSE;
+            ds.depthWriteEnable = depth ? VK_TRUE : VK_FALSE;
+            ds.depthCompareOp   = VK_COMPARE_OP_ALWAYS;
+            VkPipelineColorBlendAttachmentState cba = {};
+            cba.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT |
+                                 VK_COLOR_COMPONENT_A_BIT;
+            VkPipelineColorBlendStateCreateInfo cb = {};
+            cb.sType           = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+            cb.attachmentCount = depth ? 0u : 1u;
+            cb.pAttachments    = depth ? nullptr : &cba;
+            const VkDynamicState dyn[2] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+            VkPipelineDynamicStateCreateInfo dy = {};
+            dy.sType             = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+            dy.dynamicStateCount = 2;
+            dy.pDynamicStates    = dyn;
+            VkGraphicsPipelineCreateInfo gp = {};
+            gp.sType               = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+            gp.stageCount          = 2;
+            gp.pStages             = st;
+            gp.pVertexInputState   = &vi;
+            gp.pInputAssemblyState = &ia;
+            gp.pViewportState      = &vp;
+            gp.pRasterizationState = &rs;
+            gp.pMultisampleState   = &ms;
+            gp.pDepthStencilState  = &ds;
+            gp.pColorBlendState    = &cb;
+            gp.pDynamicState       = &dy;
+            gp.layout              = s.msaaLayout;
+            gp.renderPass          = pass;
+            VkPipeline pipe = VK_NULL_HANDLE;
+            const VkResult r = s.dapi->CreateGraphicsPipelines(s.device, VK_NULL_HANDLE, 1, &gp, nullptr, &pipe);
+            if (r != VK_SUCCESS)
+            {
+                Refuse("vkCreateGraphicsPipelines (a helper pass)", r);
+                return VK_NULL_HANDLE;
+            }
+            return pipe;
+        }
+
+        /// The set `which` names `view` (in SHADER_READ_ONLY). The views change only across a swapchain
+        /// rebuild, after a device wait, so a set is never rewritten under a frame still in flight.
+        void PointSet(uint32_t which, VkImageView view)
+        {
+            if (s.msaaSetView[which] == view) return;
+            VkDescriptorImageInfo ii = { s.msaaSampler, view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL };
+            VkWriteDescriptorSet w = {};
+            w.sType           = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+            w.dstSet          = s.msaaSet[which];
+            w.dstBinding      = 0;
+            w.descriptorCount = 1;
+            w.descriptorType  = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+            w.pImageInfo      = &ii;
+            s.dapi->UpdateDescriptorSets(s.device, 1, &w, 0, nullptr);
+            s.msaaSetView[which] = view;
+        }
+
+        /// One full-screen draw of a helper pass into `fb`, reading set `which`.
+        void Draw(VkCommandBuffer cmd, VkRenderPass pass, VkFramebuffer fb, VkPipeline pipe, uint32_t which)
+        {
+            VkRenderPassBeginInfo begin = {};
+            begin.sType             = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+            begin.renderPass        = pass;
+            begin.framebuffer       = fb;
+            begin.renderArea.extent = s.extent;
+            s.dapi->CmdBeginRenderPass(cmd, &begin, VK_SUBPASS_CONTENTS_INLINE);
+            s.dapi->CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipe);
+            s.dapi->CmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, s.msaaLayout, 0, 1, &s.msaaSet[which], 0, nullptr);
+            VkViewport v = {};
+            v.width    = static_cast<float>(s.extent.width);
+            v.height   = static_cast<float>(s.extent.height);
+            v.maxDepth = 1.0f;
+            VkRect2D sc = {};
+            sc.extent = s.extent;
+            s.dapi->CmdSetViewport(cmd, 0, 1, &v);
+            s.dapi->CmdSetScissor(cmd, 0, 1, &sc);
+            s.dapi->CmdDraw(cmd, 3, 1, 0, 0);
+            s.dapi->CmdEndRenderPass(cmd);
+            // The draws' bind tracking knows nothing of this pipeline or set.
+            pipelines::InvalidateBindings();
+        }
+
+        /// The helper passes, framebuffers and pipelines for the images that stand now (made at first use
+        /// after each (re)make of the images, dropped with them).
+        bool EnsureHelpers()
+        {
+            if (s.msaaFailed || !EnsureShared()) return false;
+            if (s.msaaResolvePipe != VK_NULL_HANDLE) return true;
+            s.msaaSeedColourPass = HelperPass(s.colourFormat, s.msaaSamples, false);
+            s.msaaSeedDepthPass  = HelperPass(s.depthFormat, s.msaaSamples, true);
+            s.msaaResolvePass    = HelperPass(s.depthFormat, 1, true);
+            if (!s.msaaSeedColourPass || !s.msaaSeedDepthPass || !s.msaaResolvePass) return false;
+            s.msaaSeedColourFb = HelperFb(s.msaaSeedColourPass, s.msaaColourView);
+            s.msaaSeedDepthFb  = HelperFb(s.msaaSeedDepthPass, s.msaaDepthView);
+            s.msaaResolveFb    = HelperFb(s.msaaResolvePass, s.depthView);
+            if (!s.msaaSeedColourFb || !s.msaaSeedDepthFb || !s.msaaResolveFb) return false;
+            s.msaaSeedColourPipe = HelperPipe(s.msaaSeedColourPass, s.msaaSamples, 1, false);
+            s.msaaSeedDepthPipe  = HelperPipe(s.msaaSeedDepthPass, s.msaaSamples, 2, true);
+            s.msaaResolvePipe    = HelperPipe(s.msaaResolvePass, 1, 3, true);
+            return s.msaaSeedColourPipe && s.msaaSeedDepthPipe && s.msaaResolvePipe;
+        }
+
+        void DropHelpers()
+        {
+            const loader::Device& d = *s.dapi;
+            VkPipeline* pipes[3] = { &s.msaaSeedColourPipe, &s.msaaSeedDepthPipe, &s.msaaResolvePipe };
+            for (VkPipeline* p : pipes)
+            {
+                if (*p != VK_NULL_HANDLE) d.DestroyPipeline(s.device, *p, nullptr);
+                *p = VK_NULL_HANDLE;
+            }
+            VkFramebuffer* fbs[3] = { &s.msaaSeedColourFb, &s.msaaSeedDepthFb, &s.msaaResolveFb };
+            for (VkFramebuffer* f : fbs)
+            {
+                if (*f != VK_NULL_HANDLE) d.DestroyFramebuffer(s.device, *f, nullptr);
+                *f = VK_NULL_HANDLE;
+            }
+            VkRenderPass* passes[3] = { &s.msaaSeedColourPass, &s.msaaSeedDepthPass, &s.msaaResolvePass };
+            for (VkRenderPass* p : passes)
+            {
+                if (*p != VK_NULL_HANDLE) d.DestroyRenderPass(s.device, *p, nullptr);
+                *p = VK_NULL_HANDLE;
+            }
+        }
+
+        /// The 1x back buffer drawn into every sample of the MSAA one.
+        void SeedColour()
+        {
+            if (!EnsureHelpers()) return;
+            VkCommandBuffer cmd = s.slots[s.fi].main;
+            Barriers b;
+            b.Add(s.backImage, VK_IMAGE_ASPECT_COLOR_BIT, 1, 1, s.backLayout, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, false);
+            b.Add(s.msaaColour, VK_IMAGE_ASPECT_COLOR_BIT, 1, 1, s.msaaColourLayout, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, true);
+            b.Record(cmd);
+            s.backLayout       = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+            s.msaaColourLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+            PointSet(kSetSeedColour, s.backView);
+            Draw(cmd, s.msaaSeedColourPass, s.msaaSeedColourFb, s.msaaSeedColourPipe, kSetSeedColour);
+            ++s.stats.msaaSeeds;
+        }
+
+        /// The 1x back depth written into every sample of the MSAA one.
+        void SeedDepth()
+        {
+            if (!EnsureHelpers()) return;
+            VkCommandBuffer cmd = s.slots[s.fi].main;
+            const VkImageAspectFlags aspect = AspectOf(s.depthFormat);
+            Barriers b;
+            b.Add(s.depthImage, aspect, 1, 1, s.depthLayout, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, false);
+            b.Add(s.msaaDepth, aspect, 1, 1, s.msaaDepthLayout, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL, true);
+            b.Record(cmd);
+            s.depthLayout     = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+            s.msaaDepthLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+            PointSet(kSetSeedDepth, s.depthView);
+            Draw(cmd, s.msaaSeedDepthPass, s.msaaSeedDepthFb, s.msaaSeedDepthPipe, kSetSeedDepth);
+            ++s.stats.msaaDepthSeeds;
+        }
+
+        /// The full-screen rectangle check of a pending clear (the slot-39 clear that asked for this pass).
+        bool CoversAll(const present::PassClear* pending, VkExtent2D area)
+        {
+            if (!pending || !pending->place) return false;
+            if (area.width != s.extent.width || area.height != s.extent.height) return false;
+            VkRect2D rect = {};
+            return pending->place(pending->device, area, rect) && rect.offset.x == 0 && rect.offset.y == 0
+                   && rect.extent.width == area.width && rect.extent.height == area.height;
+        }
+    }
+
+    uint32_t MsaaClamp(const context::Handles& h, uint32_t requested)
+    {
+        if (requested <= 1 || !h.iapi || !h.iapi->GetPhysicalDeviceProperties) return 1;
+        VkPhysicalDeviceProperties p = {};
+        h.iapi->GetPhysicalDeviceProperties(h.physical, &p);
+        // Colour and depth attachments at the count, and the depth sampled at it (the depth resolve).
+        const VkSampleCountFlags offered = p.limits.framebufferColorSampleCounts & p.limits.framebufferDepthSampleCounts
+                                           & p.limits.sampledImageDepthSampleCounts;
+        // The largest offered power of two not above the request (gxMultisample 6 is 4).
+        for (uint32_t n = 64; n > 1; n >>= 1)
+            if (n <= requested && (offered & n)) return n;
+        return 1;
+    }
+
+    void EnsureMsaaImages(const context::Handles& h)
+    {
+        s.msaaSamples = 1;
+        if (!s.ownBack || s.msaaRequested <= 1 || s.msaaFailed) return;
+        uint32_t n = MsaaClamp(h, s.msaaRequested);
+        const char* why = nullptr;
+        // The depth resolve samples the MSAA depth through a depth-aspect view: a depth-only format that is
+        // sampled (the back depth is made SAMPLED on the same condition, s.depthSampled).
+        if (n > 1 && !s.depthSampled) why = "the back depth format cannot be sampled";
+        if (why) n = 1;
+        if (n > 1)
+        {
+            if (!MakeRaw(s.colourFormat, s.extent, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+                         s.msaaColour, s.msaaColourView, s.msaaColourBlock, "multisampled back buffer", n)
+                || !MakeRaw(s.depthFormat, s.extent, VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+                            s.msaaDepth, s.msaaDepthView, s.msaaDepthBlock, "multisampled back depth", n))
+            {
+                DropMsaaImages();
+                why = "its images could not be made";
+                n   = 1;
+            }
+        }
+        s.msaaSamples      = n;
+        s.msaaColourLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        s.msaaDepthLayout  = VK_IMAGE_LAYOUT_UNDEFINED;
+        s.msaaColourNewer = s.msaaDepthNewer = false;
+        s.msaaColourStale = s.msaaDepthStale = true;
+        s.stats.msaaSamples = n;
+        if (s.msaaLoggedReq != s.msaaRequested)
+        {
+            s.msaaLoggedReq = s.msaaRequested;
+            VkPhysicalDeviceProperties p = {};
+            if (h.iapi && h.iapi->GetPhysicalDeviceProperties) h.iapi->GetPhysicalDeviceProperties(h.physical, &p);
+            wxl::ScriptMgr::Log(n > 1 || !why ? WXL_LOG_INFO : WXL_LOG_WARN,
+                                "native: frame: MSAA: gxMultisample %u, %ux used%s%s (the device offers colour 0x%X, depth "
+                                "0x%X, sampled depth 0x%X); the world and the glue's model scene render multisampled %ux%u",
+                                s.msaaRequested, n, why ? "; " : "", why ? why : "",
+                                static_cast<unsigned>(p.limits.framebufferColorSampleCounts),
+                                static_cast<unsigned>(p.limits.framebufferDepthSampleCounts),
+                                static_cast<unsigned>(p.limits.sampledImageDepthSampleCounts), s.extent.width, s.extent.height);
+        }
+    }
+
+    void DropMsaaImages()
+    {
+        if (!s.dapi || !s.device) return;
+        const loader::Device& d = *s.dapi;
+        DropHelpers();
+        DropFramebuffersNaming(s.msaaColourView, 0, true);
+        DropFramebuffersNaming(s.msaaDepthView, 0, true);
+        if (s.msaaColourView != VK_NULL_HANDLE) d.DestroyImageView(s.device, s.msaaColourView, nullptr);
+        if (s.msaaColour != VK_NULL_HANDLE) d.DestroyImage(s.device, s.msaaColour, nullptr);
+        memory::Free(s.msaaColourBlock);
+        if (s.msaaDepthView != VK_NULL_HANDLE) d.DestroyImageView(s.device, s.msaaDepthView, nullptr);
+        if (s.msaaDepth != VK_NULL_HANDLE) d.DestroyImage(s.device, s.msaaDepth, nullptr);
+        memory::Free(s.msaaDepthBlock);
+        s.msaaColourView   = VK_NULL_HANDLE;
+        s.msaaColour       = VK_NULL_HANDLE;
+        s.msaaColourBlock  = memory::Block();
+        s.msaaDepthView    = VK_NULL_HANDLE;
+        s.msaaDepth        = VK_NULL_HANDLE;
+        s.msaaDepthBlock   = memory::Block();
+        s.msaaColourLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        s.msaaDepthLayout  = VK_IMAGE_LAYOUT_UNDEFINED;
+        s.msaaColourNewer = s.msaaDepthNewer = false;
+        s.msaaColourStale = s.msaaDepthStale = true;
+        for (VkImageView& v : s.msaaSetView) v = VK_NULL_HANDLE;   // the 1x views go with the same rebuild
+        s.msaaSamples = 1;
+    }
+
+    bool MsaaWanted()
+    {
+        if (s.msaaSamples <= 1 || s.msaaFailed || s.msaaColourView == VK_NULL_HANDLE || s.msaaDepthView == VK_NULL_HANDLE)
+            return false;
+        // MSAA takes priority over the G-buffer: with the multisampled images up GBufferWanted() never opens
+        // the G-buffer class, and its consumers (hdSunShadows, hdAONormals) stay off (MultisampleCount()).
+        return s.worldOpen || s.msaaModel;
+    }
+
+    void MsaaBefore1x(bool colour, bool depth)
+    {
+        if (s.msaaSamples <= 1) return;
+        if (colour)
+        {
+            MsaaResolveColour();
+            s.msaaColourStale = true;   // the pass may draw into the 1x one
+        }
+        if (depth)
+        {
+            MsaaResolveDepth();
+            s.msaaDepthStale = true;
+        }
+    }
+
+    void MsaaPrepare(Side& c, Side* d, VkExtent2D area, const present::PassClear* pending, bool foldable)
+    {
+        // The engine's clear that asked for this pass covers the whole image: BeginPass folds it into the
+        // load op, and nothing earlier needs bringing over.
+        const bool covers      = foldable && CoversAll(pending, area);
+        const bool coverColour = covers && (pending->mask & 1u);
+        const bool coverDepth  = covers && (pending->mask & 2u) && d && (d->aspect & VK_IMAGE_ASPECT_STENCIL_BIT) == 0;
+        if (s.msaaColourStale)
+        {
+            if (coverColour)
+                c.discard = true;
+            else if (s.back1x == 2 && s.backLayout != VK_IMAGE_LAYOUT_UNDEFINED)
+            {
+                SeedColour();
+                c.discard = c.clear = false;
+            }
+            else
+            {
+                // Untouched this frame (black, as the 1x one's first use) or only cleared over the whole image.
+                c.discard = c.clear = true;
+                for (uint32_t i = 0; i < 4; ++i) c.clearColour[i] = s.back1x == 1 ? s.back1xClear[i] : (i == 3 ? 1.0f : 0.0f);
+            }
+            s.msaaColourStale = false;
+        }
+        s.msaaColourNewer = true;
+        if (!d) return;
+        if (s.msaaDepthStale)
+        {
+            if (coverDepth)
+                d->discard = true;
+            else if (!s.depthFresh && s.depthLayout != VK_IMAGE_LAYOUT_UNDEFINED)
+            {
+                SeedDepth();
+                d->discard = d->clear = false;
+            }
+            else
+                d->discard = d->clear = true;   // the far plane, as the 1x depth's first use in a frame
+            s.msaaDepthStale = false;
+        }
+        s.msaaDepthNewer = true;
+    }
+
+    void MsaaResolveColour()
+    {
+        if (!s.msaaColourNewer || s.msaaColour == VK_NULL_HANDLE || s.backImage == VK_NULL_HANDLE) return;
+        if (s.passOpen) EndPass();
+        VkCommandBuffer cmd = s.slots[s.fi].main;
+        Barriers b;
+        b.Add(s.msaaColour, VK_IMAGE_ASPECT_COLOR_BIT, 1, 1, s.msaaColourLayout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, false);
+        // Every pixel of the 1x one is written: what it held is dropped.
+        b.Add(s.backImage, VK_IMAGE_ASPECT_COLOR_BIT, 1, 1, s.backLayout, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, true);
+        b.Record(cmd);
+        s.msaaColourLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+        s.backLayout       = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+        VkImageResolve r = {};
+        r.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        r.srcSubresource.layerCount = 1;
+        r.dstSubresource            = r.srcSubresource;
+        r.extent                    = VkExtent3D{ s.extent.width, s.extent.height, 1 };
+        s.dapi->CmdResolveImage(cmd, s.msaaColour, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, s.backImage,
+                                VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &r);
+        s.msaaColourNewer = false;
+        s.back1x          = 2;   // the 1x one now holds this frame's drawing
+        s.backTouched     = true;
+        ++s.stats.msaaResolves;
+    }
+
+    void MsaaResolveDepth()
+    {
+        if (!s.msaaDepthNewer || s.msaaDepth == VK_NULL_HANDLE || s.depthImage == VK_NULL_HANDLE) return;
+        if (s.passOpen) EndPass();
+        if (!EnsureHelpers())
+        {
+            s.msaaDepthNewer = false;
+            return;
+        }
+        VkCommandBuffer cmd = s.slots[s.fi].main;
+        const VkImageAspectFlags aspect = AspectOf(s.depthFormat);
+        Barriers b;
+        b.Add(s.msaaDepth, aspect, 1, 1, s.msaaDepthLayout, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, false);
+        b.Add(s.depthImage, aspect, 1, 1, s.depthLayout, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL, true);
+        b.Record(cmd);
+        s.msaaDepthLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+        s.depthLayout     = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+        PointSet(kSetResolve, s.msaaDepthView);
+        Draw(cmd, s.msaaResolvePass, s.msaaResolveFb, s.msaaResolvePipe, kSetResolve);
+        s.msaaDepthNewer = false;
+        s.depthFresh     = false;   // written this frame: kept by the next 1x pass, readable by SceneDepth
+        s.backTouched    = true;
+        ++s.stats.msaaDepthResolves;
+    }
+}
