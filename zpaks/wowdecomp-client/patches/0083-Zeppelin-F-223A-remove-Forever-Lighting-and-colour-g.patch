@@ -97,7 +97,6 @@ CGxDeviceVulkan::~CGxDeviceVulkan() {
     HD::VulkanLightPass::Shutdown(); // Zeppelin F-223A: idempotent after DeviceDestroy
     HD::VulkanFog::Shutdown(); // HD: idempotent
     HD::VulkanBloom::Shutdown(); // HD: idempotent
-    HD::VulkanGrade::Shutdown(); // HD: idempotent
     HD::VulkanCMAA2::Shutdown(); // Zeppelin F-223A: idempotent
     HD::VulkanModelLights::Shutdown(); // HD: idempotent
     HD::VulkanPerf::Shutdown(); // Zeppelin F-234
@@ -477,9 +476,7 @@ int32_t CGxDeviceVulkan::DeviceCreate(GxWindowProc windowProc, const CGxFormat&
     if (created && !HD::VulkanBloom::Init()) { // HD: hdBloom / hdRays under Vulkan (hd/HdVulkanBloom.h)
         CGxDevice::Log("HD Vulkan bloom: initialization failed; bloom unavailable");
     }
-    if (created && !HD::VulkanGrade::Init()) { // HD: hdGrade under Vulkan (hd/HdVulkanGrade.h)
-        CGxDevice::Log("HD Vulkan grade: initialization failed; grade unavailable");
-    }
+    // Zeppelin F-223A: hdGrade (colour grading) removed; HD::VulkanGrade is no longer created
     if (created && !HD::VulkanCMAA2::Init()) { // Zeppelin F-223A: hdCMAA (hd/HdVulkanCMAA2.h)
         CGxDevice::Log("HD Vulkan CMAA2: initialization failed; CMAA2 unavailable");
     }
@@ -507,10 +504,6 @@ void CGxDeviceVulkan::DeviceDestroy() {
         CGxDevice::Log("HD Vulkan bloom: outstanding serial; retry before device destruction");
         return;
     }
-    if (!HD::VulkanGrade::Shutdown()) { // HD
-        CGxDevice::Log("HD Vulkan grade: outstanding serial; retry before device destruction");
-        return;
-    }
     if (!HD::VulkanCMAA2::Shutdown()) { // Zeppelin F-223A
         CGxDevice::Log("HD Vulkan CMAA2: outstanding serial; retry before device destruction");
         return;
@@ -681,9 +674,7 @@ int32_t CGxDeviceVulkan::DeviceCreate(void* window, const CGxFormat& format) {
     if (created && !HD::VulkanBloom::Init()) { // HD: hdBloom / hdRays under Vulkan (hd/HdVulkanBloom.h)
         CGxDevice::Log("HD Vulkan bloom: initialization failed; bloom unavailable");
     }
-    if (created && !HD::VulkanGrade::Init()) { // HD: hdGrade under Vulkan (hd/HdVulkanGrade.h)
-        CGxDevice::Log("HD Vulkan grade: initialization failed; grade unavailable");
-    }
+    // Zeppelin F-223A: hdGrade (colour grading) removed; HD::VulkanGrade is no longer created
     if (created && !HD::VulkanCMAA2::Init()) { // Zeppelin F-223A: hdCMAA (hd/HdVulkanCMAA2.h)
         CGxDevice::Log("HD Vulkan CMAA2: initialization failed; CMAA2 unavailable");
     }
