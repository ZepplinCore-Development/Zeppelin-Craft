diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/CataRippleWaves.frag b/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/CataRippleWaves.frag
new file mode 100644
index 00000000..64fa07dc
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/CataRippleWaves.frag
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Zeppelin F-234: the map the Cata water samples (CataRipples.cpp, Ripples::Composite), written over one of Cata's
+// displacement maps' window: Cata's map A (its two steps, x the height now and y the one before, kept for the water's
+// own interpolation), times the ripple strength; Cata's map B folded in at this frame's interpolation (the hulls' map,
+// whose window lies texel-aligned in A's); and the FFT waves' height (HdWaterWaves.cpp, D3D9's spectra), in the map's
+// height units, faded in and out by distance from the window's centre. The water derives its normals from one-texel
+// height differences, so the waves need no shader of their own; their heights are Hermite-interpolated from the FFT's
+// own slopes (exact float weights, C1: no facets in the normals, whatever the hardware filter precision).
+#version 450
+layout(set = 0, binding = 0) uniform sampler2D stateA;
+layout(set = 0, binding = 1) uniform sampler2D stateB;
+layout(set = 0, binding = 2) uniform sampler2D waves;   // 64 x 256: per cascade 64 rows of dh/dx, dh/dy, height (yd), Jacobian
+layout(push_constant) uniform Push {
+    vec4 a;          // xy: this texel's uv -> A's uv offset, z: A's strength (0: not read)
+    vec4 b;          // xy: -> B's uv offset, z: B's strength (0: not read), w: B's interpolation
+    vec4 fade;       // uv radii from the centre: from 0 at x to full at y (y <= 0: no fade-in), full at z to 0 at w
+    vec4 wave;       // x: map height units per yard, y: the window's size (yards)
+    vec4 tileOff0;   // cascades 0, 1: the window's corner in the tile (tile uv)
+    vec4 tileOff1;   // cascades 2, 3
+    vec4 tileScale;  // window size / tile size per cascade, 0: not used
+} pc;
+layout(location = 0) out vec4 outColor;
+
+const float kTexSize = 1024.0;
+const int kN = 64;
+
+// The height of one cascade at tile uv p: a bicubic Hermite patch over the FFT grid (corner heights and slopes, no
+// cross term), the slopes per yard turned into per grid step with the tile size.
+float Height(vec2 p, int layer, float step) {
+    vec2 g = p * float(kN);
+    vec2 cell = floor(g);
+    vec2 t = g - cell;
+    ivec2 i0 = ivec2(mod(cell, float(kN)));
+    ivec2 i1 = (i0 + 1) & (kN - 1);
+    int base = layer * kN;   // the cascades lie one under the other
+    vec4 c00 = texelFetch(waves, ivec2(i0.x, i0.y + base), 0);
+    vec4 c10 = texelFetch(waves, ivec2(i1.x, i0.y + base), 0);
+    vec4 c01 = texelFetch(waves, ivec2(i0.x, i1.y + base), 0);
+    vec4 c11 = texelFetch(waves, ivec2(i1.x, i1.y + base), 0);
+    vec2 t2 = t * t, t3 = t2 * t;
+    vec2 h0 = 2.0 * t3 - 3.0 * t2 + 1.0;   // value at 0
+    vec2 h1 = 1.0 - h0;                    // value at 1
+    vec2 d0 = (t3 - 2.0 * t2 + t) * step;  // slope at 0
+    vec2 d1 = (t3 - t2) * step;            // slope at 1
+    return c00.z * h0.x * h0.y + c10.z * h1.x * h0.y + c01.z * h0.x * h1.y + c11.z * h1.x * h1.y +
+           c00.x * d0.x * h0.y + c10.x * d1.x * h0.y + c01.x * d0.x * h1.y + c11.x * d1.x * h1.y +
+           c00.y * h0.x * d0.y + c10.y * h1.x * d0.y + c01.y * h0.x * d1.y + c11.y * h1.x * d1.y;
+}
+
+void main() {
+    vec2 uv = gl_FragCoord.xy / kTexSize;
+    vec2 h = vec2(0.0);
+    if (pc.a.z != 0.0) h += pc.a.z * texture(stateA, uv + pc.a.xy).xy;
+    if (pc.b.z != 0.0) {
+        vec2 ub = uv + pc.b.xy;
+        if (all(greaterThanEqual(ub, vec2(0.0))) && all(lessThanEqual(ub, vec2(1.0)))) {
+            vec2 s = texture(stateB, ub).xy;
+            h += pc.b.z * mix(s.y, s.x, pc.b.w);
+        }
+    }
+    if (pc.wave.x != 0.0) {
+        float r = length(uv - 0.5);
+        float w = 1.0 - smoothstep(pc.fade.z, pc.fade.w, r);
+        if (pc.fade.y > 0.0) w *= smoothstep(pc.fade.x, pc.fade.y, r);
+        if (w > 0.0) {
+            float sum = 0.0;
+            vec2 off[4] = vec2[4](pc.tileOff0.xy, pc.tileOff0.zw, pc.tileOff1.xy, pc.tileOff1.zw);
+            for (int c = 0; c < 4; ++c) {
+                float scale = pc.tileScale[c];
+                if (scale <= 0.0) continue;
+                // grid step in yards = tile / 64 = window / (scale * 64)
+                sum += Height(off[c] + uv * scale, c, pc.wave.y / (scale * float(kN)));
+            }
+            h += vec2(sum * pc.wave.x * w);
+        }
+    }
+    outColor = vec4(h, 0.0, 1.0);
+}
