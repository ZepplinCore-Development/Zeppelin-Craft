+// Zeppelin F-234: the Vulkan Cata water's waves (HdWaterWaves.h). The spectra are the D3D9 path's own (s_waves, so
+// both renderers show the same sea); only the evaluated floats are kept, the device uploads them.
+int32_t HD::WaterWavesSample(int32_t pbrType, const float** data, float* tile, uint32_t* serial) {
+    static std::vector<float> s_data;
+    static uint32_t s_lastMs = 0, s_serial = 0;
+    static int32_t s_type = 0x7FFFFFFF, s_count = 0;
+    static float s_scale = -1.0f;
+    RegisterCVars();
+    if (!WaterWavesEnabled()) return 0;
+    Load();
+    const float heading = HeadingRadians();
+    WaveType*& w = s_waves[pbrType];
+    if (w && std::fabs(w->heading - heading) > 1e-4f) {
+        if (s_current == w) s_current = nullptr;   // the D3D9 path builds it again at its next update
+        Free(w);
+        w = nullptr;
+    }
+    if (!w) {
+        w = Build(pbrType, heading);
+        s_type = 0x7FFFFFFF;
+    }
+    if (w->count == 0) return 0;
+    const uint32_t now = OsGetAsyncTimeMs();
+    const float scale = WaterWavesScale();
+    if (s_type != pbrType || s_scale != scale || now - s_lastMs >= 8u) {
+        s_type = pbrType;
+        s_scale = scale;
+        s_lastMs = now;
+        s_count = w->count;
+        const double t = (now % 3600000u) * 0.001;   // wraps once an hour, as WaterWavesUpdate
+        std::vector<float> one;
+        s_data.resize(static_cast<size_t>(s_count) * kN * kN * 4);
+        for (int32_t i = 0; i < s_count; i++) {
+            Evaluate(w->cascades[i], t, scale, one);
+            memcpy(&s_data[static_cast<size_t>(i) * kN * kN * 4], one.data(), sizeof(float) * kN * kN * 4);
+        }
+        s_serial++;
+    }
+    for (int32_t i = 0; i < kMaxTiles; i++) tile[i] = i < s_count ? w->cascades[i].size : 0.0f;
+    *data = s_data.data();
+    *serial = s_serial;
+    return s_count;
+}
