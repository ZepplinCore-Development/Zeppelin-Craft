+// Zeppelin F-234: the FFT waves in the maps (CataRipples.h). Output 0 carries them near the player at Cata's texel
+// (0.125 yd), output 1 over a 512 yd window (0.5 yd) beyond; the hand-over is complementary, so the sum is the waves.
+constexpr VkFormat kWaveFormat = VK_FORMAT_R16G16B16A16_SFLOAT;
+constexpr float kFarSize = 512.0f;
+constexpr float kNearFull = 40.0f, kNearZero = 58.0f;        // yards from the player: output 0's waves fade out
+constexpr float kFarFull = 205.0f, kFarZero = 246.0f;        // output 1's fade out (its window's half is 256)
+constexpr float kFarMinTile = 32.0f;                         // output 1 skips the cascades finer than its texels show
+
+uint16_t Half(float v) {
+    uint32_t x;
+    memcpy(&x, &v, 4);
+    const uint32_t sign = (x >> 16) & 0x8000u;
+    const int32_t e = static_cast<int32_t>((x >> 23) & 0xFF) - 127 + 15;
+    const uint32_t mant = x & 0x7FFFFFu;
+    if (e <= 0) return static_cast<uint16_t>(sign);
+    if (e >= 31) return static_cast<uint16_t>(sign | 0x7BFFu);
+    return static_cast<uint16_t>(sign | (static_cast<uint32_t>(e) << 10) | (mant >> 13));
+}
 
