+// Zeppelin F-234: one output map (CataRippleWaves.frag); push = the shader's seven vec4.
+void Ripples::Composite(VkCommandBuffer cmd, uint32_t out, VkDescriptorSet set, const float push[28]) {
+    const wxlvk::vk::loader::Device& d = *context::Get()->dapi;
+    BeginPass(cmd, 2 * kMaps + out, false);
+    d.CmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, composite_);
+    d.CmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, compositeLayout_, 0, 1, &set, 0, nullptr);
+    d.CmdPushConstants(cmd, compositeLayout_, VK_SHADER_STAGE_FRAGMENT_BIT, 0, 28 * sizeof(float), push);
+    d.CmdDraw(cmd, 3, 1, 0, 0);
+    d.CmdEndRenderPass(cmd);
+}
