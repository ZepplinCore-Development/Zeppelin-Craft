+        s_weatherTypeForced = 1;
+    } else if (wasForced) {
+        weather->SetType(s_serverWeather.type, s_serverWeather.intensity, s_serverWeather.rec, false, s_serverWeather.transition);
+    }
+    s_hdApplying = false;
+}
