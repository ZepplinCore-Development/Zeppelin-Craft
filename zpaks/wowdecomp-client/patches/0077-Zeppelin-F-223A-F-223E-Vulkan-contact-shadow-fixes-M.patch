From 2d8cff95bd58ec9990ccb00ef97a040b5af008f5 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Tue, 3 Nov 2026 13:27:42 +0000
Subject: [PATCH] Zeppelin F-223A/F-223E: Vulkan contact shadow fixes, MSAA
 contact on its own, hdWeather override

- Contact shadows: characters never cast while the character shadow map (hdShadowChar) is on (doubled shadow);
  the 3.3.5 look keeps max(70%, the sun's share of the light) in shadow, so clouds and rain fade them
- Under MSAA the depth-only contact detail follows hdSunContact alone (Soft Sun Shadows is greyed there)
- hdWeather (-1 server, 0 clear, 1 rain, 2 snow, 3 sandstorm) and hdWeatherIntensity force the weather on this
  screen only; the server's last weather is kept and restored at -1

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UHcJJVC4feQ4s15e9bNRoN
---
 .../Gx/CGxDeviceVulkan/hd/HdVulkanContact.cpp |   7 +-
 .../Gx/CGxDeviceVulkan/hd/HdVulkanShadows.cpp |   5 +-
 .../hd/shaders/contact/HdContact.comp         |   4 +-
 .../hd/shaders/contact/HdContact.spv.h        | 586 +++++++++---------
 WoW/Source/WorldClient/MapWeather.cpp         |  49 ++
 5 files changed, 355 insertions(+), 296 deletions(-)

diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanContact.cpp b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanContact.cpp
index 08c4e085..457a19a1 100644
--- a/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanContact.cpp
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanContact.cpp
@@ -148,10 +148,15 @@ bool BuildConstants(const WXL_VkStageContext& ctx, Constants& c, bool& shadows,
     if (shadows) std::memcpy(c.smat, &CShadowCache::s_shadowMatrices[3].x, sizeof c.smat);
     // the characters near the camera (camera-relative world -> view space, rotation only) and the world's up
     // (the D3D9 version's hdContactShadowUnits 1 -- characters cast too -- is honoured when that cvar exists)
+    // Zeppelin F-223A: never while the character shadow map is on (hdShadowChar): it already shadows them, and both
+    // together drew a second, offset shadow of every character. hdContactShadowUnits has no control on Vulkan.
     static CVar* unitsCast = nullptr;
+    static CVar* charMap = nullptr;
     if (!unitsCast) unitsCast = CVar::Lookup("hdContactShadowUnits");
+    if (!charMap) charMap = CVar::Lookup("hdShadowChar");
+    const bool charShadowMap = charMap && charMap->m_intValue > 0;
     HD::ContactShadowUnit list[MaxUnits];
-    units = unitsCast && unitsCast->m_intValue ? 0u : static_cast<uint32_t>(std::max(0, HD::ContactShadowGatherUnits(list, MaxUnits)));
+    units = unitsCast && unitsCast->m_intValue && !charShadowMap ? 0u : static_cast<uint32_t>(std::max(0, HD::ContactShadowGatherUnits(list, MaxUnits)));
     for (uint32_t i = 0; i < units; ++i) {
         for (int j = 0; j < 3; ++j) c.unit[i][j] = list[i].x * view[j] + list[i].y * view[4 + j] + list[i].z * view[8 + j];
         c.unit[i][3] = list[i].height;
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanShadows.cpp b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanShadows.cpp
index 675e0575..03887145 100644
--- a/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanShadows.cpp
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanShadows.cpp
@@ -315,12 +315,13 @@ void Resize(){
  // Zeppelin I-442: MSAA takes priority. With the multisampled back buffer up (gxMultisample > 1 on Vulkan) the device
  // never draws the G-buffer these shadows read, so they stay off: no receiver swap, no request.
  const uint32_t msaa=wxlvk::native::present::MultisampleCount();
- const bool msaaBlocks=msaa>1&&config.enabled;
+ // Zeppelin F-223A: under MSAA the contact detail follows hdSunContact alone (the menu greys Soft Sun Shadows out there).
+ const bool msaaBlocks=msaa>1;
  if(msaa>1)config.enabled=false;
  Mode(config.enabled);
  if(config.enabled!=requested){renderApi->RequestGBuffer(config.enabled?1:0);requested=config.enabled;}
  // Zeppelin I-442: with the full path blocked by MSAA, the contact detail still runs depth-only (HdVulkanContact) while
- // hdSunContact is 1. Never both in one frame: the full path's own contact pass is part of it, so no double darkening.
+// hdSunContact is 1 (whatever hdSunShadows says). Never both in one frame: the full path's own contact pass is part of it, so no double darkening.
  HD::VulkanContact::Settings contactOnly{};
  contactOnly.enabled=msaaBlocks&&config.contact;
  contactOnly.length=config.contactLength;contactOnly.strength=config.contactStrength;
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/contact/HdContact.comp b/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/contact/HdContact.comp
index 9df62214..a465178d 100644
--- a/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/contact/HdContact.comp
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/contact/HdContact.comp
@@ -76,7 +76,9 @@ vec4 Generate(ivec2 px){
   if(s.w>.5&&delta>bias&&delta<thick&&InUnit(s.xyz)<.5){occ=1.0-smoothstep(.4,1.0,t/len);break;}}
  occ*=(1.0-clamp((p.z-c.blur.z)*c.blur.w,0.0,1.0))*c.params.y;
  vec3 forever=c.ambient.rgb/max(c.ambient.rgb+c.diffuse.rgb*ndl,vec3(1e-4));
- vec3 k=mix(vec3(.7),forever,c.ambient.w*clamp((dot(n,c.up.xyz)-.55)*3.3,0.0,1.0));
+ // Zeppelin F-223A: the 3.3.5 look keeps 70% in shadow, but never more darkness than the sun's share of the light:
+ // under clouds and rain the world light is weak against the ambient, so its shadow is faint (it was a fixed 30%).
+ vec3 k=mix(max(vec3(.7),forever),forever,c.ambient.w*clamp((dot(n,c.up.xyz)-.55)*3.3,0.0,1.0));
  float s=c.params.z>1.5?1.0:vis;
  vec3 keep=(k+(1.0-k)*s*(1.0-occ))/(k+(1.0-k)*s);
  return vec4(1.0-keep*keep,.5+.5*vis);
