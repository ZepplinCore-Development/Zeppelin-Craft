diff --git a/WoW/Source/Ui/ZepCVarRanges.cpp b/WoW/Source/Ui/ZepCVarRanges.cpp
new file mode 100644
index 00000000..a62917fe
--- /dev/null
+++ b/WoW/Source/Ui/ZepCVarRanges.cpp
@@ -0,0 +1,79 @@
+// Not in the original (F-232): slider ranges for GetCVarMin / GetCVarMax.
+#include "WoW/Source/Ui/ZepCVarRanges.h"
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/Storm/H/storm.h"
+#include "WoW/Source/UIUtil/Camera.h"
+
+namespace {
+
+constexpr double NO_LIMIT = -1.0e30;
+
+struct ZepCVarRange {
+    const char* name;
+    double min; // NO_LIMIT = keep the stock answer (FrameXML falls back to its own table)
+    double max;
+};
+
+// Engine limits come from the CVar validators and the clamps behind them (see the F-232 note).
+const ZepCVarRange s_ranges[] = {
+    // Stock sliders whose engine limit is above the FrameXML max.
+    { "farclip", NO_LIMIT, 10000.0 },             // World::ValidateFarClip (F-162 farclip-unlock), stock UI 1277
+    { "groundEffectDist", NO_LIMIT, 1024.0 },     // CVar callback (F-162 ground-effect-distance), stock UI 140
+    { "groundEffectDensity", NO_LIMIT, 256.0 },   // CVar callback, stock UI 64
+    { "environmentDetail", NO_LIMIT, 3.0 },       // no engine cap (F-162 environment-detail-unlock); 3 = twice the stock cap
+    { "mouseSpeed", 0.1, 2.0 },                   // OsInputSetMouseSpeed clamp, stock UI 0.5..1.5
+    { "cameraYawMoveSpeed", NO_LIMIT, 360.0 },    // ValidateCameraAngularSpeed, stock UI 270
+    { "cameraYawSmoothSpeed", NO_LIMIT, 360.0 },  // ValidateCameraAngularSpeed, stock UI 270
+
+    // Hidden CVars on the F-232 Advanced video panel.
+    { "horizonFarclipScale", 3.0, 12.0 },         // CVar callback (F-162 horizon-farclip-unlock)
+    { "maxFPS", 0.0, 300.0 },                     // 0 = unlimited; the engine has no top
+    { "maxFPSBk", 0.0, 300.0 },
+    { "spellEffectLevel", 0.0, 9.0 },             // SpellVisuals rate = level / 9
+    { "SkyCloudLOD", 0.0, 3.0 },                  // CloudLODCallback
+    { "texLodBias", -1.0, 1.0 },                  // TexLodBiasCallback
+};
+
+const ZepCVarRange* Find(const char* name) {
+    for (const ZepCVarRange& range : s_ranges) {
+        if (!SStrCmpI(name, range.name, STORM_MAX_STR)) {
+            return &range;
+        }
+    }
+
+    return nullptr;
+}
+
+} // namespace
+
+bool ZepCVarRangeMin(const char* name, double* value) {
+    const ZepCVarRange* range = Find(name);
+
+    if (!range || range->min == NO_LIMIT) {
+        return false;
+    }
+
+    *value = range->min;
+    return true;
+}
+
+bool ZepCVarRangeMax(const char* name, double* value) {
+    // The effective zoom is factor x cameraDistanceMax, clamped to 50 yd in CGCamera::UpdateMotion.
+    if (!SStrCmpI(name, "cameraDistanceMaxFactor", STORM_MAX_STR)) {
+        if (!s_cvCameraDistanceMax || s_cvCameraDistanceMax->m_floatValue <= 0.0f) {
+            return false;
+        }
+
+        *value = 50.0 / s_cvCameraDistanceMax->m_floatValue;
+        return true;
+    }
+
+    const ZepCVarRange* range = Find(name);
+
+    if (!range || range->max == NO_LIMIT) {
+        return false;
+    }
+
+    *value = range->max;
+    return true;
+}
diff --git a/WoW/Source/Ui/ZepCVarRanges.h b/WoW/Source/Ui/ZepCVarRanges.h
new file mode 100644
index 00000000..14d7495d
--- /dev/null
+++ b/WoW/Source/Ui/ZepCVarRanges.h
@@ -0,0 +1,11 @@
+#ifndef WOW_SOURCE_UI_ZEPCVARRANGES_H
+#define WOW_SOURCE_UI_ZEPCVARRANGES_H
+
+// Not in the original (F-232): slider ranges that GetCVarMin / GetCVarMax report, so the options sliders
+// (stock FrameXML prefers GetCVarMin/Max over its hard-coded table) show the ranges the engine really accepts.
+
+// True and *value set when the CVar has a range override for that end; false keeps the stock answer.
+bool ZepCVarRangeMin(const char* name, double* value);
+bool ZepCVarRangeMax(const char* name, double* value);
+
+#endif
-- 
