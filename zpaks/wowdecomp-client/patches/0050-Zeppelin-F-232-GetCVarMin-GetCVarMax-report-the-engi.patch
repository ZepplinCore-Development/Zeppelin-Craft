     FrameXML_FreeHashNodes();
     FrameXML_CreateFrames("Interface\\FrameXML\\FrameXML.toc", nullptr, &md5, &status);
+    // Not in the original (F-232): Zeppelin's own FrameXML (zpak zep-options), loaded like FrameXML.toc with no addon
