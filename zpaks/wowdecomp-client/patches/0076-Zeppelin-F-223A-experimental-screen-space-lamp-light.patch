index 00000000..9138ec44
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanLightPass.h
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Zeppelin F-223A: screen-space light pass for the Vulkan renderer (hdLightPass, default off).
+//
+// Lamps, braziers, fires: every M2 point light of the frame (HD::LightsGather, the same gathering as the D3D9 per-pixel
+// terrain lamps) lights the opaque world per pixel, with no 4-light cap and no G-buffer, so it works under MSAA. A compute
+// stage at AfterOpaqueWorld (after AO) culls the lamps to the frustum on the CPU, uploads them in view space, and one
+// 16x16 workgroup per screen tile culls them to the tile's depth range, then lights each pixel from depth and a
+// depth-derived normal: colour x (1 + buffer / light^2.2)^(1/2.2) (shaders/lights/HdVulkanLightPass.comp).
+//
+// Double lighting: while the pass will run this frame, CM2Lighting::AddLight leaves the point lights out
+// (g_ownsPointLights), so the engine's per-vertex lamps (4 per model, 3 per terrain chunk) are replaced, not added to,
+// the way hdLights does it for the D3D9 HD terrain. It is set before the world is drawn and cleared when the stage runs,
+// so everything lit after the opaque world (liquids) keeps the engine's lamps. Pass off (or hdLightPassStock 1): the
+// engine's lighting is untouched.
+//
+//   hdLightPass          0 off / 1 on (Vulkan only; D3D9 unchanged)
+//   hdLightPassStrength  0..4 lamp light multiplier (1 = WoW Forever's falloff)
+//   hdLightPassMax       1..1024 lamps drawn per frame, nearest first
+//   hdLightPassRadius    0.25..4 multiplier of each lamp's radius (hdLightsRadius, or from its colour)
+//   hdLightPassFloor     0.005..1 floor of the estimated engine light^2.2 (caps the gain in dark places)
+//   hdLightPassStock     1 keeps the engine's per-vertex lamps too (A/B test of the double lighting), 0 default
+//   hdLightPassDebug     0 off / 1 lamp light only / 2 lamps per tile
+//   hdLightPassInfo      read only: lamps gathered / in view / drawn, tiles lit, per-tile average and maximum
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include "wxl/VkRenderApi.h"
+
+namespace HD::VulkanLightPass {
+extern bool g_ownsPointLights; // read by CM2Lighting::AddLight (Model2/M2Light.cpp)
+
+constexpr uint32_t MaxLamps = 1024;
+struct alignas(16) Lamp {float posRadius[4], colorInvFade[4];};
+struct alignas(16) Header {
+    float screen[4], view[4], rect[4], depth[4], full[4];
+    float ambient[4], diffuse[4], sunDir[4];
+    uint32_t counts[4]; // lamps, debug, swapRB, stats
+};
+static_assert(sizeof(Lamp) == 32 && sizeof(Header) == 144, "GLSL std430 layout");
+struct GpuStats {uint32_t tiles = 0, litTiles = 0, pairs = 0, maxPerTile = 0;};
+
+// Engine owner, like HdVulkanAO: Init after DeviceCreate, Resize before each world (reads the cvars, decides the cut),
+// EndWorld after it, Shutdown before the device goes.
+bool Init();
+void Resize();
+void EndWorld();
+bool Shutdown();
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/lights/HdVulkanLightPass.comp b/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/lights/HdVulkanLightPass.comp
new file mode 100644
index 00000000..84cebcf6
--- /dev/null
+++ b/Engine/Source/Gx/CGxDeviceVulkan/hd/shaders/lights/HdVulkanLightPass.comp
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Zeppelin F-223A: screen-space light pass (hdLightPass). One 16x16 workgroup per screen tile: it takes the tile's depth
+// range, culls this frame's lamps (every M2 point light the engine has, not 4 per draw) against the tile's frustum into a
+// shared list, then lights each pixel from its depth and a normal derived from depth. No G-buffer, so it runs on the
+// resolved depth under MSAA. There is no albedo either: the frame's colour is albedo x the engine's light, so the lamp
+// light is applied as WoW Forever does on the ground, albedo x (light^2.2 + buffer)^(1/2.2), which for the frame's colour
+// is colour x (1 + buffer / light^2.2)^(1/2.2), with `light` estimated from the sun's ambient and diffuse at that normal.
+// Falloff = CM2Light's 0 / 0.7 / 0.03 (Forever's legacy lightbufferomni), windowed to 0 at the light's radius.
+#version 450
+layout(local_size_x=16,local_size_y=16)in;
+layout(binding=0)uniform sampler2D RawDepth;
+layout(binding=1,rgba8)uniform image2D Frame;
+struct Lamp {vec4 posRadius;vec4 colorInvFade;}; // view-space position, radius (yards); rgb, 1 / fade width
+layout(std430,binding=2)readonly buffer Lights {
+    vec4 screen,view,rect,depth,full; // the AO module's reconstruction rows (HdVulkanAO.h BuildConstants)
+    vec4 ambient;  // rgb = the sun's ambient (gamma), w = floor of the estimated light^2.2
+    vec4 diffuse;  // rgb = the sun's diffuse (gamma), w = strength
+    vec4 sunDir;   // xyz = the direction the sunlight travels, view space
+    uvec4 counts;  // lamps, debug view (0 off, 1 lamp light only, 2 lamps per tile), swapRB, 0
+    Lamp lamps[];
+} L;
+layout(std430,binding=3)buffer Stats {uint tiles,litTiles,pairs,maxPerTile;} S;
+
+const uint kTileMax=256u;
+shared uint sMinZ,sMaxZ,sCount;
+shared uint sList[kTileMax];
+
+vec2 Local(vec2 uv){return (uv-L.rect.xy-L.full.zw*L.full.xy)*L.rect.zw;}
+float ViewZ(ivec2 p){
+    ivec2 size=textureSize(RawDepth,0);
+    if(any(lessThan(p,ivec2(0)))||any(greaterThanEqual(p,size)))return 0;
+    float raw=texelFetch(RawDepth,p,0).r,z01=raw*L.screen.z+L.screen.w;
+    if(isnan(raw)||isinf(raw)||z01<0||z01>=L.depth.z)return 0; // 0 = sky / outside the world's viewport
+    vec2 v=Local((vec2(p)+.5)*L.full.xy);
+    if(any(lessThan(v,vec2(0)))||any(greaterThan(v,vec2(1))))return 0;
+    return L.depth.y/max(L.depth.x-z01,1e-7);
+}
+vec3 Ray(vec2 pixel){return vec3(Local(pixel*L.full.xy)*L.view.xy+L.view.zw,1);} // view position at z = 1
+vec3 Position(ivec2 p,float z){return Ray(vec2(p)+.5)*z;}
+// Normal from depth: on each axis the neighbour closer in depth (no smearing across silhouettes), facing the eye.
+vec3 Normal(ivec2 p,vec3 c,float z){
+    float zl=ViewZ(p+ivec2(-1,0)),zr=ViewZ(p+ivec2(1,0)),zt=ViewZ(p+ivec2(0,-1)),zb=ViewZ(p+ivec2(0,1));
+    vec3 dx,dy;
+    bool useR=zr>0&&(zl<=0||abs(zr-z)<abs(zl-z)),useB=zb>0&&(zt<=0||abs(zb-z)<abs(zt-z));
+    if(useR)dx=Position(p+ivec2(1,0),zr)-c;else if(zl>0)dx=c-Position(p+ivec2(-1,0),zl);else dx=vec3(1,0,0);
+    if(useB)dy=Position(p+ivec2(0,1),zb)-c;else if(zt>0)dy=c-Position(p+ivec2(0,-1),zt);else dy=vec3(0,-1,0);
+    vec3 n=cross(dy,dx);float len=length(n);
+    n=len>1e-12?n/len:-normalize(c);
+    return dot(n,c)>0?-n:n;
+}
+vec4 Plane(vec3 a,vec3 b,vec3 inside){vec3 n=normalize(cross(a,b));return vec4(dot(n,inside)<0?-n:n,0);}
+
+void main(){
+    ivec2 p=ivec2(gl_GlobalInvocationID.xy);uint index=gl_LocalInvocationIndex;
+    ivec2 size=imageSize(Frame);bool inside=all(lessThan(p,size));
+    if(index==0u){sMinZ=0x7f7fffffu;sMaxZ=0u;sCount=0u;}
+    barrier();
+    float z=inside?ViewZ(p):0;
+    if(z>0){atomicMin(sMinZ,floatBitsToUint(z));atomicMax(sMaxZ,floatBitsToUint(z));} // positive floats order as uints
+    barrier();
+    float minZ=uintBitsToFloat(sMinZ),maxZ=uintBitsToFloat(sMaxZ);
+    bool hasDepth=sMaxZ!=0u;
+    if(hasDepth){
+        // The tile's four side planes through the eye, then its depth range.
+        vec2 lo=vec2(gl_WorkGroupID.xy*16u),hi=min(lo+16.0,vec2(size));
+        vec3 a=Ray(lo),b=Ray(vec2(hi.x,lo.y)),c=Ray(hi),d=Ray(vec2(lo.x,hi.y)),mid=Ray((lo+hi)*.5);
+        vec4 planes[4]={Plane(a,b,mid),Plane(b,c,mid),Plane(c,d,mid),Plane(d,a,mid)};
+        for(uint i=index;i<L.counts.x;i+=256u){
+            vec4 s=L.lamps[i].posRadius;
+            if(s.z+s.w<minZ||s.z-s.w>maxZ)continue;
+            if(dot(planes[0].xyz,s.xyz)<-s.w||dot(planes[1].xyz,s.xyz)<-s.w||dot(planes[2].xyz,s.xyz)<-s.w||dot(planes[3].xyz,s.xyz)<-s.w)continue;
+            uint slot=atomicAdd(sCount,1u);if(slot<kTileMax)sList[slot]=i;
+        }
+    }
+    barrier();
+    uint count=min(sCount,kTileMax);
+    if(index==0u&&L.counts.w!=0u){atomicAdd(S.tiles,1u);if(count>0u){atomicAdd(S.litTiles,1u);atomicAdd(S.pairs,count);atomicMax(S.maxPerTile,count);}}
+    if(!inside)return;
+    uint debug=L.counts.y;
+    if(debug==2u){ // lamps per tile: blue 1 .. red 32+, dark where none
+        vec4 color=imageLoad(Frame,p);float t=clamp(float(count)/32.0,0,1);
+        vec3 heat=count==0u?color.rgb*.25:mix(vec3(0,.2,1),vec3(1,.1,0),t);
+        if(L.counts.z!=0u)heat=heat.bgr;
+        imageStore(Frame,p,vec4(heat,color.a));return;
+    }
+    if(z<=0||count==0u){if(debug==1u)imageStore(Frame,p,vec4(0,0,0,imageLoad(Frame,p).a));return;}
+    vec3 pos=Position(p,z),n=Normal(p,pos,z),lamplight=vec3(0);
+    for(uint k=0u;k<count;++k){
+        Lamp lamp=L.lamps[sList[k]];
+        vec3 l=lamp.posRadius.xyz-pos;float d2=max(dot(l,l),1e-6),inv=inversesqrt(d2),dist=d2*inv;
+        if(dist>=lamp.posRadius.w)continue;
+        float nl=max(dot(l,n)*inv,0);
+        lamplight+=lamp.colorInvFade.rgb*(nl/((inv*.7+.03)*d2))*clamp((lamp.posRadius.w-dist)*lamp.colorInvFade.w,0,1);
+    }
+    lamplight*=L.diffuse.w;
+    vec4 color=imageLoad(Frame,p);
+    if(debug==1u){vec3 shown=lamplight/(1+lamplight);if(L.counts.z!=0u)shown=shown.bgr;imageStore(Frame,p,vec4(shown,color.a));return;}
+    vec3 light=L.ambient.rgb+L.diffuse.rgb*max(dot(n,-L.sunDir.xyz),0);
+    vec3 base=max(pow(max(light,vec3(0)),vec3(2.2)),vec3(L.ambient.w));
+    vec3 gain=pow(vec3(1)+lamplight/base,vec3(1.0/2.2));
+    if(L.counts.z!=0u)gain=gain.bgr; // with swapRB the image's .r is blue
+    imageStore(Frame,p,vec4(min(color.rgb*gain,vec3(1)),color.a));
+}
