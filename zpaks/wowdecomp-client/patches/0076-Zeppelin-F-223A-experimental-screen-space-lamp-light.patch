+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <new>
+#include <vector>
+#include <windows.h>
+#include "HdVulkanAO.h"
+#include "Engine/Source/ConsoleBase/ConsoleVar.h"
+#include "Engine/Source/ConsoleBase/Types.h"
+#include "Engine/Source/Model2/M2Light.h"
+#include "Engine/Source/Tempest/C3Vector.h"
+#include "WoW/Source/WorldClient/HD/HdLights.h"
+#include "WoW/Source/WorldClient/Map.h"
+#include "WoW/Source/WorldClient/MapLight.h"
+#include "WoW/Source/WorldClient/World.h"
+#include "native/Present.hpp"
+#include "wxl/Script.hpp"
+
+namespace HD::VulkanLightPass {
+bool g_ownsPointLights = false;
+namespace {
+#include "shaders/lights/HdVulkanLightPass.spv.h"
+constexpr uint32_t MaxSlots = 8, Tile = 16;
+constexpr size_t LightBytes = sizeof(Header) + sizeof(Lamp) * MaxLamps;
+
+struct Settings {
+    bool enabled = false, keepStock = false;
+    float strength = 1, radius = 1, floor = .03f;
+    uint32_t maxLamps = 256, debug = 0;
+};
+struct FrameFigures {uint32_t gathered = 0, inView = 0, drawn = 0, tiles = 0;};
+
+#define LP_FUNCTIONS(X) \
+    X(CreateDescriptorSetLayout) X(DestroyDescriptorSetLayout) X(CreatePipelineLayout) X(DestroyPipelineLayout) \
+    X(CreateDescriptorPool) X(DestroyDescriptorPool) X(AllocateDescriptorSets) X(UpdateDescriptorSets) \
+    X(CreateSampler) X(DestroySampler) X(CreateShaderModule) X(DestroyShaderModule) \
+    X(CreateComputePipelines) X(DestroyPipeline) X(CmdPipelineBarrier) X(CmdBindPipeline) \
+    X(CmdBindDescriptorSets) X(CmdDispatch)
+
+struct State {
+    const WXL_VkRenderApi* api = nullptr;
+    WXL_VkDeviceInfo device{};
+    const char* error = "";
+    VkDescriptorSetLayout setLayout = VK_NULL_HANDLE;
+    VkPipelineLayout layout = VK_NULL_HANDLE;
+    VkPipeline pipeline = VK_NULL_HANDLE;
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    VkSampler sampler = VK_NULL_HANDLE;
+    struct Slot {
+        VkDescriptorSet set = VK_NULL_HANDLE;
+        void* lights = nullptr; WXL_VkBufferInfo lightInfo{};
+        void* stats = nullptr; WXL_VkBufferInfo statsInfo{};
+        uint64_t serial = 0;
+        bool statsPending = false;
+    };
+    std::array<Slot, MaxSlots> slots{};
+    uint64_t last = 0;
+#define LP_DECLARE(n) PFN_vk##n n = nullptr;
+    LP_FUNCTIONS(LP_DECLARE)
+#undef LP_DECLARE
+};
+
+State* state = nullptr;
+Settings config;
+const WXL_VkRenderApi* renderApi = nullptr;
+void* registration = nullptr;
+CVar *enabled = nullptr, *strength = nullptr, *maxLamps = nullptr, *radius = nullptr, *floorVar = nullptr, *stock = nullptr,
+     *debug = nullptr, *info = nullptr;
+char lastInfo[300]{};
+bool ranThisWorld = false, lastOk = true;
+FrameFigures figures;
+GpuStats gpu;          // the latest completed frame's tile figures
+ULONGLONG infoTime = 0;
+std::vector<Lamp> lamps;
+std::vector<std::pair<float, uint32_t>> order;
+
+CVar* Var(const char* name, const char* help, const char* value, uint32_t flags = 1) {
+    if (auto* existing = CVar::LookupRegistered(name)) return existing;
+    return CVar::Register(name, help, flags, value, nullptr, CATEGORY_GRAPHICS, false, nullptr, false);
+}
+void Info(const char* value) {
+    if (info && std::strcmp(lastInfo, value)) {std::snprintf(lastInfo, sizeof lastInfo, "%s", value); info->Set(lastInfo, true, false, false, false);}
+}
+float Clamp(float v, float lo, float hi, float fallback) {return std::isfinite(v) ? std::clamp(v, lo, hi) : fallback;}
+
+void ReleaseSlots(State* s) {
+    for (auto& slot : s->slots) {
+        if (slot.lights) s->api->RetireBuffer(slot.lights, slot.serial);
+        if (slot.stats) s->api->RetireBuffer(slot.stats, slot.serial);
+        slot.lights = slot.stats = nullptr;
+    }
+}
+void Destroy(State* s) {
+    ReleaseSlots(s);
+    if (s->pool) s->DestroyDescriptorPool(s->device.device, s->pool, nullptr);
+    if (s->sampler) s->DestroySampler(s->device.device, s->sampler, nullptr);
+    if (s->pipeline) s->DestroyPipeline(s->device.device, s->pipeline, nullptr);
+    if (s->layout) s->DestroyPipelineLayout(s->device.device, s->layout, nullptr);
+    if (s->setLayout) s->DestroyDescriptorSetLayout(s->device.device, s->setLayout, nullptr);
+    delete s;
+}
+
+State* Create(const WXL_VkRenderApi* api) {
+    if (!api || api->apiVersion != WXL_VK_RENDER_API_VERSION || api->structSize < offsetof(WXL_VkRenderApi, RetireImage) + sizeof(api->RetireImage) ||
+        !api->GetDeviceInfo || !api->CreateBuffer || !api->RetireBuffer || !api->FlushBuffer) return nullptr;
+    auto* s = new(std::nothrow) State();
+    if (!s) return nullptr;
+    s->api = api; s->device.structSize = sizeof s->device;
+    if (!api->GetDeviceInfo(&s->device) || !s->device.device || !s->device.getDeviceProcAddr || !s->device.frameSlots ||
+        s->device.frameSlots > MaxSlots) {delete s; return nullptr;}
+#define LP_LOAD(n) s->n = reinterpret_cast<PFN_vk##n>(s->device.getDeviceProcAddr(s->device.device, "vk" #n)); if (!s->n) {delete s; return nullptr;}
+    LP_FUNCTIONS(LP_LOAD)
+#undef LP_LOAD
+    VkDescriptorSetLayoutBinding bindings[4]{};
+    const VkDescriptorType types[4] = {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+                                       VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER};
+    for (uint32_t i = 0; i < 4; ++i) {bindings[i].binding = i; bindings[i].descriptorCount = 1; bindings[i].descriptorType = types[i]; bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;}
+    VkDescriptorSetLayoutCreateInfo sl{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO}; sl.bindingCount = 4; sl.pBindings = bindings;
+    if (s->CreateDescriptorSetLayout(s->device.device, &sl, nullptr, &s->setLayout) != VK_SUCCESS) {s->error = "descriptor layout"; Destroy(s); return nullptr;}
+    VkPipelineLayoutCreateInfo pl{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO}; pl.setLayoutCount = 1; pl.pSetLayouts = &s->setLayout;
+    if (s->CreatePipelineLayout(s->device.device, &pl, nullptr, &s->layout) != VK_SUCCESS) {Destroy(s); return nullptr;}
+    VkShaderModuleCreateInfo sm{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO}; sm.codeSize = sizeof kHdVulkanLightPass; sm.pCode = kHdVulkanLightPass;
+    VkShaderModule module = VK_NULL_HANDLE;
+    if (s->CreateShaderModule(s->device.device, &sm, nullptr, &module) != VK_SUCCESS) {Destroy(s); return nullptr;}
+    VkComputePipelineCreateInfo cp{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+    cp.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO; cp.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+    cp.stage.module = module; cp.stage.pName = "main"; cp.layout = s->layout;
+    VkResult result = s->CreateComputePipelines(s->device.device, s->device.pipelineCache, 1, &cp, nullptr, &s->pipeline);
+    s->DestroyShaderModule(s->device.device, module, nullptr);
+    if (result != VK_SUCCESS) {Destroy(s); return nullptr;}
+    VkSamplerCreateInfo si{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO}; si.magFilter = si.minFilter = VK_FILTER_NEAREST; si.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    si.addressModeU = si.addressModeV = si.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    if (s->CreateSampler(s->device.device, &si, nullptr, &s->sampler) != VK_SUCCESS) {Destroy(s); return nullptr;}
+    const uint32_t n = s->device.frameSlots;
+    VkDescriptorPoolSize sizes[3] = {{VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, n}, {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, n}, {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 2 * n}};
+    VkDescriptorPoolCreateInfo pi{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO}; pi.maxSets = n; pi.poolSizeCount = 3; pi.pPoolSizes = sizes;
+    if (s->CreateDescriptorPool(s->device.device, &pi, nullptr, &s->pool) != VK_SUCCESS) {Destroy(s); return nullptr;}
+    std::array<VkDescriptorSetLayout, MaxSlots> layouts{}; layouts.fill(s->setLayout);
+    std::array<VkDescriptorSet, MaxSlots> sets{};
+    VkDescriptorSetAllocateInfo ai{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO}; ai.descriptorPool = s->pool; ai.descriptorSetCount = n; ai.pSetLayouts = layouts.data();
+    if (s->AllocateDescriptorSets(s->device.device, &ai, sets.data()) != VK_SUCCESS) {Destroy(s); return nullptr;}
+    // Per frame slot: the lamp list the CPU writes each frame (STREAM) and the tile figures the GPU writes back (HOST).
+    for (uint32_t i = 0; i < n; ++i) {
+        auto& slot = s->slots[i]; slot.set = sets[i];
+        WXL_VkBufferDesc lights{LightBytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, WXL_VK_MEMORY_STREAM};
+        WXL_VkBufferDesc stats{sizeof(GpuStats), VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, WXL_VK_MEMORY_HOST};
+        slot.lights = api->CreateBuffer(&lights, &slot.lightInfo);
+        slot.stats = api->CreateBuffer(&stats, &slot.statsInfo);
+        if (!slot.lights || !slot.stats || !slot.lightInfo.mapped || !slot.statsInfo.mapped) {Destroy(s); return nullptr;}
+        std::memset(slot.statsInfo.mapped, 0, sizeof(GpuStats)); api->FlushBuffer(slot.stats);
+    }
+    return s;
+}
+
+// World -> view, row vectors (WXL_VkSceneConstants::view): the eye's offset first, in double (world positions are large).
+void ToView(const float* v, const double eye[3], const float world[3], float out[3]) {
+    const double x = double(world[0]) - eye[0], y = double(world[1]) - eye[1], z = double(world[2]) - eye[2];
+    // the eye's own view position (eye * V + T) is 0 up to rounding; add it back so the result is exactly p * V
+    for (int k = 0; k < 3; ++k) {
+        const double e = eye[0] * v[k] + eye[1] * v[4 + k] + eye[2] * v[8 + k] + v[12 + k];
+        out[k] = float(x * v[k] + y * v[4 + k] + z * v[8 + k] + e);
+    }
+}
+void RotateToView(const float* v, const C3Vector& d, float out[3]) {
+    for (int k = 0; k < 3; ++k) out[k] = d.x * v[k] + d.y * v[4 + k] + d.z * v[8 + k];
+    const float len = std::sqrt(out[0] * out[0] + out[1] * out[1] + out[2] * out[2]);
+    if (len > 1e-6f) for (int k = 0; k < 3; ++k) out[k] /= len;
+}
+
+// The frame's lamps in view space, culled to the view frustum, nearest config.maxLamps kept. Fills `header`'s light rows.
+uint32_t BuildLamps(const WXL_VkStageContext& ctx, Header& header) {
+    const float* v = ctx.scene->view; const float* p = ctx.scene->projection;
+    const double eye[3] = {ctx.scene->cameraPos[0], ctx.scene->cameraPos[1], ctx.scene->cameraPos[2]};
+    const HD::FrameLamp* frame = nullptr;
+    const uint32_t count = World::s_m2Scene ? HD::LightsGather(World::s_m2Scene, C3Vector(float(eye[0]), float(eye[1]), float(eye[2])), &frame) : 0;
+    figures.gathered = count;
+    // The view frustum's side planes (D3D projection, row vectors: x_ndc = (p0 x + p8 z) / z), normals inward.
+    float planes[4][3] = {{p[0], 0, p[8] + 1}, {-p[0], 0, 1 - p[8]}, {0, p[5], p[9] + 1}, {0, -p[5], 1 - p[9]}};
+    for (auto& pl : planes) {const float len = std::sqrt(pl[0] * pl[0] + pl[1] * pl[1] + pl[2] * pl[2]); for (float& c : pl) c /= len > 0 ? len : 1;}
+    lamps.clear(); order.clear();
+    for (uint32_t i = 0; i < count && frame; ++i) {
+        const HD::FrameLamp& f = frame[i];
+        Lamp lamp{};
+        float r = f.radius * config.radius;
+        if (!(r > 0) || !std::isfinite(r)) continue;
+        ToView(v, eye, f.pos, lamp.posRadius);
+        const float* c = lamp.posRadius;
+        if (!std::isfinite(c[0]) || !std::isfinite(c[1]) || !std::isfinite(c[2]) || c[2] + r <= 0) continue;
+        bool outside = false;
+        for (auto& pl : planes) if (pl[0] * c[0] + pl[1] * c[1] + pl[2] * c[2] < -r) {outside = true; break;}
+        if (outside) continue;
+        lamp.posRadius[3] = r;
+        lamp.colorInvFade[0] = f.color[0]; lamp.colorInvFade[1] = f.color[1]; lamp.colorInvFade[2] = f.color[2];
+        lamp.colorInvFade[3] = 1.0f / std::max(f.fade * config.radius, 0.05f);
+        const float d = std::sqrt(c[0] * c[0] + c[1] * c[1] + c[2] * c[2]);
+        order.emplace_back(std::max(d - r, 0.0f), uint32_t(lamps.size()));
+        lamps.push_back(lamp);
+    }
+    figures.inView = uint32_t(lamps.size());
+    const uint32_t drawn = std::min<uint32_t>(figures.inView, config.maxLamps);
+    if (drawn < order.size()) std::nth_element(order.begin(), order.begin() + drawn, order.end());
+    auto* out = reinterpret_cast<Lamp*>(reinterpret_cast<uint8_t*>(&header) + sizeof(Header));
+    for (uint32_t i = 0; i < drawn; ++i) out[i] = lamps[order[i].second];
+    figures.drawn = drawn;
+
+    // The engine's sun (CMap::s_mapLight, set from DayNight each frame) for the estimate of the light already in the colour.
+    C3Vector ambient(.3f, .3f, .3f), diffuse(0, 0, 0), dir(0, 0, -1);
+    if (CMap::s_mapLight && CMap::s_mapLight->m_light.m_type != M2LIGHT_POINT) {
+        ambient = CMap::s_mapLight->m_light.m_ambColor; diffuse = CMap::s_mapLight->m_light.m_dirColor; dir = CMap::s_mapLight->m_light.m_dir;
+    }
+    header.ambient[0] = ambient.x; header.ambient[1] = ambient.y; header.ambient[2] = ambient.z; header.ambient[3] = config.floor;
+    header.diffuse[0] = diffuse.x; header.diffuse[1] = diffuse.y; header.diffuse[2] = diffuse.z; header.diffuse[3] = config.strength;
+    RotateToView(v, dir, header.sunDir);
+    return drawn;
+}
+
+bool Record(const WXL_VkStageContext& ctx) {
+    auto* s = state;
+    if (!s) return false;
+    if (ctx.structSize < sizeof ctx || !ctx.cmd || !ctx.colorView || !ctx.depthView || !ctx.serial || ctx.point != WXL_VK_POINT_AFTER_OPAQUE_WORLD ||
+        ctx.frameSlot >= s->device.frameSlots || ctx.frameSlots != s->device.frameSlots || ctx.colorFormat != VK_FORMAT_R8G8B8A8_UNORM ||
+        ctx.colorLayout != VK_IMAGE_LAYOUT_GENERAL || !ctx.extent.width || !ctx.extent.height ||
+        (ctx.depthLayout != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL && ctx.depthLayout != VK_IMAGE_LAYOUT_GENERAL &&
+         ctx.depthLayout != VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL)) {s->error = "Vulkan light pass: frame/depth/layout not ready"; return false;}
+    auto& slot = s->slots[ctx.frameSlot];
+    if (ctx.serial <= s->last || slot.serial > ctx.completedSerial) {s->error = "Vulkan light pass: duplicate/in-flight slot"; return false;}
+    HD::VulkanAO::Constants rows;
+    if (!HD::VulkanAO::BuildConstants(ctx, HD::VulkanAO::Settings{}, rows)) {s->error = "Vulkan light pass: needs forward-Z perspective depth"; return false;}
+    // The slot's previous frame has completed (checked above): its tile figures are final.
+    if (slot.statsPending) {std::memcpy(&gpu, slot.statsInfo.mapped, sizeof gpu); slot.statsPending = false;}
+    auto* header = static_cast<Header*>(slot.lightInfo.mapped);
+    std::memcpy(header->screen, rows.screen, 16); std::memcpy(header->view, rows.view, 16); std::memcpy(header->rect, rows.rect, 16);
+    std::memcpy(header->depth, rows.depth, 16); std::memcpy(header->full, rows.full, 16);
+    const uint32_t drawn = BuildLamps(ctx, *header);
+    header->counts[0] = drawn; header->counts[1] = config.debug; header->counts[2] = ctx.swapRB; header->counts[3] = 1;
+    const uint32_t groupsX = (ctx.extent.width + Tile - 1) / Tile, groupsY = (ctx.extent.height + Tile - 1) / Tile;
+    figures.tiles = groupsX * groupsY;
+    if (!drawn && config.debug != 2) {gpu = {}; s->error = ""; return true;} // nothing to light: the frame stays as it is, GPU cost 0
+    s->api->FlushBuffer(slot.lights);
+    std::memset(slot.statsInfo.mapped, 0, sizeof(GpuStats)); s->api->FlushBuffer(slot.stats);
+
+    VkDescriptorImageInfo images[2] = {{s->sampler, ctx.depthView, ctx.depthLayout}, {VK_NULL_HANDLE, ctx.colorView, ctx.colorLayout}};
+    VkDescriptorBufferInfo buffers[2] = {{slot.lightInfo.buffer, 0, sizeof(Header) + sizeof(Lamp) * std::max(drawn, 1u)}, {slot.statsInfo.buffer, 0, sizeof(GpuStats)}};
+    VkWriteDescriptorSet writes[4]{};
+    for (uint32_t i = 0; i < 4; ++i) {
+        auto& w = writes[i]; w.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET; w.dstSet = slot.set; w.dstBinding = i; w.descriptorCount = 1;
+        w.descriptorType = i == 0 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER : i == 1 ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        if (i < 2) w.pImageInfo = &images[i]; else w.pBufferInfo = &buffers[i - 2];
+    }
+    s->UpdateDescriptorSets(s->device.device, 4, writes, 0, nullptr);
+    VkMemoryBarrier barrier{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    barrier.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT; barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+    s->CmdPipelineBarrier(ctx.cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+    s->CmdBindPipeline(ctx.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s->pipeline);
+    s->CmdBindDescriptorSets(ctx.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s->layout, 0, 1, &slot.set, 0, nullptr);
+    s->CmdDispatch(ctx.cmd, groupsX, groupsY, 1);
+    barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_HOST_READ_BIT;
+    s->CmdPipelineBarrier(ctx.cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                          VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+    slot.serial = s->last = ctx.serial; slot.statsPending = true;
+    s->error = ""; return true;
+}
+
+void ShowInfo() {
+    const ULONGLONG now = GetTickCount64();
+    if (infoTime && now - infoTime < 500) return;
+    infoTime = now;
+    char text[300];
+    const float average = gpu.litTiles ? float(gpu.pairs) / float(gpu.litTiles) : 0.0f;
+    static const char* const debugNames[3] = {"", ", debug: lamp light only", ", debug: lamps per tile"};
+    // GPU time of the stage (its timestamps; -1 when the queue has none)
+    float gpuMs = -1;
+    if (renderApi && registration && renderApi->structSize >= offsetof(WXL_VkRenderApi, GetStageStats) + sizeof(renderApi->GetStageStats) &&
+        renderApi->GetStageStats) {
+        WXL_VkStageStats st{}; st.structSize = sizeof st;
+        if (renderApi->GetStageStats(registration, &st)) gpuMs = st.avgMs;
+    }
+    std::snprintf(text, sizeof text, "Vulkan light pass: %u lamps gathered, %u in view, %u drawn (max %u); %u tiles, %u lit, %.1f lamps/lit tile, max %u; "
+                  "GPU %.3f ms; stock lamps %s%s", figures.gathered, figures.inView, figures.drawn, config.maxLamps, figures.tiles, gpu.litTiles, average,
+                  gpu.maxPerTile, gpuMs, config.keepStock ? "kept (double)" : "replaced", debugNames[std::min(config.debug, 2u)]);
+    Info(text);
+}
+
+int __cdecl Wanted(void*) {return config.enabled ? 1 : 0;}
+void __cdecl Stage(void*, const WXL_VkStageContext* ctx) {
+    g_ownsPointLights = false; // from here on (liquids, late models) the engine lights with its own lamps again
+    ranThisWorld = true;
+    if (!ctx || !Record(*ctx)) {lastOk = false; Info(state ? state->error : "Vulkan light pass: not initialized"); return;}
+    lastOk = true;
+    ShowInfo();
+}
+}
+
+bool Init() {
+    if (registration) return true;
+    enabled = Var("hdLightPass", "HD (Vulkan): lamps, fires and M2 light emitters light the world per pixel, every lamp (no 4-light cap), 0 off / 1 on", "0");
+    strength = Var("hdLightPassStrength", "HD (Vulkan): light pass lamp strength 0..4 (1 = WoW Forever's falloff)", "1");
+    maxLamps = Var("hdLightPassMax", "HD (Vulkan): light pass lamps drawn per frame, nearest first (1..1024)", "256");
+    radius = Var("hdLightPassRadius", "HD (Vulkan): light pass lamp radius multiplier 0.25..4", "1");
+    floorVar = Var("hdLightPassFloor", "HD (Vulkan): light pass floor of the estimated engine light (0.005..1; lower = brighter lamps in dark places)", "0.03");
+    stock = Var("hdLightPassStock", "HD (Vulkan): 1 keeps the engine's per-vertex lamps as well (lights them twice, for comparison) / 0 replaces them", "0", 0);
+    debug = Var("hdLightPassDebug", "HD (Vulkan): light pass debug view, 0 off / 1 lamp light only / 2 lamps per tile", "0", 0);
+    info = Var("hdLightPassInfo", "HD (Vulkan): light pass status (read only)", "off", 0x80);
+    renderApi = wxl::ScriptMgr::GetInterface<const WXL_VkRenderApi>(WXL_VK_RENDER_API_NAME, WXL_VK_RENDER_API_VERSION);
+    if (!renderApi || renderApi->structSize < offsetof(WXL_VkRenderApi, UnregisterStage) + sizeof(renderApi->UnregisterStage) ||
+        !renderApi->RegisterStage || !renderApi->UnregisterStage || !(state = Create(renderApi))) {Info("Vulkan light pass: Init failed"); return false;}
+    WXL_VkStageDesc desc{}; desc.structSize = sizeof desc; desc.point = WXL_VK_POINT_AFTER_OPAQUE_WORLD;
+    desc.order = 150; // after AO (100): the lamp light is not darkened by the occlusion of the ambient twice over the clamp
+    desc.flags = WXL_VK_STAGE_NEEDS_DEPTH | WXL_VK_STAGE_WRITES_COLOR; desc.Wanted = Wanted; desc.Run = Stage;
+    registration = renderApi->RegisterStage(&desc, "HD.LightPass");
+    if (!registration) {Destroy(state); state = nullptr; Info("Vulkan light pass: stage registration failed"); return false;}
+    Info("off"); return true;
+}
+
+void Resize() {
+    g_ownsPointLights = false;
+    if (!registration) return;
+    config.enabled = enabled && enabled->m_intValue != 0;
+    config.strength = Clamp(strength ? strength->m_floatValue : 1, 0, 4, 1);
+    config.maxLamps = uint32_t(std::clamp(maxLamps ? maxLamps->m_intValue : 256, 1, int32_t(MaxLamps)));
+    config.radius = Clamp(radius ? radius->m_floatValue : 1, .25f, 4, 1);
+    config.floor = Clamp(floorVar ? floorVar->m_floatValue : .03f, .005f, 1, .03f);
+    config.keepStock = stock && stock->m_intValue != 0;
+    config.debug = debug ? uint32_t(std::clamp(debug->m_intValue, 0, 2)) : 0;
+    if (!config.enabled) {Info("off"); lastOk = true; return;}
+    // The engine's point lights are left out only while the pass is expected to run (it ran the last world): a pass that
+    // failed or did not fire gives the next frame back the engine's own lamps instead of none.
+    g_ownsPointLights = !config.keepStock && lastOk;
+    ranThisWorld = false;
+}
+
+void EndWorld() {
+    if (g_ownsPointLights || (config.enabled && !ranThisWorld)) lastOk = false; // the stage never ran inside this world
+    g_ownsPointLights = false;
+}
+
+bool Shutdown() {
+    g_ownsPointLights = false;
+    if (!renderApi && !registration) return true;
+    if (registration) {renderApi->UnregisterStage(registration); registration = nullptr;}
+    if (state) {
+        if (state->last > wxlvk::native::present::Completed()) {
+            if (wxlvk::native::present::FrameOpen() && !wxlvk::native::present::FlushAndWait()) return false;
+            if (!wxlvk::native::present::WaitSerial(state->last)) return false;
+        }
+        Destroy(state); state = nullptr;
+    }
+    renderApi = nullptr; config.enabled = false; Info("off");
+    return true;
+}
+}
diff --git a/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanLightPass.h b/Engine/Source/Gx/CGxDeviceVulkan/hd/HdVulkanLightPass.h
