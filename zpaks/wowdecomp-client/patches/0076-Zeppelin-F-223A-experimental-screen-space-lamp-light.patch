@@ -200,6 +200,35 @@ int32_t HD::LightsForSphere(CM2Scene* scene, const C3Vector& camera, const CAaSp
     return count;
 }
 
+// Zeppelin F-223A: the whole frame's lights, for the Vulkan light pass. Shares GatherFrame (and its per-frame cache)
+// with LightsForSphere, so both renderers see the same lamps.
+uint32_t HD::LightsGather(CM2Scene* scene, const C3Vector& camera, const FrameLamp** out) {
+    static std::vector<FrameLamp> s_lamps;
+    RegisterCVars();
+    s_lamps.clear();
+    if (out) *out = nullptr;
+    if (!scene) return 0;
+    if (scene != s_frameScene || scene->m_frameStamp != s_frameStamp) {
+        s_frameScene = scene;
+        s_frameStamp = scene->m_frameStamp;
+        GatherFrame(scene, camera);
+        ShowInfo(camera);
+    }
+    s_lamps.reserve(s_frame.size());
+    for (size_t i = 0; i < s_frame.size(); i++) {
+        const FrameLight& l = s_frame[i];
+        FrameLamp lamp;
+        lamp.pos[0] = l.pos.x;      lamp.pos[1] = l.pos.y;      lamp.pos[2] = l.pos.z;
+        lamp.color[0] = l.color.x;  lamp.color[1] = l.color.y;  lamp.color[2] = l.color.z;
+        lamp.strength = l.strength;
+        lamp.radius = l.radius;
+        lamp.fade = l.fade;
+        s_lamps.push_back(lamp);
+    }
+    if (out) *out = s_lamps.data();
+    return static_cast<uint32_t>(s_lamps.size());
+}
+
 void HD::LightsForget(const CM2Light* light) {
     s_known.erase(light);
 }
