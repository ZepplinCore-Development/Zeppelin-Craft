diff --git a/Extensions/HelloWorld/src/HelloWorldClient.cpp b/Extensions/HelloWorld/src/HelloWorldClient.cpp
new file mode 100644
index 0000000..53658ad
--- /dev/null
+++ b/Extensions/HelloWorld/src/HelloWorldClient.cpp
@@ -0,0 +1,49 @@
+#include "WoW/Source/Extension/ExtensionMgr.h"
+
+namespace {
+
+class HelloWorldClientScript : public ClientScript {
+    public:
+    HelloWorldClientScript() : ClientScript("HelloWorldClientScript") {}
+
+    void OnStartup() override {
+        sExtensionMgr->Log("HelloWorld: OnStartup");
+    }
+
+    void OnClientInitialized() override {
+        sExtensionMgr->Log("HelloWorld: OnClientInitialized");
+    }
+
+    void OnUpdate(float elapsedSec) override {
+        m_updates++;
+
+        if (m_updates == 1) {
+            sExtensionMgr->Log("HelloWorld: OnUpdate (first, %.4f s)", elapsedSec);
+        }
+    }
+
+    void OnClientDestroy() override {
+        sExtensionMgr->Log("HelloWorld: OnClientDestroy after %u update(s)", m_updates);
+    }
+
+    void OnEnterWorld(uint32_t mapId) override {
+        sExtensionMgr->Log("HelloWorld: OnEnterWorld (map %u)", mapId);
+    }
+
+    void OnLeaveWorld() override {
+        sExtensionMgr->Log("HelloWorld: OnLeaveWorld");
+    }
+
+    void OnShutdown() override {
+        sExtensionMgr->Log("HelloWorld: OnShutdown");
+    }
+
+    private:
+    uint32_t m_updates = 0;
+};
+
+}
+
+void AddHelloWorldClientScripts() {
+    new HelloWorldClientScript();
+}
diff --git a/Extensions/HelloWorld/src/HelloWorldLua.cpp b/Extensions/HelloWorld/src/HelloWorldLua.cpp
new file mode 100644
index 0000000..7ee4686
--- /dev/null
+++ b/Extensions/HelloWorld/src/HelloWorldLua.cpp
@@ -0,0 +1,43 @@
+#include "Engine/Source/FrameScript/FrameScript.h"
+#include "WoW/Source/Extension/ExtensionMgr.h"
+
+namespace {
+
+// The index of HELLO_WORLD_PING in the current FrameScript state's event array. It is renewed at
+// every OnFrameScriptInitialized, because every rebuild of the state gets a new array.
+uint32_t s_pingEventIndex = UINT32_MAX;
+uint32_t s_pingCount;
+
+// HelloWorld_Ping(): a global the extension adds to both Lua states. It signals HELLO_WORLD_PING
+// with the call count to every frame that registered for it, and returns the count. From the UI:
+//   /run local f = CreateFrame("Frame") f:RegisterEvent("HELLO_WORLD_PING") f:SetScript("OnEvent", function(_, e, n) print(e, n) end)
+//   /run print(HelloWorld_Ping())
+int32_t Script_HelloWorld_Ping(lua_State* L) {
+    s_pingCount++;
+
+    if (s_pingEventIndex != UINT32_MAX) {
+        FrameScript_SignalEvent(s_pingEventIndex, "%d", s_pingCount);
+    }
+
+    lua_pushnumber(L, s_pingCount);
+
+    return 1;
+}
+
+class HelloWorldLuaScript : public LuaScript {
+    public:
+    HelloWorldLuaScript() : LuaScript("HelloWorldLuaScript") {}
+
+    void OnFrameScriptInitialized(lua_State* L, FrameScriptContext context) override {
+        FrameScript_RegisterFunction("HelloWorld_Ping", Script_HelloWorld_Ping);
+        s_pingEventIndex = sExtensionMgr->DeclareFrameScriptEvent("HELLO_WORLD_PING");
+
+        sExtensionMgr->Log("HelloWorld: OnFrameScriptInitialized (%s state), HELLO_WORLD_PING is event %u", context == FRAMESCRIPT_CONTEXT_GLUE ? "glue" : "game", s_pingEventIndex);
+    }
+};
+
+}
+
+void AddHelloWorldLuaScripts() {
+    new HelloWorldLuaScript();
+}
diff --git a/Extensions/HelloWorld/src/HelloWorldNet.cpp b/Extensions/HelloWorld/src/HelloWorldNet.cpp
new file mode 100644
index 0000000..afe087f
--- /dev/null
+++ b/Extensions/HelloWorld/src/HelloWorldNet.cpp
@@ -0,0 +1,39 @@
+#include "Engine/Source/Base/CDataStore.h"
+#include "WoW/Source/Extension/ExtensionMgr.h"
+
+namespace {
+
+// Logs the first few messages in each direction with their opcode and payload size, then only
+// counts. The sizes read the stream's own fields; nothing is consumed from it.
+class HelloWorldNetScript : public NetScript {
+    public:
+    HelloWorldNetScript() : NetScript("HelloWorldNetScript") {}
+
+    void OnMessageReceived(NETMESSAGE msgId, uint32_t timeReceived, CDataStore& msg) override {
+        m_received++;
+
+        if (m_received <= 5) {
+            sExtensionMgr->Log("HelloWorld: OnMessageReceived opcode 0x%03X, %u payload byte(s), t=%u", msgId, msg.m_size - msg.m_read, timeReceived);
+        } else if (m_received % 500 == 0) {
+            sExtensionMgr->Log("HelloWorld: %u message(s) received, %u sent", m_received, m_sent);
+        }
+    }
+
+    void OnMessageSent(NETMESSAGE msgId, CDataStore& msg) override {
+        m_sent++;
+
+        if (m_sent <= 5) {
+            sExtensionMgr->Log("HelloWorld: OnMessageSent opcode 0x%03X, %u byte(s)", msgId, msg.m_size - msg.m_read);
+        }
+    }
+
+    private:
+    uint32_t m_received = 0;
+    uint32_t m_sent = 0;
+};
+
+}
+
+void AddHelloWorldNetScripts() {
+    new HelloWorldNetScript();
+}
diff --git a/Extensions/HelloWorld/src/HelloWorldRender.cpp b/Extensions/HelloWorld/src/HelloWorldRender.cpp
new file mode 100644
index 0000000..8135f11
--- /dev/null
+++ b/Extensions/HelloWorld/src/HelloWorldRender.cpp
@@ -0,0 +1,47 @@
+#include "WoW/Source/Extension/ExtensionMgr.h"
+
+namespace {
+
+// Logs the first call of each render hook and, every 1000 frames, the running counts, so the
+// relative frequencies (frames painted vs world renders) can be read off the log.
+class HelloWorldRenderScript : public RenderScript {
+    public:
+    HelloWorldRenderScript() : RenderScript("HelloWorldRenderScript") {}
+
+    void OnFrameBegin(float elapsedSec) override {
+        m_frames++;
+
+        if (m_frames == 1) {
+            sExtensionMgr->Log("HelloWorld: OnFrameBegin (first, %.4f s)", elapsedSec);
+        }
+    }
+
+    void OnWorldRendered() override {
+        m_worldRenders++;
+
+        if (m_worldRenders == 1) {
+            sExtensionMgr->Log("HelloWorld: OnWorldRendered (first)");
+        }
+    }
+
+    void OnFrameEnd() override {
+        m_frameEnds++;
+
+        if (m_frameEnds == 1) {
+            sExtensionMgr->Log("HelloWorld: OnFrameEnd (first)");
+        } else if (m_frameEnds % 1000 == 0) {
+            sExtensionMgr->Log("HelloWorld: %u frame(s) begun, %u ended, %u world render(s)", m_frames, m_frameEnds, m_worldRenders);
+        }
+    }
+
+    private:
+    uint32_t m_frames = 0;
+    uint32_t m_frameEnds = 0;
+    uint32_t m_worldRenders = 0;
+};
+
+}
+
+void AddHelloWorldRenderScripts() {
+    new HelloWorldRenderScript();
+}
