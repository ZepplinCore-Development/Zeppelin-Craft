diff --git a/WoW/Source/Extension/ScriptDefines/WorldScript.h b/WoW/Source/Extension/ScriptDefines/WorldScript.h
new file mode 100644
index 0000000..d9a485d
--- /dev/null
+++ b/WoW/Source/Extension/ScriptDefines/WorldScript.h
@@ -0,0 +1,33 @@
+#ifndef WOW_SOURCE_EXTENSION_SCRIPTDEFINES_WORLDSCRIPT_H
+#define WOW_SOURCE_EXTENSION_SCRIPTDEFINES_WORLDSCRIPT_H
+
+#include <cstdint>
+#include "WoW/Source/Extension/ScriptObject.h"
+
+// The world scene: map boundaries and the world tick. Map hooks fire from
+// WoW/Source/WorldClient/World.cpp, the tick from WoW/Source/Ui/WorldFrame.cpp. These are map
+// boundaries as opposed to ClientScript::OnEnterWorld/OnLeaveWorld, which are session boundaries:
+// a server transfer (SMSG_NEW_WORLD) unloads and loads a map without leaving the game.
+class WorldScript : public ScriptObject {
+    protected:
+    explicit WorldScript(const char* name);
+
+    public:
+    // End of CWorld::LoadMap(): the map (CMap::Load), its area of interest, the liquid material
+    // settings and the clip planes are set up. mapId is the Map.dbc id, mapName its directory
+    // name (Map.dbc m_directory). Fires on world entry and on every map transfer.
+    virtual void OnMapLoaded(uint32_t mapId, const char* mapName) {}
+
+    // World::UnloadMap(), before CMap::Unload(): the fade-out list is already cleared, the map and
+    // its objects are still loaded. Fires only when a map was active (the call from a session that
+    // never loaded one does not reach it).
+    virtual void OnMapUnload() {}
+
+    // End of CGWorldFrame::OnWorldUpdate(): the camera, the active mover, the visible objects,
+    // CWorld::Update (area of interest, day/night, fog) and the sound listener are updated for
+    // this frame and the world is about to be rendered. elapsedSec is the world frame's time.
+    // Fires only while the world frame is active (in the world, not in the glue).
+    virtual void OnWorldUpdate(float elapsedSec) {}
+};
+
+#endif
diff --git a/WoW/Source/Extension/ScriptObject.h b/WoW/Source/Extension/ScriptObject.h
new file mode 100644
index 0000000..23e0f16
--- /dev/null
+++ b/WoW/Source/Extension/ScriptObject.h
@@ -0,0 +1,33 @@
+#ifndef WOW_SOURCE_EXTENSION_SCRIPTOBJECT_H
+#define WOW_SOURCE_EXTENSION_SCRIPTOBJECT_H
+
+#include <cstdint>
+
+// Base of every script an extension can register. A script is a plain object with one virtual per
+// hook: an extension derives from one of the script types under ScriptDefines/ (ClientScript,
+// WorldScript, RenderScript, NetScript, LuaScript), overrides the hooks it needs and instantiates it
+// with new from its Add<Name>Extension() entry point. The script type's constructor adds the
+// instance to ScriptRegistry<T>, which owns it from then on and deletes it in ExtensionMgr::Unload().
+//
+// Hooks are called on the main thread, in registration order (the order the generated loader called
+// the extensions in, which is the sorted directory order, then the order of the new expressions
+// inside an entry point).
+//
+// Only hooks that the client actually fires are declared. A planned hook is listed in
+// docs/extensions.md until its call site exists, so an override can never compile and then
+// silently do nothing.
+class ScriptObject {
+    friend class ExtensionMgr;
+
+    public:
+    const char* GetName() const { return m_name; }
+
+    protected:
+    explicit ScriptObject(const char* name) : m_name(name) {}
+    virtual ~ScriptObject() = default;
+
+    private:
+    const char* m_name;
+};
+
+#endif
