@@ -0,0 +1,52 @@
+#include "WoW/Source/Extension/ScriptDefines/ClientScript.h"
+#include "Engine/Source/Event/Event.h"
+#include "WoW/Source/Extension/ExtensionMgr.h"
+#include "WoW/Source/Extension/ExtensionMgrMacros.h"
+
+// The core's EVENT_ID_UPDATE handler. One handler for all scripts: the client registers it at the
+// end of InitializeClient (after its own FrameTime update handler, so FrameTime is current when the
+// scripts run) and unregisters it at the start of WowClientDestroy. Returning 1 lets the remaining
+// handlers of the event run.
+static int32_t OnUpdateHandler(const void* data, void* param) {
+    const EVENT_DATA_UPDATE* update = static_cast<const EVENT_DATA_UPDATE*>(data);
+    sExtensionMgr->OnUpdate(update->m_elapsedSec);
+
+    return 1;
+}
+
+void ExtensionMgr::OnStartup() {
+    CALL_HOOKS(ClientScript, script->OnStartup());
+}
+
+void ExtensionMgr::OnClientInitialized() {
+    EventRegister(EVENT_ID_UPDATE, OnUpdateHandler);
+
+    CALL_HOOKS(ClientScript, script->OnClientInitialized());
+}
+
+void ExtensionMgr::OnUpdate(float elapsedSec) {
+    CALL_HOOKS(ClientScript, script->OnUpdate(elapsedSec));
+}
+
+void ExtensionMgr::OnClientDestroy() {
+    EventUnregister(EVENT_ID_UPDATE, OnUpdateHandler);
+
+    CALL_HOOKS(ClientScript, script->OnClientDestroy());
+}
+
+void ExtensionMgr::OnEnterWorld(uint32_t mapId) {
+    CALL_HOOKS(ClientScript, script->OnEnterWorld(mapId));
+}
+
+void ExtensionMgr::OnLeaveWorld() {
+    CALL_HOOKS(ClientScript, script->OnLeaveWorld());
+}
+
+void ExtensionMgr::OnShutdown() {
+    CALL_HOOKS(ClientScript, script->OnShutdown());
+}
+
+ClientScript::ClientScript(const char* name) : ScriptObject(name) {
+    ScriptRegistry<ClientScript>::AddScript(this);
+    sExtensionMgr->Log("Extensions: registered ClientScript %s", name);
+}
diff --git a/WoW/Source/Extension/ScriptDefines/ClientScript.h b/WoW/Source/Extension/ScriptDefines/ClientScript.h
new file mode 100644
index 0000000..23a1151
--- /dev/null
+++ b/WoW/Source/Extension/ScriptDefines/ClientScript.h
@@ -0,0 +1,52 @@
+#ifndef WOW_SOURCE_EXTENSION_SCRIPTDEFINES_CLIENTSCRIPT_H
+#define WOW_SOURCE_EXTENSION_SCRIPTDEFINES_CLIENTSCRIPT_H
+
+#include <cstdint>
+#include "WoW/Source/Extension/ScriptObject.h"
+
+// The process lifecycle: engine services, client systems, the game session and the per-frame tick.
+// Every hook is fired from WoW/Source/Client.cpp except OnUpdate, which the core fans out from an
+// EVENT_ID_UPDATE handler it registers itself.
+class ClientScript : public ScriptObject {
+    protected:
+    explicit ClientScript(const char* name);
+
+    public:
+    // End of InitializeGlobal(): Config.wtf and the CVars are loaded, console commands can be
+    // registered, the event system, the window and the Gx device exist. No client system is up yet
+    // (no FrameScript, no world, no glue screen). Register CVars and console commands here.
+    virtual void OnStartup() {}
+
+    // End of InitializeClient(), inside the event context's initialize callback: FrameScript, the
+    // world, shadows, lighting, input and the glue manager exist and the first glue screen is set.
+    // The message loop has not run a frame yet. This is where the core registers its per-frame
+    // update handler, so OnUpdate starts after this hook.
+    virtual void OnClientInitialized() {}
+
+    // Every message-loop iteration, from an EVENT_ID_UPDATE handler the core registered at the end
+    // of InitializeClient(). It runs after FrameTime::Update (the client's own update handler was
+    // registered first and handlers of one event run in registration order), so FrameTime is
+    // current. elapsedSec is the frame time the event scheduler measured. Fires in the glue screens
+    // as well as in the world; use WorldScript::OnWorldUpdate for world-only work.
+    virtual void OnUpdate(float elapsedSec) {}
+
+    // Start of WowClientDestroy(), inside the event context's destroy callback: the game session
+    // is already gone (ClientDestroyGame ran), the glue, FrameScript state, world and client
+    // services still exist. Mirror of OnClientInitialized; OnUpdate stops before this hook.
+    virtual void OnClientDestroy() {}
+
+    // End of ClientInitializeGame(): the player entered the world, the object manager, the game UI
+    // and the map are loaded, s_gameInitialized is set. mapId is the Map.dbc id being played.
+    virtual void OnEnterWorld(uint32_t mapId) {}
+
+    // Start of ClientDestroyGame(), after its s_gameInitialized check: the player is leaving the
+    // world (logout, character select, disconnect). Everything game-side is still valid.
+    virtual void OnLeaveWorld() {}
+
+    // Start of BeginCloseGame(): the message loop has ended, the event context and the client are
+    // destroyed, the engine is about to go away. CVars, console commands and the event system
+    // still exist, so state can be saved.
+    virtual void OnShutdown() {}
+};
+
+#endif
diff --git a/WoW/Source/Extension/ScriptDefines/LuaScript.cpp b/WoW/Source/Extension/ScriptDefines/LuaScript.cpp
new file mode 100644
index 0000000..a2d1340
--- /dev/null
+++ b/WoW/Source/Extension/ScriptDefines/LuaScript.cpp
@@ -0,0 +1,56 @@
+#include "WoW/Source/Extension/ScriptDefines/LuaScript.h"
+#include <vector>
+#include "Engine/Source/FrameScript/FrameScript.h"
+#include "Engine/Source/Storm/H/storm.h"
+#include "WoW/Source/Extension/ExtensionMgr.h"
+#include "WoW/Source/Extension/ExtensionMgrMacros.h"
+
+// The event array under construction, valid only while OnFrameScriptInitialized runs: the engine's
+// names first (their indices are the engine's enum values and must not move), the declared names
+// after them. The pointers are the callers' string literals, which outlive the array.
+static std::vector<const char*> s_eventNames;
+static bool s_declaring;
+
+uint32_t ExtensionMgr::DeclareFrameScriptEvent(const char* name) {
+    if (!s_declaring || !name) {
+        Log("Extensions: DeclareFrameScriptEvent(%s) outside LuaScript::OnFrameScriptInitialized, ignored", name ? name : "null");
+        return UINT32_MAX;
+    }
+
+    // FrameScript_CreateEvents maps equal names to one event object, so two indices for the same
+    // name would both work; one index per name keeps FrameScript_SignalEvent callers consistent.
+    for (uint32_t i = 0; i < s_eventNames.size(); i++) {
+        if (s_eventNames[i] && !SStrCmpI(s_eventNames[i], name, STORM_MAX_STR)) {
+            return i;
+        }
+    }
+
+    s_eventNames.push_back(name);
+
+    return static_cast<uint32_t>(s_eventNames.size() - 1);
+}
+
+void ExtensionMgr::OnFrameScriptInitialized(FrameScriptContext context, const char** names, uint32_t count) {
+    s_eventNames.assign(names, names + count);
+    s_declaring = true;
+
+    lua_State* L = FrameScript_GetContext();
+    CALL_HOOKS(LuaScript, script->OnFrameScriptInitialized(L, context));
+
+    s_declaring = false;
+
+    // One call for the engine's events and the declared ones: the array is replaced wholesale,
+    // so the two sets have to arrive together.
+    FrameScript_CreateEvents(s_eventNames.data(), static_cast<uint32_t>(s_eventNames.size()));
+
+    if (s_eventNames.size() > count) {
+        Log("Extensions: %u FrameScript event(s) declared in the %s state", static_cast<uint32_t>(s_eventNames.size() - count), context == FRAMESCRIPT_CONTEXT_GLUE ? "glue" : "game");
+    }
+
+    s_eventNames.clear();
+}
+
+LuaScript::LuaScript(const char* name) : ScriptObject(name) {
+    ScriptRegistry<LuaScript>::AddScript(this);
+    sExtensionMgr->Log("Extensions: registered LuaScript %s", name);
+}
diff --git a/WoW/Source/Extension/ScriptDefines/LuaScript.h b/WoW/Source/Extension/ScriptDefines/LuaScript.h
new file mode 100644
index 0000000..3c2c550
--- /dev/null
+++ b/WoW/Source/Extension/ScriptDefines/LuaScript.h
@@ -0,0 +1,42 @@
+#ifndef WOW_SOURCE_EXTENSION_SCRIPTDEFINES_LUASCRIPT_H
+#define WOW_SOURCE_EXTENSION_SCRIPTDEFINES_LUASCRIPT_H
+
+#include <cstdint>
+#include "WoW/Source/Extension/ScriptObject.h"
+
+struct lua_State;
+
+// Which FrameScript state is being set up. The glue (login, realm list, character screens) and the
+// game UI run in different Lua states with different function tables and event arrays.
+enum FrameScriptContext {
+    FRAMESCRIPT_CONTEXT_GLUE = 0,
+    FRAMESCRIPT_CONTEXT_GAME = 1,
+};
+
+// The FrameScript (Lua) state. The client destroys and recreates its Lua state several times:
+// CGlueMgr::Resume rebuilds the glue state every time the glue comes up (first start, every return
+// from the game, glue reload), CGGameUI::InitializeFrameXML rebuilds the game state on every world
+// entry and on /reloadui. Each rebuild starts from an empty state, so everything a script
+// registered in the previous state is gone: functions, tables, references and event indices.
+// OnFrameScriptInitialized therefore fires at every rebuild and a script must redo its whole
+// registration in it, every time.
+//
+// Events are addressed by index into one array that FrameScript_CreateEvents replaces wholesale.
+// A script never calls FrameScript_CreateEvents itself (that would discard the engine's events);
+// it declares its event names through ExtensionMgr::DeclareFrameScriptEvent inside this hook, and
+// the core creates the engine's names and the declared names together in the one call.
+class LuaScript : public ScriptObject {
+    protected:
+    explicit LuaScript(const char* name);
+
+    public:
+    // The state L is created and the engine's own function table for this context is registered
+    // (CGlueMgr::Resume after CGVideoOptions::RegisterScriptFunctions, CGGameUI::InitializeFrameXML
+    // after LoadScriptFunctions). The event array has not been created yet: this is the only place
+    // ExtensionMgr::DeclareFrameScriptEvent may be called. Register functions with
+    // FrameScript_RegisterFunction (they run as engine code, untainted) and build Lua tables with
+    // the lua_* API on L. No FrameXML or addon file has been loaded yet in this state.
+    virtual void OnFrameScriptInitialized(lua_State* L, FrameScriptContext context) {}
+};
+
+#endif
diff --git a/WoW/Source/Extension/ScriptDefines/NetScript.cpp b/WoW/Source/Extension/ScriptDefines/NetScript.cpp
new file mode 100644
index 0000000..264ea44
--- /dev/null
+++ b/WoW/Source/Extension/ScriptDefines/NetScript.cpp
@@ -0,0 +1,42 @@
+#include "WoW/Source/Extension/ScriptDefines/NetScript.h"
+#include "Engine/Source/Base/CDataStore.h"
+#include "WoW/Source/Extension/ExtensionMgr.h"
+#include "WoW/Source/Extension/ExtensionMgrMacros.h"
+
+void ExtensionMgr::OnMessageReceived(NETMESSAGE msgId, uint32_t timeReceived, CDataStore* msg) {
+    if (ScriptRegistry<NetScript>::ScriptPointerList.empty()) {
+        return;
+    }
+
+    // The cursor is at the payload. Each script gets it there, and the handler the client
+    // dispatches to afterwards gets it there too, whatever the scripts read.
+    uint32_t read = msg->m_read;
+
+    CALL_HOOKS(NetScript, (msg->m_read = read, script->OnMessageReceived(msgId, timeReceived, *msg)));
+
+    msg->m_read = read;
+}
+
+void ExtensionMgr::OnMessageSent(CDataStore* msg) {
+    if (ScriptRegistry<NetScript>::ScriptPointerList.empty()) {
+        return;
+    }
+
+    // Outgoing messages start with the opcode as a 32-bit value (every sender does
+    // msg.Put(static_cast<uint32_t>(CMSG_...))); the connection serialises it from the cursor.
+    uint32_t read = msg->m_read;
+    uint32_t opcode = 0;
+
+    if (msg->m_size - read >= sizeof(opcode)) {
+        msg->Get(opcode);
+    }
+
+    CALL_HOOKS(NetScript, (msg->m_read = read, script->OnMessageSent(static_cast<NETMESSAGE>(opcode), *msg)));
+
+    msg->m_read = read;
+}
+
+NetScript::NetScript(const char* name) : ScriptObject(name) {
+    ScriptRegistry<NetScript>::AddScript(this);
+    sExtensionMgr->Log("Extensions: registered NetScript %s", name);
+}
diff --git a/WoW/Source/Extension/ScriptDefines/NetScript.h b/WoW/Source/Extension/ScriptDefines/NetScript.h
new file mode 100644
index 0000000..f8c8aeb
--- /dev/null
+++ b/WoW/Source/Extension/ScriptDefines/NetScript.h
@@ -0,0 +1,34 @@
+#ifndef WOW_SOURCE_EXTENSION_SCRIPTDEFINES_NETSCRIPT_H
+#define WOW_SOURCE_EXTENSION_SCRIPTDEFINES_NETSCRIPT_H
+
+#include <cstdint>
+#include "WoW/Source/Extension/ScriptObject.h"
+#include "WoW/Source/Net/Types.h"
+
+class CDataStore;
+
+// The world-server connection, at the two points every message passes through
+// (WoW/Source/Net/NetClient/NetClient.cpp). Both hooks observe: they cannot drop or rewrite a
+// message, and the core restores the stream's read cursor after the hooks so the engine's own
+// handler sees the message exactly as if no script had looked at it. A script may therefore read
+// from msg freely with CDataStore::Get. Do not keep a pointer to msg past the hook.
+class NetScript : public ScriptObject {
+    protected:
+    explicit NetScript(const char* name);
+
+    public:
+    // NetClient::ProcessMessage, after the 16-bit opcode is read and before the message is
+    // dispatched to the handler registered for it (or dropped if there is none). The read cursor
+    // is at the payload, where a handler starts reading. Fires for every message of a connected
+    // session, including opcodes nothing handles; msgId may be outside NETMESSAGE if the server
+    // sent one. timeReceived is the receive timestamp the connection stamped the packet with.
+    virtual void OnMessageReceived(NETMESSAGE msgId, uint32_t timeReceived, CDataStore& msg) {}
+
+    // NetClient::Send, right before the message goes to the connection's SendPacket. The read
+    // cursor is at the 32-bit opcode (what the connection serialises); msgId is that opcode. Fires
+    // once per message actually handed to the connection: messages held while the client is
+    // suspended (realm redirect) fire when the held queue is flushed, not when they were queued.
+    virtual void OnMessageSent(NETMESSAGE msgId, CDataStore& msg) {}
+};
+
+#endif
