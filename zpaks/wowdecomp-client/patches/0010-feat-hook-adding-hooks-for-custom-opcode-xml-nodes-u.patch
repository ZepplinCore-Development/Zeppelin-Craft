diff --git a/Extensions/HelloWorld/src/HelloWorld.cpp b/Extensions/HelloWorld/src/HelloWorld.cpp
index 545ae1b..1aa6f55 100644
--- a/Extensions/HelloWorld/src/HelloWorld.cpp
+++ b/Extensions/HelloWorld/src/HelloWorld.cpp
@@ -1,8 +1,9 @@
 // HelloWorld: the smallest possible extension. It registers one script of every type and logs the
 // hooks it receives, so the discovery -> registration -> dispatch chain of each context can be
-// checked end to end in Logs\Extensions.log. It is the template for a real extension; it does
-// nothing else on purpose. Per-frame and per-object hooks log their first calls and counts
-// afterwards, never every call.
+// checked end to end in Logs\Extensions.log, and it uses each registration API once (a Lua
+// function and event, a message handler and a send, an XML element type). It is the template for
+// a real extension; it does nothing else on purpose. Per-frame and per-object hooks log their
+// first calls and counts afterwards, never every call.
 
 void AddHelloWorldAssetScripts();
 void AddHelloWorldClientDBScripts();
@@ -15,11 +16,13 @@ void AddHelloWorldObjectScripts();
 void AddHelloWorldRenderScripts();
 void AddHelloWorldTerrainScripts();
 void AddHelloWorldTextureScripts();
+void AddHelloWorldUIScripts();
+void AddHelloWorldUnitScripts();
 void AddHelloWorldWorldScripts();
 
 // The entry point the generated loader calls: Add<DirectoryName>Extension(). Instantiate every
 // script of the extension from here; a script registers itself in its constructor and the registry
-// owns it from then on.
+// owns it from then on. Registrations (functions, events, handlers, element types) go here too.
 void AddHelloWorldExtension() {
     AddHelloWorldAssetScripts();
     AddHelloWorldClientDBScripts();
@@ -32,5 +35,7 @@ void AddHelloWorldExtension() {
     AddHelloWorldRenderScripts();
     AddHelloWorldTerrainScripts();
     AddHelloWorldTextureScripts();
+    AddHelloWorldUIScripts();
+    AddHelloWorldUnitScripts();
     AddHelloWorldWorldScripts();
 }
diff --git a/Extensions/HelloWorld/src/HelloWorldLua.cpp b/Extensions/HelloWorld/src/HelloWorldLua.cpp
index 6fd8d58..a66aa87 100644
--- a/Extensions/HelloWorld/src/HelloWorldLua.cpp
+++ b/Extensions/HelloWorld/src/HelloWorldLua.cpp
@@ -3,20 +3,21 @@
 
 namespace {
 
-// The index of HELLO_WORLD_PING in the current FrameScript state's event array. It is renewed at
-// every OnFrameScriptInitialized, because every rebuild of the state gets a new array.
-uint32_t s_pingEventIndex = UINT32_MAX;
 uint32_t s_pingCount;
 
-// HelloWorld_Ping(): a global the extension adds to both Lua states. It signals HELLO_WORLD_PING
-// with the call count to every frame that registered for it, and returns the count. From the UI:
+// HelloWorld_Ping(): a global in both Lua states, registered once through the registration API
+// and re-registered by the core into every state. It signals HELLO_WORLD_PING with the call
+// count to every frame that registered for it, and returns the count. From the UI:
 //   /run local f = CreateFrame("Frame") f:RegisterEvent("HELLO_WORLD_PING") f:SetScript("OnEvent", function(_, e, n) print(e, n) end)
 //   /run print(HelloWorld_Ping())
 int32_t Script_HelloWorld_Ping(lua_State* L) {
     s_pingCount++;
 
-    if (s_pingEventIndex != UINT32_MAX) {
-        FrameScript_SignalEvent(s_pingEventIndex, "%d", s_pingCount);
+    // The event's index belongs to the current state; the core knows the array it built for it.
+    uint32_t index = sExtensionMgr->GetFrameScriptEventIndex("HELLO_WORLD_PING");
+
+    if (index != UINT32_MAX) {
+        FrameScript_SignalEvent(index, "%d", s_pingCount);
     }
 
     lua_pushnumber(L, s_pingCount);
@@ -24,20 +25,25 @@ int32_t Script_HelloWorld_Ping(lua_State* L) {
     return 1;
 }
 
+// Observes the state lifecycle; the registrations above need no hook. Shows the per-hook
+// declaration path too: HELLO_WORLD_STATE is declared here, inside the hook, and gets an index
+// in the same array as the registered event.
 class HelloWorldLuaScript : public LuaScript {
     public:
     HelloWorldLuaScript() : LuaScript("HelloWorldLuaScript") {}
 
     void OnFrameScriptInitialized(lua_State* L, FrameScriptContext context) override {
-        FrameScript_RegisterFunction("HelloWorld_Ping", Script_HelloWorld_Ping);
-        s_pingEventIndex = sExtensionMgr->DeclareFrameScriptEvent("HELLO_WORLD_PING");
+        uint32_t stateEvent = sExtensionMgr->DeclareFrameScriptEvent("HELLO_WORLD_STATE");
+
+        // The registered function is already a global when the hook runs.
+        lua_getglobal(L, "HelloWorld_Ping");
+        const char* pingState = lua_isfunction(L, -1) ? "registered" : "missing";
+        lua_pop(L, 1);
 
-        sExtensionMgr->Log("HelloWorld: OnFrameScriptInitialized (%s state), HELLO_WORLD_PING is event %u", context == FRAMESCRIPT_CONTEXT_GLUE ? "glue" : "game", s_pingEventIndex);
+        sExtensionMgr->Log("HelloWorld: OnFrameScriptInitialized (%s state), HELLO_WORLD_STATE is event %u, HelloWorld_Ping is %s", context == FRAMESCRIPT_CONTEXT_GLUE ? "glue" : "game", stateEvent, pingState);
     }
 
-    // The event index dies with the state; forget it so a ping between states signals nothing.
     void OnFrameScriptDestroy(lua_State* L) override {
-        s_pingEventIndex = UINT32_MAX;
         sExtensionMgr->Log("HelloWorld: OnFrameScriptDestroy after %u ping(s)", s_pingCount);
     }
 };
@@ -45,5 +51,7 @@ class HelloWorldLuaScript : public LuaScript {
 }
 
 void AddHelloWorldLuaScripts() {
+    sExtensionMgr->RegisterLuaFunction("HelloWorld_Ping", Script_HelloWorld_Ping);
+    sExtensionMgr->RegisterFrameScriptEvent("HELLO_WORLD_PING");
     new HelloWorldLuaScript();
 }
diff --git a/Extensions/HelloWorld/src/HelloWorldNet.cpp b/Extensions/HelloWorld/src/HelloWorldNet.cpp
index f353a8b..aed5723 100644
--- a/Extensions/HelloWorld/src/HelloWorldNet.cpp
+++ b/Extensions/HelloWorld/src/HelloWorldNet.cpp
@@ -1,8 +1,50 @@
 #include "Engine/Source/Base/CDataStore.h"
+#include "Engine/Source/lua-5.1/src/lua.h"
 #include "WoW/Source/Extension/ExtensionMgr.h"
 
 namespace {
 
+// Two opcodes outside the stock protocol (NUM_MSG_TYPES is 0x51F): the server-to-client one the
+// extension handles, the client-to-server one it sends. A server has to implement both for the
+// round trip to happen; the stock server ignores or refuses them.
+const uint32_t SMSG_HELLO_WORLD = 0x5F0;
+const uint32_t CMSG_HELLO_WORLD = 0x5F1;
+
+uint32_t s_hellosSent;
+
+// The handler for SMSG_HELLO_WORLD: a uint32 counter followed by a string. Same shape as a stock
+// handler; the cursor is at the payload.
+int32_t HandleHelloWorld(void* param, NETMESSAGE msgId, uint32_t time, CDataStore* msg) {
+    uint32_t counter = 0;
+    char text[256] = "";
+    msg->Get(counter);
+    msg->GetString(text, sizeof(text));
+    sExtensionMgr->Log("HelloWorld: SMSG_HELLO_WORLD #%u \"%s\" (t=%u)", counter, text, time);
+
+    return 1;
+}
+
+// HelloWorld_SendHello([text]): sends CMSG_HELLO_WORLD with a counter and the text, returns the
+// counter, or nil when there is no connection. Registered in the game state only.
+int32_t Script_HelloWorld_SendHello(lua_State* L) {
+    const char* text = lua_tolstring(L, 1, nullptr);
+    CDataStore payload;
+    payload.Put(++s_hellosSent);
+    payload.PutString(text ? text : "hello");
+    payload.Finalize();
+
+    if (!sExtensionMgr->SendClientMessage(CMSG_HELLO_WORLD, payload)) {
+        s_hellosSent--;
+        lua_pushnil(L);
+        return 1;
+    }
+
+    sExtensionMgr->Log("HelloWorld: CMSG_HELLO_WORLD #%u sent", s_hellosSent);
+    lua_pushnumber(L, s_hellosSent);
+
+    return 1;
+}
+
 // Logs the first few messages in each direction with their opcode and payload size, then only
 // counts. The sizes read the stream's own fields; nothing is consumed from it.
 class HelloWorldNetScript : public NetScript {
@@ -48,5 +90,7 @@ class HelloWorldNetScript : public NetScript {
 }
 
 void AddHelloWorldNetScripts() {
+    sExtensionMgr->RegisterMessageHandler(SMSG_HELLO_WORLD, HandleHelloWorld, nullptr);
+    sExtensionMgr->RegisterLuaFunction("HelloWorld_SendHello", Script_HelloWorld_SendHello, FRAMESCRIPT_CONTEXTS_GAME);
     new HelloWorldNetScript();
 }
diff --git a/Extensions/HelloWorld/src/HelloWorldUI.cpp b/Extensions/HelloWorld/src/HelloWorldUI.cpp
new file mode 100644
index 0000000..a0b4c5d
--- /dev/null
+++ b/Extensions/HelloWorld/src/HelloWorldUI.cpp
@@ -0,0 +1,97 @@
+#include <new>
+#include <typeinfo>
+#include "Engine/Source/Base/CDataAllocator.h"
+#include "Engine/Source/Base/Status.h"
+#include "Engine/Source/Frame/CSimpleFrame.h"
+#include "Engine/Source/FrameScript/FrameScript_Object.h"
+#include "Engine/Source/FrameXML/XMLTree.h"
+#include "Engine/Source/Storm/H/storm.h"
+#include "WoW/Source/Extension/ExtensionMgr.h"
+
+namespace {
+
+// A new UI element type, <HelloWorldFrame>, usable from XML and from CreateFrame("HelloWorldFrame").
+// It is a Frame with one extra attribute, greeting="...", and its own object type so Lua's
+// GetObjectType() / IsObjectType("HelloWorldFrame") recognise it. It inherits the Frame script
+// methods (no metatable of its own). Frames are destroyed through the virtual destructor and the
+// static operator delete of their class, so the type owns its allocator like CGCooldown does.
+class CHelloWorldFrame : public CSimpleFrame {
+    public:
+    static CDataAllocator s_allocator;
+    static int32_t s_objectType;
+    static const char* s_objectTypeName;
+
+    static void operator delete(void* ptr) {
+        if (ptr) {
+            CHelloWorldFrame::s_allocator.PutData(ptr, nullptr, 0);
+        }
+    }
+
+    static CSimpleFrame* Create(CSimpleFrame* parent) {
+        void* data = CHelloWorldFrame::s_allocator.GetData(0, typeid(CHelloWorldFrame).raw_name(), SLOG_OBJECT);
+        return data ? new (data) CHelloWorldFrame(parent) : nullptr;
+    }
+
+    static int32_t GetObjectType() {
+        if (!CHelloWorldFrame::s_objectType) {
+            CHelloWorldFrame::s_objectType = ++FrameScript_Object::s_objectTypes;
+        }
+
+        return CHelloWorldFrame::s_objectType;
+    }
+
+    explicit CHelloWorldFrame(CSimpleFrame* parent) : CSimpleFrame(parent) {}
+
+    bool IsA(int32_t type) override {
+        return type == CHelloWorldFrame::GetObjectType() || CSimpleFrame::IsA(type);
+    }
+
+    bool IsA(const char* typeName) override {
+        return !SStrCmpI(typeName, CHelloWorldFrame::s_objectTypeName, STORM_MAX_STR) || CSimpleFrame::IsA(typeName);
+    }
+
+    const char* GetObjectTypeName() override {
+        return CHelloWorldFrame::s_objectTypeName;
+    }
+
+    // The Frame attributes and children first, then the type's own attribute.
+    void LoadXML(XMLNode* node, CStatus* status) override {
+        CSimpleFrame::LoadXML(node, status);
+
+        const char* greeting = node->GetAttributeByName("greeting");
+        const char* name = node->GetAttributeByName("name");
+        sExtensionMgr->Log("HelloWorld: <HelloWorldFrame> %s created, greeting=\"%s\"", name && *name ? name : "(unnamed)", greeting ? greeting : "");
+    }
+};
+
+CDataAllocator CHelloWorldFrame::s_allocator(sizeof(CHelloWorldFrame), 16);
+int32_t CHelloWorldFrame::s_objectType;
+const char* CHelloWorldFrame::s_objectTypeName = "HelloWorldFrame";
+
+// Counts every frame the UI builds and reports element types nothing knows.
+class HelloWorldUIScript : public UIScript {
+    public:
+    HelloWorldUIScript() : UIScript("HelloWorldUIScript") {}
+
+    void OnFrameCreated(CSimpleFrame& frame, XMLNode& node) override {
+        m_created++;
+
+        if (m_created <= 3 || m_created % 1000 == 0) {
+            sExtensionMgr->Log("HelloWorld: OnFrameCreated <%s> (%u frame(s) so far)", node.m_name.m_str, m_created);
+        }
+    }
+
+    void OnUnknownFrameType(const char* name, XMLNode& node) override {
+        sExtensionMgr->Log("HelloWorld: OnUnknownFrameType <%s>", name);
+    }
+
+    private:
+    uint32_t m_created = 0;
+};
+
+}
+
+void AddHelloWorldUIScripts() {
+    sExtensionMgr->RegisterXmlElement("HelloWorldFrame", CHelloWorldFrame::Create);
+    new HelloWorldUIScript();
+}
diff --git a/Extensions/HelloWorld/src/HelloWorldUnit.cpp b/Extensions/HelloWorld/src/HelloWorldUnit.cpp
new file mode 100644
index 0000000..861a09b
--- /dev/null
+++ b/Extensions/HelloWorld/src/HelloWorldUnit.cpp
@@ -0,0 +1,59 @@
+#include "WoW/Source/Extension/ExtensionMgr.h"
+#include "WoW/Source/Object/ObjectClient/Unit_C.h"
+#include "WoW/Source/ObjectMgrClient/ObjectMgrClient.h"
+
+namespace {
+
+// Logs the local player's unit events (auras, display rebuilds, death) and counts the rest.
+class HelloWorldUnitScript : public UnitScript {
+    public:
+    HelloWorldUnitScript() : UnitScript("HelloWorldUnitScript") {}
+
+    void OnUnitMoveUpdate(CGUnit_C& unit, uint32_t time) override {
+        m_moves++;
+
+        if (m_moves == 1) {
+            sExtensionMgr->Log("HelloWorld: OnUnitMoveUpdate (first, t=%u)", time);
+        }
+    }
+
+    void OnUnitDisplayInfoUpdated(CGUnit_C& unit) override {
+        m_displays++;
+
+        if (IsLocalPlayer(unit)) {
+            sExtensionMgr->Log("HelloWorld: OnUnitDisplayInfoUpdated (local player, %u rebuild(s) in total)", m_displays);
+        }
+    }
+
+    void OnUnitDeath(CGUnit_C& unit) override {
+        m_deaths++;
+        sExtensionMgr->Log("HelloWorld: OnUnitDeath (%s, %u death(s))", IsLocalPlayer(unit) ? "local player" : "unit", m_deaths);
+    }
+
+    void OnUnitAuraAdded(CGUnit_C& unit, uint32_t index, AuraData& aura, int32_t spellId) override {
+        if (IsLocalPlayer(unit)) {
+            sExtensionMgr->Log("HelloWorld: OnUnitAuraAdded slot %u spell %d", index, spellId);
+        }
+    }
+
+    void OnUnitAuraRemoved(CGUnit_C& unit, uint32_t index, AuraData& aura, int32_t spellId) override {
+        if (IsLocalPlayer(unit)) {
+            sExtensionMgr->Log("HelloWorld: OnUnitAuraRemoved slot %u spell %d", index, spellId);
+        }
+    }
+
+    private:
+    static bool IsLocalPlayer(CGUnit_C& unit) {
+        return unit.m_obj->m_guid == ClntObjMgrGetActivePlayer();
+    }
+
+    uint32_t m_moves = 0;
+    uint32_t m_displays = 0;
+    uint32_t m_deaths = 0;
+};
+
+}
+
+void AddHelloWorldUnitScripts() {
+    new HelloWorldUnitScript();
+}
