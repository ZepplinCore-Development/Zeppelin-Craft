From 97e0288459f14f3b2e32ccbf053e7cbaf82736f6 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Fri, 16 Oct 2026 10:43:25 +0000
Subject: [PATCH] Zeppelin F-223: mingw/clang portability fixes

- CDataStoreCache::DetachBuffer decl param 'size' shadowed the template param (definition already uses size_)
- BSNEncodeInterface: const_cast before reinterpret_cast to adapter fn pointers (MSVC allowed casting away const)
---
 Engine/Source/Base/CDataStore.h               |  2 +-
 .../Battlenet/BSN/BSNEncodeInterface.cpp      | 60 +++++++++----------
 2 files changed, 31 insertions(+), 31 deletions(-)

diff --git a/Engine/Source/Base/CDataStore.h b/Engine/Source/Base/CDataStore.h
index 178ec06..fe5d00e 100644
--- a/Engine/Source/Base/CDataStore.h
+++ b/Engine/Source/Base/CDataStore.h
@@ -67,7 +67,7 @@ class CDataStoreCache : public CDataStore {
     void InternalDestroy(uint8_t*& data, uint32_t& base, uint32_t& alloc) override;
     int32_t InternalFetchWrite(uint32_t pos, uint32_t bytes, uint8_t*& data, uint32_t& base, uint32_t& alloc, const char* fileName, int32_t lineNumber) override;
     ~CDataStoreCache() override;
-    void DetachBuffer(void** data, uint32_t* size, uint32_t* alloc) override;
+    void DetachBuffer(void** data, uint32_t* size_, uint32_t* alloc) override;
 
     CDataStoreCache();
 };
diff --git a/WoW/Source/Battlenet/BSN/BSNEncodeInterface.cpp b/WoW/Source/Battlenet/BSN/BSNEncodeInterface.cpp
index 1fc28e3..b1a82d8 100644
--- a/WoW/Source/Battlenet/BSN/BSNEncodeInterface.cpp
+++ b/WoW/Source/Battlenet/BSN/BSNEncodeInterface.cpp
@@ -111,7 +111,7 @@ uint32_t BSN::BSNPrimitiveEncoder::GetFourCC(const EncodeContext* context) const
     }
 
     BSN::Protocol::Meta::FourCC meta(context->m_protocol, context->m_typeId);
-    return reinterpret_cast<AdapterGetFourCC>(meta.m_codeInfo[0])(context->m_data);
+    return reinterpret_cast<AdapterGetFourCC>(const_cast<void*>(meta.m_codeInfo[0]))(context->m_data);
 }
 
