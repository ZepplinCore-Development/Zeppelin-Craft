{
  "$schema": "../../schemas/zpak.schema.json",
  "name": "zepcraft-legacy",
  "version": "1.0.0",
  "description": "Legacy custom SQL and DBC files pending reorganization into feature zpaks",
  "author": "Zeppelin Team",
  "type": "native",
  "client_patch": "PATCH-Z",
  "patch_display_name": "Zepcraft",
  "launcher": {
    "mandatory": true,
    "enabled_by_default": true,
    "auto_update": true,
    "requires": []
  },
  "feature_id": "F-044",
  "build": {
    "preprocessors": ["model-transforms", "item-dbc-sync", "dbc-export"]
  },
  "contents": {
    "sql": [
      "sql/**/*.sql"
    ],
    "dbc": [
      "dbc/*.sql"
    ],
    "mpq": [
      "mpq/**/*"
    ]
  },
  "enabled": true,
  "priority": 999,
  "disabled_features": [
    "F-049"
  ]
}
