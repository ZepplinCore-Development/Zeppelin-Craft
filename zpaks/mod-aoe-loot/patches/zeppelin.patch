-                ItemTemplate const* proto = sObjectMgr->GetItemTemplate(item.itemid);
-                if (!proto || (proto->MaxCount > 0 && static_cast<int32>(player->GetItemCount(item.itemid)) >= proto->MaxCount))
-                    continue;
