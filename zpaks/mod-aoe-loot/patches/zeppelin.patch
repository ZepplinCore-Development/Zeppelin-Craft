+bool AOELootServer::CanPacketSend(WorldSession* session, WorldPacket const& packet)
+{
+    // Auto-greed group loot rolls when the player is the only member of their group
+    if (packet.GetOpcode() != SMSG_LOOT_START_ROLL)
+        return true;
+
+    if (!session)
+        return true;
+
+    Player* player = session->GetPlayer();
+    if (!player)
+        return true;
+
+    if (!sConfigMgr->GetOption<bool>("AOELoot.Enable", true) || !sConfigMgr->GetOption<bool>("AOELoot.AutoGreedSolo", true))
+        return true;
+
+    Group* group = player->GetGroup();
+    if (!group || group->GetMembersCount() > 1)
+        return true;
+
+    WorldPacket packetCopy(packet);
+    ObjectGuid rollGuid;
+    packetCopy >> rollGuid;
+
+    // The roll is registered after this packet is sent - cast the greed vote on the
+    // next update tick
+    ObjectGuid playerGuid = player->GetGUID();
+    ObjectGuid groupGuid = group->GetGUID();
+    player->m_Events.AddEventAtOffset([playerGuid, groupGuid, rollGuid]()
+    {
+        Player* rollPlayer = ObjectAccessor::FindPlayer(playerGuid);
+        if (!rollPlayer)
+            return;
+
+        Group* rollGroup = rollPlayer->GetGroup();
+        if (!rollGroup || rollGroup->GetGUID() != groupGuid || rollGroup->GetMembersCount() > 1)
+            return;
+
+        rollGroup->CountRollVote(playerGuid, rollGuid, ROLL_GREED);
+    }, 1ms);
+
+    return true;
+}
