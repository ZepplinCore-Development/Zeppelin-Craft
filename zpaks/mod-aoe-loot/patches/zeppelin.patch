+        lootListToBags(loot, loot->GetPlayerFFAItems());
+        lootListToBags(loot, loot->GetPlayerNonQuestNonFFAConditionalItems());
 
+        // Plain items go into the merged loot window while it has space
         for (size_t i = 0; i < loot->items.size(); ++i)
         {
+            if ((mainLoot->items.size() + itemsToAdd.size() + mainLoot->quest_items.size()) >= MAX_LOOT_ITEMS)
+                break;
+
             LootItem& item = loot->items[i];
 
             if (item.is_looted || item.freeforall || !item.conditions.empty() ||
@@ -220,30 +271,10 @@ bool AOELootServer::CanPacketReceive(WorldSession* session, WorldPacket const& p
                 !item.AllowedForPlayer(player, loot->sourceWorldObjectGUID))
                 continue;
 
