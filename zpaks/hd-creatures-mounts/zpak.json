{
  "$schema": "../../schemas/zpak.schema.json",
  "name": "hd-creatures-mounts",
  "version": "0.1.0",
  "description": "HD creature and mount model replacements (Nexus mod 891). Trial alternative to the creature portion of hd-everything.",
  "author": "Nexusmods (mod 891)",
  "type": "mpq",
  "client_patch": "PATCH-R",
  "patch_display_name": "HD Creatures & Mounts",
  "build": {
    "preprocessor": "resource-parser",
    "preprocessor_optional": true,
    "preprocessor_warning": "Resource Parser scans models for texture dependencies."
  },
  "source": {
    "type": "nexusmods",
    "url": "https://www.nexusmods.com/worldofwarcraft/mods/891"
  },
  "feature_id": "F-049",
  "launcher": {
    "mandatory": false,
    "enabled_by_default": false,
    "auto_update": false,
    "requires": []
  },
  "contents": {
    "mpq": [
      "mpq/**/*"
    ],
    "sql": [
      "sql/*.sql"
    ]
  },
  "enabled": true,
  "priority": 100
}
