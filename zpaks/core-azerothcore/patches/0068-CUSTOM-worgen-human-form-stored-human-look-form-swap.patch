+// CUSTOM (F-236): worgen human form - see Player.h (ZEP_LOOK_SIZE)
+void Player::SaveZepFormLook(ObjectGuid::LowType lowGuid, uint8 const (&look)[ZEP_LOOK_SIZE], CharacterDatabaseTransaction trans)
+{
+    for (uint8 i = 0; i < ZEP_LOOK_SIZE; ++i)
+    {
+        CharacterDatabasePreparedStatement* stmt = CharacterDatabase.GetPreparedStatement(CHAR_REP_CHARACTER_CUSTOMIZATION);
+        stmt->SetData(0, lowGuid);
+        stmt->SetData(1, uint8(ZEP_FORM_CUSTOMIZATION + i));
+        stmt->SetData(2, look[i]);
+        CharacterDatabase.ExecuteOrAppend(trans, stmt);
+    }
+}
+
+bool Player::HasZepCharSection(uint8 race, uint8 gender, uint8 section, uint8 variation, uint8 color)
+{
+    for (uint32 i = 0; i < sCharSectionsStore.GetNumRows(); ++i)
+    {
+        CharSectionsEntry const* entry = sCharSectionsStore.LookupEntry(i);
+        if (entry && entry->RaceID == race && entry->SexID == gender && entry->BaseSection == section
+            && entry->VariationIndex == variation && entry->ColorIndex == color)
+            return true;
+    }
+
+    return false;
+}
+
+// Choices the human CharSections do not have fall back to 0 (skin 0, face 0, hair style 0 colour 0); slot values are
+// 4-bit and jewellery 7-bit (bit 31 of OBJECT_FIELD_PADDING is the form bit)
+void Player::ValidateZepHumanLook(uint8 gender, uint8 (&look)[ZEP_LOOK_SIZE])
+{
+    if (!HasZepCharSection(RACE_HUMAN, gender, SECTION_TYPE_SKIN, 0, look[0]))
+        look[0] = 0;
+    if (!HasZepCharSection(RACE_HUMAN, gender, SECTION_TYPE_FACE, look[1], look[0]))
+        look[1] = 0;
+    if (!HasZepCharSection(RACE_HUMAN, gender, SECTION_TYPE_HAIR, look[2], look[3]))
+        look[2] = look[3] = 0;
+
+    look[9] &= 0x7F;
+    for (uint8 i = 10; i < ZEP_LOOK_SIZE; ++i)
+        look[i] &= 0x0F;
+}
+
+void Player::CaptureZepLook(uint8 (&look)[ZEP_LOOK_SIZE]) const
+{
+    for (uint8 i = 0; i < 4; ++i)
+        look[i] = GetByteValue(PLAYER_BYTES, i);
+    look[4] = GetByteValue(PLAYER_BYTES_2, 0);
+    for (uint8 i = 0; i < 4; ++i)
+        look[5 + i] = GetByteValue(UNIT_FIELD_PADDING, i);
+
+    uint32 pad = GetUInt32Value(OBJECT_FIELD_PADDING);
+    look[9] = uint8((pad >> 24) & 0x7F);
+    for (uint8 s = 0; s < 6; ++s)
+        look[10 + s] = uint8((pad >> (4 * s)) & 0x0F);
+}
+
+// All in one update tick, so a viewer gets the form bit and the look in the same values update
+void Player::WriteZepLook(uint8 const (&look)[ZEP_LOOK_SIZE], bool altered)
+{
+    for (uint8 i = 0; i < 4; ++i)
+        SetByteValue(PLAYER_BYTES, i, look[i]);
+    SetByteValue(PLAYER_BYTES_2, 0, look[4]);
+    for (uint8 i = 0; i < 4; ++i)
+        SetByteValue(UNIT_FIELD_PADDING, i, look[5 + i]);
+
+    uint32 pad = uint32(look[9] & 0x7F) << 24;
+    for (uint8 s = 0; s < 6; ++s)
+        pad |= uint32(look[10 + s] & 0x0F) << (4 * s);
+    if (altered)
+        pad |= ZEP_FORM_PADDING_BIT;
+    SetUInt32Value(OBJECT_FIELD_PADDING, pad);
+}
+
+void Player::SetZepAlteredForm(bool on)
+{
+    if (on == _zepAltered)
+        return;
+
+    if (on)
+    {
+        if (getRace(true) != RACE_WORGEN)
+            return;
+
+        CaptureZepLook(_zepNativeLook);
+        _zepAltered = true;
+        WriteZepLook(_zepHumanLook, true);
+    }
+    else
+    {
+        _zepAltered = false;
+        WriteZepLook(_zepNativeLook, false);
+    }
+}
+
+uint8 Player::GetNativeLookByte(uint8 index) const
+{
+    if (index >= ZEP_LOOK_SIZE)
+        return 0;
+
+    if (_zepAltered)
+        return _zepNativeLook[index];
+
+    uint8 look[ZEP_LOOK_SIZE];
+    CaptureZepLook(look);
+    return look[index];
+}
+
+void Player::ApplyZepBarberLook(uint8 hairStyle, uint8 hairColor, uint8 facialHair, int16 skin, uint8 const* extra)
+{
+    uint8 look[ZEP_LOOK_SIZE];
+    CaptureZepLook(look);
+    look[2] = hairStyle;
+    look[3] = hairColor;
+    look[4] = facialHair;
+    if (skin >= 0)
+        look[0] = uint8(skin);
+    if (extra)
+    {
+        for (uint8 i = 5; i < ZEP_LOOK_SIZE; ++i)
+            look[i] = extra[i - 5];
+        look[9] &= 0x7F;
+        for (uint8 i = 10; i < ZEP_LOOK_SIZE; ++i)
+            look[i] &= 0x0F;
+    }
+
+    WriteZepLook(look, _zepAltered);
+
+    if (_zepAltered)
+    {
+        for (uint8 i = 0; i < ZEP_LOOK_SIZE; ++i)
+            _zepHumanLook[i] = look[i];
+        SaveZepFormLook(GetGUID().GetCounter(), _zepHumanLook, nullptr);
+        return;
+    }
+
+    if (!extra)
+        return;
+
+    // native form: eye / markings (customization 1-4), jewellery (5) and geoset slots (10-15) - the F-230 barber slots
+    CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+    for (uint8 i = 0; i < 4; ++i)
+    {
+        CharacterDatabasePreparedStatement* stmt = CharacterDatabase.GetPreparedStatement(CHAR_REP_CHARACTER_CUSTOMIZATION);
+        stmt->SetData(0, GetGUID().GetCounter());
+        stmt->SetData(1, uint8(1 + i));
+        stmt->SetData(2, look[5 + i]);
+        trans->Append(stmt);
+    }
+
+    CharacterDatabasePreparedStatement* stmt = CharacterDatabase.GetPreparedStatement(CHAR_DEL_CHARACTER_ZEP_GEOSETS);
+    stmt->SetData(0, GetGUID().GetCounter());
+    trans->Append(stmt);
+
+    uint8 zep[7];
+    zep[0] = look[9];
+    for (uint8 s = 0; s < 6; ++s)
+        zep[1 + s] = look[10 + s];
+    SaveZepCustomizations(GetGUID().GetCounter(), zep, trans);
+    CharacterDatabase.CommitTransaction(trans);
 }
 
