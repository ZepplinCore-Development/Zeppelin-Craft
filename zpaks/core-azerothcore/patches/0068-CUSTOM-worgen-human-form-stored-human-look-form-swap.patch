+// CUSTOM (F-236): optional ZEPF block after ZEPO in CMSG_CHAR_CREATE / CMSG_ALTER_APPEARANCE: uint32 'ZEPF', uint8 form,
+// uint8 n, n bytes = a look in the Player::ZEP_LOOK_SIZE layout (bytes beyond 16 skipped, missing ones 0).
+// Create: form 1 = the worgen's human form look. Barber: the form showing (0 native, 1 human); look bytes 5-15 apply.
+static void ReadZepFormBlock(WorldPacket& recvData, bool& hasForm, uint8& form, uint8 (&look)[Player::ZEP_LOOK_SIZE])
+{
+    if (recvData.rpos() + 6 > recvData.size())
+        return;
+
+    if (recvData.read<uint32>() != 0x4650455A)
+    {
+        recvData.rpos(recvData.rpos() - 4);
+        return;
+    }
+
+    form = recvData.read<uint8>();
+    uint8 n = recvData.read<uint8>();
+    for (uint8 k = 0; k < n && recvData.rpos() < recvData.size(); ++k)
+    {
+        uint8 b = recvData.read<uint8>();
+        if (k < Player::ZEP_LOOK_SIZE)
+            look[k] = b;
+    }
+
+    hasForm = true;
+}
