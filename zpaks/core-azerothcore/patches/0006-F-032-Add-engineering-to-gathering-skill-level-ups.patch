From fdb24b9e79da913cf9a350c76fb7471af18ae660 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Fri, 30 Jan 2026 11:51:51 +0000
Subject: [PATCH] F-032: Add engineering to gathering skill level ups

Engineering now gains skill points using the gathering skill system,
alongside herbalism, jewelcrafting, and inscription.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/server/game/Entities/Player/PlayerUpdates.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/server/game/Entities/Player/PlayerUpdates.cpp b/src/server/game/Entities/Player/PlayerUpdates.cpp
index cb487c784..f696d2d72 100644
--- a/src/server/game/Entities/Player/PlayerUpdates.cpp
+++ b/src/server/game/Entities/Player/PlayerUpdates.cpp
@@ -786,6 +786,7 @@ bool Player::UpdateGatherSkill(uint32 SkillId, uint32 SkillValue,
                         specialLockingBusiness);
         break;
     case SKILL_HERBALISM:
+    case SKILL_ENGINEERING:
     case SKILL_JEWELCRAFTING:
     case SKILL_INSCRIPTION:
         return UpdateSkillPro(SkillId,
