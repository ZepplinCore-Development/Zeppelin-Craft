From 04d863012792eba040f9f621627dd7c2522f7c54 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Thu, 25 Jun 2026 08:06:26 +0000
Subject: [PATCH] feat(Core/Spells): Stat-scaled damage via MiscValueB (F-188)

Any SCHOOL_DAMAGE effect with MiscValueB != 0 adds caster stat * coeff
to the hit (coeff = MiscValueB / 100); MiscValue selects the stat
(enum ZepStatScalingStat: block value, AP, armor, spell power, the five
base stats, max health). Folded into EffectSchoolDMG, guarded by
MiscValueB which is unused by every stock SCHOOL_DAMAGE/periodic effect
(verified) -> zero regression, no new effect type, no DBC bulk update.
Generalizes to periodic ticks the same way when needed.

First consumer: Rockslam block-value scaling (retires spell_sha_rockslam,
F-189). The DoT "MiscValue collision" was illusory: the periodic tick
reads school from SpellInfo, never the effect MiscValue (vestigial data).

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015qmedFMHJQaq91UUAWKWL2
---
 src/server/game/Spells/SpellEffects.cpp | 26 +++++++++++++++++++++++++
 src/server/shared/SharedDefines.h       | 20 +++++++++++++++++++
 2 files changed, 46 insertions(+)

diff --git a/src/server/game/Spells/SpellEffects.cpp b/src/server/game/Spells/SpellEffects.cpp
index 70865a75d..2143edf08 100644
--- a/src/server/game/Spells/SpellEffects.cpp
+++ b/src/server/game/Spells/SpellEffects.cpp
@@ -674,6 +674,32 @@ void Spell::EffectSchoolDMG(SpellEffIndex effIndex)
                 }
         }
 
+        // F-188/F-189: stat scaling. When MiscValueB (the coeff slot) is set, add caster
+        // stat * coeff; MiscValue picks the stat (ZepStatScalingStat). MiscValueB is unused
+        // by stock SCHOOL_DAMAGE, so this never fires on existing spells. Scales as part of
+        // the hit (crit, +damage% auras, resist all apply), replacing one-off scripts.
+        // Only a unit caster has stats; a GameObject caster (#27627) skips the scaling.
+        int32 const statCoeff = m_spellInfo->Effects[effIndex].MiscValueB;
+        if (statCoeff && unitCaster)
+        {
+            float statVal = 0.0f;
+            switch (m_spellInfo->Effects[effIndex].MiscValue)
+            {
+                case ZEP_STAT_BLOCK_VALUE:  statVal = float(unitCaster->GetShieldBlockValue()); break;
+                case ZEP_STAT_ARMOR:        statVal = float(unitCaster->GetArmor()); break;
+                case ZEP_STAT_ATTACK_POWER: statVal = unitCaster->GetTotalAttackPowerValue(BASE_ATTACK); break;
+                case ZEP_STAT_SPELL_POWER:  statVal = float(unitCaster->SpellBaseDamageBonusDone(m_spellInfo->GetSchoolMask())); break;
+                case ZEP_STAT_STRENGTH:     statVal = unitCaster->GetStat(STAT_STRENGTH); break;
+                case ZEP_STAT_AGILITY:      statVal = unitCaster->GetStat(STAT_AGILITY); break;
+                case ZEP_STAT_STAMINA:      statVal = unitCaster->GetStat(STAT_STAMINA); break;
+                case ZEP_STAT_INTELLECT:    statVal = unitCaster->GetStat(STAT_INTELLECT); break;
+                case ZEP_STAT_SPIRIT:       statVal = unitCaster->GetStat(STAT_SPIRIT); break;
+                case ZEP_STAT_MAX_HEALTH:   statVal = float(unitCaster->GetMaxHealth()); break;
+                default: break;
+            }
+            damage += int32(statVal * (statCoeff / 100.0f));
+        }
+
         if (m_originalCaster /*&& damage > 0 Xinef: this can be increased from 0*/ && apply_direct_bonus)
         {
             // Xinef: protection
diff --git a/src/server/shared/SharedDefines.h b/src/server/shared/SharedDefines.h
index 988621405..47fb4a9b5 100644
--- a/src/server/shared/SharedDefines.h
+++ b/src/server/shared/SharedDefines.h
@@ -947,6 +947,26 @@ enum SpellEffects
     TOTAL_SPELL_EFFECTS                             = 165
 };
 
+// F-188/F-189: stat selector for stat-scaled damage. Any damage/heal effect with
+// MiscValueB != 0 scales on this stat at coeff = MiscValueB / 100 (no new effect type;
+// MiscValueB is unused by stock SCHOOL_DAMAGE / periodic auras, so it's the enable flag).
+// A curated index — the stats span several core enums with overlapping values (Stats,
+// BaseModGroup::SHIELD_BLOCK_VALUE, UnitMods) plus spell power (no enum), so this unifies
+// them; each entry delegates to the matching core getter.
+enum ZepStatScalingStat
+{
+    ZEP_STAT_BLOCK_VALUE   = 1,
+    ZEP_STAT_ARMOR         = 2,
+    ZEP_STAT_ATTACK_POWER  = 3,
+    ZEP_STAT_SPELL_POWER   = 4,
+    ZEP_STAT_STRENGTH      = 5,
+    ZEP_STAT_AGILITY       = 6,
+    ZEP_STAT_STAMINA       = 7,
+    ZEP_STAT_INTELLECT     = 8,
+    ZEP_STAT_SPIRIT        = 9,
+    ZEP_STAT_MAX_HEALTH    = 10
+};
+
 // EnumUtils: DESCRIBE THIS
 enum SpellCastResult : uint8
 {
