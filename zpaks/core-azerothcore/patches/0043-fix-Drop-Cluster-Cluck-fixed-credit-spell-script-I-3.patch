From 1990a6d340434f5e218be15d68ee681959c57c08 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Thu, 6 Aug 2026 13:31:04 +0000
Subject: [PATCH] fix: Drop Cluster Cluck fixed-credit spell script (I-318)

spell_zep_fixed_credit<38117> credited the caster on ANY effect hit, so
71170's dummy paid out when the item self-cast with nothing targeted, and
a genuine capture paid twice - the Wild Clucker's own SmartAI (38111
SPELLHIT 71170 -> actionlist 3811100) already grants the credit.

Registration and the now-unused NPC_CLUSTER_CLUCK_CREDIT /
SPELL_REMOTE_CONTROL_FIREWORKS enums removed. The binding is already gone
from spell_script_names, so this is a tidy-up, not a behaviour change.
Same defect and fix as I-281 (Monkey Business bananas).

Closes I-318

Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/server/scripts/Custom/zeppelin_goblin_start.cpp | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/server/scripts/Custom/zeppelin_goblin_start.cpp b/src/server/scripts/Custom/zeppelin_goblin_start.cpp
index 331ca8bb9..d8f41db47 100644
--- a/src/server/scripts/Custom/zeppelin_goblin_start.cpp
+++ b/src/server/scripts/Custom/zeppelin_goblin_start.cpp
@@ -22,13 +22,11 @@
 enum ZepGoblinCredits
 {
     // fixed kill-credit NPCs (invisible quest triggers)
-    NPC_CLUSTER_CLUCK_CREDIT     = 38117, // q24671
     NPC_ZOMBIES_BOOSTER_CREDIT   = 38807, // q24942
 
     SPELL_WEED_WHACKER            = 68211, // DUMMY
     SPELL_WEED_WHACKER_AURA       = 68212, // whirlwind state, periodic 68213 mow pulse
     SPELL_KTC_SNAPFLASH           = 68280, // DUMMY (photograph target -> credit that entry)
-    SPELL_REMOTE_CONTROL_FIREWORKS = 71170, // DUMMY
     SPELL_SUPER_BOOSTER_ROCKET_BOOTS = 72891 // SCRIPT_EFFECT
 };
 
@@ -258,8 +256,13 @@ void AddSC_zeppelin_goblin_start()
     // q14019 Monkey Business has no C++ script: the credit is granted by the fed
     // monkey's own SmartAI (34699 SPELLHIT 67917 -> actionlist 3469900), which
     // also roots, explodes and despawns it. See zz_[I-281]_monkey_business_feed.sql.
+    // q24671 Cluster Cluck likewise has no C++ script (I-318). The generic
+    // fixed-credit script paid the caster on ANY effect hit, so 71170's dummy
+    // banked a credit even when the item self-cast with nothing targeted, and
+    // a real capture paid twice. Credit belongs to the Wild Clucker's own
+    // SmartAI (38111 SPELLHIT 71170 -> actionlist 3811100), which also clears
+    // the spellclick flag and flies the bird off.
     RegisterSpellScript(spell_zep_q14236_weed_whacker);
-    RegisterSpellScriptWithArgs(spell_zep_fixed_credit<NPC_CLUSTER_CLUCK_CREDIT>, "spell_zep_q24671_cluster_cluck");
     RegisterSpellScriptWithArgs(spell_zep_fixed_credit<NPC_ZOMBIES_BOOSTER_CREDIT>, "spell_zep_q24942_zombies_booster");
     RegisterSpellScript(spell_zep_q14031_ktc_snapflash);
     RegisterSpellScript(spell_zep_q28414_footbomb_goal);
-- 
2.34.1

