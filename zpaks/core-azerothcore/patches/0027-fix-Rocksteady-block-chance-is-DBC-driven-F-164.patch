From 83b7f651f331b1b1f4843c69992a78e430a32552 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sat, 27 Jun 2026 14:32:36 +0000
Subject: [PATCH] fix: Rocksteady block chance is DBC-driven (F-164)

Remove the redundant spell_sha_rocksteady_block CalcAmount handler that
hardcoded +5% per stack. Per-stack block chance now comes from the buff's
DBC effect_base_points_1 -- the engine multiplies by stack count natively
and recalculates on stack change. Only consume-on-block remains in C++.
Stale cap comments corrected to reference the DBC StackAmount.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01K3Frjmskg8zE2Z5wUdzwd6
---
 src/server/scripts/Spells/spell_shaman.cpp | 26 +++++++++-------------
 1 file changed, 10 insertions(+), 16 deletions(-)

diff --git a/src/server/scripts/Spells/spell_shaman.cpp b/src/server/scripts/Spells/spell_shaman.cpp
index 2a82dca4d..71df71460 100644
--- a/src/server/scripts/Spells/spell_shaman.cpp
+++ b/src/server/scripts/Spells/spell_shaman.cpp
@@ -1353,22 +1353,17 @@ class spell_sha_stonebond_pulse : public AuraScript
 };
 
 // 900261 - Rocksteady (F-164 Earthwarden shared block buff)
-// Block chance = 5% per stack, capped at 20 (+100%). Stacks are generated by
-// the Rocksteady talent (chance on melee hit), Improved Rockslam (+1/+2 per
-// cast) and Rockwall (+5 burst); each block consumes a stack until depleted.
+// Per-stack block chance is fully DBC-driven: effect_base_points_1 on the
+// MOD_BLOCK_PERCENT effect (currently +3%), which AuraEffect::CalculateAmount
+// multiplies by the stack count natively (amount *= GetStackAmount()) and
+// recalculates on every stack change (m_canBeRecalculated defaults true). The
+// stack cap is the buff's DBC StackAmount. Stacks are generated by the Rocksteady
+// talent (chance on melee hit), Improved Rockslam (+1/+2 per cast) and Rockwall
+// (+5 burst). This script only handles the one thing data can't: consume-on-block.
 class spell_sha_rocksteady_block : public AuraScript
 {
     PrepareAuraScript(spell_sha_rocksteady_block);
 
-    void CalcAmount(AuraEffect const* /*aurEff*/, int32& amount, bool& canBeRecalculated)
-    {
-        canBeRecalculated = true;
-        // Per-stack value only. AuraEffect::CalculateAmount multiplies the result
-        // by the stack count after this handler runs (amount *= GetStackAmount()),
-        // so multiplying here too would square it (5*n*n) -> +5% block per stack.
-        amount = 5;
-    }
-
     void HandleProc(AuraEffect const* /*aurEff*/, ProcEventInfo& /*eventInfo*/)
     {
         ModStackAmount(-1); // each block consumes a stack; removed at 0
@@ -1376,7 +1371,6 @@ class spell_sha_rocksteady_block : public AuraScript
 
     void Register() override
     {
-        DoEffectCalcAmount += AuraEffectCalcAmountFn(spell_sha_rocksteady_block::CalcAmount, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT);
         OnEffectProc += AuraEffectProcFn(spell_sha_rocksteady_block::HandleProc, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT);
     }
 };
@@ -1384,7 +1378,7 @@ class spell_sha_rocksteady_block : public AuraScript
 // 900256-900260 (Rocksteady talent) / 900181-900182 (Improved Rockslam)
 // On proc, add stacks of the Rocksteady buff (read from EFFECT_1 TriggerSpell):
 // Improved Rockslam R2 (900182) adds 2, everything else adds 1. Capped by the
-// buff's StackAmount (20). PreventDefaultAction overrides the single-stack auto-trigger.
+// buff's DBC StackAmount. PreventDefaultAction overrides the single-stack auto-trigger.
 class spell_sha_rocksteady_stack_proc : public AuraScript
 {
     PrepareAuraScript(spell_sha_rocksteady_stack_proc);
@@ -1400,7 +1394,7 @@ class spell_sha_rocksteady_stack_proc : public AuraScript
         int32 stacksToAdd = (GetId() == 900182) ? 2 : 1; // Improved Rockslam R2 adds 2; all others add 1
 
         if (Aura* buff = caster->GetAura(buffId, caster->GetGUID()))
-            buff->ModStackAmount(stacksToAdd); // caps at StackAmount (20), refreshes duration
+            buff->ModStackAmount(stacksToAdd); // caps at the buff's DBC StackAmount, refreshes duration
         else if (Aura* fresh = caster->AddAura(buffId, caster))
             fresh->SetStackAmount(stacksToAdd);
     }
@@ -1422,7 +1416,7 @@ class spell_sha_rockwall : public SpellScript
     {
         Unit* caster = GetCaster();
         if (Aura* buff = caster->GetAura(SPELL_SHAMAN_ROCKSTEADY_BUFF, caster->GetGUID()))
-            buff->ModStackAmount(5); // caps at 10
+            buff->ModStackAmount(5); // caps at the buff's DBC StackAmount
         else if (Aura* fresh = caster->AddAura(SPELL_SHAMAN_ROCKSTEADY_BUFF, caster))
             fresh->SetStackAmount(5);
     }
