From a0d94329e3317c78e55c3cbbd4a63fe3b312359c Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sun, 14 Jun 2026 00:58:02 +0000
Subject: [PATCH] WIP: F-164 - Living Guardian shield = flat 10% of max health

---
 src/server/scripts/Spells/spell_shaman.cpp | 15 +++++----------
 1 file changed, 5 insertions(+), 10 deletions(-)

diff --git a/src/server/scripts/Spells/spell_shaman.cpp b/src/server/scripts/Spells/spell_shaman.cpp
index 5e40c4c38..658ea322f 100644
--- a/src/server/scripts/Spells/spell_shaman.cpp
+++ b/src/server/scripts/Spells/spell_shaman.cpp
@@ -2249,9 +2249,10 @@ class spell_sha_thunderborne_leap : public SpellScript
     }
 };
 
-// Living Guardian (900170/900171/900172) — F-164 absorb shield
-// Adds 15% of caster's Spell Power to the SCHOOL_ABSORB amount,
-// since aura 69 does not consult spell_bonus_data by default.
+// Living Guardian (900170) — F-164 absorb shield
+// Sets the SCHOOL_ABSORB amount to a flat 10% of the caster's max health,
+// since aura 69 does not consult spell_bonus_data by default. This scales
+// with the Earthwarden's large health pool (bigger for tanks than off-specs).
 // Pattern mirrors spell_pri_power_word_shield_aura.
 class spell_sha_living_guardian_aura : public AuraScript
 {
@@ -2262,13 +2263,7 @@ class spell_sha_living_guardian_aura : public AuraScript
     {
         canBeRecalculated = false;
         if (Unit* caster = GetCaster())
-        {
-            float bonus = 0.15f;
-            bonus *= caster->SpellBaseHealingBonusDone(
-                GetSpellInfo()->GetSchoolMask());
-            bonus *= caster->CalculateLevelPenalty(GetSpellInfo());
-            amount += int32(bonus);
-        }
+            amount = int32(caster->GetMaxHealth() / 10); // 10% of max health
     }
 
     void Register() override
-- 
2.34.1

