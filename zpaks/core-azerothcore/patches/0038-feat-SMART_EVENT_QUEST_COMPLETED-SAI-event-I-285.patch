From db65f7f3197c82634cacf939c1c559a60c52ba50 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sat, 1 Aug 2026 15:28:34 +0000
Subject: [PATCH] feat: SMART_EVENT_QUEST_COMPLETED SAI event (I-285)

- New creature SAI event 112, fired on creatures within 150yd of a player
  whose quest objectives just completed (Player::CompleteQuest), symmetric
  to SMART_EVENT_QUEST_ABANDONED (111)
- param1 = QuestID (0 = any), param2 = onlyOwnSummon
- Wires the previously-unused UnitAI::sQuestComplete virtual into SmartAI
- Replaces the Frightened Miner's per-summon farewell counter, which broke
  when the 4 deposits were split across re-summons (relog/abandon)

Co-Authored-By: Claude <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DaASnkBNWigBWmKxyaYuN8
---
 src/server/game/AI/SmartScripts/SmartAI.cpp    |  5 +++++
 src/server/game/AI/SmartScripts/SmartAI.h      |  2 +-
 .../game/AI/SmartScripts/SmartScript.cpp       |  1 +
 .../game/AI/SmartScripts/SmartScriptMgr.cpp    |  3 +++
 .../game/AI/SmartScripts/SmartScriptMgr.h      |  4 +++-
 .../game/Entities/Player/PlayerQuest.cpp       | 18 ++++++++++++++++++
 6 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/src/server/game/AI/SmartScripts/SmartAI.cpp b/src/server/game/AI/SmartScripts/SmartAI.cpp
index c1dc0e49c..00a9d581b 100644
--- a/src/server/game/AI/SmartScripts/SmartAI.cpp
+++ b/src/server/game/AI/SmartScripts/SmartAI.cpp
@@ -1165,6 +1165,11 @@ void SmartAI::sQuestAbandon(Player* player, Quest const* quest)
     GetScript()->ProcessEventsFor(SMART_EVENT_QUEST_ABANDONED, player, quest->GetQuestId());
 }
 
+void SmartAI::sQuestComplete(Player* player, Quest const* quest)
+{
+    GetScript()->ProcessEventsFor(SMART_EVENT_QUEST_COMPLETED, player, quest->GetQuestId());
+}
+
 void SmartAI::sQuestReward(Player* player, Quest const* quest, uint32 opt)
 {
     GetScript()->ProcessEventsFor(SMART_EVENT_REWARD_QUEST, player, quest->GetQuestId(), opt);
