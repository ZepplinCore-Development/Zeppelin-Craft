From bbadb50245dd1676d6307df5c2405b8924c4a88b Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sat, 11 Apr 2026 12:35:01 +0000
Subject: [PATCH] F-033: Add combo point persistence on target switch and death

---
 src/server/game/Entities/Unit/Unit.cpp | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/server/game/Entities/Unit/Unit.cpp b/src/server/game/Entities/Unit/Unit.cpp
index a5923b587..ff202f8e2 100644
--- a/src/server/game/Entities/Unit/Unit.cpp
+++ b/src/server/game/Entities/Unit/Unit.cpp
@@ -11153,7 +11153,7 @@ void Unit::setDeathState(DeathState s, bool despawn)
         if (wasAlive)
             GetCombatManager().RestartPvPCombatTimers();
         CombatStop(false, /*mutualPvP*/ true, /*keepPvPForOthers*/ true);
-        ClearComboPointHolders();                           // any combo points pointed to unit lost at it death
+        //ClearComboPointHolders();                           // prevents combo point loss on death
 
         if (IsNonMeleeSpellCast(false))
             InterruptNonMeleeSpells(false);
@@ -12880,9 +12880,13 @@ void Unit::AddComboPoints(Unit* target, int8 count)
         {
             m_comboTarget->RemoveComboPointHolder(this);
         }
-
         m_comboTarget = target;
-        m_comboPoints = count;
+        if(m_comboPoints + count > 5){ // handles transitions where 5 combo points are present
+            m_comboPoints = 5;
+        }
+        else{
+            m_comboPoints = std::max<int8>(std::min<int8>(m_comboPoints + count, 5), 0); // handles normal transitions
+        }
         target->AddComboPointHolder(this);
     }
     else
