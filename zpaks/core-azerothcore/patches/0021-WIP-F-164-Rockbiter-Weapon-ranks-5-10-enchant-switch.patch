From 34e7b5df515ffb03f9035a18d912078e517b54bc Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sat, 13 Jun 2026 15:08:58 +0000
Subject: [PATCH] WIP: F-164 - Rockbiter Weapon ranks 5-10 enchant switch cases

---
 src/server/game/Spells/SpellEffects.cpp | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/server/game/Spells/SpellEffects.cpp b/src/server/game/Spells/SpellEffects.cpp
index a66672753..121a1ae4d 100644
--- a/src/server/game/Spells/SpellEffects.cpp
+++ b/src/server/game/Spells/SpellEffects.cpp
@@ -3031,6 +3031,25 @@ void Spell::EffectEnchantItemTmp(SpellEffIndex effIndex)
             case 11:
                 spell_id = 36760;
                 break;               // 20%
+            // Rank 5-10 (F-164 custom): damage == base DPS, one enchant-spell each
+            case 15:
+                spell_id = 900240;
+                break;               // Rank 5
+            case 28:
+                spell_id = 900241;
+                break;               // Rank 6
+            case 40:
+                spell_id = 900242;
+                break;               // Rank 7
+            case 49:
+                spell_id = 900243;
+                break;               // Rank 8
+            case 62:
+                spell_id = 900244;
+                break;               // Rank 9
+            case 80:
+                spell_id = 900245;
+                break;               // Rank 10 (new WotLK rank)
             default:
                 LOG_ERROR("spells.effect", "Spell::EffectEnchantItemTmp: Damage {} not handled in S'RW", damage);
                 return;
-- 
