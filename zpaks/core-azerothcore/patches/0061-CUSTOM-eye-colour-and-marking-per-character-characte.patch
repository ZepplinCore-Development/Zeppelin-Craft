 };
 
diff --git a/src/server/game/Entities/Player/PlayerStorage.cpp b/src/server/game/Entities/Player/PlayerStorage.cpp
index c3117845d..8ae0d87b6 100644
--- a/src/server/game/Entities/Player/PlayerStorage.cpp
+++ b/src/server/game/Entities/Player/PlayerStorage.cpp
@@ -5128,6 +5128,17 @@ bool Player::LoadFromDB(ObjectGuid playerGuid, CharacterDatabaseQueryHolder cons
     SetByteValue(PLAYER_BYTES, 3, fields[12].Get<uint8>());
     SetByteValue(PLAYER_BYTES_2, 0, fields[13].Get<uint8>());
     SetByteValue(PLAYER_BYTES_2, 2, fields[14].Get<uint8>());
+
+    // CUSTOM (F-151): eye colour (byte 0) and marking (byte 1), drawn over the face by the Zeppelin client
+    if (PreparedQueryResult customizations = holder.GetPreparedResult(PLAYER_LOGIN_QUERY_LOAD_CUSTOMIZATIONS))
+    {
+        do
+        {
+            uint8 customization = (*customizations)[0].Get<uint8>();
+            if (customization == 1 || customization == 2)
+                SetByteValue(UNIT_FIELD_PADDING, customization - 1, (*customizations)[1].Get<uint8>());
+        } while (customizations->NextRow());
+    }
     SetByteValue(PLAYER_BYTES_2, 3, fields[15].Get<uint8>());
     SetByteValue(PLAYER_BYTES_3, 0, fields[5].Get<uint8>());
     SetByteValue(PLAYER_BYTES_3, 1, fields[54].Get<uint8>());
diff --git a/src/server/game/Handlers/CharacterHandler.cpp b/src/server/game/Handlers/CharacterHandler.cpp
index 3b90a043b..9ad746003 100644
--- a/src/server/game/Handlers/CharacterHandler.cpp
+++ b/src/server/game/Handlers/CharacterHandler.cpp
@@ -213,6 +213,11 @@ bool LoginQueryHolder::Initialize()
     stmt->SetData(0, rawGUID);
     res &= SetPreparedQuery(PLAYER_LOGIN_QUERY_LOAD_OFFLINE_ACHIEVEMENTS_UPDATES, stmt);
 
+    // CUSTOM (F-151)
+    stmt = CharacterDatabase.GetPreparedStatement(CHAR_SEL_CHARACTER_CUSTOMIZATIONS);
+    stmt->SetData(0, rawGUID);
+    res &= SetPreparedQuery(PLAYER_LOGIN_QUERY_LOAD_CUSTOMIZATIONS, stmt);
+
     return res;
 }
 
@@ -224,6 +229,9 @@ void WorldSession::HandleCharEnum(PreparedQueryResult result)
 
     data << num;
 
+    // CUSTOM (F-151): per listed character its eye colour and marking, the last two query columns
+    std::vector<std::tuple<uint64, uint8, uint8>> customizations;
+
     _legitCharacters.clear();
     if (result)
     {
@@ -235,12 +243,21 @@ void WorldSession::HandleCharEnum(PreparedQueryResult result)
             {
                 _legitCharacters.insert(guid);
                 ++num;
+
+                uint32 columns = result->GetFieldCount();
+                customizations.emplace_back(guid.GetRawValue(), (*result)[columns - 2].Get<uint8>(), (*result)[columns - 1].Get<uint8>());
             }
         } while (result->NextRow());
     }
 
     data.put<uint8>(0, num);
 
+    // CUSTOM (F-151): trailer after the character list, read by the Zeppelin client (RealmConnection::HandleCharEnum):
+    // "ZEPC", count, then per character guid, eye colour, marking
+    data << uint32(0x4350455A) << uint8(customizations.size());
+    for (auto const& [rawGuid, eye, marking] : customizations)
+        data << uint64(rawGuid) << uint8(eye) << uint8(marking);
+
     SendPacket(&data);
 }
 
@@ -276,6 +293,10 @@ void WorldSession::HandleCharCreateOpcode(WorldPacket& recvData)
              >> createInfo->FacialHair
              >> createInfo->OutfitId;
 
+    // CUSTOM (F-151): eye colour and marking follow the outfit when the client sends them
+    if (recvData.rpos() + 2 <= recvData.size())
+        recvData >> createInfo->EyeId >> createInfo->MarkingId;
+
     if (!HasPermission(rbac::RBAC_PERM_SKIP_CHECK_CHARACTER_CREATION_TEAMMASK))
     {
         if (uint32 mask = sWorld->getIntConfig(CONFIG_CHARACTER_CREATING_DISABLED))
@@ -574,6 +595,17 @@ void WorldSession::HandleCharCreateOpcode(WorldPacket& recvData)
 
             // Player created, save it now
             newChar->SaveToDB(characterTransaction, true, false);
+
+            // CUSTOM (F-151): eye colour and marking
+            std::pair<uint8, uint8> const customizations[] = { { 1, createInfo->EyeId }, { 2, createInfo->MarkingId } };
+            for (auto const& [customization, choice] : customizations)
+            {
+                CharacterDatabasePreparedStatement* customStmt = CharacterDatabase.GetPreparedStatement(CHAR_REP_CHARACTER_CUSTOMIZATION);
+                customStmt->SetData(0, newChar->GetGUID().GetCounter());
+                customStmt->SetData(1, customization);
+                customStmt->SetData(2, choice);
+                characterTransaction->Append(customStmt);
+            }
             createInfo->CharCount++;
 
             LoginDatabasePreparedStatement* stmt = LoginDatabase.GetPreparedStatement(LOGIN_REP_REALM_CHARACTERS);
diff --git a/src/server/game/Server/WorldSession.h b/src/server/game/Server/WorldSession.h
index f278009e8..5ab42df95 100644
--- a/src/server/game/Server/WorldSession.h
+++ b/src/server/game/Server/WorldSession.h
@@ -381,6 +381,9 @@ protected:
     uint8 HairColor = 0;
     uint8 FacialHair = 0;
     uint8 OutfitId = 0;
+    // CUSTOM (F-151): appended to CMSG_CHAR_CREATE by the Zeppelin client (character_customizations 1 / 2)
+    uint8 EyeId = 0;
+    uint8 MarkingId = 0;
 
     /// Server side data
     uint8 CharCount = 0;
