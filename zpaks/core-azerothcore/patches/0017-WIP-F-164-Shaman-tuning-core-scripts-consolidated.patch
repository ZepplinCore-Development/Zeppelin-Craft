+// 5730, 6390, 6391, 6392, 10427, 10428, 25525, 58580, 58581, 58582 - Stoneclaw Totem (summon)
+// F-164 Stonebond: when the caster has the Stonebond talent marker (900225),
+// the just-summoned earth totem drops its taunt/stun (totem aura 25513) and
+// instead soaks 20% of the shaman's damage. The totem is extended to 60s and
+// the split (900222) is pulsed onto the owner immediately, then re-cast every
+// 15s by the pulse driver (900226) for a locked ~67% uptime. Without the
+// talent this no-ops and Stoneclaw behaves exactly as stock. The redirected
+// damage drains the totem's HP (RegenHealth=0 on 31122), so totem HP = longevity.
+class spell_sha_stonebond : public SpellScript
+{
+    PrepareSpellScript(spell_sha_stonebond);
+
+    bool Validate(SpellInfo const* /*spellInfo*/) override
+    {
+        return ValidateSpellInfo({ SPELL_SHAMAN_STONEBOND_MARKER, SPELL_SHAMAN_STONEBOND_SPLIT, SPELL_SHAMAN_STONEBOND_PULSE });
+    }
+
+    void HandleAfterCast()
+    {
+        Unit* caster = GetCaster();
+        if (!caster->HasAura(SPELL_SHAMAN_STONEBOND_MARKER))
+            return;
+
+        if (!caster->m_SummonSlot[SUMMON_SLOT_TOTEM_EARTH])
+            return;
+
+        Creature* totem = caster->GetMap()->GetCreature(caster->m_SummonSlot[SUMMON_SLOT_TOTEM_EARTH]);
+        if (!totem || !totem->IsTotem())
+            return;
+
+        // Drop the stock taunt + stun (both driven by totem aura 25513)
+        totem->RemoveAurasDueToSpell(SPELL_SHAMAN_STONECLAW_TAUNT_PASSIVE);
+
+        // Long-lived totem: summon once, soak until it falls (60s)
+        if (Totem* t = totem->ToTotem())
+            t->SetTotemDuration(60 * IN_MILLISECONDS);
+
+        // Soak 20% immediately (totem = the split's caster, so damage redirects
+        // to it), then the pulse driver re-applies it on the locked rhythm.
+        totem->CastSpell(caster, SPELL_SHAMAN_STONEBOND_SPLIT, true);
+        totem->CastSpell(totem, SPELL_SHAMAN_STONEBOND_PULSE, true);
+    }
+
+    void Register() override
+    {
+        AfterCast += SpellCastFn(spell_sha_stonebond::HandleAfterCast);
+    }
+};
+
+// 900226 - Stonebond Pulse (driver aura placed on the totem by spell_sha_stonebond)
+// Each tick the totem re-casts the Stonebond split (900222) on its owner.
+// 900222's 10s duration < this aura's 15s amplitude => ~67% locked uptime.
+class spell_sha_stonebond_pulse : public AuraScript
+{
+    PrepareAuraScript(spell_sha_stonebond_pulse);
+
+    bool Validate(SpellInfo const* /*spellInfo*/) override
+    {
+        return ValidateSpellInfo({ SPELL_SHAMAN_STONEBOND_SPLIT });
+    }
+
+    void HandlePeriodic(AuraEffect const* /*aurEff*/)
+    {
+        Unit* totem = GetTarget();
+        if (Unit* owner = totem->GetOwner())
+            totem->CastSpell(owner, SPELL_SHAMAN_STONEBOND_SPLIT, true);
+    }
+
+    void Register() override
+    {
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_sha_stonebond_pulse::HandlePeriodic, EFFECT_0, SPELL_AURA_PERIODIC_DUMMY);
+    }
+};
+
+// 900261 - Rocksteady (F-164 Earthwarden shared block buff)
+// Block chance = 5% per stack, capped at 20 (+100%). Stacks are generated by
+// the Rocksteady talent (chance on melee hit), Improved Rockslam (+1/+2 per
+// cast) and Rockwall (+5 burst); each block consumes a stack until depleted.
+class spell_sha_rocksteady_block : public AuraScript
+{
+    PrepareAuraScript(spell_sha_rocksteady_block);
+
+    void CalcAmount(AuraEffect const* /*aurEff*/, int32& amount, bool& canBeRecalculated)
+    {
+        canBeRecalculated = true;
+        // Per-stack value only. AuraEffect::CalculateAmount multiplies the result
+        // by the stack count after this handler runs (amount *= GetStackAmount()),
+        // so multiplying here too would square it (5*n*n) -> +5% block per stack.
+        amount = 5;
+    }
+
+    void HandleProc(AuraEffect const* /*aurEff*/, ProcEventInfo& /*eventInfo*/)
+    {
+        ModStackAmount(-1); // each block consumes a stack; removed at 0
+    }
+
+    void Register() override
+    {
+        DoEffectCalcAmount += AuraEffectCalcAmountFn(spell_sha_rocksteady_block::CalcAmount, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT);
+        OnEffectProc += AuraEffectProcFn(spell_sha_rocksteady_block::HandleProc, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT);
+    }
+};
+
+// 900256-900260 (Rocksteady talent) / 900181-900182 (Improved Rockslam)
+// On proc, add stacks of the Rocksteady buff (read from EFFECT_1 TriggerSpell):
+// Improved Rockslam R2 (900182) adds 2, everything else adds 1. Capped by the
+// buff's StackAmount (20). PreventDefaultAction overrides the single-stack auto-trigger.
+class spell_sha_rocksteady_stack_proc : public AuraScript
+{
+    PrepareAuraScript(spell_sha_rocksteady_stack_proc);
+
+    void HandleProc(AuraEffect const* aurEff, ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction();
+        Unit* caster = GetTarget();
+        uint32 buffId = aurEff->GetSpellInfo()->Effects[aurEff->GetEffIndex()].TriggerSpell;
+        if (!buffId)
+            return;
+
+        int32 stacksToAdd = (GetId() == 900182) ? 2 : 1; // Improved Rockslam R2 adds 2; all others add 1
+
+        if (Aura* buff = caster->GetAura(buffId, caster->GetGUID()))
+            buff->ModStackAmount(stacksToAdd); // caps at StackAmount (20), refreshes duration
+        else if (Aura* fresh = caster->AddAura(buffId, caster))
+            fresh->SetStackAmount(stacksToAdd);
+    }
+
+    void Register() override
+    {
+        OnEffectProc += AuraEffectProcFn(spell_sha_rocksteady_stack_proc::HandleProc, EFFECT_1, SPELL_AURA_PROC_TRIGGER_SPELL);
+    }
+};
+
+// 900223 - Rockwall (F-164 Earthwarden CD burst)
+// Instant, 1 min CD, shield required; immediately adds 5 stacks of the
+// Rocksteady block buff (the on-demand "stack booster").
+class spell_sha_rockwall : public SpellScript
+{
+    PrepareSpellScript(spell_sha_rockwall);
+
+    void HandleDummy(SpellEffIndex /*effIndex*/)
+    {
+        Unit* caster = GetCaster();
+        if (Aura* buff = caster->GetAura(SPELL_SHAMAN_ROCKSTEADY_BUFF, caster->GetGUID()))
+            buff->ModStackAmount(5); // caps at 10
+        else if (Aura* fresh = caster->AddAura(SPELL_SHAMAN_ROCKSTEADY_BUFF, caster))
+            fresh->SetStackAmount(5);
+    }
+
+    void Register() override
+    {
+        OnEffectHit += SpellEffectFn(spell_sha_rockwall::HandleDummy, EFFECT_0, SPELL_EFFECT_DUMMY);
+    }
+};
+
+// 900119 - Rockslam (F-164 Earthwarden signature single-target)
+// Shield Slam analog: adds the caster's shield block value to the hit on top of
+// the spell's base + AP damage, so it scales with Rocksteady's block-value boost
+// and gear. Block-value coefficient is 1.0x (tune by scaling the added value).
+class spell_sha_rockslam : public SpellScript
+{
+    PrepareSpellScript(spell_sha_rockslam);
+
+    void HandleDamage(SpellEffIndex /*effIndex*/)
+    {
+        if (Player* caster = GetCaster()->ToPlayer())
+            SetHitDamage(GetHitDamage() + int32(caster->GetShieldBlockValue()));
+    }
+
+    void Register() override
+    {
+        OnEffectHitTarget += SpellEffectFn(spell_sha_rockslam::HandleDamage, EFFECT_0, SPELL_EFFECT_SCHOOL_DAMAGE);
+    }
+};
+
+// Rocksurge (900263) stack scaling is data-driven: the Rocksteady buff (900261)
+// carries a SPELLMOD_DAMAGE flat effect (aura 107) targeting Rocksurge's family
+// bit, and the stacking aura multiplies it by stack count. No script needed.
+
 // -51490 - Thunderstorm
 class spell_sha_thunderstorm : public SpellScript
 {
@@ -2169,6 +2360,106 @@ class spell_sha_windfury_weapon : public AuraScript
     }
 };
 
+// 900173 - Thunderborne Leap
+// Leaps to enemy target using JUMP_DEST. Schedules the impact AoE
+// (900174) to cast when the caster lands, since TRIGGER_SPELL fires
+// at cast time (before movement) and cannot center AoE at the
+// landing position.
+// Uses AfterCast so the timer starts after MoveJump has begun,
+// and reads the spline duration directly for accurate timing.
+class spell_sha_thunderborne_leap : public SpellScript
+{
+    PrepareSpellScript(spell_sha_thunderborne_leap);
+
+    void HandleOnCast()
+    {
+        Player* player = GetCaster()->ToPlayer();
+        if (!player)
+            return;
+
+        // Draw weapons before the jump spline packet is sent.
+        // SetSheath alone is batched (end-of-tick), so force an
+        // immediate object update so the client sees weapons
+        // drawn before the SMSG_MONSTER_MOVE arrives.
+        player->SetSheath(SHEATH_STATE_MELEE);
+        player->SendUpdateToPlayer(player);
+    }
+
+    void HandleAfterCast()
+    {
+        Unit* caster = GetCaster();
+        if (!caster)
+            return;
+
+        // Read the actual spline duration — MoveJump has already
+        // started by the time AfterCast fires
+        uint32 travelTimeMs = caster->movespline->Duration();
+
+        ObjectGuid casterGUID = caster->GetGUID();
+
+        // Capture the spell target for auto-attack on landing.
+        // GetVictim() is null at this point because melee hasn't
+        // started yet — we need the explicit spell target instead.
+        Unit* target = GetExplTargetUnit();
+        ObjectGuid targetGUID = target ? target->GetGUID()
+                                       : ObjectGuid::Empty;
+
+        caster->m_Events.AddEventAtOffset(
+            [casterGUID, targetGUID]()
+            {
+                Player* player =
+                    ObjectAccessor::FindPlayer(casterGUID);
+                if (!player)
+                    return;
+
+                player->CastSpell(player,
+                    SPELL_SHAMAN_THUNDERBORNE_LEAP_IMPACT,
+                    true);
+
+                // Start auto-attack on the leap target
+                if (!targetGUID.IsEmpty())
+                    if (Unit* victim = ObjectAccessor::GetUnit(
+                            *player, targetGUID))
+                        if (player->IsValidAttackTarget(victim))
+                            player->Attack(victim, true);
+            },
+            Milliseconds(travelTimeMs));
+    }
+
+    void Register() override
+    {
+        OnCast += SpellCastFn(
+            spell_sha_thunderborne_leap::HandleOnCast);
+        AfterCast += SpellCastFn(
+            spell_sha_thunderborne_leap::HandleAfterCast);
+    }
+};
+
+// Living Guardian (900170) — F-164 absorb shield
+// Sets the SCHOOL_ABSORB amount to a flat 10% of the caster's max health,
+// since aura 69 does not consult spell_bonus_data by default. This scales
+// with the Earthwarden's large health pool (bigger for tanks than off-specs).
+// Pattern mirrors spell_pri_power_word_shield_aura.
+class spell_sha_living_guardian_aura : public AuraScript
+{
+    PrepareAuraScript(spell_sha_living_guardian_aura);
+
+    void CalculateAmount(AuraEffect const* /*aurEff*/, int32& amount,
+        bool& canBeRecalculated)
+    {
+        canBeRecalculated = false;
+        if (Unit* caster = GetCaster())
+            amount = int32(caster->GetMaxHealth() / 10); // 10% of max health
+    }
+
+    void Register() override
+    {
+        DoEffectCalcAmount += AuraEffectCalcAmountFn(
+            spell_sha_living_guardian_aura::CalculateAmount,
+            EFFECT_0, SPELL_AURA_SCHOOL_ABSORB);
+    }
+};
