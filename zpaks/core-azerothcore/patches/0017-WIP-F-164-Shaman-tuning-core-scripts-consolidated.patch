+// 900224 - Stoneguard Totem (F-164 damage-mitigation totem)
+// Sets the summoned totem's HP to 5% of the shaman's max health and has the
+// totem redirect 20% of the shaman's incoming damage to itself (aura 900222,
+// cast by the totem on the owner so the totem is the split's caster).
+class spell_sha_stoneguard_totem : public SpellScript
+{
+    PrepareSpellScript(spell_sha_stoneguard_totem);
+
+    bool Validate(SpellInfo const* /*spellInfo*/) override
+    {
+        return ValidateSpellInfo({ SPELL_SHAMAN_STONEGUARD_SPLIT });
+    }
+
+    void HandleAfterCast()
+    {
+        Unit* caster = GetCaster();
+        if (!caster->m_SummonSlot[SUMMON_SLOT_TOTEM_EARTH])
+            return;
+
+        Creature* totem = caster->GetMap()->GetCreature(caster->m_SummonSlot[SUMMON_SLOT_TOTEM_EARTH]);
+        if (!totem || !totem->IsTotem())
+            return;
+
+        // Totem HP = 5% of the shaman's max health (the visible damage buffer)
+        if (uint32 hp = caster->CountPctFromMaxHealth(5))
+        {
+            totem->SetMaxHealth(hp);
+            totem->SetHealth(hp);
+        }
+
+        // Totem redirects 20% of the shaman's damage to itself (totem = caster)
+        totem->CastSpell(caster, SPELL_SHAMAN_STONEGUARD_SPLIT, true);
+    }
+
+    void Register() override
+    {
+        AfterCast += SpellCastFn(spell_sha_stoneguard_totem::HandleAfterCast);
+    }
+};
+
+// 900223 - Stonewall (F-164 Earthwarden block panic button)
+// Block chance = 5% per stack; starts at 10 stacks (+50%); each block consumes
+// a stack (-5%) until depleted or the 60s buff expires.
+class spell_sha_stonewall_aura : public AuraScript
+{
+    PrepareAuraScript(spell_sha_stonewall_aura);
+
+    void CalcAmount(AuraEffect const* /*aurEff*/, int32& amount, bool& canBeRecalculated)
+    {
+        canBeRecalculated = true;
+        amount = 5 * GetStackAmount(); // +5% block per stack
+    }
+
+    void AfterApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        // start at 10 stacks (+50% block); guard prevents recalc recursion
+        if (GetStackAmount() < 10)
+            SetStackAmount(10);
+    }
+
+    void HandleProc(AuraEffect const* /*aurEff*/, ProcEventInfo& /*eventInfo*/)
+    {
+        ModStackAmount(-1); // each block consumes a stack (-5%); removed at 0
+    }
+
+    void Register() override
+    {
+        DoEffectCalcAmount += AuraEffectCalcAmountFn(spell_sha_stonewall_aura::CalcAmount, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT);
+        AfterEffectApply += AuraEffectApplyFn(spell_sha_stonewall_aura::AfterApply, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT, AURA_EFFECT_HANDLE_REAL);
+        OnEffectProc += AuraEffectProcFn(spell_sha_stonewall_aura::HandleProc, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT);
+    }
+};
+
+// 900180 (R1) / 900120 (R2) - Rockslam stacking block buff (F-164)
+// Block chance = 5% per stack (mirrors Stonewall). Improved Rockslam adds 3
+// stacks per Rockslam cast (capped by the spell's StackAmount: R1=6/+30%,
+// R2=10/+50%); each block consumes a stack until depleted or the buff expires.
+class spell_sha_rockslam_block : public AuraScript
+{
+    PrepareAuraScript(spell_sha_rockslam_block);
+
+    void CalcAmount(AuraEffect const* /*aurEff*/, int32& amount, bool& canBeRecalculated)
+    {
+        canBeRecalculated = true;
+        amount = 5 * GetStackAmount(); // +5% block per stack
+    }
+
+    void HandleProc(AuraEffect const* /*aurEff*/, ProcEventInfo& /*eventInfo*/)
+    {
+        ModStackAmount(-1); // each block consumes a stack; removed at 0
+    }
+
+    void Register() override
+    {
+        DoEffectCalcAmount += AuraEffectCalcAmountFn(spell_sha_rockslam_block::CalcAmount, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT);
+        OnEffectProc += AuraEffectProcFn(spell_sha_rockslam_block::HandleProc, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT);
+    }
+};
+
+// 900181 (R1) / 900182 (R2) - Improved Rockslam (F-164)
+// Each Rockslam cast adds 3 stacks of the rank's block buff (900180/900120)
+// instead of the default single-stack refresh. The triggered buff id is read
+// from the talent's EFFECT_1 TriggerSpell so one script serves both ranks.
+class spell_sha_improved_rockslam : public AuraScript
+{
+    PrepareAuraScript(spell_sha_improved_rockslam);
+
+    void HandleProc(AuraEffect const* aurEff, ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction(); // override the aura-42 single-stack auto-trigger
+        Unit* caster = GetTarget();
+        uint32 buffId = aurEff->GetSpellInfo()->Effects[aurEff->GetEffIndex()].TriggerSpell;
+        if (!buffId)
+            return;
+
+        if (Aura* buff = caster->GetAura(buffId, caster->GetGUID()))
+            buff->ModStackAmount(3); // caps at StackAmount, refreshes duration
+        else if (Aura* fresh = caster->AddAura(buffId, caster))
+            fresh->SetStackAmount(3);
+    }
+
+    void Register() override
+    {
+        OnEffectProc += AuraEffectProcFn(spell_sha_improved_rockslam::HandleProc, EFFECT_1, SPELL_AURA_PROC_TRIGGER_SPELL);
+    }
+};
