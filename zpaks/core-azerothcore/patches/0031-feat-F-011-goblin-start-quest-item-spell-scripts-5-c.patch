 }
diff --git a/src/server/scripts/Custom/zeppelin_goblin_start.cpp b/src/server/scripts/Custom/zeppelin_goblin_start.cpp
new file mode 100644
index 000000000..041539818
--- /dev/null
+++ b/src/server/scripts/Custom/zeppelin_goblin_start.cpp
@@ -0,0 +1,76 @@
+/*
+ * Zeppelin custom content — F-011 Goblin Starting Zone (Lost Isles / Kezan).
+ *
+ * Quest-item spell scripts ported from Cataclysm (Project Neltharion). The source
+ * effects are DUMMY/SCRIPT_EFFECT whose behaviour lives in core C++; here we
+ * reimplement the quest-credit behaviour for 3.3.5a.
+ *
+ * Registered spell_script_names live in the zep-goblin-start zpak SQL.
+ */
+
+#include "Player.h"
+#include "ScriptMgr.h"
+#include "SpellScript.h"
+#include "SpellScriptLoader.h"
+
+enum ZepGoblinCredits
+{
+    // fixed kill-credit NPCs (invisible quest triggers)
+    NPC_MONKEY_BUSINESS_CREDIT   = 35760, // q14019
+    NPC_WEED_WHACKER_CREDIT      = 35816, // q14236 (Miner Troubles / Weed Whacker credit)
+    NPC_CLUSTER_CLUCK_CREDIT     = 38117, // q24671
+    NPC_ZOMBIES_BOOSTER_CREDIT   = 38807, // q24942
+
+    SPELL_NITRO_POTASSIUM_BANANAS = 67917, // SCRIPT_EFFECT
+    SPELL_WEED_WHACKER            = 68211, // DUMMY
+    SPELL_KTC_SNAPFLASH           = 68280, // DUMMY (photograph target -> credit that entry)
+    SPELL_REMOTE_CONTROL_FIREWORKS = 71170, // DUMMY
+    SPELL_SUPER_BOOSTER_ROCKET_BOOTS = 72891 // SCRIPT_EFFECT
+};
+
+// Generic: on effect hit, give the caster a fixed kill-credit.
+template <uint32 CreditEntry>
+class spell_zep_fixed_credit : public SpellScript
+{
+    PrepareSpellScript(spell_zep_fixed_credit);
+
+    void HandleCredit(SpellEffIndex /*effIndex*/)
+    {
+        if (Player* player = GetCaster() ? GetCaster()->ToPlayer() : nullptr)
+            player->KilledMonsterCredit(CreditEntry);
+    }
+
+    void Register() override
+    {
+        OnEffectHitTarget += SpellEffectFn(spell_zep_fixed_credit::HandleCredit, EFFECT_0, SPELL_EFFECT_ANY);
+    }
+};
+
+// KTC Snapflash: photograph the targeted creature -> credit its own entry.
+class spell_zep_q14031_ktc_snapflash : public SpellScript
+{
+    PrepareSpellScript(spell_zep_q14031_ktc_snapflash);
+
+    void HandleCredit(SpellEffIndex /*effIndex*/)
+    {
+        Player* player = GetCaster() ? GetCaster()->ToPlayer() : nullptr;
+        if (!player)
+            return;
+        if (Creature* target = GetHitCreature())
+            player->KilledMonsterCredit(target->GetEntry());
+    }
+
+    void Register() override
+    {
+        OnEffectHitTarget += SpellEffectFn(spell_zep_q14031_ktc_snapflash::HandleCredit, EFFECT_0, SPELL_EFFECT_ANY);
+    }
+};
+
+void AddSC_zeppelin_goblin_start()
+{
+    RegisterSpellScriptWithArgs(spell_zep_fixed_credit<NPC_MONKEY_BUSINESS_CREDIT>, "spell_zep_q14019_monkey_business");
+    RegisterSpellScriptWithArgs(spell_zep_fixed_credit<NPC_WEED_WHACKER_CREDIT>, "spell_zep_q14236_weed_whacker");
+    RegisterSpellScriptWithArgs(spell_zep_fixed_credit<NPC_CLUSTER_CLUCK_CREDIT>, "spell_zep_q24671_cluster_cluck");
+    RegisterSpellScriptWithArgs(spell_zep_fixed_credit<NPC_ZOMBIES_BOOSTER_CREDIT>, "spell_zep_q24942_zombies_booster");
+    RegisterSpellScript(spell_zep_q14031_ktc_snapflash);
+}
