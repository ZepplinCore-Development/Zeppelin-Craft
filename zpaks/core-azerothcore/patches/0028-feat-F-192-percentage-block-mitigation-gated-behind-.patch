                     if (damage < int32(damageInfo->blocked))
                         damageInfo->blocked = uint32(damage);
 
@@ -1898,6 +1972,23 @@ void Unit::CalculateMeleeDamage(Unit* victim, CalcDamageInfo* damageInfo, Weapon
         {
             damageInfo->TargetState = VICTIMSTATE_HIT;
             damageInfo->HitInfo |= HITINFO_BLOCK;
+
+            float const blockPct = CalcBlockDamageReductionPct(damageInfo->target); // F-192
+            if (blockPct >= 0.0f) // percent-block mode: reduce each damage component by blockPct%
+            {
+                damageInfo->blocked_amount = 0;
