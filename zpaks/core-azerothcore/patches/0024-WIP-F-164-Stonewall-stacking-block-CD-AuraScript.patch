From: Justin <justurn@live.com>
Date: Sun, 14 Jun 2026 02:52:13 +0000
Subject: [PATCH] WIP: F-164 - Stonewall stacking block CD AuraScript

---
 src/server/scripts/Spells/spell_shaman.cpp | 35 ++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/src/server/scripts/Spells/spell_shaman.cpp b/src/server/scripts/Spells/spell_shaman.cpp
index 952be5e85..74fb01ec6 100644
--- a/src/server/scripts/Spells/spell_shaman.cpp
+++ b/src/server/scripts/Spells/spell_shaman.cpp
@@ -60,6 +60,7 @@ enum ShamanSpells
     SPELL_SHAMAN_SATED                          = 57724,
     SPELL_SHAMAN_STONECLAW_TOTEM                = 55277,
     SPELL_SHAMAN_STONECLAW_DAMAGE_SPLIT         = 900222, // F-164: 30% damage redirect to totem
+    SPELL_SHAMAN_STONEWALL                      = 900223, // F-164: stacking block CD
     SPELL_SHAMAN_EARTHS_GRASP_R1                = 16043,
     SPELL_SHAMAN_EARTHS_GRASP_R2                = 16130,
     SPELL_SHAMAN_STORM_EARTH_AND_FIRE           = 51483,
@@ -1271,6 +1272,39 @@ class spell_sha_stoneclaw_totem : public SpellScript
     }
 };
 
+// 900223 - Stonewall (F-164 Earthwarden block panic button)
+// Block chance = 5% per stack; starts at 10 stacks (+50%); each block consumes
+// a stack (-5%) until depleted or the 60s buff expires.
+class spell_sha_stonewall_aura : public AuraScript
+{
+    PrepareAuraScript(spell_sha_stonewall_aura);
+
+    void CalcAmount(AuraEffect const* /*aurEff*/, int32& amount, bool& canBeRecalculated)
+    {
+        canBeRecalculated = true;
+        amount = 5 * GetStackAmount(); // +5% block per stack
+    }
+
+    void AfterApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        // start at 10 stacks (+50% block); guard prevents recalc recursion
+        if (GetStackAmount() < 10)
+            SetStackAmount(10);
+    }
+
+    void HandleProc(AuraEffect* /*aurEff*/, ProcEventInfo& /*eventInfo*/)
+    {
+        ModStackAmount(-1); // each block consumes a stack (-5%); removed at 0
+    }
+
+    void Register() override
+    {
+        DoEffectCalcAmount += AuraEffectCalcAmountFn(spell_sha_stonewall_aura::CalcAmount, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT);
+        AfterEffectApply += AuraEffectApplyFn(spell_sha_stonewall_aura::AfterApply, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT, AURA_EFFECT_HANDLE_REAL);
+        OnEffectProc += AuraEffectProcFn(spell_sha_stonewall_aura::HandleProc, EFFECT_0, SPELL_AURA_MOD_BLOCK_PERCENT);
+    }
+};
+
 // -51490 - Thunderstorm
 class spell_sha_thunderstorm : public SpellScript
 {
@@ -2324,6 +2358,7 @@ void AddSC_shaman_spell_scripts()
     RegisterSpellScript(spell_sha_nature_guardian);
     RegisterSpellScript(spell_sha_sentry_totem);
     RegisterSpellScript(spell_sha_stoneclaw_totem);
+    RegisterSpellScript(spell_sha_stonewall_aura);
     RegisterSpellScript(spell_sha_thunderstorm);
     RegisterSpellScript(spell_sha_flurry_proc);
     RegisterSpellScript(spell_sha_glyph_of_healing_wave);
