+// CUSTOM (F-230): zep[0] = jewellery (customization 5), zep[1 + s] = geoset slot s (customization 10 + s); 0 = unset, no row
+void Player::SaveZepCustomizations(ObjectGuid::LowType lowGuid, uint8 const (&zep)[7], CharacterDatabaseTransaction trans)
+{
+    for (uint8 i = 0; i < 7; ++i)
+    {
+        uint8 choice = i == 0 ? zep[i] : uint8(zep[i] & 0x0F);
+        if (!choice)
+            continue;
+
+        CharacterDatabasePreparedStatement* stmt = CharacterDatabase.GetPreparedStatement(CHAR_REP_CHARACTER_CUSTOMIZATION);
+        stmt->SetData(0, lowGuid);
+        stmt->SetData(1, uint8(i == 0 ? 5 : 9 + i));
+        stmt->SetData(2, choice);
+        CharacterDatabase.ExecuteOrAppend(trans, stmt);
+    }
 }
 
