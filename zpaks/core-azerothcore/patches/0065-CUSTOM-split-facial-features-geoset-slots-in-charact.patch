index eab9a2360..d79867db2 100644
--- a/src/server/game/Handlers/CharacterHandler.cpp
+++ b/src/server/game/Handlers/CharacterHandler.cpp
@@ -63,6 +63,31 @@
 #include "WorldSession.h"
 #include "WorldSessionMgr.h"
 
+// CUSTOM (F-230): optional ZEPO block the Zeppelin client appends to CMSG_CHAR_CREATE / CUSTOMIZE / FACTION_CHANGE /
+// ALTER_APPEARANCE: uint32 'ZEPO', uint8 n, n bytes (b[0] jewellery = customization 5, b[1 + s] geoset slot s = customization 10 + s).
+// Absent block = unchanged; bytes beyond the 7 known are skipped; a slot value above 15 reads as unset.
+static void ReadZepBlock(WorldPacket& recvData, bool& hasZep, uint8 (&zep)[7])
+{
+    if (recvData.rpos() + 5 > recvData.size())
+        return;
+
+    if (recvData.read<uint32>() != 0x4F50455A)
+    {
+        recvData.rpos(recvData.rpos() - 4);
+        return;
+    }
+
+    uint8 n = recvData.read<uint8>();
+    for (uint8 k = 0; k < n && recvData.rpos() < recvData.size(); ++k)
+    {
+        uint8 b = recvData.read<uint8>();
+        if (k < 7)
+            zep[k] = (k == 0 || b <= 15) ? b : 0;
+    }
+
+    hasZep = true;
+}
