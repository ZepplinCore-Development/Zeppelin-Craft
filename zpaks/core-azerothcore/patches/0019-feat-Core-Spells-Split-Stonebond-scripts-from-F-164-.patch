+                    me->CastCustomSpell(SPELL_SHAMAN_STONEBOND_SPLIT, SPELLVALUE_BASE_POINT0, pct, owner, true);
+                    me->CastCustomSpell(SPELL_SHAMAN_STONEBOND_PULSE, SPELLVALUE_BASE_POINT0, pct, me, true);
+                }
+
+                if (!me->IsInCombat())
+                {
                     if (Unit* target = owner->GetSelectedUnit())
                         if (me->CanCreatureAttack(target))
