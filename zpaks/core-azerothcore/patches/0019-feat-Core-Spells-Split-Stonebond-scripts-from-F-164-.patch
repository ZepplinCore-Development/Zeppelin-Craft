@@ -58,12 +77,28 @@ struct npc_pet_shaman_earth_elemental : public ScriptedAI
     {
         if (_initAttack)
         {
-            if (!me->IsInCombat())
-                if (Player* owner = me->GetCharmerOrOwnerPlayerOrPlayerItself())
+            _initAttack = false;
