-    SPELL_SHAMAN_FIRESHIELD     = 13377
+    SPELL_SHAMAN_FIRESHIELD     = 13377,
+    // F-164 Stonebond (Earth Elemental soak mode)
+    SPELL_SHAMAN_STONEBOND_MARKER = 900225,
+    SPELL_SHAMAN_STONEBOND_SPLIT  = 900222,
+    SPELL_SHAMAN_STONEBOND_PULSE  = 900226
 };
 
 enum ShamanEvents
@@ -42,12 +47,26 @@ enum ShamanEvents
     EVENT_SHAMAN_FIREBLAST      = 3
 };
 
+// F-164 Stonebond: returns the owner's Stonebond rank absorb % (4/8/12/16/20),
+// or 0 if unspecced. Each rank's marker aura stores its % as the effect-0 amount.
+static int32 GetStonebondPct(Unit* owner)
+{
+    static constexpr uint32 STONEBOND_RANKS[5] = { 900225, 900227, 900228, 900229, 900236 };
+    for (uint32 rankId : STONEBOND_RANKS)
+        if (AuraEffect const* eff = owner->GetAuraEffect(rankId, EFFECT_0))
+            return eff->GetAmount();
+    return 0;
+}
+
 struct npc_pet_shaman_earth_elemental : public ScriptedAI
 {
-    npc_pet_shaman_earth_elemental(Creature* creature) : ScriptedAI(creature), _initAttack(true) { }
+    npc_pet_shaman_earth_elemental(Creature* creature) : ScriptedAI(creature), _initAttack(true), _stonebond(false) { }
 
     void JustEngagedWith(Unit*) override
     {
