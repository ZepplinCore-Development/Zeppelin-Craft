From f8b997e96ef6029d4b38262f6cd61bd137c7676e Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Fri, 19 Jun 2026 11:51:46 +0000
Subject: [PATCH] WIP: F-164 - Stonebond taunt fixes (rank-aware strip +
 elemental attacks)

- spell_shaman: strip the totem's actual rank-specific taunt passive
  (spells[0]) instead of hardcoded 25513, which only de-taunted rank 7.
  Every other Stoneclaw rank kept taunting under Stonebond.
- pet_shaman: Stonebond Earth Elemental now still attacks (melee +
  engages owner's target) but never casts Angered Earth (no taunt).
- Add Totem.h include; drop now-unused STONECLAW_TAUNT_PASSIVE enum.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/server/scripts/Pet/pet_shaman.cpp      | 15 +++++++--------
 src/server/scripts/Spells/spell_shaman.cpp | 13 ++++++++++---
 2 files changed, 17 insertions(+), 11 deletions(-)

diff --git a/src/server/scripts/Pet/pet_shaman.cpp b/src/server/scripts/Pet/pet_shaman.cpp
index fb469cd7c..c9d9170a7 100644
--- a/src/server/scripts/Pet/pet_shaman.cpp
+++ b/src/server/scripts/Pet/pet_shaman.cpp
@@ -81,9 +81,9 @@ struct npc_pet_shaman_earth_elemental : public ScriptedAI
 
             if (Player* owner = me->GetCharmerOrOwnerPlayerOrPlayerItself())
             {
-                // F-164 Stonebond: a specced Earthwarden's Earth Elemental stops
-                // tanking and becomes a damage sponge -- it does not engage or
-                // taunt (no Angered Earth), it just soaks the rank's % of the
+                // F-164 Stonebond: a specced Earthwarden's Earth Elemental still
+                // attacks normally but stops tanking -- it does not taunt (no
+                // Angered Earth), it just additionally soaks the rank's % of the
                 // owner's damage via the same pulse driver used by Stoneclaw.
                 if (int32 pct = GetStonebondPct(owner))
                 {
@@ -91,7 +91,8 @@ struct npc_pet_shaman_earth_elemental : public ScriptedAI
                     me->CastCustomSpell(SPELL_SHAMAN_STONEBOND_SPLIT, SPELLVALUE_BASE_POINT0, pct, owner, true);
                     me->CastCustomSpell(SPELL_SHAMAN_STONEBOND_PULSE, SPELLVALUE_BASE_POINT0, pct, me, true);
                 }
-                else if (!me->IsInCombat())
+
+                if (!me->IsInCombat())
                 {
                     if (Unit* target = owner->GetSelectedUnit())
                         if (me->CanCreatureAttack(target))
@@ -100,15 +101,13 @@ struct npc_pet_shaman_earth_elemental : public ScriptedAI
             }
         }
 
-        if (_stonebond)
-            return;
-
         if (!UpdateVictim())
             return;
 
         _events.Update(diff);
 
-        if (_events.ExecuteEvent() == EVENT_SHAMAN_ANGEREDEARTH)
+        // Stonebond soak elementals attack but never taunt (no Angered Earth).
+        if (!_stonebond && _events.ExecuteEvent() == EVENT_SHAMAN_ANGEREDEARTH)
         {
             DoCastVictim(SPELL_SHAMAN_ANGEREDEARTH);
             _events.ScheduleEvent(EVENT_SHAMAN_ANGEREDEARTH, 5s, 20s);
diff --git a/src/server/scripts/Spells/spell_shaman.cpp b/src/server/scripts/Spells/spell_shaman.cpp
index 35d4a3d51..41a3c2e4e 100644
--- a/src/server/scripts/Spells/spell_shaman.cpp
+++ b/src/server/scripts/Spells/spell_shaman.cpp
@@ -22,6 +22,7 @@
 #include "SpellMgr.h"
 #include "SpellScript.h"
 #include "SpellScriptLoader.h"
+#include "Totem.h"
 #include "Unit.h"
 /*
  * Scripts for spells with SPELLFAMILY_SHAMAN and SPELLFAMILY_GENERIC spells used by shaman players.
@@ -64,7 +65,6 @@ enum ShamanSpells
     SPELL_SHAMAN_ROCKSTEADY_BUFF                = 900261, // F-164: shared stacking block buff
     SPELL_SHAMAN_STONEBOND_MARKER               = 900225, // F-164: Stonebond talent marker aura (HasAura gate)
     SPELL_SHAMAN_STONEBOND_PULSE                = 900226, // F-164: Stonebond pulse driver aura (on the totem)
-    SPELL_SHAMAN_STONECLAW_TAUNT_PASSIVE        = 25513,  // Stoneclaw taunt+stun totem aura (stripped by Stonebond)
     SPELL_SHAMAN_STORM_EARTH_AND_FIRE           = 51483,
     SPELL_SHAMAN_TOTEM_EARTHBIND_EARTHGRAB      = 64695,
     SPELL_SHAMAN_TOTEM_EARTHBIND_TOTEM          = 6474,
@@ -1304,8 +1304,15 @@ class spell_sha_stonebond : public SpellScript
         if (!totem || !totem->IsTotem())
             return;
 
-        // Drop the stock taunt + stun (both driven by totem aura 25513)
-        totem->RemoveAurasDueToSpell(SPELL_SHAMAN_STONECLAW_TAUNT_PASSIVE);
+        // Drop the stock taunt + stun. The taunt passive differs per Stoneclaw
+        // rank (5728/6397/6398/6399/10425/10426/25513/58583/58584/58585) -- it is
+        // the totem's own spells[0], which Totem::InitSummon cast on the totem.
+        // Strip whatever THIS rank applied, not a single hardcoded id (hardcoding
+        // 25513 only de-taunted rank 7, so every other rank kept taunting). The
+        // glyph absorb-shield in spells[1] is harmless and left intact.
+        if (Totem* t = totem->ToTotem())
+            if (uint32 tauntPassive = t->GetSpell())
+                totem->RemoveAurasDueToSpell(tauntPassive);
 
         // Soak the rank's % immediately (totem = the split's caster, so damage
         // redirects to it), then hand the same % to the pulse driver so it
-- 
