From c1af03c17aa79ff26d9ede43691700dba7f58acb Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Fri, 23 Oct 2026 05:55:41 +0000
Subject: [PATCH] CUSTOM: war paint per character - character_customizations 4
 (F-151)

- ZEPD trailer carries 4 choices (eye, tattoo, scars, war paint); CMSG_CHAR_CREATE war paint byte; UNIT_FIELD_PADDING byte 3

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01URnr7tKsFMZq4VFsSKkj3S
---
 .../Implementation/CharacterDatabase.cpp      |  8 +++----
 .../game/Entities/Player/PlayerStorage.cpp    |  4 ++--
 src/server/game/Handlers/CharacterHandler.cpp | 23 +++++++++++--------
 src/server/game/Server/WorldSession.h         |  1 +
 4 files changed, 20 insertions(+), 16 deletions(-)

diff --git a/src/server/database/Database/Implementation/CharacterDatabase.cpp b/src/server/database/Database/Implementation/CharacterDatabase.cpp
index b2f78d47b..e7aa1ec70 100644
--- a/src/server/database/Database/Implementation/CharacterDatabase.cpp
+++ b/src/server/database/Database/Implementation/CharacterDatabase.cpp
@@ -42,18 +42,18 @@ void CharacterDatabaseConnection::DoPrepareStatements()
     PrepareStatement(CHAR_SEL_BANNED_NAME, "SELECT characters.name FROM characters, character_banned WHERE character_banned.guid = ? AND character_banned.guid = characters.guid", CONNECTION_SYNCH);
     PrepareStatement(CHAR_SEL_ENUM, "SELECT c.guid, c.name, c.race, c.class, c.gender, c.skin, c.face, c.hairStyle, c.hairColor, c.facialStyle, c.level, c.zone, c.map, c.position_x, c.position_y, c.position_z, "
                      "gm.guildid, c.playerFlags, c.at_login, cp.entry, cp.modelid, cp.level, c.equipmentCache, cb.guid, c.extra_flags, "
-                     "ce.choice, cm.choice, cbm.choice "     // CUSTOM (F-151): eye colour, marking, body marking (NULL reads 0) - the last three columns
+                     "ce.choice, cm.choice, cbm.choice, cwp.choice "     // CUSTOM (F-151): eye colour, tattoo, scars, war paint (NULL reads 0) - the last four columns
                      "FROM characters AS c LEFT JOIN character_pet AS cp ON c.guid = cp.owner AND cp.slot = ? LEFT JOIN guild_member AS gm ON c.guid = gm.guid "
                      "LEFT JOIN character_banned AS cb ON c.guid = cb.guid AND cb.active = 1 "
-                     "LEFT JOIN character_customizations AS ce ON c.guid = ce.guid AND ce.customization = 1 LEFT JOIN character_customizations AS cm ON c.guid = cm.guid AND cm.customization = 2 LEFT JOIN character_customizations AS cbm ON c.guid = cbm.guid AND cbm.customization = 3 WHERE c.account = ? AND c.deleteInfos_Name IS NULL ORDER BY COALESCE(c.order, c.guid)", CONNECTION_ASYNC);
+                     "LEFT JOIN character_customizations AS ce ON c.guid = ce.guid AND ce.customization = 1 LEFT JOIN character_customizations AS cm ON c.guid = cm.guid AND cm.customization = 2 LEFT JOIN character_customizations AS cbm ON c.guid = cbm.guid AND cbm.customization = 3 LEFT JOIN character_customizations AS cwp ON c.guid = cwp.guid AND cwp.customization = 4 WHERE c.account = ? AND c.deleteInfos_Name IS NULL ORDER BY COALESCE(c.order, c.guid)", CONNECTION_ASYNC);
     PrepareStatement(CHAR_SEL_ENUM_DECLINED_NAME, "SELECT c.guid, c.name, c.race, c.class, c.gender, c.skin, c.face, c.hairStyle, c.hairColor, c.facialStyle, c.level, c.zone, c.map, "
                      "c.position_x, c.position_y, c.position_z, gm.guildid, c.playerFlags, c.at_login, cp.entry, cp.modelid, cp.level, c.equipmentCache, "
                      "cb.guid, c.extra_flags, cd.genitive, "
-                     "ce.choice, cm.choice, cbm.choice "     // CUSTOM (F-151): eye colour, marking, body marking (NULL reads 0) - the last three columns
+                     "ce.choice, cm.choice, cbm.choice, cwp.choice "     // CUSTOM (F-151): eye colour, tattoo, scars, war paint (NULL reads 0) - the last four columns
                      "FROM characters AS c LEFT JOIN character_pet AS cp ON c.guid = cp.owner AND cp.slot = ? "
                      "LEFT JOIN character_declinedname AS cd ON c.guid = cd.guid LEFT JOIN guild_member AS gm ON c.guid = gm.guid "
                      "LEFT JOIN character_banned AS cb ON c.guid = cb.guid AND cb.active = 1 "
-                     "LEFT JOIN character_customizations AS ce ON c.guid = ce.guid AND ce.customization = 1 LEFT JOIN character_customizations AS cm ON c.guid = cm.guid AND cm.customization = 2 LEFT JOIN character_customizations AS cbm ON c.guid = cbm.guid AND cbm.customization = 3 WHERE c.account = ? AND c.deleteInfos_Name IS NULL ORDER BY COALESCE(c.order, c.guid)", CONNECTION_ASYNC);
+                     "LEFT JOIN character_customizations AS ce ON c.guid = ce.guid AND ce.customization = 1 LEFT JOIN character_customizations AS cm ON c.guid = cm.guid AND cm.customization = 2 LEFT JOIN character_customizations AS cbm ON c.guid = cbm.guid AND cbm.customization = 3 LEFT JOIN character_customizations AS cwp ON c.guid = cwp.guid AND cwp.customization = 4 WHERE c.account = ? AND c.deleteInfos_Name IS NULL ORDER BY COALESCE(c.order, c.guid)", CONNECTION_ASYNC);
     PrepareStatement(CHAR_SEL_FREE_NAME, "SELECT guid, name, at_login FROM characters WHERE guid = ? AND account = ? AND NOT EXISTS (SELECT NULL FROM characters WHERE name = ?)", CONNECTION_ASYNC);
     PrepareStatement(CHAR_SEL_CHAR_ZONE, "SELECT zone FROM characters WHERE guid = ?", CONNECTION_SYNCH);
     PrepareStatement(CHAR_SEL_CHARACTER_NAME_DATA, "SELECT race, class, gender, level FROM characters WHERE guid = ?", CONNECTION_SYNCH);
diff --git a/src/server/game/Entities/Player/PlayerStorage.cpp b/src/server/game/Entities/Player/PlayerStorage.cpp
index 6e915624f..7e30d089d 100644
--- a/src/server/game/Entities/Player/PlayerStorage.cpp
+++ b/src/server/game/Entities/Player/PlayerStorage.cpp
@@ -5129,13 +5129,13 @@ bool Player::LoadFromDB(ObjectGuid playerGuid, CharacterDatabaseQueryHolder cons
     SetByteValue(PLAYER_BYTES_2, 0, fields[13].Get<uint8>());
     SetByteValue(PLAYER_BYTES_2, 2, fields[14].Get<uint8>());
 
-    // CUSTOM (F-151): eye colour (byte 0), marking (byte 1) and body marking (byte 2), drawn by the Zeppelin client
+    // CUSTOM (F-151): eye colour (byte 0), tattoo (byte 1), scars (byte 2) and war paint (byte 3), drawn by the Zeppelin client
     if (PreparedQueryResult customizations = holder.GetPreparedResult(PLAYER_LOGIN_QUERY_LOAD_CUSTOMIZATIONS))
     {
         do
         {
             uint8 customization = (*customizations)[0].Get<uint8>();
-            if (customization >= 1 && customization <= 3)
+            if (customization >= 1 && customization <= 4)
                 SetByteValue(UNIT_FIELD_PADDING, customization - 1, (*customizations)[1].Get<uint8>());
         } while (customizations->NextRow());
     }
diff --git a/src/server/game/Handlers/CharacterHandler.cpp b/src/server/game/Handlers/CharacterHandler.cpp
index 4fd34fcb4..eab9a2360 100644
--- a/src/server/game/Handlers/CharacterHandler.cpp
+++ b/src/server/game/Handlers/CharacterHandler.cpp
@@ -229,8 +229,8 @@ void WorldSession::HandleCharEnum(PreparedQueryResult result)
 
     data << num;
 
-    // CUSTOM (F-151): per listed character its eye colour, marking and body marking, the last three query columns
-    std::vector<std::tuple<uint64, uint8, uint8, uint8>> customizations;
+    // CUSTOM (F-151): per listed character its eye colour, tattoo, scars and war paint, the last four query columns
+    std::vector<std::tuple<uint64, uint8, uint8, uint8, uint8>> customizations;
 
     _legitCharacters.clear();
     if (result)
@@ -245,7 +245,7 @@ void WorldSession::HandleCharEnum(PreparedQueryResult result)
                 ++num;
 
                 uint32 columns = result->GetFieldCount();
-                customizations.emplace_back(guid.GetRawValue(), (*result)[columns - 3].Get<uint8>(), (*result)[columns - 2].Get<uint8>(), (*result)[columns - 1].Get<uint8>());
+                customizations.emplace_back(guid.GetRawValue(), (*result)[columns - 4].Get<uint8>(), (*result)[columns - 3].Get<uint8>(), (*result)[columns - 2].Get<uint8>(), (*result)[columns - 1].Get<uint8>());
             }
         } while (result->NextRow());
     }
@@ -253,11 +253,12 @@ void WorldSession::HandleCharEnum(PreparedQueryResult result)
     data.put<uint8>(0, num);
 
     // CUSTOM (F-151): trailer after the character list, read by the Zeppelin client (RealmConnection::HandleCharEnum):
-    // "ZEPD", count, then per character guid, n, n choices (customization 1 eye colour, 2 marking, 3 body marking).
-    // A client before WowClient64 v11 knows only "ZEPC" (guid, eye, marking) and shows no characters with this.
+    // "ZEPD", count, then per character guid, n, n choices (customization 1 eye colour, 2 tattoo, 3 scars, 4 war paint).
+    // A client before WowClient64 v11 knows only "ZEPC" (guid, eye, marking) and shows no characters with this;
+    // v11 / v12 read the first three choices and skip the rest.
     data << uint32(0x4450455A) << uint8(customizations.size());
-    for (auto const& [rawGuid, eye, marking, bodyMarking] : customizations)
-        data << uint64(rawGuid) << uint8(3) << uint8(eye) << uint8(marking) << uint8(bodyMarking);
+    for (auto const& [rawGuid, eye, tattoo, scars, warPaint] : customizations)
+        data << uint64(rawGuid) << uint8(4) << uint8(eye) << uint8(tattoo) << uint8(scars) << uint8(warPaint);
 
     SendPacket(&data);
 }
@@ -294,11 +295,13 @@ void WorldSession::HandleCharCreateOpcode(WorldPacket& recvData)
              >> createInfo->FacialHair
              >> createInfo->OutfitId;
 
-    // CUSTOM (F-151): eye colour, marking and body marking follow the outfit when the client sends them
+    // CUSTOM (F-151): eye colour, tattoo, scars and war paint follow the outfit when the client sends them
     if (recvData.rpos() + 2 <= recvData.size())
         recvData >> createInfo->EyeId >> createInfo->MarkingId;
     if (recvData.rpos() + 1 <= recvData.size())
         recvData >> createInfo->BodyMarkingId;
+    if (recvData.rpos() + 1 <= recvData.size())
+        recvData >> createInfo->WarPaintId;
 
     if (!HasPermission(rbac::RBAC_PERM_SKIP_CHECK_CHARACTER_CREATION_TEAMMASK))
     {
@@ -599,8 +602,8 @@ void WorldSession::HandleCharCreateOpcode(WorldPacket& recvData)
             // Player created, save it now
             newChar->SaveToDB(characterTransaction, true, false);
 
-            // CUSTOM (F-151): eye colour, marking and body marking
-            std::pair<uint8, uint8> const customizations[] = { { 1, createInfo->EyeId }, { 2, createInfo->MarkingId }, { 3, createInfo->BodyMarkingId } };
+            // CUSTOM (F-151): eye colour, tattoo, scars and war paint
+            std::pair<uint8, uint8> const customizations[] = { { 1, createInfo->EyeId }, { 2, createInfo->MarkingId }, { 3, createInfo->BodyMarkingId }, { 4, createInfo->WarPaintId } };
             for (auto const& [customization, choice] : customizations)
             {
                 CharacterDatabasePreparedStatement* customStmt = CharacterDatabase.GetPreparedStatement(CHAR_REP_CHARACTER_CUSTOMIZATION);
diff --git a/src/server/game/Server/WorldSession.h b/src/server/game/Server/WorldSession.h
index 3664f4083..3e7a49018 100644
--- a/src/server/game/Server/WorldSession.h
+++ b/src/server/game/Server/WorldSession.h
@@ -385,6 +385,7 @@ protected:
     uint8 EyeId = 0;
     uint8 MarkingId = 0;
     uint8 BodyMarkingId = 0;
+    uint8 WarPaintId = 0;
 
     /// Server side data
     uint8 CharCount = 0;
