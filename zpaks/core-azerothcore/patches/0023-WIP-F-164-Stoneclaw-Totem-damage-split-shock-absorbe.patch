From 2e0e3ec87561843fa05f5d362b4bda1b6b23092e Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sun, 14 Jun 2026 01:25:24 +0000
Subject: [PATCH] WIP: F-164 - Stoneclaw Totem damage-split shock absorber

---
 src/server/scripts/Spells/spell_shaman.cpp | 41 +++++++++++++++-------
 1 file changed, 29 insertions(+), 12 deletions(-)

diff --git a/src/server/scripts/Spells/spell_shaman.cpp b/src/server/scripts/Spells/spell_shaman.cpp
index 658ea322f..952be5e85 100644
--- a/src/server/scripts/Spells/spell_shaman.cpp
+++ b/src/server/scripts/Spells/spell_shaman.cpp
@@ -59,6 +59,9 @@ enum ShamanSpells
     SPELL_SHAMAN_NATURE_GUARDIAN_THREAT         = 39301,
     SPELL_SHAMAN_SATED                          = 57724,
     SPELL_SHAMAN_STONECLAW_TOTEM                = 55277,
+    SPELL_SHAMAN_STONECLAW_DAMAGE_SPLIT         = 900222, // F-164: 30% damage redirect to totem
+    SPELL_SHAMAN_EARTHS_GRASP_R1                = 16043,
+    SPELL_SHAMAN_EARTHS_GRASP_R2                = 16130,
     SPELL_SHAMAN_STORM_EARTH_AND_FIRE           = 51483,
     SPELL_SHAMAN_TOTEM_EARTHBIND_EARTHGRAB      = 64695,
     SPELL_SHAMAN_TOTEM_EARTHBIND_TOTEM          = 6474,
@@ -1225,27 +1228,41 @@ class spell_sha_stoneclaw_totem : public SpellScript
 
     bool Validate(SpellInfo const* /*spellInfo*/) override
     {
-        return ValidateSpellInfo({ SPELL_SHAMAN_STONECLAW_TOTEM, SPELL_SHAMAN_GLYPH_OF_STONECLAW_TOTEM });
+        return ValidateSpellInfo({ SPELL_SHAMAN_STONECLAW_DAMAGE_SPLIT, SPELL_SHAMAN_GLYPH_OF_STONECLAW_TOTEM });
     }
 
     void HandleScriptEffect(SpellEffIndex /*effIndex*/)
     {
         Unit* target = GetHitUnit();
 
-        // Cast Absorb on totems
-        for (uint8 slot = SUMMON_SLOT_TOTEM_FIRE; slot < MAX_TOTEM_SLOT; ++slot)
-        {
-            if (!target->m_SummonSlot[slot])
-                continue;
+        // F-164: Stoneclaw Totem is a visible damage buffer for the Earthwarden.
+        // The totem (earth slot) absorbs a share of the shaman's damage; its
+        // health bar is the trackable remaining buffer (no hidden shield).
+        if (!target->m_SummonSlot[SUMMON_SLOT_TOTEM_EARTH])
+            return;
 
-            Creature* totem = target->GetMap()->GetCreature(target->m_SummonSlot[slot]);
-            if (totem && totem->IsTotem())
-                GetCaster()->CastCustomSpell(SPELL_SHAMAN_STONECLAW_TOTEM, SPELLVALUE_BASE_POINT0, GetEffectValue(), totem, true);
+        Creature* totem = target->GetMap()->GetCreature(target->m_SummonSlot[SUMMON_SLOT_TOTEM_EARTH]);
+        if (!totem || !totem->IsTotem())
+            return;
+
+        // Boost the totem's max HP so it is a meaningful, visible buffer.
+        uint32 hp = totem->GetMaxHealth();
+        // Glyph of Stoneclaw Totem: + 10% of the shaman's max health
+        if (target->HasAura(SPELL_SHAMAN_GLYPH_OF_STONECLAW_TOTEM))
+            hp += target->GetMaxHealth() / 10;
+        // Earth's Grasp: buffs the totem HP +25% (R1) / +50% (R2)
+        if (target->HasAura(SPELL_SHAMAN_EARTHS_GRASP_R2))
+            hp += CalculatePct(hp, 50);
+        else if (target->HasAura(SPELL_SHAMAN_EARTHS_GRASP_R1))
+            hp += CalculatePct(hp, 25);
+        if (hp > totem->GetMaxHealth())
+        {
+            totem->SetMaxHealth(hp);
+            totem->SetHealth(hp);
         }
 
-        // Glyph of Stoneclaw Totem
-        if (AuraEffect* aur = target->GetAuraEffect(SPELL_SHAMAN_GLYPH_OF_STONECLAW_TOTEM, 0))
-            GetCaster()->CastCustomSpell(SPELL_SHAMAN_STONECLAW_TOTEM, SPELLVALUE_BASE_POINT0, GetEffectValue() * aur->GetAmount(), target, true);
+        // Redirect 30% of the shaman's incoming damage to the totem (totem = caster)
+        totem->CastSpell(target, SPELL_SHAMAN_STONECLAW_DAMAGE_SPLIT, true);
     }
 
     void Register() override
-- 
2.34.1

