From 0213aa72575b81d09a2fd9bdc5bd43cbbd83cac6 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Fri, 30 Jan 2026 12:17:49 +0000
Subject: [PATCH] I-087: Disable swimming fatigue in dark water

Prevent fatigue damage when swimming in dark/deep water areas.
Allows exploration without fatigue timer restrictions.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/server/game/Entities/Player/Player.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/server/game/Entities/Player/Player.cpp b/src/server/game/Entities/Player/Player.cpp
index 717f4d30d..231d9699f 100644
--- a/src/server/game/Entities/Player/Player.cpp
+++ b/src/server/game/Entities/Player/Player.cpp
@@ -888,8 +888,8 @@ void Player::HandleDrowning(uint32 time_diff)
             SendMirrorTimer(BREATH_TIMER, UnderWaterTime, m_MirrorTimer[BREATH_TIMER], 10);
     }
 
-    // In dark water
-    if (m_MirrorTimerFlags & UNDERWATER_INDARKWATER)
+// In dark water
+    if (false && m_MirrorTimerFlags & UNDERWATER_INDARKWATER)
     {
         // Fatigue timer not activated - activate it
         if (m_MirrorTimer[FATIGUE_TIMER] == DISABLED_MIRROR_TIMER)
-- 
2.34.1

