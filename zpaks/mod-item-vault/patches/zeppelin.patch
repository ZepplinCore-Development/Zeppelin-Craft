+local PREFIX = "|cff33ccff[Item Vault]|r "
+
+local VaultChat = {}
+
+function VaultChat:itemLink(item_template_id)
+	return GetItemLink(tonumber(item_template_id))
+end
+
+function VaultChat:send(player, message)
+	player:SendBroadcastMessage(PREFIX .. message)
+end
+
+function VaultChat:error(player, message)
+	player:SendBroadcastMessage(PREFIX .. "|cffff2020" .. message .. "|r")
+end
+
+function VaultChat:deposited(player, item_template_id, quantity, stored_quantity)
+	self:send(player, "Deposited " .. quantity .. "x " .. self:itemLink(item_template_id) .. " (vault: " .. stored_quantity .. ")")
+end
+
+function VaultChat:withdrew(player, item_template_id, quantity, stored_quantity)
+	self:send(player, "Withdrew " .. quantity .. "x " .. self:itemLink(item_template_id) .. " (vault: " .. stored_quantity .. ")")
+end
+
+return VaultChat
