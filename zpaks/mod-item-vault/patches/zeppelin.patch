From 8389d5c8d6f825cdafcc7823ef7ab1171da402e0 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sun, 17 May 2026 12:12:24 +0000
Subject: [PATCH 02/14] fix: I-181 - withdraw fails when worn bags have free
 slots

getFreeBagSlots used bag:GetBagSlot() (returns 255 for worn bags) and
iterated 1..GetBagSize() (off-by-one). Fixed to use the function arg
bag_id and iterate 0..GetBagSize()-1.

Also send WITHDRAW_RESPONSE when stored_quantity == 1 so the vault
display refreshes after the final item is withdrawn.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 server/src/player/inspector/player-inspector.lua              | 4 ++--
 .../handler/withdraw/withdraw-handler.lua                     | 2 ++
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/server/src/player/inspector/player-inspector.lua b/server/src/player/inspector/player-inspector.lua
index 68edd83..ca2e490 100644
--- a/server/src/player/inspector/player-inspector.lua
+++ b/server/src/player/inspector/player-inspector.lua
@@ -49,8 +49,8 @@ function PlayerInspector:getFreeBagSlots(player, bag_id)
 		return free_slots
 	end
 
-	for slot_id = 1, bag:GetBagSize() do
-		local item = player:GetItemByPos(bag:GetBagSlot(), slot_id)
+	for slot_id = 0, bag:GetBagSize() - 1 do
+		local item = player:GetItemByPos(bag_id, slot_id)
 
 		if not item then
 			free_slots = free_slots + 1
diff --git a/server/src/server-message-handler/handler/withdraw/withdraw-handler.lua b/server/src/server-message-handler/handler/withdraw/withdraw-handler.lua
index d631c19..e45711a 100644
--- a/server/src/server-message-handler/handler/withdraw/withdraw-handler.lua
+++ b/server/src/server-message-handler/handler/withdraw/withdraw-handler.lua
@@ -69,6 +69,8 @@ function WithdrawHandler:execute(player, data)
 
 		update_query:execute()
 
+		player:SendServerResponse("ItemVault", ClientHandlerEnum.WITHDRAW_RESPONSE, item_template_id, 0)
+
 		return
 	end
 
-- 
2.34.1


