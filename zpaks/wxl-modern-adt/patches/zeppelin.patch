From 77c382fa9918f99b26044b3591da585c16ea0c02 Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Thu, 1 Oct 2026 07:35:06 +0000
Subject: [PATCH] fix: F-195 - i686 mingw SEH guards around calls

clang cannot emit a 32-bit SEH funclet around a call (assembler
'L__ehtable$<fn>' undefined). The guards that wrap a call use the core's
WXL_SEH_TRY / WXL_SEH_EXCEPT (common/SehCompat.hpp): real __try on MSVC, a
hand-built fs:[0] SEH frame on mingw, so the fault is still recovered.
Guards around plain memory access are left as __try.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UyueuvSmK9GmAwFmmoVjp9
---
 src/load/AdtSplitInternal.hpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/load/AdtSplitInternal.hpp b/src/load/AdtSplitInternal.hpp
index 12b4f65..002c77f 100644
--- a/src/load/AdtSplitInternal.hpp
+++ b/src/load/AdtSplitInternal.hpp
@@ -40,6 +40,7 @@
 #include <string>
 #include <unordered_map>
 #include <vector>
+#include "common/SehCompat.hpp" // F-195: i686 mingw SEH around calls
 
 namespace wxl::runtime::adtsplit::detail
 {
@@ -155,11 +156,11 @@ namespace wxl::runtime::adtsplit::detail
     template <class Fn, class Ret>
     Ret SehGuarded(Fn fn, Ret fallback)
     {
-        __try
+        WXL_SEH_TRY
         {
             return fn();
         }
-        __except (EXCEPTION_EXECUTE_HANDLER)
+        WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER)
         {
             return fallback;
         }
