 8 files changed, 43 insertions(+), 33 deletions(-)

diff --git a/src/load/AnimUnwrap.cpp b/src/load/AnimUnwrap.cpp
index 12caf2f..95e6410 100644
--- a/src/load/AnimUnwrap.cpp
+++ b/src/load/AnimUnwrap.cpp
@@ -37,6 +37,7 @@
 
 #include <cstdint>
 #include <cstring>
+#include "common/SehCompat.hpp" // F-195: i686 mingw SEH around calls
 
 namespace
 {
@@ -68,8 +69,8 @@ namespace
 
     void UnwrapGuarded(void* node, uint32_t* unwrappedTo)
     {
-        __try { UnwrapCore(node, unwrappedTo); }
-        __except (EXCEPTION_EXECUTE_HANDLER) { *unwrappedTo = 0; }
+        WXL_SEH_TRY { UnwrapCore(node, unwrappedTo); }
+        WXL_SEH_EXCEPT(EXCEPTION_EXECUTE_HANDLER) { *unwrappedTo = 0; }
     }
 
     void __cdecl hkAnimLoadComplete(void* node)
