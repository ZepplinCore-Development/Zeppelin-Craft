From 15e03d95201aa2a2c9978de2c7acb930fcb6700c Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Fri, 2 Oct 2026 05:57:49 +0000
Subject: [PATCH 5/5] fix: Faction-aware race mask for account-bound learning
 (I-373)

- LearnMounts/LearnCompanions match getRaceMask() | faction pool (690/1101)
- Goblin and worgen characters now learn their faction's racial mounts/pets

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CtLSou5AEtr6SrLNg83JxH
---
 src/mod_accountbound.cpp            | 8 ++++++++
 src/mod_accountbound.h              | 1 +
 src/mod_accountbound_companions.cpp | 2 +-
 src/mod_accountbound_mounts.cpp     | 2 +-
 4 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/mod_accountbound.cpp b/src/mod_accountbound.cpp
index abdf938..c87152f 100644
--- a/src/mod_accountbound.cpp
+++ b/src/mod_accountbound.cpp
@@ -12,6 +12,14 @@ void AccountBound::OnStartup()
     LoadFactionSpecificMounts();
 }
 
+// Faction pools are stored as the stock 3.3.5a masks (Alliance 1101, Horde 690), which predate
+// goblin (race 9) and worgen (race 12). Match on faction as well as race so every race of a
+// faction can learn its faction's pool; the 690/1101 constants stay intact for twin lookup.
+uint32 AccountBound::GetLearnRaceMask(Player* player)
+{
+    return player->getRaceMask() | (player->GetTeamId() == TEAM_HORDE ? 690 : 1101);
+}
+
 void Addmod_accountboundScripts()
 {
     new AccountBound();
diff --git a/src/mod_accountbound.h b/src/mod_accountbound.h
index 4f82d0a..6116888 100644
--- a/src/mod_accountbound.h
+++ b/src/mod_accountbound.h
@@ -85,6 +85,7 @@ private:
     void LoadFactionSpecificMounts();
     uint32 GetFactionSpecificMountId(uint32 /*spell_id*/);
     void SaveHeirloom(Player* /*player*/, Item* /*item*/);
+    uint32 GetLearnRaceMask(Player* /*player*/);
 };
 
 #endif
diff --git a/src/mod_accountbound_companions.cpp b/src/mod_accountbound_companions.cpp
index 55721be..33430dd 100644
--- a/src/mod_accountbound_companions.cpp
+++ b/src/mod_accountbound_companions.cpp
@@ -86,7 +86,7 @@ void AccountBound::LearnCompanions(Player* player)
 {
     QueryResult result = LoginDatabase.Query("SELECT `spell_id` FROM `account_bound_companions` WHERE `account_id`={} AND `allowable_race` & {}",
         player->GetSession()->GetAccountId(),
-        player->getRaceMask());
+        GetLearnRaceMask(player));
 
     if (!result)
     {
diff --git a/src/mod_accountbound_mounts.cpp b/src/mod_accountbound_mounts.cpp
index bd81829..aad484b 100644
--- a/src/mod_accountbound_mounts.cpp
+++ b/src/mod_accountbound_mounts.cpp
@@ -93,7 +93,7 @@ void AccountBound::LearnMounts(Player* player)
     QueryResult result = LoginDatabase.Query("SELECT `spell_id` FROM `account_bound_mounts` WHERE `account_id` = {} AND `allowable_race` & {} "
         "AND `allowable_class` & {} AND `required_level` <= {} AND (`required_skill` = 0 OR `required_skill_rank` <= {})",
         player->GetSession()->GetAccountId(),
-        player->getRaceMask(),
+        GetLearnRaceMask(player),
         player->getClassMask(),
         player->GetLevel(),
         player->GetSkillValue(SKILL_RIDING));
-- 
