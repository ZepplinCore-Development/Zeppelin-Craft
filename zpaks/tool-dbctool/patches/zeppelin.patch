     },
+    {
+      "name": "extended_ui",
+      "type": "string"
+    },
     {
       "name": "extended_ui_state_var",
       "type": "uint32"
@@ -58,8 +62,7 @@
     },
     {
       "name": "extended_ui_state_var_unk",
-      "type": "uint32",
-      "count": 2
+      "type": "uint32"
