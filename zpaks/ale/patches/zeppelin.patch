From 2603127b6c2083a630f6a19041d31bdfbee4973b Mon Sep 17 00:00:00 2001
From: Justin <justurn@live.com>
Date: Sat, 11 Apr 2026 13:26:35 +0000
Subject: [PATCH] I-167: Fix mod-ale compilation against current AC API

- UnitMethods.h: replace removed ThreatContainer::StorageType with
  range-for on GetUnsortedThreatList()
- CreatureMethods.h: same for GetAITarget/GetAITargets, use
  GetThreatListSize() instead of .empty()/.size(), GetVictim()
  instead of the renamed getTarget()
- ALE_SC.cpp: update CanPacketSend/CanPacketReceive to take
  WorldPacket const& matching the new ServerScript signature
---
 src/ALE_SC.cpp                          |  6 +++---
 src/LuaEngine/methods/CreatureMethods.h | 19 ++++++++++---------
 src/LuaEngine/methods/UnitMethods.h     |  4 +---
 3 files changed, 14 insertions(+), 15 deletions(-)

diff --git a/src/ALE_SC.cpp b/src/ALE_SC.cpp
index 5151e08..ed85fe4 100644
--- a/src/ALE_SC.cpp
+++ b/src/ALE_SC.cpp
@@ -976,7 +976,7 @@ public:
         SERVERHOOK_CAN_PACKET_RECEIVE
     }) { }
 
-    bool CanPacketSend(WorldSession* session, WorldPacket& packet) override
+    bool CanPacketSend(WorldSession* session, WorldPacket const& packet) override
     {
         if (!sALE->OnPacketSend(session, packet))
             return false;
@@ -984,9 +984,9 @@ public:
         return true;
     }
 
-    bool CanPacketReceive(WorldSession* session, WorldPacket& packet) override
+    bool CanPacketReceive(WorldSession* session, WorldPacket const& packet) override
     {
-        if (!sALE->OnPacketReceive(session, packet))
+        if (!sALE->OnPacketReceive(session, const_cast<WorldPacket&>(packet)))
             return false;
 
         return true;
diff --git a/src/LuaEngine/methods/CreatureMethods.h b/src/LuaEngine/methods/CreatureMethods.h
index f96ad37..0c45110 100644
--- a/src/LuaEngine/methods/CreatureMethods.h
+++ b/src/LuaEngine/methods/CreatureMethods.h
@@ -649,18 +649,19 @@ namespace LuaCreature
         float dist = ALE::CHECKVAL<float>(L, 5, 0.0f);
         int32 aura = ALE::CHECKVAL<int32>(L, 6, 0);
 
-        auto const& threatlist = creature->GetThreatMgr().GetThreatList();
+        ThreatManager& mgr = creature->GetThreatMgr();
+        size_t threatCount = mgr.GetThreatListSize();
 
-        if (threatlist.empty())
+        if (threatCount == 0)
             return 1;
-        if (position >= threatlist.size())
+        if (position >= threatCount)
             return 1;
 
         std::list<Unit*> targetList;
 
-        for (auto itr = threatlist.begin(); itr != threatlist.end(); ++itr)
+        for (ThreatReference const* ref : mgr.GetUnsortedThreatList())
         {
-            Unit* target = (*itr)->getTarget();
+            Unit* target = ref->GetVictim();
 
             if (!target)
                 continue;
@@ -730,14 +731,14 @@ namespace LuaCreature
      */
     int GetAITargets(lua_State* L, Creature* creature)
     {
-        auto const& threatlist = creature->GetThreatMgr().GetThreatList();
+        ThreatManager& mgr = creature->GetThreatMgr();
 
-        lua_createtable(L, threatlist.size(), 0);
+        lua_createtable(L, mgr.GetThreatListSize(), 0);
         int tbl = lua_gettop(L);
         uint32 i = 0;
-        for (auto itr = threatlist.begin(); itr != threatlist.end(); ++itr)
+        for (ThreatReference const* ref : mgr.GetUnsortedThreatList())
         {
-            Unit* target = (*itr)->getTarget();
+            Unit* target = ref->GetVictim();
 
             if (!target)
                 continue;
diff --git a/src/LuaEngine/methods/UnitMethods.h b/src/LuaEngine/methods/UnitMethods.h
index 9e135f4..0957ede 100644
--- a/src/LuaEngine/methods/UnitMethods.h
+++ b/src/LuaEngine/methods/UnitMethods.h
@@ -1885,12 +1885,10 @@ namespace LuaUnit
             return 1;
         }
 
-        ThreatContainer::StorageType const& list = unit->GetThreatMgr().GetThreatList();
-
         lua_newtable(L);
         int table = lua_gettop(L);
         uint32 i = 1;
-        for (ThreatReference* item : list)
+        for (ThreatReference const* item : unit->GetThreatMgr().GetUnsortedThreatList())
         {
             if (!item)
             {
-- 
